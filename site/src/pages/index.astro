---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import ProductShot from "../components/ProductShot.astro";
import LayerStack from "../components/LayerStack.astro";
import RacWindow from "../components/rac/RacWindow.tsx";
import SpaceEditor from "../components/rac/SpaceEditor.tsx";
import AgentDemo from "../components/rac/AgentDemo.tsx";
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
import { HELIUM_URL, REPO_URL, UNGOOGLED_URL } from "../config";

const sidebarFacts = [
  {
    title: "Favorites",
    body: "Your most-used sites, as tiles at the top of the sidebar. The same in every space.",
  },
  {
    title: "Pinned tabs",
    body: "They stay in one space. Close one and it resets to the page you pinned it on.",
  },
  {
    title: "A sidebar that hides",
    body: "Press ⌘S and it’s gone. Point at the left edge of the screen and it slides back over the page.",
  },
];

const contacts = [
  {
    what: "Helium’s services",
    when: "Extension downloads, ad-block lists, spell check, and bangs. Run by Helium, labeled as theirs, and used only after you agree on the first-run screen.",
  },
  {
    what: "rac’s update feed",
    when: "A file on rac’s GitHub releases, checked for new versions. You can turn it off on the About rac page.",
  },
  {
    what: "Your AI provider",
    when: "Only if you turn AI on, and only the one you choose.",
  },
  {
    what: "Crash reports",
    when: "Off. If rac ever adds them, it will ask after each crash before sending anything.",
  },
];
---

<Base
  title="rac: the calm, private browser for Mac"
  description="rac brings Arc’s spaces, pinned tabs, and hiding sidebar to Helium, a fast and private Chromium browser. Free and open source."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="frame flex flex-col items-center pt-[clamp(48px,8vw,112px)] text-center">
      <h1 id="hero-title" class="display-xl max-w-[13ch]">The calm, private browser for Mac.</h1>
      <p class="text-lede mt-6 max-w-[40ch]">
        rac brings Arc’s spaces, pinned tabs, and hiding sidebar to Helium, a fast Chromium browser that keeps your
        data to itself. Free and open source.
      </p>
      <DownloadButton class="mt-9" center />
    </div>

    <div class="frame mt-[clamp(56px,7vw,96px)]">
      <ProductShot name="hero: a rac window with favorites, pinned tabs, open tabs and the space switcher">
        <RacWindow client:idle />
      </ProductShot>
      <p class="mx-auto mt-6 max-w-[60ch] text-center text-[0.9375rem] text-(--ink-2)">
        This is rac, and it works. Open tabs, swipe the sidebar or click the dots to change spaces, and press
        <kbd class="kbd">⌘S</kbd> to hide the sidebar.
      </p>
    </div>
  </section>

  <section id="features" class="py-[clamp(112px,13vw,184px)]" aria-labelledby="spaces-title">
    <div class="frame grid gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <h2 id="spaces-title" class="display-l">A space for everything.</h2>
        <p class="text-lede mt-6">
          Keep work, home, and the trip you’re planning apart, each with its own tabs and color. Give this one a name
          and a color.
        </p>
        <ul class="mt-12 grid gap-8">
          {
            sidebarFacts.map((f) => (
              <li>
                <h3 class="title-m">{f.title}</h3>
                <p class="mt-1.5 text-(--ink-2)">{f.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lg:col-span-8">
        <ProductShot name="spaces: the space editor over a tinted window">
          <SpaceEditor client:visible />
        </ProductShot>
      </div>
    </div>
  </section>

  <section class="bg-(--surface) py-[clamp(112px,13vw,184px)]" aria-labelledby="privacy-title">
    <div class="frame grid gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="privacy-title" class="display-l">Nothing phones home.</h2>
        <p class="text-lede mt-6">
          rac is built on <a class="text-link text-(--ink)" href={HELIUM_URL}>Helium</a> and{" "}
          <a class="text-link text-(--ink)" href={UNGOOGLED_URL}>ungoogled-chromium</a>, browsers made to keep your
          browsing to yourself. It adds no accounts, no telemetry, and no ads, and runs no servers that could hold your
          data.
        </p>
        <p class="mt-8">
          <a class="text-link font-medium" href="/privacy">Read the privacy page</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <h3 class="title-m">Everything rac talks to</h3>
        <dl class="mt-6 grid gap-1" data-reveal>
          {
            contacts.map((item) => (
              <div class="grid gap-1 rounded-2xl bg-(--bg) px-6 py-5 sm:grid-cols-[10.5rem_1fr] sm:gap-6">
                <dt class="font-semibold tracking-[-0.015em]">{item.what}</dt>
                <dd class="text-(--ink-2)">{item.when}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="py-[clamp(112px,13vw,184px)]" aria-labelledby="fast-title">
    <div class="frame grid gap-x-12 gap-y-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <h2 id="fast-title" class="display-l">Never slower than Helium.</h2>
        <ul class="fast-list mt-10" aria-label="What every feature is measured against">
          <li>Startup</li>
          <li>Switching tabs</li>
          <li>Scrolling</li>
          <li>Typing</li>
        </ul>
      </div>
      <div class="grid gap-5 lg:col-span-5" data-reveal>
        <p class="text-lede">These are the moments you feel. No rac feature gets to make any of them slower.</p>
        <p class="text-(--ink-2)">
          Features you turn off cost nothing: no background work, no network calls, no extra processes. Helium’s speed
          is the floor, not the goal.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-(--surface) py-[clamp(112px,13vw,184px)]" aria-labelledby="ai-title">
    <div class="frame">
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12" data-reveal>
        <h2 id="ai-title" class="display-l lg:col-span-6">AI, only if you want it.</h2>
        <div class="grid gap-4 lg:col-span-6 lg:pt-2">
          <p class="text-lede">
            The assistant is off until you turn it on. Then it uses the model you choose: your own API key, a local
            model, or Claude Code, Codex, or Cursor if you already have them.
          </p>
          <p class="text-(--ink-2)">
            With your permission it can act in your tabs. You approve the sites it may use, and anything that signs
            in, buys, or sends always asks first. rac never sees your conversations.
          </p>
        </div>
      </div>
      <div class="mt-[clamp(48px,6vw,80px)]">
        <ProductShot name="ai: the assistant panel with a plan card and a confirmation card">
          <AgentDemo client:visible />
        </ProductShot>
      </div>
    </div>
  </section>

  <section class="py-[clamp(112px,13vw,184px)]" aria-labelledby="open-title">
    <div class="frame grid gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="open-title" class="display-l">Open source, every line.</h2>
        <p class="text-lede mt-6">
          A browser sees everything you do, so you should be able to read its code. rac is GPL-3.0 and built in the
          open.
        </p>
        <p class="mt-5 text-(--ink-2)">
          rac’s changes are a thin layer of patches on top of <a class="text-link text-(--ink)" href={HELIUM_URL}
            >Helium</a
          >, which is how it keeps up with every Helium and Chromium release. rac is an independent project and isn’t
          affiliated with Helium.
        </p>
        <p class="mt-8">
          <a class="text-link font-medium" href={REPO_URL}>Read the source on GitHub</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <LayerStack />
      </div>
    </div>
  </section>

  <section class="pb-[clamp(112px,13vw,184px)]" aria-labelledby="get-title">
    <div class="frame flex flex-col items-center text-center" data-reveal>
      <Image src={appIcon} alt="" width={112} height={112} densities={[1, 2]} class="size-28" />
      <h2 id="get-title" class="display-l mt-8">Make rac your browser.</h2>
      <p class="text-lede mt-5">Free, for macOS 13 or later. Updates arrive on their own.</p>
      <DownloadButton class="mt-9" center />
    </div>
  </section>
</Base>

<style>
  .fast-list {
    font-size: clamp(2.25rem, 4.6vw, 4rem);
    font-weight: 640;
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .kbd {
    display: inline-grid;
    place-items: center;
    min-width: 2.1em;
    height: 1.6em;
    padding-inline: 0.4em;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.875em;
    font-weight: 500;
  }
</style>

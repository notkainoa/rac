---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import ProductShot from "../components/ProductShot.astro";
import LayerStack from "../components/LayerStack.astro";
import RacWindow from "../components/rac/RacWindow.tsx";
import SpaceEditor from "../components/rac/SpaceEditor.tsx";
import AgentDemo from "../components/rac/AgentDemo.tsx";
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
import { REPO_URL } from "../config";

const contacts = [
  { what: "Helium’s services", status: "After you agree" },
  { what: "rac’s update check", status: "Can be turned off" },
  { what: "Your AI provider", status: "Only with AI on" },
  { what: "Telemetry and crash reports", status: "None" },
];

// G11: bench.yml run 42974563789, rac 0.1.0 (dry-run DMG) against Helium
// 0.20.1.1, 30 interleaved rounds on a GitHub-hosted Apple silicon runner.
// Medians from that run's results.json. Update all of it together, from a
// new run, or not at all.
const BENCH_RUN_URL = "https://github.com/notkainoa/rac/actions/runs/42974563789";
const speed = [
  { what: "Cold launch", rac: "1.68 s", helium: "1.62 s" },
  { what: "New tab", rac: "142 ms", helium: "175 ms" },
  { what: "Tab switch", rac: "35 ms", helium: "37 ms" },
  { what: "Scroll", rac: "34 ms", helium: "37 ms" },
  { what: "Keypress", rac: "9.9 ms", helium: "9.1 ms" },
  { what: "Idle CPU, 20 tabs", rac: "6.2%", helium: "6.4%" },
  { what: "Memory, 20 tabs", rac: "3.53 GB", helium: "3.52 GB" },
];

const smallThings = [
  "Automatic picture-in-picture",
  "Address bar in the sidebar",
  "uBlock Origin, built in",
  "Split view",
  "!bangs",
  "Import from your old browser",
];
---

<Base
  title="rac: the calm, private browser for Mac"
  description="rac brings Arc’s spaces, pinned tabs, and hiding sidebar to Helium, a fast and private Chromium browser. Free and open source."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="frame flex flex-col items-center pt-[clamp(40px,6vw,88px)] text-center">
      <h1 id="hero-title" class="display-xl max-w-[13ch]">The calm, private browser for Mac.</h1>
      <p class="text-lede mt-6 max-w-[34ch]">Arc’s best ideas, on Helium’s fast, private Chromium. Free and open source.</p>
      <DownloadButton class="mt-9" center />
    </div>

    <div class="frame mt-[clamp(44px,5vw,72px)]">
      <ProductShot name="hero: a rac window with favorites, pinned tabs, open tabs and the space switcher">
        <RacWindow client:idle={{ timeout: 1500 }} />
      </ProductShot>
      <p class="mx-auto mt-5 text-center text-[0.9375rem] text-(--ink-2)">
        Go ahead, click around. Swipe to change spaces, <kbd class="kbd">⌘S</kbd> to hide the sidebar.
      </p>
    </div>
  </section>

  <section id="features" class="py-[clamp(112px,13vw,184px)]" aria-labelledby="spaces-title">
    <div class="frame grid gap-x-12 gap-y-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4" data-reveal>
        <h2 id="spaces-title" class="display-l">A space for everything.</h2>
        <p class="text-lede mt-6">Its own tabs, its own color. Make this one yours.</p>
      </div>
      <div class="lg:col-span-8">
        <ProductShot name="spaces: the space editor over a tinted window">
          <SpaceEditor client:idle={{ timeout: 1500 }} />
        </ProductShot>
      </div>
    </div>
  </section>

  <section class="bg-(--surface) py-[clamp(112px,13vw,184px)]" aria-labelledby="privacy-title">
    <div class="frame grid gap-x-12 gap-y-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="privacy-title" class="display-l">Nothing phones home.</h2>
        <p class="text-lede mt-6">No accounts, no telemetry, no ads.</p>
        <p class="mt-8">
          <a class="text-link font-medium" href="/privacy">Everything it does connect to</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <dl class="grid gap-1" data-reveal>
          {
            contacts.map((item) => (
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-2xl bg-(--bg) px-6 py-5">
                <dt class="font-semibold tracking-[-0.015em]">{item.what}</dt>
                <dd class="status" data-off={item.status === "None" || undefined}>
                  {item.status}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="py-[clamp(112px,13vw,184px)]" aria-labelledby="small-title">
    <div class="frame grid gap-x-12 gap-y-10 lg:grid-cols-12">
      <h2 id="small-title" class="display-l lg:col-span-4" data-reveal><span>And the small things.</span></h2>
      <ul class="small-list lg:col-span-7 lg:col-start-6" data-reveal>
        {smallThings.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="bg-(--surface) py-[clamp(112px,13vw,184px)]" aria-labelledby="ai-title">
    <div class="frame">
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <h2 id="ai-title" class="display-l lg:col-span-6">AI, only if you want it.</h2>
        <p class="text-lede lg:col-span-6">Off until you turn it on. Your model, your choice. It asks before it acts.</p>
      </div>
      <div class="mt-[clamp(40px,5vw,64px)]">
        <ProductShot name="ai: the assistant panel with a plan card and a confirmation card">
          <AgentDemo client:idle={{ timeout: 1500 }} />
        </ProductShot>
      </div>
    </div>
  </section>

  <section class="py-[clamp(112px,13vw,184px)]" aria-labelledby="open-title">
    <div class="frame grid gap-x-12 gap-y-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="open-title" class="display-l">Open source, every line.</h2>
        <p class="text-lede mt-6">GPL-3.0. A thin layer on top of Helium, and never slower than it.</p>
        <p class="mt-8">
          <a class="text-link font-medium" href={REPO_URL}>Read the source</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <LayerStack />
      </div>
    </div>
  </section>

  <section class="bg-(--surface) py-[clamp(112px,13vw,184px)]" aria-labelledby="speed-title">
    <div class="frame grid gap-x-12 gap-y-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="speed-title" class="display-l">As quick as Helium.</h2>
        <p class="text-lede mt-6">
          rac adds its features on top of Helium. In our benchmark, launching, opening and switching tabs,
          scrolling, and typing all landed within run-to-run noise of Helium.
        </p>
        <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          <a class="text-link font-medium" href={BENCH_RUN_URL}>See the run</a>
          <a class="text-link font-medium" href={`${REPO_URL}/tree/main/devutils/rac/bench`}>Run it yourself</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <table class="speed w-full">
          <caption class="sr-only">rac and Helium, median of 30 rounds</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Measure</span></th>
              <th scope="col">rac</th>
              <th scope="col">Helium</th>
            </tr>
          </thead>
          <tbody>
            {
              speed.map((row) => (
                <tr>
                  <th scope="row">{row.what}</th>
                  <td>{row.rac}</td>
                  <td>{row.helium}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-5 text-[0.875rem] leading-relaxed text-(--ink-2)">
          Medians of 30 rounds, taken in turns, of rac 0.1.0 and Helium 0.20.1.1 on a shared GitHub-hosted Mac with
          Apple silicon. Shared machines are noisy: one cold launch took 1.0 seconds and another
          3.1. Paired round by round, rac launched 92 ms slower at the median, though it was slower in only 18 of 30
          rounds. With 10 or 20 tabs open, it used about 12 MB more memory, under 1%.
        </p>
      </div>
    </div>
  </section>

  <section class="py-[clamp(112px,13vw,184px)]" aria-labelledby="get-title">
    <div class="frame flex flex-col items-center text-center" data-reveal>
      <Image src={appIcon} alt="" width={144} height={144} densities={[1, 2]} class="size-36" />
      <h2 id="get-title" class="display-l mt-5">Make rac your browser.</h2>
      <p class="text-lede mt-5">Free and open source.</p>
      <DownloadButton class="mt-9" center />
    </div>
  </section>
</Base>

<style>
  .small-list {
    display: grid;
    gap: 0.35em;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .speed {
    border-collapse: separate;
    border-spacing: 0 4px;
    font-variant-numeric: tabular-nums;
  }

  .speed thead th {
    padding: 0 1.25rem 0.5rem;
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: right;
  }

  .speed tbody th,
  .speed td {
    padding: 1rem 1.25rem;
    background: var(--bg);
  }

  .speed tbody th {
    border-radius: 1rem 0 0 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-align: left;
  }

  .speed td {
    color: var(--ink-2);
    text-align: right;
    white-space: nowrap;
  }

  .speed td:last-child {
    border-radius: 0 1rem 1rem 0;
  }

  @media (max-width: 479px) {
    .speed thead th,
    .speed tbody th,
    .speed td {
      padding-inline: 0.875rem;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .status[data-off]::before {
    background: #3eb489;
  }

  .kbd {
    display: inline-grid;
    place-items: center;
    min-width: 2.1em;
    height: 1.6em;
    padding-inline: 0.4em;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.875em;
    font-weight: 500;
  }
</style>

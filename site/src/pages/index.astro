---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import ProductShot from "../components/ProductShot.astro";
import LayerStack from "../components/LayerStack.astro";
import RacWindow from "../components/rac/RacWindow.tsx";
import SpaceEditor from "../components/rac/SpaceEditor.tsx";
import AgentDemo from "../components/rac/AgentDemo.tsx";
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
import { REPO_URL } from "../config";

const contacts = [
  { what: "Helium’s services", status: "After you agree" },
  { what: "rac’s update check", status: "Can be turned off" },
  { what: "Your AI provider", status: "Only with AI on" },
  { what: "Telemetry and crash reports", status: "None" },
];

const smallThings = [
  "Automatic picture-in-picture",
  "Address bar in the sidebar",
  "uBlock Origin, built in",
  "Split view",
  "!bangs",
  "Import from your old browser",
];
---

<Base
  title="rac: the calm, private browser for Mac"
  description="rac brings Arc’s spaces, pinned tabs, and hiding sidebar to Helium, a fast and private Chromium browser. Free and open source."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="frame flex flex-col items-center pt-[clamp(40px,6vw,88px)] text-center">
      <h1 id="hero-title" class="display-xl max-w-[13ch]">The calm, private browser for Mac.</h1>
      <p class="text-lede mt-6 max-w-[34ch]">Arc’s best ideas, on Helium’s fast, private Chromium. Free and open source.</p>
      <DownloadButton class="mt-9" center />
    </div>

    <div class="frame mt-[clamp(44px,5vw,72px)]">
      <ProductShot name="hero: a rac window with favorites, pinned tabs, open tabs and the space switcher">
        <RacWindow client:idle={{ timeout: 1500 }} />
      </ProductShot>
      <p class="mx-auto mt-5 text-center text-[0.9375rem] text-(--ink-2)">
        Go ahead, click around. Swipe to change spaces, <kbd class="kbd">⌘S</kbd> to hide the sidebar.
      </p>
    </div>
  </section>

  <section id="features" class="py-[clamp(112px,13vw,184px)]" aria-labelledby="spaces-title">
    <div class="frame grid gap-x-12 gap-y-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4" data-reveal>
        <h2 id="spaces-title" class="display-l">A space for everything.</h2>
        <p class="text-lede mt-6">Its own tabs, its own color. Make this one yours.</p>
      </div>
      <div class="lg:col-span-8">
        <ProductShot name="spaces: the space editor over a tinted window">
          <SpaceEditor client:idle={{ timeout: 1500 }} />
        </ProductShot>
      </div>
    </div>
  </section>

  <section class="bg-(--surface) py-[clamp(112px,13vw,184px)]" aria-labelledby="privacy-title">
    <div class="frame grid gap-x-12 gap-y-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="privacy-title" class="display-l">Nothing phones home.</h2>
        <p class="text-lede mt-6">No accounts, no telemetry, no ads.</p>
        <p class="mt-8">
          <a class="text-link font-medium" href="/privacy">Everything it does connect to</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <dl class="grid gap-1" data-reveal>
          {
            contacts.map((item) => (
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-2xl bg-(--bg) px-6 py-5">
                <dt class="font-semibold tracking-[-0.015em]">{item.what}</dt>
                <dd class="status" data-off={item.status === "None" || undefined}>
                  {item.status}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="py-[clamp(112px,13vw,184px)]" aria-labelledby="fast-title">
    <div class="frame" data-reveal>
      <h2 id="fast-title" class="display-l">Never slower than Helium.</h2>
      <ul class="fast-list mt-10" aria-label="What every feature is measured against">
        <li>Startup.</li>
        <li>Switching tabs.</li>
        <li>Scrolling.</li>
        <li>Typing.</li>
      </ul>
      <p class="text-lede mt-10">Turned off means it costs nothing.</p>
    </div>
  </section>

  <section class="pb-[clamp(112px,13vw,184px)]" aria-labelledby="small-title">
    <div class="frame grid gap-x-12 gap-y-10 lg:grid-cols-12">
      <h2 id="small-title" class="display-l lg:col-span-4" data-reveal><span>And the small things.</span></h2>
      <ul class="small-list lg:col-span-7 lg:col-start-6" data-reveal>
        {smallThings.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="bg-(--surface) py-[clamp(112px,13vw,184px)]" aria-labelledby="ai-title">
    <div class="frame">
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <h2 id="ai-title" class="display-l lg:col-span-6">AI, only if you want it.</h2>
        <p class="text-lede lg:col-span-6">Off until you turn it on. Your model, your key. It asks before it acts.</p>
      </div>
      <div class="mt-[clamp(40px,5vw,64px)]">
        <ProductShot name="ai: the assistant panel with a plan card and a confirmation card">
          <AgentDemo client:idle={{ timeout: 1500 }} />
        </ProductShot>
      </div>
    </div>
  </section>

  <section class="py-[clamp(112px,13vw,184px)]" aria-labelledby="open-title">
    <div class="frame grid gap-x-12 gap-y-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="open-title" class="display-l">Open source, every line.</h2>
        <p class="text-lede mt-6">GPL-3.0. A thin layer on top of Helium.</p>
        <p class="mt-8">
          <a class="text-link font-medium" href={REPO_URL}>Read the source</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <LayerStack />
      </div>
    </div>
  </section>

  <section class="pb-[clamp(112px,13vw,184px)]" aria-labelledby="get-title">
    <div class="frame flex flex-col items-center text-center" data-reveal>
      <Image src={appIcon} alt="" width={144} height={144} densities={[1, 2]} class="size-36" />
      <h2 id="get-title" class="display-l mt-5">Make rac your browser.</h2>
      <p class="text-lede mt-5">Free, for macOS 13 or later.</p>
      <DownloadButton class="mt-9" center />
    </div>
  </section>
</Base>

<style>
  .fast-list {
    font-size: clamp(2.25rem, 4.6vw, 4rem);
    font-weight: 640;
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .small-list {
    display: grid;
    gap: 0.35em;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .status[data-off]::before {
    background: #3eb489;
  }

  .kbd {
    display: inline-grid;
    place-items: center;
    min-width: 2.1em;
    height: 1.6em;
    padding-inline: 0.4em;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.875em;
    font-weight: 500;
  }
</style>

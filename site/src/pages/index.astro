---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import ProductShot from "../components/ProductShot.astro";
import BrowserMock from "../components/BrowserMock.tsx";
import SidebarFigure from "../components/SidebarFigure.tsx";
import AiCards from "../components/AiCards.astro";
import LayerStack from "../components/LayerStack.astro";
import { HELIUM_URL, REPO_URL, UNGOOGLED_URL } from "../config";

const features = [
  {
    key: "favorites",
    title: "Favorites",
    body: "Your most-used sites sit as icons at the top of the sidebar, the same in every space.",
  },
  {
    key: "pinned",
    title: "Pinned tabs",
    body: "Tabs that stay in one space, loose or in folders. Each remembers the page you pinned, so you can wander off and reset it.",
  },
  {
    key: "spaces",
    title: "Spaces",
    body: "A set of tabs for work, one for home, one for the trip you’re planning, each with its own color. Switch with the dots at the bottom.",
  },
  {
    key: "hide",
    title: "A sidebar that hides",
    body: "Press ⌘S and it’s gone. Move to the left edge of the screen and it slides back over the page.",
  },
];

const contacts = [
  {
    what: "Helium’s services",
    when: "Extension downloads, ad-block lists, spell check, and bangs. Run by Helium, labeled as theirs, and used only after you agree on the first-run screen.",
  },
  {
    what: "rac’s update feed",
    when: "A file on rac’s GitHub releases, checked for new versions. You can turn it off on the About rac page.",
  },
  {
    what: "Your AI provider",
    when: "Only if you turn AI on, and only the one you choose.",
  },
  {
    what: "Crash reports",
    when: "Off by default. If rac adds them, it will ask after each crash before sending anything.",
  },
];

const providers = [
  { title: "Your own API key", body: "from the provider you already use." },
  { title: "A local model", body: "running on your Mac." },
  { title: "An agent you have installed", body: "like Claude Code, Codex, or Cursor." },
];
---

<Base
  title="rac: the calm, private browser for Mac"
  description="rac brings Arc’s spaces, pinned tabs, and hiding sidebar to Helium, a fast and private Chromium browser. Free and open source."
>
  <!-- Hero: the browser window sits on the horizon from rac's icon. -->
  <section class="hero relative overflow-hidden" aria-labelledby="hero-title">
    <div class="frame pt-[clamp(32px,5vw,72px)]">
      <div class="grid gap-x-10 gap-y-8 lg:grid-cols-12 lg:items-end">
        <h1 id="hero-title" class="display-xl lg:col-span-8">The calm, private browser for Mac.</h1>
        <div class="lg:col-span-4 lg:pb-2">
          <p class="text-lede max-w-[34ch]">
            rac brings Arc’s spaces, pinned tabs, and hiding sidebar to Helium, the fast Chromium browser that keeps
            your data to itself. Free and open source.
          </p>
          <DownloadButton class="mt-8" />
        </div>
      </div>
    </div>

    <div class="relative mt-[clamp(40px,5vw,72px)] pb-[clamp(72px,11vw,176px)]">
      <div class="horizon absolute inset-x-0 top-[22%] bottom-0" aria-hidden="true"></div>
      <div class="frame relative">
        <ProductShot name="hero: a rac window with favorites, pinned tabs, open tabs and space dots" class="mx-auto max-w-[1120px]">
          <BrowserMock client:idle />
        </ProductShot>
      </div>
    </div>
  </section>

  <!-- Spaces: three sidebars show what is shared and what belongs to a space. -->
  <section id="features" class="sf-host py-[clamp(96px,13vw,192px)]" aria-labelledby="spaces-title">
    <div class="frame">
      <div class="grid gap-x-10 gap-y-6 lg:grid-cols-12" data-reveal>
        <h2 id="spaces-title" class="display-l lg:col-span-7">Arc’s best ideas, kept.</h2>
        <p class="text-lede self-end lg:col-span-5">
          If you miss how Arc kept your tabs in order, you’ll feel at home. The sidebar holds everything, and it gets
          out of the way when you want the whole screen.
        </p>
      </div>

      <ProductShot name="spaces: the sidebar in three spaces" class="mt-[clamp(48px,6vw,88px)]">
        <SidebarFigure />
      </ProductShot>

      <ul class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4" data-reveal>
        {
          features.map((feature) => (
            <li data-feature={feature.key} tabindex="0" class="rounded-lg outline-offset-8">
              <h3 class="text-[1.25rem] font-semibold tracking-[-0.015em]">{feature.title}</h3>
              <p class="mt-2 text-(--ink)">{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Privacy: a field of the icon's navy, whatever the theme. -->
  <section class="bg-(--field) py-[clamp(96px,13vw,192px)] text-(--field-ink)" aria-labelledby="privacy-title">
    <div class="frame grid gap-x-10 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="privacy-title" class="display-l">Nothing phones home.</h2>
        <p class="text-lede mt-8 max-w-[38ch]">
          rac is built on <a class="field-link" href={HELIUM_URL}>Helium</a> and{" "}
          <a class="field-link" href={UNGOOGLED_URL}>ungoogled-chromium</a>, browsers made to keep your browsing to
          yourself. rac adds no accounts, no telemetry, and no ads, and runs no servers that could hold your data.
        </p>
        <p class="mt-8">
          <a class="field-link" href="/privacy">Read the privacy page</a>
        </p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <h3 class="text-[1.25rem] font-semibold tracking-[-0.015em]">Everything rac talks to</h3>
        <dl class="mt-6 grid gap-2" data-reveal>
          {
            contacts.map((item) => (
              <div class="grid gap-1 rounded-2xl bg-(--field-surface) px-6 py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
                <dt class="font-semibold">{item.what}</dt>
                <dd class="text-(--field-ink-2)">{item.when}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Fast: the four things you feel, set large. -->
  <section class="py-[clamp(96px,13vw,192px)]" aria-labelledby="fast-title">
    <div class="frame">
      <h2 id="fast-title" class="display-l max-w-[14ch]" data-reveal><span>Never slower than Helium.</span></h2>
      <div class="mt-[clamp(40px,5vw,72px)] grid gap-x-10 gap-y-10 lg:grid-cols-12">
        <ul class="fast-list font-display lg:col-span-7" data-reveal aria-label="What every feature is measured against">
          <li>Startup</li>
          <li>Switching tabs</li>
          <li>Scrolling</li>
          <li>Typing</li>
        </ul>
        <div class="grid content-end gap-6 lg:col-span-5" data-reveal>
          <p class="text-lede">
            These are the moments you feel. No rac feature gets to make any of them slower than Helium on its own.
          </p>
          <p>
            Features you turn off cost nothing: no background work, no network calls, no extra processes. Helium’s
            speed is the floor, not the goal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI: optional, quiet, and asks first. -->
  <section class="bg-(--surface) py-[clamp(96px,13vw,192px)]" aria-labelledby="ai-title">
    <div class="frame grid gap-x-10 gap-y-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6" data-reveal>
        <h2 id="ai-title" class="display-l">AI, if you want it.</h2>
        <p class="text-lede mt-8">
          AI is off until you turn it on, and while it’s off, none of its code runs. If you do turn it on, it uses
          a model you pick:
        </p>
        <ul class="mt-6 grid gap-3">
          {
            providers.map((p) => (
              <li class="flex gap-3">
                <span class="mt-[0.6em] size-2 flex-none rounded-full bg-action" aria-hidden="true" />
                <span>
                  <strong class="font-semibold">{p.title}</strong> {p.body}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-6">
          The assistant reads the page you’re on and answers in the sidebar. With your permission it can also act
          in your tabs. You approve the sites it may use, and anything consequential, like signing in, buying, or
          sending a form, always asks first. rac never sees your conversations.
        </p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8" data-reveal>
        <ProductShot name="ai: the plan card and a confirmation card in the AI sidebar">
          <AiCards />
        </ProductShot>
      </div>
    </div>
  </section>

  <!-- Open source: the layers rac is built from. -->
  <section class="py-[clamp(96px,13vw,192px)]" aria-labelledby="open-title">
    <div class="frame grid gap-x-10 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="open-title" class="display-l">Open source, every line.</h2>
        <p class="text-lede mt-8">
          A browser sees everything you do, so you should be able to read its code. rac is GPL-3.0 and built in
          the open.
        </p>
        <p class="mt-6">
          rac’s changes are a thin layer of patches on top of <a class="text-link" href={HELIUM_URL}>Helium</a>, which
          is how it keeps up with every Helium and Chromium release. rac is an independent project and isn’t
          affiliated with Helium.
        </p>
        <p class="mt-8">
          <a class="text-link font-medium" href={REPO_URL}>Read the source on GitHub</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <LayerStack />
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="pb-[clamp(96px,13vw,192px)]" aria-labelledby="get-title">
    <div class="frame grid gap-x-10 gap-y-8 lg:grid-cols-12 lg:items-end" data-reveal>
      <h2 id="get-title" class="display-l lg:col-span-7">Make rac your browser.</h2>
      <div class="lg:col-span-5">
        <p class="text-lede">Free, for macOS 13 or later. Updates arrive on their own.</p>
        <DownloadButton class="mt-8" />
      </div>
    </div>
  </section>
</Base>

<style>
  .horizon {
    background-image: url("/horizon-light.png");
    background-repeat: no-repeat;
    /* Anchored to the bottom so the planet always fills the foot of the
       hero; the image's top row is the page background, so taller bands
       just extend the sky. */
    background-position: center bottom;
    background-size: max(1920px, 100%) auto;
    background-color: var(--bg);
    image-rendering: pixelated;
  }

  :global([data-theme="dark"]) .horizon {
    background-image: url("/horizon-dark.png");
  }

  .fast-list {
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .field-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: rgb(232 236 248 / 0.45);
    transition: text-decoration-color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .field-link:hover {
      text-decoration-color: currentColor;
    }
  }
</style>

---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import appIcon from "../assets/app-icon.png";

// Features that may or may not make launch. Ship confirms this list after
// day 13. Delete an entry to drop it from the page; nothing else needs to
// change.
const extras: string[] = [
  "signins", // Sites stay signed in after import.
  "clear", // One click to tidy open tabs.
  "commandBar", // ⌘T bar for tabs and commands.
];
const has = (name: string) => extras.includes(name);

const steps = [
  { title: "Download rac", body: "It’s free, and there’s no account to make." },
  { title: "Open rac", body: "Drag it into Applications and open it." },
  { title: "Import from Arc", body: "Choose Arc on the welcome screen. Your spaces show up in the sidebar." },
];
---

<Base
  title="Moving from Arc · rac"
  description="Bring your Arc spaces, pinned tabs, favorites, and themes to rac, a private, open-source browser for Mac."
>
  <section class="frame pt-[clamp(56px,9vw,128px)]" aria-labelledby="arc-title">
    <h1 id="arc-title" class="display-xl max-w-[12ch]">Moving from Arc</h1>
    <p class="text-lede mt-8 max-w-[40ch]">
      Arc isn’t getting new features anymore. rac has spaces, pinned tabs, favorites, and a sidebar that hides, and it can
      bring yours over from Arc.
    </p>
  </section>

  <section class="frame pt-[clamp(56px,7vw,96px)] pb-[clamp(96px,11vw,160px)]" aria-labelledby="how-title">
    <h2 id="how-title" class="title-m">How it works</h2>
    <ol class="mt-6 grid gap-3 md:grid-cols-3" data-reveal>
      {
        steps.map((step, i) => (
          <li class="rounded-[22px] bg-(--surface) p-7">
            <span class="num">{i + 1}</span>
            <h3 class="title-m mt-5">{step.title}</h3>
            <p class="mt-2 text-(--ink-2)">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bg-(--surface) py-[clamp(96px,11vw,160px)]" aria-labelledby="details-title">
    <div class="frame grid gap-x-10 lg:grid-cols-12">
      <header class="self-start lg:sticky lg:top-10 lg:col-span-5">
        <h2 id="details-title" class="display-l">What to expect</h2>
        <p class="text-lede mt-6 max-w-[34ch]">What comes over from Arc, what stays behind, and what will feel new.</p>
      </header>

      <div class="prose-rac mt-14 lg:col-span-6 lg:col-start-7 lg:mt-3">
        <h2>What comes over</h2>
        <ul>
          <li><strong>Spaces</strong>, with their names and emoji.</li>
          <li>
            <strong>Pinned tabs</strong> and their folders. Folders are one level deep in rac, so a nested folder
            shows up as “Parent › Child”.
          </li>
          <li><strong>Favorites</strong>, from Arc’s Top Apps.</li>
          <li>
            <strong>Themes.</strong> Colors come close to Arc’s, but they aren’t exact. Arc’s gradient overlays, noise,
            and intensity are left out.
          </li>
          <li><strong>Open tabs</strong>, unloaded until you open them.</li>
          <li><strong>Split views and tab groups</strong>, as plain tabs.</li>
          <li><strong>Profiles.</strong> Each Arc profile becomes a rac profile with its own window.</li>
          {has("signins") && <li><strong>Sign-ins.</strong> Sites stay signed in. Some, like Google, may ask again.</li>}
        </ul>
        <p>History and extensions come over in a separate step, through Helium’s importer.</p>
        <p>
          Running the import again adds nothing new. If you change your mind, Undo Arc import takes back what it added
          to your sidebar. It works for 7 days.
        </p>

        <h2>What doesn’t, yet</h2>
        <ul>
          <li>Live folders, Boosts, Easels, and Notes aren’t imported.</li>
          <li>Arc’s archive and your Air Traffic Control rules are kept for later. rac doesn’t use them at launch.</li>
          {!has("signins") && <li>Sign-ins stay behind, so you’ll sign in to sites again.</li>}
        </ul>

        <h2>What feels the same</h2>
        <ul>
          <li>Most of the words. Spaces, pinned tabs, favorites, and the sidebar are called the same things.</li>
          <li><kbd class="kbd">⌘S</kbd> hides the sidebar and brings it back.</li>
          {has("commandBar") && <li><kbd class="kbd">⌘T</kbd> opens a bar where you can search your tabs and run commands.</li>}
          {has("clear") && <li>Clear tidies your open tabs in one click.</li>}
        </ul>

        <h2>What’s different</h2>
        <ul>
          <li>Each profile opens in its own window.</li>
          <li>rac is open source and built on Helium, a private version of Chromium.</li>
        </ul>

        <h2>Your Arc data stays on your Mac</h2>
        <p>
          The import reads Arc’s files on your Mac and makes no network requests. Your Arc data never leaves your Mac.
          rac has no account, and nothing phones home. <a class="text-link" href="/privacy">More on privacy</a>
        </p>
      </div>
    </div>
  </section>

  <section class="frame flex flex-col items-center py-[clamp(112px,13vw,184px)] text-center" aria-labelledby="get-title" data-reveal>
    <Image src={appIcon} alt="" width={144} height={144} densities={[1, 2]} class="size-36" />
    <h2 id="get-title" class="display-l mt-5">Bring your spaces.</h2>
    <p class="text-lede mt-5">Free and open source.</p>
    <DownloadButton class="mt-9" center />
  </section>
</Base>

<style>
  .num {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--surface-2);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .kbd {
    display: inline-grid;
    place-items: center;
    min-width: 2.1em;
    height: 1.6em;
    padding-inline: 0.4em;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--ink);
    font-size: 0.875em;
    font-weight: 500;
  }
</style>

---
import Base from "../layouts/Base.astro";
---

<Base title="Not found · rac" description="This page doesn’t exist." noindex>
  <section class="frame flex flex-col items-center py-[clamp(96px,14vw,200px)] text-center">
    <h1 class="display-xl">Nothing here.</h1>
    <p class="text-lede mt-6">That page doesn’t exist, or it moved.</p>
    <a
      href="/"
      class="press mt-10 inline-flex h-12 items-center rounded-full bg-(--button) px-6 font-medium text-(--button-ink) hover:bg-(--button-hover)"
    >
      Back to rac
    </a>
  </section>
</Base>

---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import InstallSteps from "../components/download/InstallSteps.astro";
import appIcon from "../assets/app-icon-mark.png";
import { getRelease, PLATFORM } from "../lib/release";
import { RELEASE_READY, REPO_URL } from "../config";

// Hidden until RELEASE_READY: nothing links here and search engines skip it.
// Then every download button and the nav point here.
const release = await getRelease();
const { build } = release;
const date = new Date(release.date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const mb = (bytes: number) => `${Math.round(bytes / 1e6)} MB`;
const data = JSON.stringify({ sample: release.sample, version: release.version, url: build.url });
---

<Base title="Download rac" description="Download rac for Mac." noindex={!RELEASE_READY}>
  <div class="dl" data-release={data} data-state="nojs">
    <section class="frame flex flex-col items-center pt-[clamp(24px,4vw,48px)] text-center">
      <p class="badge" aria-live="polite">
        <span data-for="nojs">rac needs a Mac with Apple silicon (M1 or later).</span>
        <span data-for="mac">
          Your download will start automatically. If it doesn’t, <a href={build.url}>retry here</a>.
        </span>
        <span data-for="pick">rac needs a Mac with Apple silicon (M1 or later).</span>
        <span data-for="intel">This Mac has an Intel chip, and rac needs Apple silicon, so nothing downloaded.</span>
        <span data-for="started">Your download has started. If it didn’t, <a href={build.url}>retry here</a>.</span>
        <span data-for="other">rac is for Mac, so nothing downloaded. You can still get it below.</span>
      </p>

      <h1 class="display-xl mt-[clamp(36px,5vw,64px)]">Almost there.</h1>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-2.5">
        <a href={build.url} class="get-button press" data-get>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12"></path></svg>
          Download for Mac
        </a>
        <a href="#all" class="all-button press">
          All downloads
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4v12m0 0-4.5-4.5M10 16l4.5-4.5"></path></svg>
        </a>
      </div>
      <p class="mt-4 text-[0.875rem] text-(--ink-2)">{PLATFORM}</p>
      {release.preview && <p class="preview mt-3">Preview. Not for daily use.</p>}
    </section>

    <section class="frame mt-[clamp(56px,7vw,96px)]" aria-label="Install">
      <InstallSteps />
    </section>

    <section id="all" class="frame scroll-mt-8 py-[clamp(96px,11vw,160px)]" aria-labelledby="all-title">
      <div class="mx-auto max-w-[760px]">
        <h2 id="all-title" class="title-m text-center text-[1.5rem]">All downloads</h2>

        <div class="card mt-8">
          <div class="flex items-center gap-4">
            <Image src={appIcon} alt="" width={52} height={52} densities={[1, 2]} class="size-[52px]" />
            <div>
              <h3 class="font-semibold tracking-[-0.015em] text-[1.125rem]">rac for Mac</h3>
              <p class="text-[0.9375rem] text-(--ink-2)">{PLATFORM}. Updates itself.</p>
            </div>
          </div>

          <div class="build mt-6">
            <div class="min-w-0">
              <p class="font-semibold tracking-[-0.01em]">{build.label}</p>
              <p class="truncate text-[0.875rem] text-(--ink-2)">
                {build.file} · {mb(build.size)}
              </p>
            </div>
            <a class="get press" href={build.url} data-get>
              <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12"></path></svg>
              Download
            </a>
            {build.sha256 && (
              <div class="sha">
                <span class="shrink-0">SHA-256</span>
                <code class="truncate">{build.sha256}</code>
                <button type="button" class="copy press" data-copy={build.sha256} aria-label="Copy the checksum">
                  Copy
                </button>
              </div>
            )}
          </div>

          <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-[0.875rem] text-(--ink-2)">
            <span>Version {release.version}{release.preview && " (Preview. Not for daily use.)"}</span>
            <span>{date}</span>
            <a class="text-link" href={release.notesUrl}>Release notes</a>
            <a class="text-link" href={`${REPO_URL}/releases`}>Older versions</a>
          </p>
        </div>

        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="card">
            <h3 class="font-semibold tracking-[-0.015em]">Will it run on my Mac?</h3>
            <p class="mt-1.5 text-[0.9375rem] text-(--ink-2)">
              Apple menu, then About This Mac. If it lists a <b class="font-medium text-(--ink)">Chip</b>, yes.
              A <b class="font-medium text-(--ink)">Processor</b> means an Intel Mac, which rac doesn’t support.
            </p>
          </div>
          <div class="card">
            <h3 class="font-semibold tracking-[-0.015em]">Intel, Windows, or Linux?</h3>
            <p class="mt-1.5 text-[0.9375rem] text-(--ink-2)">
              rac is for Apple silicon Macs only. <a class="text-link text-(--ink)" href="https://helium.computer">Helium</a>,
              which it’s built on, runs on all three.
            </p>
          </div>
        </div>

        {release.sample && <p class="mt-8 text-center text-[0.8125rem] text-(--ink-2)">Sample data until the first release.</p>}
      </div>
    </section>
  </div>
</Base>

<script>
  interface Data {
    sample: boolean;
    version: string;
    url: string;
  }

  const root = document.querySelector<HTMLElement>(".dl")!;
  const data: Data = JSON.parse(root.dataset.release!);

  // A Mac, and whether it has Apple silicon, or null when the browser won't
  // say. Chromium reports the architecture. Elsewhere the GPU gives it away:
  // Intel Macs have Intel or AMD graphics, and only Apple silicon supports
  // ASTC textures. Nothing here leaves the page.
  async function detect(): Promise<{ mac: boolean; arm: boolean | null }> {
    const nav = navigator as Navigator & {
      userAgentData?: { platform: string; getHighEntropyValues(h: string[]): Promise<{ architecture?: string }> };
    };
    const platform = nav.userAgentData?.platform ?? navigator.platform;
    // iPads ask for desktop sites and report a Mac, but have a touch screen.
    const mac = /mac/i.test(platform) && navigator.maxTouchPoints < 2;
    if (!mac) return { mac, arm: null };
    try {
      const { architecture } = (await nav.userAgentData?.getHighEntropyValues(["architecture"])) ?? {};
      if (architecture) return { mac, arm: architecture !== "x86" };
    } catch {}
    try {
      const gl = document.createElement("canvas").getContext("webgl");
      if (gl) {
        const info = gl.getExtension("WEBGL_debug_renderer_info");
        const gpu = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : "";
        if (/intel|amd|radeon|nvidia/i.test(gpu)) return { mac, arm: false };
        if (/apple m\d/i.test(gpu) || gl.getExtension("WEBGL_compressed_texture_astc")) return { mac, arm: true };
      }
    } catch {}
    return { mac, arm: null };
  }

  const { mac, arm } = await detect();
  root.dataset.state = !mac ? "other" : arm === false ? "intel" : arm ? "mac" : "pick";

  // Start the download once per visit, and only on a Mac known to have Apple
  // silicon, so reloading or coming back doesn't download it again. The disk
  // image is served as an attachment, so the page stays put. The sample
  // release has nothing to download.
  const key = `rac-download-${data.version}`;
  let started = false;
  try {
    started = sessionStorage.getItem(key) !== null;
    sessionStorage.setItem(key, "1");
  } catch {}
  if (arm && !started && !data.sample) setTimeout(() => (location.href = data.url), 600);

  root.querySelectorAll<HTMLAnchorElement>("a[data-get]").forEach((a) =>
    a.addEventListener("click", () => (root.dataset.state = "started")),
  );

  root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) =>
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = "Copied";
      } catch {
        b.textContent = "Couldn’t copy";
      }
      setTimeout(() => (b.textContent = "Copy"), 1400);
    }),
  );
</script>

<style>
  [data-for] {
    display: none;
  }

  .dl[data-state="nojs"] [data-for="nojs"],
  .dl[data-state="mac"] [data-for="mac"],
  .dl[data-state="pick"] [data-for="pick"],
  .dl[data-state="intel"] [data-for="intel"],
  .dl[data-state="started"] [data-for="started"],
  .dl[data-state="other"] [data-for="other"] {
    display: inline;
  }

  /* Dia's note: one quiet line in a capsule. */
  .badge {
    display: inline-flex;
    max-width: 100%;
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .badge a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    text-underline-offset: 0.2em;
  }

  .get-button,
  .all-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    font-weight: 500;
    cursor: pointer;
  }

  .get-button {
    background: var(--button);
    color: var(--button-ink);
  }

  /* Only quiet previews (before 0.2.0) carry this. */
  .preview {
    display: inline-flex;
    padding: 4px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, #fcbf49 22%, var(--bg));
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .all-button {
    background: var(--surface);
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .get-button:hover {
      background: var(--button-hover);
    }

    .all-button:hover {
      background: var(--surface-2);
    }
  }

  /* Helium's list: soft cards, pill buttons. */
  .card {
    padding: 24px;
    border-radius: 22px;
    background: var(--surface);
  }

  .build {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6px 16px;
    padding: 14px 14px 14px 18px;
    border-radius: 14px;
    background: var(--bg);
  }

  .get {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--button);
    color: var(--button-ink);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  @media (hover: hover) and (pointer: fine) {
    .get:hover {
      background: var(--button-hover);
    }
  }

  .sha {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .sha code {
    min-width: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
  }

  .copy {
    flex: none;
    min-width: 58px;
    height: 26px;
    margin-left: auto;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
  }
</style>

---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import installWindow from "../assets/install-window.png";
import { RELEASE_READY, REPO_URL } from "../config";
---

<Base title="Download · rac" description="Download rac for macOS. Apple silicon and Intel, macOS 13 or later.">
  <section class="frame grid gap-x-10 gap-y-14 py-[clamp(56px,9vw,128px)] lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h1 class="display-xl">Download rac</h1>
      <p class="text-lede mt-8 max-w-[34ch]">
        {
          RELEASE_READY
            ? "Open the disk image and drag rac to Applications. That’s the whole install."
            : "rac isn’t out yet. Star the repo on GitHub to hear about the first release."
        }
      </p>
      <DownloadButton class="mt-10" />

      <div class="prose-rac mt-16">
        <h2>System requirements</h2>
        <ul>
          <!-- From mac_deployment_target in Chromium's build/config/mac/mac_sdk.gni, which rac builds with. -->
          <li>macOS 13 Ventura or later</li>
          <li>A Mac with Apple silicon or an Intel processor</li>
        </ul>

        <h2>Updates</h2>
        <p>
          rac updates itself with Sparkle. It checks rac’s own feed on GitHub releases, and new versions arrive
          automatically. Each update is signed, so rac only installs real releases. You can turn update checks off on
          the About rac page.
        </p>

        <h2>Build it yourself</h2>
        <p>
          rac is open source. The <a class="text-link" href={REPO_URL}>repository</a> has everything you need to
          build it from source.
        </p>
      </div>
    </div>

    <figure class="lg:col-span-6 lg:col-start-7 lg:mt-3">
      <Image
        src={installWindow}
        alt="rac's install window: a blue field that reads “To install, drag rac to Applications.”"
        widths={[640, 960, 1360]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-[18px]"
        loading="eager"
      />
      <figcaption class="mt-4 text-[0.9375rem] text-(--ink-2)">The install window, after you open the disk image.</figcaption>
    </figure>
  </section>
</Base>

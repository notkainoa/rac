---
import Base from "../../layouts/Base.astro";
import Cite from "../../components/compare/Cite.astro";
import CompareTable, { type Row } from "../../components/compare/CompareTable.astro";
import Sources, { type Source } from "../../components/compare/Sources.astro";
import { HELIUM_URL } from "../../config";

// Every claim about Helium below cites one of these, by number.
const sources: Source[] = [
  { title: "Helium README.", url: "https://github.com/imputnet/helium" },
  { title: "Helium home page.", url: "https://helium.computer/" },
  { title: "Helium for macOS, latest release.", url: "https://github.com/imputnet/helium-macos/releases/latest" },
  { title: "Helium privacy policy.", url: "https://helium.computer/privacy" },
  {
    title: "Helium’s Arc importer.",
    url: "https://github.com/imputnet/helium/blob/main/patches/helium/core/add-arc-importer.patch",
  },
];

const rows: Row[] = [
  {
    label: "Platforms",
    rac: "Mac with Apple silicon (M1 or later), macOS 13 or later",
    other: "Mac (Apple silicon and Intel), Windows, and Linux",
    cite: [1, 3],
  },
  { label: "Engine", rac: "Helium, with rac’s patches on top", other: "Chromium with Google’s services taken out", cite: 2 },
  { label: "License", rac: "GPL-3.0", other: "GPL-3.0", cite: 1 },
  { label: "Account", rac: "None", other: "None. No sync yet", cite: 2 },
  // AI wording needs Core sign-off (G7)
  { label: "AI", rac: "Optional, off by default", other: "None described on Helium’s site", cite: 2 },
  // AI wording needs Core sign-off (G7)
  { label: "Tabs", rac: "Spaces, Arc-style pinned tabs, and favorites", other: "Vertical tabs, split view, and tab groups", cite: 2 },
  { label: "Import from Arc", rac: "Spaces, pinned tabs, favorites, and themes", other: "Brings your Arc sidebar in as bookmarks", cite: 5 },
  { label: "Ad blocking", rac: "Helium’s, built in", other: "Ads, trackers, and cookie banners blocked by default", cite: 2 },
  { label: "Price", rac: "Free", other: "Free", cite: 2 },
];
---

<Base title="rac and Helium · rac" description="rac is built on Helium. How the two differ, and when Helium is the better pick.">
  <article class="frame grid gap-x-10 py-[clamp(56px,9vw,128px)] lg:grid-cols-12">
    <header class="self-start lg:sticky lg:top-10 lg:col-span-5">
      <p class="text-[0.9375rem] font-medium text-(--ink-2)"><a class="text-link" href="/compare">Compare</a></p>
      <h1 class="display-xl mt-4">rac and Helium</h1>
      <p class="text-lede mt-8 max-w-[34ch]">rac is Helium with Arc’s ideas on top. If you don’t want those, use Helium.</p>
    </header>

    <div class="prose-rac mt-14 lg:col-span-6 lg:col-start-7 lg:mt-3">
      <p>
        <a class="text-link" href={HELIUM_URL}>Helium</a> is a private, open-source Chromium browser that branched off
        ungoogled-chromium.<Cite n={1} /> rac is built on it: every rac build is Helium, with rac’s changes applied as
        patches after Helium’s. So the two share their privacy, their ad blocking, and their engine. rac adds Arc-style
        spaces, pinned tabs, favorites, a hiding sidebar, and Arc import. Helium runs on more computers and
        stays plainer.
      </p>

      <CompareTable other="Helium" rows={rows} caption="rac and Helium, side by side" />

      <h2>Where rac is different</h2>
      <ul>
        <li>
          Spaces, each with its own tabs and color, plus Arc-style pinned tabs and favorites. Press <kbd>⌘S</kbd> to hide
          the sidebar.
        </li>
        <li>
          Arc import keeps your spaces, pinned tabs, favorites, and themes. Helium’s own Arc import brings the sidebar in
          as bookmarks.<Cite n={5} />
        </li>
        {/* AI wording needs Core sign-off (G7) */}
        <li>
          An optional AI assistant and agent, off by default. With it off, no AI appears anywhere. With it on, you bring
          your own model or provider, and the agent asks before it acts once it reads a second site or follows a link to
          a new one.
        </li>
        {/* AI wording needs Core sign-off (G7) */}
        <li>
          rac updates through its own feed on rac’s GitHub releases. It still uses Helium’s services, such as extension
          downloads and filter lists, after you agree on Helium’s consent screen.<Cite n={4} /> See <a class="text-link" href="/privacy"
            >Privacy</a
          >.
        </li>
      </ul>

      <h2>Where Helium is better or does more</h2>
      <ul>
        <li>Helium runs on Windows and Linux, and on Intel Macs as well as Apple silicon.<Cite n={[1, 3]} /> rac is Apple silicon only.</li>
        <li>Helium comes first. rac is built on it, so Helium’s fixes and features reach rac after they ship in Helium.</li>
        <li>
          Helium is plainer, with no spaces to set up. It supports all Chromium extensions,
          customizable shortcuts, and !bangs.<Cite n={2} />
        </li>
      </ul>

      <h2>Who should pick which</h2>
      <p>
        If you want a private Chromium browser and don’t miss Arc, use Helium. It’s the better pick for most people
        who don’t want Arc-style features, and it’s the one to use on Windows, Linux, or an Intel Mac. If you want Arc’s
        spaces, pinned tabs, and hiding sidebar on top of Helium, try rac.
      </p>

      <Sources sources={sources} checked="2026-10-28" />
    </div>
  </article>
</Base>

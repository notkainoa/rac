---
import Base from "../../layouts/Base.astro";
import Cite from "../../components/compare/Cite.astro";
import CompareTable, { type Row } from "../../components/compare/CompareTable.astro";
import Sources, { type Source } from "../../components/compare/Sources.astro";

// Every claim about Dia below cites one of these, by number.
const sources: Source[] = [
  { title: "Dia home page.", url: "https://www.diabrowser.com/" },
  { title: "Dia pricing.", url: "https://www.diabrowser.com/pricing" },
  { title: "Dia security.", url: "https://www.diabrowser.com/security" },
  { title: "Dia Terms of Use.", url: "https://www.diabrowser.com/termsofuse" },
  { title: "Dia, after you download.", url: "https://www.diabrowser.com/download/thanks" },
  { title: "The Browser Company, “A farewell to Arc.”", url: "https://arc.net/" },
];

const rows: Row[] = [
  { label: "Platforms", rac: "Mac with Apple silicon (M1 or later), macOS 13 or later", other: "Mac and Windows", cite: 1 },
  { label: "Engine", rac: "Chromium, through Helium", other: "Chromium", cite: 3 },
  { label: "Source code", rac: "Open source, GPL-3.0", other: "Closed source", cite: 4 },
  { label: "Account", rac: "None. rac has no accounts", other: "Setup starts by creating an account", cite: 5 },
  // AI wording needs Core sign-off (G7)
  { label: "AI", rac: "Off by default. You bring your own model or provider", other: "Built in, with AI plans to buy. Dia’s pricing and download pages differ on how much AI the free plan has", cite: [2, 5] },
  { label: "AI requests", rac: "Go straight to the provider you pick", other: "Go through Dia’s servers to its AI partners", cite: 3 },
  // AI wording needs Core sign-off (G7)
  { label: "Spaces", rac: "Spaces in one window", other: "Profiles. Arc spaces become profiles on import", cite: [1, 6] },
  { label: "Pinned tabs", rac: "Yes", other: "Yes", cite: 6 },
  { label: "Import from Arc", rac: "Spaces stay spaces, with pinned tabs, favorites, and themes", other: "Spaces become profiles and folders become tab groups. Pinned tabs and favorites keep their names", cite: 6 },
  // AI wording needs Core sign-off (G7)
  { label: "Price", rac: "Free", other: "Free browser. AI plans at $10 and $100 a month", cite: 2 },
  // AI wording needs Core sign-off (G7)
];
---

<Base title="rac and Dia · rac" description="How rac compares with Dia, The Browser Company’s AI browser: where each one is different, and who should pick which.">
  <article class="frame grid gap-x-10 py-[clamp(56px,9vw,128px)] lg:grid-cols-12">
    <header class="self-start lg:sticky lg:top-10 lg:col-span-5">
      <p class="text-[0.9375rem] font-medium text-(--ink-2)"><a class="text-link" href="/compare">Compare</a></p>
      <h1 class="display-xl mt-4">rac and Dia</h1>
      <p class="text-lede mt-8 max-w-[34ch]">Two calm browsers that start from Arc and go different ways.</p>
    </header>

    <div class="prose-rac mt-14 lg:col-span-6 lg:col-start-7 lg:mt-3">
      <!-- AI wording needs Core sign-off (G7) -->
      <p>
        Dia is The Browser Company’s AI browser, for Mac and Windows, and the browser it points Arc users to.<Cite
          n={[1, 6]}
        /> Dia describes itself as an AI web browser, and it sells AI plans on top of the free browser.<Cite n={[2, 5]} /> rac is an open-source Mac browser
        built on Helium. It keeps Arc’s spaces as spaces, and its AI stays off unless you turn it on.
      </p>
      <!-- AI wording needs Core sign-off (G7) -->

      <CompareTable other="Dia" rows={rows} caption="rac and Dia, side by side" />

      <h2>Where rac is different</h2>
      <ul>
        <li>rac is open source under GPL-3.0. Anyone can read what it does with your browsing.</li>
        <li>
          There are no rac accounts, no telemetry, and no ads, and nothing in rac phones home to rac. Dia says that by
          default it uses some content data to improve Dia, and that you can turn this off in its privacy
          settings.<Cite n={3} />
        </li>
        <!-- AI wording needs Core sign-off (G7) -->
        <li>
          AI is off by default, and with it off, no AI appears anywhere. If you turn it on, you bring your own model or
          provider: OpenAI, Anthropic, Google, OpenRouter, a local model in Ollama or LM Studio, or an agent you already
          have, like Claude Code or Codex.
        </li>
        <li>
          rac’s agent works on its own on the site you start it on. Once it reads a second site, or follows a link to a
          new one, it asks before it acts.
        </li>
        <!-- AI wording needs Core sign-off (G7) -->
        <li>
          Arc import keeps your spaces as spaces in one window, with their pinned tabs, favorites, and themes. Dia turns
          them into profiles.<Cite n={6} />
        </li>
      </ul>

      <h2>Where Dia is better or does more</h2>
      <ul>
        <li>Dia runs on Windows as well as the Mac.<Cite n={1} /> rac is Mac only, on Apple silicon.</li>
        <li>The free Dia browser includes cross-device sync.<Cite n={2} /> rac has no sync.</li>
        <!-- AI wording needs Core sign-off (G7) -->
        <li>
          Dia’s AI is built in, with features like a Morning Brief and turning your scattered context into slides. New
          users start with a 14-day trial of its top plan.<Cite n={[1, 2]} /> rac’s AI needs your own provider first.
        </li>
        <!-- AI wording needs Core sign-off (G7) -->
        <li>Dia for Work adds single sign-on and admin tools for teams.<Cite n={1} /></li>
        <li>
          Dia comes from the team that made Arc, and its Arc import also brings passwords, bookmarks, extensions, and
          history.<Cite n={6} />
        </li>
      </ul>

      <h2>Who should pick which</h2>
      <!-- AI wording needs Core sign-off (G7) -->
      <p>
        If you want AI at the center of your browser, need Windows or sync, or want to stay with the people who made
        Arc, pick Dia. If you want Arc’s spaces kept as spaces, no account, and AI only when you choose it, with a
        model you pick, try rac. If you don’t want Arc’s ideas or AI at all, <a class="text-link" href="/compare/helium"
          >Helium</a
        > is a plain, private browser that rac is built on.
      </p>
      <!-- AI wording needs Core sign-off (G7) -->

      <Sources sources={sources} checked="2026-10-28" />
    </div>
  </article>
</Base>

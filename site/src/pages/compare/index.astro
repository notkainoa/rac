---
import Base from "../../layouts/Base.astro";

const pages = [
  { href: "/compare/arc", name: "rac and Arc", blurb: "What carries over from Arc, and what doesn’t." },
  { href: "/compare/dia", name: "rac and Dia", blurb: "Two calm browsers that start from Arc and go different ways." },
  { href: "/compare/helium", name: "rac and Helium", blurb: "The browser rac is built on, and when it’s the better pick." },
];
---

<Base title="Compare · rac" description="How rac compares with Arc, Dia, and Helium, fairly and with sources.">
  <article class="frame grid gap-x-10 py-[clamp(56px,9vw,128px)] lg:grid-cols-12">
    <header class="self-start lg:sticky lg:top-10 lg:col-span-5">
      <h1 class="display-xl">Compare</h1>
      <p class="text-lede mt-8 max-w-[34ch]">
        How rac stacks up against the browsers it’s closest to. Every claim about another browser links to its source.
      </p>
    </header>

    <ul class="mt-14 grid gap-1 self-start lg:col-span-6 lg:col-start-7 lg:mt-3">
      {
        pages.map((page) => (
          <li>
            <a href={page.href} class="press group block rounded-2xl bg-(--surface) px-6 py-5 hover:bg-(--surface-2)">
              <span class="title-m block">{page.name}</span>
              <span class="mt-1 block text-(--ink-2)">{page.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</Base>

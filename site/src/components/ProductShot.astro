---
// A place for a real screenshot of rac. Until the UI settles, each slot holds
// an illustration drawn in code that stays true as the details change.
//
// TODO: replace the illustration in each slot with a real screenshot, in
// light and dark, once rac's UI is stable. `name` says which one goes here.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<div data-product-shot={name} class={className}>
  <slot />
</div>

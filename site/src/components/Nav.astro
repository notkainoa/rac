---
import Wordmark from "./Wordmark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { REPO_URL } from "../config";

const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: "/privacy", label: "Privacy" },
  { href: "/download", label: "Download" },
  { href: REPO_URL, label: "GitHub" },
];
---

<header class="frame relative z-10 flex h-[72px] items-center justify-between gap-4">
  <a href="/" class="press -ml-1 rounded-md p-1" aria-label="rac home">
    <Wordmark class="h-[22px] w-auto" title="rac" />
  </a>
  <nav aria-label="Main" class="-mr-2 flex items-center sm:mr-0 sm:gap-2">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
          class="press rounded-full px-2 py-1.5 text-[0.9375rem] text-(--ink-2) hover:text-(--ink) aria-[current=page]:text-(--ink) sm:px-3"
        >
          {link.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

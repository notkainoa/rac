---
import { Image } from "astro:assets";
import Wordmark from "./Wordmark.astro";
import appIcon from "../assets/app-icon-mark.png";
import ThemeToggle from "./ThemeToggle.astro";
import { RELEASE_READY, REPO_URL } from "../config";

const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: "/privacy", label: "Privacy" },
  ...(RELEASE_READY ? [{ href: "/download", label: "Download" }] : []),
  { href: REPO_URL, label: "GitHub" },
];
---

<header class="frame relative z-10 flex h-[72px] items-center justify-between gap-2 min-[400px]:gap-4">
  <a href="/" class="press -ml-1 flex shrink-0 items-center gap-2.5 rounded-md p-1" aria-label="rac home">
    <Image src={appIcon} alt="" width={30} height={30} densities={[1, 2]} loading="eager" class="size-[30px] shrink-0" />
    <Wordmark class="h-[20px] w-auto max-[399px]:hidden" title="rac" />
  </a>
  <nav aria-label="Main" class="-mr-2 flex items-center sm:mr-0 sm:gap-2">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
          class="press rounded-full px-1.5 py-1.5 text-[0.9375rem] min-[400px]:px-2 text-(--ink-2) hover:text-(--ink) aria-[current=page]:text-(--ink) sm:px-3"
        >
          {link.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

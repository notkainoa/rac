---
import Wordmark from "./Wordmark.astro";
import { HELIUM_URL, LICENSE_URL, RELEASES_URL, REPO_URL } from "../config";

const links = [
  { href: REPO_URL, label: "GitHub" },
  { href: RELEASES_URL, label: "Releases" },
  { href: LICENSE_URL, label: "License (GPL-3.0)" },
  { href: "/privacy", label: "Privacy" },
  { href: "/arc", label: "Moving from Arc" },
  { href: "/compare", label: "Compare" },
];
---

<footer class="bg-(--surface)">
  <div class="frame pt-24 pb-10 sm:pt-32">
    <Wordmark class="h-auto w-full text-(--ink)" title="rac" />
    <div class="mt-12 flex flex-col gap-8 text-[0.9375rem] sm:mt-16 md:flex-row md:items-end md:justify-between">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-(--ink-2)">
        rac is arc, scrambled. Built on <a href={HELIUM_URL} class="text-link">Helium</a>.
        Made by <a href="https://github.com/notkainoa" class="text-link">Kainoa Newton</a>.
      </p>
    </div>
  </div>
</footer>

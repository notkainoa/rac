---
// Cycles system → light → dark. The choice stays in this browser's
// localStorage; nothing leaves the device.
---

<button
  type="button"
  data-theme-toggle
  class="press grid size-9 place-items-center rounded-full text-(--ink) hover:bg-(--surface)"
  aria-label="Change color theme"
>
  <svg data-icon="system" aria-hidden="true" viewBox="0 0 20 20" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.6">
    <circle cx="10" cy="10" r="6.5" />
    <path d="M10 3.5a6.5 6.5 0 0 1 0 13Z" fill="currentColor" stroke="none" />
  </svg>
  <svg data-icon="light" aria-hidden="true" viewBox="0 0 20 20" class="hidden size-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="10" cy="10" r="3.5" />
    <path d="M10 2v1.8M10 16.2V18M2 10h1.8M16.2 10H18M4.3 4.3l1.3 1.3M14.4 14.4l1.3 1.3M4.3 15.7l1.3-1.3M14.4 5.6l1.3-1.3" />
  </svg>
  <svg data-icon="dark" aria-hidden="true" viewBox="0 0 20 20" class="hidden size-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
    <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" />
  </svg>
</button>

<script>
  const order = ["system", "light", "dark"] as const;
  type Choice = (typeof order)[number];
  const names: Record<Choice, string> = { system: "System", light: "Light", dark: "Dark" };

  function current(): Choice {
    const saved = window.racTheme.get();
    return saved === "light" || saved === "dark" ? saved : "system";
  }

  function render() {
    const choice = current();
    const next = order[(order.indexOf(choice) + 1) % order.length];
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute("aria-label", `Color theme: ${names[choice]}. Switch to ${names[next]}`);
      button.title = `Theme: ${names[choice]}`;
      for (const icon of button.querySelectorAll<SVGElement>("[data-icon]")) {
        icon.classList.toggle("hidden", icon.dataset.icon !== choice);
      }
    }
  }

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = order[(order.indexOf(current()) + 1) % order.length];
      window.racTheme.set(next === "system" ? null : next);
      render();
    });
  }
  render();
</script>

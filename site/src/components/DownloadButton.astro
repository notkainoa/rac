---
import { RELEASE_READY, REPO_URL } from "../config";
import { PLATFORM } from "../lib/release";

interface Props {
  center?: boolean;
  class?: string;
}
const { center = false, class: className } = Astro.props;
const href = RELEASE_READY ? "/download" : REPO_URL;
const label = RELEASE_READY ? "Download for macOS" : "Coming soon, star the repo";
const note = PLATFORM;
---

<div class:list={["flex flex-col gap-3", center ? "items-center" : "items-start", className]}>
  <a
    href={href}
    class="press inline-flex h-14 items-center gap-3 rounded-full bg-(--button) pr-7 pl-6 text-[1.0625rem] font-medium text-(--button-ink) hover:bg-(--button-hover)"
  >
    <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {RELEASE_READY ? (
        <path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" />
      ) : (
        <path d="m10 2.8 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 8l5-.7L10 2.8Z" />
      )}
    </svg>
    {label}
  </a>
  <p class:list={["text-[0.875rem] text-(--ink-2)", !center && "pl-6"]}>{note}</p>
</div>

---
import { RELEASE_READY, RELEASES_URL, REPO_URL } from "../config";

interface Props {
  size?: "lg" | "sm";
  class?: string;
}
const { size = "lg", class: className } = Astro.props;
const href = RELEASE_READY ? RELEASES_URL : REPO_URL;
const label = RELEASE_READY ? "Download for macOS" : "Coming soon, star the repo";
const note = RELEASE_READY ? "Apple silicon and Intel" : "For Apple silicon and Intel Macs";
---

{
  size === "sm" ? (
    <a
      href={href}
      class:list={[
        "press inline-flex h-9 items-center rounded-full bg-action px-4 text-[0.875rem] font-medium text-white hover:bg-action-hover",
        className,
      ]}
    >
      {RELEASE_READY ? "Download" : "Star on GitHub"}
    </a>
  ) : (
    <div class:list={["flex flex-col items-start gap-3", className]}>
      <a
        href={href}
        class="press inline-flex h-14 items-center gap-3 rounded-full bg-action pr-7 pl-6 text-[1.0625rem] font-medium text-white hover:bg-action-hover"
      >
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          {RELEASE_READY ? (
            <path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" />
          ) : (
            <path d="m10 2.8 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 8l5-.7L10 2.8Z" />
          )}
        </svg>
        {label}
      </a>
      <p class="pl-6 text-[0.875rem] text-(--ink-2)">{note}</p>
    </div>
  )
}

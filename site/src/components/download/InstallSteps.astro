---
import { Image } from "astro:assets";
import appIcon from "../../assets/app-icon-mark.png";
import installWindow from "../../assets/install-window.png";

// The three steps after the download, drawn the way macOS shows them: the
// Downloads stack in the Dock, rac's own install window, and Finder's
// Applications folder. Sizes are in em; 1em is 1/32 of a card's width.
---

<ol class="steps" aria-label="How to install rac" data-reveal>
  <li class="step">
    <div class="art art-dock" aria-hidden="true">
      <div class="dock-stack">
        <span class="stack-file">
          <svg viewBox="0 0 64 80"><path class="dmg-page" d="M10 3h31l20 20v50a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Z" /><path class="dmg-fold" d="M41 3v15a5 5 0 0 0 5 5h15" /></svg>
        </span>
        <span class="dmg-file">
          <svg viewBox="0 0 64 80"><path class="dmg-page" d="M10 3h31l20 20v50a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Z" /><path class="dmg-fold" d="M41 3v15a5 5 0 0 0 5 5h15" /><rect class="dmg-drive" x="17" y="38" width="30" height="18" rx="4" /><circle class="dmg-led" cx="40" cy="47" r="1.8" /></svg>
          <span class="dmg-name">rac.dmg</span>
        </span>
      </div>
      <div class="dock">
        <i class="dock-divider"></i>
        <svg class="dock-item dock-folder" viewBox="0 0 100 80"><path class="folder-back" d="M6 14a8 8 0 0 1 8-8h20.6a8 8 0 0 1 5.6 2.3L45 13h41a8 8 0 0 1 8 8v45a8 8 0 0 1-8 8H14a8 8 0 0 1-8-8Z" /><path class="folder-front" d="M6 27a8 8 0 0 1 8-8h72a8 8 0 0 1 8 8v39a8 8 0 0 1-8 8H14a8 8 0 0 1-8-8Z" /><g class="folder-glyph"><circle cx="50" cy="47" r="13" /><path d="M50 40v13.5M44.5 48 50 53.5 55.5 48" /></g></svg>
        <svg class="dock-item dock-trash" viewBox="0 0 80 92"><path class="trash-can" d="M15 20h50l-5 63a6 6 0 0 1-6 5.5H26a6 6 0 0 1-6-5.5Z" /><rect class="trash-rim" x="10" y="12" width="60" height="10" rx="5" /><path class="trash-ribs" d="M30 30l2 50M40 30v50M50 30l-2 50" /></svg>
      </div>
    </div>
    <p class="caption"><span class="num">1</span> Open <b>rac.dmg</b> from your <b>Downloads</b></p>
  </li>

  <li class="step">
    <div class="art art-drag" aria-hidden="true">
      <div class="dmg-window">
        <div class="win-bar"><span class="lights"><i></i><i></i><i></i></span>rac</div>
        <div class="win-body">
          <Image src={installWindow} alt="" widths={[480, 720]} sizes="(min-width: 1024px) 340px, 90vw" class="win-bg" />
          <span class="drop drop-app">
            <Image src={appIcon} alt="" width={64} height={64} densities={[1, 2]} class="drop-icon" />
            <span>rac</span>
          </span>
          <span class="drop drop-apps">
            <i class="drop-target"></i>
            <svg class="drop-icon" viewBox="0 0 100 80"><path class="folder-back" d="M6 14a8 8 0 0 1 8-8h20.6a8 8 0 0 1 5.6 2.3L45 13h41a8 8 0 0 1 8 8v45a8 8 0 0 1-8 8H14a8 8 0 0 1-8-8Z" /><path class="folder-front" d="M6 27a8 8 0 0 1 8-8h72a8 8 0 0 1 8 8v39a8 8 0 0 1-8 8H14a8 8 0 0 1-8-8Z" /><path class="folder-glyph" d="M41 57 50 35l9 22M44.5 49h11" /></svg>
            <span>Applications</span>
          </span>
          <span class="ghost">
            <Image src={appIcon} alt="" width={64} height={64} densities={[1, 2]} class="drop-icon" />
            <svg class="cursor" viewBox="0 0 24 24"><path d="M5 2.5 19 12l-6.3 1.3 3.7 6.7-2.7 1.5-3.7-6.7L5 19.4Z" /></svg>
          </span>
        </div>
      </div>
    </div>
    <p class="caption"><span class="num">2</span> Drag <b>rac</b> into <b>Applications</b></p>
  </li>

  <li class="step">
    <div class="art art-finder" aria-hidden="true">
      <div class="finder">
        <div class="finder-side">
          <span class="lights"><i></i><i></i><i></i></span>
          <span class="side-head">Favorites</span>
          <span class="side-item"><i class="side-ico"></i>Recents</span>
          <span class="side-item is-on"><i class="side-ico"></i>Applications</span>
          <span class="side-item"><i class="side-ico"></i>Desktop</span>
          <span class="side-item"><i class="side-ico"></i>Documents</span>
          <span class="side-item"><i class="side-ico"></i>Downloads</span>
        </div>
        <div class="finder-main">
          <div class="finder-bar">Applications</div>
          <span class="row"><i style="--c:#8e8e93"></i>Calculator</span>
          <span class="row"><i style="--c:#f05b4f"></i>Calendar</span>
          <span class="row"><i style="--c:#f6c445"></i>Notes</span>
          <span class="row is-on"><Image src={appIcon} alt="" width={32} height={32} densities={[1, 2]} class="row-icon" />rac</span>
          <span class="row"><i style="--c:#7f8a99"></i>System Settings</span>
          <span class="row"><i style="--c:#c9ccd2"></i>TextEdit</span>
        </div>
        <div class="finder-preview">
          <Image src={appIcon} alt="" width={96} height={96} densities={[1, 2]} class="preview-icon" />
          <b>rac</b>
          <span>Application</span>
        </div>
      </div>
    </div>
    <p class="caption"><span class="num">3</span> Open <b>rac</b> from <b>Applications</b></p>
  </li>
</ol>

<style>
  .steps {
    display: grid;
    gap: 20px;
    max-width: 1080px;
    margin-inline: auto;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step {
    container-type: inline-size;
  }

  .art {
    --win: #ffffff;
    --win-2: #f5f5f7;
    --win-line: rgb(0 0 0 / 0.08);
    --win-ink: #1d1d1f;
    --win-ink-2: #6e6e73;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 20px;
    background: var(--surface);
    font-size: calc(100cqi / 32);
    color: var(--win-ink);
    user-select: none;
  }

  :global([data-theme="dark"]) .art {
    --win: #2a2a2c;
    --win-2: #222224;
    --win-line: rgb(255 255 255 / 0.09);
    --win-ink: #f2f2f2;
    --win-ink-2: #98989d;
  }

  .caption {
    margin-top: 18px;
    color: var(--ink-2);
    text-align: center;
    text-wrap: balance;
  }

  .caption b {
    color: var(--ink);
    font-weight: 600;
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    margin-right: 0.35em;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    font-size: 0.8125em;
    font-weight: 600;
    vertical-align: 0.1em;
  }

  .lights {
    display: inline-flex;
    gap: 0.45em;
  }

  .lights i {
    width: 0.85em;
    height: 0.85em;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  /* Shared macOS folder icon. */
  .folder-back {
    fill: #4fa2f2;
  }

  .folder-front {
    fill: #84c3fb;
  }

  .folder-glyph {
    fill: none;
    stroke: #2f80d6;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 1: the Dock, with the Downloads stack fanned open. */
  .dock {
    position: absolute;
    left: 3.2em;
    bottom: 6em;
    display: flex;
    align-items: flex-end;
    gap: 2.2em;
    width: 40em;
    height: 9.6em;
    padding: 0 0 1.1em 2.6em;
    border-radius: 2.6em 0 0 2.6em;
    background: color-mix(in srgb, var(--win) 78%, transparent);
    box-shadow:
      inset 0 0 0 1px var(--win-line),
      0 1.4em 3em -1.2em rgb(0 0 0 / 0.25);
  }

  .dock-divider {
    align-self: center;
    width: 2px;
    height: 6em;
    margin-right: 0.6em;
    border-radius: 1px;
    background: var(--win-line);
  }

  .dock-item {
    flex: none;
    width: 7.4em;
    height: auto;
  }

  .dock-trash {
    width: 6em;
  }

  .trash-can {
    fill: color-mix(in srgb, var(--win-2) 70%, #c7ccd4);
    stroke: rgb(0 0 0 / 0.14);
    stroke-width: 1.5;
  }

  .trash-rim {
    fill: color-mix(in srgb, var(--win) 60%, #dfe3e8);
    stroke: rgb(0 0 0 / 0.14);
    stroke-width: 1.5;
  }

  .trash-ribs {
    stroke: rgb(0 0 0 / 0.1);
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .dock-stack {
    position: absolute;
    left: 12.4em;
    bottom: 16.6em;
    width: 0;
  }

  .stack-file,
  .dmg-file {
    position: absolute;
    bottom: 0;
    left: 0;
  }

  .stack-file {
    transform: translate(-95%, 0.6em) rotate(-14deg);
    opacity: 0.7;
  }

  .stack-file svg {
    width: 4.6em;
  }

  .dmg-file {
    display: grid;
    justify-items: center;
    gap: 0.5em;
    transform: translateX(-35%) rotate(4deg);
  }

  .dmg-file svg {
    width: 6.2em;
    filter: drop-shadow(0 0.3em 0.6em rgb(0 0 0 / 0.16));
  }

  .dmg-page {
    fill: #fff;
    stroke: rgb(0 0 0 / 0.12);
    stroke-width: 1.4;
  }

  .dmg-fold {
    fill: #eceef2;
    stroke: rgb(0 0 0 / 0.12);
    stroke-width: 1.4;
  }

  .dmg-drive {
    fill: #c9ced6;
  }

  .dmg-led {
    fill: #fff;
  }

  .dmg-name {
    padding: 0.1em 0.6em;
    border-radius: 0.4em;
    background: #1a66d9;
    color: #fff;
    font-size: 1.2em;
    font-weight: 500;
  }

  /* 2: rac's install window, with the icon on its way to Applications. */
  .dmg-window {
    position: absolute;
    inset: 4em -0.5em 4em 3em;
    overflow: hidden;
    border-radius: 1.2em;
    background: var(--win);
    box-shadow:
      0 0 0 1px var(--win-line),
      0 1.6em 3.4em -1.4em rgb(0 0 0 / 0.35);
  }

  .win-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3em;
    font-size: 1.15em;
    font-weight: 600;
  }

  .win-bar .lights {
    position: absolute;
    left: 1em;
    font-size: 0.87em;
  }

  .win-body {
    position: absolute;
    inset: 3.45em 0 0;
  }

  .win-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 0;
  }

  .drop {
    position: absolute;
    top: 52%;
    display: grid;
    justify-items: center;
    gap: 0.5em;
    width: 9em;
    color: #fff;
    font-size: 1em;
    font-weight: 600;
    text-shadow: 0 1px 2px rgb(0 0 40 / 0.35);
    transform: translate(-50%, -50%);
  }

  .drop-app {
    left: 22%;
  }

  .drop-apps {
    left: 76%;
  }

  .drop-icon {
    width: 6.4em;
    height: auto;
  }

  .drop-app .drop-icon {
    opacity: 0.55;
  }

  .drop-apps {
    isolation: isolate;
  }

  .drop-target {
    position: absolute;
    inset: -0.6em 0.4em 1.8em;
    z-index: -1;
    border-radius: 1em;
    background: rgb(0 20 80 / 0.22);
  }

  .ghost {
    position: absolute;
    top: 44%;
    left: 59%;
    width: 6.4em;
    transform: translate(-50%, -50%) rotate(-6deg);
    filter: drop-shadow(0 0.6em 1em rgb(0 0 40 / 0.35));
  }

  .ghost .drop-icon {
    opacity: 0.92;
  }

  .cursor {
    position: absolute;
    right: -0.4em;
    bottom: -0.8em;
    width: 2.6em;
    transform: rotate(6deg);
  }

  .cursor path {
    fill: #111;
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  /* Played once, when the card scrolls into view. */
  :global(.js) .art-drag .ghost {
    animation: drag 1.6s var(--ease-in-out) 0.4s both paused;
  }

  :global(.js) .art-drag .drop-target {
    animation: target 1.6s linear 0.4s both paused;
  }

  :global(.js) .is-in .art-drag :is(.ghost, .drop-target) {
    animation-play-state: running;
  }

  @keyframes target {
    0%,
    80% {
      opacity: 0;
    }
  }

  @keyframes drag {
    from {
      left: 22%;
      top: 52%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.95);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .art-drag :is(.ghost, .drop-target) {
      animation: none;
    }
  }

  /* 3: Finder, Applications open, rac selected. */
  .finder {
    position: absolute;
    inset: 4.6em -1em 4.6em 2.6em;
    display: grid;
    grid-template-columns: 9.6em 1fr 8.6em;
    overflow: hidden;
    border-radius: 1.2em;
    background: var(--win);
    box-shadow:
      0 0 0 1px var(--win-line),
      0 1.6em 3.4em -1.4em rgb(0 0 0 / 0.35);
    font-size: 1em;
  }

  .finder-side {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    padding: 1em 0.7em;
    background: var(--win-2);
  }

  .finder-side .lights {
    margin: 0 0 1em 0.3em;
    font-size: 0.87em;
  }

  .side-head {
    padding-left: 0.4em;
    color: var(--win-ink-2);
    font-size: 0.85em;
    font-weight: 600;
  }

  .side-item {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.4em;
    border-radius: 0.5em;
    font-size: 1em;
    white-space: nowrap;
  }

  .side-ico {
    width: 0.9em;
    height: 0.9em;
    border: 0.15em solid #3a86f0;
    border-radius: 0.25em;
  }

  .side-item.is-on {
    background: rgb(0 0 0 / 0.08);
  }

  :global([data-theme="dark"]) .side-item.is-on {
    background: rgb(255 255 255 / 0.1);
  }

  .finder-main {
    display: flex;
    flex-direction: column;
    padding: 0 0.6em;
    border-right: 1px solid var(--win-line);
  }

  .finder-bar {
    display: flex;
    align-items: center;
    height: 3.6em;
    padding-left: 0.4em;
    font-size: 1.1em;
    font-weight: 700;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.6em;
    height: 2.3em;
    padding: 0 0.5em;
    border-radius: 0.5em;
    font-size: 1em;
    white-space: nowrap;
  }

  .row i {
    width: 1.3em;
    height: 1.3em;
    border-radius: 0.32em;
    background: var(--c);
  }

  .row-icon {
    width: 1.5em;
    height: 1.5em;
    margin: -0.1em;
  }

  .row.is-on {
    background: #1a66d9;
    color: #fff;
  }

  .finder-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2em;
    padding-bottom: 1em;
  }

  .preview-icon {
    width: 6em;
    height: auto;
    margin-bottom: 0.6em;
  }

  .finder-preview b {
    font-size: 1.15em;
  }

  .finder-preview span {
    color: var(--win-ink-2);
    font-size: 0.9em;
  }
</style>

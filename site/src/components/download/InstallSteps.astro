---
import { Image } from "astro:assets";
import appIcon from "../../assets/app-icon-mark.png";
import installWindow from "../../assets/install-window.png";

// The three steps after the download, drawn the way macOS shows them: the
// Downloads stack in the Dock, rac's own install window, and Finder's
// Applications folder. Sizes are in em; 1em is 1/32 of a card's width.
// Steps 1 and 3 are laid out to the pixel from aside.com/download's art
// (892px square crops, so 1em = 27.875px there).

// Finder's sidebar: [label, icon, row center in em from the window's top].
const side: [string, string, number][] = [
  ["Recents", "M10 5.5V10l3 2M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z", 3.5],
  ["Shared", "M3 6.5a1.5 1.5 0 0 1 1.5-1.5h3l1.5 1.5h6.5A1.5 1.5 0 0 1 17 8v6.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 14.5Z", 5.1],
  ["Applications", "M6 15.5 10 4.5l4 11M7.6 11.5h4.8M4 15.5h12", 8.57],
  ["Desktop", "M3 5.5A1.5 1.5 0 0 1 4.5 4h11A1.5 1.5 0 0 1 17 5.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 12.5ZM3 11h14", 10.19],
  ["Documents", "M5 3.5h6.5L15 7v9.5H5ZM11.5 3.5V7H15", 11.8],
  ["Downloads", "M10 6v7.5M7 10.5l3 3 3-3M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z", 13.42],
  ["iCloud Drive", "M6 15h8.5a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 5.3 9.2 3 3 0 0 0 6 15Z", 16.86],
  ["Home", "M3.5 9.5 10 4l6.5 5.5M5.5 8v8h9V8M8.5 16v-4.5h3V16", 18.44],
  ["AirDrop", "M6 13.5a5 5 0 1 1 8 0M7.8 11.6a2.6 2.6 0 1 1 4.4 0M10 10.5v6", 20.05],
  ["Trash", "M4.5 6h11M8 6V4.5h4V6M6 6l.8 10h6.4L14 6", 21.67],
];
const sideHeads: [string, number][] = [
  ["Favorites", 7.25],
  ["Locations", 15.46],
];
// Finder sorts by name, which puts rac third, where Aside's art has its row.
const apps: [string, string | null][] = [
  ["Photos", "#f2a33a"],
  ["Preview", "#5aa3e8"],
  ["rac", null],
  ["Reminders", "#f05b4f"],
  ["Safari", "#3d8bf5"],
  ["Shortcuts", "#c85ae8"],
  ["Stickies", "#f6c445"],
  ["Stocks", "#3a3a3c"],
  ["System Settings", "#8e8e93"],
];
---

<ol class="steps" aria-label="How to install rac" data-reveal>
  <li class="step">
    <div class="art art-dock" aria-hidden="true">
      <span class="dock-label"><span>Downloads</span></span>
      <div class="dock"></div>
      <i class="dock-divider"></i>
      <svg class="dock-folder" viewBox="0 0 100 80"><defs><linearGradient id="folder-front" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#87c9f1" /><stop offset="1" stop-color="#64addc" /></linearGradient></defs><path class="folder-back" d="M2 9a7 7 0 0 1 7-7h22.6a7 7 0 0 1 5 2.1L41 8.5h50a7 7 0 0 1 7 7V71a7 7 0 0 1-7 7H9a7 7 0 0 1-7-7Z" /><path class="folder-front" d="M2 21a7 7 0 0 1 7-7h82a7 7 0 0 1 7 7v50a7 7 0 0 1-7 7H9a7 7 0 0 1-7-7Z" /></svg>
      <svg class="dock-doc" viewBox="0 0 64 87"><path class="doc-page" d="M4 1.5h40.5L62.5 20v62a3.5 3.5 0 0 1-3.5 3.5H4A3.5 3.5 0 0 1 .5 82V5A3.5 3.5 0 0 1 4 1.5Z" /><path class="doc-fold" d="M44.5 1.5v15A3.5 3.5 0 0 0 48 20h14.5" /><rect class="doc-drive" x="13" y="20.7" width="38.2" height="45.5" rx="3.4" /><path class="doc-lip" d="M13 60h38.2v2.8a3.4 3.4 0 0 1-3.4 3.4H16.4a3.4 3.4 0 0 1-3.4-3.4Z" /><circle class="doc-led" cx="45.5" cy="63.1" r="1.1" /><path class="doc-arrow" d="M32 29v14.5M26.2 38 32 43.8 37.8 38" /></svg>
      <svg class="dock-trash" viewBox="0 0 72 79"><defs><linearGradient id="trash-body" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9c9c9c" /><stop offset="0.5" stop-color="#bdbdbd" /><stop offset="1" stop-color="#e3e3e3" /></linearGradient><linearGradient id="trash-hole" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8e8e8e" /><stop offset="1" stop-color="#b9b9b9" /></linearGradient></defs><path d="M2.5 9.5Q2.5 2 10 2h52q7.5 0 7.5 7.5l-5 60.5q-.8 7.5-8.3 7.5H15.8q-7.5 0-8.3-7.5Z" fill="url(#trash-body)" /><path d="M8.5 14 13 69M63.5 14 59 69" stroke="#fff" stroke-opacity="0.35" stroke-width="1.6" stroke-linecap="round" fill="none" /><rect x="2" y="1.5" width="68" height="14" rx="7" fill="#ececec" /><rect x="5" y="4" width="62" height="9" rx="4.5" fill="url(#trash-hole)" /></svg>
    </div>
    <p class="caption"><span class="num">1</span> Open <b>rac.dmg</b> from your <b>Downloads</b></p>
  </li>

  <li class="step">
    <div class="art art-drag" aria-hidden="true">
      <div class="dmg-window">
        <div class="win-bar"><span class="lights"><i></i><i></i><i></i></span>rac</div>
        <div class="win-body">
          <Image src={installWindow} alt="" widths={[480, 720]} sizes="(min-width: 1024px) 340px, 90vw" class="win-bg" />
          <span class="drop drop-app">
            <Image src={appIcon} alt="" width={64} height={64} densities={[1, 2]} class="drop-icon" />
            <span>rac</span>
          </span>
          <span class="drop drop-apps">
            <i class="drop-target"></i>
            <svg class="drop-icon" viewBox="0 0 100 80"><path class="folder-back" d="M6 14a8 8 0 0 1 8-8h20.6a8 8 0 0 1 5.6 2.3L45 13h41a8 8 0 0 1 8 8v45a8 8 0 0 1-8 8H14a8 8 0 0 1-8-8Z" /><path class="folder-front" d="M6 27a8 8 0 0 1 8-8h72a8 8 0 0 1 8 8v39a8 8 0 0 1-8 8H14a8 8 0 0 1-8-8Z" /><path class="folder-glyph" d="M41 57 50 35l9 22M44.5 49h11" /></svg>
            <span>Applications</span>
          </span>
          <span class="ghost">
            <Image src={appIcon} alt="" width={64} height={64} densities={[1, 2]} class="drop-icon" />
            <svg class="cursor" viewBox="0 0 24 24"><path d="M5 2.5 19 12l-6.3 1.3 3.7 6.7-2.7 1.5-3.7-6.7L5 19.4Z" /></svg>
          </span>
        </div>
      </div>
    </div>
    <p class="caption"><span class="num">2</span> Drag <b>rac</b> into <b>Applications</b></p>
  </li>

  <li class="step">
    <div class="art art-finder" aria-hidden="true">
      <div class="finder">
        <div class="f-side">
          <span class="f-lights"><i></i><i></i><i></i></span>
          {sideHeads.map(([label, y]) => <span class="f-head" style={`top:calc(${y}em - 0.39em)`}><span>{label}</span></span>)}
          {
            side.map(([label, d, y]) => (
              <span class:list={["f-item", label === "Applications" && "is-on"]} style={`top:calc(${y}em - 0.39em)`}>
                <svg viewBox="0 0 20 20"><path d={d} /></svg>
                <span>{label}</span>
              </span>
            ))
          }
        </div>
        <span class="f-nav"><svg viewBox="0 0 40 20"><path d="M12 5 7 10l5 5M28 5l5 5-5 5" /><path class="f-nav-split" d="M20 4v12" /></svg></span>
        <span class="f-title"><span>Applications</span></span>
        <span class="f-views"><svg viewBox="0 0 20 20"><rect x="3.5" y="3.5" width="5.2" height="5.2" rx="1" /><rect x="11.3" y="3.5" width="5.2" height="5.2" rx="1" /><rect x="3.5" y="11.3" width="5.2" height="5.2" rx="1" /><rect x="11.3" y="11.3" width="5.2" height="5.2" rx="1" /></svg><svg viewBox="0 0 20 20"><path d="M7.5 5h9M7.5 10h9M7.5 15h9M3.6 5h.01M3.6 10h.01M3.6 15h.01" /></svg><svg class="is-on" viewBox="0 0 20 20"><rect x="3" y="4" width="14" height="12" rx="2" /><path d="M7.7 4v12M12.3 4v12" /></svg></span>
        <span class="f-path"><span>Applications</span></span>
        {
          apps.map(([name, color], i) => (
            <span class:list={["f-row", !color && "is-on"]} style={`top:${(5.35 + i * 1.507).toFixed(3)}em`}>
              {color ? <i style={`--c:${color}`} /> : <Image src={appIcon} alt="" width={32} height={32} densities={[1, 2]} class="f-row-icon" />}
              <span>{name}</span>
            </span>
          ))
        }
        <i class="f-split"></i>
        <Image src={appIcon} alt="" width={224} height={224} densities={[1, 2]} class="f-preview" />
        <span class="f-name"><span>rac</span></span>
        <span class="f-kind"><span>Application</span></span>
        <i class="f-rule"></i>
        <span class="f-more"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="7.2" /><path d="M6.8 10h.01M10 10h.01M13.2 10h.01" /></svg><span>More…</span></span>
      </div>
    </div>
    <p class="caption"><span class="num">3</span> Open <b>rac</b> from <b>Applications</b></p>
  </li>
</ol>

<style>
  .steps {
    display: grid;
    gap: 20px;
    max-width: 1080px;
    margin-inline: auto;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step {
    container-type: inline-size;
  }

  .art {
    --win: #ffffff;
    --win-2: #f5f5f7;
    --win-line: rgb(0 0 0 / 0.08);
    --win-ink: #1d1d1f;
    --win-ink-2: #6e6e73;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 20px;
    background: var(--surface);
    font-size: calc(100cqi / 32);
    color: var(--win-ink);
    user-select: none;
  }

  :global([data-theme="dark"]) .art {
    --win: #2a2a2c;
    --win-2: #222224;
    --win-line: rgb(255 255 255 / 0.09);
    --win-ink: #f2f2f2;
    --win-ink-2: #98989d;
  }

  .caption {
    margin-top: 18px;
    color: var(--ink-2);
    text-align: center;
    text-wrap: balance;
  }

  .caption b {
    color: var(--ink);
    font-weight: 600;
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    margin-right: 0.35em;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    font-size: 0.8125em;
    font-weight: 600;
    vertical-align: 0.1em;
  }

  .lights {
    display: inline-flex;
    gap: 0.45em;
  }

  .lights i {
    width: 0.85em;
    height: 0.85em;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  /* Shared macOS folder icon. */
  .folder-back {
    fill: #4fa2f2;
  }

  .folder-front {
    fill: #84c3fb;
  }

  .folder-glyph {
    fill: none;
    stroke: #2f80d6;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 1: the Dock's Downloads stack, with rac.dmg on top of the folder. */
  .art-dock > * {
    position: absolute;
  }

  .dock-label {
    left: 4.09em;
    top: 4.59em;
    display: grid;
    place-items: center;
    width: 13.35em;
    height: 3.41em;
    border-radius: 999px;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 0.1em #fff,
      0 0 0 1px rgb(0 0 0 / 0.1),
      0 0.25em 0.7em rgb(0 0 0 / 0.08);
    color: #494b4b;
  }

  .dock-label span {
    font-size: 1.72em;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .dock {
    left: -1.5em;
    top: 9.61em;
    width: 31.71em;
    height: 16.5em;
    border-radius: 3.95em;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 0.2em #fff,
      0 0 0 1px rgb(0 0 0 / 0.07),
      0 0.5em 1.2em rgb(0 0 0 / 0.06);
  }

  .dock-divider {
    left: 2.51em;
    top: 12.27em;
    width: 0.25em;
    height: 10.9em;
    border-radius: 0.125em;
    background: #bfc1c0;
  }

  .dock-folder {
    left: 6.89em;
    top: 14.17em;
    width: 8.8em;
    height: 7.03em;
  }

  .dock-folder .folder-back {
    fill: #66afdd;
  }

  .dock-folder .folder-front {
    fill: url(#folder-front);
  }

  .dock-doc {
    left: 8.36em;
    top: 13.56em;
    width: 5.88em;
    height: 8em;
    filter: drop-shadow(0 0.15em 0.3em rgb(0 0 0 / 0.12));
  }

  .doc-page {
    fill: #f7f7f7;
    stroke: rgb(0 0 0 / 0.1);
  }

  .doc-fold {
    fill: #e6e6e6;
    stroke: rgb(0 0 0 / 0.1);
  }

  .doc-drive {
    fill: #e9e9e9;
    stroke: rgb(0 0 0 / 0.08);
  }

  .doc-lip {
    fill: #c4c4c4;
  }

  .doc-led {
    fill: #fff;
  }

  .doc-arrow {
    fill: none;
    stroke: #a9a9a9;
    stroke-width: 4.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dock-trash {
    left: 19.66em;
    top: 13.85em;
    width: 7.25em;
    height: 7.93em;
  }

  :global([data-theme="dark"]) .dock-label {
    box-shadow:
      inset 0 0 0 0.1em rgb(255 255 255 / 0.08),
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 0.25em 0.7em rgb(0 0 0 / 0.3);
    color: var(--ink);
  }

  :global([data-theme="dark"]) .dock {
    box-shadow:
      inset 0 0 0 0.2em rgb(255 255 255 / 0.06),
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 0.5em 1.2em rgb(0 0 0 / 0.3);
  }

  :global([data-theme="dark"]) .dock-divider {
    background: #4a4a4c;
  }

  /* 2: rac's install window, with the icon on its way to Applications. */
  .dmg-window {
    position: absolute;
    inset: 4em -0.5em 4em 3em;
    overflow: hidden;
    border-radius: 1.2em;
    background: var(--win);
    box-shadow:
      0 0 0 1px var(--win-line),
      0 1.6em 3.4em -1.4em rgb(0 0 0 / 0.35);
  }

  .win-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3em;
    font-size: 1.15em;
    font-weight: 600;
  }

  .win-bar .lights {
    position: absolute;
    left: 1em;
    font-size: 0.87em;
  }

  .win-body {
    position: absolute;
    inset: 3.45em 0 0;
  }

  .win-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 0;
  }

  .drop {
    position: absolute;
    top: 52%;
    display: grid;
    justify-items: center;
    gap: 0.5em;
    width: 9em;
    color: #fff;
    font-size: 1em;
    font-weight: 600;
    text-shadow: 0 1px 2px rgb(0 0 40 / 0.35);
    transform: translate(-50%, -50%);
  }

  .drop-app {
    left: 22%;
  }

  .drop-apps {
    left: 76%;
  }

  .drop-icon {
    width: 6.4em;
    height: auto;
  }

  .drop-app .drop-icon {
    opacity: 0.55;
  }

  .drop-apps {
    isolation: isolate;
  }

  .drop-target {
    position: absolute;
    inset: -0.6em 0.4em 1.8em;
    z-index: -1;
    border-radius: 1em;
    background: rgb(0 20 80 / 0.22);
  }

  .ghost {
    position: absolute;
    top: 44%;
    left: 59%;
    width: 6.4em;
    transform: translate(-50%, -50%) rotate(-6deg);
    filter: drop-shadow(0 0.6em 1em rgb(0 0 40 / 0.35));
  }

  .ghost .drop-icon {
    opacity: 0.92;
  }

  .cursor {
    position: absolute;
    right: -0.4em;
    bottom: -0.8em;
    width: 2.6em;
    transform: rotate(6deg);
  }

  .cursor path {
    fill: #111;
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  /* Played once, when the card scrolls into view. */
  :global(.js) .art-drag .ghost {
    animation: drag 1.6s var(--ease-in-out) 0.4s both paused;
  }

  :global(.js) .art-drag .drop-target {
    animation: target 1.6s linear 0.4s both paused;
  }

  :global(.js) .is-in .art-drag :is(.ghost, .drop-target) {
    animation-play-state: running;
  }

  @keyframes target {
    0%,
    80% {
      opacity: 0;
    }
  }

  @keyframes drag {
    from {
      left: 22%;
      top: 52%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.95);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .art-drag :is(.ghost, .drop-target) {
      animation: none;
    }
  }

  /* 3: Finder, Applications open, rac selected. Positions are in card em
     from the window's top-left corner (the sidebar's rows from its own). */
  .finder {
    --f-ink: #1d1d1f;
    --f-ink-2: #8a8a8a;
    --f-icon: #4a4a4a;
    --f-bg: #f9f9f9;
    --f-panel: #f6f6f6;
    --f-edge: #ebebeb;
    --f-line: #e6e6e6;
    position: absolute;
    left: 1.79em;
    top: 4.41em;
    width: 33em;
    height: 23.07em;
    border: 1px solid #050505;
    border-radius: 1.33em;
    background: var(--f-bg);
    box-shadow: 0 1em 2.4em -1em rgb(0 0 0 / 0.25);
    color: var(--f-ink);
  }

  :global([data-theme="dark"]) .finder {
    --f-ink: #f2f2f2;
    --f-ink-2: #98989d;
    --f-icon: #c8c8c8;
    --f-bg: #2a2a2c;
    --f-panel: #252527;
    --f-edge: rgb(255 255 255 / 0.08);
    --f-line: rgb(255 255 255 / 0.1);
    border-color: #000;
  }

  .finder > *,
  .f-side > * {
    position: absolute;
  }

  .f-side {
    left: 0.36em;
    top: 0.39em;
    bottom: 0.39em;
    width: 6.92em;
    border-radius: 0.93em;
    background: var(--f-panel);
    box-shadow: inset 0 0 0 1px var(--f-edge);
  }

  .f-lights {
    left: 0.63em;
    top: 0.645em;
    display: flex;
    gap: 0.475em;
  }

  .f-lights i {
    width: 0.61em;
    height: 0.61em;
    border-radius: 50%;
    background: #ff5f57;
  }

  .f-lights i:nth-child(2) {
    background: #febc2e;
  }

  .f-lights i:nth-child(3) {
    background: #28c840;
  }

  .f-head {
    left: 0.75em;
    transform: translateY(-50%);
    color: var(--f-ink-2);
  }

  .f-head span {
    font-size: 0.54em;
    font-weight: 600;
  }

  .f-item {
    left: 0.39em;
    display: flex;
    align-items: center;
    gap: 0.45em;
    width: 5.99em;
    height: 1.58em;
    padding-left: 0.46em;
    border-radius: 0.36em;
    transform: translateY(-50%);
    white-space: nowrap;
  }

  .f-item span {
    font-size: 0.61em;
    font-weight: 500;
  }

  .f-item svg,
  .f-nav svg,
  .f-more svg {
    flex: none;
    fill: none;
    stroke: var(--f-icon);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .f-item svg {
    width: 0.82em;
    height: 0.82em;
  }

  .f-item.is-on {
    background: #e1ebf3;
  }

  :global([data-theme="dark"]) .f-item.is-on {
    background: rgb(255 255 255 / 0.1);
  }

  .f-item.is-on svg {
    stroke: #1a66d9;
  }

  .f-nav,
  .f-views {
    top: 0.5em;
    height: 1.69em;
    border-radius: 999px;
    background: var(--f-bg);
    box-shadow:
      0 0 0 1px var(--f-edge),
      0 0.1em 0.3em rgb(0 0 0 / 0.05);
  }

  .f-nav {
    left: 7.75em;
    display: grid;
    place-items: center;
    width: 3.34em;
  }

  .f-nav svg {
    width: 2.5em;
    stroke-width: 1.5;
  }

  .f-nav-split {
    stroke: var(--f-line);
  }

  .f-title {
    left: 11.73em;
    top: 1.33em;
    transform: translateY(-50%);
  }

  .f-title span {
    font-size: 0.68em;
    font-weight: 700;
  }

  .f-views {
    left: 24.86em;
    display: flex;

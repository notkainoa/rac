---
// rac's place in the build: a thin layer of patches over Helium, which sits on
// ungoogled-chromium and Chromium. Heights hint at how much each layer holds.
const layers = [
  { name: "rac", about: "Spaces, pinned tabs, the sidebar, and optional AI", tone: "rac" },
  { name: "Helium", about: "Privacy, speed, and vertical tabs", tone: "helium" },
  { name: "ungoogled-chromium", about: "Chromium with Google’s services taken out", tone: "ungoogled" },
  { name: "Chromium", about: "The engine under all of it", tone: "chromium" },
];
---

<ol class="layers grid gap-1.5" aria-label="How rac is built, from top to bottom">
  {
    layers.map((layer) => (
      <li class="layer flex flex-col justify-between gap-2 rounded-2xl px-5 py-4 sm:flex-row sm:items-end sm:px-6" data-tone={layer.tone}>
        <span class="text-[1.125rem] font-semibold tracking-[-0.01em]">{layer.name}</span>
        <span class="text-[0.9375rem] opacity-80 sm:text-right">{layer.about}</span>
      </li>
    ))
  }
</ol>

<style>
  .layer[data-tone="rac"] {
    background: var(--color-action);
    color: #fff;
    min-height: 4.25rem;
  }
  .layer[data-tone="helium"] {
    background: var(--surface-2);
    min-height: 6.5rem;
  }
  .layer[data-tone="ungoogled"] {
    background: var(--surface);
    min-height: 5rem;
  }
  .layer[data-tone="chromium"] {
    background: var(--surface);
    min-height: 11rem;
    color: var(--ink-2);
  }
  .layer[data-tone="chromium"] span:first-child {
    color: var(--ink);
  }
</style>

---
// The assistant asking before it acts: a plan card, then a confirmation card
// for the one consequential step. Wording follows rac's real cards.
---

<div data-ui class="ai rounded-[22px] bg-(--surface) p-5 sm:p-7">
  <div class="ml-auto w-fit max-w-[85%] rounded-2xl bg-action px-4 py-2.5 text-[0.9375rem] text-white">
    Book the inn for March 12 to 14, two guests.
  </div>

  <div class="mt-5 rounded-2xl bg-(--bg) p-5">
    <p class="text-[0.875rem] text-(--ink-2)">rac will:</p>
    <p class="mt-1 font-medium">Fill in the booking form for two guests</p>
    <p class="mt-4 text-[0.875rem] text-(--ink-2)">On these sites</p>
    <p class="mt-1 flex items-center gap-2 font-medium">
      <span class="size-4 rounded-[5px] bg-[#e8594a]" aria-hidden="true"></span>
      hanaya-inn.jp
    </p>
    <div class="mt-5 flex justify-end">
      <span class="rounded-full bg-action px-4 py-1.5 text-[0.875rem] font-medium text-white">Allow</span>
    </div>
  </div>

  <div class="mt-3 rounded-2xl bg-(--bg) p-5">
    <p class="font-medium">Clicks Book room.</p>
    <p class="mt-1 text-(--ink-2)">It sends the form to hanaya-inn.jp</p>
    <div class="mt-5 flex justify-end gap-2">
      <span class="rounded-full bg-(--surface) px-4 py-1.5 text-[0.875rem] font-medium">Stop</span>
      <span class="rounded-full bg-(--surface) px-4 py-1.5 text-[0.875rem] font-medium">Confirm</span>
    </div>
  </div>
</div>

---
// A numbered link to an entry in the page's Sources list.
interface Props {
  n: number | number[];
}
const list = Array.isArray(Astro.props.n) ? Astro.props.n : [Astro.props.n];
---

<sup class="cite">{
  list.map((n, i) => (
    <>
      {i > 0 && ","}
      <a href={`#source-${n}`} aria-label={`Source ${n}`}>{n}</a>
    </>
  ))
}</sup>

<style>
  .cite {
    margin-left: 0.1em;
    font-size: 0.7em;
    font-weight: 500;
    color: var(--ink-3);
  }

  .cite a {
    /* A bigger tap target than the digit itself. */
    padding: 0.35em 0.15em;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .cite a:hover {
      color: var(--ink);
    }
  }
</style>

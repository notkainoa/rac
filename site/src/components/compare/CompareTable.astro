---
import Cite from "./Cite.astro";

// A two-browser comparison. On wide screens it's a table; on phones each row
// stacks into a small card so no cell is ever squeezed or clipped.
export interface Row {
  label: string;
  rac: string;
  other: string;
  // Source numbers for the other browser's cell.
  cite?: number | number[];
}

interface Props {
  other: string;
  rows: Row[];
  caption: string;
}
const { other, rows, caption } = Astro.props;
---

<!-- Explicit roles keep table semantics when phones restyle it as cards. -->
<table class="compare" role="table">
  <caption class="sr-only">{caption}</caption>
  <thead role="rowgroup">
    <tr role="row">
      <th scope="col" role="columnheader"><span class="sr-only">Feature</span></th>
      <th scope="col" role="columnheader">rac</th>
      <th scope="col" role="columnheader">{other}</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      rows.map((row) => (
        <tr role="row">
          <th scope="row" role="rowheader">{row.label}</th>
          <td role="cell" data-label="rac"><span>{row.rac}</span></td>
          <td role="cell" data-label={other}>
            <span>
              {row.other}
              {row.cite !== undefined && <Cite n={row.cite} />}
            </span>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .compare {
    width: 100%;
    margin-top: 1.5rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .compare th,
  .compare td {
    padding: 0.85rem 1rem 0.85rem 0;
    text-align: left;
    vertical-align: top;
    overflow-wrap: break-word;
  }

  .compare thead th {
    padding-top: 0;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .compare tbody tr {
    border-top: 1px solid var(--line);
  }

  .compare tbody th {
    width: 28%;
    font-weight: 500;
    color: var(--ink-2);
  }

  .compare td {
    width: 36%;
  }

  /* Phones: one card per row, each cell labeled with its browser. */
  @media (max-width: 639px) {
    .compare,
    .compare tbody,
    .compare tr,
    .compare th,
    .compare td {
      display: block;
      width: auto;
    }

    .compare thead {
      display: none;
    }

    .compare tbody {
      display: grid;
      gap: 0.5rem;
    }

    .compare tbody tr {
      border-top: 0;
      border-radius: 1rem;
      background: var(--surface);
      padding: 1rem 1.25rem;
    }

    .compare tbody th {
      width: auto;
      padding: 0 0 0.5rem;
      color: var(--ink);
      font-weight: 600;
    }

    .compare td {
      display: grid;
      grid-template-columns: 5.25rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.3rem 0 0;
    }

    .compare td::before {
      content: attr(data-label);
      color: var(--ink-2);
      font-weight: 500;
    }
  }
</style>

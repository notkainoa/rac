---
// The numbered list every <Cite> on a compare page points to.
export interface Source {
  title: string;
  url: string;
}

interface Props {
  sources: Source[];
  checked: string;
}
const { sources, checked } = Astro.props;
const date = new Date(`${checked}T12:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<h2 id="sources">Sources</h2>
<p class="text-[0.9375rem] text-(--ink-2)">Each page was checked on <time datetime={checked}>{date}</time>.</p>
<ol class="sources" role="list">
  {
    sources.map((source, i) => (
      <li id={`source-${i + 1}`}>
        <span class="num">{i + 1}.</span>
        <span>
          {source.title}{" "}
          <a class="text-link break-all text-(--ink-2)" href={source.url} rel="noreferrer">
            {source.url.replace(/^https?:\/\//, "")}
          </a>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .sources {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .sources li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    padding-left: 0;
    scroll-margin-top: 2rem;
  }

  /* The list sits inside .prose-rac; drop its bullet dots, whatever the
     stylesheet order. */
  :global(.prose-rac) .sources li::before {
    display: none;
  }

  .sources li:target {
    color: var(--ink);
  }

  .num {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
</style>

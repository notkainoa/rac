+
+bool TemplateURLService::RestoreDeletedBang(std::string_view trigger) {
+  // Clearing the mark is what matters; when the downloaded list no longer
+  // carries the trigger there is nothing to re-add.
+  rac::RemoveDeletedBang(&prefs_.get(), trigger);
+
+  const std::string lower = base::ToLowerASCII(trigger);
+  for (const auto& bang : bang_manager_->GetBangs()) {
+    if (base::ToLowerASCII(bang.bang) != lower) {
+      continue;
     }
+    if (!MaybeAddBang(bang)) {
+      // The trigger is in the list, but the user's own entry claims the
+      // keyword already.
+      return true;
+    }
+
+    Scoper scoper(this);
+    model_mutated_notification_pending_ = true;
+    return true;
   }
+  return false;
 }
 

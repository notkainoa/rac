+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/search_engines/rac_deleted_bangs.h"
+
+#include <utility>
+
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace rac {
+
+void RegisterDeletedBangsPref(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kDeletedBangsPref);
+}
+
+base::flat_set<std::string> ReadDeletedBangs(const PrefService* prefs) {
+  base::flat_set<std::string> deleted;
+  if (!prefs) {
+    return deleted;
+  }
+  for (const base::Value& entry : prefs->GetList(kDeletedBangsPref)) {
+    if (entry.is_string() && !entry.GetString().empty()) {
+      deleted.insert(base::ToLowerASCII(entry.GetString()));
+    }
+  }
+  return deleted;
+}
+
+bool IsDeletedBang(std::string_view trigger,
+                   const base::flat_set<std::string>& deleted) {
+  return !deleted.empty() && deleted.contains(base::ToLowerASCII(trigger));
+}
+
+void AddDeletedBang(PrefService* prefs, std::string_view trigger) {
+  if (!prefs || trigger.empty() ||
+      IsDeletedBang(trigger, ReadDeletedBangs(prefs))) {
+    return;
+  }
+  ScopedListPrefUpdate update(prefs, kDeletedBangsPref);
+  update->Append(base::ToLowerASCII(trigger));
+}
+
+void RemoveDeletedBang(PrefService* prefs, std::string_view trigger) {
+  if (!prefs || trigger.empty() ||
+      !IsDeletedBang(trigger, ReadDeletedBangs(prefs))) {
+    return;
+  }
+  const std::string lower = base::ToLowerASCII(trigger);
+  ScopedListPrefUpdate update(prefs, kDeletedBangsPref);
+  update->EraseIf([&](const base::Value& entry) {
+    return entry.is_string() && base::ToLowerASCII(entry.GetString()) == lower;
+  });
+}
+
+}  // namespace rac

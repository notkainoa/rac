+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/search_engines/rac_deleted_bangs.h"
+
+#include <string>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/values.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+class DeletedBangsTest : public testing::Test {
+ protected:
+  DeletedBangsTest() { RegisterDeletedBangsPref(prefs_.registry()); }
+
+  TestingPrefServiceSimple prefs_;
+};
+
+// What BangsLoadedCallback does for one downloaded list: a bang is added
+// unless the user deleted it or already has that keyword.
+std::vector<std::string> BangsToAdd(
+    const std::vector<std::string>& downloaded,
+    const base::flat_set<std::u16string>& user_keywords,
+    const base::flat_set<std::string>& deleted) {
+  std::vector<std::string> add;
+  for (const std::string& trigger : downloaded) {
+    if (IsDeletedBang(trigger, deleted)) {
+      continue;
+    }
+    if (user_keywords.contains(
+            u"!" + std::u16string(trigger.begin(), trigger.end()))) {
+      continue;
+    }
+    add.push_back(trigger);
+  }
+  return add;
+}
+
+TEST_F(DeletedBangsTest, EmptyByDefaultAndNullSafe) {
+  EXPECT_TRUE(ReadDeletedBangs(&prefs_).empty());
+  EXPECT_TRUE(ReadDeletedBangs(nullptr).empty());
+  AddDeletedBang(nullptr, "w");
+  RemoveDeletedBang(nullptr, "w");
+}
+
+TEST_F(DeletedBangsTest, AddAndReadRoundTrip) {
+  AddDeletedBang(&prefs_, "w");
+  AddDeletedBang(&prefs_, "yt");
+  base::flat_set<std::string> deleted = ReadDeletedBangs(&prefs_);
+  EXPECT_EQ(2u, deleted.size());
+  EXPECT_TRUE(IsDeletedBang("w", deleted));
+  EXPECT_TRUE(IsDeletedBang("yt", deleted));
+  EXPECT_FALSE(IsDeletedBang("g", deleted));
+}
+
+TEST_F(DeletedBangsTest, AddIsIdempotent) {
+  AddDeletedBang(&prefs_, "w");
+  AddDeletedBang(&prefs_, "w");
+  AddDeletedBang(&prefs_, "W");
+  EXPECT_EQ(1u, prefs_.GetList(kDeletedBangsPref).size());
+}
+
+TEST_F(DeletedBangsTest, RemoveIsIdempotent) {
+  AddDeletedBang(&prefs_, "w");
+  AddDeletedBang(&prefs_, "yt");
+  RemoveDeletedBang(&prefs_, "w");
+  RemoveDeletedBang(&prefs_, "w");
+  RemoveDeletedBang(&prefs_, "never-there");
+  base::flat_set<std::string> deleted = ReadDeletedBangs(&prefs_);
+  EXPECT_FALSE(IsDeletedBang("w", deleted));
+  EXPECT_TRUE(IsDeletedBang("yt", deleted));
+  EXPECT_EQ(1u, deleted.size());
+}
+
+TEST_F(DeletedBangsTest, EmptyTriggerIsIgnored) {
+  AddDeletedBang(&prefs_, "");
+  EXPECT_TRUE(prefs_.GetList(kDeletedBangsPref).empty());
+  EXPECT_FALSE(IsDeletedBang("", ReadDeletedBangs(&prefs_)));
+}
+
+TEST_F(DeletedBangsTest, NonStringEntriesAreIgnored) {
+  base::ListValue list;
+  list.Append(1);
+  list.Append(true);
+  list.Append(base::ListValue());
+  list.Append("w");
+  list.Append("");
+  prefs_.SetList(kDeletedBangsPref, std::move(list));
+  base::flat_set<std::string> deleted = ReadDeletedBangs(&prefs_);
+  EXPECT_EQ(1u, deleted.size());
+  EXPECT_TRUE(IsDeletedBang("w", deleted));
+  // Removing leaves the entries it does not own alone.
+  RemoveDeletedBang(&prefs_, "w");
+  EXPECT_EQ(4u, prefs_.GetList(kDeletedBangsPref).size());
+}
+
+TEST_F(DeletedBangsTest, CaseIsIgnored) {
+  AddDeletedBang(&prefs_, "YT");
+  base::flat_set<std::string> deleted = ReadDeletedBangs(&prefs_);
+  EXPECT_TRUE(IsDeletedBang("yt", deleted));
+  EXPECT_TRUE(IsDeletedBang("Yt", deleted));
+  RemoveDeletedBang(&prefs_, "yT");
+  EXPECT_TRUE(ReadDeletedBangs(&prefs_).empty());
+}
+
+TEST_F(DeletedBangsTest, DeletedBangStaysDeletedAcrossListUpdates) {
+  AddDeletedBang(&prefs_, "w");
+  const std::vector<std::string> list = {"g", "w", "yt"};
+  const std::vector<std::string> expected = {"g", "yt"};
+  EXPECT_EQ(expected, BangsToAdd(list, {}, ReadDeletedBangs(&prefs_)));
+  // A new download, with the bang still in it.
+  EXPECT_EQ(expected, BangsToAdd(list, {}, ReadDeletedBangs(&prefs_)));
+  // Un-deleting brings it back.
+  RemoveDeletedBang(&prefs_, "w");
+  EXPECT_EQ(list, BangsToAdd(list, {}, ReadDeletedBangs(&prefs_)));
+}
+
+TEST_F(DeletedBangsTest, UsersOwnKeywordBlocksTheDownloadedBang) {
+  const std::vector<std::string> list = {"g", "w"};
+  const std::vector<std::string> expected = {"g"};
+  EXPECT_EQ(expected, BangsToAdd(list, {u"!w"}, ReadDeletedBangs(&prefs_)));
+}
+
+}  // namespace
+}  // namespace rac

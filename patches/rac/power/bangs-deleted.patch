+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_SEARCH_ENGINES_RAC_DELETED_BANGS_H_
+#define COMPONENTS_SEARCH_ENGINES_RAC_DELETED_BANGS_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/containers/flat_set.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace rac {
+
+// The triggers (without the "!") of downloaded bangs the user deleted. A
+// list of strings. TemplateURLService skips these when it re-applies the
+// downloaded list, so a deleted bang stays deleted.
+inline constexpr char kDeletedBangsPref[] = "rac.bangs.deleted";
+
+void RegisterDeletedBangsPref(PrefRegistrySimple* registry);
+
+// Triggers are compared in ASCII lower case, so the set holds lower case
+// triggers. Entries that are not strings are skipped. A null |prefs| gives an
+// empty set.
+base::flat_set<std::string> ReadDeletedBangs(const PrefService* prefs);
+
+// True when |trigger| (no "!") is in |deleted|, ignoring ASCII case.
+bool IsDeletedBang(std::string_view trigger,
+                   const base::flat_set<std::string>& deleted);
+
+// Both do nothing when the trigger is already in (or already out of) the
+// list, and when |prefs| is null or |trigger| is empty.
+void AddDeletedBang(PrefService* prefs, std::string_view trigger);
+void RemoveDeletedBang(PrefService* prefs, std::string_view trigger);
+
+}  // namespace rac
+
+#endif  // COMPONENTS_SEARCH_ENGINES_RAC_DELETED_BANGS_H_

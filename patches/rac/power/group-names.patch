+++ src/chrome/browser/rac/power/third_party/ardia/BUILD.gn
@@ -0,0 +1,30 @@
+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+# Ardia's tab group naming rule, ported to C++. See README.chromium.
+source_set("ardia") {
+  sources = [
+    "group_name.cc",
+    "group_name.h",
+  ]
+  public_deps = [
+    "//base",
+    "//url",
+  ]
+  deps = [
+    "//components/url_formatter",
+    "//net",
+  ]
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "group_name_unittest.cc" ]
+  deps = [
+    ":ardia",
+    "//base",
+    "//testing/gtest",
+    "//url",
+  ]
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+//
+// Ported from Ardia's apps/browser/src/store/groupNames.ts
+// (https://github.com/mantrakp04/ardia, commit 4309c156).
+
+#ifndef CHROME_BROWSER_RAC_POWER_THIRD_PARTY_ARDIA_GROUP_NAME_H_
+#define CHROME_BROWSER_RAC_POWER_THIRD_PARTY_ARDIA_GROUP_NAME_H_
+
+#include <string>
+
+#include "base/containers/span.h"
+#include "url/gurl.h"
+
+namespace rac {
+
+// One tab of a group. Callers pass an empty `title` for a tab that has no page
+// title of its own, never WebContents::GetTitle()'s fallback to the URL. A
+// title equal to the URL's spec also counts as untitled.
+struct GroupNameMember {
+  GURL url;
+  std::u16string title;
+};
+
+// Names a group of tabs: the site they share, followed by the page they share
+// when every tab is on the same page. Returns "" for an empty list.
+std::u16string AutoGroupName(base::span<const GroupNameMember> members);
+
+// The site name for the members: a site name taken from their titles, a title
+// that is just the host's name, or the host's name tidied up.
+std::u16string SiteName(base::span<const GroupNameMember> members);
+
+// A lowercase key for the site of `url`, such as "bbc" for news.bbc.co.uk.
+// Pages on an IP address use the address itself. "" for a URL with no host.
+std::string SiteKey(const GURL& url);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_POWER_THIRD_PARTY_ARDIA_GROUP_NAME_H_
Index: src/chrome/browser/rac/power/third_party/ardia/group_name_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/power/third_party/ardia/group_name_unittest.cc
@@ -0,0 +1,323 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+//
+// Ported from Ardia's apps/browser/src/store/groupNames.ts
+// (https://github.com/mantrakp04/ardia, commit 4309c156) and changed by the
+// rac Authors: rewritten in C++, and HostLabel() uses the public suffix list.
+// Ardia
+// Copyright 2026 Mantra Patel
+// Licensed under the Apache License, Version 2.0
+// (https://www.apache.org/licenses/LICENSE-2.0).
+
+#include "chrome/browser/rac/power/third_party/ardia/group_name.h"
+
+#include <string>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+
+namespace {
+
+GroupNameMember Member(const char* url, const std::u16string& title = u"") {
+  return GroupNameMember{GURL(url), title};
+}
+
+std::u16string Name(const std::vector<GroupNameMember>& members) {
+  return AutoGroupName(members);
+}
+
+}  // namespace
+
+// Ardia: a group of pages on an IP address is named after the address, not one
+// of its numbers.
+TEST(GroupNameTest, IpAddressesKeepTheWholeAddress) {
+  EXPECT_EQ(u"127.0.0.1", Name({Member("http://127.0.0.1:9471/d")}));
+  EXPECT_EQ(u"[::1]", Name({Member("http://[::1]:8080/")}));
+  EXPECT_EQ("10.0.0.2", SiteKey(GURL("http://10.0.0.2/a")));
+  EXPECT_EQ(u"Bbc", Name({Member("https://news.bbc.co.uk/x")}));
+}
+
+TEST(GroupNameTest, EmptyListHasNoName) {
+  EXPECT_EQ(u"", Name({}));
+}
+
+// Three pull requests: the site is the last " · " piece of every title, and
+// the pages differ, so the name is the site alone.
+TEST(GroupNameTest, GitHubPullRequestsAreNamedGitHub) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://github.com/o/r/pull/1",
+             u"Fix the thing by someone · Pull Request #1 · o/r "
+             u"· GitHub"),
+      Member("https://github.com/o/r/pull/2",
+             u"Add another thing by someone · Pull Request #2 · o/r "
+             u"· GitHub"),
+      Member("https://github.com/o/r/pull/3",
+             u"Remove a thing by someone · Pull Request #3 · o/r "
+             u"· GitHub"),
+  };
+  EXPECT_EQ(u"GitHub", Name(members));
+  EXPECT_EQ(u"GitHub", SiteName(members));
+}
+
+// The same page in every tab adds the page to the site. The title's site
+// "Gmail" is not the host's name (google), but two titles agree on it.
+TEST(GroupNameTest, SamePageInEveryTabAddsThePage) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://mail.google.com/mail/u/0/#inbox", u"Inbox - Gmail"),
+      Member("https://mail.google.com/mail/u/0/#inbox", u"Inbox - Gmail"),
+  };
+  EXPECT_EQ(u"Gmail Inbox", Name(members));
+}
+
+// Here the site in the title matches the host's name, so one tab is enough.
+TEST(GroupNameTest, SamePageOnAHostNamedSite) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://example.com/pricing", u"Pricing | Example"),
+      Member("https://www.example.com/pricing", u"Pricing | Example"),
+  };
+  EXPECT_EQ(u"Example Pricing", Name(members));
+}
+
+// One tab whose title is not shaped like "page - site" and does not match
+// the host falls back to the host's name.
+TEST(GroupNameTest, OneTitleThatDoesNotMatchTheHostUsesTheHost) {
+  EXPECT_EQ(u"Google",
+            Name({Member("https://mail.google.com/", u"Inbox - Gmail")}));
+}
+
+TEST(GroupNameTest, DifferentPagesOfOneSiteGiveTheSite) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://www.youtube.com/watch?v=1", u"Cats - YouTube"),
+      Member("https://www.youtube.com/watch?v=2", u"Dogs - YouTube"),
+  };
+  EXPECT_EQ(u"YouTube", Name(members));
+}
+
+TEST(GroupNameTest, MixedSitesGiveTheFirstSite) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://github.com/o/r", u"Repo · GitHub"),
+      Member("https://www.youtube.com/watch?v=1", u"Cats - YouTube"),
+  };
+  EXPECT_EQ(u"GitHub", Name(members));
+}
+
+// A first tab with no host and a title names the group after its title.
+TEST(GroupNameTest, FirstTabWithoutHostGivesItsTitle) {
+  const std::vector<GroupNameMember> members = {
+      Member("about:blank", u"New Tab"),
+      Member("https://github.com/o/r", u"Repo · GitHub"),
+  };
+  EXPECT_EQ(u"New Tab", Name(members));
+}
+
+TEST(GroupNameTest, UntitledTabsGiveTheTidyHost) {
+  EXPECT_EQ(u"Python", Name({Member("https://docs.python.org/3/")}));
+  EXPECT_EQ(u"Python", Name({Member("https://docs.python.org/3/"),
+                             Member("https://www.python.org/about/")}));
+}
+
+TEST(GroupNameTest, TitleEqualToTheUrlCountsAsUntitled) {
+  EXPECT_EQ(u"Python", Name({Member("https://docs.python.org/3/",
+                                    u"https://docs.python.org/3/")}));
+}
+
+// A title equal to an invalid URL's spec counts as untitled too. GURL gives
+// this input an empty spec, so no non-ASCII spec reaches IsTitled() from
+// here; its size shortcut still only applies to an ASCII spec, in case one
+// ever does.
+TEST(GroupNameTest, ATitleEqualToAnInvalidSpecCountsAsUntitled) {
+  const GURL url("\xC3\xA9");
+  ASSERT_FALSE(url.is_valid());
+  EXPECT_EQ(u"", Name({{url, base::UTF8ToUTF16(url.possibly_invalid_spec())}}));
+}
+
+// A short title on a long address is titled; the size check decides it
+// without converting the whole address.
+TEST(GroupNameTest, AShortTitleOnALongUrlIsTitled) {
+  const std::string url = "https://example.com/" + std::string(2000, 'a');
+  EXPECT_EQ(u"Example Cats", Name({Member(url.c_str(), u"Cats | Example")}));
+}
+
+TEST(GroupNameTest, NonAsciiTitles) {
+  // A separator in the title, with a different page in each tab.
+  const std::vector<GroupNameMember> different = {
+      Member("https://ja.wikipedia.org/wiki/a", u"東京 – Wikipedia"),
+      Member("https://ja.wikipedia.org/wiki/b", u"大阪 – Wikipedia"),
+  };
+  EXPECT_EQ(u"Wikipedia", Name(different));
+  // The same page in each tab: squash() drops the non-ASCII page when it
+  // compares it with the site, but the page itself is kept.
+  const std::vector<GroupNameMember> same = {
+      Member("https://ja.wikipedia.org/wiki/a", u"東京 – Wikipedia"),
+      Member("https://ja.wikipedia.org/wiki/b", u"東京 – Wikipedia"),
+  };
+  EXPECT_EQ(u"Wikipedia 東京", Name(same));
+  // No separator and nothing that looks like the host: the host's name.
+  EXPECT_EQ(u"Example", Name({Member("https://example.jp/", u"日本語")}));
+}
+
+// A site and page with no ASCII letters or digits both squash to "", which
+// is not equality: the page is still added to the name.
+TEST(GroupNameTest, AnEmptySquashIsNotAMatch) {
+  EXPECT_EQ(
+      u"ウィキペディア 東京",
+      Name({Member("https://ja.wikipedia.org/wiki/a", u"東京 – ウィキペディア"),
+            Member("https://ja.wikipedia.org/wiki/a",
+                   u"東京 – ウィキペディア")}));
+}
+
+// With no site the group is named after the first tab's trimmed title — or
+// "" when that tab has no title of its own, such as one equal to its URL.
+TEST(GroupNameTest, NoSiteGivesTheFirstTabsTrimmedTitle) {
+  EXPECT_EQ(u"New Tab", Name({Member("about:blank", u"  New Tab  ")}));
+  EXPECT_EQ(u"",
+            Name({Member("file:///x/report.pdf", u"file:///x/report.pdf")}));
+}
+
+TEST(GroupNameTest, PrivateRegistriesAreRespected) {
+  EXPECT_EQ(u"Me", Name({Member("https://me.github.io/")}));
+  EXPECT_EQ("me", SiteKey(GURL("https://me.github.io/")));
+}
+
+TEST(GroupNameTest, SiteKey) {
+  EXPECT_EQ("example", SiteKey(GURL("https://www.Example.COM/")));
+  EXPECT_EQ("bbc", SiteKey(GURL("https://news.bbc.co.uk/")));
+  EXPECT_EQ("[::1]", SiteKey(GURL("http://[::1]:8080/")));
+  EXPECT_EQ("localhost", SiteKey(GURL("http://localhost:3000/")));
+  EXPECT_EQ("", SiteKey(GURL("not a url")));
+}
+
+TEST(GroupNameTest, SiteNameUsesATitleThatIsJustTheHostName) {
+  EXPECT_EQ(u"EXAMPLE",
+            SiteName({Member("https://www.example.com/", u"EXAMPLE")}));
+  EXPECT_EQ(u"Example", SiteName({Member("https://www.example.com/")}));
+  EXPECT_EQ(u"", SiteName({}));
+}
+
+// A separator at the very start or end of a title is not a split: one side
+// would be empty, so no end is made and the host's name is used. The host
+// does not know about YouTube's capital T.
+TEST(GroupNameTest, ASeparatorAtTheStartOrEndSplitsNothing) {
+  EXPECT_EQ(u"Youtube",
+            Name({Member("https://www.youtube.com/a", u" - YouTube"),
+                  Member("https://www.youtube.com/b", u" - YouTube")}));
+  EXPECT_EQ(u"Youtube",
+            Name({Member("https://www.youtube.com/a", u"YouTube - "),
+                  Member("https://www.youtube.com/b", u"YouTube - ")}));
+}
+
+// The site can sit behind any separator; titles split by different ones still
+// agree on it.
+TEST(GroupNameTest, DifferentSeparatorsAgreeOnTheSite) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://www.youtube.com/watch?v=1", u"Cats - YouTube"),
+      Member("https://www.youtube.com/watch?v=2", u"Dogs • YouTube"),
+  };
+  EXPECT_EQ(u"YouTube", Name(members));
+}
+
+// A title splits at each of its separators, and the page is what is left when
+// the site is removed, inner separators included.
+TEST(GroupNameTest, SeveralSeparatorsInOneTitle) {
+  EXPECT_EQ(
+      u"Example Deep - Nested",
+      Name({Member("https://example.com/a", u"Deep - Nested | Example"),
+            Member("https://example.com/a", u"Deep - Nested | Example")}));
+  EXPECT_EQ(u"Example",
+            Name({Member("https://example.com/a", u"Deep - Nested | Example"),
+                  Member("https://example.com/b", u"Other - Mid | Example")}));
+}
+
+// A site of more than three words never looks like the host, so one tab falls
+// back to the host; two tabs agreeing on it still use it.
+TEST(GroupNameTest, AWordySiteNameNeedsTwoTitles) {
+  EXPECT_EQ(
+      u"Example",
+      Name({Member("https://example.com/a", u"Home - The Daily News Site")}));
+  EXPECT_EQ(
+      u"The Daily News Site",
+      Name({Member("https://example.com/a", u"Home - The Daily News Site"),
+            Member("https://example.com/b", u"About - The Daily News Site")}));
+}
+
+// A title of only whitespace is titled — it is not empty and not the URL —
+// but it names nothing, so the group gets the host's name.
+TEST(GroupNameTest, WhitespaceOnlyTitlesActUntitled) {
+  EXPECT_EQ(u"Example", Name({Member("https://example.com/a", u"   ")}));
+  EXPECT_EQ(u"Example", Name({Member("https://example.com/a", u" \t"),
+                              Member("https://example.com/b", u"  ")}));
+}
+
+// Only one leading "www." is stripped. A host that is itself a public suffix
+// falls back to the length heuristic, which takes the second label.
+TEST(GroupNameTest, OnlyOneWwwIsStrippedAndSuffixesAreKeys) {
+  EXPECT_EQ("example", SiteKey(GURL("https://www.www.example.com/")));
+  EXPECT_EQ("example", SiteKey(GURL("https://www.example.co.uk/")));
+  EXPECT_EQ(u"Example", Name({Member("https://www.www.example.com/")}));
+  EXPECT_EQ(u"Co", Name({Member("https://co.uk/")}));
+}
+
+// An untitled tab whose URL was already seen takes its page from the titled
+// copy, whatever the order. One on a different URL has no page and the group
+// is the site alone.
+TEST(GroupNameTest, AnUntitledCopyBorrowsTheTitledTab) {
+  EXPECT_EQ(
+      u"YouTube Cats",
+      Name({Member("https://www.youtube.com/watch?v=1"),
+            Member("https://www.youtube.com/watch?v=1", u"Cats - YouTube")}));
+  EXPECT_EQ(
+      u"YouTube",
+      Name({Member("https://www.youtube.com/watch?v=1", u"Cats - YouTube"),
+            Member("https://www.youtube.com/watch?v=2")}));
+}
+
+// TidyHost sees an empty host here, which is the one input that can leave
+// it with nothing to capitalize. IDNToUnicode() never returns "" for the
+// non-empty labels HostLabel() can produce, so the guard behind it has no
+// input to cover.
+TEST(GroupNameTest, AnEmptyHostNamesNothing) {
+  EXPECT_EQ(u"", Name({Member("about:blank")}));
+  EXPECT_EQ(u"", SiteName({Member("about:blank")}));
+}
+
+// The first member's site names the group. A first tab without a host has an
+// empty site, so the group keeps that tab's title, which is empty too. Put it
+// second and it only stops a page from being found.
+TEST(GroupNameTest, AUntitledTabWithoutAHostHidesTheName) {
+  EXPECT_EQ(u"", Name({Member("about:blank"),
+                       Member("https://github.com/o/r", u"Repo · GitHub")}));
+  EXPECT_EQ(u"GitHub", Name({Member("https://github.com/o/r", u"Repo · GitHub"),
+                             Member("about:blank")}));
+}
+
+// A second titled tab on the very same address names the group just as the
+// first did; the duplicate changes nothing.
+TEST(GroupNameTest, ADuplicateSpecNamesTheGroupTheSameWay) {
+  EXPECT_EQ(
+      Name({Member("https://example.com/pricing", u"Pricing | Example")}),
+      Name({Member("https://example.com/pricing", u"Pricing | Example"),
+            Member("https://example.com/pricing", u"Pricing | Example")}));
+  EXPECT_EQ(
+      u"Example Pricing",
+      Name({Member("https://example.com/pricing", u"Pricing | Example"),
+            Member("https://example.com/pricing", u"Pricing | Example")}));
+}
+
+// A title that is just the site counts for SiteName, but AutoGroupName can
+// remove no site from it, so the group is the tidy host.
+TEST(GroupNameTest, ATitleThatIsJustTheSiteNamesTheHost) {
+  EXPECT_EQ(u"Example", Name({Member("https://www.example.com/", u"EXAMPLE")}));
+}
+
+// An untitled tab on an IDN host names its group in Unicode, not punycode.
+TEST(GroupNameTest, AnIdnHostIsNamedInUnicode) {
+  EXPECT_EQ(u"B\u00fccher",
+            Name({Member("https://xn--bcher-kva.example/", u"")}));
+}
+
+}  // namespace rac

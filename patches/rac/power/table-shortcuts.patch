+}
+
+TEST(TableShortcutsTest, StaleCommandIsInTheRacRangeWithoutALabelledRow) {
+  Action row = ShortcutRow(IDC_RAC_ACTION_FIRST, ShortcutSpec());
+  row.label_id = 11;
+  const std::vector<Action> rows = {row};
+  EXPECT_FALSE(IsStaleTableCommand(rows, IDC_RAC_ACTION_FIRST));
+  EXPECT_TRUE(IsStaleTableCommand(rows, IDC_RAC_ACTION_FIRST + 1));
+  EXPECT_TRUE(IsStaleTableCommand(rows, IDC_RAC_ACTION_LAST));
+  EXPECT_TRUE(IsStaleTableCommand({}, IDC_RAC_ACTION_FIRST));
+}
+
+TEST(TableShortcutsTest, IdsOutsideTheRacRangeAreNeverStale) {
+  EXPECT_FALSE(IsStaleTableCommand({}, IDC_RAC_ACTION_FIRST - 1));
+  EXPECT_FALSE(IsStaleTableCommand({}, IDC_RAC_ACTION_LAST + 1));
+  EXPECT_FALSE(IsStaleTableCommand({}, 0));
+  EXPECT_FALSE(IsStaleTableCommand({}, kA));
+}
+
+TEST(TableShortcutsTest, StaleRacIdOnTheRealTableHasNoLabelAndIsStale) {
+  // The last id of the range is never used by a row.
+  EXPECT_FALSE(TableLabelFor(IDC_RAC_ACTION_LAST));
+  EXPECT_TRUE(IsStaleTableCommand(IDC_RAC_ACTION_LAST));
+}

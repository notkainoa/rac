+namespace {
+
+Action AiOnlyRow(int command_id, ShortcutSpec shortcut) {
+  Action row = ShortcutRow(command_id, shortcut);
+  row.label_id = 11;
+  row.ai_only = true;
+  return row;
+}
+
+// Helium's rule for a saved rebind of a command that is absent from the
+// defaults (PersistToPrefs, browser_shortcut_service.cc:353-358 in Helium's
+// file): it survives the next save only while the command has a label.
+bool InactiveDeltaSurvives(const FakeDefaults& defaults,
+                           int command_id,
+                           bool has_label) {
+  return !defaults.contains(command_id) && has_label;
+}
+
+// Helium's LoadFromPrefs (browser_shortcut_service.cc:311-346 in Helium's
+// file) for one saved key the user added: a delta is only read for a command
+// in the defaults (ReadAcceleratorDeltasPref, :517 in Helium's file, skips
+// the others), the key is
+// refused if another command holds it locked (IsAcceleratorLocked, :333),
+// and otherwise RemoveConflictingAccelerators (:337, defined at :562) takes
+// it from every other command that holds it user-modifiable (:572).
+void ApplyUserAddedKey(FakeDefaults& current,
+                       int command_id,
+                       const ui::Accelerator& accelerator) {
+  if (!current.contains(command_id)) {
+    return;
+  }
+  for (const auto& [id, entries] : current) {
+    for (const FakeEntry& entry : entries) {
+      if (id != command_id && !entry.user_modifiable &&
+          entry.accelerator == accelerator) {
+        return;
+      }
+    }
+  }
+  for (auto& [id, entries] : current) {
+    if (id != command_id) {
+      std::erase_if(entries, [&](const FakeEntry& entry) {
+        return entry.user_modifiable && entry.accelerator == accelerator;
+      });
+    }
+  }
+  std::vector<FakeEntry>& entries = current[command_id];
+  auto at = std::ranges::lower_bound(entries, accelerator, std::ranges::less(),
+                                     &FakeEntry::accelerator);
+  if (at == entries.end() || at->accelerator != accelerator) {
+    entries.insert(at, {accelerator, true});
+  }
+}
+
+}  // namespace

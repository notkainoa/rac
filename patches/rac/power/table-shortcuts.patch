+TEST(TableShortcutsTest, MenuLabelWinsOverLabel) {
+  Action row = ShortcutRow(kA, ShortcutSpec());
+  row.label_id = 11;
+  row.menu_label_id = 12;
+  EXPECT_EQ(12, TableLabelFor({row}, kA)->message_id);
+}
+
+TEST(TableShortcutsTest, LabelFallsBackToLabelWhenMenuLabelIsZero) {
+  Action row = ShortcutRow(kA, ShortcutSpec());
+  row.label_id = 11;
+  row.menu_label_id = 0;
+  EXPECT_EQ(11, TableLabelFor({row}, kA)->message_id);
+}
+
+TEST(TableShortcutsTest, MenuLabelAloneIsEnough) {
+  Action row = ShortcutRow(kA, ShortcutSpec());
+  row.menu_label_id = 12;
+  EXPECT_EQ(12, TableLabelFor({row}, kA)->message_id);
+}

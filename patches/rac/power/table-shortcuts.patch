+TEST(TableShortcutsTest, IsTableShortcutCommandForASingleRow) {
+  const std::vector<Action> rows = {ShortcutRow(kA, ShortcutSpec())};
+  EXPECT_TRUE(IsTableShortcutCommand(rows, kA));
+  EXPECT_FALSE(IsTableShortcutCommand(rows, kB));
+  EXPECT_FALSE(IsTableShortcutCommand(rows, 0));
+}
+
+TEST(TableShortcutsTest, IsTableShortcutCommandCoversEveryMemberOfARange) {
+  const std::vector<Action> rows = {SpaceRow()};
+  EXPECT_TRUE(IsTableShortcutCommand(rows, kSpace0));
+  EXPECT_TRUE(IsTableShortcutCommand(rows, kSpace0 + 4));
+  EXPECT_TRUE(IsTableShortcutCommand(rows, kSpace8));
+  EXPECT_FALSE(IsTableShortcutCommand(rows, kSpace0 - 1));
+  EXPECT_FALSE(IsTableShortcutCommand(rows, kSpace8 + 1));
+}

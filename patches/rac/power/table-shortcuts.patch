+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//testing/test.gni")
+
+# Turns the action table's default shortcuts into entries for Helium's browser
+# shortcut service. It lives apart from the pure-text logic in ../ because it
+# needs prefs and ui. ai:core is the lightest target with rac.ai.enabled
+# (ai_prefs.h), which hides ai_only rows while AI is off.
+source_set("shortcuts") {
+  sources = [
+    "table_shortcuts.cc",
+    "table_shortcuts.h",
+  ]
+  public_deps = [
+    "//base",
+    "//chrome/browser/rac/actions:core",
+    "//ui/base",
+    "//ui/events:events_base",
+  ]
+  deps = [
+    "//chrome/app:command_ids",
+    "//chrome/browser/rac/ai:core",
+    "//components/prefs",
+  ]
+}
+
+# Build with `autoninja -C out/Default
+# chrome/browser/rac/power/shortcuts:rac_power_shortcuts_unittests`. It's
+# separate from Chromium's unit_tests, which takes hours to build.
+test("rac_power_shortcuts_unittests") {
+  sources = [
+    "table_shortcuts_prefs_unittest.cc",
+    "table_shortcuts_unittest.cc",
+  ]
+  deps = [
+    ":shortcuts",
+    "//base",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+    "//chrome/app:command_ids",
+    "//chrome/browser/rac/ai:core",
+    "//components/prefs",
+    "//components/prefs:test_support",
+    "//testing/gtest",
+    "//ui/base",
+  ]
+}

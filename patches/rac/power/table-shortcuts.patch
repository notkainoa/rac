+
+Action PrefRow(int command_id, std::string_view pref) {
+  return {.id = "row",
+          .command_id = command_id,
+          .shortcut_pref = pref,
+          .surfaces = Surfaces{Surface::kShortcut}};
+}
+
+Action AiOnlyRow(int command_id) {

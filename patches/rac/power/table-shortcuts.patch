+// The user rebound a pref-gated row, then the pref flips off and on.
+TEST(TableShortcutsTest, PrefFlipKeepsALiveSavedRebind) {
+  Action row = ShortcutRow(kA, CtrlKey(ui::VKEY_K), "rac.pref");
+  row.label_id = 11;
+  const std::vector<Action> rows = {row};
+
+  // Pref off: the row is absent from the defaults but keeps its label, so
+  // Helium keeps the saved rebind (Ctrl+J) through every save.
+  {
+    auto off = [](std::string_view) { return false; };
+    FakeDefaults defaults;
+    base::flat_set<ui::Accelerator> seen;
+    Apply(EnabledTableShortcuts(rows, off, kAiOn),
+          TableCommandsWithoutDefault(rows, off, kAiOn), defaults, seen);
+    EXPECT_FALSE(defaults.contains(kA));
+    EXPECT_TRUE(LabelFor(rows, kA));
+    EXPECT_TRUE(
+        InactiveDeltaSurvives(defaults, kA, LabelFor(rows, kA).has_value()));
+  }
+
+  // Pref on again: the row is back in the defaults with its table key, and
+  // the saved rebind applies on top of it.
+  {
+    auto on = [](std::string_view) { return true; };
+    FakeDefaults defaults;
+    base::flat_set<ui::Accelerator> seen;
+    Apply(EnabledTableShortcuts(rows, on, kAiOn),
+          TableCommandsWithoutDefault(rows, on, kAiOn), defaults, seen);
+    ASSERT_TRUE(defaults.contains(kA));
+    EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_K), true}}),
+              defaults[kA]);
+    FakeDefaults current = defaults;
+    ApplyUserAddedKey(current, kA, Ctrl(ui::VKEY_J));
+    EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_J), true},
+                                      FakeEntry{Ctrl(ui::VKEY_K), true}}),
+              current[kA]);
+  }
+}

+// An ai_only row is absent everywhere while AI is off.
+TEST(TableShortcutsTest, AiOnlyRowWithAiOff) {
+  const std::vector<Action> rows = {AiOnlyRow(kA, CtrlKey(ui::VKEY_K, kOther)),
+                                    AiOnlyRow(kB, ShortcutSpec())};
+  constexpr bool kAiOff = false;
+  EXPECT_TRUE((Enabled(rows, /*pref_on=*/true, kAiOff)).empty());
+  EXPECT_TRUE((WithoutDefault(rows, /*pref_on=*/true, kAiOff)).empty());
+  EXPECT_FALSE(LabelFor(rows, kA, kAiOff));
+  EXPECT_FALSE(LabelFor(rows, kB, kAiOff));
+  EXPECT_FALSE(IsTableShortcutCommand(rows, kA, kAiOff));
+  // No label and no DCHECK: the label hook treats it as stale.
+  EXPECT_TRUE(IsStaleTableCommand(rows, kA, kAiOff));
+  EXPECT_TRUE(IsStaleTableCommand(rows, kB, kAiOff));
+
+  // The replaced command keeps its key.
+  FakeDefaults defaults;
+  defaults[kOther] = {{Ctrl(ui::VKEY_K), true}};
+  base::flat_set<ui::Accelerator> seen = {Ctrl(ui::VKEY_K)};
+  Apply(Enabled(rows, true, kAiOff), WithoutDefault(rows, true, kAiOff),
+        defaults, seen);
+  EXPECT_FALSE(defaults.contains(kA));
+  EXPECT_FALSE(defaults.contains(kB));
+  EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_K), true}}),
+            defaults[kOther]);
+
+  // The accepted cost: with no label, a saved rebind of the row is dropped
+  // at the next save while AI is off.
+  EXPECT_FALSE(InactiveDeltaSurvives(defaults, kA,
+                                     LabelFor(rows, kA, kAiOff).has_value()));
+}

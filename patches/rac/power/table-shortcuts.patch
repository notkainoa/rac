--- /dev/null
+++ src/chrome/browser/rac/power/shortcuts/table_shortcuts.cc
@@ -0,0 +1,210 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/shortcuts/table_shortcuts.h"
+
+#include <algorithm>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/rac/actions/rac_action_ids.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace rac::power {
+
+namespace {
+
+// A ranged row whose last id comes before its first. It is a table bug, so it
+// gets no default, no label, and no listing.
+bool IsMalformed(const action_table::Action& row) {
+  return row.command_id_last != 0 && row.command_id_last < row.command_id;
+}
+
+// The last command id of a row: a single command is its own last.
+int LastCommandId(const action_table::Action& row) {
+  return row.command_id_last != 0 ? row.command_id_last : row.command_id;
+}
+
+bool IsDigitKey(ui::KeyboardCode key) {
+  return key >= ui::VKEY_0 && key <= ui::VKEY_9;
+}
+
+// Whether the row's shortcut can be expanded across its whole range.
+bool RangeKeysFit(const action_table::Action& row) {
+  const int count = LastCommandId(row) - row.command_id;
+  const int first = row.default_shortcut.key;
+  return IsDigitKey(row.default_shortcut.key) &&
+         IsDigitKey(static_cast<ui::KeyboardCode>(first + count));
+}
+
+bool IsShortcutRow(const action_table::Action& row) {
+  return row.surfaces.Has(action_table::Surface::kShortcut) &&
+         !IsMalformed(row);
+}
+
+bool IsListedRow(const action_table::Action& row) {
+  return IsShortcutRow(row) && row.command_id != 0;
+}
+
+bool PrefOn(const action_table::Action& row, PrefIsOn pref_is_on) {
+  return row.shortcut_pref.empty() || pref_is_on(row.shortcut_pref);
+}
+
+// Whether the row's table data allows a default, ignoring its pref.
+bool HasUsableDefault(const action_table::Action& row) {
+  if (row.default_shortcut.empty()) {
+    return false;
+  }
+  return row.command_id_last == 0 ||
+         (row.default_shortcut.replaces_command_id == 0 && RangeKeysFit(row));
+}
+
+// Whether the row contributes defaults at all.
+bool RowIsEnabled(const action_table::Action& row, PrefIsOn pref_is_on) {
+  return IsListedRow(row) && HasUsableDefault(row) && PrefOn(row, pref_is_on);
+}
+
+}  // namespace
+
+std::vector<TableShortcut> EnabledTableShortcuts(
+    base::span<const action_table::Action> rows,
+    PrefIsOn pref_is_on) {
+  std::vector<TableShortcut> result;
+  for (const action_table::Action& row : rows) {
+    if (!RowIsEnabled(row, pref_is_on)) {
+      continue;
+    }
+    const int count = LastCommandId(row) - row.command_id;
+    for (int i = 0; i <= count; ++i) {
+      result.push_back(
+          {.command_id = row.command_id + i,
+           .accelerator = ui::Accelerator(
+               static_cast<ui::KeyboardCode>(row.default_shortcut.key + i),
+               row.default_shortcut.modifiers),
+           .replaces_command_id = row.default_shortcut.replaces_command_id});
+    }
+  }
+  return result;
+}
+
+std::vector<int> TableCommandsWithoutDefault(
+    base::span<const action_table::Action> rows,
+    PrefIsOn pref_is_on) {
+  std::vector<int> result;
+  for (const action_table::Action& row : rows) {
+    // A row whose pref is off is inactive, not empty: it adds nothing.
+    if (!IsListedRow(row) || !PrefOn(row, pref_is_on) ||
+        HasUsableDefault(row)) {
+      continue;
+    }
+    for (int id = row.command_id; id <= LastCommandId(row); ++id) {
+      result.push_back(id);
+    }
+  }
+  return result;
+}
+
+std::vector<std::string_view> TableShortcutPrefs(
+    base::span<const action_table::Action> rows) {
+  std::vector<std::string_view> result;
+  for (const action_table::Action& row : rows) {
+    if (row.surfaces.Has(action_table::Surface::kShortcut) &&
+        !row.shortcut_pref.empty() &&
+        std::ranges::find(result, row.shortcut_pref) == result.end()) {
+      result.push_back(row.shortcut_pref);
+    }
+  }
+  return result;
+}
+
+std::optional<TableLabel> TableLabelFor(
+    base::span<const action_table::Action> rows,
+    int command_id) {
+  if (command_id == 0) {
+    return std::nullopt;
+  }
+  for (const action_table::Action& row : rows) {
+    if (!IsListedRow(row) || command_id < row.command_id ||
+        command_id > LastCommandId(row)) {
+      continue;
+    }
+    TableLabel label;
+    label.message_id =
+        row.menu_label_id != 0 ? row.menu_label_id : row.label_id;
+    if (label.message_id == 0) {
+      return std::nullopt;
+    }
+    if (row.command_id_last != 0) {
+      label.replacement =
+          base::NumberToString16(command_id - row.command_id + 1);
+    }
+    return label;
+  }
+  return std::nullopt;
+}
+
+std::optional<TableLabel> TableLabelFor(int command_id) {
+  return TableLabelFor(action_table::All(), command_id);
+}
+
+bool IsStaleTableCommand(base::span<const action_table::Action> rows,
+                         int command_id) {
+  return command_id >= IDC_RAC_ACTION_FIRST &&
+         command_id <= IDC_RAC_ACTION_LAST &&
+         !TableLabelFor(rows, command_id).has_value();
+}
+
+bool IsStaleTableCommand(int command_id) {
+  return IsStaleTableCommand(action_table::All(), command_id);
+}
+
+bool IsTableShortcutCommand(base::span<const action_table::Action> rows,
+                            int command_id) {
+  if (command_id == 0) {
+    return false;
+  }
+  return std::ranges::any_of(
+      rows, [command_id](const action_table::Action& row) {
+        return IsListedRow(row) && command_id >= row.command_id &&
+               command_id <= LastCommandId(row);
+      });
+}
+
+bool IsTableShortcutCommand(int command_id) {
+  return IsTableShortcutCommand(action_table::All(), command_id);
+}
+
+void ObserveTableShortcutPrefs(base::span<const action_table::Action> rows,
+                               PrefChangeRegistrar& registrar,
+                               const base::RepeatingClosure& callback) {
+  for (std::string_view pref : TableShortcutPrefs(rows)) {
+    const std::string name(pref);
+    if (!registrar.IsObserved(name)) {
+      registrar.Add(name, callback);
+    }
+  }
+}
+
+void ObserveTableShortcutPrefs(PrefChangeRegistrar& registrar,
+                               const base::RepeatingClosure& callback) {
+  ObserveTableShortcutPrefs(action_table::All(), registrar, callback);
+}
+
+bool IsShortcutPrefOn(const PrefService* prefs, std::string_view pref) {
+  if (pref.empty()) {
+    return true;
+  }
+  if (!prefs) {
+    return false;
+  }
+  const PrefService::Preference* preference = prefs->FindPreference(pref);
+  if (!preference || preference->GetType() != base::Value::Type::BOOLEAN) {
+    return false;
+  }
+  return prefs->GetBoolean(pref);
+}
+
+}  // namespace rac::power

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/shortcuts/table_shortcuts.h"
+
+#include <algorithm>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/rac/actions/rac_action_ids.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace rac::power {
+
+namespace {
+
+using action_table::Action;
+using action_table::ShortcutSpec;
+using action_table::Surface;
+using action_table::Surfaces;
+
+constexpr int kA = 100;
+constexpr int kB = 200;
+constexpr int kOther = 300;
+constexpr int kSpace0 = 400;
+constexpr int kSpace8 = 408;
+
+// Most tests run with AI on; the AI-off ones say so.
+constexpr bool kAiOn = true;
+
+// Stands in for BrowserShortcutService::AcceleratorEntry.
+struct FakeEntry {
+  ui::Accelerator accelerator;
+  bool user_modifiable = true;
+  bool operator==(const FakeEntry&) const = default;
+};
+using FakeDefaults = std::map<int, std::vector<FakeEntry>>;
+
+ui::Accelerator Ctrl(ui::KeyboardCode key) {
+  return ui::Accelerator(key, ui::EF_CONTROL_DOWN);
+}
+
+Action ShortcutRow(int command_id,
+                   ShortcutSpec shortcut,
+                   std::string_view pref = "") {
+  return {.id = "row",
+          .command_id = command_id,
+          .default_shortcut = shortcut,
+          .shortcut_pref = pref,
+          .surfaces = Surfaces{Surface::kShortcut}};
+}
+
+ShortcutSpec CtrlKey(ui::KeyboardCode key, int replaces = 0) {
+  return {.key = key,
+          .modifiers = ui::EF_CONTROL_DOWN,
+          .replaces_command_id = replaces};
+}
+
+Action SpaceRow(ui::KeyboardCode key = ui::VKEY_1) {
+  Action row = ShortcutRow(kSpace0, CtrlKey(key));
+  row.command_id_last = kSpace8;
+  return row;
+}
+
+std::vector<TableShortcut> Enabled(const std::vector<Action>& rows,
+                                   bool pref_on = true,
+                                   bool ai_on = kAiOn) {
+  return EnabledTableShortcuts(
+      rows, [&](std::string_view) { return pref_on; }, ai_on);
+}
+
+std::vector<int> WithoutDefault(const std::vector<Action>& rows,
+                                bool pref_on = true,
+                                bool ai_on = kAiOn) {
+  return TableCommandsWithoutDefault(
+      rows, [&](std::string_view) { return pref_on; }, ai_on);
+}
+
+// TableLabelFor() with every message holding a $1.
+std::optional<TableLabel> LabelFor(base::span<const Action> rows,
+                                   int command_id,
+                                   bool ai_on = kAiOn) {
+  return TableLabelFor(rows, command_id, ai_on, [](int) { return true; });
+}
+
+std::vector<int> Commands(const std::vector<TableShortcut>& shortcuts) {
+  std::vector<int> ids;
+  for (const TableShortcut& s : shortcuts) {
+    ids.push_back(s.command_id);
+  }
+  return ids;
+}
+
+// Runs the shortcuts the way the service hook does, with every command
+// labelled and every accelerator storable.
+void Apply(const std::vector<TableShortcut>& shortcuts,
+           const std::vector<int>& without_default,
+           FakeDefaults& defaults,
+           base::flat_set<ui::Accelerator>& seen) {
+  ApplyTableShortcuts<FakeEntry>(
+      shortcuts, without_default, defaults, seen, [](int) { return true; },
+      [](const ui::Accelerator&) { return true; });
+}
+
+}  // namespace
+
+TEST(TableShortcutsTest, EmptyTableGivesNothing) {
+  EXPECT_TRUE((Enabled({})).empty());
+  EXPECT_TRUE((WithoutDefault({})).empty());
+}
+
+TEST(TableShortcutsTest, SingleRowWithPrefOn) {
+  std::vector<std::string_view> asked;
+  const std::vector<Action> rows = {
+      ShortcutRow(kA, CtrlKey(ui::VKEY_K), "rac.pref")};
+  std::vector<TableShortcut> got = EnabledTableShortcuts(
+      rows,
+      [&](std::string_view pref) {
+        asked.push_back(pref);
+        return true;
+      },
+      kAiOn);
+  ASSERT_EQ(1u, got.size());
+  EXPECT_EQ(kA, got[0].command_id);
+  EXPECT_EQ(Ctrl(ui::VKEY_K), got[0].accelerator);
+  EXPECT_EQ(0, got[0].replaces_command_id);
+  EXPECT_EQ((std::vector<std::string_view>{"rac.pref"}), asked);
+  EXPECT_TRUE((WithoutDefault(rows)).empty());
+}
+
+TEST(TableShortcutsTest, PrefOffRowIsInactiveNotEmpty) {
+  const std::vector<Action> rows = {
+      ShortcutRow(kA, CtrlKey(ui::VKEY_K), "rac.pref"),
+      ShortcutRow(kB, ShortcutSpec(), "rac.pref")};
+  EXPECT_TRUE((Enabled(rows, /*pref_on=*/false)).empty());
+  EXPECT_TRUE((WithoutDefault(rows, /*pref_on=*/false)).empty());
+}
+
+TEST(TableShortcutsTest, PrefOffRowIsAbsentFromDefaultsEvenWithASpec) {
+  // Helium keeps the saved rebinds of commands that are absent from its
+  // defaults, so a pref flip must not list the command with an empty vector.
+  Action space = SpaceRow();
+  space.shortcut_pref = "rac.pref";
+  const std::vector<Action> rows = {
+      ShortcutRow(kA, CtrlKey(ui::VKEY_K), "rac.pref"), space};
+  FakeDefaults defaults;
+  base::flat_set<ui::Accelerator> seen;
+  auto off = [](std::string_view) { return false; };
+  Apply(EnabledTableShortcuts(rows, off, kAiOn),
+        TableCommandsWithoutDefault(rows, off, kAiOn), defaults, seen);
+  EXPECT_FALSE(defaults.contains(kA));
+  EXPECT_FALSE(defaults.contains(kSpace0));
+  EXPECT_TRUE(defaults.empty());
+  EXPECT_TRUE(seen.empty());
+}
+
+TEST(TableShortcutsTest, EmptyPrefNameCountsAsOnAndIsNeverAsked) {
+  const std::vector<Action> rows = {ShortcutRow(kA, CtrlKey(ui::VKEY_K), "")};
+  bool asked = false;
+  auto got = EnabledTableShortcuts(
+      rows,
+      [&](std::string_view) {
+        asked = true;
+        return false;
+      },
+      kAiOn);
+  EXPECT_EQ(1u, got.size());
+  EXPECT_FALSE(asked);
+}
+
+TEST(TableShortcutsTest, PrefsAreAskedPerRow) {
+  const std::vector<Action> rows = {
+      ShortcutRow(kA, CtrlKey(ui::VKEY_K), "on"),
+      ShortcutRow(kB, CtrlKey(ui::VKEY_J), "off")};
+  auto pref_is_on = [](std::string_view pref) { return pref == "on"; };
+  EXPECT_EQ((std::vector<int>{kA}),
+            Commands(EnabledTableShortcuts(rows, pref_is_on, kAiOn)));
+  EXPECT_TRUE((TableCommandsWithoutDefault(rows, pref_is_on, kAiOn)).empty());
+}
+
+TEST(TableShortcutsTest, EmptyShortcutIsListedWithoutDefault) {
+  const std::vector<Action> rows = {ShortcutRow(kA, ShortcutSpec())};
+  EXPECT_TRUE((Enabled(rows)).empty());
+  EXPECT_EQ((std::vector<int>{kA}), WithoutDefault(rows));
+}
+
+TEST(TableShortcutsTest, RowWithoutShortcutSurfaceIsIgnored) {
+  Action row = ShortcutRow(kA, CtrlKey(ui::VKEY_K));
+  row.surfaces = Surfaces{Surface::kMenu, Surface::kCommandBar};
+  EXPECT_TRUE((Enabled({row})).empty());
+  EXPECT_TRUE((WithoutDefault({row})).empty());
+}
+
+TEST(TableShortcutsTest, CommandIdZeroIsIgnored) {
+  const std::vector<Action> rows = {ShortcutRow(0, CtrlKey(ui::VKEY_K))};
+  EXPECT_TRUE((Enabled(rows)).empty());
+  EXPECT_TRUE((WithoutDefault(rows)).empty());
+}
+
+TEST(TableShortcutsTest, ReplacementIsCarried) {
+  const std::vector<Action> rows = {
+      ShortcutRow(kA, CtrlKey(ui::VKEY_T, kOther))};
+  auto got = Enabled(rows);
+  ASSERT_EQ(1u, got.size());
+  EXPECT_EQ(kOther, got[0].replaces_command_id);
+}
+
+TEST(TableShortcutsTest, TableOrderIsKept) {
+  const std::vector<Action> rows = {ShortcutRow(kB, CtrlKey(ui::VKEY_Z)),
+                                    ShortcutRow(kA, CtrlKey(ui::VKEY_A))};
+  EXPECT_EQ((std::vector<int>{kB, kA}), Commands(Enabled(rows)));
+}
+
+TEST(TableShortcutsTest, RangeExpandsCtrl1To9) {
+  const std::vector<Action> rows = {SpaceRow()};
+  auto got = Enabled(rows);
+  ASSERT_EQ(9u, got.size());
+  for (int i = 0; i < 9; ++i) {
+    EXPECT_EQ(kSpace0 + i, got[i].command_id);
+    EXPECT_EQ(Ctrl(static_cast<ui::KeyboardCode>(ui::VKEY_1 + i)),
+              got[i].accelerator);
+    EXPECT_EQ(0, got[i].replaces_command_id);
+  }
+  EXPECT_TRUE((WithoutDefault(rows)).empty());
+}
+
+TEST(TableShortcutsTest, RangeStartingAtZeroFitsWhenItEndsAtNine) {
+  Action row = SpaceRow(ui::VKEY_0);
+  row.command_id_last = kSpace0 + 9;
+  auto got = Enabled({row});
+  ASSERT_EQ(10u, got.size());
+  EXPECT_EQ(Ctrl(ui::VKEY_9), got[9].accelerator);
+}
+
+TEST(TableShortcutsTest, RangeWithALetterKeyGetsNothing) {
+  const std::vector<Action> rows = {SpaceRow(ui::VKEY_A)};
+  EXPECT_TRUE((Enabled(rows)).empty());
+  std::vector<int> ids = WithoutDefault(rows);
+  ASSERT_EQ(9u, ids.size());
+  EXPECT_EQ(kSpace0, ids.front());
+  EXPECT_EQ(kSpace8, ids.back());
+}
+
+TEST(TableShortcutsTest, RangeRunningPastNineGetsNothing) {
+  const std::vector<Action> rows = {SpaceRow(ui::VKEY_2)};
+  EXPECT_TRUE((Enabled(rows)).empty());
+  EXPECT_EQ(9u, WithoutDefault(rows).size());
+}
+
+TEST(TableShortcutsTest, RangeWithReplacementGetsNothing) {
+  Action row = SpaceRow();
+  row.default_shortcut.replaces_command_id = kOther;
+  EXPECT_TRUE((Enabled({row})).empty());
+  EXPECT_EQ(9u, WithoutDefault({row}).size());
+}
+
+TEST(TableShortcutsTest, RangePrefOffAddsNothing) {
+  Action row = SpaceRow();
+  row.shortcut_pref = "rac.pref";
+  EXPECT_TRUE((Enabled({row}, /*pref_on=*/false)).empty());
+  EXPECT_TRUE((WithoutDefault({row}, /*pref_on=*/false)).empty());
+}
+
+TEST(TableShortcutsTest, MalformedRangeGetsNothingAnywhere) {
+  Action row = SpaceRow();
+  row.command_id_last = kSpace0 - 1;
+  row.label_id = 22;
+  EXPECT_TRUE((Enabled({row})).empty());
+  EXPECT_TRUE((WithoutDefault({row})).empty());
+  EXPECT_FALSE(LabelFor({row}, kSpace0));
+  EXPECT_FALSE(LabelFor({row}, kSpace0 - 1));
+}
+
+TEST(TableShortcutsTest, MalformedRangeWithAnEmptyShortcutIsNotListed) {
+  Action row = ShortcutRow(kSpace0, ShortcutSpec());
+  row.command_id_last = kSpace0 - 5;
+  EXPECT_TRUE((WithoutDefault({row})).empty());
+}
+
+TEST(TableShortcutsTest, PrefsAreDistinctAndInTableOrder) {
+  std::vector<Action> rows = {
+      ShortcutRow(kA, CtrlKey(ui::VKEY_A), "b.pref"),
+      ShortcutRow(kB, CtrlKey(ui::VKEY_B), ""),
+      ShortcutRow(kOther, CtrlKey(ui::VKEY_C), "a.pref"),
+      ShortcutRow(500, CtrlKey(ui::VKEY_D), "b.pref")};
+  EXPECT_EQ((std::vector<std::string_view>{"b.pref", "a.pref"}),
+            TableShortcutPrefs(rows));
+  EXPECT_TRUE((TableShortcutPrefs({})).empty());
+}
+
+TEST(TableShortcutsTest, MenuOnlyRowHasNoLabelAndItsPrefIsNotReturned) {
+  Action row = {.id = "menu",
+                .command_id = kA,
+                .label_id = 11,
+                .shortcut_pref = "menu.pref",
+                .surfaces = Surfaces{Surface::kMenu}};
+  EXPECT_FALSE(LabelFor({row}, kA));
+  EXPECT_TRUE((TableShortcutPrefs({row})).empty());
+}
+
+TEST(TableShortcutsTest, ApplyAddsAnEntry) {
+  FakeDefaults defaults;
+  base::flat_set<ui::Accelerator> seen;
+  Apply({{kA, Ctrl(ui::VKEY_K), 0}}, {}, defaults, seen);
+  EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_K), true}}),
+            defaults[kA]);
+  EXPECT_TRUE(seen.contains(Ctrl(ui::VKEY_K)));
+}
+
+TEST(TableShortcutsTest, ApplyReplacementTakesTheKeyAndKeepsTheEmptyEntry) {
+  FakeDefaults defaults;
+  defaults[kOther] = {{Ctrl(ui::VKEY_T), true}};
+  base::flat_set<ui::Accelerator> seen = {Ctrl(ui::VKEY_T)};
+  Apply({{kA, Ctrl(ui::VKEY_T), kOther}}, {}, defaults, seen);
+  ASSERT_TRUE(defaults.contains(kOther));
+  EXPECT_TRUE((defaults[kOther]).empty());
+  EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_T), true}}),
+            defaults[kA]);
+  EXPECT_TRUE(seen.contains(Ctrl(ui::VKEY_T)));
+}
+
+TEST(TableShortcutsTest, ApplyReplacementKeepsTheReplacedCommandsOtherKeys) {
+  FakeDefaults defaults;
+  defaults[kOther] = {{Ctrl(ui::VKEY_N), true}, {Ctrl(ui::VKEY_T), true}};
+  base::flat_set<ui::Accelerator> seen = {Ctrl(ui::VKEY_N), Ctrl(ui::VKEY_T)};
+  Apply({{kA, Ctrl(ui::VKEY_T), kOther}}, {}, defaults, seen);
+  EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_N), true}}),
+            defaults[kOther]);

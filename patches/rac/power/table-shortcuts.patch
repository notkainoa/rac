+TEST(TableShortcutsTest, AiOffLeavesOtherRowsAlone) {
+  Action plain = ShortcutRow(kB, CtrlKey(ui::VKEY_J));
+  plain.label_id = 12;
+  const std::vector<Action> rows = {AiOnlyRow(kA, CtrlKey(ui::VKEY_K)), plain};
+  EXPECT_EQ((std::vector<int>{kB}),
+            Commands(Enabled(rows, /*pref_on=*/true, /*ai_on=*/false)));
+  EXPECT_EQ(12, LabelFor(rows, kB, /*ai_on=*/false)->message_id);
+  EXPECT_TRUE(IsTableShortcutCommand(rows, kB, /*ai_on=*/false));
+}
+
+TEST(TableShortcutsTest, AiOnlyShortcutRowIsFound) {
+  Action menu_only = AiOnlyRow(kA, ShortcutSpec());
+  menu_only.surfaces = Surfaces{Surface::kMenu};
+  EXPECT_FALSE(HasAiOnlyShortcutRow({}));
+  EXPECT_FALSE(HasAiOnlyShortcutRow({ShortcutRow(kA, ShortcutSpec())}));
+  EXPECT_FALSE(HasAiOnlyShortcutRow({menu_only}));
+  EXPECT_FALSE(HasAiOnlyShortcutRow({AiOnlyRow(0, ShortcutSpec())}));
+  EXPECT_TRUE(HasAiOnlyShortcutRow({AiOnlyRow(kA, ShortcutSpec())}));
+}
+
+// A table default against keys someone else already has.
+TEST(TableShortcutsTest, TableDefaultNeverStealsAKeyInSeen) {
+  // Ctrl+K is a Helium default of kOther, so it is in `seen`.
+  const std::vector<Action> rows = {ShortcutRow(kA, CtrlKey(ui::VKEY_K))};
+  FakeDefaults defaults;
+  defaults[kOther] = {{Ctrl(ui::VKEY_K), true}};
+  base::flat_set<ui::Accelerator> seen = {Ctrl(ui::VKEY_K)};
+  Apply(Enabled(rows), WithoutDefault(rows), defaults, seen);
+  EXPECT_TRUE(defaults[kA].empty());
+  EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_K), true}}),
+            defaults[kOther]);
+}
+
+TEST(TableShortcutsTest, AUserBindingOfTheSameKeyWinsOverATableDefault) {
+  // The user bound Ctrl+J to kOther. That is a saved delta, not a default,
+  // so it isn't in `seen` and the table's row gets Ctrl+J as its default.
+  // Helium then applies the delta in LoadFromPrefs: the table's entry is
+  // user-modifiable, so RemoveConflictingAccelerators takes the key from the
+  // row and the user's binding wins. Binding it live
+  // (AssignAcceleratorToCommand, :166-180 in Helium's file) goes through the
+  // same two checks.
+  const std::vector<Action> rows = {ShortcutRow(kA, CtrlKey(ui::VKEY_J))};
+  FakeDefaults defaults;
+  defaults[kOther] = {};
+  base::flat_set<ui::Accelerator> seen;
+  Apply(Enabled(rows), WithoutDefault(rows), defaults, seen);
+  ASSERT_EQ(1u, defaults[kA].size());
+  EXPECT_TRUE(defaults[kA][0].user_modifiable);
+
+  FakeDefaults current = defaults;
+  ApplyUserAddedKey(current, kOther, Ctrl(ui::VKEY_J));
+  EXPECT_TRUE(current[kA].empty());
+  EXPECT_EQ((std::vector<FakeEntry>{FakeEntry{Ctrl(ui::VKEY_J), true}}),
+            current[kOther]);
+}

+TEST(TableShortcutsTest, NoLabelGivesNothing) {
+  const std::vector<Action> rows = {ShortcutRow(kA, ShortcutSpec())};
+  EXPECT_FALSE(TableLabelFor(rows, kA));
+}
+
+TEST(TableShortcutsTest, UnknownIdGivesNothing) {
+  Action row = ShortcutRow(kA, ShortcutSpec());
+  row.label_id = 11;
+  EXPECT_FALSE(TableLabelFor({row}, kB));

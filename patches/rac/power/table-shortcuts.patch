--- /dev/null
+++ src/chrome/browser/rac/power/shortcuts/table_shortcuts.h
@@ -0,0 +1,280 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_POWER_SHORTCUTS_TABLE_SHORTCUTS_H_
+#define CHROME_BROWSER_RAC_POWER_SHORTCUTS_TABLE_SHORTCUTS_H_
+
+#include <algorithm>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/containers/span.h"
+#include "base/functional/callback.h"
+#include "base/functional/function_ref.h"
+#include "chrome/browser/rac/actions/rac_actions.h"
+#include "ui/base/accelerators/accelerator.h"
+
+class PrefChangeRegistrar;
+class PrefService;
+
+namespace rac::power {
+
+// One default shortcut the action table asks for. A ranged row (Show Space
+// 1-9) expands to one of these per command id.
+struct TableShortcut {
+  int command_id = 0;
+  ui::Accelerator accelerator;
+  // The command whose default this one takes over, or 0.
+  int replaces_command_id = 0;
+};
+
+// Whether Helium's shortcut page can name the command (it has a label).
+using HasLabel = base::FunctionRef<bool(int command_id)>;
+// Whether Helium can store the accelerator (it has a serialized form).
+using CanStore = base::FunctionRef<bool(const ui::Accelerator&)>;
+
+// Says whether the boolean pref called `pref` is on. Only called with a
+// non-empty name.
+using PrefIsOn = base::FunctionRef<bool(std::string_view pref)>;
+
+// Whether the text of `message_id` has a $1 for a ranged row's ordinal.
+using HasPlaceholder = base::FunctionRef<bool(int message_id)>;
+
+// AI off. Every function below that takes `ai_on` treats an ai_only row as
+// absent while it is false: no default, no listing, no label, and no menu
+// management, the same as a row whose shortcut_pref is off. The overloads the
+// browser calls read `ai_on` from the profile's rac.ai.enabled.
+//
+// The cost: Helium keeps the saved rebind of an absent command only while the
+// command has a label (PersistToPrefs drops the others). So a user's rebind
+// of an ai_only row is lost at the next save made while AI is off, and the
+// row comes back with its table default when AI is turned on again. That is
+// accepted: with AI off, no AI label may show anywhere.
+
+// The default shortcuts to add, in table order. A row counts when it has the
+// kShortcut surface, a command id, a non-empty default shortcut, its
+// shortcut_pref is on ("" counts as on), and it isn't ai_only with AI off.
+//
+// A ranged row (command_id_last != 0) gives command id `command_id + i` the
+// key `key + i`. It only counts when the first and last keys are both in
+// VKEY_0..VKEY_9; otherwise the whole range gets nothing. A ranged row can't
+// replace another command, so one that tries gets nothing too.
+std::vector<TableShortcut> EnabledTableShortcuts(
+    base::span<const action_table::Action> rows,
+    PrefIsOn pref_is_on,
+    bool ai_on);
+
+// Every command id of the kShortcut rows that are on but got no usable default
+// (empty shortcut, a range whose keys don't fit, a range with a replacement).
+// They are still listed on the shortcut page, so the user can bind them.
+//
+// A row whose pref is off (or an ai_only row with AI off) is inactive, not
+// empty: it is in neither list, so
+// its command is absent from Helium's defaults. Helium keeps the saved
+// rebinds of commands that are absent (PersistToPrefs preserves the deltas of
+// inactive commands). Listing the command with an empty vector would make
+// the next load wipe the user's rebind on every pref flip. A malformed range
+// (command_id_last < command_id) is in neither list.
+std::vector<int> TableCommandsWithoutDefault(
+    base::span<const action_table::Action> rows,
+    PrefIsOn pref_is_on,
+    bool ai_on);
+
+// The distinct non-empty shortcut_pref names of the kShortcut rows, in table
+// order.
+std::vector<std::string_view> TableShortcutPrefs(
+    base::span<const action_table::Action> rows);
+
+struct TableLabel {
+  int message_id = 0;
+  // The text for $1 in the message, when the row is a numbered set.
+  std::optional<std::u16string> replacement;
+};
+
+// The label the shortcut page shows for `command_id`. Finds the kShortcut row
+// whose command id range holds it. The message is menu_label_id, or label_id
+// when that is 0. A ranged row's replacement is the ordinal ("1".."9"). Returns
+// nullopt when no row holds the id, the row has no label, or the row is
+// ai_only and AI is off.
+//
+// A ranged row whose message has no $1 (`has_placeholder` says so; it is only
+// asked for ranged rows) gets no replacement: l10n_util DCHECKs on a
+// replacement it can't place, and the service formats every label when the
+// profile loads. Every member of that range then shows the same name, which
+// is wrong but harmless, and a translation that dropped the $1 can't crash
+// the shortcut page.
+std::optional<TableLabel> TableLabelFor(
+    base::span<const action_table::Action> rows,
+    int command_id,
+    bool ai_on,
+    HasPlaceholder has_placeholder);
+
+// TableLabelFor() on the whole action table, with AI read from `prefs` (null
+// counts as AI off) and the placeholder checked in the loaded strings. The
+// browser's shortcut hooks call this, so they don't have to include the
+// table.
+std::optional<TableLabel> TableLabelFor(int command_id,
+                                        const PrefService* prefs);
+
+// Whether `command_id` is rac's but the table gives it no label now, so the
+// label hook says "no label" instead of treating the id as a bug. That is an
+// id in rac's whole block (IDC_RAC_ASSISTANT_TOGGLE, the first rac id in
+// chrome_command_ids.h, through IDC_RAC_ACTION_LAST) that no labelled row
+// holds: a row removed or renumbered since the user saved a rebind under it,
+// or an ai_only row while AI is off. Helium's label switch names the legacy
+// rac ids it knows before this runs, so only unknown ones get here. An id a
+// row holds outside the block (an ai_only row with AI off) is stale too.
+// Helium asks for the label of every saved id.
+bool IsStaleTableCommand(base::span<const action_table::Action> rows,
+                         int command_id,
+                         bool ai_on);
+bool IsStaleTableCommand(int command_id, const PrefService* prefs);
+
+// Whether `command_id` belongs to a kShortcut row (or to a member of its
+// range), whatever the row's pref says. An ai_only row counts only when
+// `ai_on`.
+bool IsTableShortcutCommand(base::span<const action_table::Action> rows,
+                            int command_id,
+                            bool ai_on);
+
+// The Mac menu code's check, which has no PrefService: the Mac menu is shared
+// by every profile. It counts ai_only rows whatever AI says, because that is
+// the safe side for both callers. AppendMenuItems() skips reading a table
+// command's key back from the menu, which can never add a key. A managed menu
+// item (ShouldManageMenuItem()) takes its key from the active profile's
+// service, which holds no entry for an ai_only row while AI is off, so the
+// item's key is cleared. Leaving it unmanaged would keep whatever key a
+// window with AI on last set. Core's menu hook decides whether the item shows.
+bool IsTableShortcutCommand(int command_id);
+
+// Whether any ai_only row is a kShortcut row with a command id, so the
+// shortcut service has to watch rac.ai.enabled.
+bool HasAiOnlyShortcutRow(base::span<const action_table::Action> rows);
+
+// Whether AI is on for `prefs`: rac::ai::IsAiEnabled(), with null or an
+// unregistered pref counting as off (it never CHECKs).
+bool IsTableAiOn(const PrefService* prefs);
+
+// Watches every name from TableShortcutPrefs with `callback`, plus
+// rac.ai.enabled when HasAiOnlyShortcutRow() (so AI-off pays nothing while
+// no such row exists). A name the registrar already observes (a row reusing
+// one of Helium's prefs) is skipped, because adding it twice DCHECKs.
+void ObserveTableShortcutPrefs(base::span<const action_table::Action> rows,
+                               PrefChangeRegistrar& registrar,
+                               const base::RepeatingClosure& callback);
+
+// ObserveTableShortcutPrefs() on the whole action table.
+void ObserveTableShortcutPrefs(PrefChangeRegistrar& registrar,
+                               const base::RepeatingClosure& callback);
+
+// Reads a boolean pref. "" is always on. A pref that isn't registered, isn't
+// a boolean, or a null `prefs` is off; this never CHECKs.
+bool IsShortcutPrefOn(const PrefService* prefs, std::string_view pref);
+
+// Adds `shortcuts` to Helium's default accelerators. `Entry` is Helium's
+// BrowserShortcutService::AcceleratorEntry; tests use a fake with the same
+// two fields: {ui::Accelerator accelerator; bool user_modifiable;}.
+//
+// For each shortcut, in order:
+// 0. If `has_label` says the command has no label, skip it and change nothing
+//    (Helium's insert_default does the same). If `can_store` says the
+//    accelerator can't be stored, skip it but keep the command listed.
+// 1. With replaces_command_id: if that command holds the same accelerator
+//    and it is locked, skip the shortcut and keep the command listed. If it
+//    is not locked, erase that entry. The replaced command stays in
+//    `defaults`, even with no entries, so it stays listed and rebindable.
+// 2. Otherwise, if `seen` already holds the accelerator, skip the shortcut
+//    (keeping the command listed): it never takes a key from an unrelated
+//    command. If not, add it to `seen`.
+// 3. Add the entry to the command, keeping its vector sorted and free of
+//    duplicates.
+// Last, every labelled id in `without_default` gets an empty list if it has
+// none.
+template <typename Entry>
+void ApplyTableShortcuts(base::span<const TableShortcut> shortcuts,
+                         base::span<const int> without_default,
+                         std::map<int, std::vector<Entry>>& defaults,
+                         base::flat_set<ui::Accelerator>& seen,
+                         HasLabel has_label,
+                         CanStore can_store) {
+  for (const TableShortcut& shortcut : shortcuts) {
+    if (!has_label(shortcut.command_id)) {
+      continue;
+    }
+    if (!can_store(shortcut.accelerator)) {
+      defaults.try_emplace(shortcut.command_id);
+      continue;
+    }
+    bool replaced = false;
+    if (shortcut.replaces_command_id != 0) {
+      auto replaced_it = defaults.find(shortcut.replaces_command_id);
+      if (replaced_it != defaults.end()) {
+        std::vector<Entry>& held = replaced_it->second;
+        auto held_it =
+            std::ranges::find(held, shortcut.accelerator, &Entry::accelerator);
+        if (held_it != held.end()) {
+          if (!held_it->user_modifiable) {
+            // Keep the row listed, with no key, so it can still be bound.
+            defaults.try_emplace(shortcut.command_id);
+            continue;
+          }
+          held.erase(held_it);
+          replaced = true;
+        }
+      }
+    }
+    if (!seen.insert(shortcut.accelerator).second && !replaced) {
+      // Another command owns these keys; never take them.
+      defaults.try_emplace(shortcut.command_id);
+      continue;
+    }
+
+    std::vector<Entry>& entries = defaults[shortcut.command_id];
+    auto insert_at =
+        std::ranges::lower_bound(entries, shortcut.accelerator,
+                                 std::ranges::less(), &Entry::accelerator);
+    if (insert_at != entries.end() &&
+        insert_at->accelerator == shortcut.accelerator) {
+      continue;
+    }
+    entries.insert(insert_at, Entry{shortcut.accelerator, true});
+  }
+  for (int command_id : without_default) {
+    if (has_label(command_id)) {
+      defaults.try_emplace(command_id);
+    }
+  }
+}
+
+// The call the browser shortcut service makes at the end of
+// BuildCurrentDefaults(): reads the action table, the prefs, and whether AI
+// is on. The service passes its own label and storage checks. It is a
+// template so the table's code is only linked into the one place that
+// instantiates it.
+template <typename Entry>
+void ApplyTableShortcuts(const PrefService* prefs,
+                         std::map<int, std::vector<Entry>>& defaults,
+                         base::flat_set<ui::Accelerator>& seen,
+                         HasLabel has_label,
+                         CanStore can_store) {
+  auto pref_is_on = [prefs](std::string_view pref) {
+    return IsShortcutPrefOn(prefs, pref);
+  };
+  const bool ai_on = IsTableAiOn(prefs);
+  const base::span<const action_table::Action> rows = action_table::All();
+  const std::vector<TableShortcut> shortcuts =
+      EnabledTableShortcuts(rows, pref_is_on, ai_on);
+  const std::vector<int> without_default =
+      TableCommandsWithoutDefault(rows, pref_is_on, ai_on);
+  ApplyTableShortcuts<Entry>(shortcuts, without_default, defaults, seen,
+                             has_label, can_store);
+}
+
+}  // namespace rac::power
+
+#endif  // CHROME_BROWSER_RAC_POWER_SHORTCUTS_TABLE_SHORTCUTS_H_

+TEST(SitePatternTest, DomainIsStoresAnIdnHostAsPunycode) {
+  InitializeIcu();
+  // GURL canonicalizes an IDN host to punycode.
+  EXPECT_EQ("xn--bcher-kva.example", DomainValue("b\xC3\xBC"
+                                                 "cher.example"));
+  EXPECT_EQ("xn--bcher-kva.example", DomainValue("xn--bcher-kva.example"));
+
+  const std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kDomainIs,
+                          "b\xC3\xBC"
+                          "cher.example");
+  ASSERT_TRUE(pattern);
+  EXPECT_TRUE(pattern->Matches(GURL("https://xn--bcher-kva.example/")));
+  EXPECT_TRUE(
+      pattern->Matches(GURL("https://b\xC3\xBC"
+                            "cher.example/")));
+  EXPECT_TRUE(
+      pattern->Matches(GURL("https://app.b\xC3\xBC"
+                            "cher.example/")));
+  EXPECT_FALSE(
+      pattern->Matches(GURL("https://xn--bcher-kva.example.evil.test/")));
+}
+
+TEST(SitePatternTest, DomainIsHandlesAnIpv6Literal) {
+  // The canonical host keeps its brackets.
+  EXPECT_EQ("[::1]", DomainValue("[::1]"));
+  EXPECT_EQ("[::1]", DomainValue("http://[::1]:8080/x"));
+  EXPECT_EQ("[2001:db8::1]", DomainValue("[2001:DB8::1]"));
+  // A bare literal isn't a host without brackets.
+  EXPECT_FALSE(DomainValue("::1"));
+  EXPECT_FALSE(DomainValue("2001:db8::1"));
+
+  const std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kDomainIs, "[::1]");
+  ASSERT_TRUE(pattern);
+  EXPECT_TRUE(pattern->Matches(GURL("http://[::1]:8080/x")));
+  EXPECT_FALSE(pattern->Matches(GURL("http://[::2]/")));
+}
+
+TEST(SitePatternTest, DomainIsRefusesCredentialsAndBadPorts) {
+  // A pattern names a host, never a login.
+  EXPECT_FALSE(DomainValue("user@shop.example"));
+  EXPECT_FALSE(DomainValue("user:pass@shop.example"));
+  EXPECT_FALSE(DomainValue("https://user:pass@shop.example/x"));
+  // A port is fine to type, but a bad one kills the address.
+  EXPECT_EQ("shop.example", DomainValue("shop.example:8080"));
+  EXPECT_FALSE(DomainValue("shop.example:bad"));
+  EXPECT_FALSE(DomainValue("shop.example:99999"));
+}
+
+TEST(SitePatternTest, DomainIsStripsTabsButNotSpaces) {
+  // GURL removes tabs and newlines wherever they appear.
+  EXPECT_EQ("shop.example", DomainValue("shop.\texample"));
+  EXPECT_EQ("shop.example", DomainValue("shop.\nexample"));
+  // A space becomes %20 in the host, which no real host has.
+  EXPECT_FALSE(DomainValue("shop .example"));
+}
+
+TEST(SitePatternTest, DomainIsAllowsAnUnderscoreLabel) {
+  EXPECT_EQ("my_host.test", DomainValue("my_host.test"));
+  const std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kDomainIs, "my_host.test");
+  ASSERT_TRUE(pattern);
+  EXPECT_TRUE(pattern->Matches(GURL("https://my_host.test/")));
+  EXPECT_TRUE(pattern->Matches(GURL("https://a.my_host.test/")));
+}
+
+TEST(SitePatternTest, DomainIsStripsDotsAroundOddHosts) {
+  EXPECT_EQ("192.168.0.1", DomainValue("192.168.0.1."));
+  EXPECT_EQ("localhost", DomainValue(".localhost."));
+  EXPECT_EQ("shop.example", DomainValue("shop.example.."));
+  EXPECT_EQ("shop.example", DomainValue("*.SHOP.EXAMPLE."));
+}

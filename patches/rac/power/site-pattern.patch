+++ src/chrome/browser/rac/site_pattern/site_pattern.h
@@ -0,0 +1,81 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_SITE_PATTERN_SITE_PATTERN_H_
+#define CHROME_BROWSER_RAC_SITE_PATTERN_SITE_PATTERN_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace rac {
+
+// A rule that picks out a set of web pages. Only valid http and https URLs
+// ever match; every other scheme gives false.
+//
+// kDomainIs matches the stored host and any subdomain of it, on a label
+// boundary (`github.com` matches `gist.github.com`, not `notgithub.com`).
+//
+// kUrlContains matches when the stored text is a substring of the page's
+// canonical address, ignoring ASCII case. The needle is compared byte for
+// byte after ASCII lower-casing, so a non-ASCII needle only matches the
+// percent-encoded form that appears in the canonical address, never the
+// characters as typed. A typed space can't match either: in the canonical
+// address a space is `%20` or `+`.
+class SitePattern {
+ public:
+  enum class Type { kDomainIs, kUrlContains };
+
+  // Builds a pattern from what a person typed.
+  //
+  // kDomainIs takes a host or a whole address (`Shop.Example`,
+  // `https://shop.example/x?y`, `.shop.example`, `shop.example.`,
+  // `*.shop.example`, `https://*.shop.example`) and stores
+  // the canonical lower-case host without leading or trailing dots. It
+  // returns nullopt for empty input, a path alone, an address that is not
+  // http or https, and a bare ICANN public suffix (`com`, `co.uk`). A private
+  // suffix such as `github.io` or `blogspot.com` is accepted on purpose and
+  // matches every site under it. IP addresses and single labels such as
+  // `localhost` are allowed.
+  //
+  // kUrlContains trims whitespace, stores the ASCII-lower-cased text, and
+  // returns nullopt for empty input.
+  static std::optional<SitePattern> Create(Type type, std::string_view typed);
+
+  // Gives the "domain is" pattern for the site `url` belongs to: its
+  // registrable domain (`app.slack.com` gives `slack.com`; `me.github.io`
+  // stays itself), or its host for an IP address, a single label, or a bare
+  // private suffix (`https://github.io/` gives a `github.io` pattern).
+  // Returns nullopt when `url` is not a valid http or https address, or when
+  // its host is a bare ICANN public suffix (`https://co.uk/`).
+  static std::optional<SitePattern> ForSiteOf(const GURL& url);
+
+  // Reads a pattern written by ToValue(). The checks in Create() run again,
+  // so a hand-edited preference can't smuggle in a rule Create() would
+  // refuse. Returns nullopt for anything malformed.
+  static std::optional<SitePattern> FromValue(const base::DictValue& dict);
+
+  // Writes {"type": "domain" | "contains", "value": <text>}.
+  base::DictValue ToValue() const;
+
+  bool Matches(const GURL& url) const;
+
+  Type type() const { return type_; }
+  const std::string& value() const { return value_; }
+
+  friend bool operator==(const SitePattern&, const SitePattern&) = default;
+
+ private:
+  SitePattern(Type type, std::string value);
+
+  Type type_;
+  std::string value_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_SITE_PATTERN_SITE_PATTERN_H_
Index: src/chrome/browser/rac/site_pattern/site_pattern_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/site_pattern/site_pattern_unittest.cc
@@ -0,0 +1,481 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/site_pattern/site_pattern.h"
+
+#include <optional>
+#include <string>
+
+#include "base/i18n/icu_util.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+namespace {
+
+using Type = SitePattern::Type;
+
+// IDN hosts need ICU's data. base::TestSuite loads it in the real binary;
+// this also covers a plain gtest main.
+void InitializeIcu() {
+  base::i18n::AllowMultipleInitializeCallsForTesting();
+  ASSERT_TRUE(base::i18n::InitializeICU());
+}
+
+std::optional<std::string> DomainValue(std::string_view typed) {
+  std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kDomainIs, typed);
+  if (!pattern) {
+    return std::nullopt;
+  }
+  return pattern->value();
+}
+
+TEST(SitePatternTest, DomainIsStoresTheCanonicalHost) {
+  EXPECT_EQ("shop.example", DomainValue("shop.example"));
+  EXPECT_EQ("shop.example", DomainValue("Shop.Example"));
+  EXPECT_EQ("shop.example", DomainValue("  shop.example  "));
+  EXPECT_EQ("shop.example", DomainValue(".shop.example"));
+  EXPECT_EQ("shop.example", DomainValue("shop.example."));
+  EXPECT_EQ("shop.example", DomainValue("shop.example/path"));
+  EXPECT_EQ("shop.example", DomainValue("https://shop.example/x?y"));
+  EXPECT_EQ("shop.example", DomainValue("HTTP://Shop.Example:8080/x#y"));
+  EXPECT_EQ("slack.com", DomainValue("*.slack.com"));
+  EXPECT_EQ("slack.com", DomainValue("https://*.slack.com"));
+}
+
+TEST(SitePatternTest, DomainIsRefusesWhatIsNotASite) {
+  EXPECT_FALSE(DomainValue(""));
+  EXPECT_FALSE(DomainValue("   "));
+  EXPECT_FALSE(DomainValue("/path"));
+  EXPECT_FALSE(DomainValue("/shop.example"));
+  EXPECT_FALSE(DomainValue("chrome://settings"));
+  EXPECT_FALSE(DomainValue("ftp://shop.example/"));
+  EXPECT_FALSE(DomainValue("file:///tmp/a"));
+  EXPECT_FALSE(DomainValue("https://"));
+  EXPECT_FALSE(DomainValue("."));
+  // Only one `*.` is stripped; a wildcard left in the host could never
+  // match.
+  EXPECT_FALSE(DomainValue("https://*.*.slack.com"));
+  EXPECT_FALSE(DomainValue("*.*.slack.com"));
+  EXPECT_FALSE(DomainValue("sl*ck.com"));
+}
+
+TEST(SitePatternTest, DomainIsReadsASchemeOnlyBeforeThePath) {
+  EXPECT_EQ("a.test", DomainValue("a.test/?r=https://b.test"));
+  EXPECT_EQ("a.test", DomainValue("a.test?r=https://b.test"));
+}
+
+// A scheme and a colon without `//` after it isn't a host: today it would
+// store `https` or `http`.
+TEST(SitePatternTest, DomainIsRefusesASchemeWithoutSlashes) {
+  EXPECT_FALSE(DomainValue("https:/shop.example"));
+  EXPECT_FALSE(DomainValue("http:shop.example"));
+  EXPECT_FALSE(DomainValue("HTTPS:/shop.example"));
+  EXPECT_FALSE(DomainValue("https:"));
+  EXPECT_FALSE(DomainValue("mailto:a@shop.example"));
+  // The colon missing instead of a slash.
+  EXPECT_FALSE(DomainValue("https//shop.example"));
+  EXPECT_FALSE(DomainValue("http//shop.example"));
+}
+
+// What follows the colon is a port, not a scheme.
+TEST(SitePatternTest, DomainIsKeepsAHostAndPort) {
+  EXPECT_EQ("localhost", DomainValue("localhost:8080"));
+  EXPECT_EQ("shop.example", DomainValue("shop.example:8080/path"));
+}
+
+TEST(SitePatternTest, DomainIsRefusesABarePublicSuffix) {
+  EXPECT_FALSE(DomainValue("com"));
+  EXPECT_FALSE(DomainValue("COM"));
+  EXPECT_FALSE(DomainValue(".com."));
+  EXPECT_FALSE(DomainValue("co.uk"));
+  EXPECT_FALSE(DomainValue("*.com"));
+  EXPECT_FALSE(DomainValue("https://co.uk/page"));
+}
+
+TEST(SitePatternTest, DomainIsAllowsPrivateSuffixesIpsAndSingleLabels) {
+  EXPECT_EQ("github.io", DomainValue("github.io"));
+  EXPECT_EQ("localhost", DomainValue("localhost"));
+  EXPECT_EQ("192.168.0.1", DomainValue("192.168.0.1"));
+  EXPECT_EQ("192.168.0.1", DomainValue("http://192.168.0.1:3000/x"));
+}
+
+TEST(SitePatternTest, DomainIsMatchesTheHostAndItsSubdomains) {
+  const std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kDomainIs, "github.com");
+  ASSERT_TRUE(pattern);
+  EXPECT_EQ(Type::kDomainIs, pattern->type());
+  EXPECT_TRUE(pattern->Matches(GURL("https://github.com/")));
+  EXPECT_TRUE(pattern->Matches(GURL("http://github.com/a?b#c")));
+  EXPECT_TRUE(pattern->Matches(GURL("https://www.github.com/")));
+  EXPECT_TRUE(pattern->Matches(GURL("https://a.b.github.com/")));
+  EXPECT_TRUE(pattern->Matches(GURL("https://github.com:8443/")));
+  // Case in the address doesn't matter: GURL lower-cases the host.
+  EXPECT_TRUE(pattern->Matches(GURL("https://GitHub.COM/")));
+  // A trailing dot on the host is the same host.
+  EXPECT_TRUE(pattern->Matches(GURL("https://github.com./")));
+
+  // The label boundary.
+  EXPECT_FALSE(pattern->Matches(GURL("https://notgithub.com/")));
+  EXPECT_FALSE(pattern->Matches(GURL("https://github.com.evil.test/")));
+  EXPECT_FALSE(pattern->Matches(GURL("https://evil.test/github.com")));
+  EXPECT_FALSE(pattern->Matches(GURL("https://evil.test/?u=github.com")));
+  EXPECT_FALSE(pattern->Matches(GURL("https://com/")));
+}
+
+TEST(SitePatternTest, DomainIsMatchesAnIpAddress) {
+  const std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kDomainIs, "192.168.0.1");
+  ASSERT_TRUE(pattern);
+  EXPECT_TRUE(pattern->Matches(GURL("http://192.168.0.1:8080/x")));
+  EXPECT_FALSE(pattern->Matches(GURL("http://192.168.0.10/")));
+}
+
+TEST(SitePatternTest, OnlyHttpAndHttpsEverMatch) {
+  const std::optional<SitePattern> domain =
+      SitePattern::Create(Type::kDomainIs, "github.com");
+  const std::optional<SitePattern> contains =
+      SitePattern::Create(Type::kUrlContains, "github");
+  ASSERT_TRUE(domain);
+  ASSERT_TRUE(contains);
+  for (const char* spec :
+       {"ftp://github.com/", "ws://github.com/", "chrome://github.com/",
+        "file:///github.com/x", "about:blank", "data:text/plain,github",
+        "mailto:a@github.com", "javascript:github", "blob:https://github.com/a",
+        "not a url", ""}) {
+    SCOPED_TRACE(spec);
+    EXPECT_FALSE(domain->Matches(GURL(spec)));
+    EXPECT_FALSE(contains->Matches(GURL(spec)));
+  }
+  EXPECT_TRUE(contains->Matches(GURL("https://github.com/")));
+}
+
+TEST(SitePatternTest, UrlContainsTrimsAndLowerCasesTheNeedle) {
+  const std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kUrlContains, "  GitHub.com/Pull  ");
+  ASSERT_TRUE(pattern);
+  EXPECT_EQ(Type::kUrlContains, pattern->type());
+  EXPECT_EQ("github.com/pull", pattern->value());
+  EXPECT_FALSE(SitePattern::Create(Type::kUrlContains, ""));
+  EXPECT_FALSE(SitePattern::Create(Type::kUrlContains, " \t\n"));
+}
+
+TEST(SitePatternTest, UrlContainsIsACaseInsensitiveSubstringTest) {
+  const std::optional<SitePattern> pattern =
+      SitePattern::Create(Type::kUrlContains, "/Pull/");
+  ASSERT_TRUE(pattern);
+  EXPECT_TRUE(pattern->Matches(GURL("https://github.com/o/r/pull/1")));
+  EXPECT_TRUE(pattern->Matches(GURL("https://github.com/o/r/PULL/1")));
+  EXPECT_FALSE(pattern->Matches(GURL("https://github.com/o/r/pulls")));
+
+  const std::optional<SitePattern> query =
+      SitePattern::Create(Type::kUrlContains, "?TAB=repos");
+  ASSERT_TRUE(query);
+  EXPECT_TRUE(query->Matches(GURL("https://github.com/o?tab=repos")));
+  EXPECT_TRUE(query->Matches(GURL("https://github.com/o?Tab=Repos")));
+}
+
+TEST(SitePatternTest, UrlContainsSeesTheCanonicalAddress) {
+  InitializeIcu();
+  // The scheme and host are always part of the canonical address.
+  const std::optional<SitePattern> scheme =
+      SitePattern::Create(Type::kUrlContains, "https://github");
+  ASSERT_TRUE(scheme);
+  EXPECT_TRUE(scheme->Matches(GURL("HTTPS://GITHUB.com/")));
+  EXPECT_FALSE(scheme->Matches(GURL("http://github.com/")));
+
+  // A space in the address is stored percent-encoded, so that is the form a
+  // needle has to use. A non-ASCII needle never matches as typed.
+  const std::optional<SitePattern> encoded =
+      SitePattern::Create(Type::kUrlContains, "a%20b");
+  ASSERT_TRUE(encoded);
+  EXPECT_TRUE(encoded->Matches(GURL("https://x.test/a b")));
+  const std::optional<SitePattern> typed =
+      SitePattern::Create(Type::kUrlContains, "a b");
+  ASSERT_TRUE(typed);
+  EXPECT_FALSE(typed->Matches(GURL("https://x.test/a b")));
+  const std::optional<SitePattern> non_ascii =
+      SitePattern::Create(Type::kUrlContains, "caf\xC3\xA9");
+  ASSERT_TRUE(non_ascii);
+  EXPECT_FALSE(non_ascii->Matches(GURL("https://x.test/caf\xC3\xA9")));
+}
+
+TEST(SitePatternTest, ForSiteOfGivesTheRegistrableDomain) {
+  auto site_of = [](const char* spec) -> std::optional<std::string> {
+    std::optional<SitePattern> pattern = SitePattern::ForSiteOf(GURL(spec));
+    if (!pattern) {
+      return std::nullopt;
+    }
+    EXPECT_EQ(Type::kDomainIs, pattern->type());
+    return pattern->value();
+  };
+  EXPECT_EQ("slack.com", site_of("https://app.slack.com/client/x"));
+  EXPECT_EQ("slack.com", site_of("http://slack.com/"));
+  EXPECT_EQ("b.co.uk", site_of("https://a.b.co.uk/x"));
+  EXPECT_EQ("github.com", site_of("https://github.com./"));
+  // A private suffix: each subdomain is its own site.
+  EXPECT_EQ("me.github.io", site_of("https://me.github.io/page"));
+  EXPECT_EQ("me.github.io", site_of("https://www.me.github.io/"));
+  // No registrable domain: the host itself.
+  EXPECT_EQ("192.168.0.1", site_of("https://192.168.0.1:8080/x"));
+  EXPECT_EQ("localhost", site_of("http://localhost:3000/"));
+  EXPECT_EQ("github.io", site_of("https://github.io/"));
+  // Not a site.
+  EXPECT_FALSE(site_of("file:///tmp/a.html"));
+  EXPECT_FALSE(site_of("chrome://settings/"));
+  EXPECT_FALSE(site_of("about:blank"));
+  EXPECT_FALSE(site_of("ftp://github.com/"));
+  EXPECT_FALSE(site_of("not a url"));
+  EXPECT_FALSE(site_of("https://co.uk/"));
+  EXPECT_FALSE(site_of("https://com/"));
+}
+
+// A bare private suffix has no registrable domain, so the host itself is
+// the site and the pattern matches every site under it.
+TEST(SitePatternTest, ForSiteOfAcceptsABarePrivateSuffix) {
+  const std::optional<SitePattern> pattern =
+      SitePattern::ForSiteOf(GURL("https://github.io/"));
+  ASSERT_TRUE(pattern);
+  EXPECT_EQ("github.io", pattern->value());
+  EXPECT_TRUE(pattern->Matches(GURL("https://me.github.io/")));
+}
+
+TEST(SitePatternTest, ForSiteOfMatchesThePageItCameFrom) {
+  const GURL page("https://app.slack.com/client/T1/C2");
+  const std::optional<SitePattern> pattern = SitePattern::ForSiteOf(page);
+  ASSERT_TRUE(pattern);
+  EXPECT_TRUE(pattern->Matches(page));
+  EXPECT_TRUE(pattern->Matches(GURL("https://slack.com/")));
+  EXPECT_TRUE(pattern->Matches(GURL("https://files.slack.com/")));
+  EXPECT_FALSE(pattern->Matches(GURL("https://notslack.com/")));
+}

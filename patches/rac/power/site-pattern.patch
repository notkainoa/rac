+TEST(SitePatternTest, ForSiteOfTreatsEachBlogspotBlogAsASite) {
+  auto site_of = [](const char* spec) -> std::optional<std::string> {
+    std::optional<SitePattern> pattern = SitePattern::ForSiteOf(GURL(spec));
+    if (!pattern) {
+      return std::nullopt;
+    }
+    return pattern->value();
+  };
+  // blogspot.com is a private suffix, so each blog is its own site.
+  EXPECT_EQ("me.blogspot.com", site_of("https://me.blogspot.com/x"));
+  EXPECT_EQ("me.blogspot.com", site_of("https://a.b.me.blogspot.com/"));
+  // Credentials in the address don't change which site a page belongs to.
+  EXPECT_EQ("slack.com", site_of("https://user:pass@app.slack.com/"));
+}
+
+TEST(SitePatternTest, ForSiteOfGivesTheHostForAnIpv6Address) {
+  const std::optional<SitePattern> pattern =
+      SitePattern::ForSiteOf(GURL("http://[::1]:8080/x"));
+  ASSERT_TRUE(pattern);
+  EXPECT_EQ("[::1]", pattern->value());
+  EXPECT_TRUE(pattern->Matches(GURL("http://[::1]/")));
+  EXPECT_FALSE(pattern->Matches(GURL("http://[::2]/")));
+}
+
+TEST(SitePatternTest, UrlContainsMatchesPunctuationNeedles) {
+  const std::optional<SitePattern> fragment =
+      SitePattern::Create(Type::kUrlContains, "#Frag");
+  ASSERT_TRUE(fragment);
+  EXPECT_EQ("#frag", fragment->value());
+  EXPECT_TRUE(fragment->Matches(GURL("https://x.test/p#FRAG")));
+  EXPECT_FALSE(fragment->Matches(GURL("https://x.test/p")));
+
+  const std::optional<SitePattern> percent =
+      SitePattern::Create(Type::kUrlContains, "%");
+  ASSERT_TRUE(percent);
+  EXPECT_TRUE(percent->Matches(GURL("https://x.test/a b")));
+  EXPECT_FALSE(percent->Matches(GURL("https://x.test/ab")));
+
+  // Escapes are uppercase in the canonical address, but both sides are
+  // lower-cased before the substring test.
+  const std::optional<SitePattern> escape =
+      SitePattern::Create(Type::kUrlContains, "a%2Fb");
+  ASSERT_TRUE(escape);
+  EXPECT_EQ("a%2fb", escape->value());
+  EXPECT_TRUE(escape->Matches(GURL("https://x.test/a%2Fb")));
+}

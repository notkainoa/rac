+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+# A rule for a set of sites ("domain is" or "URL contains"), shared by the
+# features that act per site. Depends only on base, net, and url.
+source_set("site_pattern") {
+  sources = [
+    "site_pattern.cc",
+    "site_pattern.h",
+  ]
+  public_deps = [
+    "//base",
+    "//url",
+  ]
+  deps = [ "//net" ]
+}
+
+# Linked into //chrome/browser/rac/power:rac_power_unittests, so one binary
+# runs both sets of tests.
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "site_pattern_unittest.cc" ]
+  deps = [
+    ":site_pattern",
+    "//base",
+    "//base:i18n",
+    "//testing/gtest",
+    "//url",
+  ]
+}

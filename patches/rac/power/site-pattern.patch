+TEST(SitePatternTest, FromValueIgnoresKeysItDoesNotRead) {
+  base::DictValue dict =
+      base::DictValue().Set("type", "domain").Set("value", "a.test");
+  dict.Set("note", "hand-edited");
+  dict.Set("version", 2);
+  const std::optional<SitePattern> pattern = SitePattern::FromValue(dict);
+  ASSERT_TRUE(pattern);
+  EXPECT_EQ(Type::kDomainIs, pattern->type());
+  EXPECT_EQ("a.test", pattern->value());
+}

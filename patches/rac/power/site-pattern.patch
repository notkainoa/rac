+TEST(SitePatternTest, ValueRoundTrips) {
+  for (const SitePattern& original :
+       {*SitePattern::Create(Type::kDomainIs, "Docs.Example.com"),
+        *SitePattern::Create(Type::kUrlContains, "/Pull/")}) {
+    const base::DictValue dict = original.ToValue();
+    ASSERT_TRUE(dict.FindString("type"));
+    ASSERT_TRUE(dict.FindString("value"));
+    EXPECT_EQ(original.value(), *dict.FindString("value"));
+    const std::optional<SitePattern> restored = SitePattern::FromValue(dict);
+    ASSERT_TRUE(restored);
+    EXPECT_EQ(original, *restored);
+  }
+  EXPECT_EQ("domain", *SitePattern::Create(Type::kDomainIs, "a.test")
+                           ->ToValue()
+                           .FindString("type"));
+  EXPECT_EQ("contains", *SitePattern::Create(Type::kUrlContains, "a")
+                             ->ToValue()
+                             .FindString("type"));
+}
+
+TEST(SitePatternTest, PatternsOfDifferentTypeOrValueDiffer) {
+  EXPECT_EQ(*SitePattern::Create(Type::kDomainIs, "a.test"),
+            *SitePattern::Create(Type::kDomainIs, "A.test."));
+  EXPECT_NE(*SitePattern::Create(Type::kDomainIs, "a.test"),
+            *SitePattern::Create(Type::kDomainIs, "b.test"));
+  EXPECT_NE(*SitePattern::Create(Type::kDomainIs, "a.test"),
+            *SitePattern::Create(Type::kUrlContains, "a.test"));
+}
+
+TEST(SitePatternTest, FromValueRefusesATamperedDictionary) {
+  auto make = [](std::string_view type, std::string_view value) {
+    return base::DictValue().Set("type", type).Set("value", value);
+  };
+  // The control: well-formed.
+  EXPECT_TRUE(SitePattern::FromValue(make("domain", "a.test")));
+  EXPECT_TRUE(SitePattern::FromValue(make("contains", "needle")));
+
+  EXPECT_FALSE(SitePattern::FromValue(base::DictValue()));
+  EXPECT_FALSE(SitePattern::FromValue(make("regex", "a.test")));
+  EXPECT_FALSE(SitePattern::FromValue(make("", "a.test")));
+  EXPECT_FALSE(SitePattern::FromValue(make("Domain", "a.test")));
+  // The checks in Create() run again on the stored text.
+  EXPECT_FALSE(SitePattern::FromValue(make("domain", "com")));
+  EXPECT_FALSE(SitePattern::FromValue(make("domain", "co.uk")));
+  EXPECT_FALSE(SitePattern::FromValue(make("domain", "")));
+  EXPECT_FALSE(SitePattern::FromValue(make("domain", "/path")));
+  EXPECT_FALSE(SitePattern::FromValue(make("domain", "chrome://settings")));
+  EXPECT_FALSE(SitePattern::FromValue(make("contains", "")));
+  EXPECT_FALSE(SitePattern::FromValue(make("contains", "   ")));
+  // Missing or mistyped fields.
+  EXPECT_FALSE(SitePattern::FromValue(base::DictValue().Set("type", "domain")));
+  EXPECT_FALSE(
+      SitePattern::FromValue(base::DictValue().Set("value", "a.test")));
+  EXPECT_FALSE(SitePattern::FromValue(
+      base::DictValue().Set("type", "domain").Set("value", 5)));
+  EXPECT_FALSE(SitePattern::FromValue(
+      base::DictValue().Set("type", 1).Set("value", "a.test")));
+
+  // Text that isn't canonical is cleaned up rather than kept as written.
+  const std::optional<SitePattern> cleaned =
+      SitePattern::FromValue(make("domain", "https://A.Test/x"));
+  ASSERT_TRUE(cleaned);
+  EXPECT_EQ("a.test", cleaned->value());
+  const std::optional<SitePattern> lowered =
+      SitePattern::FromValue(make("contains", "NeedLE"));
+  ASSERT_TRUE(lowered);
+  EXPECT_EQ("needle", lowered->value());
+}

+++ src/chrome/browser/rac/site_pattern/site_pattern.cc
@@ -0,0 +1,206 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/site_pattern/site_pattern.h"
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+
+namespace rac {
+
+namespace {
+
+constexpr std::string_view kTypeKey = "type";
+constexpr std::string_view kValueKey = "value";
+constexpr std::string_view kDomainTypeName = "domain";
+constexpr std::string_view kContainsTypeName = "contains";
+
+std::string_view TrimDots(std::string_view host) {
+  while (!host.empty() && host.front() == '.') {
+    host.remove_prefix(1);
+  }
+  while (!host.empty() && host.back() == '.') {
+    host.remove_suffix(1);
+  }
+  return host;
+}
+
+// True when `typed` opens with a URL scheme that isn't followed by `//`,
+// such as `https:/a.test` or `mailto:a@b.test`, which would otherwise store
+// `https` or `mailto` as the host. A colon after what looks like a scheme
+// is a port instead when only digits follow, so `a.test:8080` stays a
+// host:port.
+bool StartsWithBrokenScheme(std::string_view typed) {
+  const size_t colon = typed.find(':');
+  if (colon == std::string_view::npos || colon == 0 ||
+      !base::IsAsciiAlpha(typed.front())) {
+    return false;
+  }
+  if (!std::ranges::all_of(typed.substr(0, colon), [](char c) {
+        return base::IsAsciiAlphaNumeric(c) || c == '+' || c == '.' || c == '-';
+      })) {
+    return false;
+  }
+  const std::string_view after = typed.substr(colon + 1);
+  if (after.starts_with("//")) {
+    return false;
+  }
+  const size_t port_end = after.find_first_not_of("0123456789");
+  const bool port_follows =
+      !after.empty() && port_end != 0 &&
+      (port_end == std::string_view::npos || after[port_end] == '/' ||
+       after[port_end] == '?' || after[port_end] == '#');
+  return !port_follows;
+}
+
+// The host a "domain is" pattern stores for `typed`, or nullopt.
+std::optional<std::string> DomainFromTyped(std::string_view typed) {
+  std::string_view trimmed = base::TrimWhitespaceASCII(typed, base::TRIM_ALL);
+  if (trimmed.empty() || trimmed.front() == '/' ||
+      StartsWithBrokenScheme(trimmed)) {
+    return std::nullopt;
+  }
+  // A scheme comes before any path, so `a.test/?r=https://b.test` has none.
+  const size_t scheme_end = trimmed.find("://");
+  const bool has_scheme = scheme_end != std::string_view::npos &&
+                          trimmed.substr(0, scheme_end).find_first_of("/?#") ==
+                              std::string_view::npos;
+  // Arc and Zen users type `*.slack.com` for "slack.com and its
+  // subdomains", which is what "domain is" means anyway. One `*.` comes off
+  // the host with or without a scheme; a second stays in the address and is
+  // refused below.
+  std::string without_wildcard;
+  if (has_scheme) {
+    const std::string_view after_scheme = trimmed.substr(scheme_end + 3);
+    if (after_scheme.starts_with("*.")) {
+      without_wildcard = base::StrCat(
+          {trimmed.substr(0, scheme_end + 3), after_scheme.substr(2)});
+      trimmed = without_wildcard;
+    }
+  } else {
+    if (trimmed.starts_with("*.")) {
+      trimmed.remove_prefix(2);
+    }
+    // A host with no scheme in front takes its leading dots off here, so
+    // the result doesn't depend on how GURL treats them.
+    while (!trimmed.empty() && trimmed.front() == '.') {
+      trimmed.remove_prefix(1);
+    }
+  }
+  const GURL url(has_scheme ? std::string(trimmed)
+                            : base::StrCat({"https://", trimmed}));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() ||
+      url.has_password()) {
+    return std::nullopt;
+  }
+  const std::string_view host = TrimDots(url.host());
+  // A `%` is an escaped character such as a second `*`, which no real host
+  // has, so the pattern could never match.
+  if (host.empty() || host.find('%') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  // `https//shop.example`, with its colon missing, parses as the host
+  // `https`. No one means to route a site by that name.
+  if (host == "http" || host == "https") {
+    return std::nullopt;
+  }
+  // Only a host that survives canonicalization unchanged goes any further.
+  // This also keeps HostIsRegistryIdentifier(), which requires a canonical
+  // host, away from input it would crash on.
+  const GURL host_url(base::StrCat({"https://", host, "/"}));
+  if (!host_url.is_valid() || host_url.host() != host) {
+    return std::nullopt;
+  }
+  if (!host_url.HostIsIPAddress() &&
+      net::registry_controlled_domains::HostIsRegistryIdentifier(
+          host, net::registry_controlled_domains::EXCLUDE_PRIVATE_REGISTRIES)) {
+    return std::nullopt;
+  }
+  return std::string(host);
+}
+
+}  // namespace
+
+SitePattern::SitePattern(Type type, std::string value)
+    : type_(type), value_(std::move(value)) {}
+
+// static
+std::optional<SitePattern> SitePattern::Create(Type type,
+                                               std::string_view typed) {
+  switch (type) {
+    case Type::kDomainIs: {
+      std::optional<std::string> host = DomainFromTyped(typed);
+      if (!host) {
+        return std::nullopt;
+      }
+      return SitePattern(type, std::move(*host));
+    }
+    case Type::kUrlContains: {
+      const std::string_view trimmed =
+          base::TrimWhitespaceASCII(typed, base::TRIM_ALL);
+      if (trimmed.empty()) {
+        return std::nullopt;
+      }
+      return SitePattern(type, base::ToLowerASCII(trimmed));
+    }
+  }
+  return std::nullopt;
+}
+
+// static
+std::optional<SitePattern> SitePattern::ForSiteOf(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  // An IP address, a single label, and a bare suffix have no registrable
+  // domain, so those use their host (and Create() then refuses a suffix).
+  return Create(Type::kDomainIs, domain.empty() ? url.host() : domain);
+}
+
+// static
+std::optional<SitePattern> SitePattern::FromValue(const base::DictValue& dict) {
+  const std::string* type = dict.FindString(kTypeKey);
+  const std::string* value = dict.FindString(kValueKey);
+  if (!type || !value) {
+    return std::nullopt;
+  }
+  if (*type == kDomainTypeName) {
+    return Create(Type::kDomainIs, *value);
+  }
+  if (*type == kContainsTypeName) {
+    return Create(Type::kUrlContains, *value);
+  }
+  return std::nullopt;
+}
+
+base::DictValue SitePattern::ToValue() const {
+  return base::DictValue()
+      .Set(kTypeKey,
+           type_ == Type::kDomainIs ? kDomainTypeName : kContainsTypeName)
+      .Set(kValueKey, value_);
+}
+
+bool SitePattern::Matches(const GURL& url) const {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  switch (type_) {
+    case Type::kDomainIs:
+      return url.DomainIs(value_);
+    case Type::kUrlContains:
+      return base::ToLowerASCII(url.spec()).find(value_) != std::string::npos;
+  }
+  return false;
+}
+
+}  // namespace rac

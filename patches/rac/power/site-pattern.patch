+TEST(SitePatternTest, FromValueRefusesASmuggledLoginOrPort) {
+  // The checks in Create() run again, so stored text can't sneak either in.
+  auto make = [](std::string_view type, std::string_view value) {
+    return base::DictValue().Set("type", type).Set("value", value);
+  };
+  EXPECT_FALSE(SitePattern::FromValue(make("domain", "u:p@a.test")));
+  EXPECT_FALSE(SitePattern::FromValue(make("domain", "a.test:bad")));
+  const std::optional<SitePattern> cleaned =
+      SitePattern::FromValue(make("domain", "A.TEST:8080/x"));
+  ASSERT_TRUE(cleaned);
+  EXPECT_EQ("a.test", cleaned->value());
+}

+std::u16string BangTriggerFromKeyword(std::u16string_view keyword) {
+  if (keyword.size() < 2 || keyword[0] != u'!') {
+    return std::u16string();
+  }
+  return std::u16string(keyword.substr(1));
+}
+
+std::u16string NormalizeBangTrigger(std::u16string_view input) {
+  std::u16string_view trigger = base::TrimWhitespace(input, base::TRIM_ALL);
+  const size_t first = trigger.find_first_not_of(u'!');
+  if (first == std::u16string_view::npos) {
+    return std::u16string();
+  }
+  trigger.remove_prefix(first);
+  if (trigger.find_first_of(base::kWhitespaceUTF16) !=
+      std::u16string_view::npos) {
+    return std::u16string();
+  }
+  return std::u16string(trigger);
+}
+
+int RankBangMatch(std::u16string_view query,
+                  std::u16string_view trigger,
+                  std::u16string_view name) {
+  if (query.empty() || trigger == query) {
+    return 0;
+  }
+  if (trigger.starts_with(query)) {
+    return 1;
+  }
+  if (name.starts_with(query)) {
+    return 2;
+  }
+  if (trigger.find(query) != std::u16string_view::npos ||
+      name.find(query) != std::u16string_view::npos) {
+    return 3;
+  }
+  return -1;
+}

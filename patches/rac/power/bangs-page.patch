+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/search_engines/rac_bangs_edit.h"
+
+#include <cstdlib>
+#include <memory>
+#include <set>
+#include <string>
+
+#include "base/functional/callback_helpers.h"
+#include "base/memory/raw_ptr.h"
+#include "components/search_engines/keyword_web_data_service.h"
+#include "components/search_engines/rac_deleted_bangs.h"
+#include "components/search_engines/search_terms_data.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_bang_manager.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/template_url_service_client.h"
+#include "components/search_engines/template_url_service_test_util.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "services/network/test/test_url_loader_factory.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/resource/resource_bundle.h"
+
+namespace rac {
+namespace {
+
+// The bangs.json the tests' BangManager "downloads". BangManager is a
+// process-wide singleton that loads the list once, so every test uses the
+// same list.
+constexpr char kBangsList[] = R"([
+  {"s": "Wikipedia", "ts": ["w"],
+   "u": "https://en.wikipedia.org/w/index.php?search={searchTerms}"},
+  {"s": "YouTube", "ts": ["yt"],
+   "u": "https://www.youtube.com/results?search_query={searchTerms}"},
+  {"s": "GitHub", "ts": ["gh"],
+   "u": "https://github.com/search?q={searchTerms}"},
+  {"s": "Upper Case", "ts": ["UP"],
+   "u": "https://upper.example/?q={searchTerms}"}
+])";
+
+class RacBangsEditTest : public TemplateURLServiceUnitTestBase {
+ protected:
+  void SetUp() override {
+    TemplateURLServiceUnitTestBase::SetUp();
+    SetBangsListOverride(kBangsList);
+    LoadWithBangs();
+  }
+
+  // What a browser start does: load the engines, then apply the downloaded
+  // list. This service has no database, so Load() doesn't apply the list
+  // itself.
+  void LoadWithBangs() {
+    template_url_service().Load();
+    template_url_service().LoadBangs();
+    task_environment.RunUntilIdle();
+  }
+
+  TemplateURL* Find(const std::u16string& keyword) {
+    return template_url_service().GetTemplateURLForKeyword(keyword);
+  }
+
+  bool IsDownloaded(const std::u16string& keyword) {
+    TemplateURL* turl = Find(keyword);
+    return turl && turl->bang_id() > 0;
+  }
+
+  bool IsDeleted(std::string_view trigger) {
+    return IsDeletedBang(trigger, ReadDeletedBangs(&pref_service()));
+  }
+
+  TemplateURL* AddUserBang(const std::u16string& keyword) {
+    TemplateURLData data;
+    data.SetShortName(u"Mine");
+    data.SetKeyword(keyword);
+    data.SetURL("https://example.com/?q={searchTerms}");
+    data.is_active = TemplateURLData::ActiveStatus::kTrue;
+    return template_url_service().Add(std::make_unique<TemplateURL>(data));
+  }
+};
+
+TEST_F(RacBangsEditTest, ListLoadAddsDownloadedBangs) {
+  EXPECT_TRUE(IsDownloaded(u"!w"));
+  EXPECT_TRUE(IsDownloaded(u"!yt"));
+  EXPECT_TRUE(IsDownloaded(u"!gh"));
+}
+
+TEST_F(RacBangsEditTest, DeleteHidesTheBangAcrossFreshListLoads) {
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), Find(u"!w")));
+  EXPECT_FALSE(Find(u"!w"));
+  EXPECT_TRUE(IsDeleted("w"));
+
+  // The list applied again in this session.
+  template_url_service().LoadBangs();
+  EXPECT_FALSE(Find(u"!w"));
+
+  // A new session: a new service, and the list applied from scratch.
+  ResetTemplateURLService();
+  LoadWithBangs();
+  EXPECT_FALSE(Find(u"!w"));
+  EXPECT_TRUE(IsDownloaded(u"!yt"));
+  EXPECT_TRUE(IsDeleted("w"));
+}
+
+TEST_F(RacBangsEditTest, RestoreBringsTheBangBack) {
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), Find(u"!w")));
+  ASSERT_FALSE(Find(u"!w"));
+
+  RestoreBang(template_url_service(), pref_service(), "w");
+  EXPECT_TRUE(IsDownloaded(u"!w"));
+  EXPECT_FALSE(IsDeleted("w"));
+
+  // And it stays back in a new session.
+  ResetTemplateURLService();
+  LoadWithBangs();
+  EXPECT_TRUE(IsDownloaded(u"!w"));
+}
+
+TEST_F(RacBangsEditTest, EditingADownloadedBangSavesTheUsersCopy) {
+  ASSERT_TRUE(SaveBang(template_url_service(), pref_service(), Find(u"!w"),
+                       u"My wiki", u"w", "https://wiki.example/?q=%s"));
+
+  TemplateURL* mine = Find(u"!w");
+  ASSERT_TRUE(mine);
+  EXPECT_EQ(0, mine->bang_id());
+  EXPECT_TRUE(IsUserBang(*mine, template_url_service()));
+  EXPECT_EQ(u"My wiki", mine->short_name());
+  EXPECT_EQ("https://wiki.example/?q={searchTerms}", mine->url());
+  EXPECT_TRUE(IsDeleted("w"));
+
+  // A fresh list load leaves the user's copy alone.
+  template_url_service().LoadBangs();
+  EXPECT_EQ(mine, Find(u"!w"));
+  EXPECT_EQ(0, Find(u"!w")->bang_id());
+}
+
+TEST_F(RacBangsEditTest,
+       EditingADownloadedBangToANewTriggerKeepsTheOldOneDeleted) {
+  ASSERT_TRUE(SaveBang(template_url_service(), pref_service(), Find(u"!yt"),
+                       u"Videos", u"!vid", "https://videos.example/?q=%s"));
+  EXPECT_TRUE(Find(u"!vid"));
+  EXPECT_FALSE(Find(u"!yt"));
+  EXPECT_TRUE(IsDeleted("yt"));
+}
+
+TEST_F(RacBangsEditTest, SavingADownloadedBangUnchangedKeepsIt) {
+  TemplateURL* wiki = Find(u"!w");
+  ASSERT_TRUE(SaveBang(template_url_service(), pref_service(), wiki,
+                       wiki->short_name(), u"w",
+                       "https://en.wikipedia.org/w/index.php?search=%s"));
+  EXPECT_TRUE(IsDownloaded(u"!w"));
+  EXPECT_FALSE(IsDeleted("w"));
+}
+
+TEST_F(RacBangsEditTest, AddingRefusesATakenTrigger) {
+  EXPECT_EQ(BangFieldError::kTaken,
+            ValidateBangField(template_url_service(), nullptr,
+                              BangField::kTrigger, u"gh"));
+  EXPECT_FALSE(SaveBang(template_url_service(), pref_service(), nullptr,
+                        u"Mine", u"gh", "https://example.com/?q=%s"));
+  EXPECT_TRUE(IsDownloaded(u"!gh"));
+  // The bang being edited may keep its own trigger.
+  EXPECT_EQ(BangFieldError::kNone,
+            ValidateBangField(template_url_service(), Find(u"!gh"),
+                              BangField::kTrigger, u"gh"));
+}
+
+TEST_F(RacBangsEditTest, AddingNeedsAQueryInTheUrl) {
+  EXPECT_EQ(BangFieldError::kInvalid,
+            ValidateBangField(template_url_service(), nullptr, BangField::kUrl,
+                              u"https://example.com/"));
+  EXPECT_FALSE(SaveBang(template_url_service(), pref_service(), nullptr,
+                        u"Mine", u"mine", "https://example.com/"));
+  EXPECT_TRUE(SaveBang(template_url_service(), pref_service(), nullptr, u"Mine",
+                       u"mine", "https://example.com/?q=%s"));
+  EXPECT_TRUE(IsUserBang(*Find(u"!mine"), template_url_service()));
+}
+
+TEST_F(RacBangsEditTest, DeletingTheUsersBangBringsBackTheOneItHid) {
+  // The user's own !gh, added while the downloaded one was deleted, so the
+  // list doesn't add the downloaded one back.
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), Find(u"!gh")));
+  TemplateURL* mine = AddUserBang(u"!gh");
+  RestoreBang(template_url_service(), pref_service(), "gh");
+  EXPECT_EQ(mine, Find(u"!gh"));
+
+  // The user's bang isn't recorded as deleted, and the downloaded one comes
+  // back right away.
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), mine));
+  EXPECT_FALSE(IsDeleted("gh"));
+  EXPECT_TRUE(IsDownloaded(u"!gh"));
+}
+
+TEST_F(RacBangsEditTest, TheDefaultSearchEngineIsNeverReplacedOrDeleted) {
+  TemplateURL* mine = AddUserBang(u"!mine");
+  ASSERT_TRUE(template_url_service().CanMakeDefault(mine));
+  template_url_service().SetUserSelectedDefaultSearchProvider(mine);
+  ASSERT_EQ(mine, template_url_service().GetDefaultSearchProvider());
+
+  EXPECT_FALSE(IsUserBang(*mine, template_url_service()));
+  EXPECT_FALSE(SaveBang(template_url_service(), pref_service(), mine,
+                        u"Renamed", u"mine", "https://example.com/?q=%s"));
+  EXPECT_EQ(u"Mine", mine->short_name());
+  EXPECT_FALSE(DeleteBang(template_url_service(), pref_service(), mine));
+  EXPECT_EQ(mine, Find(u"!mine"));
+}
+
+TEST_F(RacBangsEditTest, RenamingTheUsersBangBringsBackTheOneItHid) {
+  // The user's own !gh, made while the downloaded one was deleted.
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), Find(u"!gh")));
+  TemplateURL* mine = AddUserBang(u"!gh");
+  RestoreBang(template_url_service(), pref_service(), "gh");
+  ASSERT_EQ(mine, Find(u"!gh"));
+
+  ASSERT_TRUE(SaveBang(template_url_service(), pref_service(), mine, u"Mine",
+                       u"mygh", "https://example.com/?q=%s"));
+  EXPECT_EQ(mine, Find(u"!mygh"));
+  EXPECT_TRUE(IsDownloaded(u"!gh"));
+}
+
+TEST_F(RacBangsEditTest, RestoringAReplacedTriggerKeepsTheUsersBang) {
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), Find(u"!gh")));
+  TemplateURL* mine = AddUserBang(u"!gh");
+
+  RestoreBang(template_url_service(), pref_service(), "gh");
+  EXPECT_FALSE(IsDeleted("gh"));
+  EXPECT_EQ(mine, Find(u"!gh"));
+  EXPECT_EQ(0, Find(u"!gh")->bang_id());
+}
+
+TEST_F(RacBangsEditTest, UppercaseTriggersInTheList) {
+  // Keywords are always lower case, so the list's UP is !up.
+  ASSERT_TRUE(IsDownloaded(u"!up"));
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), Find(u"!up")));
+  EXPECT_TRUE(IsDeleted("up"));
+  EXPECT_TRUE(IsDeleted("UP"));
+
+  ResetTemplateURLService();
+  LoadWithBangs();
+  EXPECT_FALSE(Find(u"!up"));
+
+  RestoreBang(template_url_service(), pref_service(), "UP");
+  EXPECT_TRUE(IsDownloaded(u"!up"));
+}
+
+TEST_F(RacBangsEditTest, OnlyBangsAreChangedHere) {
+  // A site search entry without a "!".
+  TemplateURLData data;
+  data.SetShortName(u"Example");
+  data.SetKeyword(u"example");
+  data.SetURL("https://example.com/?q={searchTerms}");
+  TemplateURL* engine =
+      template_url_service().Add(std::make_unique<TemplateURL>(data));
+  ASSERT_TRUE(engine);
+  const std::u16string name = engine->short_name();
+  EXPECT_FALSE(IsBang(*engine, template_url_service()));
+  EXPECT_FALSE(FindBang(template_url_service(), engine->sync_guid()));
+  EXPECT_FALSE(SaveBang(template_url_service(), pref_service(), engine,
+                        u"Renamed", u"renamed", "https://example.com/?q=%s"));
+  EXPECT_EQ(name, engine->short_name());
+  EXPECT_FALSE(DeleteBang(template_url_service(), pref_service(), engine));
+  EXPECT_TRUE(
+      template_url_service().GetTemplateURLForGUID(engine->sync_guid()));
+}

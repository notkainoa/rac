+    const row = (e.currentTarget as HTMLElement).closest('.bang-row');
+    const list = row?.parentElement;
+    if (!row || !list) {
+      return null;
+    }
+    return {
+      list: list.id as BangList,
+      index: Array.from(list.querySelectorAll('.bang-row')).indexOf(row),
+    };
+  }
+
+  /**
+   * Focuses the row at |index| in |list| (or the last one, if the list got
+   * shorter), else the list's heading, else the Bangs list heading when the
+   * whole section is gone.

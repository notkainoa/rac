+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/search_engines/rac_bangs_edit.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/i18n/case_conversion.h"
+#include "base/location.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/search_engines/rac_deleted_bangs.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_bang_manager.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/template_url_starter_pack_data.h"
+#include "components/search_engines/util.h"
+
+namespace rac {
+namespace {
+
+struct ListOverride {
+  std::optional<std::string> bangs_json;
+  bool held = false;
+  base::OnceClosure pending_load;
+};
+
+ListOverride& GetListOverride() {
+  static base::NoDestructor<ListOverride> list_override;
+  return *list_override;
+}
+
+std::u16string KeywordFor(std::u16string_view trigger) {
+  return u"!" + base::i18n::ToLower(NormalizeBangTrigger(trigger));
+}
+
+void RecordDeleted(PrefService& prefs, const TemplateURL& turl) {
+  AddDeletedBang(&prefs,
+                 base::UTF16ToUTF8(BangTriggerFromKeyword(turl.keyword())));
+}
+
+}  // namespace
+
+void SetBangsListOverride(std::string bangs_json, bool hold) {
+  ListOverride& list_override = GetListOverride();
+  list_override.bangs_json = std::move(bangs_json);
+  list_override.held = hold;
+}
+
+void ReleaseBangsListOverride() {
+  ListOverride& list_override = GetListOverride();
+  list_override.held = false;
+  if (list_override.pending_load) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(list_override.pending_load));
+  }
+}
+
+bool PostBangsListOverride(base::OnceCallback<void(std::string)> load) {
+  ListOverride& list_override = GetListOverride();
+  if (!list_override.bangs_json) {
+    return false;
+  }
+  base::OnceClosure task =
+      base::BindOnce(std::move(load), *list_override.bangs_json);
+  if (list_override.held) {
+    list_override.pending_load = std::move(task);
+  } else {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                             std::move(task));
+  }
+  return true;
+}
+
+bool IsUserBang(const TemplateURL& turl, const TemplateURLService& service) {
+  return turl.type() == TemplateURL::NORMAL && turl.bang_id() == 0 &&
+         turl.prepopulate_id() == 0 &&
+         turl.starter_pack_id() ==
+             template_url_starter_pack_data::StarterPackId::kNone &&
+         turl.policy_origin() == TemplateURLData::PolicyOrigin::kNoPolicy &&
+         &turl != service.GetDefaultSearchProvider() &&
+         !BangTriggerFromKeyword(turl.keyword()).empty();
+}
+
+bool IsBang(const TemplateURL& turl, const TemplateURLService& service) {
+  return turl.bang_id() > 0 || IsUserBang(turl, service);
+}
+
+TemplateURL* FindBang(TemplateURLService& service, const std::string& guid) {
+  TemplateURL* turl =
+      guid.empty() ? nullptr : service.GetTemplateURLForGUID(guid);
+  return turl && IsBang(*turl, service) ? turl : nullptr;
+}
+
+BangFieldError ValidateBangField(const TemplateURLService& service,
+                                 const TemplateURL* existing,
+                                 BangField field,
+                                 std::u16string_view value) {
+  switch (field) {
+    case BangField::kName:
+      return IsSearchEngineNameValidToUse(std::u16string(value))
+                 ? BangFieldError::kNone
+                 : BangFieldError::kInvalid;
+    case BangField::kTrigger:
+      if (NormalizeBangTrigger(value).empty()) {
+        return BangFieldError::kInvalid;
+      }
+      return IsSearchEngineKeywordValidToUse(KeywordFor(value), &service,
+                                             existing)
+                 ? BangFieldError::kNone
+                 : BangFieldError::kTaken;
+    case BangField::kUrl:
+      return IsSearchEngineURLValidToUse(base::UTF16ToUTF8(value), &service,
+                                         existing,
+                                         /*is_new_primary=*/true)
+                 ? BangFieldError::kNone
+                 : BangFieldError::kInvalid;
+  }
+}
+
+bool SaveBang(TemplateURLService& service,
+              PrefService& prefs,
+              TemplateURL* existing,
+              std::u16string_view name,
+              std::u16string_view trigger,
+              const std::string& url) {
+  if (existing && (!IsBang(*existing, service) ||
+                   existing == service.GetDefaultSearchProvider())) {
+    // Only bangs are edited here, and replacing the default search engine
+    // would remove it.
+    return false;
+  }
+  const std::u16string url16 = base::UTF8ToUTF16(url);
+  if (ValidateBangField(service, existing, BangField::kName, name) !=
+          BangFieldError::kNone ||
+      ValidateBangField(service, existing, BangField::kTrigger, trigger) !=
+          BangFieldError::kNone ||
+      ValidateBangField(service, existing, BangField::kUrl, url16) !=
+          BangFieldError::kNone) {
+    return false;
+  }
+
+  const std::u16string title(base::TrimWhitespace(name, base::TRIM_ALL));
+  const std::u16string keyword = KeywordFor(trigger);
+  const std::string fixed_url =
+      GetFixedUpSearchEngineUrl(url, service.search_terms_data());
+  if (existing && existing->bang_id() == 0) {
+    const bool keyword_changed = existing->keyword() != keyword;
+    service.ResetTemplateURL(existing, title, keyword, fixed_url,
+                             existing->suggestions_url());
+    if (keyword_changed) {
+      // A downloaded bang the old keyword hid can come back.
+      ReapplyBangsList(service);
+    }
+    return true;
+  }
+  if (existing) {
+    if (existing->short_name() == title && existing->keyword() == keyword &&
+        existing->url() == fixed_url) {
+      return true;
+    }
+    RecordDeleted(prefs, *existing);
+    service.Remove(existing);
+  }
+  TemplateURLData data;
+  data.SetShortName(title);
+  data.SetKeyword(keyword);
+  data.SetURL(fixed_url);
+  data.is_active = TemplateURLData::ActiveStatus::kTrue;
+  service.Add(std::make_unique<TemplateURL>(data));
+  return true;
+}
+
+bool DeleteBang(TemplateURLService& service,
+                PrefService& prefs,
+                const TemplateURL* turl) {
+  if (!turl || !IsBang(*turl, service) ||
+      turl == service.GetDefaultSearchProvider()) {
+    return false;
+  }
+  const bool downloaded = turl->bang_id() > 0;
+  if (downloaded) {
+    RecordDeleted(prefs, *turl);
+  }
+  service.Remove(turl);
+  if (!downloaded) {
+    ReapplyBangsList(service);
+  }
+  return true;
+}
+
+void RestoreBang(TemplateURLService& service,
+                 PrefService& prefs,
+                 std::string_view trigger) {
+  RemoveDeletedBang(&prefs, trigger);
+  ReapplyBangsList(service);
+}
+
+void ReapplyBangsList(TemplateURLService& service) {
+  // LoadBangs() would download the list if it isn't in memory yet. When it
+  // is, it re-runs TemplateURLService::BangsLoadedCallback right away.
+  if (!Bangs::BangManager::GetInstance()->GetBangs().empty()) {
+    service.LoadBangs();
+  }
+}
+
+}  // namespace rac

+namespace settings {
+namespace {
+
+// The downloaded list has thousands of bangs. The page shows this many of
+// the ones that match its search field.
+constexpr size_t kMaxListRows = 100;
+
+// The user's own bangs are site search entries the user added with a "!"
+// keyword. Prepopulated, starter pack, policy, and extension engines are not
+// theirs to edit here, and the default search engine can't be deleted.
+bool IsUserBang(const TemplateURL* turl, const TemplateURLService* service) {
+  return turl->type() == TemplateURL::NORMAL && turl->bang_id() == 0 &&
+         turl->prepopulate_id() == 0 &&
+         turl->starter_pack_id() ==
+             template_url_starter_pack_data::StarterPackId::kNone &&
+         turl->policy_origin() == TemplateURLData::PolicyOrigin::kNoPolicy &&
+         turl != service->GetDefaultSearchProvider() &&
+         !rac::BangTriggerFromKeyword(turl->keyword()).empty();
+}
+
+// What the page's search field holds, ready for rac::RankBangMatch.
+std::u16string NormalizeQuery(const std::u16string& query) {
+  std::u16string_view trimmed = base::TrimWhitespace(query, base::TRIM_ALL);
+  while (trimmed.starts_with(u'!')) {
+    trimmed.remove_prefix(1);
+  }
+  return base::i18n::ToLower(trimmed);
+}
+
+int Rank(const std::u16string& query, const TemplateURL* turl) {
+  return rac::RankBangMatch(
+      query, base::i18n::ToLower(rac::BangTriggerFromKeyword(turl->keyword())),
+      base::i18n::ToLower(turl->short_name()));
+}
+
+base::DictValue BangValue(const TemplateURL* turl,
+                          const SearchTermsData& search_terms_data) {
+  base::DictValue bang;
+  bang.Set("id", static_cast<int>(turl->id()));
+  bang.Set("name", turl->short_name());
+  bang.Set("trigger", rac::BangTriggerFromKeyword(turl->keyword()));
+  bang.Set("url", turl->url_ref().DisplayURL(search_terms_data));
+  // For the row's icon, from the favicons already on this Mac. The page
+  // never fetches one.
+  bang.Set("siteUrl", GURL(turl->url()).GetWithEmptyPath().spec());
+  return bang;
+}
+
+using RankedBang = std::tuple<int, std::u16string, TemplateURL*>;
+
+// Puts the best |count| matches first, best first, then by trigger.
+void SortRanked(std::vector<RankedBang>& bangs, size_t count) {
+  auto by_rank = [](const RankedBang& a, const RankedBang& b) {
+    return std::tie(std::get<0>(a), std::get<1>(a)) <
+           std::tie(std::get<0>(b), std::get<1>(b));
+  };
+  std::ranges::partial_sort(
+      bangs, bangs.begin() + std::min(count, bangs.size()), by_rank);
+}
+
+std::string StringArg(const base::ListValue& args, size_t index) {
+  const std::string* value =
+      index < args.size() ? args[index].GetIfString() : nullptr;
+  return value ? *value : std::string();
+}
+
+int IdArg(const base::ListValue& args, size_t index) {
+  return index < args.size() ? args[index].GetIfInt().value_or(-1) : -1;
+}

+  struct IndexEntry {
+    std::u16string trigger;  // Lower case, no "!".
+    std::u16string name;     // Lower case.
+    std::string guid;
+    bool downloaded;
+  };
+
+  void BuildIndex();
+  base::DictValue CreateState(const std::u16string& query);
+  // Tells the page to ask again, once per batch of changes.
+  void ScheduleChanged();

+
+void RacBangsHandler::OnJavascriptAllowed() {
+  if (service_) {
+    // Settings can open before anything else asked for the engines.
+    service_->Load();
+    observation_.Observe(service_);
+  }
+  // Another Settings tab can delete or restore a bang.
+  pref_registrar_.Add(rac::kDeletedBangsPref,
+                      base::BindRepeating(&RacBangsHandler::ScheduleChanged,
+                                          base::Unretained(this)));
+}
+
+void RacBangsHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+  pref_registrar_.RemoveAll();
+  weak_factory_.InvalidateWeakPtrs();
+  changed_pending_ = false;
+  index_.reset();
+}
+
+void RacBangsHandler::OnTemplateURLServiceChanged() {
+  ScheduleChanged();
+}
+
+void RacBangsHandler::ScheduleChanged() {
+  // Rebuilt on the page's next request. TemplateURLService doesn't tell
+  // observers about downloaded bangs it adds, so the callers that re-apply
+  // the list call this too.
+  index_.reset();
+  if (changed_pending_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  changed_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RacBangsHandler::FireChanged,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void RacBangsHandler::FireChanged() {
+  changed_pending_ = false;
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("rac-bangs-changed");
+  }
+}
+
+bool RacBangsHandler::CanChange() const {
+  return service_ && service_->loaded();
+}
+
+void RacBangsHandler::BuildIndex() {
+  index_.emplace();
+  if (!service_) {
+    return;
+  }
+  for (TemplateURL* turl : service_->GetTemplateURLs()) {
+    const bool downloaded = turl->bang_id() > 0;
+    if (!downloaded && !rac::IsUserBang(*turl, *service_)) {
+      continue;
+    }
+    index_->push_back(
+        {base::i18n::ToLower(rac::BangTriggerFromKeyword(turl->keyword())),
+         base::i18n::ToLower(turl->short_name()), turl->sync_guid(),
+         downloaded});
+  }
+}
+
+base::DictValue RacBangsHandler::CreateState(const std::u16string& query) {
+  base::DictValue state;
+  base::ListValue yours_list;
+  base::ListValue bangs_list;
+  base::ListValue deleted_list;
+  size_t bangs_total = 0;
+  size_t bangs_matching = 0;
+
+  if (service_) {
+    if (!index_) {
+      BuildIndex();
+    }
+    const std::u16string normalized = NormalizeQuery(query);
+    using Ranked = std::pair<int, const IndexEntry*>;
+    std::vector<Ranked> yours;
+    std::vector<Ranked> bangs;
+    for (const IndexEntry& entry : *index_) {
+      bangs_total += entry.downloaded ? 1 : 0;
+      const int rank =
+          rac::RankBangMatch(normalized, entry.trigger, entry.name);
+      if (rank >= 0) {
+        (entry.downloaded ? bangs : yours).emplace_back(rank, &entry);
+      }
+    }
+    bangs_matching = bangs.size();
+    // With a query, the best match first, then by trigger, so typing "w"
+    // puts !w on top. Without one, by name: bangs.json is in no useful
+    // order.
+    const bool by_name = normalized.empty();
+    auto order = [by_name](const Ranked& a, const Ranked& b) {
+      const IndexEntry& x = *a.second;
+      const IndexEntry& y = *b.second;
+      return by_name ? std::tie(x.name, x.trigger) < std::tie(y.name, y.trigger)
+                     : std::tie(a.first, x.trigger, x.name) <
+                           std::tie(b.first, y.trigger, y.name);
+    };
+    std::ranges::sort(yours, order);
+    std::ranges::partial_sort(
+        bangs, bangs.begin() + std::min(kMaxListRows, bangs.size()), order);
+
+    const SearchTermsData& terms = service_->search_terms_data();
+    for (const Ranked& ranked : yours) {
+      if (const TemplateURL* turl =
+              service_->GetTemplateURLForGUID(ranked.second->guid)) {
+        yours_list.Append(BangValue(*turl, terms));
+      }
+    }
+    for (size_t i = 0; i < bangs.size() && i < kMaxListRows; ++i) {
+      if (const TemplateURL* turl =
+              service_->GetTemplateURLForGUID(bangs[i].second->guid)) {
+        bangs_list.Append(BangValue(*turl, terms));
+      }
+    }
+
+    // The deleted triggers, named from the downloaded list when it still has
+    // them.
+    const base::flat_set<std::string> deleted = rac::ReadDeletedBangs(prefs_);
+    base::flat_map<std::string, const Bangs::Bang*> listed;
+    if (!deleted.empty()) {
+      for (const Bangs::Bang& bang :
+           Bangs::BangManager::GetInstance()->GetBangs()) {
+        const std::string trigger = base::ToLowerASCII(bang.bang);
+        if (deleted.contains(trigger)) {
+          listed.emplace(trigger, &bang);
+        }
+      }
+    }
+    for (const std::string& trigger : deleted) {
+      const std::u16string trigger16 = base::UTF8ToUTF16(trigger);
+      auto bang = listed.find(trigger);
+      const std::u16string name16 = bang == listed.end()
+                                        ? std::u16string()
+                                        : base::UTF8ToUTF16(bang->second->name);
+      if (rac::RankBangMatch(normalized, trigger16,
+                             base::i18n::ToLower(name16)) < 0) {
+        continue;
+      }
+      base::DictValue entry;
+      entry.Set("trigger", trigger);
+      entry.Set("name", name16);
+      entry.Set(
+          "siteUrl",
+          bang == listed.end()
+              ? std::string()
+              : GURL(bang->second->template_url).GetWithEmptyPath().spec());
+      // The user's own bang took the trigger, so restoring wouldn't bring
+      // the downloaded one back.
+      entry.Set("replaced",
+                !!service_->GetTemplateURLForKeyword(u"!" + trigger16));
+      deleted_list.Append(std::move(entry));
+    }
+  }
+
+  state.Set("yours", std::move(yours_list));
+  state.Set("bangs", std::move(bangs_list));
+  state.Set("bangsTotal", static_cast<int>(bangs_total));
+  state.Set("bangsMatching", static_cast<int>(bangs_matching));
+  state.Set("deleted", std::move(deleted_list));
+  return state;
+}
+
+void RacBangsHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0],
+                            CreateState(base::UTF8ToUTF16(StringArg(args, 1))));
+}
+
+// Args: callback, guid ("" when adding), field ("name", "trigger", or
+// "url"), value. Resolves with "" when the value is fine, "taken" when
+// another engine has the trigger, "gone" when the bang being edited no
+// longer exists, and "invalid" otherwise.
+void RacBangsHandler::HandleValidate(const base::ListValue& args) {
+  AllowJavascript();
+  const std::string guid = StringArg(args, 1);
+  const std::string field_name = StringArg(args, 2);
+  TemplateURL* existing = service_ ? rac::FindBang(*service_, guid) : nullptr;
+  if (!guid.empty() && !existing) {
+    ResolveJavascriptCallback(args[0], base::Value("gone"));
+    return;
+  }
+  std::optional<rac::BangField> field;
+  if (field_name == "name") {
+    field = rac::BangField::kName;
+  } else if (field_name == "trigger") {
+    field = rac::BangField::kTrigger;
+  } else if (field_name == "url") {
+    field = rac::BangField::kUrl;
+  }
+  rac::BangFieldError error = rac::BangFieldError::kInvalid;
+  if (service_ && field) {
+    error = rac::ValidateBangField(*service_, existing, *field,
+                                   base::UTF8ToUTF16(StringArg(args, 3)));
+  }
+  const char* result = "";
+  if (error == rac::BangFieldError::kInvalid) {
+    result = "invalid";
+  } else if (error == rac::BangFieldError::kTaken) {
+    result = "taken";
+  }
+  ResolveJavascriptCallback(args[0], base::Value(result));
+}
+
+// Args: callback, guid ("" when adding), name, trigger, url. Resolves with
+// "saved", "gone" when the bang being edited no longer exists, or
+// "invalid".
+void RacBangsHandler::HandleSave(const base::ListValue& args) {
+  AllowJavascript();
+  const std::string guid = StringArg(args, 1);
+  TemplateURL* existing = service_ ? rac::FindBang(*service_, guid) : nullptr;
+  const char* result = "invalid";
+  if (!guid.empty() && !existing) {
+    result = "gone";
+  } else if (CanChange() && rac::SaveBang(*service_, *prefs_, existing,
+                                          base::UTF8ToUTF16(StringArg(args, 2)),
+                                          base::UTF8ToUTF16(StringArg(args, 3)),
+                                          StringArg(args, 4))) {
+    result = "saved";
+    ScheduleChanged();
+  }
+  ResolveJavascriptCallback(args[0], base::Value(result));
+}
+
+// Args: guid.
+void RacBangsHandler::HandleDelete(const base::ListValue& args) {
+  if (!CanChange()) {
+    return;
+  }
+  if (TemplateURL* turl = rac::FindBang(*service_, StringArg(args, 0));
+      turl && rac::DeleteBang(*service_, *prefs_, turl)) {
+    ScheduleChanged();
+  }
+}
+
+// Args: trigger, without the "!".
+void RacBangsHandler::HandleRestore(const base::ListValue& args) {
+  if (!CanChange()) {
+    return;
+  }
+  rac::RestoreBang(*service_, *prefs_, StringArg(args, 0));
+  ScheduleChanged();
+}
+
+// The page closed: stop observing and drop the index until it opens again.
+void RacBangsHandler::HandleClose(const base::ListValue& args) {
+  DisallowJavascript();
+}

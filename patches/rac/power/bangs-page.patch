+// The rest are the rules of the Bangs settings page
+// (chrome/browser/ui/webui/settings/rac_bangs_handler.cc), kept here so they
+// can be tested without a browser.
+
+// The trigger of a bang's keyword: "!w" gives "w". Empty when |keyword| doesn't
+// start with "!" or has nothing after it.
+std::u16string BangTriggerFromKeyword(std::u16string_view keyword);
+
+// What the user typed as a bang's shortcut, cleaned up: surrounding whitespace
+// and leading "!"s dropped. Empty when nothing is left, or when what is left
+// has whitespace in it, which the address bar can't match.
+std::u16string NormalizeBangTrigger(std::u16string_view input);
+
+// How well a bang matches the page's search field. Lower is better: 0 when the
+// trigger is the query, 1 when the trigger starts with it, 2 when the name
+// starts with it, 3 when the trigger or the name contains it, and -1 when
+// neither does. An empty query matches everything with 0. Nothing is case
+// folded here, so pass all three in lower case, and the query without "!".
+int RankBangMatch(std::u16string_view query,
+                  std::u16string_view trigger,
+                  std::u16string_view name);
+

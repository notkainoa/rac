+// Backs the Bangs page (chrome://settings/bangs). It lists three kinds of
+// bangs:
+//  - the user's own: site search entries whose keyword starts with "!",
+//  - the downloaded list (TemplateURLs with a bang_id), and
+//  - downloaded bangs the user deleted (the rac.bangs.deleted pref).
+// Deleting a downloaded bang records its trigger, so the next bangs.json
+// doesn't bring it back. Editing one deletes it the same way and adds the
+// user's version as their own. Restoring un-marks the trigger and re-applies
+// the downloaded list. The handler only observes anything while the page is
+// open.
+class RacBangsHandler : public SettingsPageUIHandler,
+                        public TemplateURLServiceObserver {
+ public:
+  explicit RacBangsHandler(Profile* profile);
+  RacBangsHandler(const RacBangsHandler&) = delete;
+  RacBangsHandler& operator=(const RacBangsHandler&) = delete;
+  ~RacBangsHandler() override;
+
+  // Adds the page's strings.
+  static void AddStrings(content::WebUIDataSource* source);
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // TemplateURLServiceObserver:
+  void OnTemplateURLServiceChanged() override;
+
+ private:
+  // The user's own bang or the downloaded bang with |id|, or null.
+  TemplateURL* FindBang(int id);
+  base::DictValue CreateState(const std::u16string& query);
+  // Tells the page to ask again, once per batch of changes.
+  void ScheduleChanged();
+  void FireChanged();
+
+  void HandleGetState(const base::ListValue& args);
+  void HandleValidate(const base::ListValue& args);
+  void HandleSave(const base::ListValue& args);
+  void HandleDelete(const base::ListValue& args);
+  void HandleRestore(const base::ListValue& args);
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<TemplateURLService> service_;
+  PrefChangeRegistrar pref_registrar_;
+  base::ScopedObservation<TemplateURLService, TemplateURLServiceObserver>
+      observation_{this};
+  bool changed_pending_ = false;
+  base::WeakPtrFactory<RacBangsHandler> weak_factory_{this};
+};

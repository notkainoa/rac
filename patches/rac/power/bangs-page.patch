+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_SEARCH_ENGINES_RAC_BANGS_EDIT_H_
+#define COMPONENTS_SEARCH_ENGINES_RAC_BANGS_EDIT_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback_forward.h"
+
+class PrefService;
+class TemplateURL;
+class TemplateURLService;
+
+// What the Bangs settings page (chrome/browser/ui/webui/settings/
+// rac_bangs_handler.cc) does to bangs, kept out of the handler so it can be
+// tested against a TemplateURLService.
+//
+// The user's own bangs are site search entries with a "!" keyword; the
+// downloaded ones are TemplateURLs with a bang_id. A downloaded bang the user
+// deletes or edits has its trigger recorded in rac.bangs.deleted, which
+// TemplateURLService::BangsLoadedCallback skips when it applies the list.
+namespace rac {
+
+// The list BangManager loads in place of downloading bangs.json, in the same
+// format. Tests set it, and so does --rac-bangs-fixture in dev builds
+// (chrome/browser/rac/power/bangs_fixture.cc). Release builds never do.
+// With |hold|, BangManager waits for ReleaseBangsListOverride() before it
+// loads the list, so the fixture can wait until the profile's engines have
+// loaded, the way a download usually arrives after them.
+void SetBangsListOverride(std::string bangs_json, bool hold = false);
+void ReleaseBangsListOverride();
+
+// When an override is set, has |load| run with it (posted, or once released)
+// and returns true, and BangManager loads it as if it was downloaded.
+// Otherwise returns false.
+bool PostBangsListOverride(base::OnceCallback<void(std::string)> load);
+
+// One of the user's own bangs: a site search entry they added with a "!"
+// keyword. Prepopulated, starter pack, policy, and extension engines are not
+// theirs to change here, and neither is the default search engine.
+bool IsUserBang(const TemplateURL& turl, const TemplateURLService& service);
+
+// A downloaded bang or one of the user's own.
+bool IsBang(const TemplateURL& turl, const TemplateURLService& service);
+
+// The bang with |guid| (its sync GUID, which unlike its id is unique), or
+// null when there's none, or the engine with that GUID isn't a bang.
+TemplateURL* FindBang(TemplateURLService& service, const std::string& guid);
+
+enum class BangField { kName, kTrigger, kUrl };
+enum class BangFieldError { kNone, kInvalid, kTaken };
+
+// Checks one field of the add or edit dialog. |existing| is the bang being
+// edited, or null when adding one. A trigger is typed without its "!", and
+// kTaken means another engine has it. A bang always searches, so its URL
+// needs the %s.
+BangFieldError ValidateBangField(const TemplateURLService& service,
+                                 const TemplateURL* existing,
+                                 BangField field,
+                                 std::u16string_view value);
+
+// Saves the dialog's fields as one of the user's own bangs. |existing| is the
+// bang being edited, or null to add one. Editing a downloaded bang deletes it
+// (recording its trigger) and adds the user's copy, unless nothing changed.
+// Renaming the user's own bang lets a downloaded bang its old keyword hid
+// come back. Returns false, changing nothing, when a field isn't valid or
+// |existing| isn't a bang or is the default search engine.
+bool SaveBang(TemplateURLService& service,
+              PrefService& prefs,
+              TemplateURL* existing,
+              std::u16string_view name,
+              std::u16string_view trigger,
+              const std::string& url);
+
+// Deletes a bang. A downloaded one's trigger is recorded so later list loads
+// skip it. Deleting the user's own bang lets a downloaded one it hid come
+// back. Returns false, changing nothing, when |turl| isn't a bang or is the
+// default search engine.
+bool DeleteBang(TemplateURLService& service,
+                PrefService& prefs,
+                const TemplateURL* turl);
+
+// Un-marks a deleted trigger (without the "!") and brings the downloaded bang
+// back, unless the user's own bang has its keyword.
+void RestoreBang(TemplateURLService& service,
+                 PrefService& prefs,
+                 std::string_view trigger);
+
+// Re-applies the downloaded list, skipping deleted triggers and keywords
+// already taken. Only when the list is in memory: it never downloads it.
+void ReapplyBangsList(TemplateURLService& service);
+
+}  // namespace rac
+
+#endif  // COMPONENTS_SEARCH_ENGINES_RAC_BANGS_EDIT_H_

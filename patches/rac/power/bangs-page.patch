+    }
+    this.deleteBang_ = null;
+    this.restoreFocus_();
+  }
+
+  protected onRestoreClick_(e: Event) {
+    const trigger = (e.currentTarget as HTMLElement).dataset['trigger'];
+    if (trigger) {
+      this.browserProxy_.restore(trigger);
+    }
+  }
+
+  private restoreFocus_() {
+    if (this.dialogAnchor_?.isConnected) {
+      focusWithoutInk(this.dialogAnchor_);
+    }
+    this.dialogAnchor_ = null;
+  }
+
+  protected yoursEmptyText_(): string {
+    return this.i18n(this.filter_ ? 'searchNoResults' : 'racBangsYoursNone');
+  }
+
+  protected bangsEmptyText_(): string {

+// The order a real start has: the engines come from a database, and Load()
+// asks for the list before the database answers. When the list is already
+// in memory (any profile after the first, or a cached download), it used to
+// be applied before the saved engines, and its ids collided with theirs.
+class RacBangsAfterRestartTest : public LoadedTemplateURLServiceUnitTestBase {
+ public:
+  static constexpr const char* kTriggers[] = {"w", "yt", "gh", "up"};
+
+ protected:
+  void SetUp() override {
+    // Loading engines from the database reads strings, which need a
+    // resource bundle; an empty one gives empty strings.
+    original_bundle_ =
+        ui::ResourceBundle::SwapSharedInstanceForTesting(&empty_bundle_);
+    // LoadedTemplateURLServiceUnitTestBase::SetUp() expects no engines but
+    // the prepopulated ones, and here the bangs load with them.
+    TemplateURLServiceUnitTestBase::SetUp();
+    SetBangsListOverride(kBangsList);
+    // Have the list in memory before the service loads.
+    Bangs::BangManager::GetInstance()->LoadBangs(nullptr, pref_service(),
+                                                 base::DoNothing());
+    task_environment.RunUntilIdle();
+    ASSERT_FALSE(Bangs::BangManager::GetInstance()->GetBangs().empty());
+    // The first session saves its engines with no bangs among them, as a
+    // first start does when the download arrives after them. Their ids then
+    // start low, where the bangs' ids start.
+    for (const char* trigger : kTriggers) {
+      AddDeletedBang(&pref_service(), trigger);
+    }
+    template_url_service().Load();
+    TemplateURLServiceLoadWaiter().WaitForLoadComplete(template_url_service());
+  }
+
+  // Lets the list in from the next session on.
+  void ShowTheList() {
+    for (const char* trigger : kTriggers) {
+      RemoveDeletedBang(&pref_service(), trigger);
+    }
+  }
+
+  void TearDown() override {
+    LoadedTemplateURLServiceUnitTestBase::TearDown();
+    ui::ResourceBundle::SwapSharedInstanceForTesting(original_bundle_);
+  }
+
+  TemplateURL* Find(const std::u16string& keyword) {
+    return template_url_service().GetTemplateURLForKeyword(keyword);
+  }
+
+  TemplateURL* AddUserBang(const std::u16string& keyword) {
+    TemplateURLData data;
+    data.SetShortName(u"Mine");
+    data.SetKeyword(keyword);
+    data.SetURL("https://example.com/?q={searchTerms}");
+    data.is_active = TemplateURLData::ActiveStatus::kTrue;
+    return template_url_service().Add(std::make_unique<TemplateURL>(data));
+  }
+
+  ui::ResourceBundle empty_bundle_{nullptr};
+  raw_ptr<ui::ResourceBundle> original_bundle_ = nullptr;
+
+  // Every engine's id is its own.
+  bool IdsAreUnique() {
+    std::set<TemplateURLID> ids;
+    for (TemplateURL* turl : template_url_service().GetTemplateURLs()) {
+      if (!ids.insert(turl->id()).second) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  bool IsDownloadedBang(const std::u16string& keyword) {
+    TemplateURL* turl = Find(keyword);
+    return turl && turl->bang_id() > 0;
+  }
+
+  size_t CountKeyword(const std::u16string& keyword) {
+    size_t count = 0;
+    for (TemplateURL* turl : template_url_service().GetTemplateURLs()) {
+      count += turl->keyword() == keyword ? 1 : 0;
+    }
+    return count;
+  }
+};
+
+TEST_F(RacBangsAfterRestartTest, DeleteHitsTheRightEngine) {
+  ASSERT_FALSE(Find(u"!w"));
+  const std::string guid = AddUserBang(u"!mine")->sync_guid();
+  ShowTheList();
+
+  // The list is in memory before the saved engines load.
+  ResetAndLoadTemplateURLService();
+  ASSERT_TRUE(Find(u"!w"));
+  EXPECT_TRUE(IdsAreUnique());
+  TemplateURL* mine = FindBang(template_url_service(), guid);
+  ASSERT_TRUE(mine);
+  EXPECT_EQ(u"!mine", mine->keyword());
+  EXPECT_EQ(0, mine->bang_id());
+
+  const size_t engines = template_url_service().GetTemplateURLs().size();
+  ASSERT_TRUE(DeleteBang(template_url_service(), pref_service(), mine));
+  EXPECT_EQ(engines - 1, template_url_service().GetTemplateURLs().size());
+  EXPECT_FALSE(Find(u"!mine"));
+  EXPECT_TRUE(Find(u"!w"));
+  EXPECT_TRUE(Find(u"!yt"));
+  EXPECT_TRUE(Find(u"!gh"));
+  EXPECT_TRUE(ReadDeletedBangs(&pref_service()).empty());
+}
+
+TEST_F(RacBangsAfterRestartTest,
+       TheUsersBangHidesTheDownloadedOneAfterRestart) {
+  AddUserBang(u"!gh");
+  ShowTheList();
+
+  // The list in memory before the saved engines load.
+  ResetAndLoadTemplateURLService();
+  ASSERT_TRUE(Find(u"!gh"));
+  EXPECT_EQ(0, Find(u"!gh")->bang_id());
+  EXPECT_EQ(1u, CountKeyword(u"!gh"));
+  EXPECT_TRUE(IsDownloadedBang(u"!w"));
+  EXPECT_TRUE(IdsAreUnique());
+
+  // The list arriving after them.
+  template_url_service().LoadBangs();
+  EXPECT_EQ(0, Find(u"!gh")->bang_id());
+  EXPECT_EQ(1u, CountKeyword(u"!gh"));
+  EXPECT_TRUE(IdsAreUnique());
+}

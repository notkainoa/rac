+  private focusNear_(list: BangList, index: number) {
+    const rows = this.shadowRoot.querySelectorAll<HTMLElement>(
+        `#${list} .bang-row`);
+    const row = rows[Math.min(index, rows.length - 1)];
+    const control = row?.querySelector<HTMLElement>(
+        'cr-icon-button, cr-button:not([disabled])');
+    const target = control ||
+        this.shadowRoot.querySelector<HTMLElement>(`#${list}Title`) ||
+        this.shadowRoot.querySelector<HTMLElement>('#bangsTitle');
+    if (target) {
+      focusWithoutInk(target);
+    }
+  }
+
+  protected onAddClick_(e: Event) {
+    this.dialogAnchor_ = e.currentTarget as HTMLElement;
+    this.editBang_ = null;
+    this.editDownloaded_ = false;
+    this.showEditDialog_ = true;
+  }
+
+  protected onEditClick_(e: Event) {
+    const found = this.findBang_(this.guidOf_(e));
+    if (!found) {
+      return;
+    }
+    this.dialogAnchor_ = e.currentTarget as HTMLElement;
+    this.focusAfterChange_ = null;
+    this.editBang_ = found.bang;
+    this.editDownloaded_ = found.downloaded;
+    this.showEditDialog_ = true;
+  }
+
+  protected onEditDialogClose_() {
+    this.showEditDialog_ = false;
+    this.editBang_ = null;
+    this.restoreFocus_();
+  }
+
+  protected onDeleteClick_(e: Event) {
+    const found = this.findBang_(this.guidOf_(e));
+    if (!found) {
+      return;
+    }
+    if (found.downloaded) {
+      // A downloaded bang can be restored, so it goes without asking.
+      this.focusAfterChange_ = this.placeOf_(e);
+      this.browserProxy_.deleteBang(found.bang.guid);
+      return;
+    }
+    this.dialogAnchor_ = e.currentTarget as HTMLElement;
+    this.focusAfterChange_ = this.placeOf_(e);
+    this.deleteBang_ = found.bang;
+  }
+
+  protected deleteTitle_(): string {
+    return this.i18n('racBangsDeleteTitle', this.deleteBang_?.trigger ?? '');
+  }
+
+  protected onDeleteDialogClose_() {
+    const dialog =
+        this.shadowRoot.querySelector<SettingsSimpleConfirmationDialogElement>(
+            '#deleteDialog');

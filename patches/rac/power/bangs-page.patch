+          display: flex;
+          flex: 3;
+          gap: 12px;
+          min-width: 0;
+        }
+
+        .bang-name site-favicon {
+          flex-shrink: 0;
+        }
+
+        .bang-trigger {
+          color: var(--cr-secondary-text-color);
+          flex: 2;
+          min-width: 0;
+        }
+
+        /* As wide in every list, so the shortcut column lines up. */
+        .bang-controls {

+  override currentRouteChanged(newRoute: Route, oldRoute?: Route) {
+    super.currentRouteChanged(newRoute, oldRoute);
+    const open = newRoute === routes.BANGS;
+    if (open === this.open_) {
+      return;
+    }
+    this.open_ = open;
+    if (open) {
+      this.refresh_();
+      return;
+    }
+    // The browser stops watching the bangs until the page opens again.
+    this.browserProxy_.close();

+      this.browserProxy_.deleteBang(this.deleteBang_.guid);
+      // Focus moves on once the row is gone.
+      this.dialogAnchor_ = null;
+    } else {
+      this.focusAfterChange_ = null;
+    }
+    this.deleteBang_ = null;
+    this.restoreFocus_();
+  }
+
+  protected onRestoreClick_(e: Event) {

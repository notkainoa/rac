+      state_: {type: Object},
+      filter_: {type: String},
+      showEditDialog_: {type: Boolean},
+      editBang_: {type: Object},
+      editDownloaded_: {type: Boolean},
+      deleteBang_: {type: Object},
+    };
+  }
+
+  /** Null while the page is closed. */
+  protected accessor state_: BangsState|null = null;
+  protected accessor filter_: string = '';
+  protected accessor showEditDialog_: boolean = false;
+  /** The bang the edit dialog edits, or null when it adds one. */
+  protected accessor editBang_: Bang|null = null;
+  protected accessor editDownloaded_: boolean = false;
+  /** The user's bang the delete dialog asks about. */
+  protected accessor deleteBang_: Bang|null = null;
+
+  private browserProxy_: BangsBrowserProxy =
+      BangsBrowserProxyImpl.getInstance();
+  private open_: boolean = false;
+  /** Drops replies to queries that were overtaken by newer ones. */
+  private requestId_: number = 0;
+  /** What gets focus back when a dialog closes. */

+// A service that sends its downloads to a test factory.
+class RacBangsNoListTest : public TemplateURLServiceUnitTestBase {
+ protected:
+  std::unique_ptr<TemplateURLService> CreateService() override {
+    return std::make_unique<TemplateURLService>(
+        pref_service(),
+        base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+            &url_loader_factory_),
+        search_engine_choice_service(), prepopulate_data_resolver(),
+        regional_capabilities_service(), profile_metrics_service(),
+        std::make_unique<SearchTermsData>(), nullptr, nullptr,
+        base::RepeatingClosure());
+  }
+
+  network::TestURLLoaderFactory url_loader_factory_;
+};
+
+TEST_F(RacBangsNoListTest, RestoreWithoutTheListMakesNoRequests) {
+  // Runs in a new process, so the BangManager singleton hasn't loaded a
+  // list there.
+  EXPECT_EXIT(
+      {
+        template_url_service().Load();
+        AddDeletedBang(&pref_service(), "w");
+        RestoreBang(template_url_service(), pref_service(), "w");
+        task_environment.RunUntilIdle();
+        const bool quiet =
+            Bangs::BangManager::GetInstance()->GetBangs().empty() &&
+            url_loader_factory_.total_requests() == 0 &&
+            ReadDeletedBangs(&pref_service()).empty();
+        std::exit(quiet ? 0 : 1);
+      },
+      testing::ExitedWithCode(0), "");
+}

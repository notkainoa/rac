+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-bangs-edit-dialog' adds a bang, or edits one, on the Bangs page.
+ * The browser checks each field as it's typed, and again when saving. A
+ * bang's shortcut is typed without its "!".
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import type {PropertyValues} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import {CrLitElement, css} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss as getSettingsSharedLit} from '../settings_shared_lit.css.js';
+
+import type {Bang, BangField, BangFieldError, BangsBrowserProxy} from './bangs_browser_proxy.js';
+import {BangsBrowserProxyImpl, NEW_BANG_GUID} from './bangs_browser_proxy.js';
+import {getHtml} from './bangs_edit_dialog.html.js';
+
+export interface SettingsBangsEditDialogElement {
+  $: {
+    dialog: CrDialogElement,
+  };
+}
+
+const SettingsBangsEditDialogElementBase = I18nMixinLit(CrLitElement);
+
+export class SettingsBangsEditDialogElement extends
+    SettingsBangsEditDialogElementBase {
+  static get is() {
+    return 'settings-bangs-edit-dialog';
+  }
+
+  static override get styles() {
+    return [
+      getCrSharedStyle(),
+      getSettingsSharedLit(),
+      css`
+        #downloadedNote {
+          margin-bottom: 16px;
+        }
+
+        #trigger [slot=inline-prefix] {
+          color: var(--cr-secondary-text-color);
+        }
+      `,
+    ];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      /** The bang to edit, or null to add one. */
+      bang: {type: Object},
+      /** The bang comes from the downloaded list. */
+      downloaded: {type: Boolean},
+      name_: {type: String},
+      trigger_: {type: String},
+      url_: {type: String},
+      errors_: {type: Object},
+      saving_: {type: Boolean},
+    };
+  }
+
+  accessor bang: Bang|null = null;
+  accessor downloaded: boolean = false;
+  protected accessor name_: string = '';
+  protected accessor trigger_: string = '';
+  protected accessor url_: string = '';
+  protected accessor errors_: Record<BangField, BangFieldError> = {
+    name: '',
+    trigger: '',
+    url: '',
+  };
+  protected accessor saving_: boolean = false;
+
+  private browserProxy_: BangsBrowserProxy =
+      BangsBrowserProxyImpl.getInstance();
+
+  override willUpdate(changedProperties: PropertyValues<this>) {
+    super.willUpdate(changedProperties);
+    if (changedProperties.has('bang')) {
+      this.name_ = this.bang?.name ?? '';
+      this.trigger_ = this.bang?.trigger ?? '';
+      this.url_ = this.bang?.url ?? '';
+      this.errors_ = {name: '', trigger: '', url: ''};
+    }
+  }
+
+  private guid_(): string {
+    return this.bang?.guid ?? NEW_BANG_GUID;
+  }
+
+  protected titleText_(): string {
+    return this.i18n(this.bang ? 'racBangsEdit' : 'racBangsAdd');
+  }
+
+  protected actionText_(): string {
+    return this.i18n(this.bang ? 'save' : 'add');
+  }
+
+  protected triggerErrorText_(): string {
+    return this.i18n(
+        this.errors_.trigger === 'taken' ? 'racBangsTriggerTaken' :
+                                           'notValid');
+  }
+
+  protected canSave_(): boolean {
+    return !this.saving_ && !!this.name_.trim() && !!this.trigger_.trim() &&
+        !!this.url_.trim() && !this.errors_.name && !this.errors_.trigger &&
+        !this.errors_.url;
+  }
+
+  protected onNameValueChanged_(e: CustomEvent<{value: string}>) {
+    this.name_ = e.detail.value;
+    this.validate_('name', this.name_);
+  }
+
+  protected onTriggerValueChanged_(e: CustomEvent<{value: string}>) {
+    this.trigger_ = e.detail.value;
+    this.validate_('trigger', this.trigger_);
+  }
+
+  protected onUrlValueChanged_(e: CustomEvent<{value: string}>) {
+    this.url_ = e.detail.value;
+    this.validate_('url', this.url_);
+  }
+
+  private async validate_(field: BangField, value: string) {
+    // An empty field only turns the Save button off; it isn't an error yet.
+    const error = value.trim() ?
+        await this.browserProxy_.validate(this.guid_(), field, value) :
+        '';
+    if (error === 'gone') {
+      // The bang was deleted or replaced elsewhere, maybe in another tab.
+      this.close_();
+      return;
+    }
+    // Drop the answer if the field changed while the browser checked it.
+    const current = {name: this.name_, trigger: this.trigger_, url: this.url_};
+    if (current[field] === value) {
+      this.errors_ = {...this.errors_, [field]: error};
+    }
+  }
+
+  private close_() {
+    if (this.$.dialog.open) {
+      this.$.dialog.close();
+    }
+  }
+
+  protected onCancelClick_() {
+    this.$.dialog.cancel();
+  }
+
+  protected async onActionClick_() {
+    if (!this.canSave_()) {
+      return;
+    }
+    this.saving_ = true;
+    const result = await this.browserProxy_.save(
+        this.guid_(), this.name_, this.trigger_, this.url_);
+    this.saving_ = false;
+    if (result !== 'invalid') {
+      // Saved, or the bang is gone and there's nothing left to save.
+      this.close_();
+      return;
+    }
+    // Something changed since the fields were checked, like another tab
+    // taking the shortcut. Check them all again to show what.
+    this.validate_('name', this.name_);
+    this.validate_('trigger', this.trigger_);
+    this.validate_('url', this.url_);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-bangs-edit-dialog': SettingsBangsEditDialogElement;
+  }
+}
+
+customElements.define(
+    SettingsBangsEditDialogElement.is, SettingsBangsEditDialogElement);

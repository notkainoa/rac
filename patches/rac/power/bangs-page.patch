+namespace settings {
+namespace {
+
+// The downloaded list has thousands of bangs. The page shows this many of
+// the ones that match its search field.
+constexpr size_t kMaxListRows = 100;
+
+// What the page's search field holds, ready for rac::RankBangMatch.
+std::u16string NormalizeQuery(const std::u16string& query) {
+  std::u16string_view trimmed = base::TrimWhitespace(query, base::TRIM_ALL);
+  while (trimmed.starts_with(u'!')) {
+    trimmed.remove_prefix(1);
+  }
+  return base::i18n::ToLower(trimmed);
+}
+
+base::DictValue BangValue(const TemplateURL& turl,
+                          const SearchTermsData& search_terms_data) {
+  base::DictValue bang;
+  bang.Set("guid", turl.sync_guid());
+  bang.Set("name", turl.short_name());
+  bang.Set("trigger", rac::BangTriggerFromKeyword(turl.keyword()));
+  bang.Set("url", turl.url_ref().DisplayURL(search_terms_data));
+  // For the row's icon, from the favicons already on this Mac. The page
+  // never fetches one.
+  bang.Set("siteUrl", GURL(turl.url()).GetWithEmptyPath().spec());
+  return bang;
+}
+
+std::string StringArg(const base::ListValue& args, size_t index) {
+  const std::string* value =
+      index < args.size() ? args[index].GetIfString() : nullptr;
+  return value ? *value : std::string();
+}
+
+}  // namespace
+
+RacBangsHandler::RacBangsHandler(Profile* profile)
+    : profile_(profile),
+      prefs_(profile->GetOriginalProfile()->GetPrefs()),
+      service_(TemplateURLServiceFactory::GetForProfile(profile)) {
+  pref_registrar_.Init(prefs_);
+}
+
+RacBangsHandler::~RacBangsHandler() = default;
+
+// static
+void RacBangsHandler::AddStrings(content::WebUIDataSource* source) {
+  static constexpr webui::LocalizedString kStrings[] = {
+      {"racBangsTitle", IDS_RAC_SETTINGS_BANGS_TITLE},
+      {"racBangsRowDescription", IDS_RAC_SETTINGS_BANGS_ROW_DESCRIPTION},
+      {"racBangsExplanation", IDS_RAC_SETTINGS_BANGS_EXPLANATION},
+      {"racBangsSearch", IDS_RAC_SETTINGS_BANGS_SEARCH},
+      {"racBangsYours", IDS_RAC_SETTINGS_BANGS_YOURS},

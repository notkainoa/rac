+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview Talks to RacBangsHandler
+ * (chrome/browser/ui/webui/settings/rac_bangs_handler.cc) for the Bangs page.
+ */
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+/** A row in the Yours or Bangs list. */
+export interface Bang {
+  id: number;
+  name: string;
+  /** Without the "!". */
+  trigger: string;
+  /** With %s in place of the query. */
+  url: string;
+  /** The site's address, for its favicon. */
+  siteUrl: string;
+}
+
+/** A downloaded bang the user deleted. */
+export interface DeletedBang {
+  /** Without the "!". */
+  trigger: string;
+  /** Empty when the downloaded list no longer has the bang. */
+  name: string;
+  /** The user's own bang has the trigger, so it can't be restored. */
+  replaced: boolean;
+}
+
+export interface BangsState {
+  yours: Bang[];
+  /** The first 100 matches. */
+  bangs: Bang[];
+  /** How many downloaded bangs there are, matching or not. */
+  bangsTotal: number;
+  /** How many downloaded bangs match the query. */
+  bangsMatching: number;
+  deleted: DeletedBang[];
+}
+
+export type BangField = 'name'|'trigger'|'url';
+
+/** '' when the value is fine. */
+export type BangFieldError = ''|'invalid'|'taken';
+
+/** The id the dialog uses for a bang that doesn't exist yet. */
+export const NEW_BANG_ID = -1;
+
+export interface BangsBrowserProxy {
+  /** The lists, narrowed to what matches |query|. */
+  getState(query: string): Promise<BangsState>;
+  validate(id: number, field: BangField, value: string):
+      Promise<BangFieldError>;
+  /** Adds a bang (id NEW_BANG_ID) or saves an edit. Resolves false if not. */
+  save(id: number, name: string, trigger: string, url: string):
+      Promise<boolean>;
+  deleteBang(id: number): void;
+  restore(trigger: string): void;
+}
+
+export class BangsBrowserProxyImpl implements BangsBrowserProxy {
+  getState(query: string) {
+    return sendWithPromise<BangsState>('racBangsGetState', query);
+  }
+
+  validate(id: number, field: BangField, value: string) {
+    return sendWithPromise<BangFieldError>(
+        'racBangsValidate', id, field, value);
+  }
+
+  save(id: number, name: string, trigger: string, url: string) {
+    return sendWithPromise<boolean>(
+        'racBangsSave', id, name, trigger, url);
+  }
+
+  deleteBang(id: number) {
+    // eslint-disable-next-line no-restricted-properties
+    chrome.send('racBangsDelete', [id]);
+  }
+
+  restore(trigger: string) {
+    // eslint-disable-next-line no-restricted-properties
+    chrome.send('racBangsRestore', [trigger]);
+  }
+
+  static getInstance(): BangsBrowserProxy {
+    return instance || (instance = new BangsBrowserProxyImpl());
+  }
+
+  static setInstance(obj: BangsBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: BangsBrowserProxy|null = null;

+TEST(BangsPageRulesTest, TriggerFromKeyword) {
+  EXPECT_EQ(u"w", BangTriggerFromKeyword(u"!w"));
+  EXPECT_EQ(u"yt", BangTriggerFromKeyword(u"!yt"));
+  EXPECT_EQ(u"", BangTriggerFromKeyword(u"w"));
+  EXPECT_EQ(u"", BangTriggerFromKeyword(u"!"));
+  EXPECT_EQ(u"", BangTriggerFromKeyword(u""));
+}
+
+TEST(BangsPageRulesTest, NormalizeTrigger) {
+  EXPECT_EQ(u"w", NormalizeBangTrigger(u"w"));
+  EXPECT_EQ(u"w", NormalizeBangTrigger(u"!w"));
+  EXPECT_EQ(u"yt", NormalizeBangTrigger(u"  !!yt\t"));
+  EXPECT_EQ(u"a!b", NormalizeBangTrigger(u"a!b"));
+  EXPECT_EQ(u"", NormalizeBangTrigger(u""));
+  EXPECT_EQ(u"", NormalizeBangTrigger(u"  "));
+  EXPECT_EQ(u"", NormalizeBangTrigger(u"!!"));
+  EXPECT_EQ(u"", NormalizeBangTrigger(u"! w"));
+  EXPECT_EQ(u"", NormalizeBangTrigger(u"two words"));
+}
+
+TEST(BangsPageRulesTest, RankMatch) {
+  // Everything matches an empty query, equally.
+  EXPECT_EQ(0, RankBangMatch(u"", u"w", u"wikipedia"));
+  EXPECT_EQ(0, RankBangMatch(u"w", u"w", u"wikipedia"));
+  EXPECT_EQ(1, RankBangMatch(u"w", u"wa", u"wolfram alpha"));
+  EXPECT_EQ(2, RankBangMatch(u"wiki", u"w", u"wikipedia"));
+  EXPECT_EQ(3, RankBangMatch(u"pedia", u"w", u"wikipedia"));
+  EXPECT_EQ(3, RankBangMatch(u"t", u"yt", u"youtube"));
+  EXPECT_EQ(-1, RankBangMatch(u"maps", u"w", u"wikipedia"));
+  // An exact trigger beats a longer one that starts the same way.
+  EXPECT_LT(RankBangMatch(u"g", u"g", u"google"),
+            RankBangMatch(u"g", u"gh", u"github"));
+}

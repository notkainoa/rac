+  /** What gets focus back when a dialog closes. */
+  private dialogAnchor_: HTMLElement|null = null;
+  /**
+   * Where focus goes once a row is gone: the row that took its place in the
+   * same list, or the one before it, or the list's heading.
+   */
+  private focusAfterChange_: {list: BangList, index: number}|null = null;
+
+  override connectedCallback() {

+  padding: 0 var(--cr-section-padding) var(--cr-section-vertical-padding);
+}
diff --git a/chrome/browser/resources/settings/search_page/bangs_page.html.ts b/chrome/browser/resources/settings/search_page/bangs_page.html.ts
new file mode 100644
index 0000000..7f5f751
--- /dev/null
+++ b/chrome/browser/resources/settings/search_page/bangs_page.html.ts
@@ -0,0 +1,163 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsBangsPageElement} from './bangs_page.js';
+
+export function getHtml(this: SettingsBangsPageElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-subpage
+    page-title="$i18n{racBangsPageTitle}"
+    route-path="${this.routePath}" search-label="$i18n{racBangsSearch}"
+    search-icon="settings20:filter-list"
+    .searchTerm="${this.filter_}"
+    @search-changed="${this.onSearchChanged_}">
+  <div class="cr-row first">
+    <div class="secondary">$i18n{racBangsPageExplanation}</div>
+  </div>
+
+  <div class="cr-row first">
+    <div class="flex cr-padded-text">
+      <h2>$i18n{racBangsYoursTitle}</h2>
+      <div class="secondary">$i18n{racBangsYoursExplanation}</div>
+    </div>
+    <cr-button class="secondary-button header-aligned-button"
+        aria-label="$i18n{racBangsAddButtonAriaLabel}"
+        @click="${this.onAddBangClick_}" id="addBang">
+      $i18n{add}
+    </cr-button>
+  </div>
+  <div id="noYours" class="list-frame"
+      ?hidden="${this.yourBangs.length > 0}">
+    $i18n{racBangsYoursNone}
+  </div>
+  <div class="no-search-results list-frame"
+      ?hidden="${!this.showNoResultsMessage_(
+          this.yourBangs, this.matchingYourBangs_)}">
+    $i18n{searchNoResults}
+  </div>
+  <div class="list-frame" role="table"
+      ?hidden="${!this.matchingYourBangs_.length}">
+    ${this.matchingYourBangs_.map(item => html`
+      <div class="list-item cr-row bang-row" role="row">
+        <span role="cell" class="bang-name">
+          <settings-search-engine-icon .engine="${item}">
+          </settings-search-engine-icon>
+          <div class="text-elide">${item.displayName}</div>
+        </span>
+        <span role="cell" class="bang-keyword">
+          <div class="text-elide">${item.keyword}</div>
+        </span>
+        <span role="cell" class="bang-controls">
+          <cr-icon-button class="icon-edit" title="$i18n{edit}"
+              aria-label="$i18n{bangsEditButtonAriaLabel}"
+              data-id="${item.id}" @click="${this.onEditYourBangClick_}"
+              ?hidden="${!item.canBeEdited}">
+          </cr-icon-button>
+          <cr-icon-button class="icon-delete-gray" title="$i18n{delete}"
+              aria-label="$i18n{bangsDeleteButtonAriaLabel}"
+              data-id="${item.id}" @click="${this.onDeleteYourBangClick_}"
+              ?hidden="${!item.canBeRemoved}">
+          </cr-icon-button>
+        </span>
+      </div>
+    `)}
+  </div>
+
+  <div class="cr-row first">
+    <div class="flex cr-padded-text">
+      <h2>$i18n{bangsSectionTitle}</h2>
+      <div class="secondary">$i18n{bangsSectionExplanation}</div>
+    </div>
+  </div>
+  <div id="noBangs" class="list-frame"
+      ?hidden="${this.bangs.length > 0}">
+    $i18n{bangsNone}
+  </div>
+  <div class="no-search-results list-frame"
+      ?hidden="${!this.showNoResultsMessage_(
+          this.bangs, this.matchingBangs_)}">
+    $i18n{searchNoResults}
+  </div>
+  <div class="list-frame" role="table"
+      ?hidden="${!this.matchingBangs_.length}">
+    ${this.matchingBangs_.map(item => html`
+      <div class="list-item cr-row bang-row" role="row">
+        <span role="cell" class="bang-name">
+          <settings-search-engine-icon .engine="${item}">
+          </settings-search-engine-icon>
+          <div class="text-elide">${item.displayName}</div>
+        </span>
+        <span role="cell" class="bang-keyword">
+          <div class="text-elide">${item.keyword}</div>
+        </span>
+        <span role="cell" class="bang-controls">
+          <cr-icon-button class="icon-edit" title="$i18n{edit}"
+              aria-label="$i18n{bangsEditButtonAriaLabel}"
+              data-id="${item.id}" @click="${this.onEditBangClick_}">
+          </cr-icon-button>
+          <cr-icon-button class="icon-delete-gray" title="$i18n{delete}"
+              aria-label="$i18n{bangsDeleteButtonAriaLabel}"
+              data-id="${item.id}" @click="${this.onDeleteBangClick_}">
+          </cr-icon-button>
+        </span>
+      </div>
+    `)}
+  </div>
+  <div class="secondary bangs-truncated"
+      ?hidden="${!this.bangsTruncated_()}">
+    $i18n{bangsTruncated}
+  </div>
+
+  ${this.deletedBangs.length ? html`
+    <div class="cr-row first">
+      <div class="flex cr-padded-text">
+        <h2>$i18n{bangsDeletedTitle}</h2>
+        <div class="secondary">$i18n{bangsDeletedExplanation}</div>
+      </div>
+    </div>
+    <div class="no-search-results list-frame"
+        ?hidden="${this.matchingDeletedBangs_.length > 0 ||
+            this.filter_ === ''}">
+      $i18n{searchNoResults}
+    </div>
+    <div class="list-frame" role="table"
+        ?hidden="${!this.matchingDeletedBangs_.length}">
+      ${this.matchingDeletedBangs_.map(trigger => html`
+        <div class="list-item cr-row bang-row" role="row">
+          <span role="cell" class="bang-keyword">
+            <div class="text-elide">!${trigger}</div>
+          </span>
+          <span role="cell" class="bang-controls">
+            <cr-button class="secondary-button" data-trigger="${trigger}"
+                @click="${this.onRestoreBangClick_}">
+              $i18n{bangsRestore}
+            </cr-button>
+          </span>
+        </div>
+      `)}
+    </div>
+  ` : ''}
+
+  ${this.showEditDialog_ ? html`
+    <settings-search-engine-edit-dialog .model="${this.dialogModel_}"
+        .isBang="${true}"
+        @close="${this.onEditDialogClose_}">
+    </settings-search-engine-edit-dialog>
+  ` : ''}
+
+  ${this.showDeleteConfirmationDialog_ ? html`
+    <settings-simple-confirmation-dialog id="deleteConfirmDialog"
+        title-text="$i18n{searchEnginesDeleteConfirmationTitle}"
+        body-text="$i18n{searchEnginesDeleteConfirmationDescription}"
+        confirm-text="$i18n{delete}"
+        @close="${this.onDeleteConfirmationDialogClose_}">
+    </settings-simple-confirmation-dialog>
+  ` : ''}
+</settings-subpage>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
diff --git a/chrome/browser/resources/settings/search_page/bangs_page.ts b/chrome/browser/resources/settings/search_page/bangs_page.ts
new file mode 100644
index 0000000..0c55ce2
--- /dev/null
+++ b/chrome/browser/resources/settings/search_page/bangs_page.ts
@@ -0,0 +1,287 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-bangs-page' is the settings page for bangs: shortcuts like !w
+ * that search a site directly from the address bar. It lists the user's own
+ * bangs first, then the downloaded bangs list, then deleted bangs that can be
+ * restored. It reuses the search engines browser proxy: the bangs lists ride
+ * along in the same SearchEnginesInfo payload.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import '../simple_confirmation_dialog.js';
+import './search_engine_icon.js';
+import './search_engine_edit_dialog.js';
+import '../settings_page/settings_subpage.js';
+
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {assert} from 'chrome://resources/js/assert.js';
+import {focusWithoutInk} from 'chrome://resources/js/focus_without_ink.js';
+import type {PropertyValues} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {SettingsViewMixinLit} from '../settings_page/settings_view_mixin_lit.js';
+
+import type {SearchEngine, SearchEnginesBrowserProxy, SearchEnginesInfo} from './search_engines_browser_proxy.js';
+import {SearchEnginesBrowserProxyImpl} from './search_engines_browser_proxy.js';
+import {getCss} from './bangs_page.css.js';
+import {getHtml} from './bangs_page.html.js';
+
+// The downloaded bangs list has thousands of entries. Only this many rows
+// render at once; the page's search field narrows the list.
+const kMaxVisibleBangs = 100;
+
+const SettingsBangsPageElementBase =
+    SettingsViewMixinLit(WebUiListenerMixinLit(I18nMixinLit(CrLitElement)));
+
+export class SettingsBangsPageElement extends SettingsBangsPageElementBase {
+  static get is() {
+    return 'settings-bangs-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      /** The user's own bangs: site-search entries with a "!" trigger. */
+      yourBangs: {type: Array},
+
+      /** The bangs from the downloaded list. */
+      bangs: {type: Array},
+
+      /** The triggers of downloaded bangs the user deleted. */
+      deletedBangs: {type: Array},
+
+      /** Filters out all bangs that do not match. */
+      filter_: {type: String},
+
+      matchingYourBangs_: {type: Array},
+      matchingBangs_: {type: Array},
+      matchingDeletedBangs_: {type: Array},
+
+      dialogModel_: {type: Object},
+      dialogAnchorElement_: {type: Object},
+      showEditDialog_: {type: Boolean},
+      showDeleteConfirmationDialog_: {type: Boolean},
+    };
+  }
+
+  accessor yourBangs: SearchEngine[] = [];
+  accessor bangs: SearchEngine[] = [];
+  accessor deletedBangs: string[] = [];
+  protected accessor filter_: string = '';
+  protected accessor matchingYourBangs_: SearchEngine[] = [];
+  protected accessor matchingBangs_: SearchEngine[] = [];
+  protected accessor matchingDeletedBangs_: string[] = [];
+  protected accessor dialogModel_: SearchEngine|null = null;
+  protected accessor dialogAnchorElement_: HTMLElement|null = null;
+  protected accessor showEditDialog_: boolean = false;
+  protected accessor showDeleteConfirmationDialog_: boolean = false;
+
+  private browserProxy_: SearchEnginesBrowserProxy =
+      SearchEnginesBrowserProxyImpl.getInstance();
+
+  override willUpdate(changedProperties: PropertyValues<this>) {
+    super.willUpdate(changedProperties);
+
+    const changedPrivateProperties =
+        changedProperties as Map<PropertyKey, unknown>;
+
+    if (changedProperties.has('yourBangs') ||
+        changedPrivateProperties.has('filter_')) {
+      this.matchingYourBangs_ =
+          this.computeMatchingEngines_(this.yourBangs);
+    }
+
+    if (changedProperties.has('bangs') ||
+        changedPrivateProperties.has('filter_')) {
+      this.matchingBangs_ = this.computeMatchingBangs_();
+    }
+
+    if (changedProperties.has('deletedBangs') ||
+        changedPrivateProperties.has('filter_')) {
+      this.matchingDeletedBangs_ = this.computeMatchingDeletedBangs_();
+    }
+  }
+
+  override firstUpdated(changedProperties: PropertyValues<this>) {
+    super.firstUpdated(changedProperties);
+
+    this.browserProxy_.getSearchEnginesList().then(
+        this.enginesChanged_.bind(this));
+    this.addWebUiListener(
+        'search-engines-changed', this.enginesChanged_.bind(this));
+  }
+
+  protected onSearchChanged_(e: CustomEvent<string>) {
+    this.filter_ = e.detail;
+  }
+
+  private openEditDialog_(
+      searchEngine: SearchEngine|null, anchorElement: HTMLElement) {
+    this.dialogModel_ = searchEngine;
+    this.dialogAnchorElement_ = anchorElement;
+    this.showEditDialog_ = true;
+  }
+
+  protected onEditDialogClose_() {
+    this.showEditDialog_ = false;
+    focusWithoutInk(this.dialogAnchorElement_ as HTMLElement);
+    this.dialogModel_ = null;
+    this.dialogAnchorElement_ = null;
+  }
+
+  protected onDeleteConfirmationDialogClose_() {
+    const dialog =
+        this.shadowRoot.querySelector('settings-simple-confirmation-dialog');
+    assert(dialog);
+    const confirmed = dialog.wasConfirmed();
+    this.showDeleteConfirmationDialog_ = false;
+
+    if (confirmed) {
+      assert(this.dialogModel_);
+      this.browserProxy_.removeSearchEngine(this.dialogModel_.id);
+      this.dialogAnchorElement_ = null;
+    }
+
+    this.dialogModel_ = null;
+  }
+
+  private enginesChanged_(searchEnginesInfo: SearchEnginesInfo) {
+    // The user's own bangs are the site-search entries whose trigger starts
+    // with "!"; downloaded bangs never reach those lists. (The display
+    // string can carry a directionality mark, so drop it before checking.)
+    const isUserBang = (engine: SearchEngine) =>
+        engine.keyword.replace(/^\u200e+/, '').startsWith('!');
+    this.yourBangs =
+        [...searchEnginesInfo.actives, ...searchEnginesInfo.others]
+            .filter(isUserBang)
+            .sort((a, b) => a.displayName.localeCompare(b.displayName));
+    this.bangs = searchEnginesInfo.bangs || [];
+    this.deletedBangs = searchEnginesInfo.deletedBangs || [];
+  }
+
+  /**
+   * @param list The original list.
+   * @return The subset of |list| that matches the filter.
+   */
+  private computeMatchingEngines_(list: SearchEngine[]): SearchEngine[] {
+    if (this.filter_ === '') {
+      return list;
+    }
+
+    const filter = this.filter_.toLowerCase();
+    return list.filter(e => {
+      return [e.displayName, e.name, e.keyword, e.url].some(
+          term => term.toLowerCase().includes(filter));
+    });
+  }
+
+  /**
+   * Filters the downloaded bangs list and caps it at kMaxVisibleBangs rows.
+   */
+  private computeMatchingBangs_(): SearchEngine[] {
+    return this.computeMatchingEngines_(this.bangs).slice(
+        0, kMaxVisibleBangs);
+  }
+
+  /**
+   * @return Whether more bangs match the filter than are rendered.
+   */
+  protected bangsTruncated_(): boolean {
+    return this.computeMatchingEngines_(this.bangs).length >
+        this.matchingBangs_.length;
+  }
+
+  /**
+   * Filters the deleted bang triggers based on the filter string.
+   */
+  private computeMatchingDeletedBangs_(): string[] {
+    if (this.filter_ === '') {
+      return this.deletedBangs;
+    }
+
+    const filter = this.filter_.toLowerCase();
+    return this.deletedBangs.filter(
+        trigger => trigger.toLowerCase().includes(filter));
+  }
+
+  protected onAddBangClick_(e: Event) {

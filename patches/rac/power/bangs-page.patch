+    const state = await this.browserProxy_.getState(this.filter_);
+    if (!this.open_ || requestId !== this.requestId_) {
+      return;
+    }
+    this.state_ = state;
+    if (this.focusAfterChange_) {
+      await this.updateComplete;
+      this.focusNear_(this.focusAfterChange_.list,
+                      this.focusAfterChange_.index);
+      this.focusAfterChange_ = null;
+    }
+  }
+
+  protected onSearchChanged_(e: CustomEvent<string>) {

+RacBangsHandler::~RacBangsHandler() = default;
+
+// static
+void RacBangsHandler::AddStrings(content::WebUIDataSource* source) {
+  static constexpr webui::LocalizedString kStrings[] = {
+      {"racBangsTitle", IDS_RAC_SETTINGS_BANGS_TITLE},
+      {"racBangsRowDescription", IDS_RAC_SETTINGS_BANGS_ROW_DESCRIPTION},
+      {"racBangsExplanation", IDS_RAC_SETTINGS_BANGS_EXPLANATION},
+      {"racBangsSearch", IDS_RAC_SETTINGS_BANGS_SEARCH},
+      {"racBangsYours", IDS_RAC_SETTINGS_BANGS_YOURS},
+      {"racBangsYoursExplanation", IDS_RAC_SETTINGS_BANGS_YOURS_EXPLANATION},
+      {"racBangsYoursNone", IDS_RAC_SETTINGS_BANGS_YOURS_NONE},
+      {"racBangsList", IDS_RAC_SETTINGS_BANGS_LIST},
+      {"racBangsListExplanation", IDS_RAC_SETTINGS_BANGS_LIST_EXPLANATION},
+      {"racBangsListNone", IDS_RAC_SETTINGS_BANGS_LIST_NONE},
+      {"racBangsListMore", IDS_RAC_SETTINGS_BANGS_LIST_MORE},
+      {"racBangsDeleted", IDS_RAC_SETTINGS_BANGS_DELETED},
+      {"racBangsDeletedExplanation",
+       IDS_RAC_SETTINGS_BANGS_DELETED_EXPLANATION},
+      {"racBangsRestore", IDS_RAC_SETTINGS_BANGS_RESTORE},
+      {"racBangsReplaced", IDS_RAC_SETTINGS_BANGS_REPLACED},
+      {"racBangsAdd", IDS_RAC_SETTINGS_BANGS_ADD},
+      {"racBangsEdit", IDS_RAC_SETTINGS_BANGS_EDIT},
+      {"racBangsEditNamed", IDS_RAC_SETTINGS_BANGS_EDIT_NAMED},
+      {"racBangsDeleteNamed", IDS_RAC_SETTINGS_BANGS_DELETE_NAMED},
+      {"racBangsRestoreNamed", IDS_RAC_SETTINGS_BANGS_RESTORE_NAMED},
+      {"racBangsEditDownloaded", IDS_RAC_SETTINGS_BANGS_EDIT_DOWNLOADED},
+      {"racBangsTriggerTaken", IDS_RAC_SETTINGS_BANGS_TRIGGER_TAKEN},
+      {"racBangsDeleteTitle", IDS_RAC_SETTINGS_BANGS_DELETE_TITLE},
+      {"racBangsDeleteBody", IDS_RAC_SETTINGS_BANGS_DELETE_BODY},

+}
+
+void RacBangsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "racBangsGetState", base::BindRepeating(&RacBangsHandler::HandleGetState,
+                                              base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racBangsValidate", base::BindRepeating(&RacBangsHandler::HandleValidate,
+                                              base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racBangsSave", base::BindRepeating(&RacBangsHandler::HandleSave,
+                                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racBangsDelete", base::BindRepeating(&RacBangsHandler::HandleDelete,
+                                            base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racBangsRestore", base::BindRepeating(&RacBangsHandler::HandleRestore,
+                                             base::Unretained(this)));
+}
+
+void RacBangsHandler::OnJavascriptAllowed() {
+  if (service_) {
+    observation_.Observe(service_);
+  }
+  // Another Settings tab can delete or restore a bang.
+  pref_registrar_.Add(rac::kDeletedBangsPref,
+                      base::BindRepeating(&RacBangsHandler::ScheduleChanged,
+                                          base::Unretained(this)));
+}
+
+void RacBangsHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+  pref_registrar_.RemoveAll();
+  weak_factory_.InvalidateWeakPtrs();
+  changed_pending_ = false;
+}
+
+void RacBangsHandler::OnTemplateURLServiceChanged() {
+  ScheduleChanged();
+}
+
+void RacBangsHandler::ScheduleChanged() {
+  if (changed_pending_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  changed_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RacBangsHandler::FireChanged,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void RacBangsHandler::FireChanged() {
+  changed_pending_ = false;
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("rac-bangs-changed");
+  }
+}
+
+TemplateURL* RacBangsHandler::FindBang(int id) {
+  if (!service_ || id < 0) {
+    return nullptr;
+  }
+  for (TemplateURL* turl : service_->GetTemplateURLs()) {
+    if (turl->id() == id &&
+        (turl->bang_id() > 0 || IsUserBang(turl, service_))) {
+      return turl;
+    }
+  }
+  return nullptr;
+}
+
+base::DictValue RacBangsHandler::CreateState(const std::u16string& query) {
+  base::DictValue state;
+  base::ListValue yours_list;
+  base::ListValue bangs_list;
+  base::ListValue deleted_list;
+  size_t bangs_total = 0;
+  size_t bangs_matching = 0;
+
+  if (service_) {
+    const std::u16string normalized = NormalizeQuery(query);
+    std::vector<RankedBang> yours;
+    std::vector<RankedBang> bangs;
+    for (TemplateURL* turl : service_->GetTemplateURLs()) {
+      const bool downloaded = turl->bang_id() > 0;
+      if (!downloaded && !IsUserBang(turl, service_)) {
+        continue;
+      }
+      bangs_total += downloaded ? 1 : 0;
+      const int rank = normalized.empty() ? 0 : Rank(normalized, turl);
+      if (rank < 0) {
+        continue;
+      }
+      (downloaded ? bangs : yours)
+          .emplace_back(rank, rac::BangTriggerFromKeyword(turl->keyword()),
+                        turl);
+    }
+    SortRanked(yours, yours.size());
+    SortRanked(bangs, kMaxListRows);
+    bangs_matching = bangs.size();
+    const SearchTermsData& terms = service_->search_terms_data();
+    for (const RankedBang& bang : yours) {
+      yours_list.Append(BangValue(std::get<2>(bang), terms));
+    }
+    for (size_t i = 0; i < bangs.size() && i < kMaxListRows; ++i) {
+      bangs_list.Append(BangValue(std::get<2>(bangs[i]), terms));
+    }
+
+    // The deleted triggers, named from the downloaded list when it still has
+    // them.
+    const base::flat_set<std::string> deleted =
+        rac::ReadDeletedBangs(profile_->GetPrefs());
+    base::flat_map<std::string, std::string> names;
+    if (!deleted.empty()) {
+      for (const Bangs::Bang& bang :
+           Bangs::BangManager::GetInstance()->GetBangs()) {
+        const std::string trigger = base::ToLowerASCII(bang.bang);
+        if (deleted.contains(trigger)) {
+          names.emplace(trigger, bang.name);
+        }
+      }
+    }
+    for (const std::string& trigger : deleted) {
+      const std::u16string trigger16 = base::UTF8ToUTF16(trigger);
+      auto name = names.find(trigger);
+      const std::u16string name16 = name == names.end()
+                                        ? std::u16string()
+                                        : base::UTF8ToUTF16(name->second);
+      if (rac::RankBangMatch(normalized, trigger16,
+                             base::i18n::ToLower(name16)) < 0) {
+        continue;
+      }
+      base::DictValue entry;
+      entry.Set("trigger", trigger);
+      entry.Set("name", name16);
+      // The user's own bang took the trigger, so restoring wouldn't bring
+      // the downloaded one back.
+      entry.Set("replaced",
+                !!service_->GetTemplateURLForKeyword(u"!" + trigger16));
+      deleted_list.Append(std::move(entry));
+    }
+  }
+
+  state.Set("yours", std::move(yours_list));
+  state.Set("bangs", std::move(bangs_list));
+  state.Set("bangsTotal", static_cast<int>(bangs_total));
+  state.Set("bangsMatching", static_cast<int>(bangs_matching));
+  state.Set("deleted", std::move(deleted_list));
+  return state;
+}
+
+void RacBangsHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0],
+                            CreateState(base::UTF8ToUTF16(StringArg(args, 1))));
+}
+
+// Args: callback, id (-1 when adding), field ("name", "trigger", or "url"),
+// value. Resolves with "" when the value is fine, "taken" when another
+// engine has the trigger, and "invalid" otherwise.
+void RacBangsHandler::HandleValidate(const base::ListValue& args) {
+  AllowJavascript();
+  const int id = IdArg(args, 1);
+  const std::string field = StringArg(args, 2);
+  const std::string value = StringArg(args, 3);
+  TemplateURL* existing = FindBang(id);
+  std::string result = "invalid";
+  if (service_ && (id < 0 || existing)) {
+    if (field == "name") {
+      result = IsSearchEngineNameValidToUse(base::UTF8ToUTF16(value))
+                   ? ""
+                   : "invalid";
+    } else if (field == "trigger") {
+      const std::u16string trigger =
+          rac::NormalizeBangTrigger(base::UTF8ToUTF16(value));
+      if (!trigger.empty()) {
+        result = IsSearchEngineKeywordValidToUse(
+                     u"!" + base::i18n::ToLower(trigger), service_, existing)
+                     ? ""
+                     : "taken";
+      }
+    } else if (field == "url") {
+      // A bang always searches, so its URL needs the %s.
+      result = IsSearchEngineURLValidToUse(value, service_, existing,
+                                           /*is_new_primary=*/true)
+                   ? ""
+                   : "invalid";
+    }
+  }
+  ResolveJavascriptCallback(args[0], base::Value(result));
+}
+
+// Args: callback, id (-1 when adding), name, trigger, url. Resolves with
+// whether the bang was saved.
+void RacBangsHandler::HandleSave(const base::ListValue& args) {
+  AllowJavascript();
+  const int id = IdArg(args, 1);
+  const std::u16string name_input = base::UTF8ToUTF16(StringArg(args, 2));
+  const std::u16string name(base::TrimWhitespace(name_input, base::TRIM_ALL));
+  const std::u16string trigger =
+      rac::NormalizeBangTrigger(base::UTF8ToUTF16(StringArg(args, 3)));
+  const std::string url = StringArg(args, 4);
+  TemplateURL* existing = FindBang(id);
+  const std::u16string keyword = u"!" + base::i18n::ToLower(trigger);
+  if (!service_ || (id >= 0 && !existing) || trigger.empty() ||
+      !IsSearchEngineNameValidToUse(name) ||
+      !IsSearchEngineKeywordValidToUse(keyword, service_, existing) ||
+      !IsSearchEngineURLValidToUse(url, service_, existing,
+                                   /*is_new_primary=*/true)) {
+    ResolveJavascriptCallback(args[0], base::Value(false));
+    return;
+  }
+
+  const std::string fixed_url =
+      GetFixedUpSearchEngineUrl(url, service_->search_terms_data());
+  if (existing && existing->bang_id() == 0) {
+    service_->ResetTemplateURL(existing, name, keyword, fixed_url,
+                               existing->suggestions_url());
+  } else if (!existing || existing->short_name() != name ||
+             existing->keyword() != keyword || existing->url() != fixed_url) {
+    if (existing) {
+      // Editing a downloaded bang replaces it with the user's own. Deleting
+      // the original records its trigger, so the next bangs.json doesn't
+      // add it back next to the user's version.
+      rac::AddDeletedBang(
+          profile_->GetPrefs(),
+          base::UTF16ToUTF8(rac::BangTriggerFromKeyword(existing->keyword())));
+      service_->Remove(existing);
+    }
+    TemplateURLData data;
+    data.SetShortName(name);
+    data.SetKeyword(keyword);
+    data.SetURL(fixed_url);
+    data.is_active = TemplateURLData::ActiveStatus::kTrue;
+    service_->Add(std::make_unique<TemplateURL>(data));
+  }
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
+
+// Args: id.
+void RacBangsHandler::HandleDelete(const base::ListValue& args) {
+  TemplateURL* turl = FindBang(IdArg(args, 0));
+  if (!turl || turl == service_->GetDefaultSearchProvider()) {
+    return;
+  }
+  const bool downloaded = turl->bang_id() > 0;
+  if (downloaded) {
+    rac::AddDeletedBang(
+        profile_->GetPrefs(),
+        base::UTF16ToUTF8(rac::BangTriggerFromKeyword(turl->keyword())));
+  }
+  service_->Remove(turl);
+  // A downloaded bang the user's own one hid can come back now. This only
+  // re-applies the list already in memory; it never downloads it.
+  if (!downloaded && !Bangs::BangManager::GetInstance()->GetBangs().empty()) {
+    service_->LoadBangs();
+    ScheduleChanged();
+  }
+}
+
+// Args: trigger, without the "!".
+void RacBangsHandler::HandleRestore(const base::ListValue& args) {
+  if (!service_) {
+    return;
+  }
+  rac::RemoveDeletedBang(profile_->GetPrefs(), StringArg(args, 0));
+  // Re-applies the downloaded list, which skips the triggers still deleted.
+  // TemplateURLService doesn't tell observers about bangs it adds, so tell
+  // the page here.
+  if (!Bangs::BangManager::GetInstance()->GetBangs().empty()) {
+    service_->LoadBangs();
+  }
+  ScheduleChanged();
+}

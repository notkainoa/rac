+  override currentRouteChanged(newRoute: Route, oldRoute?: Route) {
+    super.currentRouteChanged(newRoute, oldRoute);
+    const open = newRoute === routes.BANGS;
+    if (open === this.open_) {
+      return;
+    }
+    this.open_ = open;
+    if (open) {
+      this.refresh_();
+      return;
+    }
+    this.state_ = null;
+    this.showEditDialog_ = false;
+    this.deleteBang_ = null;
+  }
+
+  private async refresh_() {
+    if (!this.open_) {
+      return;
+    }
+    const requestId = ++this.requestId_;
+    const state = await this.browserProxy_.getState(this.filter_);
+    if (this.open_ && requestId === this.requestId_) {
+      this.state_ = state;
+    }
+  }
+
+  protected onSearchChanged_(e: CustomEvent<string>) {
+    if (this.filter_ === e.detail) {
+      return;
+    }
+    this.filter_ = e.detail;
+    this.refresh_();
+  }
+
+  protected findBang_(id: number): {bang: Bang, downloaded: boolean}|null {
+    const yours = this.state_?.yours.find(bang => bang.id === id);
+    if (yours) {
+      return {bang: yours, downloaded: false};
+    }
+    const downloaded = this.state_?.bangs.find(bang => bang.id === id);
+    return downloaded ? {bang: downloaded, downloaded: true} : null;
+  }

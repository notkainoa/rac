+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include <string_view>
+
+#include "chrome/browser/rac/actions/rac_actions.h"
+#include "chrome/browser/rac/power/table_shortcuts.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace rac::power {
+namespace {
+
+using action_table::Action;
+using action_table::Surface;
+
+// The modifiers Helium's shortcut page can store
+// (kStoredModifierMask in browser_shortcut_serialization.cc).
+constexpr int kStoredModifiers = ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN |
+                                 ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN;
+
+// These run on the real table, so a new row can't reach the browser with a
+// default Helium would refuse. The service's own checks (a label and a
+// serialized form) need the browser, so they run in the service; here is
+// what the table can promise by itself.
+
+TEST(TableRowsTest, EveryShortcutRowHasACommandAndALabel) {
+  for (const Action& row : action_table::All()) {
+    if (!row.surfaces.Has(Surface::kShortcut)) {
+      continue;
+    }
+    SCOPED_TRACE(std::string(row.id));
+    ASSERT_NE(0, row.command_id) << "a shortcut row needs its IDC_ id";
+    const int last = row.command_id_last ? row.command_id_last : row.command_id;
+    for (int command_id = row.command_id; command_id <= last; ++command_id) {
+      auto label = TableLabelFor(action_table::All(), command_id);
+      ASSERT_TRUE(label) << "no label for command " << command_id;
+      EXPECT_NE(0, label->message_id);
+    }
+  }
+}
+
+TEST(TableRowsTest, EveryDefaultShortcutCanBeStored) {
+  const auto all_on = [](std::string_view) { return true; };
+  for (const TableShortcut& shortcut :
+       EnabledTableShortcuts(action_table::All(), all_on)) {
+    SCOPED_TRACE(shortcut.command_id);
+    EXPECT_NE(ui::VKEY_UNKNOWN, shortcut.accelerator.key_code());
+    EXPECT_EQ(0, shortcut.accelerator.modifiers() & ~kStoredModifiers);
+  }
+}
+
+TEST(TableRowsTest, EveryDefaultShortcutHasAModifier) {
+  const auto all_on = [](std::string_view) { return true; };
+  for (const TableShortcut& shortcut :
+       EnabledTableShortcuts(action_table::All(), all_on)) {
+    SCOPED_TRACE(shortcut.command_id);
+    EXPECT_NE(0,
+              shortcut.accelerator.modifiers() &
+                  (ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN))
+        << "a bare or Shift-only key would fire while typing";
+  }
+}
+
+}  // namespace
+}  // namespace rac::power

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/bangs_fixture.h"
+
+#include "chrome/browser/rac/dev/buildflags.h"
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/values.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/rac_bangs_edit.h"
+#include "components/search_engines/rac_deleted_bangs.h"
+#include "components/search_engines/template_url_service.h"
+#endif
+
+namespace rac {
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+namespace {
+
+// Not in release builds, so a release always downloads the real list.
+constexpr char kBangsFixtureSwitch[] = "rac-bangs-fixture";
+
+std::optional<base::DictValue> ReadFixture() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(kBangsFixtureSwitch)) {
+    return std::nullopt;
+  }
+  base::FilePath path = command_line.GetSwitchValuePath(kBangsFixtureSwitch);
+  std::string json;
+  // Dev builds only: a few KB, read once per profile at startup.
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  // A relative path is taken from the current folder, which is the
+  // worktree when worktree.sh (or remote-build.sh on another Mac) runs it.
+  if (!path.empty() && !path.IsAbsolute() && !path.ReferencesParent()) {
+    path = base::MakeAbsoluteFilePath(path);
+  }
+  if (!path.IsAbsolute() || !base::ReadFileToString(path, &json)) {
+    LOG(ERROR) << "--" << kBangsFixtureSwitch
+               << " needs a path to a readable file, absolute or relative to"
+                  " the worktree";
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> fixture =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!fixture) {
+    LOG(ERROR) << "--" << kBangsFixtureSwitch
+               << ": the fixture isn't a JSON object";
+  }
+  return fixture;
+}
+
+void AddYours(TemplateURLService* service,
+              PrefService* prefs,
+              const base::ListValue& yours) {
+  for (const base::Value& entry : yours) {
+    const base::DictValue* bang = entry.GetIfDict();
+    const std::string* name = bang ? bang->FindString("name") : nullptr;
+    const std::string* trigger = bang ? bang->FindString("trigger") : nullptr;
+    const std::string* url = bang ? bang->FindString("url") : nullptr;
+    // SaveBang refuses a keyword that's taken, so a profile that already
+    // has the bang from an earlier run keeps one copy.
+    if (name && trigger && url) {
+      SaveBang(*service, *prefs, /*existing=*/nullptr, base::UTF8ToUTF16(*name),
+               base::UTF8ToUTF16(*trigger), *url);
+    }
+  }
+}
+
+void OnServiceLoaded(TemplateURLService* service,
+                     PrefService* prefs,
+                     base::ListValue yours) {
+  AddYours(service, prefs, yours);
+  // The list arrives after the user's engines, as a download does.
+  ReleaseBangsListOverride();
+}
+
+}  // namespace
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+
+void MaybeApplyBangsFixture(TemplateURLService& service, PrefService& prefs) {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  std::optional<base::DictValue> fixture = ReadFixture();
+  if (!fixture) {
+    return;
+  }
+
+  if (const base::ListValue* bangs = fixture->FindList("bangs")) {
+    std::optional<std::string> bangs_json = base::WriteJson(*bangs);
+    if (bangs_json) {
+      SetBangsListOverride(std::move(*bangs_json), /*hold=*/true);
+    }
+  }
+
+  base::ListValue deleted;
+  if (const base::ListValue* triggers = fixture->FindList("deleted")) {
+    for (const base::Value& trigger : *triggers) {
+      if (trigger.is_string()) {
+        deleted.Append(base::ToLowerASCII(trigger.GetString()));
+      }
+    }
+  }
+  prefs.SetList(kDeletedBangsPref, std::move(deleted));
+
+  base::ListValue yours;
+  if (base::ListValue* list = fixture->FindList("yours")) {
+    yours = std::move(*list);
+  }
+  // The subscription has to outlive the load. Profiles live until the
+  // browser quits in a dev run, so the list of them never shrinks.
+  static base::NoDestructor<std::vector<base::CallbackListSubscription>>
+      subscriptions;
+  subscriptions->push_back(service.RegisterOnLoadedCallback(
+      base::BindOnce(&OnServiceLoaded, &service, &prefs, std::move(yours))));
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+}
+
+}  // namespace rac

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_POWER_BANGS_FIXTURE_H_
+#define CHROME_BROWSER_RAC_POWER_BANGS_FIXTURE_H_
+
+class PrefService;
+class TemplateURLService;
+
+namespace rac {
+
+// Dev builds: --rac-bangs-fixture=<file> starts a profile with the bangs
+// state the file describes, so the Bangs page can be shown without clicks.
+// The file is a JSON object (devutils/rac/fixtures/bangs/ has examples):
+//
+//   bangs   — the bangs list, in bangs.json's format; it's loaded in place
+//             of the download, once the profile's engines have loaded
+//   deleted — triggers (no "!") to record as deleted; replaces the pref
+//   yours   — [{name, trigger, url}], the user's own bangs, added unless the
+//             keyword is taken; url has %s for the query
+//
+// Called when the profile's TemplateURLService is built, before it loads.
+// Release builds compile this to nothing, switch name included.
+void MaybeApplyBangsFixture(TemplateURLService& service, PrefService& prefs);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_POWER_BANGS_FIXTURE_H_

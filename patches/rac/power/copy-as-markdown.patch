===================================================================
--- /dev/null
+++ src/chrome/browser/rac/power/markdown_link_label_unittest.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/markdown_link.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+namespace {
+
+TEST(MarkdownLinkLabelTest, TitleIsTrimmedAndLineBreaksBecomeSpaces) {
+  // CR and LF each become a space, so CRLF leaves two.
+  EXPECT_EQ(u"Two  lines",
+            MarkdownLinkLabel(u"  Two\r\nlines \n", GURL("https://a.test/")));
+}
+
+TEST(MarkdownLinkLabelTest, TitleIsNotEscaped) {
+  EXPECT_EQ(u"[a] `b`", MarkdownLinkLabel(u"[a] `b`", GURL("https://a.test/")));
+}
+
+TEST(MarkdownLinkLabelTest, NoTitleFallsBackToTheUnicodeHost) {
+  EXPECT_EQ(u"bücher.example",
+            MarkdownLinkLabel(u"", GURL("https://xn--bcher-kva.example/")));
+  EXPECT_EQ(
+      u"bücher.example",
+      MarkdownLinkLabel(u" \r\n", GURL("https://xn--bcher-kva.example/")));
+}
+
+TEST(MarkdownLinkLabelTest, TitleEqualToTheSpecCountsAsNoTitle) {
+  const GURL url("https://xn--bcher-kva.example/?utm_source=x");
+  EXPECT_EQ(u"bücher.example",
+            MarkdownLinkLabel(u"https://xn--bcher-kva.example/"
+                              u"?utm_source=x",
+                              url));
+}
+
+TEST(MarkdownLinkLabelTest, HostlessAddressFallsBackToTheSpec) {
+  EXPECT_EQ(u"about:blank", MarkdownLinkLabel(u"", GURL("about:blank")));
+}
+
+TEST(MarkdownLinkLabelTest, InvalidAddressGivesAnEmptyLabel) {
+  EXPECT_EQ(u"", MarkdownLinkLabel(u"", GURL()));
+  EXPECT_EQ(u"Title", MarkdownLinkLabel(u"Title", GURL()));
+}
+
+TEST(MarkdownLinkLabelTest, MarkdownLinkUsesTheLabel) {
+  const GURL url("https://xn--bcher-kva.example/");
+  EXPECT_EQ(u"[bücher.example](https://xn--bcher-kva.example/)",
+            MarkdownLink(MarkdownLinkLabel(u"", url), url));
+}
+
+}  // namespace
+}  // namespace rac

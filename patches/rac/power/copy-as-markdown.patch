===================================================================
--- /dev/null
+++ src/chrome/browser/ui/rac/rac_action_copy_markdown.cc
@@ -0,0 +1,69 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/ui/rac/rac_action_copy_markdown.h"
+
+#include <string>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/power/markdown_link.h"
+#include "chrome/browser/rac/power/third_party/stedding/clean_link.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/toasts/api/toast_id.h"
+#include "chrome/browser/ui/toasts/toast_controller.h"
+#include "chrome/browser/ui/toasts/toast_features.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/clipboard/clipboard_buffer.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+#include "url/gurl.h"
+
+namespace rac::action_table {
+
+void CopyAsMarkdown(const ActionContext& context, const base::DictValue&) {
+  BrowserWindowInterface* browser = context.browser;
+  if (!browser) {
+    return;
+  }
+  TabStripModel* tabs = browser->GetTabStripModel();
+  content::WebContents* contents =
+      tabs ? tabs->GetActiveWebContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  const GURL& url = contents->GetLastCommittedURL();
+  if (!url.is_valid()) {
+    return;
+  }
+
+  // The page's own title, and only while the committed entry is the one being
+  // shown. WebContents::GetTitle() would fall back to the address, which still
+  // carries the tracking parameters, and a pending navigation's title belongs
+  // to a page the link doesn't point at.
+  content::NavigationController& controller = contents->GetController();
+  const content::NavigationEntry* entry = controller.GetLastCommittedEntry();
+  std::u16string title;
+  if (entry && entry == controller.GetVisibleEntry()) {
+    title = entry->GetTitle();
+  }
+
+  const GURL clean_url = rac::CleanLink(url);
+  ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+  writer.WriteText(rac::MarkdownLink(title, url));
+  writer.WriteHyperlink(rac::MarkdownLinkLabel(title, url), clean_url.spec());
+  if (browser->GetProfile()->IsOffTheRecord()) {
+    writer.MarkAsOffTheRecord();
+  }
+
+  // The confirmation Copy Link shows.
+  if (toast_features::IsEnabled(toast_features::kLinkCopiedToast)) {
+    if (ToastController* const toast_controller =
+            ToastController::From(browser)) {
+      toast_controller->MaybeShowToast(ToastParams(ToastId::kLinkCopied));
+    }
+  }
+}
+
+}  // namespace rac::action_table

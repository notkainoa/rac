--- src.orig/chrome/browser/rac/power/markdown_link.h
+++ src/chrome/browser/rac/power/markdown_link.h
@@ -35,6 +35,13 @@ namespace rac {
 // invalid `url` has an empty destination: `[label]()`.
 std::u16string MarkdownLink(std::u16string_view title, const GURL& url);
 
+// The label MarkdownLink() uses, before escaping: `title` with each CR and LF
+// turned into a space and the ends trimmed; when that leaves nothing (or the
+// title is `url`'s spec) the Unicode host of CleanLink(`url`), then its spec.
+// The HTML link written next to the Markdown one uses it as its anchor text,
+// so both name the page the same way.
+std::u16string MarkdownLinkLabel(std::u16string_view title, const GURL& url);
+
 }  // namespace rac
 
 #endif  // CHROME_BROWSER_RAC_POWER_MARKDOWN_LINK_H_

--- /dev/null
+++ src/chrome/browser/rac/power/power_actions_unittest.cc
@@ -0,0 +1,81 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include <algorithm>
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/rac/actions/rac_action_ids.h"
+#include "chrome/browser/rac/actions/rac_actions.h"
+#include "chrome/browser/rac/power/shortcuts/table_shortcuts.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace rac::action_table {
+namespace {
+
+bool Shows(Surface surface, const ActionContext& context) {
+  return std::ranges::contains(ForSurface(surface, context),
+                               Find("copy_as_markdown"));
+}
+
+TEST(PowerActionsTest, CopyAsMarkdownRow) {
+  const Action* row = Find("copy_as_markdown");
+  ASSERT_TRUE(row);
+  EXPECT_EQ(IDC_RAC_COPY_AS_MARKDOWN, row->command_id);
+  EXPECT_EQ(row, FindByCommand(IDC_RAC_COPY_AS_MARKDOWN));
+  EXPECT_EQ(Dispatch::kBrowser, row->dispatch);
+  EXPECT_FALSE(row->ai_only);
+  EXPECT_NE(0, row->label_id);
+  EXPECT_EQ("", row->shortcut_pref) << "always on";
+  EXPECT_EQ(Menu::kEdit, row->menu);
+  EXPECT_EQ(IDC_COPY_URL, row->menu_after);
+  EXPECT_EQ(ui::VKEY_C, row->default_shortcut.key);
+  EXPECT_EQ(ui::EF_SHIFT_DOWN | ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN,
+            row->default_shortcut.modifiers);
+  EXPECT_EQ(0, row->default_shortcut.replaces_command_id);
+}
+
+TEST(PowerActionsTest, CopyAsMarkdownIsNeverOfferedToAgents) {
+  const Action* row = Find("copy_as_markdown");
+  ASSERT_TRUE(row);
+  EXPECT_FALSE(row->surfaces.Has(Surface::kBuiltInAgent));
+  EXPECT_FALSE(row->surfaces.Has(Surface::kOutsideAgent));
+  EXPECT_EQ(OutsideClass::kNotOffered, row->outside);
+}
+
+TEST(PowerActionsTest, CopyAsMarkdownNeedsAWebPage) {
+  ActionContext context;
+  for (Surface surface :
+       {Surface::kCommandBar, Surface::kMenu, Surface::kShortcut}) {
+    EXPECT_FALSE(Shows(surface, context));
+  }
+  context.has_tab = true;
+  EXPECT_FALSE(Shows(Surface::kMenu, context)) << "a tab without a web page";
+  context.has_web_page = true;
+  for (Surface surface :
+       {Surface::kCommandBar, Surface::kMenu, Surface::kShortcut}) {
+    EXPECT_TRUE(Shows(surface, context));
+  }
+  // Works with AI off (the default here) and in an incognito window.
+  EXPECT_FALSE(context.ai_enabled);
+  context.incognito = true;
+  EXPECT_TRUE(Shows(Surface::kMenu, context));
+}
+
+}  // namespace
+// The shortcut service sees the row: it has a label, isn't stale, and its
+// menu item is managed as a table shortcut.
+TEST(PowerActionsTest, CopyAsMarkdownReachesTheShortcutService) {
+  // The row isn't AI-only, so it reaches the service with AI off too.
+  EXPECT_TRUE(
+      power::TableLabelFor(All(), IDC_RAC_COPY_AS_MARKDOWN, /*ai_on=*/false,
+                           /*has_placeholder=*/[](int) { return true; }));
+  EXPECT_FALSE(power::IsStaleTableCommand(All(), IDC_RAC_COPY_AS_MARKDOWN,
+                                          /*ai_on=*/false));
+  EXPECT_TRUE(power::IsTableShortcutCommand(All(), IDC_RAC_COPY_AS_MARKDOWN,
+                                            /*ai_on=*/false));
+}
+
+}  // namespace rac::action_table

--- /dev/null
+++ src/chrome/browser/rac/power/group_namer_logic_unittest.cc
@@ -0,0 +1,113 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/group_namer_logic.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+namespace {
+
+TEST(ShouldAutoRenameTest, UnnamedGroupIsRenamed) {
+  EXPECT_TRUE(ShouldAutoRename(false, u"", nullptr));
+  const std::u16string nothing_written;
+  EXPECT_TRUE(ShouldAutoRename(false, u"", &nothing_written));
+}
+
+TEST(ShouldAutoRenameTest, ClearedNameFreezesTheGroup) {
+  const std::u16string last = u"BBC";
+  EXPECT_FALSE(ShouldAutoRename(false, u"", &last));
+}
+
+TEST(ShouldAutoRenameTest, OwnNameIsRenamed) {
+  const std::u16string last = u"BBC";
+  EXPECT_TRUE(ShouldAutoRename(false, u"BBC", &last));
+}
+
+TEST(ShouldAutoRenameTest, OtherNameFreezesTheGroup) {
+  const std::u16string last = u"BBC";
+  EXPECT_FALSE(ShouldAutoRename(false, u"Reading", &last));
+  EXPECT_FALSE(ShouldAutoRename(false, u"bbc", &last));
+  EXPECT_FALSE(ShouldAutoRename(false, u"BBC ", &last));
+}
+
+TEST(ShouldAutoRenameTest, NameWithNothingWrittenIsTheUsers) {
+  EXPECT_FALSE(ShouldAutoRename(false, u"Reading", nullptr));
+}
+
+TEST(ShouldAutoRenameTest, CustomizedGroupIsNeverRenamed) {
+  const std::u16string last = u"BBC";
+  EXPECT_FALSE(ShouldAutoRename(true, u"", nullptr));
+  EXPECT_FALSE(ShouldAutoRename(true, u"", &last));
+  EXPECT_FALSE(ShouldAutoRename(true, u"BBC", &last));
+  EXPECT_FALSE(ShouldAutoRename(true, u"Reading", &last));
+}
+
+TEST(ShouldHandleTabChangeTest, TitleAndAddressChangesAreHandled) {
+  // A title set by script after load, or one that arrives after a pushState
+  // navigation, comes as one of these.
+  EXPECT_TRUE(ShouldHandleTabChange(TabChangeType::kAll));
+  EXPECT_TRUE(ShouldHandleTabChange(TabChangeType::kAttentionOnly));
+  EXPECT_TRUE(ShouldHandleTabChange(TabChangeType::kBlockedOnly));
+  EXPECT_TRUE(ShouldHandleTabChange(TabChangeType::kResourceUsageOnly));
+}
+
+TEST(ShouldHandleTabChangeTest, LoadingOnlyIsSkipped) {
+  EXPECT_FALSE(ShouldHandleTabChange(TabChangeType::kLoadingOnly));
+}
+
+TEST(ShouldTrackNewGroupTest, NewEmptyGroupIsTracked) {
+  EXPECT_TRUE(ShouldTrackNewGroup(true, false, false, false));
+}
+
+TEST(ShouldTrackNewGroupTest, GroupMovedFromAnotherWindowIsNotTracked) {
+  EXPECT_FALSE(ShouldTrackNewGroup(true, false, false, true));
+  // It usually arrives with its name too.
+  EXPECT_FALSE(ShouldTrackNewGroup(false, false, false, true));
+}
+
+TEST(ShouldTrackNewGroupTest, SessionRestoredNamedGroupIsNotTracked) {
+  EXPECT_FALSE(ShouldTrackNewGroup(false, false, false, false));
+  EXPECT_FALSE(ShouldTrackNewGroup(true, true, false, false));
+  EXPECT_FALSE(ShouldTrackNewGroup(false, true, false, false));
+}
+
+TEST(ShouldTrackNewGroupTest, EphemeralGroupIsNotTracked) {
+  EXPECT_FALSE(ShouldTrackNewGroup(true, false, true, false));
+}
+
+TEST(MakeGroupNameMemberTest, VisibleCommittedTitleIsUsed) {
+  const GroupNameMember member = MakeGroupNameMember(
+      GURL("https://example.com/a"), u"Example Domain", true);
+  EXPECT_EQ(GURL("https://example.com/a"), member.url);
+  EXPECT_EQ(u"Example Domain", member.title);
+}
+
+TEST(MakeGroupNameMemberTest, PendingNavigationHasNoTitle) {
+  const GroupNameMember member = MakeGroupNameMember(
+      GURL("https://example.com/a"), u"Example Domain", false);
+  EXPECT_EQ(GURL("https://example.com/a"), member.url);
+  EXPECT_EQ(u"", member.title);
+}
+
+TEST(MakeGroupNameMemberTest, NoTitleStaysEmpty) {
+  const GroupNameMember member =
+      MakeGroupNameMember(GURL("https://example.com/"), u"", true);
+  EXPECT_EQ(u"", member.title);
+}
+
+TEST(GroupNameMemberTest, NamesTheMembersTheHelperMakes) {
+  const GroupNameMember members[] = {
+      MakeGroupNameMember(GURL("https://docs.example.com/a"), u"Intro", true),
+      MakeGroupNameMember(GURL("https://docs.example.com/b"), u"", true),
+  };
+  EXPECT_FALSE(AutoGroupName(members).empty());
+  EXPECT_EQ(u"", AutoGroupName(base::span<const GroupNameMember>()));
+}
+
+}  // namespace
+}  // namespace rac

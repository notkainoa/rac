--- /dev/null
+++ src/chrome/browser/rac/power/group_namer_logic.cc
@@ -0,0 +1,45 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/group_namer_logic.h"
+
+namespace rac {
+
+bool ShouldAutoRename(bool customized,
+                      const std::u16string& title,
+                      const std::u16string* last_written) {
+  if (customized) {
+    return false;
+  }
+  if (title.empty()) {
+    // Empty is where every group starts. Once the namer has written a name,
+    // an empty one means the user cleared it.
+    return !last_written || last_written->empty();
+  }
+  return last_written && title == *last_written;
+}
+
+bool ShouldHandleTabChange(TabChangeType change_type) {
+  return change_type != TabChangeType::kLoadingOnly;
+}
+
+bool ShouldTrackNewGroup(bool title_empty,
+                         bool customized,
+                         bool ephemeral,
+                         bool from_another_window) {
+  return title_empty && !customized && !ephemeral && !from_another_window;
+}
+
+GroupNameMember MakeGroupNameMember(const GURL& url,
+                                    const std::u16string& committed_title,
+                                    bool committed_is_visible) {
+  GroupNameMember member;
+  member.url = url;
+  if (committed_is_visible) {
+    member.title = committed_title;
+  }
+  return member;
+}
+
+}  // namespace rac

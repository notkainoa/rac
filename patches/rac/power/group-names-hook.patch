+++ src/chrome/browser/rac/power/group_namer_logic.h
@@ -0,0 +1,61 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_POWER_GROUP_NAMER_LOGIC_H_
+#define CHROME_BROWSER_RAC_POWER_GROUP_NAMER_LOGIC_H_
+
+#include <string>
+
+#include "chrome/browser/rac/power/third_party/ardia/group_name.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "url/gurl.h"
+
+// The decisions behind naming tab groups automatically, kept free of browser
+// code so a small test binary can cover them. The tab strip observer that
+// uses them is chrome/browser/ui/rac/power/group_namer.h.
+namespace rac {
+
+// Whether a group's name may be replaced by an automatic one. `customized` is
+// TabGroup::IsCustomized(), set when the user edited the group. `title` is
+// the group's current name. `last_written` is the last name the namer gave the
+// group, or null or empty if it gave none yet. A group is renamed only while
+// it is still unnamed (and nothing was written yet) or still carries the name
+// the namer wrote. Any other name came from the user, session restore, or
+// sync, and is never touched. So is an empty name after the namer has written
+// one: the user cleared it.
+bool ShouldAutoRename(bool customized,
+                      const std::u16string& title,
+                      const std::u16string* last_written);
+
+// Whether a tab change can have changed the tab's title or address, so the
+// group's name is worth refreshing. Every kind does except kLoadingOnly,
+// which only flips the spinner. A title that arrives after the page loaded
+// (a script setting document.title, or a title coming in after a pushState
+// navigation) reaches the observer as kAll in 156, and the other kinds are
+// harmless, so only the one known no-op is skipped.
+bool ShouldHandleTabChange(TabChangeType change_type);
+
+// Whether a group that was just created is one the namer should follow.
+// Only a new, unnamed, uncustomized group in this window is. A group that
+// arrives from another window (it keeps the name it had there, and is not
+// renamed again), a group restored with a name or edited by the user, and an
+// ephemeral (focus mode) group are left alone.
+bool ShouldTrackNewGroup(bool title_empty,
+                         bool customized,
+                         bool ephemeral,
+                         bool from_another_window);
+
+// A group member for AutoGroupName(). `url` is the tab's last committed URL.
+// `committed_title` is the title of the last committed navigation entry, and
+// `committed_is_visible` says that entry is also the visible one. A tab in the
+// middle of a navigation has no title of its own yet, and a tab without a
+// committed entry has none at all, so both give an empty title. This never
+// falls back to the URL the way WebContents::GetTitle() does.
+GroupNameMember MakeGroupNameMember(const GURL& url,
+                                    const std::u16string& committed_title,
+                                    bool committed_is_visible);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_POWER_GROUP_NAMER_LOGIC_H_

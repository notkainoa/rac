@@ -0,0 +1,87 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_POWER_GROUP_NAMER_H_
+#define CHROME_BROWSER_UI_RAC_POWER_GROUP_NAMER_H_
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/containers/flat_map.h"
+#include "base/containers/flat_set.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tab_groups/tab_group_id.h"
+
+class TabStripModel;
+
+namespace rac {
+
+// Names the tab groups of one window after their tabs, with
+// rac::AutoGroupName(). A new group is named at once, and the name follows
+// the group as tabs join or leave and as a tab's title or address changes.
+//
+// A group stays under the namer's care only while it carries no name or the
+// last name the namer wrote. The first time it has any other name, such as one
+// the user typed in the group editor (including clearing the name), one
+// restored from a session, or one from synced saved groups, the namer lets go
+// of it for good. After a restart, or when a group moves to another window,
+// the group keeps the name it has and is not renamed again. Ephemeral
+// (focus mode) groups are never tracked.
+//
+// Renames run in a task after the event that asked for them: a burst of
+// changes costs one rename per group, and the tab strip is never changed while
+// it is still telling its observers about another change. A window with no
+// groups does nothing beyond the tab strip's own callbacks.
+//
+// The namer owns itself and deletes itself with its tab strip, so the window's
+// BrowserWindowFeatures needs no member for it.
+class GroupNamer : public TabStripModelObserver {
+ public:
+  // Starts naming the groups of `model`. Does nothing when the tab strip
+  // doesn't support groups.
+  static void Attach(TabStripModel* model);
+
+  GroupNamer(const GroupNamer&) = delete;
+  GroupNamer& operator=(const GroupNamer&) = delete;
+
+  // TabStripModelObserver:
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+  void TabGroupedStateChanged(TabStripModel* tab_strip_model,
+                              std::optional<tab_groups::TabGroupId> old_group,
+                              std::optional<tab_groups::TabGroupId> new_group,
+                              tabs::TabInterface* tab,
+                              int index) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+ private:
+  explicit GroupNamer(TabStripModel* model);
+  ~GroupNamer() override;
+
+  // Asks for `group` to be renamed soon, if the namer still cares for it.
+  void MarkDirty(const tab_groups::TabGroupId& group);
+  void RenameDirtyGroups();
+  void RenameGroup(const tab_groups::TabGroupId& group);
+
+  const raw_ptr<TabStripModel> model_;
+
+  // The groups under the namer's care, each with the last name the namer
+  // wrote for it ("" before the first one).
+  base::flat_map<tab_groups::TabGroupId, std::u16string> last_written_;
+  base::flat_set<tab_groups::TabGroupId> dirty_;
+  bool rename_posted_ = false;
+  // The group and name being written right now, so the namer can tell its own
+  // visuals change from anyone else's.
+  std::optional<std::pair<tab_groups::TabGroupId, std::u16string>> writing_;
+
+  base::WeakPtrFactory<GroupNamer> weak_factory_{this};
+};
+
+}  // namespace rac

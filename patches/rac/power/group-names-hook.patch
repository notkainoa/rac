Index: src/chrome/browser/ui/rac/power/group_namer.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/rac/power/group_namer.cc
@@ -0,0 +1,218 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/power/group_namer.h"
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/rac/power/group_namer_logic.h"
+#include "chrome/browser/rac/power/third_party/ardia/group_name.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/tab_group.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace rac {
+
+namespace {
+
+GroupNameMember MemberForTab(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  if (!contents) {
+    return GroupNameMember();
+  }
+  content::NavigationController& controller = contents->GetController();
+  content::NavigationEntry* committed = controller.GetLastCommittedEntry();
+  return MakeGroupNameMember(
+      contents->GetLastCommittedURL(),
+      committed ? committed->GetTitle() : std::u16string(),
+      committed && committed == controller.GetVisibleEntry());
+}
+
+}  // namespace
+
+// static
+void GroupNamer::Attach(TabStripModel* model) {
+  if (model && model->SupportsTabGroups()) {
+    // Deletes itself in OnTabStripModelDestroyed().
+    new GroupNamer(model);
+  }
+}
+
+GroupNamer::GroupNamer(TabStripModel* model) : model_(model) {
+  model_->AddObserver(this);
+}
+
+GroupNamer::~GroupNamer() = default;
+
+void GroupNamer::OnTabGroupChanged(const TabGroupChange& change) {
+  switch (change.type) {
+    case TabGroupChange::kCreated: {
+      // A group that arrives with a name (restored) or from another window
+      // is not ours to name, and neither is a focus mode group.
+      const TabGroup* group = model_->group_model()->GetTabGroup(change.group);
+      const TabGroupChange::CreateChange* created = change.GetCreateChange();
+      if (group && ShouldTrackNewGroup(
+                       group->visual_data()->title().empty(),
+                       group->IsCustomized(), group->is_ephemeral(),
+                       created && created->reason() ==
+                                      TabGroupChange::TabGroupCreationReason::
+                                          kInsertedFromAnotherTabstrip)) {
+        last_written_[change.group] = std::u16string();
+        MarkDirty(change.group);
+      }
+      break;
+    }
+    case TabGroupChange::kVisualsChanged: {
+      if (last_written_.empty()) {
+        break;
+      }
+      auto it = last_written_.find(change.group);
+      if (it == last_written_.end()) {
+        break;
+      }
+      // The change a group's first tab sends carries no visuals.
+      const TabGroupChange::VisualsChange* visuals = change.GetVisualsChange();
+      if (!visuals || !visuals->new_visuals) {
+        break;
+      }
+      // Our own write echoing back. Any other change, even a nested one made
+      // while we write, goes through the check below.
+      if (writing_ && writing_->first == change.group &&
+          writing_->second == visuals->new_visuals->title()) {
+        break;
+      }
+      const TabGroup* group = model_->group_model()->GetTabGroup(change.group);
+      if (!group ||
+          !ShouldAutoRename(group->IsCustomized(),
+                            visuals->new_visuals->title(), &it->second)) {
+        // Someone else named it; leave it alone for good.
+        last_written_.erase(it);
+        dirty_.erase(change.group);
+      }
+      break;
+    }
+    case TabGroupChange::kClosed:
+      last_written_.erase(change.group);
+      dirty_.erase(change.group);
+      break;
+    case TabGroupChange::kEditorOpened:
+    case TabGroupChange::kMoved:
+      break;
+  }
+}
+
+void GroupNamer::TabGroupedStateChanged(
+    TabStripModel* tab_strip_model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  if (last_written_.empty()) {
+    return;
+  }
+  if (old_group) {
+    MarkDirty(*old_group);
+  }
+  if (new_group) {
+    MarkDirty(*new_group);
+  }
+}
+
+void GroupNamer::OnTabChangedAt(tabs::TabInterface* tab,
+                                TabChangeType change_type) {
+  if (last_written_.empty()) {
+    return;
+  }
+  // Everything but a loading spinner change can carry a new title or address,
+  // including a title set by script or after a pushState navigation.
+  if (!ShouldHandleTabChange(change_type)) {
+    return;
+  }
+  if (std::optional<tab_groups::TabGroupId> group = tab->GetGroup()) {
+    MarkDirty(*group);
+  }
+}
+
+void GroupNamer::OnTabStripModelDestroyed(TabStripModel* tab_strip_model) {
+  delete this;
+}
+
+void GroupNamer::MarkDirty(const tab_groups::TabGroupId& group) {
+  if (!last_written_.contains(group)) {
+    return;
+  }
+  dirty_.insert(group);
+  // Without a task runner (some tests) nothing renames; groups stay as they
+  // are.
+  if (!rename_posted_ && base::SequencedTaskRunner::HasCurrentDefault()) {
+    rename_posted_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&GroupNamer::RenameDirtyGroups,
+                                  weak_factory_.GetWeakPtr()));
+  }
+}
+
+void GroupNamer::RenameDirtyGroups() {
+  rename_posted_ = false;
+  base::flat_set<tab_groups::TabGroupId> groups = std::move(dirty_);
+  dirty_.clear();
+  for (const tab_groups::TabGroupId& group : groups) {
+    RenameGroup(group);
+  }
+}
+
+void GroupNamer::RenameGroup(const tab_groups::TabGroupId& group_id) {
+  auto it = last_written_.find(group_id);
+  if (it == last_written_.end()) {
+    return;
+  }
+  TabGroupModel* group_model = model_->group_model();
+  if (!group_model->ContainsTabGroup(group_id)) {
+    last_written_.erase(it);
+    return;
+  }
+  const TabGroup* group = group_model->GetTabGroup(group_id);
+  // Copied: setting the new visuals replaces the group's own copy.
+  const tab_groups::TabGroupVisualData visuals = *group->visual_data();
+  if (!ShouldAutoRename(group->IsCustomized(), visuals.title(), &it->second)) {
+    last_written_.erase(it);
+    return;
+  }
+
+  std::vector<GroupNameMember> members;
+  for (int i = 0; i < model_->count(); ++i) {
+    tabs::TabInterface* tab = model_->GetTabAtIndex(i);
+    if (tab && tab->GetGroup() == group_id) {
+      members.push_back(MemberForTab(tab));
+    }
+  }
+  if (members.empty()) {
+    return;
+  }
+
+  // An empty name would erase the one the group has.
+  std::u16string name = AutoGroupName(members);
+  if (name.empty() || name == visuals.title()) {
+    return;
+  }
+  it->second = name;
+  writing_ = std::make_pair(group_id, name);
+  model_->ChangeTabGroupVisuals(
+      group_id, tab_groups::TabGroupVisualData(std::move(name), visuals.color(),
+                                               visuals.is_collapsed()));
+  writing_.reset();
+}
+
+}  // namespace rac

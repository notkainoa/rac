@@ -0,0 +1,27 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_POWER_THIRD_PARTY_STEDDING_CLEAN_LINK_H_
+#define CHROME_BROWSER_RAC_POWER_THIRD_PARTY_STEDDING_CLEAN_LINK_H_
+
+#include "url/gurl.h"
+
+namespace rac {
+
+// Returns `url` without the query parameters that only exist to track the
+// reader: the utm_ family, ad-click ids (fbclid, gclid, ...), mail-merge ids,
+// and the share ids of a few sites (YouTube, Spotify, Instagram, X).
+//
+// It only touches a valid http or https URL that has a query. Parameters are
+// found in the raw query, split on `&`, and named by the text before the
+// first `=`, compared ASCII case-insensitively and without decoding (so
+// `utm%5Fsource` is not `utm_source`). Every parameter that stays keeps its
+// order and its encoding byte for byte, empty parts are dropped, the fragment
+// is never touched, and a query that ends up empty is removed. When nothing is
+// dropped, the result is `url` itself, unchanged.
+GURL CleanLink(const GURL& url);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_POWER_THIRD_PARTY_STEDDING_CLEAN_LINK_H_

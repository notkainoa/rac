+++ src/chrome/browser/rac/site_pattern/site_pattern.h
@@ -0,0 +1,77 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_SITE_PATTERN_SITE_PATTERN_H_
+#define CHROME_BROWSER_RAC_SITE_PATTERN_SITE_PATTERN_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace rac {
+
+// A rule that picks out a set of web pages. Only valid http and https URLs
+// ever match; every other scheme gives false.
+//
+// kDomainIs matches the stored host and any subdomain of it, on a label
+// boundary (`github.com` matches `gist.github.com`, not `notgithub.com`).
+//
+// kUrlContains matches when the stored text is a substring of the page's
+// canonical address, ignoring ASCII case. The needle is compared byte for
+// byte after ASCII lower-casing, so a non-ASCII needle only matches the
+// percent-encoded form that appears in the canonical address, never the
+// characters as typed.
+class SitePattern {
+ public:
+  enum class Type { kDomainIs, kUrlContains };
+
+  // Builds a pattern from what a person typed.
+  //
+  // kDomainIs takes a host or a whole address (`Shop.Example`,
+  // `https://shop.example/x?y`, `.shop.example`, `shop.example.`,
+  // `*.shop.example`) and stores
+  // the canonical lower-case host without leading or trailing dots. It
+  // returns nullopt for empty input, a path alone, an address that is not
+  // http or https, and a bare public suffix (`com`, `co.uk`; `github.io` is
+  // allowed). IP addresses and single labels such as `localhost` are allowed.
+  //
+  // kUrlContains trims whitespace, stores the ASCII-lower-cased text, and
+  // returns nullopt for empty input.
+  static std::optional<SitePattern> Create(Type type, std::string_view typed);
+
+  // Gives the "domain is" pattern for the site `url` belongs to: its
+  // registrable domain (`app.slack.com` gives `slack.com`; `me.github.io`
+  // stays itself), or its host for an IP address or a single label. Returns
+  // nullopt when `url` is not a valid http or https address, or when its host
+  // is a bare public suffix.
+  static std::optional<SitePattern> ForSiteOf(const GURL& url);
+
+  // Reads a pattern written by ToValue(). The checks in Create() run again,
+  // so a hand-edited preference can't smuggle in a rule Create() would
+  // refuse. Returns nullopt for anything malformed.
+  static std::optional<SitePattern> FromValue(const base::DictValue& dict);
+
+  // Writes {"type": "domain" | "contains", "value": <text>}.
+  base::DictValue ToValue() const;
+
+  bool Matches(const GURL& url) const;
+
+  Type type() const { return type_; }
+  const std::string& value() const { return value_; }
+
+  friend bool operator==(const SitePattern&, const SitePattern&) = default;
+
+ private:
+  SitePattern(Type type, std::string value);
+
+  Type type_;
+  std::string value_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_SITE_PATTERN_SITE_PATTERN_H_

+// LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+// CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+// SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+// INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+// CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+// ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+// POSSIBILITY OF SUCH DAMAGE.
+
+#include "chrome/browser/rac/power/third_party/stedding/clean_link.h"
+
+#include "base/containers/span.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+namespace {
+
+struct Case {
+  const char* in;
+  const char* out;
+};
+
+void ExpectCases(base::span<const Case> cases) {
+  for (const Case& row : cases) {
+    SCOPED_TRACE(row.in);
+    EXPECT_EQ(row.out, CleanLink(GURL(row.in)).spec());
+  }
+}
+
+void ExpectUnchanged(base::span<const char* const> specs) {
+  for (const char* spec : specs) {
+    SCOPED_TRACE(spec);
+    const GURL url(spec);
+    EXPECT_EQ(url, CleanLink(url));
+    EXPECT_EQ(url.spec(), CleanLink(url).spec());
+  }
+}
+
+TEST(CleanLinkTest, DropsTheAcceptanceCaseParameter) {
+  EXPECT_EQ("https://x.com/a?id=3#c",
+            CleanLink(GURL("https://x.com/a?utm_source=y&id=3#c")).spec());
+}
+
+TEST(CleanLinkTest, DropsEveryFamilyInTheTable) {
+  const Case kCases[] = {
+      {"https://a.test/p?utm_source=x&utm_medium=y&q=1",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?utm_campaign=x&utm_term=y&utm_content=z&utm_id=1",
+       "https://a.test/p"},
+      {"https://a.test/p?fbclid=abc", "https://a.test/p"},
+      {"https://a.test/p?q=1&gclid=1&dclid=2&msclkid=3",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?gbraid=1&wbraid=2&q=1", "https://a.test/p?q=1"},
+      {"https://a.test/p?mc_eid=1&mc_cid=2&igshid=3&q=1",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?_hsenc=1&_hsmi=2&mkt_tok=3&q=1",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?yclid=4&twclid=5&ttclid=6&li_fat_id=7&q=1",
+       "https://a.test/p?q=1"},
+      {"https://x.com/p?ref_src=twsrc%5Etfw", "https://x.com/p"},
+      {"https://twitter.com/p?ref_src=twsrc%5Etfw", "https://twitter.com/p"},
+      // A name with no value is still a name.
+      {"https://a.test/p?fbclid&q=1", "https://a.test/p?q=1"},
+      {"https://a.test/p?q=1&fbclid", "https://a.test/p?q=1"},
+      // Plain http, a port, and a path-less address.
+      {"http://a.test:8080/p?gclid=1&q=1", "http://a.test:8080/p?q=1"},
+      {"https://a.test?utm_source=x", "https://a.test/"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, NamesAreMatchedWithoutRegardToCase) {
+  const Case kCases[] = {
+      {"https://a.test/p?UTM_Source=y&k=v", "https://a.test/p?k=v"},
+      {"https://a.test/p?Utm_Medium=y&k=v", "https://a.test/p?k=v"},
+      {"https://a.test/p?FBCLID=y&k=v", "https://a.test/p?k=v"},
+      {"https://a.test/p?GClid=y&k=v", "https://a.test/p?k=v"},
+      // The values keep their case.
+      {"https://a.test/p?K=V&utm_source=Y", "https://a.test/p?K=V"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, KeptParametersKeepTheirOrderAndEncodingByteForByte) {
+  const Case kCases[] = {
+      {"https://a.test/?z=1&utm_x=1&a=2", "https://a.test/?z=1&a=2"},
+      {"https://a.test/?b=%20x&utm_medium=m&a=1+2",
+       "https://a.test/?b=%20x&a=1+2"},
+      {"https://a.test/?q=a%20b&r=%2F&utm_source=x&s=%e2%82%ac",
+       "https://a.test/?q=a%20b&r=%2F&s=%e2%82%ac"},
+      {"https://a.test/?a=1&a=2&utm_source=x&a=3",
+       "https://a.test/?a=1&a=2&a=3"},
+      {"https://a.test/?k=v=w&utm_source=x", "https://a.test/?k=v=w"},
+      // A rewrite drops empty parts, so no stray `&` is left behind.
+      {"https://a.test/?a=1&&utm_x=1&b=2", "https://a.test/?a=1&b=2"},
+      {"https://a.test/?a=1&&utm_source=x", "https://a.test/?a=1"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, TheFragmentIsNeverTouched) {
+  const Case kCases[] = {
+      {"https://a.test/p?a=1&fbclid=x#frag", "https://a.test/p?a=1#frag"},
+      {"https://a.test/p?utm_source=1#utm_source=x&b=2",
+       "https://a.test/p#utm_source=x&b=2"},
+  };
+  ExpectCases(kCases);
+  const char* const kUnchanged[] = {
+      "https://a.test/p?a=1#utm_source=x",
+      "https://a.test/p#utm_source=x",
+      "https://a.test/p?a=1#?fbclid=x",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+TEST(CleanLinkTest, AnEmptiedQueryIsRemoved) {
+  const Case kCases[] = {
+      {"https://a.test/p?fbclid=abc", "https://a.test/p"},
+      {"https://a.test/p?utm_source=a&utm_medium=b", "https://a.test/p"},
+      {"https://a.test/p?utm_source=a&", "https://a.test/p"},
+      {"https://a.test/p?fbclid=abc#frag", "https://a.test/p#frag"},
+  };
+  ExpectCases(kCases);
+  EXPECT_FALSE(CleanLink(GURL("https://a.test/p?fbclid=abc")).has_query());
+}
+
+TEST(CleanLinkTest, TheShareIdIsOnlyTrackingOnItsSites) {
+  const Case kTracking[] = {
+      {"https://www.youtube.com/watch?v=abc&si=track",
+       "https://www.youtube.com/watch?v=abc"},
+      {"https://youtube.com/watch?si=track&v=abc",
+       "https://youtube.com/watch?v=abc"},
+      {"https://m.youtube.com/watch?v=abc&SI=track",
+       "https://m.youtube.com/watch?v=abc"},
+      {"https://youtu.be/abc?si=track", "https://youtu.be/abc"},
+      {"https://youtu.be/abc?t=30&si=track", "https://youtu.be/abc?t=30"},
+      {"https://music.youtube.com/watch?v=abc&si=track",
+       "https://music.youtube.com/watch?v=abc"},
+      {"https://open.spotify.com/track/1?si=track",
+       "https://open.spotify.com/track/1"},
+      {"https://www.instagram.com/p/abc/?igsh=track",
+       "https://www.instagram.com/p/abc/"},
+      {"https://instagram.com/p/abc/?igsh=track&hl=en",
+       "https://instagram.com/p/abc/?hl=en"},
+  };
+  ExpectCases(kTracking);
+  const char* const kKept[] = {
+      "https://example.com/p?si=keep",
+      "https://example.com/p?igsh=keep",
+      "https://www.spotify.com/p?si=keep",
+      "https://notyoutube.com/watch?si=keep",
+      "https://youtube.com.evil.test/watch?si=keep",
+      "https://notinstagram.com/p?igsh=keep",
+      // The other site's id doesn't count.
+      "https://www.instagram.com/p/abc/?si=keep",
+      "https://www.youtube.com/watch?igsh=keep",
+      "https://open.spotify.com/track/1?igsh=keep",
+  };
+  ExpectUnchanged(kKept);
+}
+
+TEST(CleanLinkTest, LooksLikeTrackingButIsNot) {
+  const char* const kUnchanged[] = {
+      "https://a.test/p?id=1",
+      "https://a.test/p?ref=home",
+      "https://a.test/p?source=newsletter",
+      "https://a.test/p?utm=1",
+      "https://a.test/p?utmsource=1",
+      "https://a.test/p?q=utm_source",
+      "https://a.test/p?q=utm_source%3Dx&fbclid_x=1",
+      "https://a.test/p?gclid_x=1",
+      "https://a.test/p?xgclid=1",
+      "https://a.test/p?my_utm_source=1",
+      "https://a.test/p?ref_srcs=1",
+      // ref_src is Twitter's; elsewhere it may be a working parameter.
+      "https://a.test/p?ref_src=twsrc%5Etfw",
+      "https://a.test/p?q=1&page=2",
+      "https://a.test/p?q=a%20b&r=%2F",
+      "https://a.test/p?si=keep",
+      // The name is compared as written, not decoded.
+      "https://a.test/p?utm%5Fsource=x",
+      "https://a.test/p?%75tm_source=x",
+      // Nothing was dropped, so nothing is rewritten.
+      "https://a.test/p?a=1&&b=2",
+      "https://a.test/p?&a=1&",
+      "https://a.test/p",
+      "https://a.test/p?",
+      "https://a.test/?",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+// Every name added beyond the plan's list is matched exactly, so working
+// parameters that only look like one stay. Several are real: Google
+// Calendar's `eid`, Yandex's `clid`, and the `cid` many shops use.
+TEST(CleanLinkTest, NamesNearTheAddedEntriesAreKept) {
+  const char* const kKept[] = {
+      // gbraid, wbraid.
+      "https://a.test/p?braid=1",
+      "https://a.test/p?gbraid_v=1",
+      // mc_cid, mc_eid.
+      "https://shop.test/p?cid=42",
+      "https://calendar.google.com/calendar/event?eid=abc",
+      "https://a.test/p?mc_cid_x=1",
+      // _hsmi.
+      "https://a.test/p?hsmi=1",
+      // yclid, twclid, ttclid.
+      "https://yandex.ru/search/?clid=123&text=a",
+      "https://a.test/p?tclid=1",
+      "https://a.test/p?yclid2=1",
+      // li_fat_id.
+      "https://www.linkedin.com/jobs/view/1?li=1",
+      "https://a.test/p?fat_id=1",
+      "https://a.test/p?li_fat=1",
+      // ref_src stays on hosts that only look like X or Twitter.
+      "https://box.com/p?ref_src=keep",
+      "https://x.com.evil.test/p?ref_src=keep",
+      "https://nottwitter.com/p?ref_src=keep",
+  };
+  ExpectUnchanged(kKept);
+}
+
+TEST(CleanLinkTest, OnlyWebAddressesAreTouched) {
+  const char* const kUnchanged[] = {
+      "mailto:a@b.test?utm_source=x&subject=hi",
+      "file:///tmp/a.html?utm_source=x",
+      "data:text/html,a?utm_source=x",
+      "chrome://settings/?utm_source=x",
+      "about:blank?utm_source=x",
+      "ftp://a.test/p?utm_source=x",
+      "blob:https://a.test/0000?utm_source=x",
+      "javascript:alert(1)?utm_source=x",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+TEST(CleanLinkTest, InvalidInputComesBackUnchanged) {
+  for (const char* spec : {"", "not a url", "https://", "http://[::1"}) {
+    SCOPED_TRACE(spec);
+    const GURL url(spec);
+    EXPECT_FALSE(url.is_valid());
+    const GURL cleaned = CleanLink(url);
+    EXPECT_FALSE(cleaned.is_valid());
+    EXPECT_EQ(url, cleaned);
+  }
+  EXPECT_FALSE(CleanLink(GURL()).is_valid());
+}
+
+}  // namespace
+}  // namespace rac

--- /dev/null
+++ src/chrome/browser/rac/power/third_party/ardia/group_name_unittest.cc
@@ -0,0 +1,166 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+//
+// Ported from Ardia's apps/browser/src/store/groupNames.ts
+// (https://github.com/mantrakp04/ardia, commit 4309c156) and changed by the
+// rac Authors: rewritten in C++, and HostLabel() uses the public suffix list.
+// Ardia
+// Copyright 2026 Mantra Patel
+// Licensed under the Apache License, Version 2.0
+// (https://www.apache.org/licenses/LICENSE-2.0).
+
+#include "chrome/browser/rac/power/third_party/ardia/group_name.h"
+
+#include <string>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+
+namespace {
+
+GroupNameMember Member(const char* url, const std::u16string& title = u"") {
+  return GroupNameMember{GURL(url), title};
+}
+
+std::u16string Name(const std::vector<GroupNameMember>& members) {
+  return AutoGroupName(members);
+}
+
+}  // namespace
+
+// Ardia: a group of pages on an IP address is named after the address, not one
+// of its numbers.
+TEST(GroupNameTest, IpAddressesKeepTheWholeAddress) {
+  EXPECT_EQ(u"127.0.0.1", Name({Member("http://127.0.0.1:9471/d")}));
+  EXPECT_EQ(u"[::1]", Name({Member("http://[::1]:8080/")}));
+  EXPECT_EQ("10.0.0.2", SiteKey(GURL("http://10.0.0.2/a")));
+  EXPECT_EQ(u"Bbc", Name({Member("https://news.bbc.co.uk/x")}));
+}
+
+TEST(GroupNameTest, EmptyListHasNoName) {
+  EXPECT_EQ(u"", Name({}));
+}
+
+// Three pull requests: the site is the last " · " piece of every title, and
+// the pages differ, so the name is the site alone.
+TEST(GroupNameTest, GitHubPullRequestsAreNamedGitHub) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://github.com/o/r/pull/1",
+             u"Fix the thing by someone · Pull Request #1 · o/r "
+             u"· GitHub"),
+      Member("https://github.com/o/r/pull/2",
+             u"Add another thing by someone · Pull Request #2 · o/r "
+             u"· GitHub"),
+      Member("https://github.com/o/r/pull/3",
+             u"Remove a thing by someone · Pull Request #3 · o/r "
+             u"· GitHub"),
+  };
+  EXPECT_EQ(u"GitHub", Name(members));
+  EXPECT_EQ(u"GitHub", SiteName(members));
+}
+
+// The same page in every tab adds the page to the site. The title's site
+// "Gmail" is not the host's name (google), but two titles agree on it.
+TEST(GroupNameTest, SamePageInEveryTabAddsThePage) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://mail.google.com/mail/u/0/#inbox", u"Inbox - Gmail"),
+      Member("https://mail.google.com/mail/u/0/#inbox", u"Inbox - Gmail"),
+  };
+  EXPECT_EQ(u"Gmail Inbox", Name(members));
+}
+
+// Here the site in the title matches the host's name, so one tab is enough.
+TEST(GroupNameTest, SamePageOnAHostNamedSite) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://example.com/pricing", u"Pricing | Example"),
+      Member("https://www.example.com/pricing", u"Pricing | Example"),
+  };
+  EXPECT_EQ(u"Example Pricing", Name(members));
+}
+
+// One tab whose title is not shaped like "page - site" and does not match
+// the host falls back to the host's name.
+TEST(GroupNameTest, OneTitleThatDoesNotMatchTheHostUsesTheHost) {
+  EXPECT_EQ(u"Google",
+            Name({Member("https://mail.google.com/", u"Inbox - Gmail")}));
+}
+
+TEST(GroupNameTest, DifferentPagesOfOneSiteGiveTheSite) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://www.youtube.com/watch?v=1", u"Cats - YouTube"),
+      Member("https://www.youtube.com/watch?v=2", u"Dogs - YouTube"),
+  };
+  EXPECT_EQ(u"YouTube", Name(members));
+}
+
+TEST(GroupNameTest, MixedSitesGiveTheFirstSite) {
+  const std::vector<GroupNameMember> members = {
+      Member("https://github.com/o/r", u"Repo · GitHub"),
+      Member("https://www.youtube.com/watch?v=1", u"Cats - YouTube"),
+  };
+  EXPECT_EQ(u"GitHub", Name(members));
+}
+
+// A first tab with no host and a title names the group after its title.
+TEST(GroupNameTest, FirstTabWithoutHostGivesItsTitle) {
+  const std::vector<GroupNameMember> members = {
+      Member("about:blank", u"New Tab"),
+      Member("https://github.com/o/r", u"Repo · GitHub"),
+  };
+  EXPECT_EQ(u"New Tab", Name(members));
+}
+
+TEST(GroupNameTest, UntitledTabsGiveTheTidyHost) {
+  EXPECT_EQ(u"Python", Name({Member("https://docs.python.org/3/")}));
+  EXPECT_EQ(u"Python", Name({Member("https://docs.python.org/3/"),
+                             Member("https://www.python.org/about/")}));
+}
+
+TEST(GroupNameTest, TitleEqualToTheUrlCountsAsUntitled) {
+  EXPECT_EQ(u"Python", Name({Member("https://docs.python.org/3/",
+                                    u"https://docs.python.org/3/")}));
+}
+
+TEST(GroupNameTest, NonAsciiTitles) {
+  // A separator in the title, with a different page in each tab.
+  const std::vector<GroupNameMember> different = {
+      Member("https://ja.wikipedia.org/wiki/a", u"東京 – Wikipedia"),
+      Member("https://ja.wikipedia.org/wiki/b", u"大阪 – Wikipedia"),
+  };
+  EXPECT_EQ(u"Wikipedia", Name(different));
+  // The same page in each tab: squash() drops the non-ASCII page when it
+  // compares it with the site, but the page itself is kept.
+  const std::vector<GroupNameMember> same = {
+      Member("https://ja.wikipedia.org/wiki/a", u"東京 – Wikipedia"),
+      Member("https://ja.wikipedia.org/wiki/b", u"東京 – Wikipedia"),
+  };
+  EXPECT_EQ(u"Wikipedia 東京", Name(same));
+  // No separator and nothing that looks like the host: the host's name.
+  EXPECT_EQ(u"Example", Name({Member("https://example.jp/", u"日本語")}));
+}
+
+TEST(GroupNameTest, PrivateRegistriesAreRespected) {
+  EXPECT_EQ(u"Me", Name({Member("https://me.github.io/")}));
+  EXPECT_EQ("me", SiteKey(GURL("https://me.github.io/")));
+}
+
+TEST(GroupNameTest, SiteKey) {
+  EXPECT_EQ("example", SiteKey(GURL("https://www.Example.COM/")));
+  EXPECT_EQ("bbc", SiteKey(GURL("https://news.bbc.co.uk/")));
+  EXPECT_EQ("[::1]", SiteKey(GURL("http://[::1]:8080/")));
+  EXPECT_EQ("localhost", SiteKey(GURL("http://localhost:3000/")));
+  EXPECT_EQ("", SiteKey(GURL("not a url")));
+}
+
+TEST(GroupNameTest, SiteNameUsesATitleThatIsJustTheHostName) {
+  EXPECT_EQ(u"EXAMPLE",
+            SiteName({Member("https://www.example.com/", u"EXAMPLE")}));
+  EXPECT_EQ(u"Example", SiteName({Member("https://www.example.com/")}));
+  EXPECT_EQ(u"", SiteName({}));
+}
+
+}  // namespace rac

Index: src/chrome/browser/rac/power/BUILD.gn
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/power/BUILD.gn
@@ -0,0 +1,41 @@
+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//testing/test.gni")
+
+# Pure logic for the power features: copying a clean link, writing a Markdown
+# link, and naming a tab group. Code taken from other projects sits in
+# third_party/, each with its README.chromium and LICENSE, so about:credits
+# lists it.
+source_set("power") {
+  sources = [
+    "markdown_link.cc",
+    "markdown_link.h",
+  ]
+  public_deps = [
+    "//base",
+    "//url",
+    "third_party/ardia",
+    "third_party/stedding",
+  ]
+}
+
+# Build with `autoninja -C out/Default
+# chrome/browser/rac/power:rac_power_unittests`. It also runs the SitePattern
+# tests, so one binary covers both. It's separate from Chromium's unit_tests,
+# which takes hours to build.
+test("rac_power_unittests") {
+  sources = [ "markdown_link_unittest.cc" ]
+  deps = [
+    ":power",
+    "third_party/ardia:unit_tests",
+    "third_party/stedding:unit_tests",
+    "//base",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+    "//chrome/browser/rac/site_pattern:unit_tests",
+    "//testing/gtest",
+    "//url",
+  ]
+}
Index: src/chrome/browser/rac/power/markdown_link.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/power/markdown_link.cc
@@ -0,0 +1,96 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/markdown_link.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rac/power/third_party/stedding/clean_link.h"
+
+namespace rac {
+
+namespace {
+
+// True when every `)` closes an earlier `(` and every `(` is closed.
+bool ParenthesesAreBalanced(std::string_view text) {
+  int depth = 0;
+  for (char c : text) {
+    if (c == '(') {
+      ++depth;
+    } else if (c == ')' && --depth < 0) {
+      return false;
+    }
+  }
+  return depth == 0;
+}
+
+std::u16string EscapeLabel(std::u16string_view label) {
+  std::u16string escaped;
+  escaped.reserve(label.size());
+  for (char16_t c : label) {
+    // A backtick could open a code span, which outranks the link.
+    if (c == u'\\' || c == u'[' || c == u']' || c == u'`') {
+      escaped.push_back(u'\\');
+    }
+    escaped.push_back(c);
+  }
+  return escaped;
+}
+
+std::u16string EscapeDestination(std::string_view spec) {
+  const bool escape_parentheses = !ParenthesesAreBalanced(spec);
+  std::u16string escaped;
+  escaped.reserve(spec.size());
+  for (char16_t c : base::UTF8ToUTF16(spec)) {
+    // GURL leaves a backslash or a backtick in a query as it was. Markdown
+    // would read the first as an escape and the second as a code span.
+    if (c == u'`') {
+      escaped += u"%60";
+      continue;
+    }
+    if (c == u'\\' || (escape_parentheses && (c == u'(' || c == u')'))) {
+      escaped.push_back(u'\\');
+    }
+    escaped.push_back(c);
+  }
+  return escaped;
+}
+
+}  // namespace
+
+std::u16string MarkdownLink(std::u16string_view title, const GURL& url) {
+  const GURL clean = CleanLink(url);
+  // GURL::spec() DCHECKs on an invalid URL.
+  const std::string_view spec =
+      clean.is_valid() ? std::string_view(clean.spec()) : std::string_view();
+
+  // A title that is just the address would put back what CleanLink() took
+  // out, so it counts as no title.
+  std::u16string label(title);
+  if (label == base::UTF8ToUTF16(url.possibly_invalid_spec())) {
+    label.clear();
+  }
+  base::ReplaceChars(label, u"\r\n", u" ", &label);
+  std::u16string_view trimmed = base::TrimWhitespace(label, base::TRIM_ALL);
+  std::u16string fallback;
+  if (trimmed.empty()) {
+    fallback = base::UTF8ToUTF16(clean.is_valid() ? clean.host() : "");
+    if (fallback.empty()) {
+      fallback = base::UTF8ToUTF16(spec);
+    }
+    trimmed = fallback;
+  }
+
+  std::u16string link = u"[";
+  link += EscapeLabel(trimmed);
+  link += u"](";
+  link += EscapeDestination(spec);
+  link += u")";
+  return link;
+}
+
+}  // namespace rac
Index: src/chrome/browser/rac/power/markdown_link.h
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/power/markdown_link.h
@@ -0,0 +1,34 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_POWER_MARKDOWN_LINK_H_
+#define CHROME_BROWSER_RAC_POWER_MARKDOWN_LINK_H_
+
+#include <string>
+#include <string_view>
+
+#include "url/gurl.h"
+
+namespace rac {
+
+// Returns `[label](destination)` for a page. Callers pass the page's own
+// title, or "" when it has none, never WebContents::GetTitle()'s fallback to
+// the address, which would carry the tracking parameters CleanLink() removes.
+// A title equal to `url`'s spec counts as none.
+//
+// The destination is CleanLink(`url`).spec(). The label is `title` with each
+// CR and LF turned into a space and the ends trimmed; when that leaves
+// nothing it falls back to the host and then to the spec. A backslash, `[`,
+// `]`, and a backtick in the label are backslash-escaped, so the label can't
+// end the link early or open a code span.
+//
+// In the destination, a backslash is backslash-escaped, a backtick becomes
+// `%60`, and `(` and `)` are backslash-escaped only when they are
+// unbalanced, so an address such as `https://en.wikipedia.org/wiki/Foo_(bar)`
+// stays readable. An invalid `url` has an empty destination: `[label]()`.
+std::u16string MarkdownLink(std::u16string_view title, const GURL& url);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_POWER_MARKDOWN_LINK_H_
Index: src/chrome/browser/rac/power/markdown_link_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/power/markdown_link_unittest.cc
@@ -0,0 +1,123 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/markdown_link.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+namespace {
+
+TEST(MarkdownLinkTest, TitleAndAddress) {
+  EXPECT_EQ(u"[Example Domain](https://example.com/)",
+            MarkdownLink(u"Example Domain", GURL("https://example.com")));
+  EXPECT_EQ(u"[A page](https://example.com/a/b?c=d#e)",
+            MarkdownLink(u"A page", GURL("https://example.com/a/b?c=d#e")));
+}
+
+TEST(MarkdownLinkTest, TheAddressIsCleaned) {
+  EXPECT_EQ(u"[T](https://x.com/a?id=3#c)",
+            MarkdownLink(u"T", GURL("https://x.com/a?utm_source=y&id=3#c")));
+  EXPECT_EQ(u"[T](https://x.com/a)",
+            MarkdownLink(u"T", GURL("https://x.com/a?fbclid=1")));
+}
+
+TEST(MarkdownLinkTest, TheLabelEscapesBracketsAndBackslashes) {
+  const GURL url("https://example.com/");
+  EXPECT_EQ(u"[a \\[b\\] c](https://example.com/)",
+            MarkdownLink(u"a [b] c", url));
+  EXPECT_EQ(u"[a\\\\b](https://example.com/)", MarkdownLink(u"a\\b", url));
+  EXPECT_EQ(u"[\\[\\[x\\]\\]](https://example.com/)",
+            MarkdownLink(u"[[x]]", url));
+  // Parentheses, and other Markdown characters, are left as they are.
+  EXPECT_EQ(u"[f(x) *y* _z_](https://example.com/)",
+            MarkdownLink(u"f(x) *y* _z_", url));
+}
+
+TEST(MarkdownLinkTest, LineBreaksInTheTitleBecomeSpaces) {
+  const GURL url("https://example.com/");
+  EXPECT_EQ(u"[a b](https://example.com/)", MarkdownLink(u"a\nb", url));
+  EXPECT_EQ(u"[a b](https://example.com/)", MarkdownLink(u"a\rb", url));
+  EXPECT_EQ(u"[a  b](https://example.com/)", MarkdownLink(u"a\r\nb", url));
+  // The ends are trimmed, including a break at either end.
+  EXPECT_EQ(u"[a](https://example.com/)", MarkdownLink(u"\n  a \r\n", url));
+}
+
+TEST(MarkdownLinkTest, ATitleWithNothingInItGivesTheHost) {
+  EXPECT_EQ(u"[example.com](https://example.com/p)",
+            MarkdownLink(u"", GURL("https://example.com/p")));
+  EXPECT_EQ(u"[example.com](https://example.com/p)",
+            MarkdownLink(u" \t\r\n ", GURL("https://example.com/p")));
+  EXPECT_EQ(u"[www.example.com](https://www.example.com/)",
+            MarkdownLink(u"", GURL("https://www.example.com")));
+  EXPECT_EQ(u"[192.168.0.1](http://192.168.0.1:8080/)",
+            MarkdownLink(u"", GURL("http://192.168.0.1:8080")));
+  // The host is escaped like any other label.
+  EXPECT_EQ(u"[\\[::1\\]](http://[::1]/)",
+            MarkdownLink(u"", GURL("http://[::1]/")));
+}
+
+TEST(MarkdownLinkTest, WithNoHostTheLabelIsTheAddress) {
+  EXPECT_EQ(u"[mailto:a@example.com](mailto:a@example.com)",
+            MarkdownLink(u"", GURL("mailto:a@example.com")));
+  EXPECT_EQ(u"[file:///tmp/a.txt](file:///tmp/a.txt)",
+            MarkdownLink(u"", GURL("file:///tmp/a.txt")));
+}
+
+TEST(MarkdownLinkTest, BalancedParenthesesStayReadable) {
+  EXPECT_EQ(
+      u"[Foo](https://en.wikipedia.org/wiki/Foo_(bar))",
+      MarkdownLink(u"Foo", GURL("https://en.wikipedia.org/wiki/Foo_(bar)")));
+  EXPECT_EQ(u"[F](https://x.test/a_(b)_(c(d)))",
+            MarkdownLink(u"F", GURL("https://x.test/a_(b)_(c(d))")));
+  EXPECT_EQ(u"[F](https://x.test/p?q=(1)&r=2)",
+            MarkdownLink(u"F", GURL("https://x.test/p?q=(1)&r=2")));
+}
+
+TEST(MarkdownLinkTest, UnbalancedParenthesesAreEscaped) {
+  EXPECT_EQ(u"[F](https://x.test/a\\)b)",
+            MarkdownLink(u"F", GURL("https://x.test/a)b")));
+  EXPECT_EQ(u"[F](https://x.test/a\\(b)",
+            MarkdownLink(u"F", GURL("https://x.test/a(b")));
+  // A close before its open is unbalanced even when the counts are equal.
+  EXPECT_EQ(u"[F](https://x.test/\\)a\\()",
+            MarkdownLink(u"F", GURL("https://x.test/)a(")));
+  // Every parenthesis is escaped, the matched pair included.
+  EXPECT_EQ(u"[F](https://x.test/\\(a\\)\\))",
+            MarkdownLink(u"F", GURL("https://x.test/(a))")));
+}
+
+TEST(MarkdownLinkTest, ParenthesesAreCountedAfterTheAddressIsCleaned) {
+  // The tracking parameter holds the stray parenthesis, so nothing is left
+  // to escape once it is dropped.
+  EXPECT_EQ(u"[F](https://x.test/a_(b))",
+            MarkdownLink(u"F", GURL("https://x.test/a_(b)?fbclid=)")));
+}
+
+TEST(MarkdownLinkTest, ATitleThatIsTheAddressCountsAsNone) {
+  const GURL url("https://x.com/a?utm_source=y&id=3");
+  EXPECT_EQ(u"[x.com](https://x.com/a?id=3)",
+            MarkdownLink(u"https://x.com/a?utm_source=y&id=3", url));
+}
+
+TEST(MarkdownLinkTest, BackticksCannotOpenACodeSpan) {
+  EXPECT_EQ(u"[Use \\` here](https://x.test/?q=%60a)",
+            MarkdownLink(u"Use ` here", GURL("https://x.test/?q=`a")));
+}
+
+TEST(MarkdownLinkTest, ABackslashInTheAddressIsEscaped) {
+  EXPECT_EQ(u"[F](https://x.test/?q=a\\\\_b)",
+            MarkdownLink(u"F", GURL("https://x.test/?q=a\\_b")));
+  EXPECT_EQ(u"[F](https://x.test/?q=a\\\\\\(b)",
+            MarkdownLink(u"F", GURL("https://x.test/?q=a\\(b")));
+}
+
+TEST(MarkdownLinkTest, AnInvalidAddressGivesAnEmptyDestination) {
+  EXPECT_EQ(u"[T]()", MarkdownLink(u"T", GURL()));
+  EXPECT_EQ(u"[]()", MarkdownLink(u"", GURL("not a url")));
+}
+
+}  // namespace
+}  // namespace rac

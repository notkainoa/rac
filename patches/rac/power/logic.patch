+// AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+// IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+// ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE
+// LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+// CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+// SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+// INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+// CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+// ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+// POSSIBILITY OF SUCH DAMAGE.
+
+#include "chrome/browser/rac/power/third_party/stedding/clean_link.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace rac {
+
+namespace {
+
+// A parameter is dropped when its lower-cased name matches an entry exactly,
+// or starts with an entry that ends in "_" (the utm_ family).
+constexpr std::string_view kTrackingParameters[] = {
+    "utm_",    "fbclid", "gclid",  "dclid",  "gbraid",    "wbraid",
+    "msclkid", "mc_eid", "mc_cid", "igshid", "_hsenc",    "_hsmi",
+    "mkt_tok", "yclid",  "twclid", "ttclid", "li_fat_id",
+};
+
+// Parameters that track only on one site. `domain` matches the host and its
+// subdomains.
+struct SiteParameter {
+  std::string_view name;
+  std::string_view domain;
+};
+constexpr SiteParameter kSiteParameters[] = {
+    {"si", "youtube.com"},      {"si", "youtu.be"},
+    {"si", "open.spotify.com"}, {"igsh", "instagram.com"},
+    {"ref_src", "twitter.com"}, {"ref_src", "x.com"},
+};
+
+bool IsTracking(std::string_view raw_name, const GURL& url) {
+  const std::string name = base::ToLowerASCII(raw_name);
+  for (std::string_view entry : kTrackingParameters) {
+    if (entry.back() == '_' ? base::StartsWith(name, entry) : name == entry) {
+      return true;
+    }
+  }
+  for (const SiteParameter& entry : kSiteParameters) {
+    if (name == entry.name && url.DomainIs(entry.domain)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+GURL CleanLink(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_query()) {
+    return url;
+  }
+  // Work on the raw query so what survives keeps its encoding byte for byte.
+  // Empty parts (`a=1&&b=2`) carry nothing, so a rewrite drops them.
+  std::vector<std::string_view> kept;
+  bool changed = false;
+  for (std::string_view part :
+       base::SplitStringPiece(url.query(), "&", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    const std::string_view name = part.substr(0, part.find('='));
+    if (IsTracking(name, url)) {
+      changed = true;
+    } else {
+      kept.push_back(part);
+    }
+  }
+  if (!changed) {
+    return url;
+  }
+  GURL::Replacements replacements;
+  const std::string query = base::JoinString(kept, "&");
+  if (query.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+}  // namespace rac

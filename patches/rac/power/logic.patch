--- /dev/null
+++ src/chrome/browser/rac/power/third_party/ardia/group_name.cc
@@ -0,0 +1,324 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+//
+// Ported from Ardia's apps/browser/src/store/groupNames.ts
+// (https://github.com/mantrakp04/ardia, commit 4309c156) and changed by the
+// rac Authors: rewritten in C++, and HostLabel() uses the public suffix list.
+// Ardia
+// Copyright 2026 Mantra Patel
+// Licensed under the Apache License, Version 2.0
+// (https://www.apache.org/licenses/LICENSE-2.0).
+
+#include "chrome/browser/rac/power/third_party/ardia/group_name.h"
+
+#include <algorithm>
+#include <array>
+#include <map>
+#include <optional>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+
+namespace rac {
+
+namespace {
+
+constexpr std::array<std::u16string_view, 8> kSeparators = {
+    u" / ", u" | ", u" - ", u" — ", u" – ", u" · ", u" • ", u" :: ",
+};
+
+using TitleEnd = std::pair<std::u16string, std::u16string>;
+
+// The text a title is compared with to see whether it is just the URL.
+std::u16string UrlText(const GURL& url) {
+  return base::UTF8ToUTF16(url.possibly_invalid_spec());
+}
+
+// A tab with a title of its own, not empty and not the URL.
+bool IsTitled(const GroupNameMember& member) {
+  return !member.title.empty() && member.title != UrlText(member.url);
+}
+
+// JS `trim()`.
+std::u16string Trim(std::u16string_view text) {
+  return std::u16string(base::TrimWhitespace(text, base::TRIM_ALL));
+}
+
+std::string HostOf(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  std::string_view host = url.host();
+  if (host.starts_with("www.")) {
+    host.remove_prefix(4);
+  }
+  return std::string(host);
+}
+
+// Lowercases and keeps only the ASCII letters and digits.
+std::u16string Squash(std::u16string_view text) {
+  std::u16string out;
+  for (char16_t c : text) {
+    if (base::IsAsciiAlpha(c) || base::IsAsciiDigit(c)) {
+      out.push_back(base::ToLowerASCII(c));
+    }
+  }
+  return out;
+}
+
+// `^\d{1,3}(\.\d{1,3}){3}$`, or an IPv6 host, which GURL keeps in brackets.
+bool IsIpAddress(std::string_view host) {
+  if (host.starts_with('[')) {
+    return true;
+  }
+  const std::vector<std::string_view> parts = base::SplitStringPiece(
+      host, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 4) {
+    return false;
+  }
+  return std::ranges::all_of(parts, [](std::string_view part) {
+    return part.size() >= 1 && part.size() <= 3 &&
+           std::ranges::all_of(part,
+                               [](char c) { return base::IsAsciiDigit(c); });
+  });
+}
+
+// The name part of a host, from the public suffix list: "bbc" for
+// news.bbc.co.uk and "me" for me.github.io. Ardia guessed from label lengths;
+// that guess is the fallback when the list has no answer.
+std::string HostLabel(std::string_view host) {
+  if (IsIpAddress(host)) {
+    return std::string(host);
+  }
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          host, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  const std::string label = domain.substr(0, domain.find('.'));
+  if (!label.empty()) {
+    return label;
+  }
+  const std::vector<std::string_view> parts = base::SplitStringPiece(
+      host, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.size() < 2) {
+    return parts.empty() ? std::string() : std::string(parts[0]);
+  }
+  const std::string_view second = parts[parts.size() - 2];
+  return std::string(parts.size() > 2 && second.size() <= 3 &&
+                             parts.back().size() <= 2
+                         ? parts[parts.size() - 3]
+                         : second);
+}
+
+std::u16string TidyHost(std::string_view host) {
+  std::string label = HostLabel(host);
+  if (label.empty()) {
+    return std::u16string();
+  }
+  label[0] = base::ToUpperASCII(label[0]);
+  return base::UTF8ToUTF16(label);
+}
+
+// Splits `title` at each separator, once at the last occurrence and once at
+// the first, as (site, page) pairs, where the site is the text beyond the
+// separator. Pairs with an empty side are dropped.
+std::vector<TitleEnd> Ends(std::u16string_view title) {
+  std::vector<TitleEnd> out;
+  for (std::u16string_view sep : kSeparators) {
+    const size_t last = title.rfind(sep);
+    if (last != std::u16string_view::npos && last > 0) {
+      out.emplace_back(Trim(title.substr(last + sep.size())),
+                       Trim(title.substr(0, last)));
+    }
+    const size_t first = title.find(sep);
+    if (first != std::u16string_view::npos && first > 0) {
+      out.emplace_back(Trim(title.substr(0, first)),
+                       Trim(title.substr(first + sep.size())));
+    }
+  }
+  std::erase_if(out, [](const TitleEnd& end) {
+    return end.first.empty() || end.second.empty();
+  });
+  return out;
+}
+
+// Whether `site` is the site end of some split of every title, given each
+// title's Ends().
+bool EveryTitleEndsWith(const std::vector<std::vector<TitleEnd>>& ends,
+                        const std::u16string& site) {
+  return std::ranges::all_of(ends, [&site](const std::vector<TitleEnd>& e) {
+    return std::ranges::any_of(
+        e, [&site](const TitleEnd& end) { return end.first == site; });
+  });
+}
+
+// A site name that all of `titles` (from one host, at least one) end or begin
+// with, such as "GitHub" for "Fix it · Pull Request #1 · o/r · GitHub".
+std::optional<std::u16string> SiteFromTitles(
+    std::string_view host,
+    const std::vector<std::u16string>& titles) {
+  const std::u16string label = Squash(base::UTF8ToUTF16(HostLabel(host)));
+  auto looks_like_host = [&label](const std::u16string& site) {
+    const std::u16string s = Squash(site);
+    return !s.empty() && !label.empty() &&
+           (s == label || (s.size() >= 3 && (label.find(s) != label.npos ||
+                                             s.find(label) != s.npos)));
+  };
+  // Split each title once. Pages set their own titles, so a long one must not
+  // be split again for every candidate.
+  std::vector<std::vector<TitleEnd>> ends;
+  ends.reserve(titles.size());
+  for (const std::u16string& title : titles) {
+    ends.push_back(Ends(title));
+  }
+  for (const TitleEnd& end : ends[0]) {
+    const std::u16string& site = end.first;
+    // `site.split(" ").length <= 3`: pieces split on single spaces.
+    const size_t words = std::ranges::count(site, u' ') + 1;
+    if (words <= 3 && looks_like_host(site) && EveryTitleEndsWith(ends, site)) {
+      return site;
+    }
+  }
+  if (titles.size() < 2) {
+    return std::nullopt;
+  }
+  for (const TitleEnd& end : ends[0]) {
+    if (EveryTitleEndsWith(ends, end.first)) {
+      return end.first;
+    }
+  }
+  return std::nullopt;
+}
+
+// The title without its site. An empty `site` stands for no site.
+std::u16string PageOf(const std::u16string& title, const std::u16string& site) {
+  if (site.empty()) {
+    return Trim(title);
+  }
+  for (const TitleEnd& end : Ends(title)) {
+    if (end.first == site) {
+      return end.second;
+    }
+  }
+  return Trim(title);
+}
+
+}  // namespace
+
+std::string SiteKey(const GURL& url) {
+  return base::ToLowerASCII(HostLabel(HostOf(url)));
+}
+
+std::u16string SiteName(base::span<const GroupNameMember> members) {
+  std::string host;
+  for (const GroupNameMember& member : members) {
+    host = HostOf(member.url);
+    if (!host.empty()) {
+      break;
+    }
+  }
+  std::vector<std::u16string> titles;
+  for (const GroupNameMember& member : members) {
+    if (IsTitled(member)) {
+      titles.push_back(member.title);
+    }
+  }
+  const std::u16string label = Squash(base::UTF8ToUTF16(HostLabel(host)));
+  std::optional<std::u16string> titled_like_host;
+  if (!label.empty()) {
+    for (const std::u16string& title : titles) {
+      if (Squash(title) == label) {
+        titled_like_host = Trim(title);
+        break;
+      }
+    }
+  }
+  std::optional<std::u16string> from_titles;
+  if (!titles.empty()) {
+    from_titles = SiteFromTitles(host, titles);
+  }
+  if (from_titles) {
+    return *from_titles;
+  }
+  if (titled_like_host) {
+    return *titled_like_host;
+  }
+  return TidyHost(host);
+}
+
+std::u16string AutoGroupName(base::span<const GroupNameMember> members) {
+  if (members.empty()) {
+    return std::u16string();
+  }
+  std::vector<std::string> hosts;
+  for (const GroupNameMember& member : members) {
+    hosts.push_back(HostOf(member.url));
+  }
+  std::map<std::string, std::vector<std::u16string>> titled_by_host;
+  std::map<std::string, const GroupNameMember*> loaded_by_url;
+  for (size_t i = 0; i < members.size(); ++i) {
+    const GroupNameMember& member = members[i];
+    if (!IsTitled(member)) {
+      continue;
+    }
+    titled_by_host[hosts[i]].push_back(member.title);
+    loaded_by_url.emplace(member.url.possibly_invalid_spec(), &member);
+  }
+  std::map<std::string, std::u16string> site_of_host;
+  for (const std::string& host : hosts) {
+    if (site_of_host.contains(host)) {
+      continue;
+    }
+    std::optional<std::u16string> site;
+    auto titles = titled_by_host.find(host);
+    if (titles != titled_by_host.end()) {
+      site = SiteFromTitles(host, titles->second);
+    }
+    site_of_host[host] = site ? *site : TidyHost(host);
+  }
+  const std::u16string site = site_of_host[hosts[0]];
+  const bool one_site = std::ranges::all_of(
+      hosts, [&](const std::string& h) { return site_of_host[h] == site; });
+  if (site.empty() || !one_site) {
+    return site.empty() ? members[0].title : site;
+  }
+  // The site only counts as part of the titles if some title has it to remove.
+  const bool site_in_titles =
+      std::ranges::any_of(members, [&site](const GroupNameMember& member) {
+        return !member.title.empty() &&
+               PageOf(member.title, site) != Trim(member.title);
+      });
+  const std::u16string title_site = site_in_titles ? site : std::u16string();
+  std::vector<std::optional<std::u16string>> pages;
+  for (const GroupNameMember& member : members) {
+    const GroupNameMember* loaded = nullptr;
+    if (IsTitled(member)) {
+      loaded = &member;
+    } else {
+      auto it = loaded_by_url.find(member.url.possibly_invalid_spec());
+      if (it != loaded_by_url.end()) {
+        loaded = it->second;
+      }
+    }
+    pages.push_back(loaded ? std::optional<std::u16string>(
+                                 PageOf(loaded->title, title_site))
+                           : std::nullopt);
+  }
+  const std::optional<std::u16string>& page = pages[0];
+  if (title_site.empty() || !page || page->empty() ||
+      std::ranges::any_of(pages,
+                          [&page](const std::optional<std::u16string>& p) {
+                            return p != page;
+                          }) ||
+      Squash(*page) == Squash(site)) {
+    return site;
+  }
+  return site + u" " + *page;
+}
+
+}  // namespace rac

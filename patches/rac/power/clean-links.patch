+// CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+// ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+// POSSIBILITY OF SUCH DAMAGE.
+
+#include "chrome/browser/rac/power/third_party/stedding/clean_link.h"
+
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/i18n/icu_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+namespace {
+
+struct Case {
+  const char* in;
+  const char* out;
+};
+
+void ExpectCases(base::span<const Case> cases) {
+  for (const Case& row : cases) {
+    SCOPED_TRACE(row.in);
+    EXPECT_EQ(row.out, CleanLink(GURL(row.in)).spec());
+  }
+}
+
+void ExpectUnchanged(base::span<const char* const> specs) {
+  for (const char* spec : specs) {
+    SCOPED_TRACE(spec);
+    const GURL url(spec);
+    EXPECT_EQ(url, CleanLink(url));
+    EXPECT_EQ(url.spec(), CleanLink(url).spec());
+  }
+}
+
+TEST(CleanLinkTest, DropsTheAcceptanceCaseParameter) {
+  EXPECT_EQ("https://x.com/a?id=3#c",
+            CleanLink(GURL("https://x.com/a?utm_source=y&id=3#c")).spec());
+}
+
+TEST(CleanLinkTest, DropsEveryFamilyInTheTable) {
+  const Case kCases[] = {
+      {"https://a.test/p?utm_source=x&utm_medium=y&q=1",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?utm_campaign=x&utm_term=y&utm_content=z&utm_id=1",
+       "https://a.test/p"},
+      {"https://a.test/p?fbclid=abc", "https://a.test/p"},
+      {"https://a.test/p?q=1&gclid=1&dclid=2&msclkid=3",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?gbraid=1&wbraid=2&q=1", "https://a.test/p?q=1"},
+      {"https://a.test/p?mc_eid=1&mc_cid=2&igshid=3&q=1",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?_hsenc=1&_hsmi=2&mkt_tok=3&q=1",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?yclid=4&twclid=5&ttclid=6&li_fat_id=7&q=1",
+       "https://a.test/p?q=1"},
+      // Google's cross-domain linker parameters.
+      {"https://a.test/p?_ga=1&_gl=2&q=1", "https://a.test/p?q=1"},
+      {"https://x.com/p?ref_src=twsrc%5Etfw", "https://x.com/p"},
+      {"https://twitter.com/p?ref_src=twsrc%5Etfw", "https://twitter.com/p"},
+      // A name with no value is still a name.
+      {"https://a.test/p?fbclid&q=1", "https://a.test/p?q=1"},
+      {"https://a.test/p?q=1&fbclid", "https://a.test/p?q=1"},
+      // Plain http, a port, and a path-less address.
+      {"http://a.test:8080/p?gclid=1&q=1", "http://a.test:8080/p?q=1"},
+      {"https://a.test?utm_source=x", "https://a.test/"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, NamesAreMatchedWithoutRegardToCase) {
+  const Case kCases[] = {
+      {"https://a.test/p?UTM_Source=y&k=v", "https://a.test/p?k=v"},
+      {"https://a.test/p?Utm_Medium=y&k=v", "https://a.test/p?k=v"},
+      {"https://a.test/p?FBCLID=y&k=v", "https://a.test/p?k=v"},
+      {"https://a.test/p?GClid=y&k=v", "https://a.test/p?k=v"},
+      // The values keep their case.
+      {"https://a.test/p?K=V&utm_source=Y", "https://a.test/p?K=V"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, KeptParametersKeepTheirOrderAndEncodingByteForByte) {
+  const Case kCases[] = {
+      {"https://a.test/?z=1&utm_x=1&a=2", "https://a.test/?z=1&a=2"},
+      {"https://a.test/?b=%20x&utm_medium=m&a=1+2",
+       "https://a.test/?b=%20x&a=1+2"},
+      {"https://a.test/?q=a%20b&r=%2F&utm_source=x&s=%e2%82%ac",
+       "https://a.test/?q=a%20b&r=%2F&s=%e2%82%ac"},
+      // A truncated escape stays byte-exact: "%" is a query character and
+      // passes canonicalization untouched.
+      {"https://a.test/?q=%2&utm_source=x", "https://a.test/?q=%2"},
+      {"https://a.test/?a=1&a=2&utm_source=x&a=3",
+       "https://a.test/?a=1&a=2&a=3"},
+      {"https://a.test/?k=v=w&utm_source=x", "https://a.test/?k=v=w"},
+      // A rewrite drops empty parts, so no stray `&` is left behind.
+      {"https://a.test/?a=1&&utm_x=1&b=2", "https://a.test/?a=1&b=2"},
+      {"https://a.test/?a=1&&utm_source=x", "https://a.test/?a=1"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, TheFragmentIsNeverTouched) {
+  const Case kCases[] = {
+      {"https://a.test/p?a=1&fbclid=x#frag", "https://a.test/p?a=1#frag"},
+      {"https://a.test/p?utm_source=1#utm_source=x&b=2",
+       "https://a.test/p#utm_source=x&b=2"},
+  };
+  ExpectCases(kCases);
+  const char* const kUnchanged[] = {
+      "https://a.test/p?a=1#utm_source=x",
+      "https://a.test/p#utm_source=x",
+      "https://a.test/p?a=1#?fbclid=x",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+TEST(CleanLinkTest, AnEmptiedQueryIsRemoved) {
+  const Case kCases[] = {
+      {"https://a.test/p?fbclid=abc", "https://a.test/p"},
+      {"https://a.test/p?utm_source=a&utm_medium=b", "https://a.test/p"},
+      {"https://a.test/p?utm_source=a&", "https://a.test/p"},
+      {"https://a.test/p?fbclid=abc#frag", "https://a.test/p#frag"},
+  };
+  ExpectCases(kCases);
+  EXPECT_FALSE(CleanLink(GURL("https://a.test/p?fbclid=abc")).has_query());
+}
+
+TEST(CleanLinkTest, TheShareIdIsOnlyTrackingOnItsSites) {
+  const Case kTracking[] = {
+      {"https://www.youtube.com/watch?v=abc&si=track",
+       "https://www.youtube.com/watch?v=abc"},
+      {"https://youtube.com/watch?si=track&v=abc",
+       "https://youtube.com/watch?v=abc"},
+      {"https://m.youtube.com/watch?v=abc&SI=track",
+       "https://m.youtube.com/watch?v=abc"},
+      {"https://youtu.be/abc?si=track", "https://youtu.be/abc"},
+      {"https://youtu.be/abc?t=30&si=track", "https://youtu.be/abc?t=30"},
+      {"https://music.youtube.com/watch?v=abc&si=track",
+       "https://music.youtube.com/watch?v=abc"},
+      {"https://www.youtube.com/watch?v=x&si=t&pp=abc",
+       "https://www.youtube.com/watch?v=x&pp=abc"},
+      {"https://www.youtube-nocookie.com/embed/abc?si=track",
+       "https://www.youtube-nocookie.com/embed/abc"},
+      {"https://www.facebook.com/p/1?mibextid=track",
+       "https://www.facebook.com/p/1"},
+      {"https://m.facebook.com/p/1?mibextid=track&q=1",
+       "https://m.facebook.com/p/1?q=1"},
+      {"https://open.spotify.com/track/1?si=track",
+       "https://open.spotify.com/track/1"},
+      {"https://www.instagram.com/p/abc/?igsh=track",
+       "https://www.instagram.com/p/abc/"},
+      {"https://instagram.com/p/abc/?igsh=track&hl=en",
+       "https://instagram.com/p/abc/?hl=en"},
+  };
+  ExpectCases(kTracking);
+  const char* const kKept[] = {
+      "https://example.com/p?si=keep",
+      "https://example.com/p?igsh=keep",
+      "https://www.spotify.com/p?si=keep",
+      "https://notyoutube.com/watch?si=keep",
+      "https://youtube.com.evil.test/watch?si=keep",
+      "https://notinstagram.com/p?igsh=keep",
+      // The other site's id doesn't count.
+      "https://www.instagram.com/p/abc/?si=keep",
+      "https://www.youtube.com/watch?igsh=keep",
+      "https://open.spotify.com/track/1?igsh=keep",
+      "https://example.com/p?mibextid=keep",
+      "https://notfacebook.com/p?mibextid=keep",
+  };
+  ExpectUnchanged(kKept);
+}
+
+TEST(CleanLinkTest, LooksLikeTrackingButIsNot) {
+  const char* const kUnchanged[] = {
+      "https://a.test/p?id=1",
+      "https://a.test/p?ref=home",
+      "https://a.test/p?source=newsletter",
+      "https://a.test/p?utm=1",
+      "https://a.test/p?utmsource=1",
+      "https://a.test/p?q=utm_source",
+      "https://a.test/p?q=utm_source%3Dx&fbclid_x=1",
+      "https://a.test/p?gclid_x=1",
+      "https://a.test/p?xgclid=1",
+      "https://a.test/p?my_utm_source=1",
+      "https://a.test/p?ref_srcs=1",
+      // ref_src is Twitter's; elsewhere it may be a working parameter.
+      "https://a.test/p?ref_src=twsrc%5Etfw",
+      "https://a.test/p?q=1&page=2",
+      "https://a.test/p?q=a%20b&r=%2F",
+      "https://a.test/p?si=keep",
+      // The name is compared as written, not decoded.
+      "https://a.test/p?utm%5Fsource=x",
+      "https://a.test/p?%75tm_source=x",
+      // Tracking text in the path is not a parameter.
+      "https://a.test/utm_source=x/?q=1",
+      "https://a.test/p/fbclid=1",
+      // Nothing was dropped, so nothing is rewritten.
+      "https://a.test/p?a=1&&b=2",
+      "https://a.test/p?&a=1&",
+      "https://a.test/p",
+      "https://a.test/p?",
+      "https://a.test/?",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+// Every name added beyond the plan's list is matched exactly, so working
+// parameters that only look like one stay. Several are real: Google
+// Calendar's `eid`, Yandex's `clid`, and the `cid` many shops use.
+TEST(CleanLinkTest, NamesNearTheAddedEntriesAreKept) {
+  const char* const kKept[] = {
+      // gbraid, wbraid.
+      "https://a.test/p?braid=1",
+      "https://a.test/p?gbraid_v=1",
+      // mc_cid, mc_eid.
+      "https://shop.test/p?cid=42",
+      "https://calendar.google.com/calendar/event?eid=abc",
+      "https://a.test/p?mc_cid_x=1",
+      // _hsmi.
+      "https://a.test/p?hsmi=1",
+      // yclid, twclid, ttclid.
+      "https://yandex.ru/search/?clid=123&text=a",
+      "https://a.test/p?tclid=1",
+      "https://a.test/p?yclid2=1",
+      // li_fat_id.
+      "https://www.linkedin.com/jobs/view/1?li=1",
+      "https://a.test/p?fat_id=1",
+      "https://a.test/p?li_fat=1",
+      // ref_src stays on hosts that only look like X or Twitter.
+      "https://box.com/p?ref_src=keep",
+      "https://x.com.evil.test/p?ref_src=keep",
+      "https://nottwitter.com/p?ref_src=keep",
+      // _ga and _gl are exact names: look-alike and working parameters stay.
+      "https://a.test/p?ga=1",
+      "https://a.test/p?gl=us",
+      "https://a.test/p?_gal=1",
+      // spm was considered and left out: sites use it for real content.
+      "https://a.test/p?spm=a2.1",
+  };
+  ExpectUnchanged(kKept);
+}
+
+TEST(CleanLinkTest, OnlyWebAddressesAreTouched) {
+  const char* const kUnchanged[] = {
+      "mailto:a@b.test?utm_source=x&subject=hi",
+      "file:///tmp/a.html?utm_source=x",
+      "data:text/html,a?utm_source=x",
+      "chrome://settings/?utm_source=x",
+      "about:blank?utm_source=x",
+      "ftp://a.test/p?utm_source=x",
+      "ws://a.test/p?utm_source=x",
+      "wss://a.test/p?utm_source=x",
+      "blob:https://a.test/0000?utm_source=x",
+      "javascript:alert(1)?utm_source=x",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+TEST(CleanLinkTest, InvalidInputComesBackUnchanged) {
+  for (const char* spec : {"", "not a url", "https://", "http://[::1"}) {
+    SCOPED_TRACE(spec);
+    const GURL url(spec);
+    EXPECT_FALSE(url.is_valid());
+    const GURL cleaned = CleanLink(url);
+    EXPECT_FALSE(cleaned.is_valid());
+    EXPECT_EQ(url, cleaned);
+  }
+  EXPECT_FALSE(CleanLink(GURL()).is_valid());
+}
+
+// The share sites match on any subdomain, and GURL::DomainIs ignores a
+// host's trailing dot, but only ever on a label boundary.
+TEST(CleanLinkTest, SiteIdsApplyToSubdomainsAndTrailingDots) {
+  const Case kCases[] = {
+      {"https://a.b.youtube.com/watch?si=t&v=1",
+       "https://a.b.youtube.com/watch?v=1"},
+      {"https://www.youtu.be/v/abc?si=t", "https://www.youtu.be/v/abc"},
+      {"https://a.open.spotify.com/track/1?si=t",
+       "https://a.open.spotify.com/track/1"},
+      {"https://de.instagram.com/p/abc/?igsh=t",
+       "https://de.instagram.com/p/abc/"},
+      {"https://m.twitter.com/p?ref_src=t", "https://m.twitter.com/p"},
+      {"https://www.x.com/p?ref_src=t", "https://www.x.com/p"},
+      // A trailing dot doesn't hide the domain.
+      {"https://youtube.com./watch?si=t&v=1", "https://youtube.com./watch?v=1"},
+      {"https://open.spotify.com./track/1?si=t",
+       "https://open.spotify.com./track/1"},
+      {"https://x.com./p?ref_src=t", "https://x.com./p"},
+      // A global name doesn't care what the host looks like.
+      {"https://a.test./p?utm_source=x", "https://a.test./p"},
+  };
+  ExpectCases(kCases);
+  const char* const kKept[] = {
+      "https://instagram.com.evil.test/p/abc/?igsh=keep",
+      "https://youtu.be.evil.test/v/abc?si=keep",
+      "https://open.spotify.com.evil.test/track/1?si=keep",
+      // "ax.com" ends in "x.com" but not on a label boundary.
+      "https://ax.com/p?ref_src=keep",
+  };
+  ExpectUnchanged(kKept);
+}
+
+// GURL lowercases the scheme and host before CleanLink sees them.
+TEST(CleanLinkTest, SiteIdsMatchHostsCanonicalizedToLowercase) {
+  const Case kCases[] = {
+      {"HTTPS://WWW.YOUTUBE.COM/Watch?si=t&v=abc",
+       "https://www.youtube.com/Watch?v=abc"},
+      {"https://Open.Spotify.COM/track/1?si=t",
+       "https://open.spotify.com/track/1"},
+      {"https://WWW.INSTAGRAM.COM/p/abc/?igsh=t&hl=en",
+       "https://www.instagram.com/p/abc/?hl=en"},
+      {"https://A.TEST/p?utm_source=x", "https://a.test/p"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, UserinfoPortsAndIpv6HostsArePreserved) {
+  const Case kCases[] = {
+      {"https://user:pass@a.test/p?utm_source=x&q=1",
+       "https://user:pass@a.test/p?q=1"},
+      {"https://a.test:8443/p?utm_source=x&q=1", "https://a.test:8443/p?q=1"},
+      // 443 is https's default port, so canonicalization drops it.
+      {"https://a.test:443/p?utm_source=x", "https://a.test/p"},
+      {"https://[2001:db8::1]/p?gclid=1&k=v", "https://[2001:db8::1]/p?k=v"},
+      // A site id still applies on its site with userinfo and a port.
+      {"https://u@youtube.com:8443/watch?si=t&v=1",
+       "https://u@youtube.com:8443/watch?v=1"},
+  };
+  ExpectCases(kCases);
+  const char* const kUnchanged[] = {
+      // Tracking-looking text in the userinfo is not a parameter.
+      "https://utm_source:x@a.test/p?q=1",
+      // An IP host is no site's domain, so the site ids stay.
+      "https://[2001:db8::1]/p?si=keep",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+// An IDN host canonicalizes to punycode before CleanLink sees the spec.
+TEST(CleanLinkTest, IdnHostsAreCanonicalizedFirst) {
+  // IDN canonicalization needs ICU's data. base::TestSuite loads it in the
+  // real binary; this also covers a plain gtest main.
+  base::i18n::AllowMultipleInitializeCallsForTesting();
+  ASSERT_TRUE(base::i18n::InitializeICU());
+  const Case kCases[] = {
+      // "bücher" and "münchen".
+      {"https://bücher.example/p?utm_source=x&q=1",
+       "https://xn--bcher-kva.example/p?q=1"},
+      {"https://münchen.example/p?fbclid=1&k=v",
+       "https://xn--mnchen-3ya.example/p?k=v"},
+  };
+  ExpectCases(kCases);
+}
+
+// Only "&" splits the query; a ";" inside a part is just text.
+TEST(CleanLinkTest, SemicolonsDoNotSplitParameters) {
+  const Case kCases[] = {
+      {"https://a.test/p?a=1;utm_source=x&utm_medium=y",
+       "https://a.test/p?a=1;utm_source=x"},
+      // A part starting with a tracking name drops as a whole.
+      {"https://a.test/p?utm_source=x;y=1&q=1", "https://a.test/p?q=1"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, PartsWithNoValueAndEmptyNames) {
+  const Case kCases[] = {
+      // A part may be "=" with an empty name.
+      {"https://a.test/p?=x&utm_source=y", "https://a.test/p?=x"},
+      {"https://a.test/p?q=1&=&utm_source=y", "https://a.test/p?q=1&="},
+      // A tracking name needs no value.
+      {"https://a.test/p?q=1&utm_source", "https://a.test/p?q=1"},
+      {"https://a.test/p?q=1&utm_source=", "https://a.test/p?q=1"},
+      // The bare utm_ prefix is a name itself.
+      {"https://a.test/p?q=1&utm_", "https://a.test/p?q=1"},
+      {"https://a.test/p?utm_&q=1", "https://a.test/p?q=1"},
+  };
+  ExpectCases(kCases);
+}
+
+TEST(CleanLinkTest, EveryCopyOfATrackingNameIsDropped) {
+  const Case kCases[] = {
+      {"https://a.test/p?utm_source=a&utm_source=b", "https://a.test/p"},
+      {"https://a.test/p?q=1&utm_source=a&r=2&utm_source=b",
+       "https://a.test/p?q=1&r=2"},
+      {"https://a.test/p?q=1&utm_source=x&&&utm_medium=y",
+       "https://a.test/p?q=1"},
+  };
+  ExpectCases(kCases);
+}
+
+// The name comparison never decodes, and a kept part's value is never
+// decoded either.
+TEST(CleanLinkTest, EncodedTextIsTreatedByteForByte) {
+  const Case kCases[] = {
+      // An encoded "&name=" inside a value is not another parameter.
+      {"https://a.test/p?next=%2Fp%3Futm_source%3Dx%26fbclid%3Dy&fbclid=z",
+       "https://a.test/p?next=%2Fp%3Futm_source%3Dx%26fbclid%3Dy"},
+      {"https://a.test/p?q=a%26b&utm_source=x", "https://a.test/p?q=a%26b"},
+  };
+  ExpectCases(kCases);
+  const char* const kUnchanged[] = {
+      // "+" and "%3D" inside a name mean it isn't that name.
+      "https://a.test/p?utm+source=x",
+      "https://a.test/p?fbclid%3D=x",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+// Empty query markers carry no parts and are never rewritten.
+TEST(CleanLinkTest, EmptyQueryMarkersStayPut) {
+  const Case kCases[] = {
+      // Cleaning in front of an empty fragment leaves the "#".
+      {"https://a.test/p?utm_source=x#", "https://a.test/p#"},
+      // Only empty parts are left, so the query goes away whole.
+      {"https://a.test/p?&utm_source=x&", "https://a.test/p"},
+  };
+  ExpectCases(kCases);
+  const char* const kUnchanged[] = {
+      "https://a.test/p?#frag",
+      "https://a.test/p?#",
+      "https://a.test/p?&",
+  };
+  ExpectUnchanged(kUnchanged);
+}
+
+TEST(CleanLinkTest, LongQueriesAreScannedToTheEnd) {
+  // A tracker at the end of a long query is still found, and every kept
+  // parameter keeps its place.
+  std::string query;
+  for (int i = 0; i < 100; ++i) {
+    if (!query.empty()) {
+      query += '&';
+    }
+    query += "p" + std::to_string(i) + "=v" + std::to_string(i);
+  }
+  const GURL url("https://a.test/p?" + query + "&utm_source=x&gclid=1");
+  EXPECT_EQ("https://a.test/p?" + query, CleanLink(url).spec());
+}

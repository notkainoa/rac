+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//testing/test.gni")
+
+# Pure logic for the power features: copying a clean link, writing a Markdown
+# link, and naming a tab group. Code taken from other projects sits in
+# third_party/, each with its README.chromium and LICENSE, so about:credits
+# lists it.
+source_set("power") {
+  sources = [
+    "markdown_link.cc",
+    "markdown_link.h",
+  ]
+  public_deps = [
+    "//base",
+    "//url",
+    "third_party/stedding",
+  ]
+  deps = [ "//components/url_formatter" ]
+}
+
+# Build with `autoninja -C out/Default
+# chrome/browser/rac/power:rac_power_unittests`. It's separate from Chromium's
+# unit_tests, which takes hours to build.
+test("rac_power_unittests") {
+  sources = [ "markdown_link_unittest.cc" ]
+  deps = [
+    ":power",
+    "third_party/stedding:unit_tests",
+    "//base",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+    "//testing/gtest",
+    "//url",
+  ]
+}

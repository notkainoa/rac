--- /dev/null
+++ src/chrome/browser/rac/power/third_party/stedding/clean_link.h
@@ -0,0 +1,32 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+//
+// Derived from Stedding's clean_link.h
+// (https://github.com/ysalitrynskyi/stedding-browser, commit f301a37c).
+// BSD-3-Clause; see LICENSE beside this file.
+
+#ifndef CHROME_BROWSER_RAC_POWER_THIRD_PARTY_STEDDING_CLEAN_LINK_H_
+#define CHROME_BROWSER_RAC_POWER_THIRD_PARTY_STEDDING_CLEAN_LINK_H_
+
+#include "url/gurl.h"
+
+namespace rac {
+
+// Returns `url` without the query parameters that only exist to track the
+// reader: the utm_ family, ad-click ids (fbclid, gclid, ...), mail-merge ids,
+// and the share ids of a few sites (YouTube, Spotify, Instagram, X).
+//
+// It only touches a valid http or https URL that has a query. Parameters are
+// found in the raw query, split on `&`, and named by the text before the
+// first `=`, compared ASCII case-insensitively and without decoding (so
+// `utm%5Fsource` is not `utm_source`). When nothing is a tracking parameter
+// the result is `url` itself, unchanged — empty query parts (`a=1&&b=2`)
+// included. A rewrite keeps every surviving parameter's order and encoding
+// byte for byte, drops empty parts, never touches the fragment, and removes
+// the query when nothing is left.
+GURL CleanLink(const GURL& url);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_POWER_THIRD_PARTY_STEDDING_CLEAN_LINK_H_

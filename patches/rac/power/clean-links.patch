--- /dev/null
+++ src/chrome/browser/rac/power/markdown_link.cc
@@ -0,0 +1,156 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/markdown_link.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rac/power/third_party/stedding/clean_link.h"
+#include "components/url_formatter/url_formatter.h"
+
+namespace rac {
+
+namespace {
+
+// True when every `)` closes an earlier `(` and every `(` is closed.
+bool ParenthesesAreBalanced(std::string_view text) {
+  int depth = 0;
+  for (char c : text) {
+    if (c == '(') {
+      ++depth;
+    } else if (c == ')' && --depth < 0) {
+      return false;
+    }
+  }
+  return depth == 0;
+}
+
+// True when `text` opens with an entity reference, which CommonMark decodes
+// in link text and in a link destination: `&name;`, `&#123;`, or `&#x7B;`.
+// Only the shape counts, not whether the name is a real entity.
+bool StartsEntityLikeRun(std::u16string_view text) {
+  if (text.size() < 3 || text[0] != u'&') {
+    return false;
+  }
+  if (text[1] == u'#') {
+    size_t i = 2;
+    const bool hex = i < text.size() && (text[i] == u'x' || text[i] == u'X');
+    if (hex) {
+      ++i;
+    }
+    const size_t first_digit = i;
+    while (i < text.size() &&
+           (hex ? base::IsHexDigit(text[i]) : base::IsAsciiDigit(text[i]))) {
+      ++i;
+    }
+    return i > first_digit && i < text.size() && text[i] == u';';
+  }
+  if (!base::IsAsciiAlpha(text[1])) {
+    return false;
+  }
+  size_t i = 2;
+  while (i < text.size() && base::IsAsciiAlphaNumeric(text[i])) {
+    ++i;
+  }
+  return i < text.size() && text[i] == u';';
+}
+
+std::u16string EscapeLabel(std::u16string_view label) {
+  std::u16string escaped;
+  escaped.reserve(label.size());
+  for (size_t i = 0; i < label.size(); ++i) {
+    const char16_t c = label[i];
+    // A backtick could open a code span, which outranks the link, and a `<`
+    // an autolink or inline HTML. An `&` that starts an entity-like run
+    // would be decoded in the link text.
+    if (c == u'\\' || c == u'[' || c == u']' || c == u'`' || c == u'<' ||
+        (c == u'&' && StartsEntityLikeRun(label.substr(i)))) {
+      escaped.push_back(u'\\');
+    }
+    escaped.push_back(c);
+  }
+  return escaped;
+}
+
+std::u16string EscapeDestination(std::string_view spec) {
+  const bool escape_parentheses = !ParenthesesAreBalanced(spec);
+  const std::u16string wide = base::UTF8ToUTF16(spec);
+  std::u16string escaped;
+  escaped.reserve(wide.size());
+  for (size_t i = 0; i < wide.size(); ++i) {
+    const char16_t c = wide[i];
+    // GURL leaves a backslash, a backtick, or an `&` in a query as it was.
+    // Markdown would read the first as an escape, the second as a code
+    // span, and the third as an entity when it starts an entity-like run.
+    if (c == u'`') {
+      escaped += u"%60";
+      continue;
+    }
+    // A data: or javascript: address keeps its spaces, and a space would end
+    // the destination. %20 means the same address.
+    if (c == u' ') {
+      escaped += u"%20";
+      continue;
+    }
+    // Those addresses keep `<` and `>` raw where a web address would carry
+    // them percent-encoded, and a raw one could read as an autolink or
+    // inline HTML. %3C and %3E mean the same address.
+    if (c == u'<') {
+      escaped += u"%3C";
+      continue;
+    }
+    if (c == u'>') {
+      escaped += u"%3E";
+      continue;
+    }
+    if (c == u'\\' || (escape_parentheses && (c == u'(' || c == u')')) ||
+        (c == u'&' &&
+         StartsEntityLikeRun(std::u16string_view(wide).substr(i)))) {
+      escaped.push_back(u'\\');
+    }
+    escaped.push_back(c);
+  }
+  return escaped;
+}
+
+}  // namespace
+
+std::u16string MarkdownLink(std::u16string_view title, const GURL& url) {
+  const GURL clean = CleanLink(url);
+  // GURL::spec() DCHECKs on an invalid URL.
+  const std::string_view spec =
+      clean.is_valid() ? std::string_view(clean.spec()) : std::string_view();
+
+  // A title that is just the address would put back what CleanLink() took
+  // out, so it counts as no title.
+  std::u16string label(title);
+  if (label == base::UTF8ToUTF16(url.possibly_invalid_spec())) {
+    label.clear();
+  }
+  base::ReplaceChars(label, u"\r\n", u" ", &label);
+  std::u16string_view trimmed = base::TrimWhitespace(label, base::TRIM_ALL);
+  std::u16string fallback;
+  if (trimmed.empty()) {
+    // The host as a reader knows it: Unicode for an IDN that passes
+    // Chromium's spoof checks.
+    fallback = clean.is_valid() ? url_formatter::IDNToUnicode(clean.host())
+                                : std::u16string();
+    if (fallback.empty()) {
+      fallback = base::UTF8ToUTF16(spec);
+    }
+    trimmed = fallback;
+  }
+
+  std::u16string link = u"[";
+  link += EscapeLabel(trimmed);
+  link += u"](";
+  link += EscapeDestination(spec);
+  link += u")";
+  return link;
+}
+
+}  // namespace rac

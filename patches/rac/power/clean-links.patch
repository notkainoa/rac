+++ src/chrome/browser/rac/power/markdown_link.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_POWER_MARKDOWN_LINK_H_
+#define CHROME_BROWSER_RAC_POWER_MARKDOWN_LINK_H_
+
+#include <string>
+#include <string_view>
+
+#include "url/gurl.h"
+
+namespace rac {
+
+// Returns `[label](destination)` for a page. Callers pass the page's own
+// title, or "" when it has none, never WebContents::GetTitle()'s fallback to
+// the address, which would carry the tracking parameters CleanLink() removes.
+// A title equal to `url`'s spec counts as none.
+//
+// The destination is CleanLink(`url`).spec(). The label is `title` with each
+// CR and LF turned into a space and the ends trimmed; when that leaves
+// nothing it falls back to the host and then to the spec. A backslash, `[`,
+// `]`, a backtick, a `<`, and an `&` that starts an entity-like run
+// (`&amp;`, `&#38;`, `&#x26;`) in the label are backslash-escaped, so the
+// label can't end the link early, open a code span, start an autolink or
+// inline HTML, or be decoded as an entity.
+//
+// In the destination, a backslash is backslash-escaped, a backtick becomes
+// `%60`, a space (kept by data: and javascript: addresses) becomes `%20`,
+// a `<` and a `>` (kept raw by those addresses too) become `%3C` and `%3E`,
+// and an `&` that starts an entity-like run (`&amp;`, `&#38;`,
+// `&#x26;`) is backslash-escaped because CommonMark decodes those. `(` and
+// `)` are backslash-escaped only when they are unbalanced, so an address
+// such as `https://en.wikipedia.org/wiki/Foo_(bar)` stays readable. An
+// invalid `url` has an empty destination: `[label]()`.
+std::u16string MarkdownLink(std::u16string_view title, const GURL& url);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_POWER_MARKDOWN_LINK_H_
Index: src/chrome/browser/rac/power/markdown_link_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/power/markdown_link_unittest.cc
@@ -0,0 +1,300 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/power/markdown_link.h"
+
+#include <string_view>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac {
+namespace {
+
+// Asserts `link` is one link: a single unescaped `](` between the label
+// and the destination, and a closing `)` at the end.
+void ExpectLinkShape(std::u16string_view link) {
+  EXPECT_TRUE(link.ends_with(u")"));
+  size_t joins = 0;
+  for (size_t i = 0; i + 1 < link.size(); ++i) {
+    if (link[i] != u']' || link[i + 1] != u'(') {
+      continue;
+    }
+    // An odd run of backslashes escapes the `]`.
+    size_t slashes = 0;
+    for (size_t j = i; j > 0 && link[j - 1] == u'\\'; --j) {
+      ++slashes;
+    }
+    if (slashes % 2 == 0) {
+      ++joins;
+    }
+  }
+  EXPECT_EQ(1u, joins);
+}
+
+TEST(MarkdownLinkTest, TitleAndAddress) {
+  EXPECT_EQ(u"[Example Domain](https://example.com/)",
+            MarkdownLink(u"Example Domain", GURL("https://example.com")));
+  EXPECT_EQ(u"[A page](https://example.com/a/b?c=d#e)",
+            MarkdownLink(u"A page", GURL("https://example.com/a/b?c=d#e")));
+}
+
+TEST(MarkdownLinkTest, TheAddressIsCleaned) {
+  EXPECT_EQ(u"[T](https://x.com/a?id=3#c)",
+            MarkdownLink(u"T", GURL("https://x.com/a?utm_source=y&id=3#c")));
+  EXPECT_EQ(u"[T](https://x.com/a)",
+            MarkdownLink(u"T", GURL("https://x.com/a?fbclid=1")));
+}
+
+TEST(MarkdownLinkTest, TheLabelEscapesBracketsAndBackslashes) {
+  const GURL url("https://example.com/");
+  EXPECT_EQ(u"[a \\[b\\] c](https://example.com/)",
+            MarkdownLink(u"a [b] c", url));
+  EXPECT_EQ(u"[a\\\\b](https://example.com/)", MarkdownLink(u"a\\b", url));
+  EXPECT_EQ(u"[\\[\\[x\\]\\]](https://example.com/)",
+            MarkdownLink(u"[[x]]", url));
+  // Parentheses, and other Markdown characters, are left as they are.
+  EXPECT_EQ(u"[f(x) *y* _z_](https://example.com/)",
+            MarkdownLink(u"f(x) *y* _z_", url));
+}
+
+TEST(MarkdownLinkTest, LineBreaksInTheTitleBecomeSpaces) {
+  const GURL url("https://example.com/");
+  EXPECT_EQ(u"[a b](https://example.com/)", MarkdownLink(u"a\nb", url));
+  EXPECT_EQ(u"[a b](https://example.com/)", MarkdownLink(u"a\rb", url));
+  EXPECT_EQ(u"[a  b](https://example.com/)", MarkdownLink(u"a\r\nb", url));
+  // The ends are trimmed, including a break at either end.
+  EXPECT_EQ(u"[a](https://example.com/)", MarkdownLink(u"\n  a \r\n", url));
+}
+
+TEST(MarkdownLinkTest, ATitleWithNothingInItGivesTheHost) {
+  EXPECT_EQ(u"[example.com](https://example.com/p)",
+            MarkdownLink(u"", GURL("https://example.com/p")));
+  EXPECT_EQ(u"[example.com](https://example.com/p)",
+            MarkdownLink(u" \t\r\n ", GURL("https://example.com/p")));
+  EXPECT_EQ(u"[www.example.com](https://www.example.com/)",
+            MarkdownLink(u"", GURL("https://www.example.com")));
+  EXPECT_EQ(u"[192.168.0.1](http://192.168.0.1:8080/)",
+            MarkdownLink(u"", GURL("http://192.168.0.1:8080")));
+  // The host is escaped like any other label.
+  EXPECT_EQ(u"[\\[::1\\]](http://[::1]/)",
+            MarkdownLink(u"", GURL("http://[::1]/")));
+}
+
+TEST(MarkdownLinkTest, WithNoHostTheLabelIsTheAddress) {
+  EXPECT_EQ(u"[mailto:a@example.com](mailto:a@example.com)",
+            MarkdownLink(u"", GURL("mailto:a@example.com")));
+  EXPECT_EQ(u"[file:///tmp/a.txt](file:///tmp/a.txt)",
+            MarkdownLink(u"", GURL("file:///tmp/a.txt")));
+}
+
+TEST(MarkdownLinkTest, BalancedParenthesesStayReadable) {
+  EXPECT_EQ(
+      u"[Foo](https://en.wikipedia.org/wiki/Foo_(bar))",
+      MarkdownLink(u"Foo", GURL("https://en.wikipedia.org/wiki/Foo_(bar)")));
+  EXPECT_EQ(u"[F](https://x.test/a_(b)_(c(d)))",
+            MarkdownLink(u"F", GURL("https://x.test/a_(b)_(c(d))")));
+  EXPECT_EQ(u"[F](https://x.test/p?q=(1)&r=2)",
+            MarkdownLink(u"F", GURL("https://x.test/p?q=(1)&r=2")));
+}
+
+TEST(MarkdownLinkTest, UnbalancedParenthesesAreEscaped) {
+  EXPECT_EQ(u"[F](https://x.test/a\\)b)",
+            MarkdownLink(u"F", GURL("https://x.test/a)b")));
+  EXPECT_EQ(u"[F](https://x.test/a\\(b)",
+            MarkdownLink(u"F", GURL("https://x.test/a(b")));
+  // A close before its open is unbalanced even when the counts are equal.
+  EXPECT_EQ(u"[F](https://x.test/\\)a\\()",
+            MarkdownLink(u"F", GURL("https://x.test/)a(")));
+  // Every parenthesis is escaped, the matched pair included.
+  EXPECT_EQ(u"[F](https://x.test/\\(a\\)\\))",
+            MarkdownLink(u"F", GURL("https://x.test/(a))")));
+}
+
+TEST(MarkdownLinkTest, ParenthesesAreCountedAfterTheAddressIsCleaned) {
+  // The tracking parameter holds the stray parenthesis, so nothing is left
+  // to escape once it is dropped.
+  EXPECT_EQ(u"[F](https://x.test/a_(b))",
+            MarkdownLink(u"F", GURL("https://x.test/a_(b)?fbclid=)")));
+}
+
+TEST(MarkdownLinkTest, ATitleThatIsTheAddressCountsAsNone) {
+  const GURL url("https://x.com/a?utm_source=y&id=3");
+  EXPECT_EQ(u"[x.com](https://x.com/a?id=3)",
+            MarkdownLink(u"https://x.com/a?utm_source=y&id=3", url));
+}
+
+TEST(MarkdownLinkTest, BackticksCannotOpenACodeSpan) {
+  EXPECT_EQ(u"[Use \\` here](https://x.test/?q=%60a)",
+            MarkdownLink(u"Use ` here", GURL("https://x.test/?q=`a")));
+}
+
+TEST(MarkdownLinkTest, ABackslashInTheAddressIsEscaped) {
+  EXPECT_EQ(u"[F](https://x.test/?q=a\\\\_b)",
+            MarkdownLink(u"F", GURL("https://x.test/?q=a\\_b")));
+  EXPECT_EQ(u"[F](https://x.test/?q=a\\\\\\(b)",
+            MarkdownLink(u"F", GURL("https://x.test/?q=a\\(b")));
+}
+
+TEST(MarkdownLinkTest, AnInvalidAddressGivesAnEmptyDestination) {
+  EXPECT_EQ(u"[T]()", MarkdownLink(u"T", GURL()));
+  EXPECT_EQ(u"[]()", MarkdownLink(u"", GURL("not a url")));
+}
+
+TEST(MarkdownLinkTest, EmojiAndNonAsciiAreLeftAlone) {
+  EXPECT_EQ(u"[🎉 launch](https://example.com/)",
+            MarkdownLink(u"🎉 launch", GURL("https://example.com/")));
+  // Non-ASCII in the address is percent-encoded by GURL.
+  EXPECT_EQ(u"[F](https://example.com/%C3%BC)",
+            MarkdownLink(u"F", GURL("https://example.com/ü")));
+}
+
+// An escaped bracket can neither end the label nor open a link of its own.
+TEST(MarkdownLinkTest, TheLabelCannotBeBrokenOutOf) {
+  const GURL url("https://example.com/");
+  EXPECT_EQ(u"[\\[\\]](https://example.com/)", MarkdownLink(u"[]", url));
+  EXPECT_EQ(u"[x\\](https://e.test](https://example.com/)",
+            MarkdownLink(u"x](https://e.test", url));
+}
+
+// Schemes without a host give the whole address as the label, and balanced
+// parentheses inside a javascript: address are left alone.
+TEST(MarkdownLinkTest, JavascriptAndDataUrls) {
+  EXPECT_EQ(u"[javascript:alert(1)](javascript:alert(1))",
+            MarkdownLink(u"", GURL("javascript:alert(1)")));
+  EXPECT_EQ(u"[data:text/plain,hi](data:text/plain,hi)",
+            MarkdownLink(u"", GURL("data:text/plain,hi")));
+}
+
+// data: and javascript: addresses keep `<` and `>` raw, where the same
+// characters in a web address would already be percent-encoded. A raw one
+// could read as an autolink or inline HTML, so they become %3C and %3E.
+TEST(MarkdownLinkTest, AngleBracketsInTheAddressAreEncoded) {
+  EXPECT_EQ(u"[data:text/html,\\<a>b\\</a>](data:text/html,%3Ca%3Eb%3C/a%3E)",
+            MarkdownLink(u"", GURL("data:text/html,<a>b</a>")));
+  EXPECT_EQ(u"[F](javascript:alert('%3Cx%3E'))",
+            MarkdownLink(u"F", GURL("javascript:alert('<x>')")));
+}
+
+// Whatever the address held, the output is still one link.
+TEST(MarkdownLinkTest, EveryDestinationKeepsTheLinkShape) {
+  const char* const kSpecs[] = {
+      "https://example.com/",
+      "https://x.test/a_(b)_(c(d))",
+      "https://x.test/a)b",
+      "https://x.test/a(b",
+      "https://x.test/)a(",
+      "https://x.test/(a))",
+      "https://x.test/a#b)c",
+      "https://en.wikipedia.org/wiki/Foo_(bar)",
+      "https://x.test/?q=a\\_b",
+      "https://x.test/?q=a\\(b",
+      "https://x.test/?a=1&amp;b=2",
+      "https://x.test/a#b&#38;c",
+      "javascript:alert(1)",
+      "javascript:alert('<x>')",
+      "data:text/html,<a>b</a>",
+      "data:text/html,hello world",
+      "not a url",
+  };
+  for (const char* spec : kSpecs) {
+    SCOPED_TRACE(spec);
+    ExpectLinkShape(MarkdownLink(u"F", GURL(spec)));
+  }
+}
+
+// GURL itself percent-escapes a backtick in the path, so the destination
+// escaper never sees one.
+TEST(MarkdownLinkTest, ABacktickInThePathIsCanonicalized) {
+  EXPECT_EQ(u"[F](https://x.test/%60a)",
+            MarkdownLink(u"F", GURL("https://x.test/`a")));
+}
+
+// Only a title equal to the address as typed counts as none. The cleaned
+// address, or the address with a stray space, stays as the label.
+TEST(MarkdownLinkTest, ATitleEqualToTheCleanedAddressIsKept) {
+  const GURL url("https://x.com/a?utm_source=y");
+  EXPECT_EQ(u"[https://x.com/a](https://x.com/a)",
+            MarkdownLink(u"https://x.com/a", url));
+  EXPECT_EQ(u"[https://x.com/a?utm_source=y](https://x.com/a)",
+            MarkdownLink(u"https://x.com/a?utm_source=y ", url));
+}
+
+// CleanLink() only touches http and https, so a tracker on another scheme
+// stays in the destination.
+TEST(MarkdownLinkTest, NonHttpUrlsAreNotCleaned) {
+  EXPECT_EQ(u"[x.com](ftp://x.com/?utm_source=y)",
+            MarkdownLink(u"", GURL("ftp://x.com/?utm_source=y")));
+  EXPECT_EQ(u"[settings](chrome://settings/)",
+            MarkdownLink(u"", GURL("chrome://settings/")));
+}
+
+// Parentheses are balanced over the whole address, fragment included.
+TEST(MarkdownLinkTest, AParenthesisInTheFragmentCounts) {
+  EXPECT_EQ(u"[F](https://x.test/a#b\\)c)",
+            MarkdownLink(u"F", GURL("https://x.test/a#b)c")));
+}
+
+// A `<` in the title could open an autolink or inline HTML inside the link
+// text, so it is escaped like a bracket.
+TEST(MarkdownLinkTest, AngleBracketsInTheTitleAreEscaped) {
+  const GURL url("https://example.com/");
+  EXPECT_EQ(u"[\\<https://a.example>](https://example.com/)",
+            MarkdownLink(u"<https://a.example>", url));
+  EXPECT_EQ(u"[\\<em>x\\</em>](https://example.com/)",
+            MarkdownLink(u"<em>x</em>", url));
+}
+
+// CommonMark decodes `&name;`, `&#123;`, and `&#x7B;` in a destination, so
+// a literal `&` that starts one takes a backslash. `&#` can only sit in the
+// fragment: anywhere earlier the `#` would open it.
+TEST(MarkdownLinkTest, EntityLikeRunsInTheAddressAreEscaped) {
+  EXPECT_EQ(u"[F](https://x.test/?a=1\\&amp;b=2)",
+            MarkdownLink(u"F", GURL("https://x.test/?a=1&amp;b=2")));
+  EXPECT_EQ(u"[F](https://x.test/a#b\\&#38;c)",
+            MarkdownLink(u"F", GURL("https://x.test/a#b&#38;c")));
+  EXPECT_EQ(u"[F](https://x.test/a#b\\&#x26;c)",
+            MarkdownLink(u"F", GURL("https://x.test/a#b&#x26;c")));
+}
+
+// CommonMark decodes entity references in link text too, so an `&` that
+// opens an entity-like run in the label takes a backslash, while a plain
+// `&` stays as it was.
+TEST(MarkdownLinkTest, EntityLikeRunsInTheLabelAreEscaped) {
+  const GURL url("https://example.com/");
+  EXPECT_EQ(u"[Using \\&nbsp; and \\&copy; in HTML](https://example.com/)",
+            MarkdownLink(u"Using &nbsp; and &copy; in HTML", url));
+  EXPECT_EQ(u"[Tom & Jerry](https://example.com/)",
+            MarkdownLink(u"Tom & Jerry", url));
+}
+
+// An `&` that isn't an entity's shape stays as it was.
+TEST(MarkdownLinkTest, APlainAmpersandIsLeftAlone) {
+  EXPECT_EQ(u"[F](https://x.test/?a=1&b=2)",
+            MarkdownLink(u"F", GURL("https://x.test/?a=1&b=2")));
+  EXPECT_EQ(u"[F](https://x.test/?a=1&;b=2)",
+            MarkdownLink(u"F", GURL("https://x.test/?a=1&;b=2")));
+  EXPECT_EQ(u"[F](https://x.test/a#b&#;c)",
+            MarkdownLink(u"F", GURL("https://x.test/a#b&#;c")));
+  // No closing `;`, no entity.
+  EXPECT_EQ(u"[F](https://x.test/?a=1&amp)",
+            MarkdownLink(u"F", GURL("https://x.test/?a=1&amp")));
+}
+
+// data: and javascript: addresses keep their spaces; a raw space would end
+// the destination, so it becomes %20.
+TEST(MarkdownLinkTest, ASpaceInTheAddressIsEncoded) {
+  EXPECT_EQ(u"[x](data:text/html,hello%20world)",
+            MarkdownLink(u"x", GURL("data:text/html,hello world")));
+}
+
+// With no title, the label is the host in Unicode; the destination stays
+// the canonical punycode address.
+TEST(MarkdownLinkTest, AnUntitledIdnPageIsLabelledInUnicode) {
+  EXPECT_EQ(u"[b\u00fccher.example](https://xn--bcher-kva.example/)",
+            MarkdownLink(u"", GURL("https://xn--bcher-kva.example/")));
+}
+
+}  // namespace
+}  // namespace rac

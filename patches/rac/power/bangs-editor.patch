+void SearchEnginesHandler::HandleRemoveBang(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  TemplateURLID id = args[0].GetInt();
+
+  // Bangs are LOCAL engines, so CanRemove() does not cover them; bang_id()
+  // is the check here. Remove() records the trigger in rac.bangs.deleted.
+  TemplateURL* template_url = list_controller_.GetTemplateURL(id);
+  if (template_url && template_url->bang_id() > 0) {
+    list_controller_.RemoveTemplateURL(id);
+  }
+}
+
+void SearchEnginesHandler::HandleRestoreBang(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  const std::string& trigger = args[0].GetString();
+
+  TemplateURLService* template_url_service =
+      TemplateURLServiceFactory::GetForProfile(profile_);
+  if (template_url_service) {
+    template_url_service->RestoreDeletedBang(trigger);
+  }
+
+  // Refresh the page even when nothing was re-added: clearing the deleted
+  // list alone already changes it.
+  OnTemplateURLServiceChanged();
+}

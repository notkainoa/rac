+// Synthetic test data only. Hosts use the reserved .test TLD and
+// documentation IP ranges.
+ImportedCookie MakeCookie(std::string name,
+                          std::string host_key,
+                          bool secure = true) {
+  const base::Time now = base::Time::Now();
+  ImportedCookie cookie;
+  cookie.name = std::move(name);
+  cookie.value = "synthetic-value";
+  cookie.host_key = std::move(host_key);
+  cookie.path = "/";
+  cookie.creation = now - base::Days(10);
+  cookie.last_access = now - base::Days(1);
+  cookie.expiry = now + base::Days(30);
+  cookie.secure = secure;
+  cookie.source_scheme = secure ? net::CookieSourceScheme::kSecure
+                                : net::CookieSourceScheme::kNonSecure;
+  cookie.source_port = secure ? 443 : 80;
+  return cookie;
+}
+
+// `count` cookies, each on its own registrable domain, since the store keeps
+// at most 180 per eTLD+1.
+std::vector<ImportedCookie> ManyCookies(size_t count) {
+  std::vector<ImportedCookie> cookies;
+  for (size_t i = 0; i < count; ++i) {
+    cookies.push_back(
+        MakeCookie("n", "site" + base::NumberToString(i) + ".test"));
+  }
+  return cookies;
+}
+
+// Allows every cookie, as a profile with default settings would.
+CookieSettingsFilter AllowAll() {
+  return base::BindRepeating([](const net::CanonicalCookie&, const GURL&) {
+    return CookieSettingsDecision::kAllow;
+  });
+}
+
+// A stand-in for a profile's cookie settings: `decision` for every cookie
+// whose domain is in `hosts`, kAllow for the rest. With no hosts, `decision`
+// applies to every cookie, like a default setting.
+CookieSettingsFilter FakeSettings(CookieSettingsDecision decision,
+                                  std::set<std::string> hosts = {}) {
+  return base::BindRepeating(
+      [](CookieSettingsDecision decision, const std::set<std::string>& hosts,
+         const net::CanonicalCookie& cookie, const GURL&) {
+        return hosts.empty() || hosts.contains(cookie.Domain())
+                   ? decision
+                   : CookieSettingsDecision::kAllow;
+      },
+      decision, std::move(hosts));
+}
+
+// An in-process CookieManager with no mojo pipe. In kHold mode it keeps every
+// callback until the test answers or drops it; dropping one is what a lost
+// connection does. Records every SetCanonicalCookie and FlushCookieStore call.
+// GetAllCookies() answers at once with `existing()`, or drops the call while
+// `drop_reads()` is above zero.
+class FakeCookieManager : public network::TestCookieManager {
+ public:
+  enum class Mode {
+    // Keep callbacks until the test calls AcceptHeldSets(), AnswerFlush() or
+    // DropHeldCalls().
+    kHold,
+    // Answer every call at once, with success.
+    kAccept,
+    // Destroy every callback unrun, as a dead pipe does.
+    kDrop,
+  };
+
+  explicit FakeCookieManager(Mode mode) : mode_(mode) {}
+  ~FakeCookieManager() override = default;
+
+  void SetCanonicalCookie(const net::CanonicalCookie& cookie,
+                          const GURL& source_url,
+                          const net::CookieOptions& cookie_options,
+                          SetCanonicalCookieCallback callback) override {
+    ++set_calls_;
+    switch (mode_) {
+      case Mode::kHold:
+        held_sets_.push_back(std::move(callback));
+        return;
+      case Mode::kAccept:
+        std::move(callback).Run(net::CookieAccessResult());
+        return;
+      case Mode::kDrop:
+        return;
+    }
+  }
+
+  void GetAllCookies(GetAllCookiesCallback callback) override {
+    ++read_calls_;
+    if (drop_reads_ > 0) {
+      --drop_reads_;
+      return;
+    }
+    std::move(callback).Run(existing_);
+  }
+
+  void FlushCookieStore(FlushCookieStoreCallback callback) override {
+    ++flush_calls_;
+    sets_before_flush_ = set_calls_;
+    switch (mode_) {
+      case Mode::kHold:
+        held_flush_ = std::move(callback);
+        return;
+      case Mode::kAccept:
+        std::move(callback).Run();
+        return;
+      case Mode::kDrop:
+        return;
+    }
+  }
+
+  void AcceptHeldSets() {
+    std::vector<SetCanonicalCookieCallback> callbacks;
+    callbacks.swap(held_sets_);
+    for (SetCanonicalCookieCallback& callback : callbacks) {
+      std::move(callback).Run(net::CookieAccessResult());
+    }
+  }
+
+  // Destroys every held callback without running it.
+  void DropHeldCalls() {
+    std::vector<SetCanonicalCookieCallback> callbacks;
+    callbacks.swap(held_sets_);
+    callbacks.clear();
+    held_flush_.Reset();
+  }
+
+  void AnswerFlush() { std::move(held_flush_).Run(); }
+
+  std::vector<net::CanonicalCookie>& existing() { return existing_; }
+  void set_drop_reads(size_t count) { drop_reads_ = count; }
+  size_t read_calls() const { return read_calls_; }
+  size_t held_sets() const { return held_sets_.size(); }
+  bool has_held_flush() const { return !held_flush_.is_null(); }
+  size_t set_calls() const { return set_calls_; }
+  size_t flush_calls() const { return flush_calls_; }
+  size_t sets_before_flush() const { return sets_before_flush_; }
+
+ private:
+  const Mode mode_;
+  std::vector<SetCanonicalCookieCallback> held_sets_;
+  FlushCookieStoreCallback held_flush_;
+  std::vector<net::CanonicalCookie> existing_;
+  size_t drop_reads_ = 0;
+  size_t read_calls_ = 0;
+  size_t set_calls_ = 0;
+  size_t flush_calls_ = 0;
+  size_t sets_before_flush_ = 0;
+};
+
+// A real network::CookieManager over an in-memory net::CookieMonster, reached
+// through a mojo pipe as in the browser. Tests that need to hold, drop or
+// count calls use FakeCookieManager instead.
+class CookieWriterTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    auto context_builder = net::CreateTestURLRequestContextBuilder();
+    context_builder->SetCookieStore(std::make_unique<net::CookieMonster>(
+        /*store=*/nullptr, /*net_log=*/nullptr));
+    url_request_context_ = context_builder->Build();
+    cookie_manager_ = std::make_unique<network::CookieManager>(
+        url_request_context_.get(),
+        /*session_cleanup_cookie_store=*/nullptr, /*params=*/nullptr);
+    cookie_manager_->AddReceiver(remote_.BindNewPipeAndPassReceiver());
+  }
+
+  CookieWriteReport Write(std::vector<ImportedCookie> cookies,
+                          CookieSettingsFilter filter = AllowAll()) {
+    return WriteWith(remote_.get(), std::move(cookies), std::move(filter));
+  }
+
+  static CookieWriteReport WriteWith(
+      network::mojom::CookieManager* manager,
+      std::vector<ImportedCookie> cookies,
+      CookieSettingsFilter filter = AllowAll()) {
+    std::unique_ptr<CookieWriter> writer =
+        CookieWriter::CreateForTesting(manager, std::move(filter));
+    base::test::TestFuture<const CookieWriteReport&> done;
+    writer->Write(std::move(cookies), done.GetCallback());
+    return done.Get();
+  }
+
+  // Puts `cookie` in the store directly, as if rac had set it before the
+  // import. Converted the same way the writer converts.
+  void SeedCookie(ImportedCookie cookie) {
+    internal::PrepareResult prepared =
+        internal::PrepareCookies({std::move(cookie)}, base::Time::Now());
+    ASSERT_EQ(prepared.ready.size(), 1u);
+    net::CookieOptions options;
+    options.set_include_httponly();
+    options.set_same_site_cookie_context(
+        net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+    base::test::TestFuture<net::CookieAccessResult> result;
+    remote_->SetCanonicalCookie(prepared.ready[0].cookie,
+                                prepared.ready[0].source_url, options,
+                                result.GetCallback());
+    ASSERT_TRUE(result.Get().status.IsInclude());
+  }
+
+  std::vector<net::CanonicalCookie> AllCookies() {
+    base::test::TestFuture<const std::vector<net::CanonicalCookie>&> cookies;
+    remote_->GetAllCookies(cookies.GetCallback());
+    return cookies.Get();
+  }
+
+  std::optional<net::CanonicalCookie> FindCookie(std::string_view name) {
+    for (const net::CanonicalCookie& cookie : AllCookies()) {
+      if (cookie.Name() == name) {
+        return cookie;
+      }
+    }
+    return std::nullopt;
+  }
+
+  // Writes one cookie and checks that it's the only outcome in the report.
+  void ExpectSet(ImportedCookie cookie) {
+    const CookieWriteReport report = Write({std::move(cookie)});
+    EXPECT_EQ(report.total, 1u);
+    EXPECT_EQ(report.set, 1u);
+    EXPECT_EQ(report.rejected_total(), 0u);
+  }
+  void ExpectRejected(ImportedCookie cookie, CookieRejectReason reason) {
+    const std::string name = cookie.name;
+    const CookieWriteReport report = Write({std::move(cookie)});
+    EXPECT_EQ(report.total, 1u);
+    EXPECT_EQ(report.set, 0u);
+    EXPECT_EQ(report.rejected_count(reason), 1u);
+    EXPECT_EQ(report.rejected_total(), 1u);
+    EXPECT_FALSE(FindCookie(name));
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  std::unique_ptr<net::URLRequestContext> url_request_context_;
+  std::unique_ptr<network::CookieManager> cookie_manager_;
+  mojo::Remote<network::mojom::CookieManager> remote_;
+};

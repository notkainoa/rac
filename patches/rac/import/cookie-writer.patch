+
+#ifndef CHROME_BROWSER_RAC_IMPORT_COOKIE_WRITER_PROFILE_H_
+#define CHROME_BROWSER_RAC_IMPORT_COOKIE_WRITER_PROFILE_H_
+
+#include <memory>
+
+#include "chrome/browser/rac/import/cookie_writer.h"
+
+class Profile;
+
+namespace rac::import {
+
+// The way in for production code: a writer for `profile`, with the getter and
+// settings filter below. `profile` must not be null. Create it right before
+// Write(); the filter's clear-on-exit rules are read when it's created.
+std::unique_ptr<CookieWriter> CreateCookieWriterForImport(Profile* profile);
+
+// A getter for CookieWriter that returns the cookie manager of `profile`'s
+// default storage partition, re-read before each batch so a restarted
+// network service is picked up. `profile` must not be null.
+//
+// The getter returns null, which fails the import, when `profile` is
+// incognito, guest or a system profile, so an import can never land in one,
+// and once `profile` is destroyed. It never falls back to the original
+// profile.
+CookieWriter::CookieManagerGetter CookieManagerGetterForImport(
+    Profile* profile);
+
+// A settings filter that applies `profile`'s cookie settings, through
+// Chromium's own content_settings::CookieSettings:
+//
+// - kBlock when `profile` would not let the cookie's site store cookies:
+//   a Block exception for the site, or Block as the default. Each cookie is
+//   asked as first-party to its own site, so blocking third-party cookies
+//   doesn't skip it. A partitioned cookie with a cross-site ancestor is
+//   asked in its partition instead (the cookie's site embedded under the
+//   partition's top-level site), with the network service's rule for
+//   partitioned cookies.
+// - kClearOnExit when `profile` would delete the cookie at exit, by the
+//   same rule the network service deletes with.
+// - kAllow otherwise.
+//
+// Returns kBlock once `profile` is destroyed; the writer never gets that far,
+// since its getter returns null first. `profile` must not be null.
+CookieSettingsFilter CookieSettingsFilterForImport(Profile* profile);
+
+}  // namespace rac::import
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_COOKIE_WRITER_PROFILE_H_

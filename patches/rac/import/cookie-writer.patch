+TEST_F(CookieWriterTest, DeletingWriterMidBatchCancels) {
+  // Late replies and dropped calls both arrive after the writer is gone.
+  for (const bool drop : {false, true}) {
+    SCOPED_TRACE(drop);
+    FakeCookieManager manager(FakeCookieManager::Mode::kHold);
+    std::unique_ptr<CookieWriter> writer =
+        CookieWriter::CreateForTesting(&manager);
+    bool done_ran = false;
+    writer->Write(ManyCookies(CookieWriter::kBatchSize + 10),
+                  base::BindLambdaForTesting(
+                      [&](const CookieWriteReport&) { done_ran = true; }));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return manager.held_sets() == CookieWriter::kBatchSize; }));
+
+    writer.reset();
+    if (drop) {
+      manager.DropHeldCalls();
+    } else {
+      manager.AcceptHeldSets();
+    }
+    task_environment_.RunUntilIdle();
+    EXPECT_FALSE(done_ran);
+    EXPECT_EQ(manager.set_calls(), CookieWriter::kBatchSize);
+    EXPECT_EQ(manager.flush_calls(), 0u);
+  }
+}

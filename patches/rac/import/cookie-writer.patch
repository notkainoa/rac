+#include "base/functional/bind.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/content_settings/cookie_settings_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/content_settings/core/browser/cookie_settings.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/cookie_settings_base.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/schemeful_site.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_partition_key.h"
+#include "net/cookies/cookie_setting_override.h"
+#include "net/cookies/site_for_cookies.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace rac::import {
+
+namespace {
+
+// Null for a destroyed, incognito, guest or system profile. Other storage
+// partitions (isolated apps, <webview>) are never written.
+network::mojom::CookieManager* GetCookieManagerForImport(
+    base::WeakPtr<Profile> weak_profile) {
+  Profile* profile = weak_profile.get();
+  if (!profile || !profile->IsRegularProfile()) {
+    return nullptr;
+  }
+  return profile->GetDefaultStoragePartition()
+      ->GetCookieManagerForBrowserProcess();
+}
+
+struct ImportCookieSettings {
+  base::WeakPtr<Profile> profile;
+  scoped_refptr<content_settings::CookieSettings> cookie_settings;
+  // ShouldDeleteCookieOnExit() wants the rule list built once, not per
+  // cookie.
+  ContentSettingsForOneType rules;
+};
+
+// Whether the profile would let the cookie's own site store it.
+bool IsAllowedForImport(const content_settings::CookieSettings& settings,
+                        const net::CanonicalCookie& cookie,
+                        const GURL& source_url) {
+  const std::optional<net::CookiePartitionKey>& partition_key =
+      cookie.PartitionKey();
+  // The partition key argument below only matters for nonce keys, which
+  // CookiePartitionKey::FromStorage() never returns, so it's left out.
+  if (partition_key && partition_key->IsThirdParty()) {
+    // Set by the cookie's site while embedded under the partition's site,
+    // and only ever readable there. Ask in that context. Third-party
+    // blocking alone leaves partitioned cookies allowed; a Block that
+    // applies to the site there doesn't. Same rule as the network service's
+    // CookieSettings::IsCookieAllowed().
+    content_settings::CookieSettingsBase::CookieSettingWithMetadata setting;
+    const bool full_access = settings.IsFullCookieAccessAllowed(
+        source_url, net::SiteForCookies(),
+        url::Origin::Create(partition_key->site().GetURL()),
+        net::CookieSettingOverrides(), /*cookie_partition_key=*/std::nullopt,
+        &setting);
+    return full_access || setting.allow_partitioned_cookies();
+  }
+  // Unpartitioned, or partitioned by its own site: first-party. The original
+  // context is unknown, and the user's site exceptions and default are what
+  // decide whether the site may keep cookies at all; a stored cookie is
+  // readable by its own site whatever the third-party setting is.
+  const url::Origin origin = url::Origin::Create(source_url);
+  return settings.IsFullCookieAccessAllowed(
+      source_url, net::SiteForCookies::FromOrigin(origin), origin,
+      net::CookieSettingOverrides(), /*cookie_partition_key=*/std::nullopt);
+}
+
+CookieSettingsDecision CheckImportCookieSettings(
+    const ImportCookieSettings* settings,
+    const net::CanonicalCookie& cookie,
+    const GURL& source_url) {
+  if (!settings->profile) {
+    return CookieSettingsDecision::kBlock;
+  }
+  const content_settings::CookieSettings& cookie_settings =
+      *settings->cookie_settings;
+  if (!IsAllowedForImport(cookie_settings, cookie, source_url)) {
+    return CookieSettingsDecision::kBlock;
+  }
+  // The predicate the network service deletes session-only cookies with at
+  // exit (CookieSettings::CreateDeleteCookieOnExitPredicate()), so a cookie
+  // is skipped exactly when rac would delete it. IsCookieSessionOnly() only
+  // looks at the site's own rule, and would skip a domain cookie that an
+  // Allow exception for a subdomain keeps.
+  if (cookie_settings.ShouldDeleteCookieOnExit(settings->rules, cookie.Domain(),
+                                               cookie.SourceScheme())) {
+    return CookieSettingsDecision::kClearOnExit;
+  }
+  return CookieSettingsDecision::kAllow;
+}
+
+}  // namespace
+
+std::unique_ptr<CookieWriter> CreateCookieWriterForImport(Profile* profile) {
+  return std::make_unique<CookieWriter>(CookieManagerGetterForImport(profile),
+                                        CookieSettingsFilterForImport(profile));
+}
+
+CookieWriter::CookieManagerGetter CookieManagerGetterForImport(
+    Profile* profile) {
+  CHECK(profile);
+  // A weak pointer, so a profile closed mid-import makes the getter return
+  // null and the writer fails the remaining cookies instead of crashing.
+  return base::BindRepeating(&GetCookieManagerForImport,
+                             profile->GetWeakPtr());
+}
+
+CookieSettingsFilter CookieSettingsFilterForImport(Profile* profile) {
+  CHECK(profile);
+  auto settings = std::make_unique<ImportCookieSettings>();
+  settings->profile = profile->GetWeakPtr();
+  settings->cookie_settings = CookieSettingsFactory::GetForProfile(profile);
+  CHECK(settings->cookie_settings);
+  settings->rules = settings->cookie_settings->GetCookieSettings();
+  return base::BindRepeating(&CheckImportCookieSettings,
+                             base::Owned(std::move(settings)));
+}
+
+}  // namespace rac::import

+TEST_F(CookieWriterTest, WritesNormalCookieWithItsAttributes) {
+  ImportedCookie in = MakeCookie("plain", ".example.test");
+  in.path = "/account";
+  in.priority = net::COOKIE_PRIORITY_HIGH;
+  in.same_site = net::CookieSameSite::LAX_MODE;
+  const base::Time creation = in.creation;
+  const base::Time expiry = in.expiry;
+  const base::Time last_access = in.last_access;
+  ExpectSet(in);
+
+  std::optional<net::CanonicalCookie> out = FindCookie("plain");
+  ASSERT_TRUE(out);
+  EXPECT_EQ(out->Value(), "synthetic-value");
+  EXPECT_EQ(out->Domain(), ".example.test");
+  EXPECT_TRUE(out->IsDomainCookie());
+  EXPECT_EQ(out->Path(), "/account");

+TEST_F(CookieWriterTest, WriterCanBeDeletedFromDone) {
+  FakeCookieManager manager(FakeCookieManager::Mode::kAccept);
+  std::unique_ptr<CookieWriter> writer =
+      CookieWriter::CreateForTesting(&manager);
+  base::RunLoop run_loop;
+  size_t set = 0;
+  writer->Write(
+      {MakeCookie("a", "example.test")},
+      base::BindLambdaForTesting([&](const CookieWriteReport& report) {
+        writer.reset();
+        // Still valid: the writer passes its own copy.
+        set = report.set;
+        run_loop.Quit();
+      }));
+  run_loop.Run();
+  EXPECT_FALSE(writer);
+  EXPECT_EQ(set, 1u);
+}

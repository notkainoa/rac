+using ExclusionReason = net::CookieInclusionStatus::ExclusionReason;
+
+constexpr int kMaxPort = 65535;
+
+// A browser-initiated import is trusted: it may write HttpOnly cookies and
+// every SameSite mode. Same options as ProfileAuthData and FloatingSsoService.
+net::CookieOptions ImportCookieOptions() {
+  net::CookieOptions options;
+  options.set_include_httponly();
+  options.set_same_site_cookie_context(
+      net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+  options.set_do_not_update_access_time();
+  return options;
+}
+
+// The CookieManager mojom traits hit NOTREACHED() on an enum value they don't
+// know, which would crash the browser while sending the cookie. The source DB
+// can hold such values (SameSite 3 was the retired "Extended" mode), so map
+// anything unknown to the default. SQLitePersistentCookieStore does the same
+// for SameSite and the source scheme when it loads a row.
+net::CookieSameSite KnownSameSite(net::CookieSameSite value) {
+  switch (value) {
+    case net::CookieSameSite::UNSPECIFIED:
+    case net::CookieSameSite::NO_RESTRICTION:
+    case net::CookieSameSite::LAX_MODE:
+    case net::CookieSameSite::STRICT_MODE:
+      return value;
+  }
+  return net::CookieSameSite::UNSPECIFIED;
+}
+
+net::CookiePriority KnownPriority(net::CookiePriority value) {
+  switch (value) {
+    case net::COOKIE_PRIORITY_LOW:
+    case net::COOKIE_PRIORITY_MEDIUM:
+    case net::COOKIE_PRIORITY_HIGH:
+      return value;
+  }
+  return net::COOKIE_PRIORITY_DEFAULT;
+}
+
+// Never sent to the store as is (CreateSanitizedCookie derives the cookie's
+// source scheme from the URL), but SourceUrlFor() reads it.
+net::CookieSourceScheme KnownSourceScheme(net::CookieSourceScheme value) {
+  switch (value) {
+    case net::CookieSourceScheme::kUnset:
+    case net::CookieSourceScheme::kNonSecure:
+    case net::CookieSourceScheme::kSecure:
+      return value;
+  }
+  return net::CookieSourceScheme::kUnset;
+}
+
+// Maps CreateSanitizedCookie's exclusion reasons to one report bucket. The
+// order matters: a `__Host-` cookie with a Domain is a prefix failure first.
+CookieRejectReason ReasonForSanitizeFailure(
+    const net::CookieInclusionStatus& status) {
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_PREFIX)) {
+    return CookieRejectReason::kInvalidPrefix;
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_PARTITIONED)) {
+    return CookieRejectReason::kPartitionedInsecure;
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_DOMAIN) ||
+      status.HasExclusionReason(ExclusionReason::EXCLUDE_DOMAIN_NON_ASCII)) {
+    return CookieRejectReason::kInvalidDomain;
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_PATH)) {
+    return CookieRejectReason::kInvalidPath;
+  }
+  if (status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_DISALLOWED_CHARACTER) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_NAME_VALUE_PAIR_EXCEEDS_MAX_SIZE) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_ATTRIBUTE_VALUE_EXCEEDS_MAX_SIZE) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_AMBIGUOUS_SERIALIZATION) ||
+      status.HasExclusionReason(ExclusionReason::EXCLUDE_NO_COOKIE_CONTENT)) {
+    return CookieRejectReason::kInvalidNameOrValue;
+  }
+  return CookieRejectReason::kNonCanonical;
+}
+
+CookieRejectReason ReasonForStoreFailure(
+    const net::CookieInclusionStatus& status) {
+  if (status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_SAMESITE_NONE_INSECURE)) {
+    return CookieRejectReason::kSameSiteNoneInsecure;
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_OVERWRITE_SECURE) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_OVERWRITE_HTTP_ONLY)) {
+    return CookieRejectReason::kWouldOverwriteProtected;
+  }
+  return CookieRejectReason::kStoreRefused;
+}

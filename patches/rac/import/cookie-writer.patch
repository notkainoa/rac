+TEST_F(CookieWriterTest, RetriesDroppedBatchOnceOnNewManager) {
+  // A network service restart with a whole batch in flight: the old remote
+  // drops every pending callback and the getter returns a new manager.
+  FakeCookieManager old_manager(FakeCookieManager::Mode::kHold);
+  FakeCookieManager new_manager(FakeCookieManager::Mode::kAccept);
+  network::mojom::CookieManager* current = &old_manager;
+  CookieWriter writer(
+      base::BindLambdaForTesting(
+          [&]() -> network::mojom::CookieManager* { return current; }),
+      AllowAll());
+
+  const size_t kCount = CookieWriter::kBatchSize + 10;
+  base::test::TestFuture<const CookieWriteReport&> done;
+  writer.Write(ManyCookies(kCount), done.GetCallback());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return old_manager.held_sets() == CookieWriter::kBatchSize;
+  }));
+
+  current = &new_manager;
+  old_manager.DropHeldCalls();
+  EXPECT_FALSE(done.IsReady());
+
+  const CookieWriteReport& report = done.Get();
+  EXPECT_EQ(report.total, kCount);
+  EXPECT_EQ(report.set, kCount);
+  EXPECT_EQ(report.rejected_total(), 0u);
+  EXPECT_EQ(old_manager.set_calls(), CookieWriter::kBatchSize);
+  // The dropped batch again, then the 10 never sent.
+  EXPECT_EQ(new_manager.set_calls(), kCount);
+  EXPECT_EQ(old_manager.flush_calls(), 0u);
+  EXPECT_EQ(new_manager.flush_calls(), 1u);
+}

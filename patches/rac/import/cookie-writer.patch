+TEST_F(CookieWriterTest, ReportCountsEveryOutcome) {
+  // rac already has a newer "j".
+  ImportedCookie in_rac = MakeCookie("j", "example.test");
+  in_rac.creation = base::Time::Now() - base::Days(1);
+  SeedCookie(in_rac);
+
+  std::vector<ImportedCookie> cookies;
+  cookies.push_back(MakeCookie("a", "example.test"));
+  cookies.push_back(MakeCookie("b", ".example.test"));
+  ImportedCookie expired = MakeCookie("c", "example.test");
+  expired.expiry = base::Time::Now() - base::Days(1);
+  cookies.push_back(expired);
+  cookies.push_back(MakeCookie("__Host-d", ".example.test"));
+  cookies.push_back(MakeCookie("__Secure-e", "example.test", /*secure=*/false));
+  ImportedCookie bad_key = MakeCookie("f", "example.test");
+  bad_key.partition_key = "::";
+  cookies.push_back(bad_key);
+  cookies.push_back(MakeCookie("g", ".test"));  // Public suffix.
+  ImportedCookie bad_value = MakeCookie("h", "example.test");
+  bad_value.value = "semi;colon";
+  cookies.push_back(bad_value);
+  ImportedCookie none_insecure =
+      MakeCookie("i", "example.test", /*secure=*/false);
+  none_insecure.same_site = net::CookieSameSite::NO_RESTRICTION;
+  cookies.push_back(none_insecure);
+  ImportedCookie duplicate = MakeCookie("a", "example.test");
+  duplicate.creation = base::Time::Now() - base::Days(20);
+  cookies.push_back(duplicate);
+  cookies.push_back(MakeCookie("j", "example.test"));  // Older than rac's.
+  cookies.push_back(MakeCookie("k", "blocked.test"));
+  cookies.push_back(MakeCookie("l", "session.test"));
+
+  const CookieWriteReport report = Write(
+      std::move(cookies),
+      base::BindRepeating([](const net::CanonicalCookie& cookie, const GURL&) {
+        if (cookie.Domain() == "blocked.test") {
+          return CookieSettingsDecision::kBlock;
+        }
+        if (cookie.Domain() == "session.test") {
+          return CookieSettingsDecision::kClearOnExit;
+        }
+        return CookieSettingsDecision::kAllow;
+      }));
+  EXPECT_EQ(report.total, 13u);
+  EXPECT_EQ(report.set, 2u);
+  EXPECT_EQ(report.skipped_expired, 1u);
+  EXPECT_EQ(report.skipped_duplicate, 1u);

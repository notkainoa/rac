+TEST_F(CookieWriterTest, WriteTwiceCrashes) {
+  FakeCookieManager manager(FakeCookieManager::Mode::kAccept);
+  std::unique_ptr<CookieWriter> writer =
+      CookieWriter::CreateForTesting(&manager);
+  base::test::TestFuture<const CookieWriteReport&> done;
+  writer->Write({}, done.GetCallback());
+  ASSERT_TRUE(done.Wait());
+  // `done_` is empty again here, so only `started_` catches this.
+  EXPECT_CHECK_DEATH(writer->Write({}, base::DoNothing()));
+}

+TEST(CookieWriterPrepareTest, SkipCookiesNotNewerThanMatchesByLegacyKey) {
+  const base::Time now = base::Time::Now();
+  ImportedCookie older = MakeCookie("older", "example.test");
+  older.creation = now - base::Days(5);
+  ImportedCookie tie = MakeCookie("tie", "example.test");
+  tie.creation = now - base::Days(3);
+  ImportedCookie newer = MakeCookie("newer", "example.test");
+  newer.creation = now - base::Days(1);
+  ImportedCookie unrelated = MakeCookie("unrelated", "example.test");
+
+  // rac's copies were set over http on another port. The store treats them
+  // as the same cookies, so the comparison does too.
+  auto rac_copy = [&](const std::string& name, base::Time creation) {
+    ImportedCookie in_rac = MakeCookie(name, "example.test", /*secure=*/false);
+    in_rac.source_port = 8080;
+    in_rac.creation = creation;
+    in_rac.last_access = creation;
+    internal::PrepareResult result = internal::PrepareCookies({in_rac}, now);
+    CHECK_EQ(result.ready.size(), 1u);
+    return result.ready[0].cookie;
+  };
+  std::vector<net::CanonicalCookie> existing = {
+      rac_copy("older", now - base::Days(3)),
+      rac_copy("tie", now - base::Days(3)),
+      rac_copy("newer", now - base::Days(3)),
+  };
+
+  internal::PrepareResult result = internal::SkipCookiesNotNewerThan(
+      internal::PrepareCookies({older, tie, newer, unrelated}, now),
+      std::move(existing));
+  EXPECT_EQ(result.report.total, 4u);
+  EXPECT_EQ(result.report.skipped_newer_in_rac, 2u);
+  ASSERT_EQ(result.ready.size(), 2u);
+  // Still oldest first.
+  EXPECT_EQ(result.ready[0].cookie.Name(), "unrelated");
+  EXPECT_EQ(result.ready[1].cookie.Name(), "newer");
+}

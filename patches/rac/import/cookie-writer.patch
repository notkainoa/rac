+ImportedCookie::ImportedCookie() = default;
+ImportedCookie::ImportedCookie(const ImportedCookie&) = default;
+ImportedCookie::ImportedCookie(ImportedCookie&&) = default;
+ImportedCookie& ImportedCookie::operator=(const ImportedCookie&) = default;
+ImportedCookie& ImportedCookie::operator=(ImportedCookie&&) = default;
+ImportedCookie::~ImportedCookie() = default;
+
+size_t CookieWriteReport::rejected_total() const {
+  return std::accumulate(rejected.begin(), rejected.end(), size_t{0});
+}
+
+namespace internal {
+
+PrepareResult::PrepareResult() = default;
+PrepareResult::PrepareResult(PrepareResult&&) = default;
+PrepareResult& PrepareResult::operator=(PrepareResult&&) = default;
+PrepareResult::~PrepareResult() = default;
+
+// Keeps the source scheme and port. The host check means a malformed
+// `host_key` such as "a.test@b.test" can't plant a cookie on another site.
+std::optional<GURL> SourceUrlFor(const ImportedCookie& in) {
+  std::string_view host = in.host_key;
+  if (host.starts_with('.')) {
+    host.remove_prefix(1);
+  }
+  if (host.empty()) {
+    return std::nullopt;
+  }
+
+  const bool https =
+      in.secure || in.source_scheme == net::CookieSourceScheme::kSecure;
+  const int default_port = https ? 443 : 80;
+  std::string port;
+  if (in.source_port > 0 && in.source_port <= kMaxPort &&
+      in.source_port != default_port) {
+    port = base::StrCat({":", base::NumberToString(in.source_port)});
+  }
+
+  GURL url(base::StrCat({https ? "https" : "http", "://", host, port, "/"}));
+  if (!url.is_valid() || !url.has_host() || url.has_username() ||
+      url.has_password() ||
+      !base::EqualsCaseInsensitiveASCII(url.host(), host)) {
+    return std::nullopt;
+  }
+  return url;
+}
+
+PrepareResult PrepareCookies(std::vector<ImportedCookie> cookies,
+                             base::Time now) {
+  PrepareResult result;
+  result.ready.reserve(cookies.size());
+  CookieWriteReport& report = result.report;
+
+  for (ImportedCookie& in : cookies) {
+    ++report.total;
+
+    in.same_site = KnownSameSite(in.same_site);
+    in.priority = KnownPriority(in.priority);
+    in.source_scheme = KnownSourceScheme(in.source_scheme);
+
+    if (!in.expiry.is_null() && in.expiry <= now) {
+      ++report.skipped_expired;
+      continue;
+    }
+
+    std::optional<net::CookiePartitionKey> partition_key;
+    if (!in.partition_key.empty()) {
+      // Strict parsing: the string must be exactly a serialized schemeful
+      // site, as Chromium writes it to `top_frame_site_key`.
+      auto parsed = net::CookiePartitionKey::FromStorage(
+          in.partition_key, in.has_cross_site_ancestor);
+      if (!parsed.has_value() || !parsed->has_value()) {
+        report.AddRejected(CookieRejectReason::kInvalidPartitionKey);
+        continue;
+      }
+      partition_key = std::move(*parsed);
+    }
+
+    std::optional<GURL> source_url = SourceUrlFor(in);
+    if (!source_url) {
+      report.AddRejected(CookieRejectReason::kInvalidDomain);
+      continue;
+    }
+
+    // Keep the source's times but never in the future, and never with a last
+    // access before creation. CreateSanitizedCookie refuses a non-null last
+    // access with a null creation, so creation is always filled in.
+    const base::Time creation =
+        (in.creation.is_null() || in.creation > now) ? now : in.creation;
+    const base::Time last_access =
+        in.last_access.is_null()
+            ? creation
+            : std::clamp(in.last_access, creation, now);
+
+    // A host-only cookie has no Domain attribute; a domain cookie's
+    // `host_key` is its Domain attribute.
+    const std::string domain_attribute =
+        in.host_key.starts_with('.') ? in.host_key : std::string();
+
+    net::CookieInclusionStatus status;
+    std::unique_ptr<net::CanonicalCookie> cookie =
+        net::CanonicalCookie::CreateSanitizedCookie(
+            *source_url, in.name, in.value, domain_attribute, in.path,
+            creation, in.expiry, last_access, in.secure, in.http_only,
+            in.same_site, in.priority, std::move(partition_key), &status);
+    if (!cookie) {
+      report.AddRejected(ReasonForSanitizeFailure(status));
+      continue;
+    }
+    // CreateSanitizedCookie only DCHECKs this.
+    if (!cookie->IsCanonical()) {
+      report.AddRejected(CookieRejectReason::kNonCanonical);
+      continue;
+    }
+    // CreateSanitizedCookie quietly turns a domain cookie on a public suffix
+    // (".test", ".co.uk") or an IP address into a host-only cookie. Only
+    // import cookies whose domain survives the conversion unchanged.
+    if (cookie->Domain() != base::ToLowerASCII(in.host_key)) {
+      report.AddRejected(CookieRejectReason::kInvalidDomain);
+      continue;
+    }
+    // A key without a cross-site ancestor means the top-level site set the
+    // cookie for itself, so the cookie's own site has to be that site.
+    // Otherwise the store accepts a cookie that no request can ever read.
+    if (cookie->IsPartitioned() && !cookie->PartitionKey()->IsThirdParty() &&
+        net::SchemefulSite(*source_url) != cookie->PartitionKey()->site()) {
+      report.AddRejected(CookieRejectReason::kInvalidPartitionKey);
+      continue;
+    }
+    // CreateSanitizedCookie caps expiry at creation + 400 days, which can put
+    // an old cookie in the past. The store would accept it and drop it
+    // silently, so count it here instead.
+    if (cookie->IsExpired(now)) {
+      ++report.skipped_expired;
+      continue;
+    }
+
+    result.ready.push_back(
+        {std::move(*cookie), std::move(source_url).value()});
+  }
+
+  std::ranges::stable_sort(result.ready, {}, [](const PreparedCookie& p) {
+    return p.cookie.CreationDate();
+  });
+
+  // Rows that differ only in source scheme or port are one cookie to the
+  // store, which would keep whichever came last and still count both as set.
+  // Keep the newest; on a tie, the one listed later. Cookies already in rac
+  // are compared later, in SkipCookiesNotNewerThan().
+  std::set<net::UniqueCookieKey> seen;
+  std::vector<PreparedCookie> kept;
+  kept.reserve(result.ready.size());
+  for (auto it = result.ready.rbegin(); it != result.ready.rend(); ++it) {
+    if (!seen.insert(it->cookie.LegacyUniqueKey()).second) {
+      ++report.skipped_duplicate;
+      continue;
+    }
+    kept.push_back(std::move(*it));
+  }
+  // Back to oldest first, so the order is the same on every run.
+  std::ranges::reverse(kept);
+  result.ready = std::move(kept);
+  return result;
+}
+
+PrepareResult SkipCookiesNotNewerThan(
+    PrepareResult prepared,
+    std::vector<net::CanonicalCookie> existing) {
+  // The same key the dedupe above uses. With scheme- and port-bound cookies
+  // off (the default in 156) it's also the key the store replaces by; with
+  // them on it's coarser, which only ever keeps more of rac's cookies.
+  std::map<net::UniqueCookieKey, base::Time> newest_in_rac;
+  for (const net::CanonicalCookie& cookie : existing) {
+    auto [it, inserted] =
+        newest_in_rac.try_emplace(cookie.LegacyUniqueKey(),
+                                  cookie.CreationDate());
+    if (!inserted) {
+      it->second = std::max(it->second, cookie.CreationDate());
+    }
+  }
+  // rac's cookie values aren't needed past this point.
+  existing.clear();
+  existing.shrink_to_fit();
+
+  std::vector<PreparedCookie> kept;
+  kept.reserve(prepared.ready.size());
+  for (PreparedCookie& candidate : prepared.ready) {
+    auto it = newest_in_rac.find(candidate.cookie.LegacyUniqueKey());
+    // A tie keeps rac's: it's the cookie the user's sites see today.
+    if (it != newest_in_rac.end() &&
+        it->second >= candidate.cookie.CreationDate()) {
+      ++prepared.report.skipped_newer_in_rac;
+      continue;
+    }
+    kept.push_back(std::move(candidate));
+  }
+  prepared.ready = std::move(kept);
+  return prepared;
+}
+
+}  // namespace internal
+
+// static
+std::unique_ptr<CookieWriter> CookieWriter::CreateForTesting(
+    network::mojom::CookieManager* cookie_manager,
+    CookieSettingsFilter settings_filter) {
+  CHECK(cookie_manager);
+  if (!settings_filter) {
+    settings_filter = base::BindRepeating(
+        [](const net::CanonicalCookie&, const GURL&) {
+          return CookieSettingsDecision::kAllow;
+        });
+  }
+  return std::make_unique<CookieWriter>(
+      base::BindRepeating(
+          [](network::mojom::CookieManager* manager) { return manager; },
+          base::Unretained(cookie_manager)),
+      std::move(settings_filter));
+}
+
+CookieWriter::CookieWriter(CookieManagerGetter get_cookie_manager,
+                           CookieSettingsFilter settings_filter)
+    : get_cookie_manager_(std::move(get_cookie_manager)),
+      settings_filter_(std::move(settings_filter)) {
+  CHECK(get_cookie_manager_);
+  CHECK(settings_filter_);
+}
+
+CookieWriter::~CookieWriter() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
+
+void CookieWriter::Write(std::vector<ImportedCookie> cookies,
+                         DoneCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // `done_` is empty again once it has run, so it can't guard this.
+  CHECK(!started_);
+  started_ = true;
+  CHECK(done);
+  done_ = std::move(done);
+
+  // Parsing and canonicalizing a few thousand cookies takes long enough to
+  // drop frames, so keep it off the UI thread.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&internal::PrepareCookies, std::move(cookies),
+                     base::Time::Now()),
+      base::BindOnce(&CookieWriter::OnPrepared,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void CookieWriter::OnPrepared(internal::PrepareResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  report_ = result.report;
+  pending_ = std::move(result.ready);
+  next_ = 0;
+  if (pending_.empty()) {
+    Finish();
+    return;
+  }
+  ReadExistingCookies();
+}
+
+void CookieWriter::ReadExistingCookies() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  network::mojom::CookieManager* cookie_manager = get_cookie_manager_.Run();
+  if (!cookie_manager) {
+    FailUnsentCookies();
+    return;
+  }
+  // One read of every cookie in the profile, partitioned ones included. The
+  // store holds at most a few thousand, so this is one round trip; a
+  // GetCookieList() per host would be hundreds, and it matches by URL rather
+  // than by exact name, domain, path and partition key.
+  cookie_manager->GetAllCookies(mojo::WrapCallbackWithDropHandler(
+      base::BindOnce(&CookieWriter::OnExistingCookies,
+                     weak_factory_.GetWeakPtr()),
+      base::BindOnce(&CookieWriter::OnExistingCookiesDropped,
+                     weak_factory_.GetWeakPtr())));
+}
+
+void CookieWriter::OnExistingCookies(
+    const std::vector<net::CanonicalCookie>& existing) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  internal::PrepareResult prepared;
+  prepared.ready = std::move(pending_);
+  prepared.report = report_;
+  pending_.clear();
+  // Building the key map and checking a few thousand cookies against it is
+  // kept off the UI thread too. `existing` is copied into the task.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&internal::SkipCookiesNotNewerThan, std::move(prepared),
+                     existing),
+      base::BindOnce(&CookieWriter::OnComparedWithExisting,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void CookieWriter::OnExistingCookiesDropped() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The pipe closed or the network service restarted. This can run while the
+  // remote is being destroyed, so only post. Without the read the writer
+  // can't tell which imports are older than rac's, so a second loss fails
+  // the import rather than overwrite blindly.
+  if (read_retried_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CookieWriter::FailUnsentCookies,
+                                  weak_factory_.GetWeakPtr()));
+    return;
+  }
+  read_retried_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CookieWriter::ReadExistingCookies,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void CookieWriter::OnComparedWithExisting(internal::PrepareResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  report_ = result.report;
+  pending_ = std::move(result.ready);
+  next_ = 0;
+  ContinueOrFinish();
+}
+
+void CookieWriter::FailUnsentCookies() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK_EQ(in_flight_, 0u);
+  for (size_t i = 0; i < retry_.size(); ++i) {
+    report_.AddRejected(CookieRejectReason::kStoreRefused);
+  }
+  retry_.clear();
+  for (; next_ < pending_.size(); ++next_) {
+    report_.AddRejected(CookieRejectReason::kStoreRefused);
+  }
+  Finish();
+}
+
+void CookieWriter::PostContinueOrFinish() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Post rather than recurse, so the UI thread gets a turn between batches
+  // and a synchronous fake or a dying pipe can't re-enter SendNextBatch().
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CookieWriter::ContinueOrFinish,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void CookieWriter::ContinueOrFinish() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!retry_.empty() || next_ < pending_.size()) {
+    SendNextBatch();
+  } else {
+    Finish();
+  }
+}
+
+void CookieWriter::SendNextBatch() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK_EQ(in_flight_, 0u);
+  DCHECK(dropped_.empty());
+
+  network::mojom::CookieManager* cookie_manager = get_cookie_manager_.Run();
+  if (!cookie_manager) {
+    FailUnsentCookies();
+    return;
+  }
+
+  // A batch is either a one-time resend of calls the last batch lost to a
+  // dropped connection, or the next new cookies that rac's cookie settings
+  // allow. Resent cookies were already checked.
+  std::vector<size_t> batch;
+  retrying_ = !retry_.empty();
+  if (retrying_) {
+    batch.swap(retry_);
+  } else {
+    // Settings are read now, not at the start, so a change the user makes
+    // mid-import applies to every batch not yet sent. At most kBatchSize
+    // cookies are checked per task.
+    const size_t end = std::min(next_ + kBatchSize, pending_.size());
+    batch.reserve(end - next_);
+    for (; next_ < end; ++next_) {
+      const internal::PreparedCookie& prepared = pending_[next_];
+      switch (settings_filter_.Run(prepared.cookie, prepared.source_url)) {
+        case CookieSettingsDecision::kAllow:
+          batch.push_back(next_);
+          break;
+        case CookieSettingsDecision::kBlock:
+          ++report_.skipped_blocked_by_settings;
+          break;
+        case CookieSettingsDecision::kClearOnExit:
+          ++report_.skipped_clear_on_exit;
+          break;
+      }
+    }
+    if (batch.empty()) {
+      // Every cookie in this stretch was skipped. Move on in a new task, as
+      // after a batch.
+      PostContinueOrFinish();
+      return;
+    }
+  }
+
+  const net::CookieOptions options = ImportCookieOptions();
+  // Set before sending: a fake manager may answer, or a dead pipe may drop the
+  // callback, synchronously.
+  in_flight_ = batch.size();
+  for (size_t index : batch) {
+    const internal::PreparedCookie& prepared = pending_[index];
+    // A lost connection destroys the callback without running it, which
+    // calls OnCookieDropped() instead. That can happen synchronously while
+    // the pipe is torn down, so neither path may finish the import directly.
+    cookie_manager->SetCanonicalCookie(
+        prepared.cookie, prepared.source_url, options,
+        mojo::WrapCallbackWithDropHandler(
+            base::BindOnce(&CookieWriter::OnCookieSet,
+                           weak_factory_.GetWeakPtr()),
+            base::BindOnce(&CookieWriter::OnCookieDropped,
+                           weak_factory_.GetWeakPtr(), index)));
+  }
+}
+
+void CookieWriter::OnCookieSet(net::CookieAccessResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (result.status.IsInclude()) {
+    ++report_.set;
+  } else {
+    report_.AddRejected(ReasonForStoreFailure(result.status));
+  }
+  OnBatchItemDone();
+}
+
+void CookieWriter::OnCookieDropped(size_t index) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The network service restarted or the pipe closed. Resend once, on
+  // whatever manager the getter returns next; a second loss is final.
+  if (retrying_) {
+    report_.AddRejected(CookieRejectReason::kStoreRefused);
+  } else {
+    dropped_.push_back(index);
+  }
+  OnBatchItemDone();
+}
+
+void CookieWriter::OnBatchItemDone() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK_GT(in_flight_, 0u);
+  if (--in_flight_ != 0) {
+    return;
+  }
+  retry_ = std::move(dropped_);
+  dropped_.clear();
+  PostContinueOrFinish();
+}
+
+void CookieWriter::Finish() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Drop the cookie values as soon as they're no longer needed.
+  pending_.clear();
+  pending_.shrink_to_fit();
+
+  DCHECK_EQ(report_.total, report_.set + report_.skipped_total() +
+                               report_.rejected_total());
+  // Counts only. Never log names, values or hosts.
+  VLOG(1) << "rac import: cookies total=" << report_.total
+          << " set=" << report_.set
+          << " skipped_expired=" << report_.skipped_expired
+          << " skipped_duplicate=" << report_.skipped_duplicate
+          << " skipped_newer_in_rac=" << report_.skipped_newer_in_rac
+          << " skipped_blocked_by_settings="
+          << report_.skipped_blocked_by_settings
+          << " skipped_clear_on_exit=" << report_.skipped_clear_on_exit
+          << " rejected=" << report_.rejected_total();
+
+  network::mojom::CookieManager* cookie_manager =
+      report_.set > 0 ? get_cookie_manager_.Run() : nullptr;
+  if (!cookie_manager) {
+    OnFlushed();
+    return;
+  }
+  // Commit to disk now instead of within the store's usual 30 seconds, so a
+  // crash right after import doesn't lose it. If the pipe drops first, the
+  // callback runs anyway, possibly while the remote is being destroyed.
+  cookie_manager->FlushCookieStore(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce(&CookieWriter::OnFlushed, weak_factory_.GetWeakPtr())));
+}
+
+void CookieWriter::OnFlushed() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Always a fresh task: this can run from inside a remote's destructor during
+  // profile teardown or a network service restart, and `done` must not.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&CookieWriter::RunDone, weak_factory_.GetWeakPtr()));
+}
+
+void CookieWriter::RunDone() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Copy first: `done_` may delete this writer, and `report_` with it.
+  const CookieWriteReport report = report_;
+  std::move(done_).Run(report);
+}
+

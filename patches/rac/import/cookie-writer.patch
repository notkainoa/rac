+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_constants.h"
+#include "url/gurl.h"
+
+namespace net {
+struct CookieAccessResult;
+}  // namespace net
+
+namespace network::mojom {
+class CookieManager;
+}  // namespace network::mojom
+
+namespace rac::import {
+
+// One cookie as the source reader hands it over. Field meanings match
+// Chromium's `cookies` table; the reader has already decrypted the value and
+// converted times from Windows-epoch microseconds to base::Time.
+struct ImportedCookie {
+  ImportedCookie();
+  ImportedCookie(const ImportedCookie&);
+  ImportedCookie(ImportedCookie&&);
+  ImportedCookie& operator=(const ImportedCookie&);
+  ImportedCookie& operator=(ImportedCookie&&);
+  ~ImportedCookie();
+
+  std::string name;
+  std::string value;
+  // `host_key`: "example.com" for a host-only cookie, ".example.com" for a
+  // domain cookie, "192.0.2.1" or "[2001:db8::1]" for an IP host.
+  std::string host_key;
+  std::string path;
+  base::Time creation;
+  // Null means a session cookie.
+  base::Time expiry;
+  base::Time last_access;
+  bool secure = false;
+  bool http_only = false;
+  // The three enums below may hold any value the source DB had, including
+  // ones this Chromium doesn't know. The writer maps unknown values to
+  // UNSPECIFIED, MEDIUM and kUnset.
+  net::CookieSameSite same_site = net::CookieSameSite::UNSPECIFIED;
+  net::CookiePriority priority = net::COOKIE_PRIORITY_DEFAULT;
+  net::CookieSourceScheme source_scheme = net::CookieSourceScheme::kUnset;
+  // -1 (url::PORT_UNSPECIFIED) when unknown.
+  int source_port = -1;
+  // `top_frame_site_key`, such as "https://example.com". Empty means the
+  // cookie is unpartitioned.
+  std::string partition_key;
+  // `has_cross_site_ancestor`. Only read when `partition_key` is set.
+  bool has_cross_site_ancestor = true;
+};
+
+// Why a cookie was not written. Reported as counts only.
+enum class CookieRejectReason {
+  // `partition_key` is set but is not a serialized schemeful site, or it has
+  // no cross-site ancestor and names a different site than the cookie's host.
+  kInvalidPartitionKey = 0,
+  // Breaks a `__Host-`, `__Secure-`, `__Http-` or `__Host-Http-` rule.
+  kInvalidPrefix,
+  // Partitioned without Secure.
+  kPartitionedInsecure,
+  // `host_key` is empty, a public suffix, malformed, or names another host.
+  kInvalidDomain,
+  kInvalidPath,
+  // Disallowed characters, over the size limits, or an ambiguous
+  // empty-name cookie.
+  kInvalidNameOrValue,
+  // Built, but CanonicalCookie::IsCanonical() still failed.
+  kNonCanonical,
+  // The store refused SameSite=None without Secure.
+  kSameSiteNoneInsecure,
+  // The store refused to replace an existing Secure or HttpOnly cookie.
+  kWouldOverwriteProtected,
+  // Any other store refusal, a missing cookie manager, or a call dropped
+  // twice by a lost network service connection. Losing the read of rac's
+  // existing cookies twice fails every cookie this way.
+  kStoreRefused,
+  kMaxValue = kStoreRefused,
+};
+
+struct CookieWriteReport {
+  size_t total = 0;
+  // Accepted by the cookie store. The store can still evict some later if the
+  // profile goes over its per-domain or global cookie limits.
+  size_t set = 0;
+  // Expired on arrival, or expired once capped to 400 days after creation.
+  size_t skipped_expired = 0;
+  // Another row had the same name, domain, path and partition key and a
+  // newer (or equal, later-listed) creation time.
+  size_t skipped_duplicate = 0;
+  // rac already had a cookie with the same name, domain, path and partition
+  // key, created at the same time or later. rac's is kept.
+  size_t skipped_newer_in_rac = 0;
+  // rac's cookie settings block the cookie's site, or block all cookies by
+  // default.
+  size_t skipped_blocked_by_settings = 0;
+  // rac's cookie settings clear the cookie's site, or every site, on exit.
+  size_t skipped_clear_on_exit = 0;
+  std::array<size_t, static_cast<size_t>(CookieRejectReason::kMaxValue) + 1>
+      rejected = {};
+
+  size_t rejected_count(CookieRejectReason reason) const {
+    return rejected[static_cast<size_t>(reason)];
+  }
+  size_t rejected_total() const;
+  size_t skipped_total() const {
+    return skipped_expired + skipped_duplicate + skipped_newer_in_rac +
+           skipped_blocked_by_settings + skipped_clear_on_exit;
+  }
+  void AddRejected(CookieRejectReason reason) {
+    ++rejected[static_cast<size_t>(reason)];
+  }
+};
+
+// What the target profile's cookie settings say about one imported cookie.
+enum class CookieSettingsDecision {
+  kAllow,
+  // Counted as `skipped_blocked_by_settings`.
+  kBlock,
+  // Counted as `skipped_clear_on_exit`.
+  kClearOnExit,
+};
+
+// Asks the target profile's cookie settings about `cookie`, which the writer
+// would set from `source_url`. Runs on the UI thread, in the task that sends
+// the cookie's batch, so it sees the settings as they are then. Must not
+// re-enter the writer. CookieSettingsFilterForImport() builds the real one.
+using CookieSettingsFilter =
+    base::RepeatingCallback<CookieSettingsDecision(
+        const net::CanonicalCookie& cookie,
+        const GURL& source_url)>;
+
+namespace internal {
+
+struct PreparedCookie {
+  net::CanonicalCookie cookie;
+  GURL source_url;
+};
+
+struct PrepareResult {
+  PrepareResult();
+  PrepareResult(PrepareResult&&);
+  PrepareResult& operator=(PrepareResult&&);
+  ~PrepareResult();
+
+  // Oldest first, with no two sharing a name, domain, path and partition key.
+  std::vector<PreparedCookie> ready;
+  // PrepareCookies() fills in `total`, `skipped_expired`, `skipped_duplicate`
+  // and the pre-store rejections; SkipCookiesNotNewerThan() adds
+  // `skipped_newer_in_rac`.
+  CookieWriteReport report;
+};
+
+// Validates and converts `cookies`. Pure and thread-safe; runs on the thread
+// pool. Exposed for tests.
+PrepareResult PrepareCookies(std::vector<ImportedCookie> cookies,
+                             base::Time now);
+
+// Drops every cookie in `prepared.ready` that matches a cookie in `existing`
+// by LegacyUniqueKey() (name, domain, path, partition key) when that existing
+// cookie was created at the same time or later, and counts it as
+// `skipped_newer_in_rac`. Keeps the order of the rest. Pure and thread-safe;
+// runs on the thread pool. Exposed for tests.
+PrepareResult SkipCookiesNotNewerThan(
+    PrepareResult prepared,
+    std::vector<net::CanonicalCookie> existing);
+
+// Rebuilds the URL `cookie` could have come from. Returns nullopt unless the
+// URL's host is exactly the cookie's host. Exposed for tests, since later
+// checks in PrepareCookies() reject the same inputs.
+std::optional<GURL> SourceUrlFor(const ImportedCookie& cookie);
+
+}  // namespace internal
+
+// Writes imported cookies into one profile's cookie store through the public
+// CookieManager mojo interface. Lives on the UI thread. Deleting the writer
+// cancels the import; `done` then never runs.
+//
+// In order: validate (thread pool), read rac's cookies once with
+// GetAllCookies() and drop imports that aren't newer (thread pool), then send
+// in batches, asking `settings_filter` about each cookie just before its batch
+// goes out.
+class CookieWriter {
+ public:
+  // Called before every batch, so a network service restart is picked up.
+  // May return null, which fails the rest of the import.
+  using CookieManagerGetter =
+      base::RepeatingCallback<network::mojom::CookieManager*()>;
+  using DoneCallback = base::OnceCallback<void(const CookieWriteReport&)>;
+
+  // How many SetCanonicalCookie calls are in flight at once. The writer waits
+  // for a whole batch to be acknowledged before sending the next.
+  static constexpr size_t kBatchSize = 250;
+
+  // Always writes to `cookie_manager`, which must outlive the writer. A null
+  // `settings_filter` allows every cookie. Real callers use
+  // CreateCookieWriterForImport(), which passes the profile's getter and
+  // filter.
+  static std::unique_ptr<CookieWriter> CreateForTesting(
+      network::mojom::CookieManager* cookie_manager,
+      CookieSettingsFilter settings_filter = CookieSettingsFilter());
+
+  // Both must be non-null.
+  CookieWriter(CookieManagerGetter get_cookie_manager,
+               CookieSettingsFilter settings_filter);
+  CookieWriter(const CookieWriter&) = delete;
+  CookieWriter& operator=(const CookieWriter&) = delete;
+  ~CookieWriter();
+
+  // Call once. `done` always runs in its own task, never from inside Write()
+  // or from a mojo pipe being torn down, and may delete the writer.
+  void Write(std::vector<ImportedCookie> cookies, DoneCallback done);
+
+ private:
+  void OnPrepared(internal::PrepareResult result);
+  void ReadExistingCookies();
+  void OnExistingCookies(const std::vector<net::CanonicalCookie>& existing);
+  void OnExistingCookiesDropped();
+  void OnComparedWithExisting(internal::PrepareResult result);
+  void FailUnsentCookies();
+  void PostContinueOrFinish();
+  void ContinueOrFinish();
+  void SendNextBatch();
+  void OnCookieSet(net::CookieAccessResult result);
+  void OnCookieDropped(size_t index);
+  void OnBatchItemDone();
+  void Finish();
+  void OnFlushed();
+  void RunDone();
+
+  CookieManagerGetter get_cookie_manager_;
+  CookieSettingsFilter settings_filter_;
+  bool started_ = false;
+  // Whether the read of rac's existing cookies was already lost once.
+  bool read_retried_ = false;
+  std::vector<internal::PreparedCookie> pending_;
+  // The next index in `pending_` that has never been checked against the
+  // settings filter or sent.
+  size_t next_ = 0;
+  size_t in_flight_ = 0;
+  // Whether the batch in flight is a resend of dropped calls.
+  bool retrying_ = false;
+  // Indexes in `pending_` whose calls the current batch lost to a dropped
+  // connection.
+  std::vector<size_t> dropped_;
+  // Indexes to resend, once, before any new cookies.
+  std::vector<size_t> retry_;
+  CookieWriteReport report_;
+  DoneCallback done_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<CookieWriter> weak_factory_{this};
+};
+
+}  // namespace rac::import

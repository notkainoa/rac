+void SpacesService::RestoreSpace(Space space, size_t index) {
+  CHECK(space.id.is_valid());
+  const base::Uuid id = space.id;
+  auto it = FindIterator(id);
+  if (it == spaces_.end()) {
+    index = std::min(index, spaces_.size());
+    spaces_.insert(spaces_.begin() + index, std::move(space));
+    Save();
+    for (Observer& observer : observers_) {
+      observer.OnSpaceAdded(id);
+    }
+    return;
+  }
+
+  // Upsert: take the old entry out, put `space` where it should be, and
+  // report only what changed.
+  const size_t old_index = static_cast<size_t>(it - spaces_.begin());
+  const bool renamed = it->name != space.name;
+  const bool appearance = it->icon != space.icon ||
+                          it->theme.ToDict() != space.theme.ToDict();
+  spaces_.erase(it);
+  index = std::min(index, spaces_.size());
+  spaces_.insert(spaces_.begin() + index, std::move(space));
+  Save();
+  if (appearance) {
+    for (Observer& observer : observers_) {
+      observer.OnSpaceAppearanceChanged(id);
+    }
+  }
+  if (renamed) {
+    for (Observer& observer : observers_) {
+      observer.OnSpaceRenamed(id);
+    }
+  }
+  if (index != old_index) {
+    for (Observer& observer : observers_) {
+      observer.OnSpacesReordered();
+    }
+  }
+}

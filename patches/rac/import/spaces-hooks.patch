+void SpacesWindowManager::MoveWindowTabs(const base::Uuid& from,
+                                         const base::Uuid& to) {
+  if (from == to || !spaces_->FindSpace(from) || !spaces_->FindSpace(to)) {
+    return;
+  }
+  // Retag every live tab of `from`, wherever it sits. TagTab also rewrites
+  // the session service's per-tab extra data, so a later session restore
+  // doesn't put them back in `from`. Groups and splits keep their members:
+  // a group belongs to one space, so all of `from`'s move together.
+  std::vector<WindowState*> affected;
+  for (auto* tab : GetSpaceTabs(from)) {
+    TagTab(tab, to);
+    WindowState* state = FindState(tab->GetBrowserWindowInterface());
+    if (state && !std::ranges::contains(affected, state)) {
+      affected.push_back(state);
+    }
+  }
+  // A window showing `from` now has no visible tabs of it; show `to` there.
+  // ShowSpace records the new window space in the session, and it reveals
+  // `to`'s tabs before the store merge below adds `from`'s stored ones.
+  for (const auto& [browser, state] : windows_) {
+    if (!state->closing && state->space == from) {
+      ShowSpace(const_cast<BrowserWindowInterface*>(browser), to);
+      // ShowSpace already refreshed and notified this window.
+      std::erase(affected, state.get());
+    }
+  }
+  // A space's tabs live either in a window or in the store; move the stored
+  // entry too. AddStoredTabs restores it into a window when `to` has live
+  // tabs, which the store merge would lose.
+  if (store_ready_) {
+    if (const StoredSpace* stored = store_.Find(from)) {
+      StoredSpace moved = CopyStoredSpace(*stored);
+      moved.space = to;
+      store_.Remove(from);
+      AddStoredTabs(std::move(moved));
+    }
+  }
+  hidden_since_.erase(from);
+  last_active_tabs_.erase(from);
+  for (WindowState* state : affected) {
+    RefreshVisibility(*state);
+    NotifyWindowSpaceChanged(state->browser);
+  }
+  UpdateUnloadTimer();
+}

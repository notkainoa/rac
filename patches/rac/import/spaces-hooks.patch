+void SpacesWindowManager::FlushStore(base::OnceClosure callback) {
+  if (!store_ready_) {
+    RunWhenStoreReady(base::BindOnce(&SpacesWindowManager::FlushStore,
+                                     weak_ptr_factory_.GetWeakPtr(),
+                                     std::move(callback)));
+    return;
+  }
+  // A hidden space's tabs stay live in a window's tab strip, and the store
+  // only learns of them when they leave a window (HandleWindowClosing) or
+  // at Shutdown. Snapshot them now, replacing each space's entry like a
+  // window closing does: the live tabs are the current copy, and a stale or
+  // appended entry can't outlive them. Tabs of a space a window shows
+  // persist through the session instead, as at quit.
+  std::map<base::Uuid, std::vector<tabs::TabInterface*>> hidden;
+  for (const auto& [browser, state] : windows_) {
+    if (state->closing) {
+      continue;
+    }
+    for (auto* tab : *browser->GetTabStripModel()) {
+      if (tab->IsPinned() || tab == state->placeholder_tab) {
+        continue;
+      }
+      if (auto space = SpaceTabTag::Get(tab->GetContents())) {
+        hidden[*space].push_back(tab);
+      }
+    }
+  }
+  for (const auto& [space, tabs] : hidden) {
+    if (GetWindowHoldingSpace(space)) {
+      continue;
+    }
+    tabs::TabInterface* active = nullptr;
+    if (auto it = last_active_tabs_.find(space);
+        it != last_active_tabs_.end()) {
+      active = it->second.Get();
+    }
+    store_.Put(SnapshotSpaceTabs(space, tabs, active));
+  }
+  store_.Flush(std::move(callback));

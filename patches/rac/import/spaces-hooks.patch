+void SpacesWindowManager::AddStoredTabs(StoredSpace stored) {
+  if (!store_ready_) {
+    DLOG(ERROR) << "AddStoredTabs before the store is ready; callers wait "
+                   "with RunWhenStoreReady.";
+    return;
+  }
+  if (!spaces_->FindSpace(stored.space)) {
+    return;
+  }
+  // A space with live tabs but no window showing it (hidden) still gets live
+  // tabs: a store entry beside live tabs is dropped when the space is shown
+  // again, so the tabs would be lost.
+  BrowserWindowInterface* holder = GetWindowHoldingSpace(stored.space);
+  if (!holder) {
+    const std::vector<tabs::TabInterface*> live = GetSpaceTabs(stored.space);
+    if (!live.empty()) {
+      holder = live.front()->GetBrowserWindowInterface();
+    }
+  }
+  if (holder) {
+    // RestoreStoredSpace inserts every tab unselected and defers loading
+    // until activation, so the window's active tab and its loaded pages are
+    // untouched. Its return value only matters to a caller that activates.
+    RestoreStoredSpace(holder, stored);
+    if (WindowState* state = FindState(holder)) {
+      RefreshVisibility(*state);
+    }
+    return;
+  }
+  // No window has the space's tabs: they stay stored. Appended after any
+  // existing entry's tabs, which keep the entry's active tab.
+  if (const StoredSpace* existing = store_.Find(stored.space)) {
+    StoredSpace entry = CopyStoredSpace(*existing);

+TEST_F(SpacesServiceTest, RestoreSpaceInsertsAtIndexAndClamps) {
+  auto service = MakeService();
+  const base::Uuid a = service->spaces()[0].id;
+  const base::Uuid b = service->CreateSpace("B");
+  const base::Uuid c = service->CreateSpace("C");
+
+  Space imported(base::Uuid::GenerateRandomV4(), "Imported");
+  const base::Uuid imported_id = imported.id;
+  service->RestoreSpace(std::move(imported), 1);
+  EXPECT_THAT(Ids(*service), ElementsAre(a, imported_id, b, c));
+  EXPECT_EQ(service->FindSpace(imported_id)->name, "Imported");
+
+  // An index past the end appends.
+  Space last(base::Uuid::GenerateRandomV4(), "Last");
+  const base::Uuid last_id = last.id;
+  service->RestoreSpace(std::move(last), 100);
+  EXPECT_THAT(Ids(*service), ElementsAre(a, imported_id, b, c, last_id));
+}
+
+TEST_F(SpacesServiceTest, RestoreSpaceUpsertReportsOnlyWhatChanged) {
+  auto service = MakeService();
+  const base::Uuid a = service->spaces()[0].id;
+  const base::Uuid b = service->CreateSpace("B");
+  const base::Uuid c = service->CreateSpace("C");
+  RecordingObserver observer;
+  service->AddObserver(&observer);
+
+  // A new ID is an addition, not a reorder.
+  Space imported(base::Uuid::GenerateRandomV4(), "Imported");
+  const base::Uuid imported_id = imported.id;
+  service->RestoreSpace(std::move(imported), 1);
+  EXPECT_THAT(observer.added, ElementsAre(imported_id));
+  EXPECT_TRUE(observer.renamed.empty());
+  EXPECT_TRUE(observer.appearance.empty());
+  EXPECT_EQ(observer.reordered, 0);
+
+  // Same spot, new name: only a rename.
+  Space renamed(imported_id, "Renamed");
+  service->RestoreSpace(std::move(renamed), 1);
+  EXPECT_THAT(observer.renamed, ElementsAre(imported_id));
+  EXPECT_TRUE(observer.appearance.empty());
+  EXPECT_EQ(observer.reordered, 0);
+  EXPECT_EQ(observer.added.size(), 1u);
+
+  // A new icon or theme and a new spot: appearance and reorder.
+  Space themed(imported_id, "Renamed");
+  themed.icon = "🌊";
+  themed.theme.color1 = "#123456";
+  service->RestoreSpace(std::move(themed), 0);
+  EXPECT_THAT(observer.appearance, ElementsAre(imported_id));
+  EXPECT_EQ(observer.renamed.size(), 1u);
+  EXPECT_EQ(observer.reordered, 1);
+  EXPECT_THAT(Ids(*service), ElementsAre(imported_id, a, b, c));
+
+  // Restoring the very same space reports nothing.
+  Space same(imported_id, "Renamed");
+  same.icon = "🌊";
+  same.theme.color1 = "#123456";
+  service->RestoreSpace(std::move(same), 0);
+  EXPECT_EQ(observer.appearance.size(), 1u);
+  EXPECT_EQ(observer.renamed.size(), 1u);
+  EXPECT_EQ(observer.reordered, 1);
+  service->RemoveObserver(&observer);
+
+  // Upserting the only space's ID leaves one space.
+  TestingPrefServiceSimple solo_prefs;
+  RegisterSpacesProfilePrefs(solo_prefs.registry());
+  SpacesService solo(&solo_prefs);
+  solo.RestoreSpace(Space(solo.spaces()[0].id, "Only"), 0);
+  EXPECT_EQ(solo.spaces().size(), 1u);
+}
+
+TEST_F(SpacesServiceTest, RestoreSpaceKeepsEveryFieldAndPersists) {
+  auto service = MakeService();
+  const base::Uuid id = service->spaces()[0].id;
+  const base::Uuid b = service->CreateSpace("B");
+
+  Space restored(id, "Restored");
+  restored.icon = "🌊";
+  restored.theme.color1 = "#123456";
+  restored.theme.color2 = "#654321";
+  restored.theme.mode = SpaceTheme::Mode::kDark;
+  restored.theme.unknown_fields.Set("dark1", "#111111");
+  restored.unknown_fields.Set("future_field", 42);
+  restored.last_active = base::Time::FromSecondsSinceUnixEpoch(1'600'000'000);
+  service->RestoreSpace(std::move(restored), 1);
+
+  service.reset();
+  auto reloaded = MakeService();
+  const Space* space = reloaded->FindSpace(id);
+  ASSERT_TRUE(space);
+  EXPECT_EQ(space->name, "Restored");
+  EXPECT_EQ(space->icon, "🌊");
+  EXPECT_EQ(space->theme.color1, "#123456");
+  EXPECT_EQ(space->theme.color2, "#654321");
+  EXPECT_EQ(space->theme.mode, SpaceTheme::Mode::kDark);
+  EXPECT_EQ(*space->theme.unknown_fields.FindString("dark1"), "#111111");
+  EXPECT_EQ(space->unknown_fields.FindInt("future_field"), 42);
+  EXPECT_EQ(space->last_active,
+            base::Time::FromSecondsSinceUnixEpoch(1'600'000'000));
+  EXPECT_EQ(reloaded->GetIndex(id), 1u);
+
+  // A new ID persists too, at its restored spot.
+  Space added(base::Uuid::GenerateRandomV4(), "Added");
+  const base::Uuid added_id = added.id;
+  reloaded->RestoreSpace(std::move(added), 0);
+  reloaded.reset();
+  auto again = MakeService();
+  EXPECT_THAT(Ids(*again), ElementsAre(added_id, b, id));
+  EXPECT_EQ(again->FindSpace(added_id)->name, "Added");
+}
+
+TEST_F(SpacesServiceTest, RestoreSpaceSavesOnce) {
+  auto service = MakeService();
+  const base::Uuid a = service->spaces()[0].id;
+  service->CreateSpace("B");
+
+  int writes = 0;
+  PrefChangeRegistrar registrar;
+  registrar.Init(&prefs_);
+  registrar.Add(kSpaces,
+                base::BindLambdaForTesting([&writes] { ++writes; }));
+
+  Space imported(base::Uuid::GenerateRandomV4(), "Imported");
+  service->RestoreSpace(std::move(imported), 0);
+  EXPECT_EQ(writes, 1);
+
+  Space renamed(a, "New name");
+  service->RestoreSpace(std::move(renamed), 2);
+  EXPECT_EQ(writes, 2);
+}
+
+TEST_F(SpacesServiceTest, SaveBatchWritesOnceAtTheOutermostEnd) {
+  auto service = MakeService();
+  RecordingObserver observer;
+  service->AddObserver(&observer);
+
+  int writes = 0;
+  PrefChangeRegistrar registrar;
+  registrar.Init(&prefs_);
+  registrar.Add(kSpaces,
+                base::BindLambdaForTesting([&writes] { ++writes; }));
+
+  std::vector<base::Uuid> added;
+  {
+    SpacesService::ScopedSaveBatch batch(service.get());
+    for (int i = 0; i < 3; ++i) {
+      Space space(base::Uuid::GenerateRandomV4(), "Imported");
+      added.push_back(space.id);
+      service->RestoreSpace(std::move(space), service->spaces().size());
+    }
+    {
+      SpacesService::ScopedSaveBatch nested(service.get());
+      added.push_back(service->CreateSpace("Nested"));
+    }
+    // Observers hear of each change as it happens; the pref waits.
+    EXPECT_EQ(observer.added, added);
+    EXPECT_EQ(writes, 0);
+  }
+  EXPECT_EQ(writes, 1);
+  service->RemoveObserver(&observer);
+
+  // The single write holds every change.
+  service.reset();
+  auto reloaded = MakeService();
+  for (const base::Uuid& id : added) {
+    EXPECT_TRUE(reloaded->FindSpace(id));
+  }
+
+  // A batch with no change writes nothing.
+  writes = 0;
+  { SpacesService::ScopedSaveBatch batch(reloaded.get()); }
+  EXPECT_EQ(writes, 0);
+}
+
 }  // namespace

+void SpacesWindowManager::MoveItemTabsToSpace(
+    const base::Uuid& from,
+    const base::Uuid& to,
+    const base::flat_set<std::string>& item_ids) {
+  if (from == to || item_ids.empty() || !spaces_->FindSpace(from) ||
+      !spaces_->FindSpace(to)) {
+    return;
+  }
+  std::vector<tabs::TabInterface*> all;
+  std::vector<ItemTabCandidate> candidates;
+  for (const auto& [browser, state] : windows_) {
+    if (state->closing) {
+      continue;
+    }
+    for (auto* tab : *browser->GetTabStripModel()) {
+      if (tab == state->placeholder_tab) {
+        continue;
+      }
+      all.push_back(tab);
+      candidates.push_back({SpaceTabTag::Get(tab->GetContents()),
+                            GetSidebarItemId(tab->GetContents()),
+                            tab->IsPinned()});
+    }
+  }
+  std::vector<tabs::TabInterface*> moving;
+  for (size_t index : PickItemTabsToMove(candidates, from, item_ids)) {
+    moving.push_back(all[index]);
+  }
+  if (moving.empty()) {
+    return;
+  }
+  // As MoveWindowTabs: TagTab also rewrites the session's per-tab extra
+  // data, so a session restore puts them in `to`.
+  std::vector<WindowState*> affected;
+  for (auto* tab : moving) {
+    TagTab(tab, to);
+    WindowState* state = FindState(tab->GetBrowserWindowInterface());
+    if (state && !std::ranges::contains(affected, state)) {
+      affected.push_back(state);
+    }
+  }
+  // The window holding `to` shows its pins, so it gets their tabs, as
+  // MoveTabsToSpace does; otherwise its sidebar sync would open a second,
+  // fresh copy. Pinned tabs are never in a tab group, but one can be half
+  // of a split, which stays where it is, re-tagged, as MoveWindowTabs
+  // leaves every tab.
+  if (BrowserWindowInterface* owner = GetWindowHoldingSpace(to)) {
+    WindowState* owner_state = FindState(owner);
+    for (WindowState* state : affected) {
+      if (state == owner_state) {
+        continue;
+      }
+      TabStripModel* source = state->browser->GetTabStripModel();
+      std::vector<int> indices;
+      for (auto* tab : moving) {
+        const int index = source->GetIndexOfTab(tab);
+        if (index != TabStripModel::kNoTab && !tab->GetSplit()) {
+          indices.push_back(index);
+        }
+      }
+      if (indices.empty()) {
+        continue;
+      }
+      base::AutoReset<bool> changing(&state->changing_space, true);
+      if (static_cast<int>(indices.size()) == source->count()) {
+        EnsurePlaceholder(*state);
+      }
+      TransferSpaceTabs(source, owner->GetTabStripModel(), indices);
+    }
+    if (owner_state && !std::ranges::contains(affected, owner_state)) {
+      affected.push_back(owner_state);
+    }
+  }
+  for (WindowState* state : affected) {
+    RefreshVisibility(*state);
+    NotifyWindowSpaceChanged(state->browser);
+  }
+  UpdateUnloadTimer();
+}

+          tab.navigations[selected];
+      summary.url = navigation.virtual_url();
+      summary.title = navigation.title();
+      summary.favicon_url = navigation.favicon_url();
+    }
+    summary.pinned = !tab.sidebar_item_id.empty();
+    summary.last_active = tab.last_active;

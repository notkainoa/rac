+      ProfileWith(ArcProfileResult::Status::kFailed, /*sign_ins_written=*/3);
+  failed.failure = ArcImportFailure::kRecordNotSaved;
+  EXPECT_EQ(FoldArcImportStatus({failed}, ArcImportFailure::kRecordNotSaved),
+            ArcImportResult::Status::kFailed);
+  // Even with no failure reported for the whole import.
+  EXPECT_EQ(FoldArcImportStatus({failed}, ArcImportFailure::kNone),
+            ArcImportResult::Status::kFailed);
+}

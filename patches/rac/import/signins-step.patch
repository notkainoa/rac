===================================================================
--- /dev/null
+++ src/chrome/browser/rac/import/arc_cookie_import.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_cookie_import.h"
+
+#include <optional>
+#include <string_view>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "base/types/expected_macros.h"
+#include "chrome/browser/rac/import/arc_reader.h"
+#include "chrome/browser/rac/import/imported_cookie_crypto.h"
+#include "net/cookies/cookie_constants.h"
+
+namespace rac::import {
+
+namespace {
+
+static_assert(kImportedCookieKeySize == 16);
+
+constexpr base::FilePath::CharType kUserDataDir[] =
+    FILE_PATH_LITERAL("User Data");
+constexpr base::FilePath::CharType kNetworkDir[] = FILE_PATH_LITERAL("Network");
+constexpr base::FilePath::CharType kCookiesFile[] =
+    FILE_PATH_LITERAL("Cookies");
+
+// Whether `name` names one folder directly inside `User Data`: not empty, not
+// "." or "..", and with no separator or NUL that could reach anywhere else.
+bool IsPlainFolderName(std::string_view name) {
+  if (name.empty() || name == "." || name == ".." ||
+      name.find_first_of(std::string_view("/\\\0", 3)) !=
+          std::string_view::npos ||
+      !base::IsStringUTF8(name)) {
+    return false;
+  }
+  const base::FilePath path = base::FilePath::FromUTF8Unsafe(name);
+  return path.BaseName() == path && !path.ReferencesParent();
+}
+
+bool IsExistingFile(const base::FilePath& path) {
+  return base::PathExists(path) && !base::DirectoryExists(path);
+}
+
+// Chromium's DB stores Windows-epoch microseconds; 0 becomes a null time,
+// which for `expires_utc` means a session cookie.
+base::Time TimeFromDb(int64_t microseconds) {
+  return base::Time::FromDeltaSinceWindowsEpoch(
+      base::Microseconds(microseconds));
+}
+
+// DBCookiePriority in net/extras/sqlite/sqlite_persistent_cookie_store.cc.
+// net::CookiePriority has no fixed underlying type, so casting a value it
+// doesn't name is undefined; unknown values become the default here instead
+// of in the writer.
+net::CookiePriority PriorityFromDb(int priority) {
+  switch (priority) {
+    case 0:
+      return net::COOKIE_PRIORITY_LOW;
+    case 1:
+      return net::COOKIE_PRIORITY_MEDIUM;
+    case 2:
+      return net::COOKIE_PRIORITY_HIGH;
+  }
+  return net::COOKIE_PRIORITY_DEFAULT;
+}
+
+// The row's cookie value, or nullopt if it can't be decoded. Follows
+// SQLitePersistentCookieStore's load: an empty `encrypted_value` means the
+// value is stored in plaintext (possibly empty), and a row with both is
+// refused as ambiguous.
+std::optional<std::string> DecodeValue(CookieDbRow& row,
+                                       base::span<const uint8_t, 16> key,
+                                       int db_version) {
+  if (row.encrypted_value.empty()) {
+    return std::move(row.value);
+  }
+  if (!row.value.empty()) {
+    return std::nullopt;
+  }
+  base::expected<std::string, CookieDecryptError> decrypted =
+      DecryptImportedCookieValue(key, row.encrypted_value, row.host_key,
+                                 db_version);
+  if (!decrypted.has_value()) {
+    return std::nullopt;
+  }
+  return std::move(decrypted).value();
+}
+
+}  // namespace
+
+ArcCookieReadResult::ArcCookieReadResult() = default;
+ArcCookieReadResult::ArcCookieReadResult(ArcCookieReadResult&&) = default;
+ArcCookieReadResult& ArcCookieReadResult::operator=(ArcCookieReadResult&&) =
+    default;
+ArcCookieReadResult::~ArcCookieReadResult() = default;
+
+base::FilePath ArcCookieDbPath(const base::FilePath& arc_support_dir,
+                               const std::string& profile_directory) {
+  if (arc_support_dir.empty() || !IsPlainFolderName(profile_directory)) {
+    return base::FilePath();
+  }
+  const base::FilePath profile_dir =
+      arc_support_dir.Append(kUserDataDir)
+          .Append(base::FilePath::FromUTF8Unsafe(profile_directory));
+  // Chromium moved the cookie store into Network/ in M96; older profiles
+  // still have it at the top.
+  base::FilePath db_path = profile_dir.Append(kNetworkDir).Append(kCookiesFile);
+  if (!IsExistingFile(db_path)) {
+    db_path = profile_dir.Append(kCookiesFile);
+    if (!IsExistingFile(db_path)) {
+      return base::FilePath();
+    }
+  }
+  // A symlink anywhere on the way, the file included, may lead out of Arc's
+  // folder. Don't fall back to the other location then: something is off.
+  if (!ArcPathStaysInside(arc_support_dir, db_path)) {
+    return base::FilePath();
+  }
+  return db_path;
+}
+
+base::expected<ArcCookieReadResult, CookieDbReadError> ReadArcCookies(
+    const base::FilePath& db_path,
+    base::span<const uint8_t, 16> key) {
+  ASSIGN_OR_RETURN(CookieDbSnapshot snapshot, ReadCookieDbRows(db_path));
+
+  ArcCookieReadResult result;
+  result.truncated = snapshot.rows_truncated;
+  result.cookies.reserve(snapshot.rows.size());
+  for (CookieDbRow& row : snapshot.rows) {
+    std::optional<std::string> value =
+        DecodeValue(row, key, snapshot.meta_version);
+    if (!value) {
+      ++result.undecodable;
+      continue;
+    }
+    ImportedCookie& cookie = result.cookies.emplace_back();
+    cookie.name = std::move(row.name);
+    cookie.value = std::move(*value);
+    cookie.host_key = std::move(row.host_key);
+    cookie.path = std::move(row.path);
+    cookie.creation = TimeFromDb(row.creation_utc);
+    cookie.expiry = TimeFromDb(row.expires_utc);
+    cookie.last_access = TimeFromDb(row.last_access_utc);
+    cookie.secure = row.is_secure;
+    cookie.http_only = row.is_httponly;
+    // Both enums have an int underlying type and the DB's numbering, so any
+    // value is safe to carry over; the writer maps unknown ones.
+    cookie.same_site = static_cast<net::CookieSameSite>(row.samesite);
+    cookie.priority = PriorityFromDb(row.priority);
+    cookie.source_scheme =
+        static_cast<net::CookieSourceScheme>(row.source_scheme);
+    cookie.source_port = row.source_port;
+    cookie.partition_key = std::move(row.top_frame_site_key);
+    cookie.has_cross_site_ancestor = row.has_cross_site_ancestor;
+  }
+  return result;
+}
+
+}  // namespace rac::import

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_safe_storage_key.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "build/build_config.h"
+
+namespace rac::import {
+
+namespace {
+
+// The answer of the live ScopedArcSafeStorageKeyForTesting, if any. Set and
+// read on the test's main thread only.
+std::optional<base::expected<std::string, ArcKeyError>>& TestingAnswer() {
+  static base::NoDestructor<
+      std::optional<base::expected<std::string, ArcKeyError>>>
+      answer;
+  return *answer;
+}
+
+// Replies a fixed answer from a posted task. Serves the test override, and
+// the platforms without Arc's Keychain item.
+class FixedAnswerSource : public ArcSafeStorageKeySource {
+ public:
+  explicit FixedAnswerSource(base::expected<std::string, ArcKeyError> answer)
+      : answer_(std::move(answer)) {}
+  FixedAnswerSource(const FixedAnswerSource&) = delete;
+  FixedAnswerSource& operator=(const FixedAnswerSource&) = delete;
+  ~FixedAnswerSource() override = default;
+
+  void GetPassword(ArcPasswordCallback done) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&FixedAnswerSource::Reply,
+                                  weak_factory_.GetWeakPtr(), std::move(done)));
+  }
+
+ private:
+  void Reply(ArcPasswordCallback done) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    std::move(done).Run(answer_);
+  }
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  const base::expected<std::string, ArcKeyError> answer_;
+  base::WeakPtrFactory<FixedAnswerSource> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<ArcSafeStorageKeySource> CreateArcSafeStorageKeySource() {
+  if (const auto& answer = TestingAnswer(); answer.has_value()) {
+    return std::make_unique<FixedAnswerSource>(*answer);
+  }
+#if BUILDFLAG(IS_MAC)
+  return internal::CreateKeychainArcSafeStorageKey();
+#else
+  return std::make_unique<FixedAnswerSource>(
+      base::unexpected(ArcKeyError::kFailed));
+#endif
+}
+
+ScopedArcSafeStorageKeyForTesting::ScopedArcSafeStorageKeyForTesting(
+    base::expected<std::string, ArcKeyError> answer) {
+  CHECK(!TestingAnswer().has_value())
+      << "ScopedArcSafeStorageKeyForTesting can't nest";
+  TestingAnswer().emplace(std::move(answer));
+}
+
+ScopedArcSafeStorageKeyForTesting::~ScopedArcSafeStorageKeyForTesting() {
+  CHECK(TestingAnswer().has_value());
+  TestingAnswer().reset();
+}
+
+}  // namespace rac::import

@@ -0,0 +1,36 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_GUARD_H_
+#define CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_GUARD_H_
+
+#include <memory>
+
+#include "base/sequence_checker.h"
+
+namespace rac {
+
+// At most one Arc import, sign-ins retry, or Undo runs at a time in the
+// whole browser, whichever page or window starts it. Each holds one of these
+// from its start until just before it reports
+// (chrome/browser/ui/rac/import/arc_importer.h). UI thread only: each one is
+// released on the sequence that took it.
+class ArcImportInProgress {
+ public:
+  // Null while another is held: the caller reports kBusy.
+  static std::unique_ptr<ArcImportInProgress> TryBegin();
+
+  ArcImportInProgress(const ArcImportInProgress&) = delete;
+  ArcImportInProgress& operator=(const ArcImportInProgress&) = delete;
+  ~ArcImportInProgress();
+
+ private:
+  ArcImportInProgress();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_GUARD_H_

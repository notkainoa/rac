+
+TEST_F(ArcSignInsCoreTest, UnreadableDatabaseFails) {
+  read_result_ = base::unexpected(CookieDbReadError::kOpenFailed);
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kFailed);
+  EXPECT_EQ(store_.sinks_made, 0);
+}
+
+TEST_F(ArcSignInsCoreTest, EmptyDatabaseWritesNothing) {
+  SetCookies(0, 0);
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kNoCookies);
+  EXPECT_EQ(store_.sinks_made, 0);
+}
+
+TEST_F(ArcSignInsCoreTest, GoneProfileFails) {
+  SetCookies(1, 0);
+  store_.gone = true;
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kFailed);
+  EXPECT_EQ(store_.sinks_made, 1);
+  EXPECT_TRUE(store_.written.empty());
+}

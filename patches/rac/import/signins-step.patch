--- /dev/null
+++ src/chrome/browser/rac/import/arc_safe_storage_key.cc
@@ -0,0 +1,169 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_safe_storage_key.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/notreached.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "build/build_config.h"
+#include "chrome/browser/rac/dev/buildflags.h"
+
+namespace rac::import {
+
+namespace {
+
+#if BUILDFLAG(IS_MAC)
+// switches::kTestType, which //content defines. Spelled out so this target
+// doesn't depend on //content for one string.
+constexpr char kTestTypeSwitch[] = "test-type";
+#endif
+
+// switches::kUseMockKeychain, which //components/os_crypt defines. It makes
+// os_crypt use a fake Keychain, but this file reads Arc's item through
+// crypto::apple::KeychainV2, which the switch doesn't cover.
+constexpr char kUseMockKeychainSwitch[] = "use-mock-keychain";
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+// The dev-only switch GetArcSourcePaths() reads (arc_source_root.h). Spelled
+// out so this target doesn't depend on the reader.
+constexpr char kImportSourceRootSwitch[] = "rac-import-source-root";
+#endif
+
+// The live ScopedArcSafeStorageKeyForTesting's factory, if any. Set and read
+// on the test's main thread only.
+internal::ArcKeySourceFactory g_factory_for_testing = nullptr;
+
+// Says once per process why the Keychain isn't read. Never the password.
+void LogNotReadingKeychainOnce(internal::ArcKeySourceKind kind) {
+  static bool logged = false;
+  if (logged) {
+    return;
+  }
+  logged = true;
+  LOG(WARNING) << "Not reading Arc's Keychain item in this "
+               << (kind == internal::ArcKeySourceKind::kFixturePassword
+                       ? "run: answering the fixture password"
+                       : "run: sign-ins will fail");
+}
+
+// Replies a fixed answer from a posted task. Serves the test override, the
+// runs that must not read the Keychain, and the platforms without Arc's
+// Keychain item.
+class FixedAnswerSource : public ArcSafeStorageKeySource {
+ public:
+  explicit FixedAnswerSource(base::expected<std::string, ArcKeyError> answer)
+      : answer_(std::move(answer)) {}
+  FixedAnswerSource(const FixedAnswerSource&) = delete;
+  FixedAnswerSource& operator=(const FixedAnswerSource&) = delete;
+  ~FixedAnswerSource() override = default;
+
+  void GetPassword(ArcPasswordCallback done) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&FixedAnswerSource::Reply,
+                                  weak_factory_.GetWeakPtr(), std::move(done)));
+  }
+
+ private:
+  void Reply(ArcPasswordCallback done) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    std::move(done).Run(answer_);
+  }
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  const base::expected<std::string, ArcKeyError> answer_;
+  base::WeakPtrFactory<FixedAnswerSource> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<ArcSafeStorageKeySource> CreateArcSafeStorageKeySource() {
+  if (g_factory_for_testing) {
+    return g_factory_for_testing();
+  }
+  const base::CommandLine empty(base::CommandLine::NO_PROGRAM);
+  const base::CommandLine& command_line =
+      base::CommandLine::InitializedForCurrentProcess()
+          ? *base::CommandLine::ForCurrentProcess()
+          : empty;
+#if BUILDFLAG(IS_MAC)
+  // Browser tests run with --test-type. One that gets here without
+  // ScopedArcSafeStorageKeyForTesting could show a real Keychain prompt for
+  // the machine's own Arc item, or hang on it on a bot, so it crashes
+  // instead. This also covers anything else launched with --test-type.
+  CHECK(!command_line.HasSwitch(kTestTypeSwitch))
+      << "Tests must use ScopedArcSafeStorageKeyForTesting";
+#endif
+  const internal::ArcKeySourceKind kind =
+      internal::ChooseArcKeySource(command_line);
+  switch (kind) {
+    case internal::ArcKeySourceKind::kKeychain:
+#if BUILDFLAG(IS_MAC)
+      return internal::CreateKeychainArcSafeStorageKey();
+#else
+      return internal::CreateFixedAnswerArcKeySource(
+          base::unexpected(ArcKeyError::kFailed));
+#endif
+    case internal::ArcKeySourceKind::kFailed:
+      LogNotReadingKeychainOnce(kind);
+      return internal::CreateFixedAnswerArcKeySource(
+          base::unexpected(ArcKeyError::kFailed));
+    case internal::ArcKeySourceKind::kFixturePassword:
+      LogNotReadingKeychainOnce(kind);
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+      return internal::CreateFixedAnswerArcKeySource(
+          std::string(kArcFixtureSafeStoragePassword));
+#else
+      // ChooseArcKeySource() never answers this in release builds.
+      return internal::CreateFixedAnswerArcKeySource(
+          base::unexpected(ArcKeyError::kFailed));
+#endif
+  }
+  NOTREACHED();
+}
+
+namespace internal {
+
+ArcKeySourceKind ChooseArcKeySource(const base::CommandLine& command_line) {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  // A fixture brings its own password, so it wins over --use-mock-keychain:
+  // neither reaches the Keychain.
+  if (command_line.HasSwitch(kImportSourceRootSwitch)) {
+    return ArcKeySourceKind::kFixturePassword;
+  }
+#endif
+  if (command_line.HasSwitch(kUseMockKeychainSwitch)) {
+    return ArcKeySourceKind::kFailed;
+  }
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  // A dev build never reads the real Keychain, so a dev run can't prompt
+  // for, or read, the maintainer's own Arc item.
+  return ArcKeySourceKind::kFailed;
+#else
+  return ArcKeySourceKind::kKeychain;
+#endif
+}
+
+std::unique_ptr<ArcSafeStorageKeySource> CreateFixedAnswerArcKeySource(
+    base::expected<std::string, ArcKeyError> answer) {
+  return std::make_unique<FixedAnswerSource>(std::move(answer));
+}
+
+void SetArcKeySourceFactoryForTesting(ArcKeySourceFactory factory) {
+  g_factory_for_testing = factory;
+}
+
+}  // namespace internal
+
+}  // namespace rac::import

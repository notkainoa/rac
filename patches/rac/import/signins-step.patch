+            ArcKeyError::kDenied);
+  EXPECT_EQ(internal::ArcKeyErrorFromStatus(errSecAuthFailed),
+            ArcKeyError::kDenied);
+  EXPECT_EQ(internal::ArcKeyErrorFromStatus(errSecItemNotFound),

@@ -0,0 +1,144 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_safe_storage_key.h"
+
+#import <Foundation/Foundation.h>
+#include <Security/Security.h>
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/apple/foundation_util.h"
+#include "base/apple/osstatus_logging.h"
+#include "base/apple/scoped_cftyperef.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/thread_pool.h"
+#include "crypto/apple/keychain_v2.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace rac::import {
+
+namespace {
+
+using PasswordResult = base::expected<std::string, ArcKeyError>;
+
+// The generic password Arc keeps in the login Keychain. The service and
+// account names are the ones Cra's MIT-licensed import uses for Arc
+// (Sources/Cra/Services/Import/BrowserSources.swift, read through
+// ChromiumCrypto.keychainSecret in CredentialImport.swift).
+NSString* const kArcKeychainService = @"Arc Safe Storage";
+NSString* const kArcKeychainAccount = @"Arc";
+
+// Overwrites the password in `result`, if it holds one.
+void Wipe(PasswordResult& result) {
+  if (result.has_value() && !result->empty()) {
+    OPENSSL_cleanse(result->data(), result->size());
+  }
+}
+
+// Reads the password. Blocks while macOS shows its access prompt, so it runs
+// on the thread pool. Read only: it never adds, updates or deletes an item.
+PasswordResult ReadArcPasswordFromKeychain() {
+  @autoreleasepool {
+    // No kSecUseDataProtectionKeychain: Arc's item is in the file-based login
+    // Keychain, which a data protection query would never search.
+    NSDictionary* query = @{
+      (__bridge id)kSecClass : (__bridge id)kSecClassGenericPassword,
+      (__bridge id)kSecAttrService : kArcKeychainService,
+      (__bridge id)kSecAttrAccount : kArcKeychainAccount,
+      (__bridge id)kSecReturnData : @YES,
+      (__bridge id)kSecMatchLimit : (__bridge id)kSecMatchLimitOne,
+    };
+
+    base::apple::ScopedCFTypeRef<CFTypeRef> result;
+    OSStatus status = crypto::apple::KeychainV2::GetInstance().ItemCopyMatching(
+        (__bridge CFDictionaryRef)query, result.InitializeInto());
+    if (status != errSecSuccess) {
+      ArcKeyError error = internal::ArcKeyErrorFromStatus(status);
+      if (error == ArcKeyError::kFailed) {
+        OSSTATUS_DLOG(WARNING, status) << "Reading Arc Safe Storage failed";
+      }
+      return base::unexpected(error);
+    }
+
+    CFDataRef data = base::apple::CFCast<CFDataRef>(result.get());
+    if (!data || CFDataGetLength(data) == 0) {
+      return base::unexpected(ArcKeyError::kFailed);
+    }
+    // The password goes straight into the string handed to the caller. The
+    // CFData belongs to the Security framework and is immutable, so it is
+    // released, not overwritten.
+    return std::string(base::as_string_view(base::apple::CFDataToSpan(data)));
+  }
+}
+
+// Reads Arc's "Arc Safe Storage" item with SecItemCopyMatching.
+class KeychainArcSafeStorageKeySource : public ArcSafeStorageKeySource {
+ public:
+  KeychainArcSafeStorageKeySource() = default;
+  KeychainArcSafeStorageKeySource(const KeychainArcSafeStorageKeySource&) =
+      delete;
+  KeychainArcSafeStorageKeySource& operator=(
+      const KeychainArcSafeStorageKeySource&) = delete;
+  ~KeychainArcSafeStorageKeySource() override = default;
+
+  void GetPassword(ArcPasswordCallback done) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    // USER_BLOCKING: the user just clicked and is waiting on the prompt.
+    // CONTINUE_ON_SHUTDOWN: a prompt left open must not hold up quitting. The
+    // task touches nothing that shutdown destroys.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+         base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&ReadArcPasswordFromKeychain),
+        base::BindOnce(&KeychainArcSafeStorageKeySource::OnRead,
+                       weak_factory_.GetWeakPtr(), std::move(done)));
+  }
+
+ private:
+  // Static so the password is wiped even when the source is gone.
+  static void OnRead(base::WeakPtr<KeychainArcSafeStorageKeySource> source,
+                     ArcPasswordCallback done,
+                     PasswordResult result) {
+    if (!source) {
+      Wipe(result);
+      return;
+    }
+    DCHECK_CALLED_ON_VALID_SEQUENCE(source->sequence_checker_);
+    std::move(done).Run(std::move(result));
+  }
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<KeychainArcSafeStorageKeySource> weak_factory_{this};
+};
+
+}  // namespace
+
+namespace internal {
+
+std::unique_ptr<ArcSafeStorageKeySource> CreateKeychainArcSafeStorageKey() {
+  return std::make_unique<KeychainArcSafeStorageKeySource>();
+}
+
+ArcKeyError ArcKeyErrorFromStatus(OSStatus status) {
+  switch (status) {
+    case errSecUserCanceled:
+    case errSecAuthFailed:
+      return ArcKeyError::kDenied;
+    case errSecItemNotFound:
+      return ArcKeyError::kNotFound;
+    default:
+      return ArcKeyError::kFailed;
+  }
+}
+
+}  // namespace internal
+
+}  // namespace rac::import

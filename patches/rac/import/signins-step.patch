+#include "testing/gtest/include/gtest/gtest.h"
+
+// Everything here runs against fakes: no Keychain, no Arc files, no cookie
+// store.
+
+namespace rac::import {
+namespace {
+
+using Status = ArcSignInsResult::Status;
+using Step = ArcImportProgress::Step;
+
+constexpr char kRun[] = "run-1";
+constexpr char kOtherRun[] = "run-2";
+constexpr char kPassword[] = "not-a-real-safe-storage-secret";
+
+std::array<uint8_t, kImportedCookieKeySize> ExpectedKey() {
+  const std::string password(kPassword);
+  return DeriveImportedCookieKey(base::as_byte_span(password));
+}
+
+bool IsExpectedKey(const ArcCookieKey& key) {
+  return std::ranges::equal(key.bytes(), ExpectedKey());
+}
+
+// What the fake Keychain answers, and how often it was asked.
+struct FakeKeychain {
+  int requests = 0;
+  // Unset: the request waits in `held` until the test answers it.
+  std::optional<base::expected<std::string, ArcKeyError>> answer =
+      std::string(kPassword);
+  ArcPasswordCallback held;
+};
+
+class FakeKeySource : public ArcSafeStorageKeySource {
+ public:
+  explicit FakeKeySource(FakeKeychain* keychain) : keychain_(keychain) {}
+
+  // ArcSafeStorageKeySource:
+  void GetPassword(ArcPasswordCallback done) override {
+    ++keychain_->requests;
+    if (!keychain_->answer) {
+      keychain_->held = std::move(done);
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), *keychain_->answer));
+  }
+
+ private:
+  raw_ptr<FakeKeychain> keychain_;
+};
+
+// What the fake cookie store took and reports.
+struct FakeStore {
+  int sinks_made = 0;
+  // make_sink() returns null, like a profile that went away.
+  bool gone = false;
+  std::vector<ImportedCookie> written;
+  CookieWriteReport report;
+};
+
+class FakeSink : public ArcCookieSink {
+ public:
+  explicit FakeSink(FakeStore* store) : store_(store) {}
+
+  // ArcCookieSink:
+  void Write(std::vector<ImportedCookie> cookies,
+             CookieWriter::DoneCallback done) override {
+    store_->written = std::move(cookies);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), store_->report));
+  }
+
+ private:
+  raw_ptr<FakeStore> store_;
+};
+
+ImportedCookie Cookie(const std::string& name) {
+  ImportedCookie cookie;
+  cookie.name = name;
+  cookie.value = "value";
+  cookie.host_key = "example.com";
+  cookie.path = "/";
+  return cookie;
+}
+
+class ArcSignInsCoreTest : public testing::Test {
+ protected:
+  ArcRunKeyCache::SourceFactory Keychain() {
+    return base::BindLambdaForTesting(
+        [this]() -> std::unique_ptr<ArcSafeStorageKeySource> {
+          return std::make_unique<FakeKeySource>(&keychain_);
+        });
+  }
+
+  ArcKeyResult GetKey(ArcRunKeyCache& keys, const std::string& run_id) {
+    base::RunLoop loop;
+    std::optional<ArcKeyResult> out;
+    keys.GetKey(run_id, base::BindLambdaForTesting([&](ArcKeyResult key) {
+                  out.emplace(std::move(key));
+                  loop.Quit();
+                }));
+    loop.Run();
+    return std::move(*out);
+  }
+
+  // ArcCookieReadResult is move-only, so the fake reader hands out a copy.
+  base::expected<ArcCookieReadResult, CookieDbReadError> CopyReadResult()
+      const {
+    if (!read_result_.has_value()) {
+      return base::unexpected(read_result_.error());
+    }
+    ArcCookieReadResult copy;
+    copy.cookies = read_result_->cookies;
+    copy.undecodable = read_result_->undecodable;
+    copy.truncated = read_result_->truncated;
+    return copy;
+  }
+
+  ArcSignInsJob Job(const std::string& run_id) {
+    ArcSignInsJob job;
+    job.run_id = run_id;
+    job.arc_support_dir = base::FilePath(FILE_PATH_LITERAL("/arc-copy"));
+    job.profile_directory = "Default";
+    job.is_arc_running =
+        base::BindLambdaForTesting([this] { return arc_running_; });
+    // Runs on the thread pool.
+    job.read_cookies = base::BindLambdaForTesting(
+        [this](const base::FilePath& arc_support_dir,
+               const std::string& profile_directory, const ArcCookieKey& key) {
+          ++reads_;
+          read_with_expected_key_ = IsExpectedKey(key);
+          return CopyReadResult();
+        });
+    job.make_sink =
+        base::BindLambdaForTesting([this]() -> std::unique_ptr<ArcCookieSink> {
+          ++store_.sinks_made;
+          if (store_.gone) {
+            return nullptr;
+          }
+          return std::make_unique<FakeSink>(&store_);
+        });
+    job.progress =
+        base::BindLambdaForTesting([this](const ArcImportProgress& progress) {
+          steps_.push_back(progress.step);
+        });
+    return job;
+  }
+
+  ArcSignInsResult Run(ArcRunKeyCache& keys, ArcSignInsJob job) {
+    base::RunLoop loop;
+    ArcSignInsResult out;
+    RunArcSignIns(keys, std::move(job),
+                  base::BindLambdaForTesting([&](const ArcSignInsResult& r) {
+                    out = r;
+                    loop.Quit();
+                  }));
+    loop.Run();
+    return out;
+  }
+
+  void SetCookies(int count, int undecodable) {
+    ArcCookieReadResult read;
+    for (int i = 0; i < count; ++i) {
+      read.cookies.push_back(Cookie("c" + std::to_string(i)));
+    }
+    read.undecodable = undecodable;
+    read_result_ = std::move(read);
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  FakeKeychain keychain_;
+  FakeStore store_;
+  bool arc_running_ = false;
+  std::atomic<int> reads_ = 0;
+  std::atomic<bool> read_with_expected_key_ = false;
+  base::expected<ArcCookieReadResult, CookieDbReadError> read_result_ =
+      ArcCookieReadResult();
+  std::vector<Step> steps_;
+};
+
+// The per-run password cache.
+
+TEST_F(ArcSignInsCoreTest, AsksOncePerRun) {
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_FALSE(keys.HasAnswer(kRun));
+  ArcKeyResult first = GetKey(keys, kRun);
+  ArcKeyResult second = GetKey(keys, kRun);
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+  EXPECT_TRUE(IsExpectedKey(*first));
+  EXPECT_TRUE(IsExpectedKey(*second));
+  EXPECT_EQ(keychain_.requests, 1);
+  EXPECT_TRUE(keys.HasAnswer(kRun));
+}
+
+TEST_F(ArcSignInsCoreTest, CallersWhileAskingShareOneRequest) {
+  keychain_.answer.reset();
+  ArcRunKeyCache keys(Keychain());
+  std::optional<ArcKeyResult> first;
+  std::optional<ArcKeyResult> second;
+  keys.GetKey(kRun, base::BindLambdaForTesting(
+                        [&](ArcKeyResult key) { first.emplace(key); }));
+  keys.GetKey(kRun, base::BindLambdaForTesting(
+                        [&](ArcKeyResult key) { second.emplace(key); }));
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(keychain_.requests, 1);
+  EXPECT_FALSE(first.has_value());
+  EXPECT_FALSE(keys.HasAnswer(kRun));
+
+  std::move(keychain_.held).Run(std::string(kPassword));
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(first && first->has_value());
+  ASSERT_TRUE(second && second->has_value());
+  EXPECT_TRUE(IsExpectedKey(**first));
+  EXPECT_TRUE(IsExpectedKey(**second));
+  EXPECT_EQ(keychain_.requests, 1);
+}
+
+TEST_F(ArcSignInsCoreTest, EndRunDropsTheKey) {
+  ArcRunKeyCache keys(Keychain());
+  ASSERT_TRUE(GetKey(keys, kRun).has_value());
+  EXPECT_EQ(keys.run_count_for_testing(), 1u);
+
+  keys.EndRun(kRun);
+  EXPECT_EQ(keys.run_count_for_testing(), 0u);
+  EXPECT_FALSE(keys.HasAnswer(kRun));
+
+  // Nothing is left to reuse: a new request.
+  ASSERT_TRUE(GetKey(keys, kRun).has_value());
+  EXPECT_EQ(keychain_.requests, 2);
+}
+
+TEST_F(ArcSignInsCoreTest, RunsDontShareKeys) {
+  ArcRunKeyCache keys(Keychain());
+  ASSERT_TRUE(GetKey(keys, kRun).has_value());
+  ASSERT_TRUE(GetKey(keys, kOtherRun).has_value());
+  EXPECT_EQ(keychain_.requests, 2);
+
+  keys.EndRun(kRun);
+  EXPECT_FALSE(keys.HasAnswer(kRun));
+  EXPECT_TRUE(keys.HasAnswer(kOtherRun));
+  EXPECT_EQ(keys.run_count_for_testing(), 1u);
+}
+
+TEST_F(ArcSignInsCoreTest, RefusalIsKeptForTheRun) {
+  keychain_.answer = base::unexpected(ArcKeyError::kDenied);
+  ArcRunKeyCache keys(Keychain());
+  ArcKeyResult first = GetKey(keys, kRun);
+  ArcKeyResult second = GetKey(keys, kRun);
+  ASSERT_FALSE(first.has_value());
+  ASSERT_FALSE(second.has_value());
+  EXPECT_EQ(first.error(), ArcKeyError::kDenied);
+  EXPECT_EQ(second.error(), ArcKeyError::kDenied);
+  // One prompt per run, even when refused.
+  EXPECT_EQ(keychain_.requests, 1);
+}
+
+TEST_F(ArcSignInsCoreTest, EmptyPasswordIsNoKey) {
+  keychain_.answer = std::string();
+  ArcRunKeyCache keys(Keychain());
+  ArcKeyResult key = GetKey(keys, kRun);
+  ASSERT_FALSE(key.has_value());
+  EXPECT_EQ(key.error(), ArcKeyError::kFailed);
+}
+
+TEST_F(ArcSignInsCoreTest, NoSourceFails) {
+  ArcRunKeyCache keys(base::BindRepeating(
+      []() -> std::unique_ptr<ArcSafeStorageKeySource> { return nullptr; }));
+  ArcKeyResult key = GetKey(keys, kRun);
+  ASSERT_FALSE(key.has_value());
+  EXPECT_EQ(key.error(), ArcKeyError::kFailed);
+}
+
+TEST_F(ArcSignInsCoreTest, EndRunWhileAskingFailsWaitersAndDropsTheAnswer) {
+  keychain_.answer.reset();
+  ArcRunKeyCache keys(Keychain());
+  std::optional<ArcKeyResult> waiting;
+  keys.GetKey(kRun, base::BindLambdaForTesting(
+                        [&](ArcKeyResult key) { waiting.emplace(key); }));
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(keychain_.held);
+
+  keys.EndRun(kRun);
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(waiting);
+  ASSERT_FALSE(waiting->has_value());
+  EXPECT_EQ(waiting->error(), ArcKeyError::kFailed);
+
+  // A late answer finds no run, and isn't kept.
+  std::move(keychain_.held).Run(std::string(kPassword));
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(keys.run_count_for_testing(), 0u);
+  EXPECT_FALSE(keys.HasAnswer(kRun));
+}
+
+TEST_F(ArcSignInsCoreTest, KeyCopiesKeepTheirBytes) {
+  const std::array<uint8_t, kImportedCookieKeySize> bytes = ExpectedKey();
+  ArcCookieKey key(bytes);
+  ArcCookieKey copy(key);
+  EXPECT_TRUE(IsExpectedKey(copy));
+  {
+    ArcCookieKey other(key);
+    copy = other;
+  }
+  // `other` zeroed only its own bytes.
+  EXPECT_TRUE(IsExpectedKey(key));
+  EXPECT_TRUE(IsExpectedKey(copy));
+}
+
+// Report folding.
+
+TEST_F(ArcSignInsCoreTest, FoldCountsWhatTheWriterReported) {
+  CookieWriteReport report;
+  report.total = 10;
+  report.set = 6;
+  report.skipped_expired = 1;
+  report.skipped_duplicate = 1;
+  report.skipped_blocked_by_settings = 1;
+  report.AddRejected(CookieRejectReason::kInvalidDomain);
+  const ArcSignInsResult result =
+      FoldArcSignIns(/*undecodable=*/2, /*truncated=*/true, report);
+  EXPECT_EQ(result.status, Status::kDone);
+  EXPECT_EQ(result.written, 6);
+  EXPECT_EQ(result.skipped, 3);
+  EXPECT_EQ(result.rejected, 1);
+  EXPECT_EQ(result.undecodable, 2);
+  EXPECT_TRUE(result.truncated);
+}
+
+TEST_F(ArcSignInsCoreTest, FoldNothingThereIsNoCookies) {
+  EXPECT_EQ(FoldArcSignIns(0, false, CookieWriteReport()).status,
+            Status::kNoCookies);
+}
+
+TEST_F(ArcSignInsCoreTest, FoldNothingDecryptedFails) {
+  const ArcSignInsResult result = FoldArcSignIns(3, false, CookieWriteReport());
+  EXPECT_EQ(result.status, Status::kFailed);
+  EXPECT_EQ(result.undecodable, 3);
+}
+
+TEST_F(ArcSignInsCoreTest, FoldStoreRefusingEverythingFails) {
+  CookieWriteReport report;
+  report.total = 2;
+  report.AddRejected(CookieRejectReason::kStoreRefused);
+  report.AddRejected(CookieRejectReason::kStoreRefused);
+  const ArcSignInsResult result = FoldArcSignIns(0, false, report);
+  EXPECT_EQ(result.status, Status::kFailed);
+  EXPECT_EQ(result.rejected, 2);
+}
+
+TEST_F(ArcSignInsCoreTest, FoldAllSkippedIsDone) {
+  // rac already had newer copies: nothing to write, nothing wrong.
+  CookieWriteReport report;
+  report.total = 2;
+  report.skipped_newer_in_rac = 2;
+  const ArcSignInsResult result = FoldArcSignIns(0, false, report);
+  EXPECT_EQ(result.status, Status::kDone);
+  EXPECT_EQ(result.written, 0);
+  EXPECT_EQ(result.skipped, 2);
+}
+
+TEST_F(ArcSignInsCoreTest, ErrorStatuses) {
+  EXPECT_EQ(SignInsStatusFor(ArcKeyError::kDenied), Status::kDenied);
+  EXPECT_EQ(SignInsStatusFor(ArcKeyError::kNotFound), Status::kFailed);
+  EXPECT_EQ(SignInsStatusFor(ArcKeyError::kFailed), Status::kFailed);
+  EXPECT_EQ(SignInsStatusFor(CookieDbReadError::kSourceMissing),
+            Status::kNoCookies);
+  EXPECT_EQ(SignInsStatusFor(CookieDbReadError::kOpenFailed), Status::kFailed);
+  EXPECT_EQ(SignInsStatusFor(CookieDbReadError::kQueryFailed), Status::kFailed);
+}
+
+// One profile's job.
+
+TEST_F(ArcSignInsCoreTest, ArcRunningChangesNothing) {
+  arc_running_ = true;
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kArcRunning);
+  EXPECT_EQ(keychain_.requests, 0);
+  EXPECT_EQ(reads_.load(), 0);
+  EXPECT_EQ(store_.sinks_made, 0);
+  EXPECT_TRUE(steps_.empty());
+}
+
+TEST_F(ArcSignInsCoreTest, NoProfileFolderDoesntAsk) {
+  ArcRunKeyCache keys(Keychain());
+  ArcSignInsJob job = Job(kRun);
+  job.profile_directory.clear();
+  EXPECT_EQ(Run(keys, std::move(job)).status, Status::kNoCookies);
+  EXPECT_EQ(keychain_.requests, 0);
+  EXPECT_EQ(reads_.load(), 0);
+}
+
+TEST_F(ArcSignInsCoreTest, WritesAndReports) {
+  SetCookies(/*count=*/2, /*undecodable=*/1);
+  store_.report.total = 2;
+  store_.report.set = 2;
+  ArcRunKeyCache keys(Keychain());
+  const ArcSignInsResult result = Run(keys, Job(kRun));
+  EXPECT_EQ(result.status, Status::kDone);
+  EXPECT_EQ(result.written, 2);
+  EXPECT_EQ(result.undecodable, 1);
+  EXPECT_EQ(store_.written.size(), 2u);
+  EXPECT_TRUE(read_with_expected_key_.load());
+  EXPECT_EQ(steps_, (std::vector<Step>{Step::kWaitingForMac, Step::kSignIns}));
+}
+
+TEST_F(ArcSignInsCoreTest, LaterProfilesOfTheRunDontAskAgain) {
+  SetCookies(1, 0);
+  store_.report.total = 1;
+  store_.report.set = 1;
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kDone);
+  steps_.clear();
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kDone);
+  EXPECT_EQ(keychain_.requests, 1);
+  EXPECT_EQ(reads_.load(), 2);
+  // No wait for macOS the second time.
+  EXPECT_EQ(steps_, std::vector<Step>{Step::kSignIns});
+}
+
+TEST_F(ArcSignInsCoreTest, LastProfileOfTheRunDropsTheKey) {
+  SetCookies(1, 0);
+  store_.report.total = 1;
+  store_.report.set = 1;
+  ArcRunKeyCache keys(Keychain());
+  Run(keys, Job(kRun));
+  Run(keys, Job(kRun));
+  // What the importer does once the run's last profile is done.
+  keys.EndRun(kRun);
+  EXPECT_EQ(keys.run_count_for_testing(), 0u);
+
+  // A retry is a run of its own, and asks once.
+  Run(keys, Job(kOtherRun));
+  EXPECT_EQ(keychain_.requests, 2);
+}
+
+TEST_F(ArcSignInsCoreTest, RefusedReadsNothing) {
+  keychain_.answer = base::unexpected(ArcKeyError::kDenied);
+  SetCookies(1, 0);
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kDenied);
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kDenied);
+  EXPECT_EQ(keychain_.requests, 1);
+  EXPECT_EQ(reads_.load(), 0);
+  EXPECT_EQ(store_.sinks_made, 0);
+}
+
+TEST_F(ArcSignInsCoreTest, MissingKeyFails) {
+  keychain_.answer = base::unexpected(ArcKeyError::kNotFound);
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_EQ(Run(keys, Job(kRun)).status, Status::kFailed);

+ArcSignInsResult WithStatus(ArcSignInsResult::Status status) {
+  ArcSignInsResult result;
+  result.status = status;
+  return result;
+}
+
+void PostKey(ArcKeyCallback done, ArcKeyResult key) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), std::move(key)));
+}
+
+// One profile's sign-ins. Its owner keeps it from RunArcSignIns() until
+// `done`, or cancels it by destroying it.
+class SignInsRun : public ArcSignInsRun {
+ public:
+  SignInsRun(ArcRunKeyCache& keys, ArcSignInsJob job, ArcSignInsCallback done)
+      : keys_(keys), job_(std::move(job)), done_(std::move(done)) {
+    CHECK(job_.is_arc_running);
+    CHECK(job_.has_cookie_db);
+    CHECK(job_.read_cookies);
+    CHECK(job_.make_sink);
+  }
+  SignInsRun(const SignInsRun&) = delete;
+  SignInsRun& operator=(const SignInsRun&) = delete;
+  ~SignInsRun() override = default;
+
+  void Start() {
+    // Arc keeps its cookie store open while it runs, so a copy could be torn
+    // or stale.
+    if (job_.is_arc_running.Run()) {
+      Finish(WithStatus(ArcSignInsResult::Status::kArcRunning));
+      return;
+    }
+    // Nothing to read, so nothing to ask macOS for.
+    if (job_.arc_support_dir.empty() || job_.profile_directory.empty()) {
+      Finish(WithStatus(ArcSignInsResult::Status::kNoCookies));
+      return;
+    }
+    // Looked for before the key, so a profile without a database never
+    // shows macOS's prompt.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(job_.has_cookie_db, job_.arc_support_dir,
+                       job_.profile_directory),
+        base::BindOnce(&SignInsRun::OnCookieDbChecked,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnCookieDbChecked(bool found) {
+    if (!found) {
+      Finish(WithStatus(ArcSignInsResult::Status::kNoCookies));
+      return;
+    }
+    if (!keys_->HasAnswer(job_.run_id)) {
+      Progress(ArcImportProgress::Step::kWaitingForMac);
+    }
+    keys_->GetKey(job_.run_id, base::BindOnce(&SignInsRun::OnKey,
+                                              weak_factory_.GetWeakPtr()));
+  }
+
+  void OnKey(ArcKeyResult key) {
+    if (!key.has_value()) {
+      Finish(WithStatus(SignInsStatusFor(key.error())));
+      return;
+    }
+    // The user may have opened Arc while macOS showed its prompt.
+    if (job_.is_arc_running.Run()) {
+      Finish(WithStatus(ArcSignInsResult::Status::kArcRunning));
+      return;
+    }
+    Progress(ArcImportProgress::Step::kSignIns);
+    // The task's copy of the key zeroes itself once the read is done.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(job_.read_cookies, job_.arc_support_dir,
+                       job_.profile_directory, std::move(key).value()),
+        base::BindOnce(&SignInsRun::OnRead, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnRead(base::expected<ArcCookieReadResult, CookieDbReadError> read) {
+    if (!read.has_value()) {
+      Finish(WithStatus(SignInsStatusFor(read.error())));
+      return;
+    }
+    undecodable_ = read->undecodable;
+    truncated_ = read->truncated;
+    if (read->cookies.empty()) {
+      Finish(FoldArcSignIns(undecodable_, truncated_, CookieWriteReport()));
+      return;
+    }
+    sink_ = std::move(job_.make_sink).Run();
+    if (!sink_) {
+      Finish(WithStatus(ArcSignInsResult::Status::kFailed));
+      return;
+    }
+    sink_->Write(
+        std::move(read->cookies),
+        base::BindOnce(&SignInsRun::OnWritten, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnWritten(const CookieWriteReport& report) {
+    Finish(FoldArcSignIns(undecodable_, truncated_, report));
+  }
+
+  void Progress(ArcImportProgress::Step step) {
+    if (!job_.progress) {
+      return;
+    }
+    ArcImportProgress progress;
+    progress.step = step;
+    job_.progress.Run(progress);
+  }
+
+  void Finish(const ArcSignInsResult& result) {
+    // The writer allows deleting the sink from its `done`.
+    sink_.reset();
+    // Through a weak pointer, so destroying the run before the task runs
+    // still cancels `done`.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SignInsRun::Report,
+                                  weak_factory_.GetWeakPtr(), result));
+  }
+
+  void Report(const ArcSignInsResult& result) {
+    // The owner may destroy this run from `done`; nothing here touches it
+    // after.
+    std::move(done_).Run(result);
+  }
+
+  const raw_ref<ArcRunKeyCache> keys_;
+  ArcSignInsJob job_;
+  ArcSignInsCallback done_;
+  std::unique_ptr<ArcCookieSink> sink_;
+  int undecodable_ = 0;
+  bool truncated_ = false;
+  base::WeakPtrFactory<SignInsRun> weak_factory_{this};
+};
+
+}  // namespace
+
+ArcCookieKey::ArcCookieKey(
+    base::span<const uint8_t, kImportedCookieKeySize> bytes) {

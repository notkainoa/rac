+
+#ifndef CHROME_BROWSER_RAC_IMPORT_ARC_SIGNINS_CORE_H_
+#define CHROME_BROWSER_RAC_IMPORT_ARC_SIGNINS_CORE_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/types/expected.h"
+#include "chrome/browser/rac/import/arc_cookie_import.h"
+#include "chrome/browser/rac/import/arc_import_types.h"
+#include "chrome/browser/rac/import/arc_safe_storage_key.h"
+#include "chrome/browser/rac/import/cookie_db_rows.h"
+#include "chrome/browser/rac/import/cookie_writer.h"
+#include "chrome/browser/rac/import/imported_cookie_crypto.h"
+
+// The parts of the Arc sign-ins step that need no profile: the import run's
+// cookie key, one Arc profile's cookie import behind seams, and how its
+// outcome folds into ArcSignInsResult. The browser side, which binds the
+// seams to Arc's Keychain item, Arc's files and a profile's cookie store, is
+// chrome/browser/ui/rac/import/arc_signins.h.
+
+namespace rac::import {
+
+// A cookie key derived from Arc's Safe Storage password. Every copy zeroes
+// itself when it goes.
+class ArcCookieKey {
+ public:
+  explicit ArcCookieKey(
+      base::span<const uint8_t, kImportedCookieKeySize> bytes);
+  ArcCookieKey(const ArcCookieKey&);
+  ArcCookieKey& operator=(const ArcCookieKey&);
+  ~ArcCookieKey();
+
+  base::span<const uint8_t, kImportedCookieKeySize> bytes() const {
+    return bytes_;
+  }
+
+ private:
+  std::array<uint8_t, kImportedCookieKeySize> bytes_;
+};
+
+using ArcKeyResult = base::expected<ArcCookieKey, ArcKeyError>;
+using ArcKeyCallback = base::OnceCallback<void(ArcKeyResult)>;
+
+// Arc's cookie key, per import run. The run's first profile asks the
+// ArcSafeStorageKeySource for Arc's password, which may show macOS's
+// Keychain prompt, and derives the key; the password is zeroed right after.
+// The run's other profiles get the same answer without asking again. A
+// refusal or failure is kept too, so one run never prompts twice. EndRun()
+// zeroes and forgets the run's key. Nothing is written anywhere.
+//
+// UI thread only.
+class ArcRunKeyCache {
+ public:
+  using SourceFactory =
+      base::RepeatingCallback<std::unique_ptr<ArcSafeStorageKeySource>()>;
+
+  explicit ArcRunKeyCache(SourceFactory make_source);
+  ArcRunKeyCache(const ArcRunKeyCache&) = delete;
+  ArcRunKeyCache& operator=(const ArcRunKeyCache&) = delete;
+  ~ArcRunKeyCache();
+
+  // Runs `done` with `run_id`'s key, always from a posted task. Calls made
+  // while the source is asking wait for its answer.
+  void GetKey(const std::string& run_id, ArcKeyCallback done);
+  // Whether `run_id` already has an answer, so GetKey() won't ask.
+  bool HasAnswer(const std::string& run_id) const;
+  // Zeroes and forgets `run_id`'s key, and drops a request still in flight.
+  // Callers still waiting get kFailed.
+  void EndRun(const std::string& run_id);
+  // EndRun() for every run, such as at shutdown.
+  void EndAll();
+
+  size_t run_count_for_testing() const { return runs_.size(); }
+
+ private:
+  struct Run;
+
+  void OnPassword(const std::string& run_id,
+                  base::expected<std::string, ArcKeyError> password);
+
+  SourceFactory make_source_;
+  std::map<std::string, std::unique_ptr<Run>> runs_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<ArcRunKeyCache> weak_factory_{this};
+};
+
+// Whether Arc has a cookie database for the profile: ArcCookieDbPath() isn't
+// empty. Blocking; runs on the thread pool.
+using ArcCookieDbFinder =
+    base::RepeatingCallback<bool(const base::FilePath& arc_support_dir,
+                                 const std::string& profile_directory)>;
+
+// Reads one Arc profile's cookies: ArcCookieDbPath(), then ReadArcCookies().
+// Blocking; runs on the thread pool. kSourceMissing when Arc has no cookie
+// database for the profile.
+using ArcCookieReader = base::RepeatingCallback<
+    base::expected<ArcCookieReadResult, CookieDbReadError>(
+        const base::FilePath& arc_support_dir,
+        const std::string& profile_directory,
+        const ArcCookieKey& key)>;
+
+// Where one profile's cookies go: CookieWriter, in the browser.
+class ArcCookieSink {
+ public:
+  virtual ~ArcCookieSink() = default;
+  // Call once. `done` runs once, in its own task, and may delete the sink.
+  // Deleting the sink first cancels; `done` then never runs.
+  virtual void Write(std::vector<ImportedCookie> cookies,
+                     CookieWriter::DoneCallback done) = 0;
+};
+
+using ArcSignInsProgressCallback =
+    base::RepeatingCallback<void(const ArcImportProgress&)>;
+using ArcSignInsCallback = base::OnceCallback<void(const ArcSignInsResult&)>;
+
+// One Arc profile's sign-ins.
+struct ArcSignInsJob {
+  ArcSignInsJob();
+  ArcSignInsJob(ArcSignInsJob&&);
+  ArcSignInsJob& operator=(ArcSignInsJob&&);
+  ~ArcSignInsJob();
+
+  // ArcImportRun::id: which key the job uses.
+  std::string run_id;
+  // Arc's support folder (ImportPlan::source_dir).
+  base::FilePath arc_support_dir;
+  // ImportProfile::directory.
+  std::string profile_directory;
+  // IsArcRunning(). Must be set.
+  base::RepeatingCallback<bool()> is_arc_running;
+  // Must be set.
+  ArcCookieDbFinder has_cookie_db;
+  // Must be set.
+  ArcCookieReader read_cookies;
+  // Makes the target's sink right before the write. Null if the target is
+  // gone or can't take cookies. Must be set.
+  base::OnceCallback<std::unique_ptr<ArcCookieSink>()> make_sink;
+  // kWaitingForMac while the key is asked for, then kSignIns. May be null.
+  ArcSignInsProgressCallback progress;
+};
+
+// One ArcSignInsJob while it runs. Destroying it cancels the job: its `done`
+// then never runs. It may be destroyed from `done`.
+class ArcSignInsRun {
+ public:
+  virtual ~ArcSignInsRun() = default;
+};
+
+// Runs `job`, in order:
+//
+// 1. Arc is running: kArcRunning. Nothing is read or asked for.
+// 2. No Arc folder or profile folder: kNoCookies, without asking for the key.
+// 3. `has_cookie_db` on a MayBlock thread pool task. No database:
+//    kNoCookies, without asking for the key.
+// 4. The run's key from `keys`; kWaitingForMac first if it has to ask. A
+//    refusal is kDenied; any other key error is kFailed.
+// 5. Arc started while the key was asked for: kArcRunning. Nothing is read.
+// 6. kSignIns, then `read_cookies` on a MayBlock thread pool task.
+// 7. The cookies go into `make_sink()`, which is kept until it reports.
+// 8. FoldArcSignIns().
+//
+// `done` runs once, always from a posted task, unless the returned run is
+// destroyed first. `keys` must outlive the run.
+[[nodiscard]] std::unique_ptr<ArcSignInsRun> RunArcSignIns(
+    ArcRunKeyCache& keys,
+    ArcSignInsJob job,
+    ArcSignInsCallback done);
+
+// The outcome of a read that found cookies, or found none (an empty
+// `written`): kDone with the counts, kNoCookies when there were none, or
+// kFailed when none could be decrypted or the store refused them all.
+ArcSignInsResult FoldArcSignIns(int undecodable,
+                                bool truncated,
+                                const CookieWriteReport& written);
+ArcSignInsResult::Status SignInsStatusFor(ArcKeyError error);
+ArcSignInsResult::Status SignInsStatusFor(CookieDbReadError error);
+
+// The whole import's status from its profiles' results and `failure`, the
+// starting profile's. kDone when a profile's sidebar part or history brought
+// something, or its sign-ins did and its sidebar part didn't fail: sign-ins
+// never make a failed profile count as done. That profile keeps both its
+// kFailed and its ArcSignInsResult. Otherwise kFailed if a profile failed or
+// `failure` is set, else kNothingNew.
+ArcImportResult::Status FoldArcImportStatus(
+    const std::vector<ArcProfileResult>& profiles,
+    ArcImportFailure failure);
+
+}  // namespace rac::import
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_ARC_SIGNINS_CORE_H_

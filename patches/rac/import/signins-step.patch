+// the override is gone. Test's main thread only.
+class ScopedArcSafeStorageKeyForTesting {
+ public:
+  explicit ScopedArcSafeStorageKeyForTesting(
+      base::expected<std::string, ArcKeyError> answer);
+  ScopedArcSafeStorageKeyForTesting(const ScopedArcSafeStorageKeyForTesting&) =
+      delete;
+  ScopedArcSafeStorageKeyForTesting& operator=(
+      const ScopedArcSafeStorageKeyForTesting&) = delete;
+  ~ScopedArcSafeStorageKeyForTesting();
+};
+
+}  // namespace rac::import

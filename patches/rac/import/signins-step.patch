+
+// Each run's key zeroes itself as `runs_` goes.
+ArcRunKeyCache::~ArcRunKeyCache() = default;
+
+void ArcRunKeyCache::GetKey(const std::string& run_id, ArcKeyCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::unique_ptr<Run>& run = runs_[run_id];
+  if (!run) {
+    run = std::make_unique<Run>();
+  }
+  if (run->answer) {
+    PostKey(std::move(done), *run->answer);
+    return;
+  }
+  run->waiting.push_back(std::move(done));
+  if (run->source) {
+    return;
+  }
+  run->source = make_source_.Run();
+  if (!run->source) {
+    OnPassword(run_id, base::unexpected(ArcKeyError::kFailed));
+    return;
+  }
+  // `run` may be gone by the time the source answers (EndRun()), so the
+  // answer finds it again by id.
+  run->source->GetPassword(base::BindOnce(&ArcRunKeyCache::OnPassword,
+                                          weak_factory_.GetWeakPtr(), run_id));
+}
+
+bool ArcRunKeyCache::HasAnswer(const std::string& run_id) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto it = runs_.find(run_id);
+  return it != runs_.end() && it->second->answer.has_value();
+}
+
+void ArcRunKeyCache::EndRun(const std::string& run_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  std::unique_ptr<Run> run = std::move(it->second);
+  runs_.erase(it);
+  for (ArcKeyCallback& done : run->waiting) {
+    PostKey(std::move(done), base::unexpected(ArcKeyError::kFailed));
+  }
+  // `run->answer` zeroes itself here, and dropping `run->source` drops its
+  // request.
+}
+
+void ArcRunKeyCache::EndAll() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // EndRun() posts its waiters' kFailed, so none of them runs in here and
+  // can start a new run meanwhile.
+  while (!runs_.empty()) {
+    // A copy: EndRun() erases the map's own.
+    const std::string run_id = runs_.begin()->first;
+    EndRun(run_id);
+  }
+}
+
+void ArcRunKeyCache::OnPassword(
+    const std::string& run_id,
+    base::expected<std::string, ArcKeyError> password) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::optional<ArcKeyResult> answer;
+  if (!password.has_value()) {
+    answer.emplace(base::unexpected(password.error()));
+  } else if (password->empty()) {
+    // An empty secret means no key; one derived from it anyone could compute
+    // (imported_cookie_crypto.h).
+    answer.emplace(base::unexpected(ArcKeyError::kFailed));
+  } else {
+    std::array<uint8_t, kImportedCookieKeySize> derived =
+        DeriveImportedCookieKey(base::as_byte_span(*password));
+    answer.emplace(ArcCookieKey(derived));
+    crypto::SecureZeroBuffer(derived);
+  }
+  if (password.has_value()) {
+    crypto::SecureZeroBuffer(base::as_writable_byte_span(*password));
+  }
+
+  const auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    // The run ended while the source asked. `answer` zeroes itself.
+    return;
+  }
+  Run& run = *it->second;
+  if (run.source) {
+    // Not deleted here: the source may still be on the stack.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(run.source));
+  }
+  run.answer = std::move(answer);
+  for (ArcKeyCallback& done : std::exchange(run.waiting, {})) {
+    PostKey(std::move(done), *run.answer);
+  }
+}
+
+ArcSignInsJob::ArcSignInsJob() = default;
+ArcSignInsJob::ArcSignInsJob(ArcSignInsJob&&) = default;
+ArcSignInsJob& ArcSignInsJob::operator=(ArcSignInsJob&&) = default;
+ArcSignInsJob::~ArcSignInsJob() = default;
+
+std::unique_ptr<ArcSignInsRun> RunArcSignIns(ArcRunKeyCache& keys,
+                                             ArcSignInsJob job,
+                                             ArcSignInsCallback done) {
+  auto run =
+      std::make_unique<SignInsRun>(keys, std::move(job), std::move(done));
+  run->Start();
+  return run;
+}
+
+ArcSignInsResult FoldArcSignIns(int undecodable,
+                                bool truncated,
+                                const CookieWriteReport& written) {
+  ArcSignInsResult result;
+  result.written = base::saturated_cast<int>(written.set);
+  result.skipped = base::saturated_cast<int>(written.skipped_total());
+  result.rejected = base::saturated_cast<int>(written.rejected_total());
+  result.undecodable = undecodable;
+  result.truncated = truncated;
+  if (written.total == 0) {
+    // Cookies that were there but none decrypted: most likely the wrong key.
+    result.status = undecodable > 0 ? ArcSignInsResult::Status::kFailed
+                                    : ArcSignInsResult::Status::kNoCookies;
+  } else if (written.set == 0 &&
+             written.rejected_count(CookieRejectReason::kStoreRefused) > 0) {
+    // The cookie store wasn't there, or refused everything sent to it.
+    result.status = ArcSignInsResult::Status::kFailed;
+  } else {
+    result.status = ArcSignInsResult::Status::kDone;
+  }
+  return result;
+}
+
+ArcSignInsResult::Status SignInsStatusFor(ArcKeyError error) {
+  switch (error) {
+    case ArcKeyError::kDenied:
+      return ArcSignInsResult::Status::kDenied;
+    case ArcKeyError::kNotFound:
+    case ArcKeyError::kFailed:
+      return ArcSignInsResult::Status::kFailed;
+  }
+  NOTREACHED();
+}
+
+ArcSignInsResult::Status SignInsStatusFor(CookieDbReadError error) {
+  switch (error) {
+    case CookieDbReadError::kSourceMissing:
+      return ArcSignInsResult::Status::kNoCookies;
+    case CookieDbReadError::kSourceTooLarge:
+    case CookieDbReadError::kTempDirFailed:
+    case CookieDbReadError::kCopyFailed:
+    case CookieDbReadError::kOpenFailed:
+    case CookieDbReadError::kNoCookiesTable:
+    case CookieDbReadError::kMissingRequiredColumn:
+    case CookieDbReadError::kQueryFailed:
+      return ArcSignInsResult::Status::kFailed;
+  }
+  NOTREACHED();
+}
+
+ArcImportResult::Status FoldArcImportStatus(
+    const std::vector<ArcProfileResult>& profiles,
+    ArcImportFailure failure) {
+  bool any_done = false;
+  bool any_failed = false;
+  for (const ArcProfileResult& profile : profiles) {
+    const bool failed = profile.status == ArcProfileResult::Status::kFailed;
+    any_done |= profile.status == ArcProfileResult::Status::kDone ||
+                profile.history == ArcProfileResult::History::kImported ||
+                (!failed && profile.sign_ins.written > 0);
+    any_failed |= failed;
+  }
+  if (any_done) {
+    return ArcImportResult::Status::kDone;
+  }
+  if (any_failed || failure != ArcImportFailure::kNone) {
+    return ArcImportResult::Status::kFailed;
+  }
+  return ArcImportResult::Status::kNothingNew;
+}
+
+}  // namespace rac::import

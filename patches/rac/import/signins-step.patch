+ArcProfileResult ProfileWith(ArcProfileResult::Status status,
+                             int sign_ins_written) {
+  ArcProfileResult profile;
+  profile.status = status;
+  if (sign_ins_written > 0) {
+    profile.sign_ins.status = Status::kDone;
+    profile.sign_ins.written = sign_ins_written;
+  }
+  return profile;
+}

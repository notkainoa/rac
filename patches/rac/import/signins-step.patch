+namespace rac {
+
+namespace {
+
+// Whether an ArcImportInProgress is held.
+bool g_arc_import_in_progress = false;
+
+}  // namespace
+
+// static
+std::unique_ptr<ArcImportInProgress> ArcImportInProgress::TryBegin() {
+  if (g_arc_import_in_progress) {
+    return nullptr;
+  }
+  g_arc_import_in_progress = true;

+// Blocking: runs on the thread pool.
+base::expected<import::ArcCookieReadResult, import::CookieDbReadError>
+ReadProfileCookies(const base::FilePath& arc_support_dir,
+                   const std::string& profile_directory,
+                   const import::ArcCookieKey& key) {
+  const base::FilePath db =
+      import::ArcCookieDbPath(arc_support_dir, profile_directory);
+  if (db.empty()) {
+    return base::unexpected(import::CookieDbReadError::kSourceMissing);
+  }
+  return import::ReadArcCookies(db, key.bytes());
+}
+
+// A profile's cookie store, through the importer's writer.
+class ProfileCookieSink : public import::ArcCookieSink {
+ public:
+  explicit ProfileCookieSink(std::unique_ptr<import::CookieWriter> writer)
+      : writer_(std::move(writer)) {}
+
+  // import::ArcCookieSink:
+  void Write(std::vector<import::ImportedCookie> cookies,
+             import::CookieWriter::DoneCallback done) override {
+    writer_->Write(std::move(cookies), std::move(done));
+  }
+
+ private:
+  std::unique_ptr<import::CookieWriter> writer_;
+};
+
+// Made right before the write: the writer reads the profile's clear-on-exit
+// rules when it's created.
+std::unique_ptr<import::ArcCookieSink> MakeProfileSink(
+    base::WeakPtr<Profile> target) {
+  if (!target) {
+    return nullptr;
+  }
+  return std::make_unique<ProfileCookieSink>(
+      import::CreateCookieWriterForImport(target.get()));
+}
+
+// One profile a run brought sign-ins into, for RetryArcSignIns().
+struct SignInsTarget {
+  base::FilePath profile_path;
+  std::string source_key;
+};
+
+// The profile maker and the sign-ins step, for the whole browser. Made the
+// first time an import screen opens; never destroyed.
+class ArcSignIns : public ArcProfileMaker, public ArcSignInsStep {
+ public:
+  static ArcSignIns& Get() {
+    static base::NoDestructor<ArcSignIns> instance;
+    return *instance;
+  }
+
+  ArcSignIns(const ArcSignIns&) = delete;
+  ArcSignIns& operator=(const ArcSignIns&) = delete;
+
+  // ArcProfileMaker:
+  void MakeProfile(const ImportProfile& source,
+                   const std::u16string& name,
+                   base::OnceCallback<void(Profile*)> done) override {
+    if (!g_browser_process->profile_manager()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](base::OnceCallback<void(Profile*)> done) {
+                           std::move(done).Run(nullptr);
+                         },
+                         std::move(done)));
+      return;
+    }
+    // `done` gets the profile once it's initialized, or null. A new profile
+    // holds ProfileManager's kWaitingForFirstBrowserWindow keep-alive until
+    // its first window closes, so it stays loaded through the import.
+    ProfileManager::CreateMultiProfileAsync(
+        name, profiles::GetPlaceholderAvatarIndex(), /*is_hidden=*/false,
+        std::move(done));
+  }
+
+  // ArcSignInsStep:
+  void ImportSignIns(Profile* target,
+                     const ImportProfile& source,
+                     const std::string& run_id,
+                     const base::FilePath& arc_support_dir,
+                     ArcImportProgressCallback progress,
+                     ArcSignInsDoneCallback done) override {
+    pending_targets_[run_id].push_back({target->GetPath(), source.source_key});
+    Run(target, source.directory, run_id, arc_support_dir, std::move(progress),
+        std::move(done));
+  }
+
+  void EndRun(const std::string& run_id,
+              const base::FilePath& origin_path) override {
+    keys_.EndRun(run_id);
+    // The newest run from `origin_path` is the one a retry repeats, even
+    // when it brought no sign-ins.
+    std::vector<SignInsTarget> targets;
+    if (auto it = pending_targets_.find(run_id); it != pending_targets_.end()) {
+      targets = std::move(it->second);
+      pending_targets_.erase(it);
+    }
+    if (targets.empty()) {
+      last_targets_.erase(origin_path);
+    } else {
+      last_targets_[origin_path] = std::move(targets);
+    }
+  }
+
+  // One profile's sign-ins, under `run_id`'s key.
+  void Run(Profile* target,
+           const std::string& profile_directory,
+           const std::string& run_id,
+           const base::FilePath& arc_support_dir,
+           ArcImportProgressCallback progress,
+           ArcSignInsDoneCallback done) {
+    import::ArcSignInsJob job;
+    job.run_id = run_id;
+    job.arc_support_dir = arc_support_dir;
+    job.profile_directory = profile_directory;
+    job.is_arc_running = base::BindRepeating(&import::IsArcRunning);
+    job.read_cookies = base::BindRepeating(&ReadProfileCookies);
+    job.make_sink = base::BindOnce(&MakeProfileSink, target->GetWeakPtr());
+    job.progress = std::move(progress);
+    import::RunArcSignIns(keys_, std::move(job), std::move(done));
+  }
+
+  // A retry's own run, which no importer ends.
+  void EndRetry(const std::string& run_id) { keys_.EndRun(run_id); }
+
+  std::vector<SignInsTarget> LastTargets(
+      const base::FilePath& origin_path) const {
+    const auto it = last_targets_.find(origin_path);
+    return it != last_targets_.end() ? it->second
+                                     : std::vector<SignInsTarget>();
+  }
+
+ private:
+  friend class base::NoDestructor<ArcSignIns>;
+
+  ArcSignIns() = default;
+  ~ArcSignIns() override = default;
+
+  import::ArcRunKeyCache keys_{
+      base::BindRepeating(&import::CreateArcSafeStorageKeySource)};
+  // Runs still going: the profiles they brought sign-ins into so far.
+  std::map<std::string, std::vector<SignInsTarget>> pending_targets_;
+  // The newest finished run's profiles, by the profile it started from.
+  std::map<base::FilePath, std::vector<SignInsTarget>> last_targets_;
+};
+
+// RetryArcSignIns(). Owns itself from Start() until it runs `done`.
+class ArcSignInsRetry {
+ public:
+  static void Start(base::FilePath origin_path,
+                    std::vector<SignInsTarget> targets,
+                    ArcImportProgressCallback progress,
+                    ArcImportDoneCallback done) {
+    (new ArcSignInsRetry(std::move(origin_path), std::move(targets),
+                         std::move(progress), std::move(done)))
+        ->ReadPlan();
+  }
+
+  ArcSignInsRetry(const ArcSignInsRetry&) = delete;
+  ArcSignInsRetry& operator=(const ArcSignInsRetry&) = delete;
+
+ private:
+  ArcSignInsRetry(base::FilePath origin_path,
+                  std::vector<SignInsTarget> targets,
+                  ArcImportProgressCallback progress,
+                  ArcImportDoneCallback done)
+      : origin_path_(std::move(origin_path)),
+        targets_(std::move(targets)),
+        progress_(std::move(progress)),
+        done_(std::move(done)),
+        run_id_(base::Uuid::GenerateRandomV4().AsLowercaseString()) {
+    for (const SignInsTarget& target : targets_) {
+      ArcProfileResult result;
+      result.source_key = target.source_key;
+      result.profile_path = target.profile_path;
+      // The sidebar part isn't run again.
+      result.status = ArcProfileResult::Status::kNothingNew;
+      result.new_profile = target.profile_path != origin_path_;
+      results_.push_back(std::move(result));
+    }
+  }
+
+  ~ArcSignInsRetry() = default;
+
+  void ReadPlan() {
+    if (targets_.empty()) {
+      PostFinish();
+      return;
+    }
+    // GetArcSourcePaths() can touch the disk under the dev source switch.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce([] { return ReadArc(GetArcSourcePaths()); }),
+        base::BindOnce(&ArcSignInsRetry::OnPlanRead,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnPlanRead(base::expected<ImportPlan, ArcReadError> plan) {
+    if (!plan.has_value()) {
+      for (ArcProfileResult& result : results_) {
+        result.sign_ins.status = ArcSignInsResult::Status::kFailed;
+      }
+      Finish();
+      return;
+    }
+    plan_ = std::move(plan).value();
+    Next();
+  }
+
+  void Next() {
+    if (next_ == targets_.size()) {
+      Finish();
+      return;
+    }
+    const size_t index = next_++;
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (!FindSource(targets_[index].source_key) || !manager) {
+      // That Arc profile is gone from Arc, or the browser is shutting down.
+      results_[index].sign_ins.status = ArcSignInsResult::Status::kFailed;
+      PostNext();
+      return;
+    }
+    // Runs `OnProfileLoaded` with null, right away, if the profile is gone.
+    manager->LoadProfileByPath(
+        targets_[index].profile_path, /*incognito=*/false,
+        base::BindOnce(&ArcSignInsRetry::OnProfileLoaded,
+                       weak_factory_.GetWeakPtr(), index));
+  }
+
+  void OnProfileLoaded(size_t index, Profile* profile) {
+    if (profile) {
+      // Nothing else keeps a profile loaded by path alive meanwhile. The
+      // same origin as Undo's.
+      keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
+          profile,
+          ProfileKeepAliveOrigin::kWaitingForBookmarksImportOnFirstRun);
+    }
+    const ImportProfile* source = FindSource(targets_[index].source_key);
+    if (!profile || !keep_alive_ || !source) {
+      results_[index].sign_ins.status = ArcSignInsResult::Status::kFailed;
+      keep_alive_.reset();
+      PostNext();
+      return;
+    }
+    ArcSignIns::Get().Run(profile, source->directory, run_id_, plan_.source_dir,
+                          progress_,
+                          base::BindOnce(&ArcSignInsRetry::OnSignInsDone,
+                                         weak_factory_.GetWeakPtr(), index));
+  }
+
+  void OnSignInsDone(size_t index, const ArcSignInsResult& sign_ins) {
+    results_[index].sign_ins = sign_ins;
+    keep_alive_.reset();
+    Next();
+  }
+
+  const ImportProfile* FindSource(const std::string& source_key) const {
+    for (const ImportProfile& source : plan_.profiles) {
+      if (source.source_key == source_key) {
+        return &source;
+      }
+    }
+    return nullptr;
+  }
+
+  void PostNext() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ArcSignInsRetry::Next, weak_factory_.GetWeakPtr()));
+  }
+
+  void PostFinish() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ArcSignInsRetry::Finish, weak_factory_.GetWeakPtr()));
+  }
+
+  void Finish() {
+    ArcSignIns::Get().EndRetry(run_id_);
+    ArcImportResult result;
+    bool any_written = false;
+    bool any_failed = targets_.empty();
+    for (const ArcProfileResult& profile : results_) {
+      any_written |= profile.sign_ins.written > 0;
+      any_failed |=
+          profile.sign_ins.status == ArcSignInsResult::Status::kFailed ||
+          profile.sign_ins.status == ArcSignInsResult::Status::kDenied ||
+          profile.sign_ins.status == ArcSignInsResult::Status::kArcRunning;
+    }
+    result.status = any_written  ? ArcImportResult::Status::kDone
+                    : any_failed ? ArcImportResult::Status::kFailed
+                                 : ArcImportResult::Status::kNothingNew;
+    result.profiles = std::move(results_);
+    std::move(done_).Run(result);
+    delete this;
+  }
+
+  const base::FilePath origin_path_;
+  const std::vector<SignInsTarget> targets_;
+  ArcImportProgressCallback progress_;
+  ArcImportDoneCallback done_;
+  // Its own key run: the import's ended, and its key with it.
+  const std::string run_id_;
+  ImportPlan plan_;
+  std::vector<ArcProfileResult> results_;
+  size_t next_ = 0;
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+  base::WeakPtrFactory<ArcSignInsRetry> weak_factory_{this};
+};
+
+}  // namespace
+
+bool ArcSignInsAvailable() {
+  return true;
+}
+
+void InstallArcSignIns() {
+  ArcSignIns& sign_ins = ArcSignIns::Get();
+  SetArcProfileMaker(&sign_ins);
+  SetArcSignInsStep(&sign_ins);
+}
+
+void RetryArcSignIns(Profile* profile,
+                     ArcImportProgressCallback progress,
+                     ArcImportDoneCallback done) {
+  ArcSignInsRetry::Start(profile->GetPath(),
+                         ArcSignIns::Get().LastTargets(profile->GetPath()),
+                         std::move(progress), std::move(done));
+}
+
+#else  // BUILDFLAG(IS_MAC)
+
+bool ArcSignInsAvailable() {
+  return false;
+}
+
+void InstallArcSignIns() {}
+
+void RetryArcSignIns(Profile* profile,
+                     ArcImportProgressCallback progress,
+                     ArcImportDoneCallback done) {
+  // ArcImportResult starts as kFailed.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), ArcImportResult()));
+}
+
+#endif  // BUILDFLAG(IS_MAC)
+
+}  // namespace rac

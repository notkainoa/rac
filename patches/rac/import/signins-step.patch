--- /dev/null
+++ src/chrome/browser/rac/import/arc_cookie_import_unittest.cc
@@ -0,0 +1,455 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_cookie_import.h"
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/notreached.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/rac/import/cookie_db_rows.h"
+#include "chrome/browser/rac/import/cookie_fixture_db.h"
+#include "chrome/browser/rac/import/cookie_writer.h"
+#include "chrome/browser/rac/import/imported_cookie_crypto.h"
+#include "net/cookies/cookie_constants.h"
+#include "sql/database.h"
+#include "sql/test/test_helpers.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::import {
+namespace {
+
+// The layout cookie_test_vectors.inc expects its includer to define.
+struct CookieTestVector {
+  const char* name;
+  const char* host_key;
+  int db_version;
+  const char* encrypted_hex;
+  const char* plaintext;
+  const char* expect;
+};
+
+// Generated from synthetic fixtures with a fixed test password. Defines
+// kTestPassword, kTestDerivedKeyHex, and kCookieTestVectors.
+#include "chrome/browser/rac/import/cookie_test_vectors.inc"
+
+using test::CookieFixtureDb;
+using test::FixtureCookieRow;
+
+// Every v23 vector fails its padding check under the key from this password,
+// so a wrong key is detectable at both versions in these tests. (In general a
+// wrong key passes a v23 value about 1 time in 256.)
+constexpr char kOtherPassword[] = "not the fixture password";
+
+std::array<uint8_t, kImportedCookieKeySize> KeyFor(std::string_view password) {
+  return DeriveImportedCookieKey(base::as_byte_span(password));
+}
+
+std::vector<uint8_t> FromHex(std::string_view hex) {
+  std::vector<uint8_t> bytes;
+  // HexStringToBytes() rejects "", but the empty_blob vector is legitimately
+  // zero bytes.
+  if (!hex.empty()) {
+    EXPECT_TRUE(base::HexStringToBytes(hex, &bytes)) << hex;
+  }
+  return bytes;
+}
+
+const CookieTestVector& VectorNamed(std::string_view name) {
+  for (const CookieTestVector& v : kCookieTestVectors) {
+    if (name == v.name) {
+      return v;
+    }
+  }
+  NOTREACHED() << name;
+}
+
+// A fixture row holding `vector`'s blob, named after the vector so names stay
+// unique for the cookies_unique_index.
+FixtureCookieRow RowFor(const CookieTestVector& vector) {
+  FixtureCookieRow row;
+  row.host_key = vector.host_key;
+  row.name = vector.name;
+  row.encrypted_value = FromHex(vector.encrypted_hex);
+  return row;
+}
+
+std::vector<const CookieTestVector*> OkVectorsAt(int version) {
+  std::vector<const CookieTestVector*> vectors;
+  for (const CookieTestVector& v : kCookieTestVectors) {
+    if (v.db_version == version && std::string_view(v.expect) == "ok") {
+      vectors.push_back(&v);
+    }
+  }
+  return vectors;
+}
+
+const ImportedCookie* CookieNamed(const ArcCookieReadResult& result,
+                                  std::string_view name) {
+  for (const ImportedCookie& cookie : result.cookies) {
+    if (cookie.name == name) {
+      return &cookie;
+    }
+  }
+  return nullptr;
+}
+
+int64_t ToDb(base::Time time) {
+  return time.ToDeltaSinceWindowsEpoch().InMicroseconds();
+}
+
+class ArcCookieImportTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    db_path_ = temp_dir_.GetPath().AppendASCII("Cookies");
+  }
+
+  // Writes `rows` into a fresh fixture DB at `db_path_`.
+  void MakeDb(int version, const std::vector<FixtureCookieRow>& rows) {
+    auto fixture = CookieFixtureDb::Create(db_path_, {.meta_version = version});
+    ASSERT_TRUE(fixture);
+    ASSERT_TRUE(fixture->AddRows(rows));
+  }
+
+  const std::array<uint8_t, kImportedCookieKeySize> key_ =
+      KeyFor(kTestPassword);
+  base::ScopedTempDir temp_dir_;
+  base::FilePath db_path_;
+};
+
+TEST_F(ArcCookieImportTest, TestKeyMatchesVectors) {
+  EXPECT_EQ(base::HexEncodeLower(key_), kTestDerivedKeyHex);
+}
+
+class ArcCookieImportVersionTest : public ArcCookieImportTest,
+                                   public testing::WithParamInterface<int> {};
+
+// Every decodable vector at the DB's version comes back with its plaintext.
+TEST_P(ArcCookieImportVersionTest, DecodesGoodRows) {
+  const int version = GetParam();
+  const std::vector<const CookieTestVector*> vectors = OkVectorsAt(version);
+  ASSERT_FALSE(vectors.empty());
+  std::vector<FixtureCookieRow> rows;
+  for (const CookieTestVector* v : vectors) {
+    rows.push_back(RowFor(*v));
+  }
+  ASSERT_NO_FATAL_FAILURE(MakeDb(version, rows));
+
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(0, result->undecodable);
+  EXPECT_FALSE(result->truncated);
+  ASSERT_EQ(vectors.size(), result->cookies.size());
+  for (const CookieTestVector* v : vectors) {
+    SCOPED_TRACE(v->name);
+    const ImportedCookie* cookie = CookieNamed(*result, v->name);
+    ASSERT_TRUE(cookie);
+    EXPECT_EQ(v->plaintext, cookie->value);
+    EXPECT_EQ(v->host_key, cookie->host_key);
+  }
+}
+
+// Every column the writer uses lands in its field.
+TEST_P(ArcCookieImportVersionTest, MapsEveryField) {
+  const int version = GetParam();
+  FixtureCookieRow row =
+      RowFor(VectorNamed(version == 23 ? "plain_v23" : "plain_v24"));
+  row.name = "session";
+  row.creation_utc = 13'380'000'000'000'001;
+  row.top_frame_site_key = "https://toplevel.example";
+  row.path = "/account";
+  row.expires_utc = 13'390'000'000'000'002;
+  row.is_secure = true;
+  row.is_httponly = true;
+  row.last_access_utc = 13'380'000'000'000'003;
+  row.has_expires = true;
+  row.priority = 2;
+  row.samesite = 2;
+  row.source_scheme = 2;
+  row.source_port = 443;
+  row.has_cross_site_ancestor = true;
+  ASSERT_NO_FATAL_FAILURE(MakeDb(version, {row}));
+
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_TRUE(result.has_value());
+  ASSERT_EQ(1u, result->cookies.size());
+  const ImportedCookie& cookie = result->cookies[0];
+  EXPECT_EQ("session", cookie.name);
+  EXPECT_EQ("session=abc123", cookie.value);
+  EXPECT_EQ("example.com", cookie.host_key);
+  EXPECT_EQ("/account", cookie.path);
+  EXPECT_EQ(row.creation_utc, ToDb(cookie.creation));
+  EXPECT_EQ(row.expires_utc, ToDb(cookie.expiry));
+  EXPECT_EQ(row.last_access_utc, ToDb(cookie.last_access));
+  EXPECT_TRUE(cookie.secure);
+  EXPECT_TRUE(cookie.http_only);
+  EXPECT_EQ(net::CookieSameSite::STRICT_MODE, cookie.same_site);
+  EXPECT_EQ(net::COOKIE_PRIORITY_HIGH, cookie.priority);
+  EXPECT_EQ(net::CookieSourceScheme::kSecure, cookie.source_scheme);
+  EXPECT_EQ(443, cookie.source_port);
+  EXPECT_EQ("https://toplevel.example", cookie.partition_key);
+  EXPECT_TRUE(cookie.has_cross_site_ancestor);
+}
+
+// The wrong key fails every encrypted row without crashing.
+TEST_P(ArcCookieImportVersionTest, WrongKeyGivesUndecodableRows) {
+  const int version = GetParam();
+  const std::vector<const CookieTestVector*> vectors = OkVectorsAt(version);
+  std::vector<FixtureCookieRow> rows;
+  for (const CookieTestVector* v : vectors) {
+    rows.push_back(RowFor(*v));
+  }
+  ASSERT_NO_FATAL_FAILURE(MakeDb(version, rows));
+
+  auto result = ReadArcCookies(db_path_, KeyFor(kOtherPassword));
+  ASSERT_TRUE(result.has_value());
+  EXPECT_TRUE(result->cookies.empty());
+  EXPECT_EQ(static_cast<int>(vectors.size()), result->undecodable);
+}
+
+INSTANTIATE_TEST_SUITE_P(MetaVersions,
+                         ArcCookieImportVersionTest,
+                         testing::Values(23, 24));
+
+// The other end of each field: a session cookie, unpartitioned, with the
+// DB's defaults.
+TEST_F(ArcCookieImportTest, MapsDefaults) {
+  FixtureCookieRow row = RowFor(VectorNamed("plain_v24"));
+  row.expires_utc = 0;
+  row.is_persistent = false;
+  row.priority = 0;
+  row.samesite = -1;
+  row.source_scheme = 1;
+  row.has_cross_site_ancestor = false;
+  ASSERT_NO_FATAL_FAILURE(MakeDb(24, {row}));
+
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_TRUE(result.has_value());
+  ASSERT_EQ(1u, result->cookies.size());
+  const ImportedCookie& cookie = result->cookies[0];
+  EXPECT_TRUE(cookie.expiry.is_null());
+  EXPECT_FALSE(cookie.secure);
+  EXPECT_FALSE(cookie.http_only);
+  EXPECT_EQ(net::CookieSameSite::UNSPECIFIED, cookie.same_site);
+  EXPECT_EQ(net::COOKIE_PRIORITY_LOW, cookie.priority);
+  EXPECT_EQ(net::CookieSourceScheme::kNonSecure, cookie.source_scheme);
+  EXPECT_EQ(-1, cookie.source_port);
+  EXPECT_TRUE(cookie.partition_key.empty());
+  EXPECT_FALSE(cookie.has_cross_site_ancestor);
+}
+
+// A priority the DB format doesn't define becomes the default rather than an
+// out-of-range net::CookiePriority.
+TEST_F(ArcCookieImportTest, UnknownPriorityBecomesDefault) {
+  FixtureCookieRow row = RowFor(VectorNamed("plain_v24"));
+  row.priority = 7;
+  ASSERT_NO_FATAL_FAILURE(MakeDb(24, {row}));
+
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_TRUE(result.has_value());
+  ASSERT_EQ(1u, result->cookies.size());
+  EXPECT_EQ(net::COOKIE_PRIORITY_DEFAULT, result->cookies[0].priority);
+}
+
+// Each kind of bad value is counted and left out; the good row still comes
+// through.
+TEST_F(ArcCookieImportTest, CountsAndSkipsUndecodableRows) {
+  std::vector<FixtureCookieRow> rows = {
+      RowFor(VectorNamed("plain_v24")),
+      RowFor(VectorNamed("bad_padding_v24")),
+      RowFor(VectorNamed("host_mismatch_v24")),
+      RowFor(VectorNamed("truncated_v24")),
+      RowFor(VectorNamed("v11_prefix_v24")),
+  };
+  ASSERT_NO_FATAL_FAILURE(MakeDb(24, rows));
+
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(4, result->undecodable);
+  ASSERT_EQ(1u, result->cookies.size());
+  EXPECT_EQ("plain_v24", result->cookies[0].name);
+  EXPECT_EQ("session=abc123", result->cookies[0].value);
+}
+
+// A row with an empty encrypted_value is stored in plaintext. It needs no
+// key, so it comes through even with the wrong one.
+TEST_F(ArcCookieImportTest, UsesPlaintextValueWhenNotEncrypted) {
+  FixtureCookieRow plain;
+  plain.host_key = ".example.org";
+  plain.name = "legacy";
+  plain.value = "plain";
+  FixtureCookieRow empty;
+  empty.host_key = ".example.org";
+  empty.name = "empty";
+  ASSERT_NO_FATAL_FAILURE(MakeDb(24, {plain, empty}));
+
+  for (const auto& key : {key_, KeyFor(kOtherPassword)}) {
+    auto result = ReadArcCookies(db_path_, key);
+    ASSERT_TRUE(result.has_value());
+    EXPECT_EQ(0, result->undecodable);
+    ASSERT_EQ(2u, result->cookies.size());
+    ASSERT_TRUE(CookieNamed(*result, "legacy"));
+    EXPECT_EQ("plain", CookieNamed(*result, "legacy")->value);
+    ASSERT_TRUE(CookieNamed(*result, "empty"));
+    EXPECT_EQ("", CookieNamed(*result, "empty")->value);
+  }
+}
+
+// Chromium's own store refuses a row with both values, since it can't tell
+// which is real. So does the import.
+TEST_F(ArcCookieImportTest, SkipsRowWithBothValues) {
+  FixtureCookieRow row = RowFor(VectorNamed("plain_v24"));
+  row.value = "plaintext too";
+  ASSERT_NO_FATAL_FAILURE(MakeDb(24, {row}));
+
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(1, result->undecodable);
+  EXPECT_TRUE(result->cookies.empty());
+}
+
+// A meta version the decoder doesn't know fails every encrypted row instead
+// of guessing at the format. Plaintext rows still come through.
+TEST_F(ArcCookieImportTest, UnsupportedVersionGivesUndecodableRows) {
+  FixtureCookieRow plain;
+  plain.host_key = "example.com";
+  plain.name = "legacy";
+  plain.value = "plain";
+  ASSERT_NO_FATAL_FAILURE(
+      MakeDb(24, {RowFor(VectorNamed("plain_v24")), plain}));
+  {
+    sql::Database db(sql::test::kTestTag);
+    ASSERT_TRUE(db.Open(db_path_));
+    ASSERT_TRUE(
+        db.Execute("UPDATE meta SET value = '25' WHERE key = 'version'"));
+  }
+
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(1, result->undecodable);
+  ASSERT_EQ(1u, result->cookies.size());
+  EXPECT_EQ("legacy", result->cookies[0].name);
+}
+
+TEST_F(ArcCookieImportTest, PassesReadErrorThrough) {
+  auto result = ReadArcCookies(db_path_, key_);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(CookieDbReadError::kSourceMissing, result.error());
+}
+
+class ArcCookieDbPathTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    support_ = temp_dir_.GetPath().AppendASCII("Arc");
+    // Arc's real folder name, built at runtime; no file in the repo has a
+    // space in its path.
+    user_data_ = support_.Append(FILE_PATH_LITERAL("User Data"));
+    ASSERT_TRUE(base::CreateDirectory(user_data_));
+  }
+
+  // Creates an empty file at `relative`, under "User Data".
+  base::FilePath Touch(std::string_view relative) {
+    const base::FilePath path = user_data_.AppendASCII(relative);
+    EXPECT_TRUE(base::CreateDirectory(path.DirName()));
+    EXPECT_TRUE(base::WriteFile(path, ""));
+    return path;
+  }
+
+  base::ScopedTempDir temp_dir_;
+  base::FilePath support_;
+  base::FilePath user_data_;
+};
+
+TEST_F(ArcCookieDbPathTest, PrefersNetworkCookies) {
+  const base::FilePath network = Touch("Default/Network/Cookies");
+  Touch("Default/Cookies");
+  EXPECT_EQ(network, ArcCookieDbPath(support_, "Default"));
+}
+
+TEST_F(ArcCookieDbPathTest, FallsBackToProfileCookies) {
+  const base::FilePath legacy = Touch("Profile 1/Cookies");
+  ASSERT_TRUE(base::CreateDirectory(
+      user_data_.AppendASCII("Profile 1").AppendASCII("Network")));
+  EXPECT_EQ(legacy, ArcCookieDbPath(support_, "Profile 1"));
+}
+
+TEST_F(ArcCookieDbPathTest, EmptyWhenNeitherExists) {
+  ASSERT_TRUE(base::CreateDirectory(user_data_.AppendASCII("Default")));
+  EXPECT_TRUE(ArcCookieDbPath(support_, "Default").empty());
+  EXPECT_TRUE(ArcCookieDbPath(support_, "Missing").empty());
+}
+
+// A folder named Cookies isn't a database.
+TEST_F(ArcCookieDbPathTest, IgnoresFolderNamedCookies) {
+  ASSERT_TRUE(
+      base::CreateDirectory(user_data_.AppendASCII("Default/Network/Cookies")));
+  const base::FilePath legacy = Touch("Default/Cookies");
+  EXPECT_EQ(legacy, ArcCookieDbPath(support_, "Default"));
+}
+
+// Names that could reach past one folder in "User Data" are refused, even
+// where a Cookies file waits at the end.
+TEST_F(ArcCookieDbPathTest, RejectsNamesThatArentOneFolder) {
+  // "User Data/.." is Arc's folder itself.
+  ASSERT_TRUE(base::WriteFile(support_.AppendASCII("Cookies"), ""));
+  Touch("a/b/Cookies");
+  Touch("Default/Cookies");
+  for (const char* name :
+       {"..", ".", "", "a/b", "../Arc", "Default/", "/Default", "a\\b"}) {
+    SCOPED_TRACE(name);
+    EXPECT_TRUE(ArcCookieDbPath(support_, name).empty());
+  }
+  EXPECT_TRUE(ArcCookieDbPath(support_, std::string("Default\0x", 9)).empty());
+  EXPECT_TRUE(ArcCookieDbPath(base::FilePath(), "Default").empty());
+}
+
+TEST_F(ArcCookieDbPathTest, RejectsSymlinkOutOfArcFolder) {
+  base::ScopedTempDir outside;
+  ASSERT_TRUE(outside.CreateUniqueTempDir());
+  const base::FilePath target = outside.GetPath().AppendASCII("Cookies");
+  ASSERT_TRUE(base::WriteFile(target, ""));
+  const base::FilePath network =
+      user_data_.AppendASCII("Default").AppendASCII("Network");
+  ASSERT_TRUE(base::CreateDirectory(network));
+  ASSERT_TRUE(base::CreateSymbolicLink(target, network.AppendASCII("Cookies")));
+  // An inside file at the fallback location isn't used instead.
+  Touch("Default/Cookies");
+
+  EXPECT_TRUE(ArcCookieDbPath(support_, "Default").empty());
+}
+
+TEST_F(ArcCookieDbPathTest, RejectsSymlinkedProfileFolderOutOfArcFolder) {
+  base::ScopedTempDir outside;
+  ASSERT_TRUE(outside.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(outside.GetPath().AppendASCII("Cookies"), ""));
+  ASSERT_TRUE(base::CreateSymbolicLink(outside.GetPath(),
+                                       user_data_.AppendASCII("Default")));
+
+  EXPECT_TRUE(ArcCookieDbPath(support_, "Default").empty());
+}
+
+TEST_F(ArcCookieDbPathTest, AllowsSymlinkThatStaysInside) {
+  const base::FilePath real = Touch("Default/Cookies");
+  const base::FilePath network =
+      user_data_.AppendASCII("Default").AppendASCII("Network");
+  ASSERT_TRUE(base::CreateDirectory(network));
+  const base::FilePath link = network.AppendASCII("Cookies");
+  ASSERT_TRUE(base::CreateSymbolicLink(real, link));
+
+  EXPECT_EQ(link, ArcCookieDbPath(support_, "Default"));
+}
+
+}  // namespace
+}  // namespace rac::import

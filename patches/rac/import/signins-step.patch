+#ifndef CHROME_BROWSER_UI_RAC_IMPORT_ARC_SIGNINS_H_
+#define CHROME_BROWSER_UI_RAC_IMPORT_ARC_SIGNINS_H_
+
+#include "chrome/browser/ui/rac/import/arc_importer.h"
+
+class Profile;
+
+// The Arc import's sign-ins step: the rac profiles for Arc's other profiles,
+// and Arc's cookies in each. The importer calls it through ArcProfileMaker
+// and ArcSignInsStep; the pure parts are in
+// chrome/browser/rac/import/arc_signins_core.h.
+//
+// For each profile, after its sidebar part: nothing while Arc runs, or
+// without a cookie database to read; Arc's password once per import run
+// (macOS may show its Keychain prompt), kept in memory only until the run's
+// last profile finishes, then zeroed; nothing if Arc started meanwhile;
+// Arc's cookie database copied and read on the thread pool; the cookies
+// written through CreateCookieWriterForImport(). Nothing is sent anywhere.
+// Undo never removes cookies.
+
+namespace rac {
+
+// Whether this build can bring over sign-ins: macOS only, where Arc keeps its
+// key in the Keychain.
+bool ArcSignInsAvailable();
+
+// Registers the profile maker and the sign-ins step with the importer.
+// Idempotent; UI thread. Costs nothing until an import runs. Does nothing
+// where ArcSignInsAvailable() is false.
+void InstallArcSignIns();
+
+// Brings over the sign-ins of the newest import started from `profile` in
+// this session again, into the same rac profiles, and nothing else: for
+// after Arc was quit or the Keychain prompt was refused. Reads Arc's plan
+// again, off the UI thread, and asks for Arc's key again, once. `done` runs
+// once, from a posted task, with each profile's ArcProfileResult::sign_ins;
+// their sidebar parts read kNothingNew. kFailed when there is nothing to
+// retry, and kFailed with kBusy while another Arc import, retry, or Undo
+// runs (ArcImportInProgress).
+void RetryArcSignIns(Profile* profile,
+                     ArcImportProgressCallback progress,
+                     ArcImportDoneCallback done);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_IMPORT_ARC_SIGNINS_H_

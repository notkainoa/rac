+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_signins_core.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/check.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/raw_ref.h"
+#include "base/notreached.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "crypto/secure_util.h"
+
+namespace rac::import {
+
+namespace {
+
+ArcSignInsResult WithStatus(ArcSignInsResult::Status status) {
+  ArcSignInsResult result;
+  result.status = status;
+  return result;
+}
+
+void PostKey(ArcKeyCallback done, ArcKeyResult key) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), std::move(key)));
+}
+
+// One profile's sign-ins. Owns itself from Start() until it posts `done`.
+class SignInsRun {
+ public:
+  SignInsRun(ArcRunKeyCache& keys, ArcSignInsJob job, ArcSignInsCallback done)
+      : keys_(keys), job_(std::move(job)), done_(std::move(done)) {
+    CHECK(job_.is_arc_running);
+    CHECK(job_.read_cookies);
+    CHECK(job_.make_sink);
+  }
+  SignInsRun(const SignInsRun&) = delete;
+  SignInsRun& operator=(const SignInsRun&) = delete;
+  ~SignInsRun() = default;
+
+  void Start() {
+    // Arc keeps its cookie store open while it runs, so a copy could be torn
+    // or stale.
+    if (job_.is_arc_running.Run()) {
+      Finish(WithStatus(ArcSignInsResult::Status::kArcRunning));
+      return;
+    }
+    // Nothing to read, so nothing to ask macOS for.
+    if (job_.arc_support_dir.empty() || job_.profile_directory.empty()) {
+      Finish(WithStatus(ArcSignInsResult::Status::kNoCookies));
+      return;
+    }
+    if (!keys_->HasAnswer(job_.run_id)) {
+      Progress(ArcImportProgress::Step::kWaitingForMac);
+    }
+    keys_->GetKey(job_.run_id, base::BindOnce(&SignInsRun::OnKey,
+                                              weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnKey(ArcKeyResult key) {
+    if (!key.has_value()) {
+      Finish(WithStatus(SignInsStatusFor(key.error())));
+      return;
+    }
+    Progress(ArcImportProgress::Step::kSignIns);
+    // The task's copy of the key zeroes itself once the read is done.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(job_.read_cookies, job_.arc_support_dir,
+                       job_.profile_directory, std::move(key).value()),
+        base::BindOnce(&SignInsRun::OnRead, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnRead(base::expected<ArcCookieReadResult, CookieDbReadError> read) {
+    if (!read.has_value()) {
+      Finish(WithStatus(SignInsStatusFor(read.error())));
+      return;
+    }
+    undecodable_ = read->undecodable;
+    truncated_ = read->truncated;
+    if (read->cookies.empty()) {
+      Finish(FoldArcSignIns(undecodable_, truncated_, CookieWriteReport()));
+      return;
+    }
+    sink_ = std::move(job_.make_sink).Run();
+    if (!sink_) {
+      Finish(WithStatus(ArcSignInsResult::Status::kFailed));
+      return;
+    }
+    sink_->Write(
+        std::move(read->cookies),
+        base::BindOnce(&SignInsRun::OnWritten, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnWritten(const CookieWriteReport& report) {
+    Finish(FoldArcSignIns(undecodable_, truncated_, report));
+  }
+
+  void Progress(ArcImportProgress::Step step) {
+    if (!job_.progress) {
+      return;
+    }
+    ArcImportProgress progress;
+    progress.step = step;
+    job_.progress.Run(progress);
+  }
+
+  void Finish(const ArcSignInsResult& result) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done_), result));
+    // Also deletes the sink, which the writer allows from its `done`.
+    delete this;
+  }
+
+  const raw_ref<ArcRunKeyCache> keys_;
+  ArcSignInsJob job_;
+  ArcSignInsCallback done_;
+  std::unique_ptr<ArcCookieSink> sink_;
+  int undecodable_ = 0;
+  bool truncated_ = false;
+  base::WeakPtrFactory<SignInsRun> weak_factory_{this};
+};
+
+}  // namespace
+
+ArcCookieKey::ArcCookieKey(
+    base::span<const uint8_t, kImportedCookieKeySize> bytes) {
+  base::span(bytes_).copy_from(bytes);
+}
+
+ArcCookieKey::ArcCookieKey(const ArcCookieKey& other)
+    : ArcCookieKey(other.bytes()) {}
+
+ArcCookieKey& ArcCookieKey::operator=(const ArcCookieKey& other) {
+  base::span(bytes_).copy_from(other.bytes());
+  return *this;
+}
+
+ArcCookieKey::~ArcCookieKey() {
+  crypto::SecureZeroBuffer(bytes_);
+}
+
+struct ArcRunKeyCache::Run {
+  // Set while the password is being asked for.
+  std::unique_ptr<ArcSafeStorageKeySource> source;
+  std::vector<ArcKeyCallback> waiting;
+  // Set once the source has answered.
+  std::optional<ArcKeyResult> answer;
+};
+
+ArcRunKeyCache::ArcRunKeyCache(SourceFactory make_source)
+    : make_source_(std::move(make_source)) {
+  CHECK(make_source_);
+}
+
+// Each run's key zeroes itself as `runs_` goes.
+ArcRunKeyCache::~ArcRunKeyCache() = default;
+
+void ArcRunKeyCache::GetKey(const std::string& run_id, ArcKeyCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::unique_ptr<Run>& run = runs_[run_id];
+  if (!run) {
+    run = std::make_unique<Run>();
+  }
+  if (run->answer) {
+    PostKey(std::move(done), *run->answer);
+    return;
+  }
+  run->waiting.push_back(std::move(done));
+  if (run->source) {
+    return;
+  }
+  run->source = make_source_.Run();
+  if (!run->source) {
+    OnPassword(run_id, base::unexpected(ArcKeyError::kFailed));
+    return;
+  }
+  // `run` may be gone by the time the source answers (EndRun()), so the
+  // answer finds it again by id.
+  run->source->GetPassword(base::BindOnce(&ArcRunKeyCache::OnPassword,
+                                          weak_factory_.GetWeakPtr(), run_id));
+}
+
+bool ArcRunKeyCache::HasAnswer(const std::string& run_id) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto it = runs_.find(run_id);
+  return it != runs_.end() && it->second->answer.has_value();
+}
+
+void ArcRunKeyCache::EndRun(const std::string& run_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  std::unique_ptr<Run> run = std::move(it->second);
+  runs_.erase(it);
+  for (ArcKeyCallback& done : run->waiting) {
+    PostKey(std::move(done), base::unexpected(ArcKeyError::kFailed));
+  }
+  // `run->answer` zeroes itself here, and dropping `run->source` drops its
+  // request.
+}
+
+void ArcRunKeyCache::OnPassword(
+    const std::string& run_id,
+    base::expected<std::string, ArcKeyError> password) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::optional<ArcKeyResult> answer;
+  if (!password.has_value()) {
+    answer.emplace(base::unexpected(password.error()));
+  } else if (password->empty()) {
+    // An empty secret means no key; one derived from it anyone could compute
+    // (imported_cookie_crypto.h).
+    answer.emplace(base::unexpected(ArcKeyError::kFailed));
+  } else {
+    std::array<uint8_t, kImportedCookieKeySize> derived =
+        DeriveImportedCookieKey(base::as_byte_span(*password));
+    answer.emplace(ArcCookieKey(derived));
+    crypto::SecureZeroBuffer(derived);
+  }
+  if (password.has_value()) {
+    crypto::SecureZeroBuffer(base::as_writable_byte_span(*password));
+  }
+
+  const auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    // The run ended while the source asked. `answer` zeroes itself.
+    return;
+  }
+  Run& run = *it->second;
+  if (run.source) {
+    // Not deleted here: the source may still be on the stack.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(run.source));
+  }
+  run.answer = std::move(answer);
+  for (ArcKeyCallback& done : std::exchange(run.waiting, {})) {
+    PostKey(std::move(done), *run.answer);
+  }
+}
+
+ArcSignInsJob::ArcSignInsJob() = default;
+ArcSignInsJob::ArcSignInsJob(ArcSignInsJob&&) = default;
+ArcSignInsJob& ArcSignInsJob::operator=(ArcSignInsJob&&) = default;
+ArcSignInsJob::~ArcSignInsJob() = default;
+
+void RunArcSignIns(ArcRunKeyCache& keys,
+                   ArcSignInsJob job,
+                   ArcSignInsCallback done) {
+  (new SignInsRun(keys, std::move(job), std::move(done)))->Start();
+}
+
+ArcSignInsResult FoldArcSignIns(int undecodable,
+                                bool truncated,
+                                const CookieWriteReport& written) {
+  ArcSignInsResult result;
+  result.written = base::saturated_cast<int>(written.set);
+  result.skipped = base::saturated_cast<int>(written.skipped_total());
+  result.rejected = base::saturated_cast<int>(written.rejected_total());
+  result.undecodable = undecodable;
+  result.truncated = truncated;
+  if (written.total == 0) {
+    // Cookies that were there but none decrypted: most likely the wrong key.
+    result.status = undecodable > 0 ? ArcSignInsResult::Status::kFailed
+                                    : ArcSignInsResult::Status::kNoCookies;
+  } else if (written.set == 0 &&
+             written.rejected_count(CookieRejectReason::kStoreRefused) > 0) {
+    // The cookie store wasn't there, or refused everything sent to it.
+    result.status = ArcSignInsResult::Status::kFailed;
+  } else {
+    result.status = ArcSignInsResult::Status::kDone;
+  }
+  return result;
+}
+
+ArcSignInsResult::Status SignInsStatusFor(ArcKeyError error) {
+  switch (error) {
+    case ArcKeyError::kDenied:
+      return ArcSignInsResult::Status::kDenied;
+    case ArcKeyError::kNotFound:
+    case ArcKeyError::kFailed:
+      return ArcSignInsResult::Status::kFailed;
+  }
+  NOTREACHED();
+}
+
+ArcSignInsResult::Status SignInsStatusFor(CookieDbReadError error) {
+  switch (error) {
+    case CookieDbReadError::kSourceMissing:
+      return ArcSignInsResult::Status::kNoCookies;
+    case CookieDbReadError::kSourceTooLarge:
+    case CookieDbReadError::kTempDirFailed:
+    case CookieDbReadError::kCopyFailed:
+    case CookieDbReadError::kOpenFailed:
+    case CookieDbReadError::kNoCookiesTable:
+    case CookieDbReadError::kMissingRequiredColumn:
+    case CookieDbReadError::kQueryFailed:
+      return ArcSignInsResult::Status::kFailed;
+  }
+  NOTREACHED();
+}
+
+}  // namespace rac::import

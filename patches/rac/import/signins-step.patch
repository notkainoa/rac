@@ -0,0 +1,51 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_ARC_COOKIE_IMPORT_H_
+#define CHROME_BROWSER_RAC_IMPORT_ARC_COOKIE_IMPORT_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "chrome/browser/rac/import/cookie_db_rows.h"
+#include "chrome/browser/rac/import/cookie_writer.h"
+
+namespace rac::import {
+
+// Arc's cookies, decoded and ready for CookieWriter.
+struct ArcCookieReadResult {
+  ArcCookieReadResult();
+  ArcCookieReadResult(ArcCookieReadResult&&);
+  ArcCookieReadResult& operator=(ArcCookieReadResult&&);
+  ~ArcCookieReadResult();
+
+  std::vector<ImportedCookie> cookies;
+  // Rows whose value didn't decode: a wrong key, a corrupt or unsupported
+  // value, a database version the decoder doesn't know, or a row with both a
+  // plaintext and an encrypted value. They're left out of `cookies`.
+  int undecodable = 0;
+  // The reader hit its row cap, so some rows were never read.
+  bool truncated = false;
+};
+
+// The cookie database of one Arc profile: <arc_support_dir>/User Data/
+// <profile_directory>/Network/Cookies if it exists, else .../Cookies. Empty
+// if neither exists, if `profile_directory` isn't one plain folder name, or
+// if the path resolves outside `arc_support_dir`. Blocking.
+base::FilePath ArcCookieDbPath(const base::FilePath& arc_support_dir,
+                               const std::string& profile_directory);
+
+// Reads a copy of `db_path` and decodes every row with `key`. Blocking: call
+// on a MayBlock sequence. Never logs cookie names, values or hosts.
+base::expected<ArcCookieReadResult, CookieDbReadError> ReadArcCookies(
+    const base::FilePath& db_path,
+    base::span<const uint8_t, 16> key);
+
+}  // namespace rac::import
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_ARC_COOKIE_IMPORT_H_

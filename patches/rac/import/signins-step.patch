+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/raw_ptr.h"
+#include "base/run_loop.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/test/bind.h"
+#include "base/test/task_environment.h"
+#include "chrome/browser/rac/import/arc_signins_core.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+// Everything here runs against fakes: no Keychain, no Arc files, no cookie
+// store.
+
+namespace rac::import {
+namespace {
+
+using Status = ArcSignInsResult::Status;
+using Step = ArcImportProgress::Step;
+
+constexpr char kRun[] = "run-1";
+constexpr char kOtherRun[] = "run-2";
+constexpr char kPassword[] = "not-a-real-safe-storage-secret";
+
+std::array<uint8_t, kImportedCookieKeySize> ExpectedKey() {
+  const std::string password(kPassword);
+  return DeriveImportedCookieKey(base::as_byte_span(password));
+}
+
+bool IsExpectedKey(const ArcCookieKey& key) {
+  return std::ranges::equal(key.bytes(), ExpectedKey());
+}
+
+// What the fake Keychain answers, and how often it was asked.
+struct FakeKeychain {
+  int requests = 0;
+  // Unset: the request waits in `held` until the test answers it.
+  std::optional<base::expected<std::string, ArcKeyError>> answer =
+      std::string(kPassword);
+  ArcPasswordCallback held;
+};
+
+class FakeKeySource : public ArcSafeStorageKeySource {
+ public:
+  explicit FakeKeySource(FakeKeychain* keychain) : keychain_(keychain) {}
+
+  // ArcSafeStorageKeySource:
+  void GetPassword(ArcPasswordCallback done) override {
+    ++keychain_->requests;
+    if (!keychain_->answer) {
+      keychain_->held = std::move(done);
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), *keychain_->answer));
+  }
+
+ private:
+  raw_ptr<FakeKeychain> keychain_;
+};
+
+// What the fake cookie store took and reports.
+struct FakeStore {
+  int sinks_made = 0;
+  // make_sink() returns null, like a profile that went away.
+  bool gone = false;
+  std::vector<ImportedCookie> written;
+  CookieWriteReport report;
+};
+
+class FakeSink : public ArcCookieSink {
+ public:
+  explicit FakeSink(FakeStore* store) : store_(store) {}
+
+  // ArcCookieSink:
+  void Write(std::vector<ImportedCookie> cookies,
+             CookieWriter::DoneCallback done) override {
+    store_->written = std::move(cookies);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), store_->report));
+  }
+
+ private:
+  raw_ptr<FakeStore> store_;
+};
+
+ImportedCookie Cookie(const std::string& name) {
+  ImportedCookie cookie;
+  cookie.name = name;
+  cookie.value = "value";
+  cookie.host_key = "example.com";
+  cookie.path = "/";
+  return cookie;
+}
+
+class ArcSignInsCoreTest : public testing::Test {
+ protected:
+  ArcRunKeyCache::SourceFactory Keychain() {
+    return base::BindLambdaForTesting(
+        [this]() -> std::unique_ptr<ArcSafeStorageKeySource> {
+          return std::make_unique<FakeKeySource>(&keychain_);
+        });
+  }
+
+  ArcKeyResult GetKey(ArcRunKeyCache& keys, const std::string& run_id) {
+    base::RunLoop loop;
+    std::optional<ArcKeyResult> out;
+    keys.GetKey(run_id, base::BindLambdaForTesting([&](ArcKeyResult key) {
+                  out.emplace(std::move(key));
+                  loop.Quit();
+                }));
+    loop.Run();
+    return std::move(*out);
+  }
+
+  // ArcCookieReadResult is move-only, so the fake reader hands out a copy.
+  base::expected<ArcCookieReadResult, CookieDbReadError> CopyReadResult()
+      const {
+    if (!read_result_.has_value()) {
+      return base::unexpected(read_result_.error());
+    }
+    ArcCookieReadResult copy;
+    copy.cookies = read_result_->cookies;
+    copy.undecodable = read_result_->undecodable;
+    copy.truncated = read_result_->truncated;
+    return copy;
+  }
+
+  ArcSignInsJob Job(const std::string& run_id) {
+    ArcSignInsJob job;
+    job.run_id = run_id;
+    job.arc_support_dir = base::FilePath(FILE_PATH_LITERAL("/arc-copy"));
+    job.profile_directory = "Default";
+    job.is_arc_running =
+        base::BindLambdaForTesting([this] { return arc_running_; });
+    // Both run on the thread pool.
+    job.has_cookie_db = base::BindLambdaForTesting(
+        [this](const base::FilePath& arc_support_dir,
+               const std::string& profile_directory) {
+          ++db_checks_;
+          return has_db_.load();
+        });
+    job.read_cookies = base::BindLambdaForTesting(
+        [this](const base::FilePath& arc_support_dir,
+               const std::string& profile_directory, const ArcCookieKey& key) {
+          ++reads_;
+          read_with_expected_key_ = IsExpectedKey(key);
+          return CopyReadResult();
+        });
+    job.make_sink =
+        base::BindLambdaForTesting([this]() -> std::unique_ptr<ArcCookieSink> {
+          ++store_.sinks_made;
+          if (store_.gone) {
+            return nullptr;
+          }
+          return std::make_unique<FakeSink>(&store_);
+        });
+    job.progress =
+        base::BindLambdaForTesting([this](const ArcImportProgress& progress) {
+          steps_.push_back(progress.step);
+        });
+    return job;
+  }
+
+  ArcSignInsResult Run(ArcRunKeyCache& keys, ArcSignInsJob job) {
+    base::RunLoop loop;
+    ArcSignInsResult out;
+    std::unique_ptr<ArcSignInsRun> run = RunArcSignIns(
+        keys, std::move(job),
+        base::BindLambdaForTesting([&](const ArcSignInsResult& r) {
+          out = r;
+          loop.Quit();
+        }));
+    loop.Run();
+    return out;
+  }
+
+  // Starts `job` without waiting. `result` is set once it reports.
+  std::unique_ptr<ArcSignInsRun> Start(
+      ArcRunKeyCache& keys,
+      ArcSignInsJob job,
+      std::optional<ArcSignInsResult>& result) {
+    return RunArcSignIns(
+        keys, std::move(job),
+        base::BindLambdaForTesting(
+            [&result](const ArcSignInsResult& r) { result = r; }));
+  }
+
+  void SetCookies(int count, int undecodable) {
+    ArcCookieReadResult read;
+    for (int i = 0; i < count; ++i) {
+      read.cookies.push_back(Cookie("c" + std::to_string(i)));
+    }
+    read.undecodable = undecodable;
+    read_result_ = std::move(read);
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  FakeKeychain keychain_;
+  FakeStore store_;
+  bool arc_running_ = false;
+  std::atomic<bool> has_db_ = true;
+  std::atomic<int> db_checks_ = 0;
+  std::atomic<int> reads_ = 0;
+  std::atomic<bool> read_with_expected_key_ = false;
+  base::expected<ArcCookieReadResult, CookieDbReadError> read_result_ =
+      ArcCookieReadResult();
+  std::vector<Step> steps_;
+};
+
+// The per-run password cache.
+
+TEST_F(ArcSignInsCoreTest, AsksOncePerRun) {
+  ArcRunKeyCache keys(Keychain());
+  EXPECT_FALSE(keys.HasAnswer(kRun));
+  ArcKeyResult first = GetKey(keys, kRun);
+  ArcKeyResult second = GetKey(keys, kRun);
+  ASSERT_TRUE(first.has_value());

@@ -0,0 +1,119 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_ARC_SAFE_STORAGE_KEY_H_
+#define CHROME_BROWSER_RAC_IMPORT_ARC_SAFE_STORAGE_KEY_H_
+
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/types/expected.h"
+#include "build/build_config.h"
+#include "chrome/browser/rac/dev/buildflags.h"
+
+#if BUILDFLAG(IS_MAC)
+#include <MacTypes.h>
+#endif
+
+// The password that protects Arc's cookies.
+//
+// Arc, like every Chromium browser on macOS, encrypts cookie values with a key
+// derived from a random password it keeps in the user's login Keychain. To
+// bring sign-ins over, rac reads that password, which makes macOS show its own
+// prompt asking the user to allow access. The read never adds, changes or
+// deletes a Keychain item.
+
+namespace base {
+class CommandLine;
+}  // namespace base
+
+namespace rac::import {
+
+enum class ArcKeyError {
+  // The user denied access at the macOS prompt, or cancelled it.
+  kDenied,
+  // There is no "Arc Safe Storage" item: Arc never stored a cookie key.
+  kNotFound,
+  // Anything else, including every platform but macOS.
+  kFailed,
+};
+
+using ArcPasswordCallback =
+    base::OnceCallback<void(base::expected<std::string, ArcKeyError>)>;
+
+// Where the password protecting Arc's cookies comes from.
+class ArcSafeStorageKeySource {
+ public:
+  virtual ~ArcSafeStorageKeySource() = default;
+  // May show a macOS access prompt: call only after the user asked to bring
+  // sign-ins over. Replies once, on the calling sequence, never re-entrantly.
+  // Destroying the source before it replies drops `done` without running it.
+  virtual void GetPassword(ArcPasswordCallback done) = 0;
+};
+
+// Where CreateArcSafeStorageKeySource() gets the password, in order:
+//
+// 1. While a ScopedArcSafeStorageKeyForTesting
+//    (arc_safe_storage_key_test_support.h) is alive: its answer.
+// 2. On macOS, a process run with --test-type is a CHECK failure, so no test
+//    can show a real Keychain prompt.
+// 3. A process run with --use-mock-keychain: kFailed, in every build. That
+//    switch doesn't cover the Keychain API this reads, so it's honored here.
+// 4. Dev builds (BUILDFLAG(RAC_DEV_SWITCHES), every non-official build) never
+//    read the real Keychain: kArcFixtureSafeStoragePassword when the import
+//    reads a fixture (--rac-import-source-root, which wins over
+//    --use-mock-keychain), else kFailed.
+// 5. Release builds: the real "Arc Safe Storage" Keychain item, on macOS.
+//    kFailed on every other platform.
+//
+// Logs once, without the password, when 3 or 4 keeps it from the Keychain.
+std::unique_ptr<ArcSafeStorageKeySource> CreateArcSafeStorageKeySource();
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+// The Arc Safe Storage password of rac's fixture Arc folders, which dev builds
+// answer while --rac-import-source-root is set. Fixture generators encrypt
+// their cookies with it, and tests use it. Not a real secret.
+inline constexpr char kArcFixtureSafeStoragePassword[] =
+    "test-only-arc-safe-storage";
+#endif
+
+namespace internal {
+
+// Which source CreateArcSafeStorageKeySource() makes for `command_line`, steps
+// 3 to 5 above. Never touches the Keychain.
+enum class ArcKeySourceKind {
+  // The real Keychain item. Release builds only.
+  kKeychain,
+  // A source that replies kFailed.
+  kFailed,
+  // A source that replies kArcFixtureSafeStoragePassword. Dev builds only.
+  kFixturePassword,
+};
+ArcKeySourceKind ChooseArcKeySource(const base::CommandLine& command_line);
+
+// A source that replies `answer` from a posted task.
+std::unique_ptr<ArcSafeStorageKeySource> CreateFixedAnswerArcKeySource(
+    base::expected<std::string, ArcKeyError> answer);
+
+// Test seam, for arc_safe_storage_key_test_support.h only. While set,
+// CreateArcSafeStorageKeySource() returns `factory()` and nothing else. Pass
+// null to unset. UI thread only.
+using ArcKeySourceFactory = std::unique_ptr<ArcSafeStorageKeySource> (*)();
+void SetArcKeySourceFactoryForTesting(ArcKeySourceFactory factory);
+
+#if BUILDFLAG(IS_MAC)
+// The Keychain-backed source. Use CreateArcSafeStorageKeySource() instead,
+// which honors the test override and the switches above.
+std::unique_ptr<ArcSafeStorageKeySource> CreateKeychainArcSafeStorageKey();
+
+// How a SecItemCopyMatching() status maps to an error. Not for errSecSuccess.
+ArcKeyError ArcKeyErrorFromStatus(OSStatus status);
+#endif
+
+}  // namespace internal
+
+}  // namespace rac::import
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_ARC_SAFE_STORAGE_KEY_H_

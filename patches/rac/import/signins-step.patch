+TEST_F(ArcSignInsCoreTest, SignInsCountWhenTheSidebarHadNothingNew) {
+  EXPECT_EQ(FoldArcImportStatus(
+                {ProfileWith(ArcProfileResult::Status::kNothingNew, 2)},
+                ArcImportFailure::kNone),
+            ArcImportResult::Status::kDone);
+  EXPECT_EQ(FoldArcImportStatus(
+                {ProfileWith(ArcProfileResult::Status::kNothingNew, 0)},
+                ArcImportFailure::kNone),
+            ArcImportResult::Status::kNothingNew);
+}
+
+TEST_F(ArcSignInsCoreTest, AnyDoneProfileMakesTheImportDone) {
+  EXPECT_EQ(
+      FoldArcImportStatus({ProfileWith(ArcProfileResult::Status::kFailed, 3),
+                           ProfileWith(ArcProfileResult::Status::kDone, 0)},
+                          ArcImportFailure::kNone),
+      ArcImportResult::Status::kDone);
+  ArcProfileResult history;
+  history.status = ArcProfileResult::Status::kNothingNew;
+  history.history = ArcProfileResult::History::kImported;
+  EXPECT_EQ(FoldArcImportStatus({history}, ArcImportFailure::kNone),
+            ArcImportResult::Status::kDone);
+}

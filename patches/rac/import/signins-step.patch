+TEST_F(ArcSafeStorageKeyTest, OverrideAnswersItsPassword) {
+  ScopedArcSafeStorageKeyForTesting key{PasswordResult(kTestPassword)};
+  std::unique_ptr<ArcSafeStorageKeySource> source =
+      CreateArcSafeStorageKeySource();
+
+  base::test::TestFuture<PasswordResult> future;
+  source->GetPassword(future.GetCallback());
+  EXPECT_EQ(future.Take(), PasswordResult(kTestPassword));
+}
+
+TEST_F(ArcSafeStorageKeyTest, OverrideAnswersAnError) {
+  for (ArcKeyError error :
+       {ArcKeyError::kDenied, ArcKeyError::kNotFound, ArcKeyError::kFailed}) {
+    ScopedArcSafeStorageKeyForTesting key{base::unexpected(error)};
+    std::unique_ptr<ArcSafeStorageKeySource> source =
+        CreateArcSafeStorageKeySource();
+
+    base::test::TestFuture<PasswordResult> future;
+    source->GetPassword(future.GetCallback());
+    PasswordResult result = future.Take();
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), error);
+  }
+}
+
+TEST_F(ArcSafeStorageKeyDeathTest, NestedOverridesCheck) {
+  ScopedArcSafeStorageKeyForTesting outer{PasswordResult(kTestPassword)};
+  EXPECT_CHECK_DEATH({
+    ScopedArcSafeStorageKeyForTesting inner{
+        base::unexpected(ArcKeyError::kDenied)};
+  });
+}
+
+TEST_F(ArcSafeStorageKeyTest, RepliesAsynchronously) {
+  ScopedArcSafeStorageKeyForTesting key{PasswordResult(kTestPassword)};
+  std::unique_ptr<ArcSafeStorageKeySource> source =
+      CreateArcSafeStorageKeySource();
+
+  std::optional<PasswordResult> result;
+  base::RunLoop run_loop;
+  source->GetPassword(base::BindLambdaForTesting([&](PasswordResult answer) {
+    result = std::move(answer);
+    run_loop.Quit();
+  }));
+  EXPECT_FALSE(result.has_value()) << "replied inside GetPassword()";
+
+  run_loop.Run();
+  EXPECT_EQ(result, PasswordResult(kTestPassword));
+}
+
+TEST_F(ArcSafeStorageKeyTest, EachCallRepliesOnce) {
+  ScopedArcSafeStorageKeyForTesting key{PasswordResult(kTestPassword)};
+  std::unique_ptr<ArcSafeStorageKeySource> source =
+      CreateArcSafeStorageKeySource();
+
+  int replies = 0;
+  auto count = base::BindLambdaForTesting([&](PasswordResult) { ++replies; });
+  source->GetPassword(count);
+  source->GetPassword(count);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(replies, 2);
+}
+
+TEST_F(ArcSafeStorageKeyTest, DestroyingTheSourceDropsTheReply) {
+  ScopedArcSafeStorageKeyForTesting key{PasswordResult(kTestPassword)};
+  std::unique_ptr<ArcSafeStorageKeySource> source =
+      CreateArcSafeStorageKeySource();
+
+  bool replied = false;
+  source->GetPassword(
+      base::BindLambdaForTesting([&](PasswordResult) { replied = true; }));
+  source.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(replied);
+}
+
+TEST_F(ArcSafeStorageKeyTest, SourceKeepsTheAnswerAfterTheOverrideEnds) {
+  std::unique_ptr<ArcSafeStorageKeySource> source;
+  {
+    ScopedArcSafeStorageKeyForTesting key{PasswordResult(kTestPassword)};
+    source = CreateArcSafeStorageKeySource();
+  }
+
+  base::test::TestFuture<PasswordResult> future;
+  source->GetPassword(future.GetCallback());
+  EXPECT_EQ(future.Take(), PasswordResult(kTestPassword));
+}

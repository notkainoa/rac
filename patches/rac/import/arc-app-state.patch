+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_app_state_mac.h"
+
+#import <AppKit/AppKit.h>
+#import <Foundation/Foundation.h>
+
+#include <utility>
+
+#include "base/apple/foundation_util.h"
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+
+namespace rac::import {
+
+struct ArcQuitWatcher::Impl {
+  // The token addObserverForName:... returned. Under ARC this is a strong
+  // reference; nil once the observer has been removed.
+  id<NSObject> token = nil;
+};
+
+namespace internal {
+
+bool IsArcRunning(std::string_view bundle_id) {
+  NSArray<NSRunningApplication*>* apps = [NSRunningApplication
+      runningApplicationsWithBundleIdentifier:base::SysUTF8ToNSString(
+                                                  bundle_id)];
+  for (NSRunningApplication* app in apps) {
+    // The list can still hold an app that has quit but isn't released yet.
+    if (!app.terminated) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace internal
+
+bool IsArcRunning() {
+  return internal::IsArcRunning(kArcBundleId);
+}
+
+ArcQuitWatcher::ArcQuitWatcher(base::OnceClosure on_quit)
+    : ArcQuitWatcher(std::move(on_quit), kArcBundleId) {}
+
+ArcQuitWatcher::ArcQuitWatcher(base::OnceClosure on_quit,
+                               std::string_view bundle_id)
+    : bundle_id_(bundle_id),
+      on_quit_(std::move(on_quit)),
+      impl_(std::make_unique<Impl>()) {
+  CHECK(on_quit_);
+  base::WeakPtr<ArcQuitWatcher> weak = weak_factory_.GetWeakPtr();
+  NSString* watched_id = base::SysUTF8ToNSString(bundle_id_);
+
+  // Observe first, then check, so an Arc that quits in between is still seen.
+  // NSWorkspace posts on the main thread; the main queue makes that explicit.
+  impl_->token = [NSWorkspace.sharedWorkspace.notificationCenter
+      addObserverForName:NSWorkspaceDidTerminateApplicationNotification
+                  object:nil
+                   queue:NSOperationQueue.mainQueue
+              usingBlock:^(NSNotification* notification) {
+                NSRunningApplication* app =
+                    base::apple::ObjCCast<NSRunningApplication>(
+                        notification.userInfo[NSWorkspaceApplicationKey]);
+                if (![app.bundleIdentifier isEqualToString:watched_id]) {
+                  return;
+                }
+                if (weak) {
+                  weak->CheckAndFinish();
+                }
+              }];
+
+  if (!internal::IsArcRunning(bundle_id_)) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ArcQuitWatcher::CheckAndFinish, std::move(weak)));
+  }
+}
+
+ArcQuitWatcher::~ArcQuitWatcher() {
+  StopObserving();
+}
+
+void ArcQuitWatcher::CheckAndFinish() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Already finished, or a second Arc process is still running.
+  if (!on_quit_ || internal::IsArcRunning(bundle_id_)) {
+    return;
+  }
+  // `on_quit_` may destroy this watcher, so nothing is touched after it.
+  base::OnceClosure on_quit = std::move(on_quit_);
+  StopObserving();
+  std::move(on_quit).Run();
+}
+
+void ArcQuitWatcher::StopObserving() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (impl_->token) {
+    [NSWorkspace.sharedWorkspace.notificationCenter
+        removeObserver:impl_->token];
+    impl_->token = nil;
+  }
+}
+
+}  // namespace rac::import

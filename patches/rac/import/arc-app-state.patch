+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_app_state_mac.h"
+
+#include <string_view>
+
+#include "base/run_loop.h"
+#include "base/test/bind.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::import {
+namespace {
+
+// No application has this bundle identifier. It's reverse-DNS, and `invalid`
+// is a top-level domain reserved so that it never names anything (RFC 2606).
+constexpr std::string_view kNoSuchBundleId = "invalid.rac.test.no-such-app";
+
+TEST(ArcAppStateMacTest, NoSuchBundleIdIsNotRunning) {
+  EXPECT_FALSE(internal::IsArcRunning(kNoSuchBundleId));
+}
+
+// Tests can't tell whether the machine running them has Arc open, so this
+// only checks that the real check agrees with the injected one for Arc.
+TEST(ArcAppStateMacTest, ArcCheckUsesArcsBundleId) {
+  EXPECT_EQ(IsArcRunning(), internal::IsArcRunning(kArcBundleId));
+}
+
+// With nothing to wait for, the callback runs once, later, not from the
+// constructor.
+TEST(ArcAppStateMacTest, WatcherCallsBackWhenAppIsNotRunning) {
+  base::test::SingleThreadTaskEnvironment task_environment;
+  base::RunLoop run_loop;
+  int calls = 0;
+  ArcQuitWatcher watcher(base::BindLambdaForTesting([&] {
+                           ++calls;
+                           run_loop.Quit();
+                         }),
+                         kNoSuchBundleId);
+  EXPECT_EQ(calls, 0);
+  run_loop.Run();
+  EXPECT_EQ(calls, 1);
+}
+
+// Destroying the watcher before its task runs cancels the callback.
+TEST(ArcAppStateMacTest, DestroyedWatcherNeverCallsBack) {
+  base::test::SingleThreadTaskEnvironment task_environment;
+  int calls = 0;
+  {
+    ArcQuitWatcher watcher(base::BindLambdaForTesting([&] { ++calls; }),
+                           kNoSuchBundleId);
+  }
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(calls, 0);
+}
+
+}  // namespace
+}  // namespace rac::import

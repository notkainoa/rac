+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_ARC_APP_STATE_MAC_H_
+#define CHROME_BROWSER_RAC_IMPORT_ARC_APP_STATE_MAC_H_
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+
+// Whether Arc is running, and a way to wait until it isn't.
+//
+// Arc must be quit before rac brings over sign-ins (cookies): Arc keeps its
+// cookie store open while it runs, so a copy taken then can be torn or stale.
+// While IsArcRunning() is true, the import screen shows "Quit Arc to bring
+// over your sign-ins" and holds the sign-ins step. An ArcQuitWatcher tells
+// the screen when Arc has quit, so it can continue without the user pressing
+// anything and without polling.
+//
+// Both are for the UI thread. Neither reads any of Arc's files.
+
+namespace rac::import {
+
+// Arc's bundle identifier.
+inline constexpr char kArcBundleId[] = "company.thebrowser.Browser";
+
+// True if at least one Arc process is running that has not terminated.
+bool IsArcRunning();
+
+// Calls `on_quit` once, on the UI thread, when Arc is not running. If Arc is
+// already not running, `on_quit` still runs, from a posted task, never from
+// the constructor. Destroying the watcher first cancels the call.
+//
+// It listens for NSWorkspaceDidTerminateApplicationNotification, so it costs
+// nothing while Arc runs and does no work at any other time. It stops
+// listening as soon as it has called `on_quit`, and in its destructor.
+class ArcQuitWatcher {
+ public:
+  explicit ArcQuitWatcher(base::OnceClosure on_quit);
+  // Watches `bundle_id` instead of Arc. Tests use this with an application
+  // that can't exist.
+  ArcQuitWatcher(base::OnceClosure on_quit, std::string_view bundle_id);
+  ArcQuitWatcher(const ArcQuitWatcher&) = delete;
+  ArcQuitWatcher& operator=(const ArcQuitWatcher&) = delete;
+  ~ArcQuitWatcher();
+
+ private:
+  // Holds the Objective-C observer token, so this header stays C++.
+  struct Impl;
+
+  // A termination was reported, or the first check ran. Calls `on_quit_` if
+  // no process of the application is left.
+  void CheckAndFinish();
+  void StopObserving();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  const std::string bundle_id_;
+  base::OnceClosure on_quit_;
+  std::unique_ptr<Impl> impl_;
+  base::WeakPtrFactory<ArcQuitWatcher> weak_factory_{this};
+};
+
+namespace internal {
+
+// IsArcRunning() for any bundle identifier.
+bool IsArcRunning(std::string_view bundle_id);
+
+}  // namespace internal
+
+}  // namespace rac::import
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_ARC_APP_STATE_MAC_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/imported_cookie_crypto.h"
+
+#include <array>
+#include <optional>
+#include <vector>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/location.h"
+#include "base/strings/string_view_util.h"
+#include "crypto/hash.h"
+#include "crypto/openssl_util.h"
+#include "crypto/secure_util.h"
+#include "third_party/abseil-cpp/absl/cleanup/cleanup.h"
+#include "third_party/boringssl/src/include/openssl/cipher.h"
+#include "third_party/boringssl/src/include/openssl/evp.h"
+
+namespace rac::import {
+
+namespace {
+
+// These match Chromium's macOS cookie encryption. See
+// components/os_crypt/async/browser/keychain_key_provider.mm and
+// components/os_crypt/async/common/encryptor.cc.
+constexpr std::string_view kV10Prefix = "v10";
+constexpr auto kSalt =
+    std::to_array<uint8_t>({'s', 'a', 'l', 't', 'y', 's', 'a', 'l', 't'});
+constexpr uint32_t kIterations = 1003;
+constexpr size_t kBlockSize = 16;
+constexpr std::array<uint8_t, kBlockSize> kIv{
+    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+};
+
+constexpr size_t kHostHashSize = crypto::hash::kSha256Size;
+
+// AES-128-CBC decrypts `ciphertext` into `plaintext`, leaving the padding in
+// place so UnpaddedLength() can check it. `ciphertext` must be a positive
+// multiple of the block size and `plaintext` the same size.
+void DecryptBlocks(base::span<const uint8_t, kImportedCookieKeySize> key,
+                   base::span<const uint8_t> ciphertext,
+                   base::span<uint8_t> plaintext) {
+  CHECK_EQ(plaintext.size(), ciphertext.size());
+  crypto::OpenSSLErrStackTracer err_tracer(FROM_HERE);
+  // The context's key schedule is freed with OPENSSL_free(), which zeroes it.
+  bssl::ScopedEVP_CIPHER_CTX ctx;
+  CHECK(EVP_DecryptInit_ex(ctx.get(), EVP_aes_128_cbc(), nullptr, key.data(),
+                           kIv.data()));
+  CHECK(EVP_CIPHER_CTX_set_padding(ctx.get(), 0));
+
+  size_t out_len = 0;
+  CHECK(EVP_DecryptUpdate_ex(ctx.get(), plaintext.data(), &out_len,
+                             plaintext.size(), ciphertext.data(),
+                             ciphertext.size()));
+  auto remainder = plaintext.subspan(out_len);
+  size_t tail_len = 0;
+  CHECK(EVP_DecryptFinal_ex2(ctx.get(), remainder.data(), &tail_len,
+                             remainder.size()));
+  CHECK_EQ(out_len + tail_len, plaintext.size());
+}
+
+// Returns the length of `plaintext` without its PKCS#7 padding, or nullopt if
+// the padding is invalid. A valid pad is 1 to 16 bytes that all equal the pad
+// length. Every byte of the last block is examined whatever the pad length, so
+// a pad that's right only in its last byte is still rejected.
+std::optional<size_t> UnpaddedLength(base::span<const uint8_t> plaintext) {
+  CHECK(!plaintext.empty());
+  CHECK_EQ(plaintext.size() % kBlockSize, 0u);
+  const auto last_block = plaintext.last<kBlockSize>();
+  const size_t pad = last_block.back();
+
+  bool bad = pad == 0 || pad > kBlockSize;
+  for (size_t i = 0; i < kBlockSize; ++i) {
+    // Byte `i` is padding if it's among the last `pad` bytes of the block.
+    const bool is_padding = kBlockSize - i <= pad;
+    bad |= is_padding && last_block[i] != pad;
+  }
+  if (bad) {
+    return std::nullopt;
+  }
+  return plaintext.size() - pad;
+}
+
+}  // namespace
+
+std::array<uint8_t, kImportedCookieKeySize> DeriveImportedCookieKey(
+    base::span<const uint8_t> password) {
+  DCHECK(!password.empty());
+  // This is what crypto::kdf::Pbkdf2HmacSha1() does. That wrapper needs a
+  // crypto::SubtlePassKey, which only friends listed in an upstream header can
+  // make, so call BoringSSL directly instead of patching //crypto.
+  crypto::OpenSSLErrStackTracer err_tracer(FROM_HERE);
+  std::array<uint8_t, kImportedCookieKeySize> key;
+  CHECK_EQ(PKCS5_PBKDF2_HMAC_SHA1(base::as_chars(password).data(),
+                                  password.size(), kSalt.data(), kSalt.size(),
+                                  kIterations, key.size(), key.data()),
+           1);
+  return key;
+}
+
+base::expected<std::string, CookieDecryptError> DecryptImportedCookieValue(
+    base::span<const uint8_t, kImportedCookieKeySize> key,
+    base::span<const uint8_t> encrypted_value,
+    std::string_view host_key,
+    int db_version) {
+  if (db_version < kMinSupportedCookieDbVersion ||
+      db_version > kMaxSupportedCookieDbVersion) {
+    return base::unexpected(CookieDecryptError::kUnsupportedVersion);
+  }
+  if (encrypted_value.empty()) {
+    return base::unexpected(CookieDecryptError::kEmpty);
+  }
+  if (!base::as_string_view(encrypted_value).starts_with(kV10Prefix)) {
+    return base::unexpected(CookieDecryptError::kNotV10);
+  }
+  const base::span<const uint8_t> ciphertext =
+      encrypted_value.subspan(kV10Prefix.size());
+  if (ciphertext.empty() || ciphertext.size() % kBlockSize != 0) {
+    return base::unexpected(CookieDecryptError::kTruncated);
+  }
+
+  std::vector<uint8_t> plaintext(ciphertext.size());
+  absl::Cleanup zero_plaintext = [&plaintext] {
+    crypto::SecureZeroBuffer(plaintext);
+  };
+  DecryptBlocks(key, ciphertext, plaintext);
+
+  const std::optional<size_t> length = UnpaddedLength(plaintext);
+  if (!length.has_value()) {
+    return base::unexpected(CookieDecryptError::kBadPadding);
+  }
+  base::span<const uint8_t> value = base::span(plaintext).first(*length);
+
+  if (db_version >= kCookieDbVersionWithHostHash) {
+    // Chromium's cookie store strips this prefix after a plain StartsWith().
+    // Compare in constant time instead, and treat a short plaintext as a
+    // mismatch: it can't hold the hash. This is also the main wrong-key check,
+    // since a wrong key still yields valid padding about 1 time in 256.
+    if (value.size() < kHostHashSize) {
+      return base::unexpected(CookieDecryptError::kHostMismatch);
+    }
+    const std::array<uint8_t, kHostHashSize> host_hash =
+        crypto::hash::Sha256(host_key);
+    if (!crypto::SecureMemEqual(value.first<kHostHashSize>(), host_hash)) {
+      return base::unexpected(CookieDecryptError::kHostMismatch);
+    }
+    value = value.subspan(kHostHashSize);
+  }
+
+  return std::string(base::as_string_view(value));
+}
+
+}  // namespace rac::import

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_IMPORTED_COOKIE_CRYPTO_H_
+#define CHROME_BROWSER_RAC_IMPORT_IMPORTED_COOKIE_CRYPTO_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+
+// Decrypts cookie values that another Chromium-based browser on macOS (such as
+// Arc) stored in its cookie database, so the Arc importer can bring them into
+// rac. This is the same "v10" format as Chromium's own macOS cookie store:
+//
+//   encrypted_value = "v10" || AES-128-CBC(key, iv = 16 x ' ', PKCS#7(pt))
+//   key = PBKDF2-HMAC-SHA1(password, "saltysalt", 1003 iterations, 16 bytes)
+//   pt  = SHA-256(host_key) || value   at cookie DB meta version >= 24
+//   pt  = value                        before version 24
+//
+// The password is the other browser's "Safe Storage" secret. Getting it is the
+// caller's job; nothing here touches the Keychain, files, or logs.
+//
+// Chromium's own decryptor retries a failed decryption with a fixed fallback
+// key, PBKDF2-HMAC-SHA1("", "saltysalt", 1 iteration, 16 bytes), for values
+// written while the Keychain was unavailable (see
+// components/os_crypt/async/common/encryptor.cc and crbug.com/40055416). This
+// decoder deliberately doesn't. That key is public, so accepting it would let
+// anyone's value pass for a Keychain-protected one and weaken the wrong-key
+// check. Such values come back as kBadPadding or kHostMismatch.
+namespace rac::import {
+
+// Size of the AES-128 key derived from the Safe Storage password.
+inline constexpr size_t kImportedCookieKeySize = 16;
+
+// The first cookie DB meta version that prefixes each plaintext with
+// SHA-256(host_key). See net/extras/sqlite/sqlite_persistent_cookie_store.cc.
+inline constexpr int kCookieDbVersionWithHostHash = 24;
+
+// The oldest and newest cookie DB meta versions this decoder understands. The
+// encryption format is the same across the range; only the host hash prefix
+// differs. Anything outside it is rejected instead of guessed at.
+inline constexpr int kMinSupportedCookieDbVersion = 23;
+inline constexpr int kMaxSupportedCookieDbVersion =
+    kCookieDbVersionWithHostHash;
+
+enum class CookieDecryptError {
+  // `db_version` is older than kMinSupportedCookieDbVersion or newer than
+  // kMaxSupportedCookieDbVersion. A newer database may have changed the
+  // format, so this fails instead of decoding it as version 24.
+  kUnsupportedVersion,
+  // `encrypted_value` is empty. The cookie may be stored in plaintext in the
+  // `value` column instead; that's the caller's call.
+  kEmpty,
+  // `encrypted_value` doesn't start with "v10".
+  kNotV10,
+  // The ciphertext after "v10" is empty or not a multiple of 16 bytes.
+  kTruncated,
+  // The PKCS#7 padding is invalid. Usually a wrong key or a corrupt value.
+  kBadPadding,
+  // At version 24 or later, the plaintext doesn't start with
+  // SHA-256(host_key). Usually a wrong key that happened to produce valid
+  // padding, or a value copied from another row.
+  kHostMismatch,
+};
+
+// Derives the AES-128 key from the Safe Storage `password`. Callers should
+// zero both the password and the returned key when they're done with them.
+//
+// The caller must reject an empty password before calling this, as Chromium's
+// keychain_key_provider.mm does: an empty or missing Keychain secret means "no
+// key", and deriving from it would produce a key anyone can compute. This
+// DCHECKs `!password.empty()`, so a bug shows up in debug builds only.
+std::array<uint8_t, kImportedCookieKeySize> DeriveImportedCookieKey(
+    base::span<const uint8_t> password);
+
+// Decrypts one `encrypted_value` from a cookie row. `host_key` is the row's
+// `host_key` column and `db_version` is the database's meta `version`, which
+// must be in [kMinSupportedCookieDbVersion, kMaxSupportedCookieDbVersion]
+// (otherwise kUnsupportedVersion). Returns the cookie value, without the host
+// hash.
+//
+// Before version 24 there's no host hash, so a wrong key goes undetected about
+// 1 time in 256 (whenever the garbage happens to end in valid padding).
+// Callers that import pre-24 databases should check the key some other way.
+base::expected<std::string, CookieDecryptError> DecryptImportedCookieValue(
+    base::span<const uint8_t, kImportedCookieKeySize> key,
+    base::span<const uint8_t> encrypted_value,
+    std::string_view host_key,
+    int db_version);
+
+}  // namespace rac::import
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_IMPORTED_COOKIE_CRYPTO_H_

+TEST(ImportedCookieCryptoTest, WrongPasswordFailsEveryHostHashedVector) {
+  const auto key = KeyFor(kOtherPassword);
+  ASSERT_NE(key, KeyFor(kTestPassword));
+  size_t checked = 0;
+  for (const CookieTestVector& vector : kCookieTestVectors) {
+    if (std::string_view(vector.expect) != "ok" ||
+        vector.db_version < kCookieDbVersionWithHostHash) {
+      continue;
+    }
+    SCOPED_TRACE(vector.name);
+    ++checked;
+    const DecryptResult result = DecryptImportedCookieValue(
+        key, FromHex(vector.encrypted_hex), vector.host_key, vector.db_version);
+    ASSERT_FALSE(result.has_value());
+    EXPECT_TRUE(result.error() == CookieDecryptError::kBadPadding ||
+                result.error() == CookieDecryptError::kHostMismatch)
+        << ResultName(result);
+  }
+  EXPECT_GT(checked, 0u) << "No \"ok\" version-24 vectors to check.";
+}

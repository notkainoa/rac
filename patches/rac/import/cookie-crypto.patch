+// Self-contained tests. These encrypt with Chromium's crypto::aes_cbc at test
+// time, so they don't depend on the generated vectors.
+
+TEST(ImportedCookieCryptoTest, RoundTripsVersion24Value) {
+  const auto key = KeyFor(kOtherPassword);
+  EXPECT_EQ(
+      DecryptImportedCookieValue(
+          key, EncryptV10(key, HostHash(kHost) + "session=abc123"), kHost, 24),
+      DecryptResult("session=abc123"));
+}
+
+TEST(ImportedCookieCryptoTest, RoundTripsEmptyVersion24Value) {
+  // A 32-byte plaintext is block-aligned, so it ends in a whole padding block.
+  const auto key = KeyFor(kOtherPassword);
+  EXPECT_EQ(DecryptImportedCookieValue(key, EncryptV10(key, HostHash(kHost)),
+                                       kHost, 24),
+            DecryptResult(""));
+}
+
+TEST(ImportedCookieCryptoTest, RoundTripsUnprefixedVersion23Value) {
+  const auto key = KeyFor(kOtherPassword);
+  for (std::string_view value :
+       {"", "a", "fifteen bytes..", "sixteen bytes...", "seventeen bytes.."}) {
+    SCOPED_TRACE(value);
+    EXPECT_EQ(
+        DecryptImportedCookieValue(key, EncryptV10(key, value), kHost, 23),
+        DecryptResult(std::string(value)));
+  }
+}
+
+TEST(ImportedCookieCryptoTest, RejectsHashOfAnotherHost) {
+  const auto key = KeyFor(kOtherPassword);
+  const auto encrypted = EncryptV10(key, HostHash("example.test") + "v");
+  EXPECT_EQ(DecryptImportedCookieValue(key, encrypted, ".example.test", 24),
+            base::unexpected(CookieDecryptError::kHostMismatch));
+  EXPECT_EQ(DecryptImportedCookieValue(key, encrypted, "example.test", 24),
+            DecryptResult("v"));
+}
+
+TEST(ImportedCookieCryptoTest, RejectsVersion24ValueWithoutHostHash) {
+  const auto key = KeyFor(kOtherPassword);
+  // Shorter than a hash.
+  EXPECT_EQ(
+      DecryptImportedCookieValue(key, EncryptV10(key, "short"), kHost, 24),
+      base::unexpected(CookieDecryptError::kHostMismatch));
+  // One byte short of a hash: the first 31 bytes of the right one.
+  EXPECT_EQ(DecryptImportedCookieValue(
+                key, EncryptV10(key, HostHash(kHost).substr(0, 31)), kHost, 24),
+            base::unexpected(CookieDecryptError::kHostMismatch));
+  // Long enough, but not the hash.
+  EXPECT_EQ(DecryptImportedCookieValue(
+                key, EncryptV10(key, std::string(40, 'x')), kHost, 24),
+            base::unexpected(CookieDecryptError::kHostMismatch));
+}
+
+TEST(ImportedCookieCryptoTest, RejectsUnsupportedDatabaseVersions) {
+  const auto key = KeyFor(kOtherPassword);
+  // Even a value that would decode under the neighboring version is refused.
+  const auto encrypted = EncryptV10(key, HostHash(kHost) + "v");
+  for (int db_version : {-1, 0, 22, 25, 26, 1000}) {
+    SCOPED_TRACE(db_version);
+    EXPECT_EQ(DecryptImportedCookieValue(key, encrypted, kHost, db_version),
+              base::unexpected(CookieDecryptError::kUnsupportedVersion));
+  }
+  // The supported range's bounds still decode.
+  EXPECT_EQ(DecryptImportedCookieValue(key, encrypted, kHost, 24),
+            DecryptResult("v"));
+  EXPECT_EQ(DecryptImportedCookieValue(key, EncryptV10(key, "v"), kHost, 23),
+            DecryptResult("v"));
+}
+
+TEST(ImportedCookieCryptoTest, Version23KeepsAVersion24HostHash) {
+  // The caller must pass the database's real version: read as version 23, a
+  // version-24 value keeps its hash prefix.
+  const auto key = KeyFor(kOtherPassword);
+  EXPECT_EQ(DecryptImportedCookieValue(
+                key, EncryptV10(key, HostHash(kHost) + "v"), kHost, 23),
+            DecryptResult(HostHash(kHost) + "v"));
+}
+
+TEST(ImportedCookieCryptoTest, RejectsWrongKeyForVersion24Value) {
+  const auto right_key = KeyFor(kOtherPassword);
+  const auto wrong_key = KeyFor("yet another password");
+  const DecryptResult result = DecryptImportedCookieValue(
+      wrong_key, EncryptV10(right_key, HostHash(kHost) + "session=abc123"),
+      kHost, 24);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_TRUE(result.error() == CookieDecryptError::kBadPadding ||
+              result.error() == CookieDecryptError::kHostMismatch)
+      << ResultName(result);
+}
+
+TEST(ImportedCookieCryptoTest, RejectsValueEncryptedWithEmptyFallbackKey) {
+  // Chromium's decryptor retries with this public key, derived from an empty
+  // password with 1 iteration. This decoder must not.
+  constexpr std::string_view kSalt = "saltysalt";
+  std::array<uint8_t, kImportedCookieKeySize> fallback_key;
+  ASSERT_EQ(PKCS5_PBKDF2_HMAC_SHA1("", 0, base::as_byte_span(kSalt).data(),
+                                   kSalt.size(), 1, fallback_key.size(),
+                                   fallback_key.data()),
+            1);
+  ASSERT_EQ(base::HexEncodeLower(fallback_key).substr(0, 8), "d0d0ec9c");
+
+  const auto key = KeyFor(kOtherPassword);
+  ASSERT_NE(key, fallback_key);
+  for (int db_version : {23, 24}) {
+    SCOPED_TRACE(db_version);
+    const auto encrypted =
+        EncryptV10(fallback_key, HostHash(kHost) + "session=abc123");
+    // Sanity check: the value is well formed under the fallback key.
+    EXPECT_EQ(
+        DecryptImportedCookieValue(fallback_key, encrypted, kHost, db_version),
+        DecryptResult(db_version >= kCookieDbVersionWithHostHash
+                          ? "session=abc123"
+                          : HostHash(kHost) + "session=abc123"));
+    // With the real key, the value is rejected, not retried.
+    const DecryptResult result =
+        DecryptImportedCookieValue(key, encrypted, kHost, db_version);
+    if (db_version >= kCookieDbVersionWithHostHash) {
+      ASSERT_FALSE(result.has_value());
+      EXPECT_TRUE(result.error() == CookieDecryptError::kBadPadding ||
+                  result.error() == CookieDecryptError::kHostMismatch)
+          << ResultName(result);
+    } else {
+      // Before version 24 a wrong key can't be told apart from a right one
+      // about 1 time in 256, but it must never yield the fallback plaintext.
+      EXPECT_NE(result, DecryptResult(HostHash(kHost) + "session=abc123"));
+    }
+  }
+}

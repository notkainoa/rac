+TEST(ImportedCookieCryptoTest, RejectsMalformedEnvelope) {
+  const auto key = KeyFor(kOtherPassword);
+  const struct {
+    std::string value;
+    CookieDecryptError error;
+  } cases[] = {
+      {"", CookieDecryptError::kEmpty},
+      {"v", CookieDecryptError::kNotV10},
+      {"v1", CookieDecryptError::kNotV10},
+      {"V10" + std::string(16, '\0'), CookieDecryptError::kNotV10},
+      {"v11" + std::string(16, '\0'), CookieDecryptError::kNotV10},
+      {"v10", CookieDecryptError::kTruncated},
+      {"v10" + std::string(1, '\0'), CookieDecryptError::kTruncated},
+      {"v10" + std::string(15, '\0'), CookieDecryptError::kTruncated},
+      {"v10" + std::string(17, '\0'), CookieDecryptError::kTruncated},
+      {"v10" + std::string(31, '\0'), CookieDecryptError::kTruncated},
+  };
+  for (const auto& test_case : cases) {
+    SCOPED_TRACE(test_case.value.size());
+    for (int db_version : {23, 24}) {
+      EXPECT_EQ(
+          DecryptImportedCookieValue(key, base::as_byte_span(test_case.value),
+                                     kHost, db_version),
+          base::unexpected(test_case.error));
+    }
+  }
+}
+
+TEST(ImportedCookieCryptoTest, AcceptsEveryValidPaddingLength) {
+  const auto key = KeyFor(kOtherPassword);
+  for (size_t pad = 1; pad <= 16; ++pad) {
+    SCOPED_TRACE(pad);
+    std::array<uint8_t, 16> block;
+    std::ranges::fill(block, 'x');
+    std::ranges::fill(base::span(block).last(pad), static_cast<uint8_t>(pad));
+    EXPECT_EQ(DecryptImportedCookieValue(key, EncryptV10Unpadded(key, block),
+                                         kHost, 23),
+              DecryptResult(std::string(16 - pad, 'x')));
+  }
+}
+
+TEST(ImportedCookieCryptoTest, ChecksEveryPaddingByte) {
+  const auto key = KeyFor(kOtherPassword);
+  // Each block ends in a byte that names a pad length, but an earlier byte of
+  // that pad is wrong. A check of only the last byte would accept all of them.
+  std::vector<std::array<uint8_t, 16>> blocks;
+  for (size_t pad = 2; pad <= 16; ++pad) {
+    for (size_t wrong = 16 - pad; wrong < 15; ++wrong) {
+      std::array<uint8_t, 16> block;
+      std::ranges::fill(block, 'x');
+      std::ranges::fill(base::span(block).last(pad), static_cast<uint8_t>(pad));
+      block[wrong] = static_cast<uint8_t>(pad - 1);
+      blocks.push_back(block);
+    }
+  }
+  for (const auto& block : blocks) {
+    SCOPED_TRACE(base::HexEncodeLower(block));
+    for (int db_version : {23, 24}) {
+      EXPECT_EQ(DecryptImportedCookieValue(key, EncryptV10Unpadded(key, block),
+                                           kHost, db_version),
+                base::unexpected(CookieDecryptError::kBadPadding));
+    }
+  }
+}
+
+TEST(ImportedCookieCryptoTest, RejectsOutOfRangePadByte) {
+  const auto key = KeyFor(kOtherPassword);
+  // 0 is never a pad length, and neither is anything over the block size, even
+  // when every byte of the block agrees.
+  for (uint8_t pad_byte : std::to_array<uint8_t>({0x00, 0x11, 0x20, 0xff})) {
+    SCOPED_TRACE(static_cast<int>(pad_byte));
+    std::array<uint8_t, 16> block;
+    std::ranges::fill(block, pad_byte);
+    std::array<uint8_t, 32> two_blocks;
+    std::ranges::fill(two_blocks, pad_byte);
+    EXPECT_EQ(DecryptImportedCookieValue(key, EncryptV10Unpadded(key, block),
+                                         kHost, 23),
+              base::unexpected(CookieDecryptError::kBadPadding));
+    EXPECT_EQ(DecryptImportedCookieValue(
+                  key, EncryptV10Unpadded(key, two_blocks), kHost, 23),
+              base::unexpected(CookieDecryptError::kBadPadding));
+  }
+}

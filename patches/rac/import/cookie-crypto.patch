+
+#include "chrome/browser/rac/import/imported_cookie_crypto.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/check_op.h"
+#include "base/containers/span.h"
+#include "base/notreached.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_view_util.h"
+#include "crypto/aes_cbc.h"
+#include "crypto/hash.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/boringssl/src/include/openssl/evp.h"
+
+namespace rac::import {
+namespace {
+
+struct CookieTestVector {
+  const char* name;
+  const char* host_key;
+  int db_version;
+  const char* encrypted_hex;
+  const char* plaintext;
+  const char* expect;
+};
+
+// Generated from synthetic fixtures with a fixed test password. Defines
+// kTestPassword, kTestDerivedKeyHex, and kCookieTestVectors.
+#include "chrome/browser/rac/import/cookie_test_vectors.inc"
+
+using DecryptResult = base::expected<std::string, CookieDecryptError>;
+
+constexpr char kOtherPassword[] = "not the fixture password";
+constexpr char kHost[] = ".example.test";
+
+constexpr std::array<uint8_t, crypto::aes_cbc::kBlockSize> kIv{
+    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+};
+
+std::array<uint8_t, kImportedCookieKeySize> KeyFor(std::string_view password) {
+  return DeriveImportedCookieKey(base::as_byte_span(password));
+}
+
+std::vector<uint8_t> FromHex(std::string_view hex) {
+  std::vector<uint8_t> bytes;
+  if (!hex.empty()) {
+    EXPECT_TRUE(base::HexStringToBytes(hex, &bytes)) << hex;
+  }
+  return bytes;
+}
+
+std::vector<uint8_t> WithV10Prefix(base::span<const uint8_t> ciphertext) {
+  std::vector<uint8_t> value = {'v', '1', '0'};
+  value.insert(value.end(), ciphertext.begin(), ciphertext.end());
+  return value;
+}
+
+// Encrypts `plaintext` the way Chromium writes a cookie value.
+std::vector<uint8_t> EncryptV10(
+    base::span<const uint8_t, kImportedCookieKeySize> key,
+    std::string_view plaintext) {
+  return WithV10Prefix(
+      crypto::aes_cbc::Encrypt(key, kIv, base::as_byte_span(plaintext)));
+}
+
+// Encrypts block-aligned `blocks` without adding padding, so a test controls
+// the last block. Encrypt() appends a whole padding block to aligned input,
+// and in CBC the earlier ciphertext blocks don't depend on later plaintext,
+// so dropping that last block leaves the unpadded encryption.
+std::vector<uint8_t> EncryptV10Unpadded(
+    base::span<const uint8_t, kImportedCookieKeySize> key,
+    base::span<const uint8_t> blocks) {
+  CHECK_EQ(blocks.size() % crypto::aes_cbc::kBlockSize, 0u);
+  std::vector<uint8_t> ciphertext = crypto::aes_cbc::Encrypt(key, kIv, blocks);
+  ciphertext.resize(blocks.size());
+  return WithV10Prefix(ciphertext);
+}
+
+std::string HostHash(std::string_view host) {
+  const std::array<uint8_t, crypto::hash::kSha256Size> hash =
+      crypto::hash::Sha256(host);
+  return std::string(base::as_string_view(hash));
+}
+
+std::string_view ResultName(const DecryptResult& result) {
+  if (result.has_value()) {
+    return "ok";
+  }
+  switch (result.error()) {
+    case CookieDecryptError::kUnsupportedVersion:
+      return "unsupported_version";
+    case CookieDecryptError::kEmpty:
+      return "empty";
+    case CookieDecryptError::kNotV10:
+      return "not_v10";
+    case CookieDecryptError::kTruncated:
+      return "truncated";
+    case CookieDecryptError::kBadPadding:
+      return "bad_padding";
+    case CookieDecryptError::kHostMismatch:
+      return "host_mismatch";
+  }
+  NOTREACHED();
+}

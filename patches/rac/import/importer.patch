+
+#ifndef CHROME_BROWSER_UI_RAC_IMPORT_ARC_IMPORTER_H_
+#define CHROME_BROWSER_UI_RAC_IMPORT_ARC_IMPORTER_H_
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/time/time.h"
+#include "chrome/browser/rac/import/arc_import_mapping.h"
+#include "chrome/browser/rac/import/arc_import_types.h"
+#include "chrome/browser/rac/import/import_plan.h"
+
+class Profile;
+
+namespace rac {
+
+class SidebarItems;
+
+using ArcImportProgressCallback =
+    base::RepeatingCallback<void(const ArcImportProgress&)>;
+using ArcImportDoneCallback = base::OnceCallback<void(const ArcImportResult&)>;
+using ArcProfileDoneCallback =
+    base::OnceCallback<void(const ArcProfileResult&)>;
+
+// Puts an Arc ImportPlan into rac. In each target profile it:
+//
+// 1. Takes DataBackups' operation token, and holds it to the end.
+// 2. Reads the import record, settles an earlier import that was cut short
+//    (below), and maps the Arc profile against the record and the live
+//    sidebar (MapArcProfile). If nothing is new, it stops there: no
+//    snapshot, no write.
+// 3. Flushes the spaces store and takes a pinned "import-arc" snapshot. No
+//    snapshot, no import.
+// 4. Saves the record with the run marked in progress, the snapshot, and
+//    every rac id it is about to write already mapped (AssignRacIds). If
+//    that fails, nothing is written and it reports kRecordNotSaved.
+// 5. Writes spaces, pinned tabs, folders, and favorites through
+//    SpacesService, SidebarItems, and SpacesWindowManager, in one UI task, so
+//    no window shows half an import. Open tabs go into the spaces store,
+//    unloaded, except in a space a window shows.
+// 6. Flushes the spaces store if it added stored tabs, commits
+//    `Preferences`, and only then saves the record again with the run done,
+//    so the record never claims ids that aren't on disk.
+// 7. Writes Arc's cached favicons to the favicon database, decoded in the
+//    data decoder's sandbox. Nothing is fetched.
+// 8. Runs Helium's importer for history only, if asked and not done before.
+// 9. Operation::MarkDataChanged(), and releases the token.
+//
+// An import cut short between steps 4 and 6 (a crash, a power cut) leaves
+// a record whose run is in progress. The next import or Undo in that
+// profile settles it before anything else (ArcImportRecord::
+// FinishInterrupted): what of it reached disk is kept as imported and stays
+// undoable, the rest is forgotten. So nothing is added twice, and Undo
+// always finds what the import wrote.
+//
+// Nothing here makes a network request, installs an extension, or touches
+// AI data. Profiles are imported one at a time.
+
+// For the sign-ins step, which owns profile creation. It makes
+// the rac profile for an Arc profile that isn't the default one. Until it's
+// registered, those Arc profiles end as ArcProfileResult::kNeedsProfile.
+class ArcProfileMaker {
+ public:
+  virtual ~ArcProfileMaker() = default;
+  // Runs `done` with the new profile, fully initialized, or null if it
+  // couldn't be made. `name` is ArcProfileName() for it.
+  virtual void MakeProfile(const ImportProfile& source,
+                           const std::u16string& name,
+                           base::OnceCallback<void(Profile*)> done) = 0;
+};
+// Called once at startup by the sign-ins step. Not owned.
+void SetArcProfileMaker(ArcProfileMaker* maker);
+
+// What every profile of one import shares.
+struct ArcImportRun {
+  ArcImportRun();
+  ArcImportRun(const ArcImportRun&);
+  ArcImportRun& operator=(const ArcImportRun&);
+  ~ArcImportRun();
+
+  // A new UUID per import, the same in every profile's record, so Undo
+  // finds every profile's part.
+  std::string id;
+  // Arc's support folder, for the history step: the folder the plan was
+  // read from (ImportPlan::source_dir). Empty: no history.
+  base::FilePath arc_support_dir;
+  ArcImportOptions options;
+  // Set only for the profile the import started from: hand-offs live in its
+  // record.
+  bool origin = false;
+  ImportHandoffs handoffs;
+  // Origin only: the other profiles this import wrote into, as profile
+  // folder base names, and the latest of their Undo deadlines, so the
+  // starting profile's record leads Undo to them.
+  std::vector<std::string> other_profiles;
+  base::Time others_undo_until;
+  // For progress across profiles: Arc spaces handled before this profile,
+  // and in all.
+  int spaces_before = 0;
+  int spaces_total = 0;
+};
+
+// The import screens' entry point. `profile` receives the default Arc
+// profile; the other checked ones go through ArcProfileMaker. `progress`
+// runs on the UI thread, in bursts; `done` runs once. History comes from
+// `plan.source_dir`, which ReadArc() always sets; a plan without one
+// imports no history.
+void StartArcImport(Profile* profile,
+                    ImportPlan plan,
+                    ArcImportOptions options,
+                    ArcImportProgressCallback progress,
+                    ArcImportDoneCallback done);
+
+// The per-profile entry point, for the sign-ins step when it drives
+// profiles itself: imports `source` into `target`, which must be a regular
+// profile. StartArcImport() calls it too.
+void ImportArcProfileInto(Profile* target,
+                          ImportProfile source,
+                          ArcImportRun run,
+                          ArcImportProgressCallback progress,
+                          ArcProfileDoneCallback done);
+
+// When this profile last received an Arc import, and what Undo would do
+// there: undo its newest import until when, or nothing because it was
+// undone or has expired. Reads the import record on a background sequence.
+void GetArcImportState(Profile* profile,
+                       base::OnceCallback<void(ArcImportState)> done);
+
+// "Undo Arc import": removes what this profile's newest import that isn't
+// undone yet added, and puts back the blank space it replaced; then the
+// same import's part in each profile it made, where that is still the
+// profile's newest. Each profile's imports are undone one at a time, newest
+// first, so a later import into another profile never makes an earlier one
+// un-undoable: Undo there takes out the later one, and then the earlier
+// one. It never deletes a profile and leaves history, favicons, and cookies
+// in place. The spaces it removes close their tabs, which stay in History.
+// Things the user made since the import are kept; pins they added to an
+// imported space move to a space that stays, or stay where they are if a
+// page keeps that space open (kPartlyUndone). `done` also says which spaces
+// stayed and which profiles still have a newer import to undo
+// (ArcUndoOutcome).
+void UndoArcImport(Profile* profile,
+                   base::OnceCallback<void(ArcUndoOutcome)> done);
+
+// Undo's sidebar steps for the user's own pins in a run space it deletes
+// (PlanKeptPins()). In the header for tests, which run them on a real
+// SidebarItems.
+//
+// Moves `kept` from `source_key` to the end of the top level of
+// `target_key`, in one batch. A folder of kept pins is made again there,
+// under a new id. Returns that id for each folder in `kept`, empty for a
+// loose item or a folder that wasn't moved. Only the sidebar lists change:
+// the pins' live tabs keep their space until
+// SpacesWindowManager::MoveItemTabsToSpace() moves them.
+std::vector<std::string> MoveKeptPins(SidebarItems* items,
+                                      const std::string& source_key,
+                                      const std::string& target_key,
+                                      const std::vector<ArcKeptPin>& kept);
+// Undoes MoveKeptPins() for a space that stayed after all. Each kept pin
+// goes back to its index, in list order, which rebuilds the list as it was
+// (ArcKeptPin). A folder that moving its pins out emptied, and so removed,
+// is made again in its place under its own id, so the record's mapping of
+// it still holds; its copy is emptied by the moves, and so removed.
+void PutKeptPinsBack(SidebarItems* items,
+                     const std::string& source_key,
+                     const std::string& target_key,
+                     const std::vector<ArcKeptPin>& kept,
+                     const std::vector<std::string>& copies);
+
+// What the sidebar calls an imported space: its name, or rac's own
+// "Space <position>" (1-based, switcher order) if Arc had none.
+std::u16string ImportedSpaceTitle(const ImportSpace& space, size_t position);
+// "Work", "Your Arc profile", or "Arc profile 2". Never the folder name.
+std::u16string ArcProfileName(const ImportPlan& plan, size_t index);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_IMPORT_ARC_IMPORTER_H_

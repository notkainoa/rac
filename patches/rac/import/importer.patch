+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_IMPORT_ARC_DEV_TRIGGER_H_
+#define CHROME_BROWSER_UI_RAC_IMPORT_ARC_DEV_TRIGGER_H_
+
+class Profile;
+
+namespace rac {
+
+// Dev builds only: true when the process was launched with the Arc import
+// switch. The spaces store loads at a higher priority then, because an
+// import is waiting on it. Always false in release builds.
+bool DevArcImportRequested();
+
+// Dev builds only. With --rac-import-arc-now, imports Arc into `profile`,
+// reading from --rac-import-source-root, as soon as the spaces store is
+// loaded, once per run. It exists so the sidebar can be screenshotted
+// before and after an import without clicking through the import screens.
+// Does nothing in release builds, where the switch doesn't exist.
+void MaybeStartDevArcImport(Profile* profile);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_IMPORT_ARC_DEV_TRIGGER_H_

+// Writes Arc's cached favicons to the favicon database. Decoding happens in
+// the data decoder service's sandboxed process, never in the browser. Only
+// for http and https pages, and only where no favicon is stored yet
+// (SetOnDemandFavicons doesn't overwrite, and marks the icon expired, so the
+// site's real icon replaces it on the first visit).
+class ArcFaviconWriter {
+ public:
+  struct Icon {
+    GURL page_url;
+    base::FilePath path;
+  };
+
+  ArcFaviconWriter(Profile* profile,
+                   scoped_refptr<base::SequencedTaskRunner> file_runner)
+      : profile_(profile), file_runner_(std::move(file_runner)) {}
+  ArcFaviconWriter(const ArcFaviconWriter&) = delete;
+  ArcFaviconWriter& operator=(const ArcFaviconWriter&) = delete;
+  ~ArcFaviconWriter() = default;
+
+  void Write(std::vector<Icon> icons, base::OnceClosure done) {
+    done_ = std::move(done);
+    std::erase_if(icons, [](const Icon& icon) {
+      return !icon.page_url.SchemeIsHTTPOrHTTPS() || icon.path.empty();
+    });
+    if (icons.size() > kMaxFavicons) {
+      icons.resize(kMaxFavicons);
+    }
+    if (icons.empty()) {
+      std::move(done_).Run();
+      return;
+    }
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&ReadFiles, std::move(icons)),
+        base::BindOnce(&ArcFaviconWriter::OnRead, weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  using Files = std::vector<std::pair<GURL, std::string>>;
+
+  static Files ReadFiles(std::vector<Icon> icons) {
+    Files files;
+    size_t total = 0;
+    for (const Icon& icon : icons) {
+      std::string bytes;
+      if (!base::ReadFileToStringWithMaxSize(icon.path, &bytes,
+                                             kMaxFaviconBytes) ||
+          bytes.empty()) {
+        continue;
+      }
+      total += bytes.size();
+      if (total > kMaxTotalFaviconBytes) {
+        break;
+      }
+      files.emplace_back(icon.page_url, std::move(bytes));
+    }
+    return files;
+  }
+
+  void OnRead(Files files) {
+    files_ = std::move(files);
+    pending_ = files_.size();
+    if (pending_ == 0) {
+      std::move(done_).Run();
+      return;
+    }
+    StartMore();
+  }
+
+  // Starts decodes until kMaxFaviconDecodesInFlight are running or every
+  // file has been started. The service copies the bytes it is sent, so a
+  // file's bytes are freed once its decode has started.
+  void StartMore() {
+    while (in_flight_ < kMaxFaviconDecodesInFlight && next_ < files_.size()) {
+      auto& [page_url, bytes] = files_[next_++];
+      ++in_flight_;
+      // A stable, made-up icon URL per image, so two pages of one site with
+      // different icons (Docs and Sheets) don't share one.
+      const GURL icon_url = page_url.GetWithEmptyPath().Resolve(
+          base::StringPrintf("/favicon.ico#rac-arc-%08x",
+                             base::PersistentHash(bytes)));
+      data_decoder::DecodeImage(
+          &decoder_, base::as_byte_span(bytes),
+          data_decoder::mojom::ImageCodec::kDefault, /*shrink_to_fit=*/true,
+          kMaxFaviconBytes, gfx::Size(kFaviconSize, kFaviconSize),
+          base::BindOnce(&ArcFaviconWriter::OnDecoded,
+                         weak_factory_.GetWeakPtr(), page_url, icon_url));
+      std::string().swap(bytes);
+    }
+  }
+
+  void OnDecoded(const GURL& page_url,
+                 const GURL& icon_url,
+                 const SkBitmap& bitmap) {
+    --in_flight_;
+    if (!bitmap.drawsNothing()) {
+      if (favicon::FaviconService* service =
+              FaviconServiceFactory::GetForProfile(
+                  profile_, ServiceAccessType::EXPLICIT_ACCESS)) {
+        service->SetOnDemandFavicons(
+            page_url, icon_url, favicon_base::IconType::kFavicon,
+            gfx::Image::CreateFrom1xBitmap(bitmap), base::DoNothing());
+      }
+    }
+    if (--pending_ == 0) {
+      std::move(done_).Run();
+      return;
+    }
+    StartMore();
+  }
+
+  const raw_ptr<Profile> profile_;
+  const scoped_refptr<base::SequencedTaskRunner> file_runner_;
+  // One utility process for every icon of the import.
+  data_decoder::DataDecoder decoder_;
+  // The files that were read, minus the bytes of each one whose decode has
+  // started.
+  Files files_;
+  size_t next_ = 0;
+  size_t in_flight_ = 0;
+  size_t pending_ = 0;
+  base::OnceClosure done_;
+  base::WeakPtrFactory<ArcFaviconWriter> weak_factory_{this};
+};
+
+// One Arc profile into one rac profile. Owns itself from Start() until it
+// runs `done`.
+class ArcProfileImport : public ProfileObserver,
+                         public importer::ImporterProgressObserver {
+ public:
+  static void Start(Profile* profile,
+                    ImportProfile source,
+                    ArcImportRun run,
+                    ArcImportProgressCallback progress,
+                    ArcProfileDoneCallback done) {
+    (new ArcProfileImport(profile, std::move(source), std::move(run),
+                          std::move(progress), std::move(done)))
+        ->Begin();
+  }
+
+ private:
+  ArcProfileImport(Profile* profile,
+                   ImportProfile source,
+                   ArcImportRun run,
+                   ArcImportProgressCallback progress,
+                   ArcProfileDoneCallback done)
+      : profile_(profile),
+        services_(GetServices(profile)),
+        source_(std::move(source)),
+        run_info_(std::move(run)),
+        progress_(std::move(progress)),
+        done_(std::move(done)),
+        file_runner_(CreateFileTaskRunner()) {
+    result_.source_key = source_.source_key;
+    result_.profile_path = profile_->GetPath();
+    result_.pinned_extensions =
+        static_cast<int>(source_.pinned_extension_ids.size());
+    run_.id = run_info_.id;
+    profile_observation_.Observe(profile_);
+  }
+
+  ~ArcProfileImport() override {
+    if (history_host_) {
+      history_host_->set_observer(nullptr);
+      history_host_->Cancel();
+    }
+  }
+
+  void Begin() {
+    if (!services_.ok()) {
+      Fail(ArcImportFailure::kProfileGone);
+      return;
+    }
+    operation_ = services_.backups->TryBeginOperation();
+    if (!operation_) {
+      Fail(ArcImportFailure::kBusy);
+      return;
+    }
+    // Stored tabs and DeleteSpace need the store loaded; it loads at
+    // profile start, so this is usually immediate.
+    services_.windows->RunWhenStoreReady(base::BindOnce(
+        &ArcProfileImport::ReadRecord, weak_factory_.GetWeakPtr()));
+  }
+
+  void ReadRecord() {
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&ArcImportRecord::Read, profile_->GetPath()),
+        base::BindOnce(&ArcProfileImport::OnRecordRead,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnRecordRead(ArcImportRecord::ReadResult read) {
+    switch (read.status) {
+      case ArcImportRecord::ReadStatus::kTooNew:
+        Fail(ArcImportFailure::kRecordTooNew);
+        return;
+      case ArcImportRecord::ReadStatus::kUnreadable:
+        // Not moved aside: a temporary read error must not make a rerun
+        // import everything twice.
+        Fail(ArcImportFailure::kRecordUnreadable);
+        return;
+      case ArcImportRecord::ReadStatus::kCorrupt:
+        // Kept for a look by hand; a fresh record replaces it. Ordered on
+        // the same sequence before the write.
+        file_runner_->PostTask(
+            FROM_HERE, base::BindOnce(base::IgnoreResult(
+                                          &ArcImportRecord::MoveAside),
+                                      profile_->GetPath()));
+        break;
+      case ArcImportRecord::ReadStatus::kMissing:
+        break;
+      case ArcImportRecord::ReadStatus::kOk:
+        record_ = std::move(read.record);
+        break;
+    }
+
+    // An earlier import into this profile that was cut short is settled
+    // first, so nothing it wrote is added twice and Undo still finds it.
+    if (SettleInterruptedRun(profile_, services_, record_) !=
+        ArcImportRecord::Interrupted::kNone) {
+      record_dirty_ = true;
+    }
+    plan_ = MapArcProfile(source_, record_, GatherLive(profile_, services_),
+                          run_info_.options);
+    result_.counts = plan_.counts;
+    if (plan_.IsEmpty()) {
+      NothingNew();
+      return;
+    }
+    TakeSnapshot();
+  }
+
+  // Nothing is left to add: report it, write the record when it must name
+  // this run so Undo finds the other profiles, or when it changed (an
+  // interrupted run was settled), and go on to history.
+  void NothingNew() {
+    SendSpacesProgress();
+    result_.status = ArcProfileResult::Status::kNothingNew;
+    if (NeedsRecordWithoutSidebar()) {
+      FinalizeRecord(/*wrote_sidebar=*/false);
+      WriteRecord(base::BindOnce(&ArcProfileImport::AfterRecordSaved,
+                                 weak_factory_.GetWeakPtr(),
+                                 /*wrote_sidebar=*/false));
+      return;
+    }
+    if (record_dirty_) {
+      WriteRecord(base::BindOnce(
+          [](base::WeakPtr<ArcProfileImport> self, bool) {
+            if (self) {
+              self->ImportHistory();
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+      return;
+    }
+    ImportHistory();
+  }
+
+  void TakeSnapshot() {
+    ArcImportProgress progress;
+    progress.step = ArcImportProgress::Step::kSnapshot;
+    progress_.Run(progress);
+    // The snapshot must hold the newest hidden tabs, so the store is written
+    // first.
+    services_.windows->FlushStore(base::BindOnce(
+        [](base::WeakPtr<ArcProfileImport> self) {
+          if (self) {
+            self->services_.backups->CreateSnapshot(
+                kSnapshotReason,
+                base::BindOnce(&ArcProfileImport::OnSnapshot, self));
+          }
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+
+  void OnSnapshot(std::optional<std::string> id) {
+    if (!id) {
+      Fail(ArcImportFailure::kSnapshotFailed);
+      return;
+    }
+    // Keeps the snapshot cap from deleting it during the Undo window.
+    services_.backups->PinSnapshot(*id);
+    run_.snapshot_id = *id;
+    run_.snapshot_time = base::Time::Now();
+    run_.undo_until = run_.snapshot_time + DataBackups::kSnapshotLifetime;
+    result_.undo_until = run_.undo_until;
+    Apply();
+  }
+
+  // Plans the import and saves the record with the run marked in progress
+  // and every id it is about to write already mapped, before anything is
+  // written: an import cut short after this is settled at the next import
+  // or Undo instead of being added twice or left out of Undo.
+  void Apply() {
+    // The sidebar may have changed while the store flushed and the
+    // snapshot was written, so plan against it now, not against what it
+    // was when the record was read.
+    plan_ = MapArcProfile(source_, record_, GatherLive(profile_, services_),
+                          run_info_.options);
+    result_.counts = plan_.counts;
+    if (plan_.IsEmpty()) {
+      NothingNewAfterSnapshot();
+      return;
+    }
+    base_record_ = record_;
+    if (plan_.record_was_stale) {
+      record_.ClearMappings();
+    }
+    AssignRacIds(plan_, record_, run_.id, [] { return NewRacId(); });
+    run_.in_progress = true;
+    run_.replaced_blank_space = plan_.replace_blank_space;
+    FinalizeRecord(/*wrote_sidebar=*/true);
+    WriteRecord(base::BindOnce(&ArcProfileImport::OnInProgressSaved,
+                               weak_factory_.GetWeakPtr()));
+  }
+
+  // The snapshot has nothing to roll back to; unpin it so its normal cap
+  // and expiry apply.
+  void NothingNewAfterSnapshot() {
+    services_.backups->UnpinSnapshot(run_.snapshot_id);
+    run_.snapshot_id.clear();
+    run_.snapshot_time = base::Time();
+    run_.undo_until = base::Time();
+    result_.undo_until.reset();
+    NothingNew();
+  }
+
+  void OnInProgressSaved(bool saved) {
+    if (!saved) {
+      // Nothing is written without a saved record to settle it by.
+      services_.backups->UnpinSnapshot(run_.snapshot_id);
+      services_.backups->DeleteSnapshot(run_.snapshot_id);
+      result_.counts = ArcImportCounts();
+      result_.undo_until.reset();
+      Fail(ArcImportFailure::kRecordNotSaved);
+      return;
+    }
+    WriteSidebar();
+  }
+
+  // Everything visible, in one task, so no window shows half an import.
+  void WriteSidebar() {
+    // Planned again against the sidebar as it is now, with the ids the
+    // saved record holds. Whatever has none waits for a later import.
+    plan_ = MapArcProfile(source_, base_record_,
+                          GatherLive(profile_, services_), run_info_.options);
+    TakePlannedRacIds(plan_, record_, run_.id);
+    result_.counts = plan_.counts;
+    if (plan_.IsEmpty()) {
+      // The saved run is in progress with nothing written; write the record
+      // without it.
+      record_ = std::move(base_record_);
+      record_dirty_ = true;
+      run_.in_progress = false;
+      run_.replaced_blank_space.clear();
+      NothingNewAfterSnapshot();
+      return;
+    }
+    std::optional<base::Uuid> first_new_space;
+    {
+      // Without the batches, every space saves the whole spaces pref and
+      // every item the whole lists pref, and wakes every window's sync.
+      SpacesService::ScopedSaveBatch save_batch(services_.spaces);
+      SidebarItems::ScopedBatch batch(services_.items);
+      folder_lists_ = GatherFolderLists(services_);
+      for (ArcApplySpace& space : plan_.spaces) {
+        const base::Uuid id =
+            space.is_new() ? CreateSpace(space)
+                           : base::Uuid::ParseLowercase(space.existing_id);
+        if (!first_new_space && space.is_new()) {
+          first_new_space = id;
+        }
+        AddPinned(id, space.pinned);
+        if (!space.open_tabs.empty()) {
+          open_tabs_.emplace_back(id, std::move(space.open_tabs));
+        }
+      }
+      for (const ArcApplyTab& favorite : plan_.favorites) {
+        AddTab(SidebarItems::kFavorites, SidebarPosition{}, favorite,
+               /*at_end_of=*/SidebarItems::kFavorites);
+      }
+      folder_lists_.clear();
+    }
+
+    run_.replaced_blank_space.clear();
+    if (first_new_space && !plan_.replace_blank_space.empty()) {
+      ReplaceBlankSpace(base::Uuid::ParseLowercase(plan_.replace_blank_space),
+                        *first_new_space);
+    }
+
+    // Open tabs last, so a space a window now shows gets them as tabs in that
+    // window, and every other space in the store.
+    const bool wrote_stored_tabs = !open_tabs_.empty();
+    for (auto& [space, tabs] : open_tabs_) {
+      StoredSpace stored;
+      stored.space = space;
+      for (const ArcApplyTab& tab : tabs) {
+        stored.tabs.push_back(ToStoredTab(tab));
+        if (!tab.favicon_path.empty()) {
+          favicons_.push_back({tab.url, tab.favicon_path});
+        }
+      }
+      stored.active_tab = 0;
+      // Appends to the space's stored tabs, or, when a window holds the
+      // space's live tabs, adds them there deferred and unselected, so the
+      // active tab stays and nothing loads.
+      services_.windows->AddStoredTabs(std::move(stored));
+    }
+    open_tabs_.clear();
+
+    SendSpacesProgress();
+    result_.status = ArcProfileResult::Status::kDone;
+    FinalizeRecord(/*wrote_sidebar=*/true);
+    // Marks the run done, mapping only what was written: an item that
+    // couldn't be added isn't in the profile, so a later import brings it.
+    const ArcLiveSidebar live = GatherLive(profile_, services_);
+    if (record_.FinishInterrupted(live.space_ids, live.sidebar_ids) ==
+        ArcImportRecord::Interrupted::kDropped) {
+      // Nothing could be added at all.
+      services_.backups->UnpinSnapshot(run_.snapshot_id);
+      result_.status = ArcProfileResult::Status::kNothingNew;
+      result_.counts = ArcImportCounts();
+      result_.undo_until.reset();
+    }
+    CommitThenWriteDoneRecord(wrote_stored_tabs);
+  }
+
+  // The done record must not reach disk before what it maps. `Preferences`
+  // holds the spaces and the sidebar lists and is written lazily, and the
+  // spaces store on its own schedule. A crash in between would leave a
+  // done run mapping ids the profile never got, and a rerun would skip
+  // them. So the store is flushed when this import added stored tabs, then
+  // `Preferences` is committed, and the record is written in the reply.
+  // Until then the in-progress record on disk covers a crash.
+  void CommitThenWriteDoneRecord(bool flush_store) {
+    base::OnceClosure commit = base::BindOnce(
+        [](base::WeakPtr<ArcProfileImport> self) {
+          if (!self) {
+            return;
+          }
+          self->profile_->GetPrefs()->CommitPendingWrite(base::BindOnce(
+              [](base::WeakPtr<ArcProfileImport> self) {
+                if (self) {
+                  self->WriteRecord(base::BindOnce(
+                      &ArcProfileImport::AfterRecordSaved, self,
+                      /*wrote_sidebar=*/true));
+                }
+              },
+              self));
+        },
+        weak_factory_.GetWeakPtr());
+    if (flush_store) {
+      services_.windows->FlushStore(std::move(commit));
+      return;
+    }
+    std::move(commit).Run();
+  }
+
+  base::Uuid CreateSpace(ArcApplySpace& apply) {
+    // AssignRacIds() made the id, and the saved record maps it.
+    Space space(base::Uuid::ParseLowercase(apply.rac_id),
+                std::move(apply.name));
+    space.icon = std::move(apply.icon);
+    if (apply.theme) {
+      space.theme = std::move(*apply.theme);
+    }
+    const base::Uuid id = space.id;
+    // Upserts by id, keeps the theme's custom stops and unknown fields, and
+    // notifies OnSpaceAdded.
+    services_.spaces->RestoreSpace(std::move(space),
+                                   services_.spaces->spaces().size());
+    return id;
+  }
+
+  void AddPinned(const base::Uuid& space,
+                 const std::vector<ArcApplyEntry>& entries) {
+    const std::string key = SidebarItems::PinnedListKey(space);
+    for (const ArcApplyEntry& entry : entries) {
+      if (const auto* tab = std::get_if<ArcApplyTab>(&entry)) {
+        AddTab(key, SidebarPosition{}, *tab, key);
+        continue;
+      }
+      const ArcApplyFolder& folder = std::get<ArcApplyFolder>(entry);
+      std::string folder_id = folder.existing_id;
+      std::string folder_key = key;
+      if (folder_id.empty()) {
+        folder_id = folder.rac_id;
+        if (!services_.items->AddFolderWithId(
+                folder_id, key, services_.items->GetList(key).entries.size(),
+                folder.title)) {
+          // The id is taken. The folder and its tabs wait for a later
+          // import; the tabs' ids never become live, so FinishInterrupted()
+          // forgets them, but the folder's is someone else's.
+          record_.UnmapItem(folder.source_id, run_.id);
+          continue;
+        }
+      } else {
+        // The user may have moved it to another space since.
+        auto it = folder_lists_.find(folder_id);
+        if (it == folder_lists_.end()) {
+          continue;
+        }
+        folder_key = it->second;
+      }
+      for (const ArcApplyTab& tab : folder.tabs) {
+        const SidebarFolder* live =
+            services_.items->GetList(folder_key).FindFolder(folder_id);
+        if (!live) {
+          break;
+        }
+        AddTab(folder_key, SidebarPosition{folder_id, live->items.size()}, tab,
+               std::string());
+      }
+    }
+  }
+
+  // Adds at `position`, or at the end of the top level of `at_end_of`,
+  // under the id AssignRacIds() made, which the saved record maps.
+  void AddTab(std::string_view key,
+              SidebarPosition position,
+              const ArcApplyTab& tab,
+              std::string_view at_end_of) {
+    if (!at_end_of.empty()) {
+      position = {std::string(),
+                  services_.items->GetList(at_end_of).entries.size()};
+    }
+    if (!services_.items->AddItemWithId(tab.rac_id, key, position, tab.url,
+                                        tab.page_title)) {
+      // Left out of the record, so a later import brings it. The id may be
+      // taken, and so live, which FinishInterrupted() alone would keep.
+      record_.UnmapItem(tab.source_id, run_.id);
+      return;
+    }
+    if (!tab.name.empty()) {
+      services_.items->SetItemName(tab.rac_id, tab.name);
+    }
+    if (!tab.favicon_path.empty()) {
+      favicons_.push_back({tab.url, tab.favicon_path});
+    }
+  }
+
+  // The window showing the blank space shows Arc's first space instead, on
+  // a fresh new-tab page, so no Arc page loads. Then the blank space goes.
+  void ReplaceBlankSpace(const base::Uuid& blank, const base::Uuid& first) {
+    if (!services_.spaces->FindSpace(blank)) {
+      return;
+    }
+    if (BrowserWindowInterface* window =
+            services_.windows->GetWindowHoldingSpace(blank)) {
+      services_.windows->ShowSpace(window, first);
+    }
+    // Closes the blank space's new-tab pages.
+    services_.windows->DeleteSpace(blank);
+    if (!services_.spaces->FindSpace(blank)) {
+      run_.replaced_blank_space = blank.AsLowercaseString();
+    }
+  }
+
+  bool NeedsRecordWithoutSidebar() const {
+    return run_info_.origin && !run_info_.other_profiles.empty();
+  }
+
+  void FinalizeRecord(bool wrote_sidebar) {
+    const base::Time now = base::Time::Now();
+    run_.time = now;
+    if (!wrote_sidebar) {
+      // The run is recorded here only so Undo finds the other profiles.
+      run_.undo_until = run_info_.others_undo_until;
+    }
+    if (run_info_.origin) {
+      run_.other_profiles = run_info_.other_profiles;
+      record_.handoffs = run_info_.handoffs;
+    }
+    record_.AddRun(run_);
+    if (record_.first_import.is_null()) {
+      record_.first_import = now;
+    }
+    record_.last_import = now;
+    if (!source_.source_key.empty()) {
+      record_.arc_profile_key = source_.source_key;
+    }
+    if (!source_.pinned_extension_ids.empty()) {
+      record_.pinned_extension_ids = source_.pinned_extension_ids;
+    }
+  }
+
+  void WriteRecord(base::OnceCallback<void(bool)> done) {
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](ArcImportRecord record, base::FilePath dir) {
+              return record.Write(dir);
+            },
+            record_, profile_->GetPath()),
+        std::move(done));
+  }
+
+  void AfterRecordSaved(bool wrote_sidebar, bool saved) {
+    // With the sidebar written, a record that couldn't be marked done is
+    // fine: the in-progress one saved before maps everything written, and
+    // the next import or Undo settles it. Nothing is taken back.
+    if (!saved && !wrote_sidebar) {
+      // The nothing-new run's record couldn't be saved, so the hand-offs
+      // and other profiles' names it held are gone. Report it and carry on
+      // to favicons and history.
+      result_.status = ArcProfileResult::Status::kFailed;
+      result_.failure = ArcImportFailure::kRecordNotSaved;
+    }
+    if (wrote_sidebar) {
+      operation_->MarkDataChanged();
+    }
+    favicon_writer_ =
+        std::make_unique<ArcFaviconWriter>(profile_, file_runner_);
+    favicon_writer_->Write(std::move(favicons_),
+                           base::BindOnce(&ArcProfileImport::ImportHistory,
+                                          weak_factory_.GetWeakPtr()));
+  }
+
+  // Helium's importer, history only. With items set to HISTORY, the host
+  // loads no bookmark model, runs no extension import, and shows no dialog;
+  // the utility process reads only the source's History file. Bookmarks off
+  // also keeps Arc's pins from arriving a second time.
+  void ImportHistory() {
+    if (!run_info_.options.history) {
+      result_.history = ArcProfileResult::History::kNotRequested;
+      Finish();
+      return;
+    }
+    if (!record_.history_imported.is_null()) {
+      result_.history = ArcProfileResult::History::kAlreadyImported;
+      Finish();
+      return;
+    }
+    if (source_.directory.empty() || run_info_.arc_support_dir.empty()) {
+      result_.history = ArcProfileResult::History::kNotAvailable;
+      Finish();
+      return;
+    }
+    // `directory` is a single folder name (import_plan.h). Anything else
+    // could point outside Arc's "User Data".
+    if (!IsPlainFolderName(source_.directory)) {
+      result_.history = ArcProfileResult::History::kNotAvailable;
+      Finish();
+      return;
+    }
+    const base::FilePath source_path =
+        run_info_.arc_support_dir.Append(FILE_PATH_LITERAL("User Data"))
+            .Append(base::FilePath::FromUTF8Unsafe(source_.directory));
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](const base::FilePath& support_dir,
+               const base::FilePath& folder) {
+              // Helium's importer reads this folder. It and its History must
+              // be inside Arc's folder once symlinks are followed, as for
+              // every file the reader reads.
+              const base::FilePath history =
+                  folder.Append(FILE_PATH_LITERAL("History"));
+              return base::PathExists(history) &&
+                     ArcPathStaysInside(support_dir, folder) &&
+                     ArcPathStaysInside(support_dir, history);
+            },
+            run_info_.arc_support_dir, source_path),
+        base::BindOnce(&ArcProfileImport::StartHistory,
+                       weak_factory_.GetWeakPtr(), source_path));
+  }
+
+  void StartHistory(base::FilePath source_path, bool exists) {
+    if (!exists) {
+      result_.history = ArcProfileResult::History::kNotAvailable;
+      Finish();
+      return;
+    }
+    ArcImportProgress progress;
+    progress.step = ArcImportProgress::Step::kHistory;
+    progress_.Run(progress);
+
+    user_data_importer::SourceProfile source;
+    source.importer_name = u"Arc";
+    source.importer_type = user_data_importer::TYPE_ARC;
+    source.source_path = std::move(source_path);
+    source.services_supported = user_data_importer::HISTORY;
+    history_host_ = new BraveExternalProcessImporterHost();
+    history_host_->set_headless();
+    history_host_->set_observer(this);
+    history_host_->StartImportSettings(source, profile_,
+                                       user_data_importer::HISTORY,
+                                       new ProfileWriter(profile_));
+  }
+
+  // importer::ImporterProgressObserver:
+  void ImportStarted() override {}
+  void ImportItemStarted(user_data_importer::ImportItem item) override {}
+  void ImportItemEnded(user_data_importer::ImportItem item) override {
+    if (item == user_data_importer::HISTORY) {
+      history_ok_ = true;
+    }
+  }
+  void ImportEnded() override {
+    // The host deletes itself after this.
+    history_host_ = nullptr;
+    if (!history_ok_) {
+      result_.history = ArcProfileResult::History::kFailed;
+      Finish();
+      return;
+    }
+    result_.history = ArcProfileResult::History::kImported;
+    record_.history_imported = base::Time::Now();
+    WriteRecord(base::BindOnce([](base::WeakPtr<ArcProfileImport> self,
+                                  bool) {
+      if (self) {
+        self->Finish();
+      }
+    }, weak_factory_.GetWeakPtr()));
+  }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    profile_observation_.Reset();
+    Fail(ArcImportFailure::kProfileGone);
+  }
+
+  void SendSpacesProgress() {
+    ArcImportProgress progress;
+    progress.step = ArcImportProgress::Step::kSpaces;
+    progress.total = run_info_.spaces_total;
+    int done = run_info_.spaces_before;
+    for (const ImportSpace& space : source_.spaces) {
+      progress.done = ++done;
+      progress.space_id = space.source_id;
+      const ArcImportRecord::SpaceMapping* mapping =
+          record_.FindSpace(space.source_id);
+      const std::optional<size_t> position =
+          mapping ? services_.spaces->GetIndex(
+                        base::Uuid::ParseLowercase(mapping->rac_id))
+                  : std::nullopt;
+      progress.space_title = base::UTF16ToUTF8(
+          ImportedSpaceTitle(space, position.value_or(0) + 1));
+      progress_.Run(progress);
+    }
+  }
+
+  void Fail(ArcImportFailure failure) {
+    result_.status = ArcProfileResult::Status::kFailed;
+    result_.failure = failure;
+    Finish();
+  }
+
+  void Finish() {
+    // Releasing the token lets DataBackups refresh its daily backup soon.
+    operation_.reset();
+    std::move(done_).Run(result_);
+    delete this;
+  }
+
+  const raw_ptr<Profile> profile_;
+  const Services services_;
+  const ImportProfile source_;
+  const ArcImportRun run_info_;
+  ArcImportProgressCallback progress_;
+  ArcProfileDoneCallback done_;
+  const scoped_refptr<base::SequencedTaskRunner> file_runner_;
+
+  std::unique_ptr<DataBackups::Operation> operation_;
+  ArcImportRecord record_;
+  // The record as read, before this run's mappings, for planning again
+  // once the in-progress record is saved.
+  ArcImportRecord base_record_;
+  // The record changed without a run of this import: write it even if
+  // nothing is new.
+  bool record_dirty_ = false;
+  ArcImportRecord::Run run_;
+  ArcApplyPlan plan_;
+  ArcProfileResult result_;
+  // Folder ids to their list keys, while the sidebar is written.
+  FolderLists folder_lists_;
+  std::vector<std::pair<base::Uuid, std::vector<ArcApplyTab>>> open_tabs_;
+  std::vector<ArcFaviconWriter::Icon> favicons_;
+  std::unique_ptr<ArcFaviconWriter> favicon_writer_;
+  raw_ptr<BraveExternalProcessImporterHost> history_host_ = nullptr;
+  bool history_ok_ = false;
+
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<ArcProfileImport> weak_factory_{this};
+};
+
+// The whole import: other Arc profiles first, each into the profile the
+// sign-ins step makes, then the default one into the profile the import
+// started from. That order lets the starting profile's record name every
+// profile the import touched, in one write, while it holds its token.
+class ArcImportCoordinator {
+ public:
+  static void Start(Profile* profile,
+                    ImportPlan plan,
+                    ArcImportOptions options,
+                    ArcImportProgressCallback progress,
+                    ArcImportDoneCallback done) {
+    (new ArcImportCoordinator(profile, std::move(plan), std::move(options),
+                              std::move(progress), std::move(done)))
+        ->Next();
+  }
+
+ private:
+  ArcImportCoordinator(Profile* profile,
+                       ImportPlan plan,
+                       ArcImportOptions options,
+                       ArcImportProgressCallback progress,
+                       ArcImportDoneCallback done)
+      : origin_path_(profile->GetPath()),
+        plan_(std::move(plan)),
+        progress_(std::move(progress)),
+        done_(std::move(done)) {
+    run_.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    // The plan carries the folder it was read from (ImportPlan::source_dir),
+    // so history comes from the same copy, such as a dev fixture. ReadArc()
+    // always sets it. Without it there's no history: finding Arc's folder
+    // again would touch the disk on the UI thread.
+    run_.arc_support_dir = plan_.source_dir;
+    run_.options = std::move(options);
+    run_.handoffs = plan_.handoffs;
+    for (size_t i = 0; i < plan_.profiles.size(); ++i) {
+      const ImportProfile& source = plan_.profiles[i];
+      if (run_.options.skipped_profile_keys.contains(source.source_key)) {
+        continue;
+      }
+      run_.spaces_total += static_cast<int>(source.spaces.size());
+      if (source.is_default) {
+        default_index_ = i;
+      } else {
+        others_.push_back(i);
+      }
+    }
+    for (const ImportProfile& source : plan_.profiles) {
+      ArcProfileResult skipped;
+      skipped.source_key = source.source_key;
+      skipped.status = ArcProfileResult::Status::kSkipped;
+      results_.push_back(skipped);
+    }
+  }
+
+  ~ArcImportCoordinator() = default;
+
+  Profile* origin() const {
+    return g_browser_process->profile_manager()->GetProfileByPath(
+        origin_path_);
+  }
+
+  void Next() {
+    if (next_other_ < others_.size()) {
+      const size_t index = others_[next_other_++];
+      if (!g_profile_maker) {
+        results_[index].status = ArcProfileResult::Status::kNeedsProfile;
+        Next();
+        return;
+      }
+      g_profile_maker->MakeProfile(
+          plan_.profiles[index], ArcProfileName(plan_, index),
+          base::BindOnce(&ArcImportCoordinator::OnProfileMade,
+                         base::Unretained(this), index));
+      return;
+    }
+    if (!origin_started_) {
+      origin_started_ = true;
+      Profile* profile = origin();
+      if (!profile) {
+        Finish(ArcImportFailure::kProfileGone);
+        return;
+      }
+      ArcImportRun run = run_;
+      run.origin = true;
+      run.other_profiles = other_profiles_;
+      run.others_undo_until = others_undo_until_;
+      run.spaces_before = spaces_done_;
+      // With the default profile unchecked, the starting profile still
+      // records the run, for Undo and the hand-offs.
+      ImportProfile source;
+      if (default_index_) {
+        source = plan_.profiles[*default_index_];
+      }
+      ImportArcProfileInto(
+          profile, std::move(source), std::move(run), progress_,
+          base::BindOnce(&ArcImportCoordinator::OnProfileDone,
+                         base::Unretained(this), default_index_,
+                         /*new_profile=*/false));
+      return;
+    }
+    Finish(ArcImportFailure::kNone);
+  }
+
+  void OnProfileMade(size_t index, Profile* profile) {
+    if (!profile) {
+      results_[index].status = ArcProfileResult::Status::kFailed;
+      Next();
+      return;
+    }
+    ArcImportRun run = run_;
+    run.spaces_before = spaces_done_;
+    ImportArcProfileInto(
+        profile, plan_.profiles[index], std::move(run), progress_,
+        base::BindOnce(&ArcImportCoordinator::OnProfileDone,
+                       base::Unretained(this), std::optional<size_t>(index),
+                       /*new_profile=*/true));
+  }
+
+  void OnProfileDone(std::optional<size_t> index,
+                     bool new_profile,
+                     const ArcProfileResult& result) {
+    if (index) {
+      spaces_done_ += static_cast<int>(plan_.profiles[*index].spaces.size());
+      results_[*index] = result;
+      results_[*index].new_profile = new_profile;
+    }
+    if (new_profile && result.undo_until) {
+      other_profiles_.push_back(result.profile_path.BaseName().AsUTF8Unsafe());
+      others_undo_until_ = std::max(others_undo_until_, *result.undo_until);
+    }
+    if (!new_profile) {
+      origin_result_ = result;
+    }
+    Next();
+  }
+
+  void Finish(ArcImportFailure failure) {
+    if (failure == ArcImportFailure::kNone && origin_result_ &&
+        origin_result_->status == ArcProfileResult::Status::kFailed) {
+      failure = origin_result_->failure;
+    }
+    bool any_done = false;
+    bool any_failed = false;
+    for (const ArcProfileResult& result : results_) {
+      result_.counts += result.counts;
+      result_.pinned_extensions += result.pinned_extensions;
+      any_done |= result.status == ArcProfileResult::Status::kDone ||
+                  result.history == ArcProfileResult::History::kImported;
+      any_failed |= result.status == ArcProfileResult::Status::kFailed;
+      if (result.undo_until) {
+        result_.undo_until =
+            std::max(result_.undo_until.value_or(base::Time()),
+                     *result.undo_until);
+      }
+    }
+    result_.profiles = results_;
+    result_.failure = failure;
+    if (any_done) {
+      result_.status = ArcImportResult::Status::kDone;
+    } else if (any_failed || failure != ArcImportFailure::kNone) {
+      result_.status = ArcImportResult::Status::kFailed;
+    } else {
+      result_.status = ArcImportResult::Status::kNothingNew;
+    }
+    // Hand-offs live only in the starting profile's record. A nothing-new
+    // run writes that record only when other profiles' names had to go
+    // into it for Undo.
+    result_.handoffs_saved =
+        origin_result_ &&
+        (origin_result_->status == ArcProfileResult::Status::kDone ||
+         (origin_result_->status == ArcProfileResult::Status::kNothingNew &&
+          !other_profiles_.empty())) &&
+        (!plan_.handoffs.routing_rules_json.empty() ||
+         !plan_.handoffs.auto_archive_raw.empty());
+    std::move(done_).Run(result_);
+    delete this;
+  }
+
+  const base::FilePath origin_path_;
+  const ImportPlan plan_;
+  ArcImportProgressCallback progress_;
+  ArcImportDoneCallback done_;
+  ArcImportRun run_;
+  std::optional<size_t> default_index_;
+  std::vector<size_t> others_;
+  size_t next_other_ = 0;
+  bool origin_started_ = false;
+  int spaces_done_ = 0;
+  std::vector<std::string> other_profiles_;
+  base::Time others_undo_until_;
+  // The starting profile's own result, also when the default Arc profile
+  // was unchecked and it only recorded the run.
+  std::optional<ArcProfileResult> origin_result_;
+  std::vector<ArcProfileResult> results_;
+  ArcImportResult result_;
+};
+
+// Undo in one profile. `run_id` empty: this profile's newest undoable run.
+class ArcProfileUndo : public ProfileObserver {
+ public:
+  using Done = base::OnceCallback<void(ArcUndoOutcome,
+                                       const ArcImportRecord::Run* run)>;
+
+  static void Start(Profile* profile, std::string run_id, Done done) {
+    (new ArcProfileUndo(profile, std::move(run_id), std::move(done)))
+        ->Begin();
+  }
+
+ private:
+  ArcProfileUndo(Profile* profile, std::string run_id, Done done)
+      : profile_(profile),
+        services_(GetServices(profile)),
+        run_id_(std::move(run_id)),
+        done_(std::move(done)),
+        file_runner_(CreateFileTaskRunner()) {
+    profile_observation_.Observe(profile_);
+  }
+  ~ArcProfileUndo() override = default;
+
+  void Begin() {
+    if (!services_.ok()) {
+      Finish(ArcUndoResult::kFailed);
+      return;
+    }
+    operation_ = services_.backups->TryBeginOperation();
+    if (!operation_) {
+      Finish(ArcUndoResult::kBusy);
+      return;
+    }
+    // See ArcProfileImport::Begin().
+    services_.windows->RunWhenStoreReady(base::BindOnce(
+        [](base::WeakPtr<ArcProfileUndo> self) {
+          if (!self) {
+            return;
+          }
+          self->file_runner_->PostTaskAndReplyWithResult(
+              FROM_HERE,
+              base::BindOnce(&ArcImportRecord::Read,
+                             self->profile_->GetPath()),
+              base::BindOnce(&ArcProfileUndo::OnRecordRead, self));
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+
+  void OnRecordRead(ArcImportRecord::ReadResult read) {
+    if (read.status == ArcImportRecord::ReadStatus::kMissing) {
+      Finish(ArcUndoResult::kNothingToUndo);
+      return;
+    }
+    if (read.status != ArcImportRecord::ReadStatus::kOk) {
+      Finish(ArcUndoResult::kFailed);
+      return;
+    }
+    record_ = std::move(read.record);
+    const base::Time now = base::Time::Now();
+
+    // An import cut short is settled first (ArcImportRecord::
+    // FinishInterrupted). If none of it was in the profile, settling it is
+    // this profile's whole Undo; the other profiles it names still get
+    // theirs.
+    std::optional<ArcImportRecord::Run> interrupted;
+    if (const ArcImportRecord::Run* run = record_.InterruptedRun()) {
+      interrupted = *run;
+    }
+    if (SettleInterruptedRun(profile_, services_, record_) ==
+            ArcImportRecord::Interrupted::kDropped &&
+        (run_id_.empty() || run_id_ == interrupted->id)) {
+      run_ = std::move(*interrupted);
+      WriteRecord();
+      return;
+    }
+
+    // One run at a time, newest first, in each profile.
+    const ArcImportRecord::Run* newest = record_.NewestActiveRun();
+    const ArcImportRecord::Run* run =
+        run_id_.empty() ? newest : record_.FindRun(run_id_);
+    if (!run || run->undone) {
+      Finish(ArcUndoResult::kNothingToUndo);
+      return;
+    }
+    if (run != newest) {
+      // A newer import into this profile may have added to what this run
+      // made; it has to be undone here first.
+      outcome_.blocked_profiles.push_back(ProfileDisplayName(profile_));
+      Finish(ArcUndoResult::kPartlyUndone);
+      return;
+    }
+    if (run->undo_until.is_null() || now >= run->undo_until) {
+      Finish(ArcUndoResult::kExpired);
+      return;
+    }
+    run_ = *run;
+    if (run_.replaced_blank_space.empty() || run_.snapshot_id.empty()) {
+      Apply(std::nullopt);
+      return;
+    }
+    // The blank space comes back exactly as the snapshot has it.
+    services_.backups->ReadBackup(
+        run_.snapshot_id,
+        base::BindOnce(&ArcProfileUndo::OnSnapshotRead,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnSnapshotRead(std::optional<DataBackups::Contents> contents) {
+    const base::Uuid blank =
+        base::Uuid::ParseLowercase(run_.replaced_blank_space);
+    std::optional<Space> space;
+    if (contents) {
+      if (const base::DictValue* spaces =
+              contents->prefs.FindDict(DataBackups::kSpacesPref)) {
+        if (const base::ListValue* list = spaces->FindList("spaces")) {
+          for (const base::Value& value : *list) {
+            if (const base::DictValue* dict = value.GetIfDict()) {
+              std::optional<Space> parsed = Space::FromDict(*dict);
+              if (parsed && parsed->id == blank) {
+                space = std::move(parsed);
+                break;
+              }
+            }
+          }
+        }
+      }
+    }
+    // Without the snapshot, a blank space with the same id is the same
+    // thing: that's what made it blank.
+    if (!space && blank.is_valid()) {
+      space.emplace(blank, std::string());
+    }
+    Apply(std::move(space));
+  }
+
+  void Apply(std::optional<Space> blank) {
+    const Removal removal =
+        RemoveRun(services_, record_, run_, std::move(blank));
+    partial_ = removal.partial;
+    outcome_.kept_spaces = removal.kept_space_names;
+    for (const auto& [old_id, new_id] : removal.moved_folders) {
+      record_.RemapItem(run_.id, old_id, new_id);
+    }
+    record_.ForgetRemoved(run_.id, removal.removed, base::Time::Now());
+    operation_->MarkDataChanged();
+    // As for the import's done record: the record forgets what Undo removed
+    // only once `Preferences` no longer has it. The other way round, a crash
+    // would bring the items back unmapped, and a rerun would add them twice.
+    profile_->GetPrefs()->CommitPendingWrite(base::BindOnce(
+        &ArcProfileUndo::WriteRecord, weak_factory_.GetWeakPtr()));
+  }
+
+  void WriteRecord() {
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](ArcImportRecord record, base::FilePath dir) {
+              return record.Write(dir);
+            },
+            record_, profile_->GetPath()),
+        base::BindOnce(&ArcProfileUndo::OnRecordWritten,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnRecordWritten(bool saved) {
+    // The pre-import snapshot isn't deleted: Undo is done with it, so the
+    // pin comes off and its normal cap and expiry apply. A space that
+    // stayed keeps the run undoable, and Undo may need the snapshot again.
+    if (!partial_ && !run_.snapshot_id.empty()) {
+      services_.backups->UnpinSnapshot(run_.snapshot_id);
+    }
+    // The sidebar is already undone. A record that couldn't be saved still
+    // maps the removed items, so a rerun skips them until it's saved again.
+    Finish(partial_ ? ArcUndoResult::kPartlyUndone
+           : saved  ? ArcUndoResult::kUndone
+                    : ArcUndoResult::kFailed);
+  }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    profile_observation_.Reset();
+    Finish(ArcUndoResult::kFailed);
+  }
+
+  void Finish(ArcUndoResult result) {
+    operation_.reset();
+    outcome_.result = result;
+    // The lists say what stayed, and only a partly undone import has any.
+    if (result != ArcUndoResult::kPartlyUndone) {
+      outcome_.kept_spaces.clear();
+      outcome_.blocked_profiles.clear();
+    }
+    std::move(done_).Run(std::move(outcome_),
+                         run_.id.empty() ? nullptr : &run_);
+    delete this;
+  }
+
+  const raw_ptr<Profile> profile_;
+  const Services services_;
+  const std::string run_id_;
+  Done done_;
+  const scoped_refptr<base::SequencedTaskRunner> file_runner_;
+  std::unique_ptr<DataBackups::Operation> operation_;
+  ArcImportRecord record_;
+  ArcImportRecord::Run run_;
+  bool partial_ = false;
+  ArcUndoOutcome outcome_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<ArcProfileUndo> weak_factory_{this};
+};
+
+// Undo across profiles: the starting profile first, then each other profile
+// its run names, loaded if needed. Never deletes a profile.
+class ArcUndoCoordinator {
+ public:
+  static void Start(Profile* profile,
+                    base::OnceCallback<void(ArcUndoOutcome)> done) {
+    auto* self = new ArcUndoCoordinator(profile->GetPath(), std::move(done));
+    ArcProfileUndo::Start(
+        profile, std::string(),
+        base::BindOnce(&ArcUndoCoordinator::OnOriginDone,
+                       base::Unretained(self)));
+  }
+
+ private:
+  ArcUndoCoordinator(base::FilePath origin_path,
+                     base::OnceCallback<void(ArcUndoOutcome)> done)
+      : user_data_dir_(origin_path.DirName()), done_(std::move(done)) {}
+
+  void OnOriginDone(ArcUndoOutcome outcome, const ArcImportRecord::Run* run) {
+    outcome_ = std::move(outcome);
+    if (!run || (outcome_.result != ArcUndoResult::kUndone &&
+                 outcome_.result != ArcUndoResult::kPartlyUndone)) {
+      Finish();
+      return;
+    }
+    run_id_ = run->id;
+    others_ = run->other_profiles;
+    Next();
+  }
+
+  void Next() {
+    if (others_.empty()) {
+      Finish();
+      return;
+    }
+    const std::string name = others_.back();
+    others_.pop_back();
+    // The record names profiles by folder name. Anything else could point
+    // outside the user data dir.
+    if (!IsPlainFolderName(name)) {
+      Next();
+      return;
+    }
+    const base::FilePath path =
+        user_data_dir_.Append(base::FilePath::FromUTF8Unsafe(name));
+    // An unknown profile runs the callback with null, which continues;
+    // don't continue again here.
+    g_browser_process->profile_manager()->LoadProfileByPath(
+        path, /*incognito=*/false,
+        base::BindOnce(&ArcUndoCoordinator::OnProfileLoaded,
+                       base::Unretained(this)));
+  }
+
+  void OnProfileLoaded(Profile* profile) {
+    if (!profile) {
+      Next();
+      return;
+    }
+    // Nothing else keeps a profile loaded by path alive while Undo runs.
+    keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
+        profile,
+        ProfileKeepAliveOrigin::kWaitingForBookmarksImportOnFirstRun);
+    if (!keep_alive_) {
+      // The profile is being deleted. Nothing of it to undo.
+      Next();
+      return;
+    }
+    ArcProfileUndo::Start(
+        profile, run_id_,
+        base::BindOnce(
+            [](ArcUndoCoordinator* self, ArcUndoOutcome outcome,
+               const ArcImportRecord::Run*) {
+              if (outcome.result == ArcUndoResult::kPartlyUndone ||
+                  outcome.result == ArcUndoResult::kFailed ||
+                  outcome.result == ArcUndoResult::kBusy) {
+                self->outcome_.result = ArcUndoResult::kPartlyUndone;
+                // After the starting profile's, in the order the profiles
+                // were undone.
+                for (std::u16string& name : outcome.kept_spaces) {
+                  self->outcome_.kept_spaces.push_back(std::move(name));
+                }
+                for (std::u16string& name : outcome.blocked_profiles) {
+                  self->outcome_.blocked_profiles.push_back(std::move(name));
+                }
+              }
+              self->keep_alive_.reset();
+              self->Next();
+            },
+            base::Unretained(this)));
+  }
+
+  void Finish() {
+    keep_alive_.reset();
+    std::move(done_).Run(std::move(outcome_));
+    delete this;
+  }
+
+  const base::FilePath user_data_dir_;
+  base::OnceCallback<void(ArcUndoOutcome)> done_;
+  ArcUndoOutcome outcome_;
+  std::string run_id_;
+  std::vector<std::string> others_;
+  // Keeps the profile being undone alive until its Undo finishes.
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+};
+
+}  // namespace
+
+std::vector<std::string> MoveKeptPins(SidebarItems* items,
+                                      const std::string& source_key,
+                                      const std::string& target_key,
+                                      const std::vector<ArcKeptPin>& kept) {
+  // One save and one notification. The windows' sidebar sync reacts to it
+  // in a posted task, so the pins' tabs still carry the source space's tag
+  // when this returns.
+  SidebarItems::ScopedBatch batch(items);
+  std::vector<std::string> copies(kept.size());
+  for (size_t i = 0; i < kept.size(); ++i) {
+    const ArcKeptPin& pin = kept[i];
+    if (pin.item_ids.empty()) {
+      continue;
+    }
+    if (pin.folder_id.empty()) {
+      items->MoveItem(
+          pin.item_ids.front(), target_key,
+          SidebarPosition{std::string(),
+                          items->GetList(target_key).entries.size()});
+      continue;
+    }
+    const SidebarFolder* folder =
+        items->GetList(source_key).FindFolder(pin.folder_id);
+    if (!folder) {
+      continue;
+    }
+    // AddFolder may grow the list and move its entries, so copy the
+    // folder's fields before calling it.
+    const std::u16string title = folder->title;
+    const bool collapsed = folder->collapsed;
+    copies[i] = items->AddFolder(
+        target_key, items->GetList(target_key).entries.size(), title);
+    if (copies[i].empty()) {
+      continue;
+    }
+    items->SetFolderCollapsed(copies[i], collapsed);
+    items->MoveItems(pin.item_ids, target_key, SidebarPosition{copies[i], 0});
+  }
+  return copies;
+}
+
+void PutKeptPinsBack(SidebarItems* items,
+                     const std::string& source_key,
+                     const std::string& target_key,
+                     const std::vector<ArcKeptPin>& kept,
+                     const std::vector<std::string>& copies) {
+  SidebarItems::ScopedBatch batch(items);
+  for (size_t i = 0; i < kept.size(); ++i) {
+    const ArcKeptPin& pin = kept[i];
+    if (pin.item_ids.empty()) {
+      continue;
+    }
+    if (pin.folder_id.empty()) {
+      items->MoveItem(pin.item_ids.front(), source_key,
+                      SidebarPosition{std::string(), pin.index});
+      continue;
+    }
+    if (copies[i].empty()) {
+      continue;
+    }
+    if (!items->GetList(source_key).FindFolder(pin.folder_id)) {
+      const SidebarFolder* copy =
+          items->GetList(target_key).FindFolder(copies[i]);
+      if (!copy) {
+        continue;
+      }
+      const std::u16string title = copy->title;
+      const bool collapsed = copy->collapsed;
+      // Fails only if something else has taken the id since. The pins then
+      // stay in the copy, which RemoveRun() maps in its place.
+      if (!items->AddFolderWithId(pin.folder_id, source_key, pin.index,
+                                  title)) {
+        continue;
+      }
+      items->SetFolderCollapsed(pin.folder_id, collapsed);
+    }
+    for (size_t j = 0; j < pin.item_ids.size(); ++j) {
+      items->MoveItem(pin.item_ids[j], source_key,
+                      SidebarPosition{pin.folder_id, pin.item_indices[j]});
+    }
+  }
+}
+
+ArcImportRun::ArcImportRun() = default;
+ArcImportRun::ArcImportRun(const ArcImportRun&) = default;
+ArcImportRun& ArcImportRun::operator=(const ArcImportRun&) = default;
+ArcImportRun::~ArcImportRun() = default;
+
+void SetArcProfileMaker(ArcProfileMaker* maker) {
+  g_profile_maker = maker;
+}
+
+void StartArcImport(Profile* profile,
+                    ImportPlan plan,
+                    ArcImportOptions options,
+                    ArcImportProgressCallback progress,
+                    ArcImportDoneCallback done) {
+  CHECK(profile);
+  if (profile->IsOffTheRecord()) {
+    // Fail like any other failure, but asynchronously: `done` never runs
+    // synchronously.
+    ArcImportResult result;
+    result.status = ArcImportResult::Status::kFailed;
+    result.failure = ArcImportFailure::kOffTheRecord;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), std::move(result)));
+    return;
+  }
+  ArcImportCoordinator::Start(profile, std::move(plan), std::move(options),
+                              std::move(progress), std::move(done));
+}
+
+void ImportArcProfileInto(Profile* target,
+                          ImportProfile source,
+                          ArcImportRun run,
+                          ArcImportProgressCallback progress,
+                          ArcProfileDoneCallback done) {
+  CHECK(target);
+  if (target->IsOffTheRecord()) {
+    ArcProfileResult result;
+    result.source_key = source.source_key;
+    result.status = ArcProfileResult::Status::kFailed;
+    result.failure = ArcImportFailure::kOffTheRecord;
+    result.profile_path = target->GetPath();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), std::move(result)));
+    return;
+  }
+  ArcProfileImport::Start(target, std::move(source), std::move(run),
+                          std::move(progress), std::move(done));
+}
+
+void GetArcImportState(Profile* profile,
+                       base::OnceCallback<void(ArcImportState)> done) {
+  CreateFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath dir) {
+            ArcImportRecord::ReadResult read = ArcImportRecord::Read(dir);
+            if (read.status != ArcImportRecord::ReadStatus::kOk) {
+              return ArcImportState();
+            }
+            // An interrupted run counts as the newest import: Undo settles
+            // it, then takes out what of it is in the profile.
+            return read.record.StateAt(base::Time::Now());
+          },
+          profile->GetPath()),
+      std::move(done));
+}
+
+void UndoArcImport(Profile* profile,
+                   base::OnceCallback<void(ArcUndoOutcome)> done) {
+  CHECK(profile);
+  if (profile->IsOffTheRecord()) {
+    ArcUndoOutcome outcome;
+    outcome.result = ArcUndoResult::kFailed;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), std::move(outcome)));
+    return;
+  }
+  ArcUndoCoordinator::Start(profile, std::move(done));
+}
+
+std::u16string ImportedSpaceTitle(const ImportSpace& space, size_t position) {
+  const std::string name = ImportedSpaceName(space);
+  if (!name.empty()) {
+    return base::UTF8ToUTF16(name);
+  }
+  return l10n_util::GetStringFUTF16(IDS_RAC_SPACE_FALLBACK_NAME,
+                                    base::NumberToString16(position));
+}
+
+std::u16string ArcProfileName(const ImportPlan& plan, size_t index) {
+  const ArcProfileLabel label = ArcProfileLabelFor(plan, index);
+  switch (label.fallback) {
+    case ArcProfileLabel::Fallback::kNone:
+      return base::UTF8ToUTF16(label.name);
+    case ArcProfileLabel::Fallback::kDefault:
+      // English until the import screens land their strings.
+      return u"Your Arc profile";
+    case ArcProfileLabel::Fallback::kNumbered:
+      return u"Arc profile " + base::NumberToString16(label.number);
+  }
+}
+
+}  // namespace rac

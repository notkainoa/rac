+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/import/arc_dev_trigger.h"
+
+#include "chrome/browser/rac/dev/buildflags.h"
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/types/expected.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/import/arc_import_types.h"
+#include "chrome/browser/rac/import/arc_reader.h"
+#include "chrome/browser/rac/import/arc_source_root.h"
+#include "chrome/browser/rac/import/import_plan.h"
+#include "chrome/browser/ui/rac/import/arc_importer.h"
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+
+namespace rac {
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+
+namespace {
+
+// Not in release builds.
+constexpr char kImportArcNowSwitch[] = "rac-import-arc-now";
+
+bool g_started = false;
+
+void OnDone(const ArcImportResult& result) {
+  LOG(INFO) << "rac dev import finished";
+}
+
+void OnRead(base::WeakPtr<Profile> profile,
+            base::expected<ImportPlan, ArcReadError> plan) {
+  if (!profile) {
+    return;
+  }
+  if (!plan.has_value()) {
+    LOG(ERROR) << "rac dev import: Arc could not be read";
+    return;
+  }
+  ArcImportOptions options;
+  // The screenshots are about the sidebar. History would run Helium's
+  // importer.
+  options.history = false;
+  StartArcImport(profile.get(), std::move(plan.value()), options,
+                 base::DoNothing(), base::BindOnce(&OnDone));
+}
+
+void Start(base::WeakPtr<Profile> profile) {
+  if (!profile) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([] { return ReadArc(GetArcSourcePaths()); }),
+      base::BindOnce(&OnRead, std::move(profile)));
+}
+
+}  // namespace
+
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+
+bool DevArcImportRequested() {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kImportArcNowSwitch);
+#else
+  return false;
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+}
+
+void MaybeStartDevArcImport(Profile* profile) {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  if (g_started || !profile->IsRegularProfile() || !DevArcImportRequested()) {
+    return;
+  }
+  if (!HasDevArcSourceRootSwitch(*base::CommandLine::ForCurrentProcess())) {
+    // Without a copy to read, the import would read the real Arc.
+    LOG(ERROR) << "--" << kImportArcNowSwitch
+               << " needs --rac-import-source-root; not importing";
+    return;
+  }
+  g_started = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&Start, profile->GetWeakPtr()));
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+}
+
+}  // namespace rac

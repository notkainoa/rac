+#include "chrome/browser/ui/rac/sidebar/sidebar_items.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager_factory.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+// One restore, from the operation token to the applied plan. It owns itself:
+// every step's callback holds a WeakPtr, and Finish() runs `done` and deletes
+// it. Deleting it also releases the Operation token, and pending steps whose
+// replies were dropped with their service die with it.
+class RestoreJob : public ProfileObserver {
+ public:
+  RestoreJob(Profile* profile,
+             RestoreMode mode,
+             bool resolve_offer,
+             DataRestorer::Callback done)
+      : mode_(mode),
+        resolve_offer_(resolve_offer),
+        profile_(profile),
+        done_(std::move(done)) {
+    if (profile_) {
+      profile_observation_.Observe(profile_);
+    }
+  }
+  RestoreJob(const RestoreJob&) = delete;
+  RestoreJob& operator=(const RestoreJob&) = delete;
+  ~RestoreJob() override = default;
+
+  // Steps 1 and 2: the token, then the backup in memory. A null `backup_id`
+  // reads the offered backup, which falls back to the next-best one.
+  void Begin(std::optional<std::string> backup_id) {
+    if (!ProfileAlive()) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    DataBackups* backups = DataBackupsFactory::GetForProfile(profile_);
+    if (!backups) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    operation_ = backups->TryBeginOperation();
+    if (!operation_) {
+      Finish(DataRestorer::Result::kBusy);
+      return;
+    }
+    auto read = base::BindOnce(&RestoreJob::OnBackupRead,
+                               weak_factory_.GetWeakPtr());
+    if (backup_id) {
+      backups->ReadBackup(*backup_id, std::move(read));
+    } else {
+      backups->ReadOfferedBackup(std::move(read));
+    }
+  }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile*) override {
+    profile_ = nullptr;
+    Finish(DataRestorer::Result::kProfileGone);
+  }
+
+ private:
+  // Step 3: wait for the store, look at what's live, and take the safety
+  // snapshot when the restore could lose something.
+  void OnBackupRead(std::optional<DataBackups::Contents> backup) {
+    if (!ProfileAlive()) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    if (!backup) {
+      Finish(DataRestorer::Result::kBackupMissing);
+      return;
+    }
+    backup_ = std::move(*backup);
+    SpacesWindowManager* windows =
+        SpacesWindowManagerFactory::GetForProfile(profile_);
+    if (!windows) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    windows->RunWhenStoreReady(base::BindOnce(&RestoreJob::OnStoreReady,
+                                            weak_factory_.GetWeakPtr()));
+  }
+
+  void OnStoreReady() {
+    if (!ProfileAlive()) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    PrefService* prefs = profile_->GetPrefs();
+    SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile_);
+    SpacesWindowManager* windows =
+        SpacesWindowManagerFactory::GetForProfile(profile_);
+    if (!prefs || !spaces || !windows) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    GatherLive(*prefs, *spaces, *windows);
+    if (!NeedsSafetySnapshot(mode_, live_)) {
+      ApplyPlan();
+      return;
+    }
+    // The snapshot's copy of `rac spaces` must hold the tabs of every hidden
+    // space, so the store is written first.
+    windows->FlushStore(base::BindOnce(&RestoreJob::OnStoreFlushed,
+                                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnStoreFlushed() {
+    if (!ProfileAlive()) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    DataBackups* backups = DataBackupsFactory::GetForProfile(profile_);
+    if (!backups) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    backups->CreateSnapshot(
+        "restore", base::BindOnce(&RestoreJob::OnSafetySnapshot,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void OnSafetySnapshot(std::optional<std::string> id) {
+    if (!id) {
+      Finish(DataRestorer::Result::kSnapshotFailed);
+      return;
+    }
+    if (!ProfileAlive()) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+    ApplyPlan();
+  }
+
+  // Captured the same way a backup captures them: user values only, so an
+  // unset pref stays out and the planner treats it as the default.
+  void GatherLive(const PrefService& prefs,
+                  const SpacesService& spaces,
+                  const SpacesWindowManager& windows) {
+    for (const char* name : DataBackups::kBackedUpPrefs) {
+      if (const base::Value* value = prefs.GetUserPrefValue(name)) {
+        live_.prefs.Set(name, value->Clone());
+      }
+    }
+    for (const Space& space : spaces.spaces()) {
+      if (windows.HasLiveTabs(space.id)) {
+        live_.spaces_with_window_tabs.insert(space.id.AsLowercaseString());
+      }
+      if (!windows.GetStoredTabs(space.id).empty()) {
+        live_.spaces_with_stored_tabs.insert(space.id.AsLowercaseString());
+      }
+    }
+  }
+
+  // Steps 4-6: apply in this one task, so windows never paint a
+  // half-restored sidebar. Everything is re-fetched; the profile could have
+  // lost a service while a step was pending.
+  void ApplyPlan() {
+    PrefService* prefs = profile_->GetPrefs();
+    SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile_);
+    SpacesWindowManager* windows =
+        SpacesWindowManagerFactory::GetForProfile(profile_);
+    SidebarItems* items = SidebarItems::Get(profile_);
+    DataBackups* backups = DataBackupsFactory::GetForProfile(profile_);
+    if (!prefs || !spaces || !windows || !items || !backups) {
+      Finish(DataRestorer::Result::kProfileGone);
+      return;
+    }
+
+    // The sidebar can change while the store flushes and the safety snapshot
+    // is written, so plan against what is live now, in this same task.
+    live_ = LiveSidebar();
+    GatherLive(*prefs, *spaces, *windows);
+    RestorePlan plan = MakeRestorePlan(*backup_, live_, mode_);
+
+    // The backup's spaces, in its order.
+    for (size_t i = 0; i < plan.spaces.size(); ++i) {
+      if (std::optional<Space> space = Space::FromDict(plan.spaces[i])) {
+        spaces->RestoreSpace(std::move(*space), i);
+      }
+    }
+
+    // The blank space a reset left hands its open tabs to the first restored
+    // space. Delete it only once its tabs moved: if the target couldn't be
+    // restored, keeping it loses nothing and closing it would lose tabs.
+    bool moved_placeholder = false;
+    if (plan.move_tabs_from) {
+      const base::Uuid from =
+          base::Uuid::ParseCaseInsensitive(*plan.move_tabs_from);
+      const base::Uuid to = base::Uuid::ParseCaseInsensitive(plan.move_tabs_to);
+      if (from.is_valid() && to.is_valid() && spaces->FindSpace(to)) {
+        windows->MoveWindowTabs(from, to);
+        moved_placeholder = true;
+      }
+    }
+    for (const std::string& id : plan.delete_spaces) {
+      if (!moved_placeholder && plan.move_tabs_from &&
+          id == *plan.move_tabs_from) {
+        continue;
+      }
+      const base::Uuid space = base::Uuid::ParseCaseInsensitive(id);
+      if (space.is_valid()) {
+        windows->DeleteSpace(space);
+      }
+    }
+
+    // Favorites and pinned tabs. The pref changes first, then the service
+    // that owns the live copy reloads it.
+    SetOrClearDict(prefs, kListsPref, plan.sidebar_lists);
+    items->ReloadFromPrefs();
+
+    // Hidden spaces' tabs. Only plans from a backup with `rac spaces` carry
+    // either list, so a daily or pre-reset copy leaves them alone.
+    for (const auto& [id, dict] : plan.restore_stored_tabs) {
+      const base::Uuid space = base::Uuid::ParseCaseInsensitive(id);
+      if (!space.is_valid()) {
+        continue;
+      }
+      std::optional<StoredSpace> stored = StoredSpace::FromDict(dict);
+      if (!stored) {
+        continue;
+      }
+      stored->space = space;
+      // AddStoredTabs appends; drop the live entry first so the backup's
+      // copy replaces it.
+      windows->RemoveStoredTabs(space);
+      windows->AddStoredTabs(std::move(*stored));
+    }
+    for (const std::string& id : plan.remove_stored_tabs) {
+      const base::Uuid space = base::Uuid::ParseCaseInsensitive(id);
+      if (space.is_valid()) {
+        windows->RemoveStoredTabs(space);
+      }
+    }
+
+    // Agent permissions. Only pref values change; no AI code runs.
+    SetOrClearDict(prefs, DataBackups::kAgentSiteRulesPref,
+                   plan.agent_site_rules);
+    SetOrClearString(prefs, DataBackups::kAgentPermissionLevelPref,
+                     plan.agent_permission_level);
+
+    operation_->MarkDataChanged();
+    if (resolve_offer_) {
+      backups->ResolveRestoreOffer();
+    }
+    Finish(DataRestorer::Result::kRestored);
+  }
+
+  // A nullopt from the plan clears the pref; anything unexpected falls back
+  // to clearing it too, since SidebarItems reads a non-dict as empty anyway.
+  static void SetOrClearDict(PrefService* prefs,
+                             std::string_view name,
+                             const std::optional<base::Value>& value) {
+    if (value && value->is_dict()) {
+      prefs->SetDict(name, value->GetDict().Clone());
+    } else {
+      prefs->ClearPref(name);
+    }
+  }
+
+  static void SetOrClearString(PrefService* prefs,
+                               std::string_view name,
+                               const std::optional<base::Value>& value) {
+    if (value && value->is_string()) {
+      prefs->SetString(name, value->GetString());
+    } else {
+      prefs->ClearPref(name);
+    }
+  }
+
+  // The observer fires for a real teardown; IsValidProfile also catches a
+  // profile that was never registered or is already half gone. It only
+  // compares pointers, so a stale `profile_` is safe to pass.
+  bool ProfileAlive() const {
+    ProfileManager* manager =
+        g_browser_process ? g_browser_process->profile_manager() : nullptr;
+    return profile_ && manager && manager->IsValidProfile(profile_);
+  }
+
+  void Finish(DataRestorer::Result result) {
+    // Free the token first, so `done` may start another operation.
+    operation_.reset();
+    profile_observation_.Reset();
+    if (done_) {
+      std::move(done_).Run(result);
+    }
+    delete this;
+  }
+
+  const RestoreMode mode_;
+  const bool resolve_offer_;
+  raw_ptr<Profile> profile_;
+  DataRestorer::Callback done_;
+  std::unique_ptr<DataBackups::Operation> operation_;
+  std::optional<DataBackups::Contents> backup_;
+  LiveSidebar live_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<RestoreJob> weak_factory_{this};
+};
+
+}  // namespace
+
+// static
+void DataRestorer::Restore(Profile* profile,
+                           std::string_view backup_id,
+                           Mode mode,
+                           Callback done) {
+  // Owns itself until `done` runs.
+  RestoreJob* job = new RestoreJob(profile, mode, /*resolve_offer=*/false,
+                                   std::move(done));
+  job->Begin(std::string(backup_id));
+}
+
+// static
+void DataRestorer::RestoreOffer(Profile* profile, Callback done) {
+  RestoreJob* job = new RestoreJob(profile, RestoreMode::kMerge,
+                                   /*resolve_offer=*/true, std::move(done));
+  job->Begin(std::nullopt);
+}
+
+}  // namespace rac

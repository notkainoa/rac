+constexpr char kImportArcNowSwitch[] = "rac-import-arc-now";
+
+bool g_started = false;
+
+void OnDone(const ArcImportResult& result) {
+  LOG(INFO) << "rac dev import finished";
+}
+
+void OnRead(base::WeakPtr<Profile> profile,
+            base::expected<ImportPlan, ArcReadError> plan) {
+  if (!profile) {
+    return;
+  }
+  if (!plan.has_value()) {
+    LOG(ERROR) << "rac dev import: Arc could not be read";
+    return;
+  }
+  ArcImportOptions options;
+  // The screenshots are about the sidebar. History would run Helium's
+  // importer.
+  options.history = false;
+  StartArcImport(profile.get(), std::move(plan.value()), options,
+                 base::DoNothing(), base::BindOnce(&OnDone));
+}
+
+void Start(base::WeakPtr<Profile> profile) {
+  if (!profile) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([] { return ReadArc(GetArcSourcePaths()); }),
+      base::BindOnce(&OnRead, std::move(profile)));
+}
+
+}  // namespace
+
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+
+bool DevArcImportRequested() {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kImportArcNowSwitch);
+#else
+  return false;
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+}
+
+void MaybeStartDevArcImport(Profile* profile) {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  if (g_started || !profile->IsRegularProfile() || !DevArcImportRequested()) {
+    return;
+  }
+  g_started = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&Start, profile->GetWeakPtr()));
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+}
+
+}  // namespace rac

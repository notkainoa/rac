+
+namespace rac {
+
+namespace {
+
+using ItemKind = ArcImportRecord::ItemKind;
+
+ArcProfileMaker* g_profile_maker = nullptr;
+
+constexpr char kSnapshotReason[] = "import-arc";
+// Arc's favicon cache holds small images. Anything larger isn't one.
+constexpr size_t kMaxFaviconBytes = 512 * 1024;
+constexpr size_t kMaxFavicons = 2000;
+// All of them together, so reading them can't fill memory before decoding
+// starts.
+constexpr size_t kMaxTotalFaviconBytes = 32 * 1024 * 1024;
+// The decoder's process gets at most this many images at a time.
+constexpr size_t kMaxFaviconDecodesInFlight = 16;
+constexpr int kFaviconSize = 32;
+
+scoped_refptr<base::SequencedTaskRunner> CreateFileTaskRunner() {
+  // USER_VISIBLE: the import screen waits on it. BLOCK_SHUTDOWN: a record
+  // write that has started must finish, or a rerun adds everything twice.
+  return base::ThreadPool::CreateSequencedTaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+}
+
+// True when `name` names one folder directly inside a directory. Anything
+// else could make a path joined to that directory point at it, or outside
+// it.
+bool IsPlainFolderName(const std::string& name) {
+  const base::FilePath path = base::FilePath::FromUTF8Unsafe(name);
+  return !path.empty() && !path.IsAbsolute() && !path.ReferencesParent() &&
+         path.BaseName() == path;
+}
+
+struct Services {
+  raw_ptr<DataBackups> backups = nullptr;
+  raw_ptr<SpacesService> spaces = nullptr;
+  raw_ptr<SidebarItems> items = nullptr;
+  raw_ptr<SpacesWindowManager> windows = nullptr;
+
+  bool ok() const { return backups && spaces && items && windows; }
+};
+
+Services GetServices(Profile* profile) {
+  Services services;
+  services.backups = DataBackupsFactory::GetForProfile(profile);
+  services.spaces = SpacesServiceFactory::GetForProfile(profile);
+  services.items = SidebarItems::Get(profile);
+  services.windows = SpacesWindowManagerFactory::GetForProfile(profile);
+  return services;
+}
+
+// Same idea as SpacesWindowManager's IsUnusedInitialTab(), with the
+// URL-only checks first: IsNTPOrRelatedURL needs the default search
+// provider, which can still be loading this early in a cold start.
+bool IsUnusedTab(tabs::TabInterface* tab, Profile* profile) {
+  content::WebContents* contents = tab->GetContents();
+  const GURL& url = contents->GetVisibleURL();
+  return contents->GetController().IsInitialBlankNavigation() ||
+         url.IsAboutBlank() || url == chrome::ChromeUINewTabURLAsGURL() ||
+         search::IsNTPURL(url) || search::IsNTPOrRelatedURL(url, profile);
+}
+
+// The profile's only space, if a new profile would look like this: no name,
+// icon, theme, or pins, and nothing open but new-tab pages.
+bool IsBlankSpace(Profile* profile, const Space& space, const Services& s) {
+  const SpaceTheme fresh;
+  if (!space.name.empty() || !space.icon.empty() ||
+      space.theme.color1 != fresh.color1 ||
+      space.theme.color2 != fresh.color2 ||
+      space.theme.mode != SpaceTheme::Mode::kAuto ||
+      !space.theme.unknown_fields.empty() ||
+      !s.items->GetList(SidebarItems::PinnedListKey(space.id))
+           .entries.empty()) {
+    return false;
+  }
+  // A blank space with stored tabs has been used.
+  if (!s.windows->GetStoredTabs(space.id).empty()) {
+    return false;
+  }
+  // With one space, every unpinned tab is that space's. Favorites (Chromium
+  // pinned tabs) belong to the profile and stay.
+  bool unused = true;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        TabStripModel* model = browser->GetTabStripModel();
+        if (!model) {
+          return true;
+        }
+        for (tabs::TabInterface* tab : *model) {
+          if (!tab->IsPinned() && !IsUnusedTab(tab, profile)) {
+            unused = false;
+            return false;
+          }
+        }
+        return true;
+      });
+  return unused;
+}
+
+ArcLiveSidebar GatherLive(Profile* profile, const Services& s) {
+  ArcLiveSidebar live;
+  for (const SidebarItem* item :
+       s.items->GetList(SidebarItems::kFavorites).AllItems()) {
+    live.sidebar_ids.insert(item->id);
+    live.favorite_urls.insert(item->url.spec());
+  }
+  for (const Space& space : s.spaces->spaces()) {
+    live.space_ids.insert(space.id.AsLowercaseString());
+    const SidebarList& list =
+        s.items->GetList(SidebarItems::PinnedListKey(space.id));
+    for (const SidebarList::Entry& entry : list.entries) {
+      if (const auto* folder = std::get_if<SidebarFolder>(&entry)) {
+        live.sidebar_ids.insert(folder->id);
+        for (const SidebarItem& item : folder->items) {
+          live.sidebar_ids.insert(item.id);
+        }
+      } else {
+        live.sidebar_ids.insert(std::get<SidebarItem>(entry).id);
+      }
+    }
+  }
+  if (s.spaces->spaces().size() == 1 &&
+      IsBlankSpace(profile, s.spaces->spaces().front(), s)) {
+    live.blank_space_id = s.spaces->spaces().front().id.AsLowercaseString();
+  }
+  return live;
+}
+
+// Every folder in a space's pinned list, by id, with the key of that list.
+// Built once per pass, so finding folders stays linear.
+using FolderLists = std::map<std::string, std::string, std::less<>>;
+FolderLists GatherFolderLists(const Services& s) {
+  FolderLists folders;
+  for (const Space& space : s.spaces->spaces()) {
+    const std::string key = SidebarItems::PinnedListKey(space.id);
+    for (const SidebarList::Entry& entry : s.items->GetList(key).entries) {
+      if (const auto* folder = std::get_if<SidebarFolder>(&entry)) {
+        folders.emplace(folder->id, key);
+      }
+    }
+  }
+  return folders;
+}
+
+// An import cut short before it marked its run done is settled against
+// what the profile holds (ArcImportRecord::FinishInterrupted). A dropped
+// run's snapshot is unpinned, so its normal cap and expiry apply.
+ArcImportRecord::Interrupted SettleInterruptedRun(Profile* profile,
+                                                  const Services& s,
+                                                  ArcImportRecord& record) {
+  const ArcImportRecord::Run* interrupted = record.InterruptedRun();
+  if (!interrupted) {
+    return ArcImportRecord::Interrupted::kNone;
+  }
+  const std::string snapshot = interrupted->snapshot_id;
+  const ArcLiveSidebar live = GatherLive(profile, s);
+  const ArcImportRecord::Interrupted result =
+      record.FinishInterrupted(live.space_ids, live.sidebar_ids);
+  if (result == ArcImportRecord::Interrupted::kDropped && !snapshot.empty()) {
+    s.backups->UnpinSnapshot(snapshot);
+  }
+  return result;
+}
+
+std::string NewRacId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+StoredTab ToStoredTab(const ArcApplyTab& tab) {
+  // As SidebarWindowSync's GetItemNavigation(): one entry, never loaded.
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_index(0);
+  navigation.set_virtual_url(tab.url);
+  navigation.set_original_request_url(tab.url);
+  navigation.set_title(tab.name.empty() ? tab.page_title : tab.name);
+  navigation.set_transition_type(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  if (!tab.created.is_null()) {
+    navigation.set_timestamp(tab.created);
+  }
+  StoredTab stored;
+  stored.navigations.push_back(std::move(navigation));
+  stored.selected_navigation = 0;
+  stored.last_active = tab.created;
+  return stored;
+}
+
+// What the run removed, and whether some of it couldn't be.
+struct Removal {
+  base::flat_set<std::string> removed;
+  bool partial = false;
+  // The spaces that stayed, in sidebar order, as the sidebar names them.
+  std::vector<std::u16string> kept_space_names;
+  // Folders the run made that now live on as a copy under a new id, holding
+  // the user's own pins: the old id and the new one, for
+  // ArcImportRecord::RemapItem().
+  std::vector<std::pair<std::string, std::string>> moved_folders;
+};
+
+// The profile's name in the profile list, or nothing if the list doesn't
+// have it.
+std::u16string ProfileDisplayName(Profile* profile) {
+  const ProfileAttributesEntry* entry =
+      g_browser_process->profile_manager()
+          ->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(profile->GetPath());
+  return entry ? entry->GetName() : std::u16string();
+}
+
+// The top-level entries of `list`, as PlanKeptPins() reads them.
+std::vector<ArcUndoPinEntry> PinEntries(const SidebarList& list) {
+  std::vector<ArcUndoPinEntry> entries;
+  for (const SidebarList::Entry& entry : list.entries) {
+    ArcUndoPinEntry pin;
+    if (const auto* folder = std::get_if<SidebarFolder>(&entry)) {
+      pin.id = folder->id;
+      pin.is_folder = true;
+      for (const SidebarItem& item : folder->items) {
+        pin.item_ids.push_back(item.id);
+      }
+    } else {
+      pin.id = std::get<SidebarItem>(entry).id;
+    }
+    entries.push_back(std::move(pin));
+  }
+  return entries;
+}
+
+// Takes out what `run` added to this profile, by id, wherever it is now.
+// Pins the user added to an imported space after the import are first
+// moved to a space that stays, with their open tabs. Used by Undo. `blank`
+// is the space the run replaced, put back first so the profile always has
+// a space and windows on an imported space fall back to it.
+//
+// A page that asks before closing can keep its space: the user stayed on
+// it. That space then stays as it was. Its kept pins go back in their
+// places, with their tabs, and nothing in it is removed, so its mappings
+// stay and Undo can be tried again; the result is partial.
+Removal RemoveRun(const Services& s,
+                  const ArcImportRecord& record,
+                  const ArcImportRecord::Run& run,
+                  std::optional<Space> blank) {
+  Removal result;
+  const std::vector<std::string> run_spaces = record.SpacesOfRun(run.id);
+  std::vector<std::string> profile_spaces;
+  for (const Space& space : s.spaces->spaces()) {
+    profile_spaces.push_back(space.id.AsLowercaseString());
+  }
+  // The blank space comes back first, unless a partial Undo already put it
+  // back: RestoreSpace upserts, and would undo the user's changes to it.
+  // DeleteSpace does nothing to the last space, so if the user deleted
+  // every space of their own since, a new blank one keeps the profile
+  // valid.
+  const ArcUndoSpaces plan = PlanUndoSpaces(
+      profile_spaces, run_spaces,
+      blank ? blank->id.AsLowercaseString() : std::string());
+  if (plan.restore_blank) {
+    s.spaces->RestoreSpace(std::move(*blank), 0);
+  }
+  std::optional<base::Uuid> created;
+  if (plan.create_space) {
+    created = s.spaces->CreateSpace();
+  }
+
+  // DeleteSpace deletes a space's whole pinned list, so what the run didn't
+  // make is moved out first: pins the user added to an imported space after
+  // the import. They go to the restored blank space if the run replaced
+  // one, else to the first space the run didn't make. The favorites list
+  // is profile-wide and untouched by DeleteSpace, so favorites need no
+  // move.
+  std::optional<base::Uuid> target_space;
+  if (!plan.target_space.empty()) {
+    target_space = base::Uuid::ParseLowercase(plan.target_space);
+  } else {
+    target_space = created;
+  }
+  if (target_space &&
+      (!target_space->is_valid() || !s.spaces->FindSpace(*target_space))) {
+    target_space.reset();
+  }
+  const std::string target_key =
+      target_space ? SidebarItems::PinnedListKey(*target_space)
+                   : std::string();
+  base::flat_set<std::string> run_ids;
+  for (ItemKind kind :
+       {ItemKind::kPinnedTab, ItemKind::kFolder, ItemKind::kFavorite}) {
+    for (const std::string& id : record.ItemsOfRun(run.id, kind)) {
+      run_ids.insert(id);
+    }
+  }
+
+  // Deleting a space closes its tabs into History, drops its stored tabs,
+  // and deletes its pinned list. Its tabs' space tags and session data go
+  // with the tabs, and windows showing it switch first, which rewrites the
+  // window's session space. A page that asks before closing keeps its
+  // space; DeleteSpace returns with the space still there.
+  std::vector<std::string> kept_spaces;
+  for (const std::string& id : run_spaces) {
+    const base::Uuid uuid = base::Uuid::ParseLowercase(id);
+    if (!uuid.is_valid() || !s.spaces->FindSpace(uuid)) {
+      result.removed.insert(id);
+      continue;
+    }
+    const std::string source_key = SidebarItems::PinnedListKey(uuid);
+    std::vector<ArcKeptPin> kept;
+    std::vector<std::string> copies;
+    base::flat_set<std::string> kept_item_ids;
+    if (target_space) {
+      kept = PlanKeptPins(PinEntries(s.items->GetList(source_key)), run_ids);
+      copies = MoveKeptPins(s.items, source_key, target_key, kept);
+      for (const ArcKeptPin& pin : kept) {
+        kept_item_ids.insert(pin.item_ids.begin(), pin.item_ids.end());
+      }
+      // The pins have moved, but their live tabs are still tagged with this
+      // space until the windows' sidebar sync runs, in a posted task, and
+      // DeleteSpace would close them with it. They move now, as they are.
+      s.windows->MoveItemTabsToSpace(uuid, *target_space, kept_item_ids);
+    }
+    s.windows->DeleteSpace(uuid);
+    if (!s.spaces->FindSpace(uuid)) {
+      result.removed.insert(id);
+    } else {
+      PutKeptPinsBack(s.items, source_key, target_key, kept, copies);
+      if (target_space) {
+        s.windows->MoveItemTabsToSpace(*target_space, uuid, kept_item_ids);
+      }
+      kept_spaces.push_back(source_key);
+      result.partial = true;
+    }
+    // A folder the run made, gone from here, whose copy holds the user's
+    // pins: the copy is that folder now, for the record and a later Undo.
+    for (size_t i = 0; i < kept.size(); ++i) {
+      const std::string& folder_id = kept[i].folder_id;
+      if (!folder_id.empty() && !copies[i].empty() &&
+          run_ids.contains(folder_id) &&
+          !s.items->GetList(source_key).FindFolder(folder_id) &&
+          s.items->GetList(target_key).FindFolder(copies[i])) {
+        result.moved_folders.emplace_back(folder_id, copies[i]);
+      }
+    }
+  }
+  // The new blank space isn't needed when an imported space stayed, unless
+  // it now holds pins moved out of one that went.
+  if (created && !kept_spaces.empty() &&
+      s.items->GetList(SidebarItems::PinnedListKey(*created))
+          .entries.empty()) {
+    s.windows->DeleteSpace(*created);
+  }
+
+  // Name the spaces that stayed the way the sidebar does: the space's name,
+  // or rac's "Space <position>" (1-based, switcher order) if it has none.
+  const std::vector<Space>& all_spaces = s.spaces->spaces();
+  for (size_t i = 0; i < all_spaces.size(); ++i) {
+    if (!std::ranges::contains(
+            kept_spaces, SidebarItems::PinnedListKey(all_spaces[i].id))) {
+      continue;
+    }
+    result.kept_space_names.push_back(
+        all_spaces[i].name.empty()
+            ? l10n_util::GetStringFUTF16(IDS_RAC_SPACE_FALLBACK_NAME,
+                                         base::NumberToString16(i + 1))
+            : base::UTF8ToUTF16(all_spaces[i].name));
+  }
+
+  // Everything in a space that stayed is left as it is.
+  base::flat_set<std::string> in_kept_spaces;
+  for (const std::string& key : kept_spaces) {
+    for (const ArcUndoPinEntry& entry : PinEntries(s.items->GetList(key))) {
+      in_kept_spaces.insert(entry.id);
+      in_kept_spaces.insert(entry.item_ids.begin(), entry.item_ids.end());
+    }
+  }
+
+  // One save and one notification for the item removals. The batch isn't
+  // held across DeleteSpace, which closes tabs.
+  SidebarItems::ScopedBatch batch(s.items);
+  // Pins the run added to spaces that stay, such as one an earlier import
+  // made, or that the user moved out of an imported space; and favorites.
+  // A tab that stops being an item closes if idle and stays if in use.
+  // RemoveItem does nothing for an item that's gone.
+  for (ItemKind kind : {ItemKind::kPinnedTab, ItemKind::kFavorite}) {
+    for (const std::string& id : record.ItemsOfRun(run.id, kind)) {
+      if (in_kept_spaces.contains(id)) {
+        continue;
+      }
+      s.items->RemoveItem(id);
+      result.removed.insert(id);
+    }
+  }
+  // A folder the run made goes when it's empty. One the user has since put
+  // their own pins in is theirs, and stays; its mapping stays too, so a
+  // later import doesn't make it a second time. Gathered after the item
+  // removals, which remove a folder they empty.
+  const FolderLists folders = GatherFolderLists(s);
+  for (const std::string& id : record.ItemsOfRun(run.id, ItemKind::kFolder)) {
+    if (in_kept_spaces.contains(id)) {
+      continue;
+    }
+    auto it = folders.find(id);
+    if (it == folders.end()) {
+      result.removed.insert(id);
+      continue;
+    }
+    if (s.items->GetList(it->second).FindFolder(id)->items.empty()) {
+      s.items->RemoveFolder(id);
+      result.removed.insert(id);
+    }
+  }
+  return result;
+}

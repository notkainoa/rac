+
+#ifndef CHROME_BROWSER_UI_RAC_STORAGE_DATA_RESTORER_H_
+#define CHROME_BROWSER_UI_RAC_STORAGE_DATA_RESTORER_H_
+
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/rac/storage/restore_plan.h"
+
+class Profile;
+
+namespace rac {
+
+// Puts a DataBackups backup back into a live profile. It writes only through
+// the services that own the data (SpacesService, SidebarItems, and the
+// SpacesWindowManager's store), because they keep the live copy and would
+// overwrite a pref changed behind their back. Only ever called because the
+// user asked: "Undo Arc import", or "Restore" in the restore prompt.
+//
+// Every restore runs in this order:
+//
+// 1. Take DataBackups::TryBeginOperation(). If an import, Undo, or restore
+//    is already running, fail with kBusy. The token is held to the end.
+// 2. Read the backup into memory. Nothing after this can lose it: not the
+//    snapshot cap, not expiry.
+// 3. If NeedsSafetySnapshot(), flush the spaces store and take a "restore"
+//    snapshot of the live data, so the restore can itself be undone. If that
+//    fails, stop with kSnapshotFailed. A merge into an empty sidebar skips
+//    this step, so a full disk can't block getting data back.
+// 4. MakeRestorePlan(), then apply it in one UI task, so windows never show
+//    a half-restored sidebar.
+// 5. Operation::MarkDataChanged(), so the daily backup is refreshed soon.
+//
+// Nothing changes on any failure, and the offer stays.
+class DataRestorer {
+ public:
+  using Mode = RestoreMode;
+
+  enum class Result {
+    kRestored,
+    // Another import, Undo, or restore is running. Nothing changed.
+    kBusy,
+    // The backup (and, for the offer, every fallback) expired or can't be
+    // read. Nothing changed.
+    kBackupMissing,
+    // The safety snapshot of the current data couldn't be written. Nothing
+    // changed.
+    kSnapshotFailed,
+    // The profile went away first. Nothing changed.
+    kProfileGone,
+  };
+  using Callback = base::OnceCallback<void(Result)>;
+
+  // For Undo: restores `backup_id` in kExact mode. `apply` pins its
+  // pre-import snapshot (DataBackups::PinSnapshot) for the Undo window, so
+  // the snapshot cap can't delete it first.
+  static void Restore(Profile* profile,
+                      std::string_view backup_id,
+                      Mode mode,
+                      Callback done);
+
+  // For the restore prompt: restores the pending offer in kMerge mode, read
+  // with DataBackups::ReadOfferedBackup(), which falls back to the next-best
+  // backup if the offered one is gone. Calls ResolveRestoreOffer() only on
+  // kRestored. On any failure the offer stays, and the prompt says why.
+  static void RestoreOffer(Profile* profile, Callback done);
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_STORAGE_DATA_RESTORER_H_

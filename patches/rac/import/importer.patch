+using ArcImportProgressCallback =
+    base::RepeatingCallback<void(const ArcImportProgress&)>;
+using ArcImportDoneCallback = base::OnceCallback<void(const ArcImportResult&)>;
+using ArcProfileDoneCallback =
+    base::OnceCallback<void(const ArcProfileResult&)>;
+
+// Puts an Arc ImportPlan into rac. In each target profile it:
+//
+// 1. Takes DataBackups' operation token, and holds it to the end.
+// 2. Reads the import record and maps the Arc profile against it and the live
+//    sidebar (MapArcProfile). If nothing is new, it stops there: no snapshot,
+//    no write.
+// 3. Flushes the spaces store and takes a pinned "import-arc" snapshot. No
+//    snapshot, no import.
+// 4. Writes spaces, pinned tabs, folders, and favorites through
+//    SpacesService, SidebarItems, and SpacesWindowManager, in one UI task, so
+//    no window shows half an import. Open tabs go into the spaces store,
+//    unloaded, except in a space a window shows.
+// 5. Saves the record. If that fails, takes the import back and reports
+//    kFailed, so a rerun can't add everything twice.
+// 6. Writes Arc's cached favicons to the favicon database, decoded in the
+//    data decoder's sandbox. Nothing is fetched.
+// 7. Runs Helium's importer for history only, if asked and not done before.
+// 8. Operation::MarkDataChanged(), and releases the token.
+//
+// Nothing here makes a network request, installs an extension, or touches
+// AI data. Profiles are imported one at a time.
+
+// For the sign-ins step, which owns profile creation. It makes
+// the rac profile for an Arc profile that isn't the default one. Until it's
+// registered, those Arc profiles end as ArcProfileResult::kNeedsProfile.
+class ArcProfileMaker {
+ public:
+  virtual ~ArcProfileMaker() = default;
+  // Runs `done` with the new profile, fully initialized, or null if it
+  // couldn't be made. `name` is ArcProfileName() for it.
+  virtual void MakeProfile(const ImportProfile& source,
+                           const std::u16string& name,
+                           base::OnceCallback<void(Profile*)> done) = 0;
+};
+// Called once at startup by the sign-ins step. Not owned.
+void SetArcProfileMaker(ArcProfileMaker* maker);
+
+// What every profile of one import shares.
+struct ArcImportRun {
+  ArcImportRun();
+  ArcImportRun(const ArcImportRun&);
+  ArcImportRun& operator=(const ArcImportRun&);
+  ~ArcImportRun();
+
+  // A new UUID per import, the same in every profile's record, so Undo
+  // finds every profile's part.
+  std::string id;
+  // Arc's support folder, for the history step: the folder the plan was
+  // read from (ArcSourcePaths::support_dir).
+  base::FilePath arc_support_dir;
+  ArcImportOptions options;
+  // Set only for the profile the import started from: hand-offs live in its
+  // record.
+  bool origin = false;
+  ImportHandoffs handoffs;
+  // Origin only: the other profiles this import wrote into, as profile
+  // folder base names, and the latest of their Undo deadlines, so the
+  // starting profile's record leads Undo to them.
+  std::vector<std::string> other_profiles;
+  base::Time others_undo_until;
+  // For progress across profiles: Arc spaces handled before this profile,
+  // and in all.
+  int spaces_before = 0;
+  int spaces_total = 0;
+};
+
+// The import screens' entry point. `profile` receives the default Arc
+// profile; the other checked ones go through ArcProfileMaker. `progress`
+// runs on the UI thread, in bursts; `done` runs once.
+void StartArcImport(Profile* profile,
+                    ImportPlan plan,
+                    ArcImportOptions options,
+                    ArcImportProgressCallback progress,
+                    ArcImportDoneCallback done);
+
+// The per-profile entry point, for the sign-ins step when it drives
+// profiles itself: imports `source` into `target`, which must be a regular
+// profile. StartArcImport() calls it too.
+void ImportArcProfileInto(Profile* target,
+                          ImportProfile source,
+                          ArcImportRun run,
+                          ArcImportProgressCallback progress,
+                          ArcProfileDoneCallback done);
+
+// When this profile last received an Arc import, and whether and until when
+// it can be undone. Reads the import record on a background sequence.
+void GetArcImportState(Profile* profile,
+                       base::OnceCallback<void(ArcImportState)> done);
+
+// "Undo Arc import": removes what the newest import added, in every profile
+// it touched, and puts back the blank space it replaced. It never deletes a
+// profile and leaves history, favicons, and cookies in place. The spaces
+// it removes close their tabs, which stay in History. Things the user made
+// since the import are kept; pins they added to an imported space move to
+// a space that stays.
+void UndoArcImport(Profile* profile,
+                   base::OnceCallback<void(ArcUndoResult)> done);
+
+// What the sidebar calls an imported space: its name, or rac's own
+// "Space <position>" (1-based, switcher order) if Arc had none.
+std::u16string ImportedSpaceTitle(const ImportSpace& space, size_t position);
+// "Work", "Your Arc profile", or "Arc profile 2". Never the folder name.
+std::u16string ArcProfileName(const ImportPlan& plan, size_t index);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_IMPORT_ARC_IMPORTER_H_

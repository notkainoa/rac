+
+std::vector<uint8_t> FromHex(const char* hex) {
+  std::vector<uint8_t> bytes;
+  // HexStringToBytes() rejects "", but the empty_blob vector is legitimately
+  // zero bytes.
+  if (std::string_view(hex).empty()) {
+    return bytes;
+  }
+  EXPECT_TRUE(base::HexStringToBytes(hex, &bytes)) << hex;
+  return bytes;
+}
+
+const CookieTestVector& VectorNamed(std::string_view name) {
+  for (const CookieTestVector& v : kCookieTestVectors) {
+    if (name == v.name) {
+      return v;
+    }
+  }
+  NOTREACHED() << name;
+}
+
+// A row where every column differs from CookieDbRow's defaults, so a column
+// that silently fails to load shows up as a mismatch.
+FixtureCookieRow FullRow() {
+  FixtureCookieRow row;
+  row.creation_utc = 13'380'000'000'000'001;
+  row.host_key = "example.com";
+  row.top_frame_site_key = "https://toplevel.example";
+  row.name = "session";
+  row.value = "";
+  row.encrypted_value = FromHex(VectorNamed("plain_v24").encrypted_hex);
+  row.path = "/account";
+  row.expires_utc = 13'390'000'000'000'002;
+  row.is_secure = true;
+  row.is_httponly = true;
+  row.last_access_utc = 13'380'000'000'000'003;
+  row.has_expires = true;
+  row.is_persistent = true;
+  row.priority = 2;
+  row.samesite = 1;
+  row.source_scheme = 2;
+  row.source_port = 443;
+  row.last_update_utc = 13'380'000'000'000'004;
+  row.source_type = 1;
+  row.has_cross_site_ancestor = true;
+  return row;
+}
+
+void ExpectSameRow(const FixtureCookieRow& want, const CookieDbRow& got) {
+  EXPECT_EQ(want.creation_utc, got.creation_utc);
+  EXPECT_EQ(want.host_key, got.host_key);
+  EXPECT_EQ(want.top_frame_site_key, got.top_frame_site_key);
+  EXPECT_EQ(want.name, got.name);
+  EXPECT_EQ(want.value, got.value);
+  EXPECT_EQ(want.encrypted_value, got.encrypted_value);
+  EXPECT_EQ(want.path, got.path);
+  EXPECT_EQ(want.expires_utc, got.expires_utc);
+  EXPECT_EQ(want.is_secure, got.is_secure);
+  EXPECT_EQ(want.is_httponly, got.is_httponly);
+  EXPECT_EQ(want.last_access_utc, got.last_access_utc);
+  EXPECT_EQ(want.has_expires, got.has_expires);
+  EXPECT_EQ(want.is_persistent, got.is_persistent);
+  EXPECT_EQ(want.priority, got.priority);
+  EXPECT_EQ(want.samesite, got.samesite);
+  EXPECT_EQ(want.source_scheme, got.source_scheme);
+  EXPECT_EQ(want.source_port, got.source_port);
+  EXPECT_EQ(want.last_update_utc, got.last_update_utc);
+  EXPECT_EQ(want.source_type, got.source_type);
+  EXPECT_EQ(want.has_cross_site_ancestor, got.has_cross_site_ancestor);
+}
+
+const CookieDbRow* RowNamed(const CookieDbSnapshot& snapshot,
+                            std::string_view name) {
+  for (const CookieDbRow& row : snapshot.rows) {
+    if (row.name == name) {
+      return &row;
+    }
+  }
+  return nullptr;
+}

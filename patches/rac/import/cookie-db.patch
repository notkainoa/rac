+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/cookie_fixture_db.h"
+
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/memory/ptr_util.h"
+#include "sql/meta_table.h"
+#include "sql/statement.h"
+#include "sql/test/test_helpers.h"
+#include "sql/transaction.h"
+
+namespace rac::import::test {
+
+namespace {
+
+// Copied from CreateV24Schema() in
+// net/extras/sqlite/sqlite_persistent_cookie_store.cc. CreateV23Schema() in
+// that file's unittest is byte-for-byte the same; v24 only changed what
+// encrypted_value holds.
+constexpr char kCreateTableSql[] =
+    "CREATE TABLE cookies("
+    "creation_utc INTEGER NOT NULL,"
+    "host_key TEXT NOT NULL,"
+    "top_frame_site_key TEXT NOT NULL,"
+    "name TEXT NOT NULL,"
+    "value TEXT NOT NULL,"
+    "encrypted_value BLOB NOT NULL,"
+    "path TEXT NOT NULL,"
+    "expires_utc INTEGER NOT NULL,"
+    "is_secure INTEGER NOT NULL,"
+    "is_httponly INTEGER NOT NULL,"
+    "last_access_utc INTEGER NOT NULL,"
+    "has_expires INTEGER NOT NULL,"
+    "is_persistent INTEGER NOT NULL,"
+    "priority INTEGER NOT NULL,"
+    "samesite INTEGER NOT NULL,"
+    "source_scheme INTEGER NOT NULL,"
+    "source_port INTEGER NOT NULL,"
+    "last_update_utc INTEGER NOT NULL,"
+    "source_type INTEGER NOT NULL,"
+    "has_cross_site_ancestor INTEGER NOT NULL);";
+
+constexpr char kCreateIndexSql[] =
+    "CREATE UNIQUE INDEX cookies_unique_index "
+    "ON cookies(host_key, top_frame_site_key, has_cross_site_ancestor, "
+    "name, path, source_scheme, source_port)";
+
+constexpr char kInsertSql[] =
+    "INSERT INTO cookies (creation_utc, host_key, top_frame_site_key, name, "
+    "value, encrypted_value, path, expires_utc, is_secure, is_httponly, "
+    "last_access_utc, has_expires, is_persistent, priority, samesite, "
+    "source_scheme, source_port, last_update_utc, source_type, "
+    "has_cross_site_ancestor) "
+    "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";
+
+}  // namespace
+
+FixtureCookieRow::FixtureCookieRow() = default;
+FixtureCookieRow::FixtureCookieRow(const FixtureCookieRow&) = default;
+FixtureCookieRow& FixtureCookieRow::operator=(const FixtureCookieRow&) =
+    default;
+FixtureCookieRow::~FixtureCookieRow() = default;
+
+// static
+std::unique_ptr<CookieFixtureDb> CookieFixtureDb::Create(
+    const base::FilePath& path,
+    const Options& options) {
+  if (options.meta_version != 23 && options.meta_version != 24) {
+    return nullptr;
+  }
+  if (base::PathExists(path)) {
+    return nullptr;
+  }
+
+  auto fixture = base::WrapUnique(new CookieFixtureDb(options.wal_mode));
+  sql::Database& db = fixture->db_;
+  if (!db.Open(path)) {
+    return nullptr;
+  }
+
+  // Chromium writes the same number for version and compatible version at
+  // both 23 and 24 (kCompatibleVersionNumber tracks kCurrentVersionNumber).
+  // MetaTable::Init() runs its own transaction; it is kept outside ours
+  // because sql::Database's nested transactions are deprecated.
+  sql::MetaTable meta_table;
+  if (!meta_table.Init(&db, options.meta_version, options.meta_version)) {
+    return nullptr;
+  }
+
+  sql::Transaction transaction(&db);
+  if (!transaction.Begin()) {
+    return nullptr;
+  }
+  if (!db.Execute(kCreateTableSql) || !db.Execute(kCreateIndexSql)) {
+    return nullptr;
+  }
+  if (!transaction.Commit()) {
+    return nullptr;
+  }
+  return fixture;
+}
+
+CookieFixtureDb::CookieFixtureDb(bool wal_mode)
+    : db_(sql::DatabaseOptions()
+              .set_wal_mode(wal_mode)
+              // Non-exclusive so WAL mode keeps a real -shm file on disk,
+              // like a live browser profile would.
+              .set_exclusive_locking(false),
+          sql::test::kTestTag) {}
+
+CookieFixtureDb::~CookieFixtureDb() = default;
+
+bool CookieFixtureDb::AddRow(const FixtureCookieRow& row) {
+  return AddRows(base::span_from_ref(row));
+}
+
+bool CookieFixtureDb::AddRows(base::span<const FixtureCookieRow> rows) {
+  sql::Transaction transaction(&db_);
+  if (!transaction.Begin()) {
+    return false;
+  }
+  sql::Statement s(db_.GetCachedStatement(SQL_FROM_HERE, kInsertSql));
+  if (!s.is_valid()) {
+    return false;
+  }
+  for (const FixtureCookieRow& row : rows) {
+    s.Reset(/*clear_bound_vars=*/true);
+    s.BindInt64(0, row.creation_utc);
+    s.BindString(1, row.host_key);
+    s.BindString(2, row.top_frame_site_key);
+    s.BindString(3, row.name);
+    s.BindString(4, row.value);
+    // BindBlob handles an empty span as a zero-length blob, not NULL, so the
+    // NOT NULL constraint holds.
+    s.BindBlob(5, base::span(row.encrypted_value));
+    s.BindString(6, row.path);
+    s.BindInt64(7, row.expires_utc);
+    s.BindBool(8, row.is_secure);
+    s.BindBool(9, row.is_httponly);
+    s.BindInt64(10, row.last_access_utc);
+    s.BindBool(11, row.has_expires);
+    s.BindBool(12, row.is_persistent);
+    s.BindInt(13, row.priority);
+    s.BindInt(14, row.samesite);
+    s.BindInt(15, row.source_scheme);
+    s.BindInt(16, row.source_port);
+    s.BindInt64(17, row.last_update_utc);
+    s.BindInt(18, row.source_type);
+    s.BindBool(19, row.has_cross_site_ancestor);
+    if (!s.Run()) {
+      return false;
+    }
+  }
+  return transaction.Commit();
+}
+
+void CookieFixtureDb::Close() {
+  db_.Close();
+}
+
+}  // namespace rac::import::test

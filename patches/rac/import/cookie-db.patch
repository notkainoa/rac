+
+#ifndef CHROME_BROWSER_RAC_IMPORT_COOKIE_FIXTURE_DB_H_
+#define CHROME_BROWSER_RAC_IMPORT_COOKIE_FIXTURE_DB_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "sql/database.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace rac::import::test {
+
+// Field values for one fixture row, written verbatim. Nothing is encrypted
+// here: put already-encrypted bytes (for example from
+// cookie_test_vectors.inc) in `encrypted_value`. *_utc fields are raw
+// microseconds since the Windows epoch, as Chromium stores them.
+struct FixtureCookieRow {
+  FixtureCookieRow();
+  FixtureCookieRow(const FixtureCookieRow&);
+  FixtureCookieRow& operator=(const FixtureCookieRow&);
+  ~FixtureCookieRow();
+
+  int64_t creation_utc = 13'370'000'000'000'000;
+  std::string host_key;
+  std::string top_frame_site_key;
+  std::string name;
+  std::string value;
+  std::vector<uint8_t> encrypted_value;
+  std::string path = "/";
+  int64_t expires_utc = 0;
+  bool is_secure = false;
+  bool is_httponly = false;
+  int64_t last_access_utc = 13'370'000'000'000'000;
+  bool has_expires = false;
+  bool is_persistent = true;
+  int priority = 1;       // DBCookiePriority::kMedium.
+  int samesite = -1;      // kCookieSameSiteUnspecified.
+  int source_scheme = 0;  // CookieSourceScheme::kUnset.
+  int source_port = -1;   // url::PORT_UNSPECIFIED.
+  int64_t last_update_utc = 13'370'000'000'000'000;
+  int source_type = 0;  // kDBCookieSourceTypeUnknown.
+  bool has_cross_site_ancestor = false;
+};
+
+// A Chromium-shaped cookies DB on disk: the `meta` table plus the `cookies`
+// table and `cookies_unique_index`, matching CreateV24Schema() in
+// net/extras/sqlite/sqlite_persistent_cookie_store.cc. Versions 23 and 24
+// share one schema; only the meaning of encrypted_value differs.
+//
+// The connection stays open until the object is destroyed or Close() is
+// called. With `wal_mode`, rows added after Create() stay in the -wal file
+// while it is open, which lets a test check that readers copy the -wal.
+class CookieFixtureDb {
+ public:
+  struct Options {
+    int meta_version = 24;  // 23 or 24.
+    bool wal_mode = false;
+  };
+
+  // Returns nullptr if `path` already exists, `meta_version` is not 23 or 24,
+  // or any SQL step fails.
+  static std::unique_ptr<CookieFixtureDb> Create(const base::FilePath& path,
+                                                 const Options& options);
+
+  CookieFixtureDb(const CookieFixtureDb&) = delete;
+  CookieFixtureDb& operator=(const CookieFixtureDb&) = delete;
+  ~CookieFixtureDb();
+
+  // Inserts the rows in one transaction. False on any failure, including a
+  // cookies_unique_index collision.
+  [[nodiscard]] bool AddRows(base::span<const FixtureCookieRow> rows);
+  [[nodiscard]] bool AddRow(const FixtureCookieRow& row);
+
+  void Close();
+
+ private:
+  explicit CookieFixtureDb(bool wal_mode);
+
+  sql::Database db_;
+};
+
+}  // namespace rac::import::test
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_COOKIE_FIXTURE_DB_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_COOKIE_DB_ROWS_H_
+#define CHROME_BROWSER_RAC_IMPORT_COOKIE_DB_ROWS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/types/expected.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace rac::import {
+
+// One row of a Chromium `cookies` table, as stored. Nothing is decoded:
+// `encrypted_value` is the opaque blob (normally "v10" + ciphertext), and the
+// *_utc fields are raw microseconds since the Windows epoch. Convert with
+// base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(x)).
+//
+// Columns that the source DB lacks keep the defaults below.
+struct CookieDbRow {
+  CookieDbRow();
+  CookieDbRow(const CookieDbRow&);
+  CookieDbRow(CookieDbRow&&);
+  CookieDbRow& operator=(const CookieDbRow&);
+  CookieDbRow& operator=(CookieDbRow&&);
+  ~CookieDbRow();
+
+  int64_t creation_utc = 0;
+  std::string host_key;
+  std::string top_frame_site_key;
+  std::string name;
+  std::string value;
+  std::vector<uint8_t> encrypted_value;
+  std::string path;
+  int64_t expires_utc = 0;
+  bool is_secure = false;
+  bool is_httponly = false;
+  int64_t last_access_utc = 0;
+  bool has_expires = false;
+  bool is_persistent = false;
+  int priority = 1;       // DBCookiePriority::kMedium.
+  int samesite = -1;      // DBCookieSameSite::kCookieSameSiteUnspecified.
+  int source_scheme = 0;  // CookieSourceScheme::kUnset.
+  int source_port = -1;   // url::PORT_UNSPECIFIED.
+  int64_t last_update_utc = 0;
+  int source_type = 0;  // kDBCookieSourceTypeUnknown.
+  bool has_cross_site_ancestor = false;
+};
+
+struct CookieDbSnapshot {
+  CookieDbSnapshot();
+  CookieDbSnapshot(CookieDbSnapshot&&);
+  CookieDbSnapshot& operator=(CookieDbSnapshot&&);
+  ~CookieDbSnapshot();
+
+  // meta.version of the source DB, or 0 if it has no meta table. The caller
+  // uses it to decide whether the decrypted value starts with
+  // SHA-256(host_key) (version >= 24).
+  int meta_version = 0;
+  std::vector<CookieDbRow> rows;
+  // True if the table had more rows than CookieDbReadLimits::max_rows. `rows`
+  // then holds the first max_rows in SQLite's order, and the rest were never
+  // read. The caller can still import those and say that some were left out.
+  bool rows_truncated = false;
+};
+
+// How much ReadCookieDbRows() takes from a source DB. A real cookie store is a
+// few MB with a few thousand rows, so anything far past these isn't one, and
+// copying or loading it would only cost disk and memory.
+struct CookieDbReadLimits {
+  // The largest DB file, and the largest -wal or -shm file, that is copied.
+  int64_t max_file_bytes = 256 * 1024 * 1024;
+  // Rows past this many are left unread, and the snapshot says so.
+  size_t max_rows = 100'000;
+};
+
+enum class CookieDbReadError {
+  kSourceMissing,
+  // The DB, its -wal, or its -shm is larger than
+  // CookieDbReadLimits::max_file_bytes. Nothing is read.
+  kSourceTooLarge,
+  kTempDirFailed,
+  kCopyFailed,
+  kOpenFailed,
+  kNoCookiesTable,
+  kMissingRequiredColumn,
+  kQueryFailed,
+};
+
+// Copies `cookies_db` and any `-wal` / `-shm` siblings into a fresh private
+// (0700) temp directory, opens the copy read-only, and returns its rows, up
+// to `limits`. The source files are only ever opened for reading, by the copy.
+// The temp directory is deleted before returning.
+//
+// Required columns: host_key, name, value, encrypted_value, path. Every other
+// column is optional and looked up by name.
+//
+// Blocking. Call on a sequence that allows blocking IO.
+base::expected<CookieDbSnapshot, CookieDbReadError> ReadCookieDbRows(
+    const base::FilePath& cookies_db,
+    const CookieDbReadLimits& limits = CookieDbReadLimits());
+
+}  // namespace rac::import
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_COOKIE_DB_ROWS_H_

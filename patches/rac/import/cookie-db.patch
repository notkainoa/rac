+
+#include "chrome/browser/rac/import/cookie_db_rows.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/to_vector.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/cstring_view.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/types/expected.h"
+#include "base/types/expected_macros.h"
+#include "sql/database.h"
+#include "sql/meta_table.h"
+#include "sql/statement.h"
+
+namespace rac::import {
+
+namespace {
+
+constexpr base::FilePath::CharType kCopyName[] = FILE_PATH_LITERAL("Cookies");
+constexpr const base::FilePath::CharType* kSidecarSuffixes[] = {
+    FILE_PATH_LITERAL("-wal"),
+    FILE_PATH_LITERAL("-shm"),
+};
+
+using ColumnReader = void (*)(sql::Statement&, int, CookieDbRow&);
+
+struct ColumnSpec {
+  base::cstring_view name;
+  bool required;
+  ColumnReader read;
+};
+
+// Every column we know about, looked up by name. Only columns the source DB
+// actually has go into the SELECT, so an older or newer schema still loads.
+// The names are compile-time constants; nothing from the DB is spliced into
+// SQL.
+constexpr ColumnSpec kColumns[] = {
+    {"creation_utc", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.creation_utc = s.ColumnInt64(i);
+     }},
+    {"host_key", true,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.host_key = s.ColumnString(i);
+     }},
+    {"top_frame_site_key", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.top_frame_site_key = s.ColumnString(i);
+     }},
+    {"name", true,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.name = s.ColumnString(i);
+     }},
+    {"value", true,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.value = s.ColumnString(i);
+     }},
+    {"encrypted_value", true,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       // Opaque bytes. May contain NULs; never treated as text.
+       r.encrypted_value = s.ColumnBlobAsVector(i);
+     }},
+    {"path", true,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.path = s.ColumnString(i);
+     }},
+    {"expires_utc", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.expires_utc = s.ColumnInt64(i);
+     }},
+    {"is_secure", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.is_secure = s.ColumnBool(i);
+     }},
+    {"is_httponly", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.is_httponly = s.ColumnBool(i);
+     }},
+    {"last_access_utc", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.last_access_utc = s.ColumnInt64(i);
+     }},
+    {"has_expires", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.has_expires = s.ColumnBool(i);
+     }},
+    {"is_persistent", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.is_persistent = s.ColumnBool(i);
+     }},
+    {"priority", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.priority = s.ColumnInt(i);
+     }},
+    {"samesite", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.samesite = s.ColumnInt(i);
+     }},
+    {"source_scheme", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.source_scheme = s.ColumnInt(i);
+     }},
+    {"source_port", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.source_port = s.ColumnInt(i);
+     }},
+    {"last_update_utc", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.last_update_utc = s.ColumnInt64(i);
+     }},
+    {"source_type", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.source_type = s.ColumnInt(i);
+     }},
+    {"has_cross_site_ancestor", false,
+     [](sql::Statement& s, int i, CookieDbRow& r) {
+       r.has_cross_site_ancestor = s.ColumnBool(i);
+     }},
+};
+
+base::FilePath WithSuffix(const base::FilePath& path,
+                          const base::FilePath::CharType* suffix) {
+  return base::FilePath(base::StrCat({path.value(), suffix}));
+}
+
+// Copies one file and narrows it to 0600. The directory is already 0700, so
+// this is belt and braces.
+bool CopyPrivate(const base::FilePath& from, const base::FilePath& to) {
+  return base::CopyFile(from, to) &&
+         base::SetPosixFilePermissions(to,
+                                       base::FILE_PERMISSION_READ_BY_USER |
+                                           base::FILE_PERMISSION_WRITE_BY_USER);
+}
+
+// Copies `from` like CopyPrivate(), unless it's larger than `max_bytes`. The
+// copy is measured too, in case the source grew while it was copied (for
+// example, while Arc is open).
+base::expected<void, CookieDbReadError> CopyPrivateCapped(
+    const base::FilePath& from,
+    const base::FilePath& to,
+    int64_t max_bytes) {
+  std::optional<int64_t> size = base::GetFileSize(from);
+  if (!size) {
+    return base::unexpected(CookieDbReadError::kCopyFailed);
+  }
+  if (*size > max_bytes) {
+    return base::unexpected(CookieDbReadError::kSourceTooLarge);
+  }
+  if (!CopyPrivate(from, to)) {
+    return base::unexpected(CookieDbReadError::kCopyFailed);
+  }
+  size = base::GetFileSize(to);
+  if (!size) {
+    return base::unexpected(CookieDbReadError::kCopyFailed);
+  }
+  if (*size > max_bytes) {
+    return base::unexpected(CookieDbReadError::kSourceTooLarge);
+  }
+  return base::ok();
+}
+
+bool MakePrivateDir(base::ScopedTempDir& dir) {
+  // CreateUniqueTempDir() uses mkdtemp(), which already creates 0700. Set and
+  // verify it anyway so a future base change can't widen it silently.
+  if (!dir.CreateUniqueTempDir() ||
+      !base::SetPosixFilePermissions(dir.GetPath(),
+                                     base::FILE_PERMISSION_USER_MASK)) {
+    return false;
+  }
+  int mode = 0;
+  return base::GetPosixFilePermissions(dir.GetPath(), &mode) &&
+         (mode & base::FILE_PERMISSION_MASK) == base::FILE_PERMISSION_USER_MASK;
+}
+
+int ReadMetaVersion(sql::Database& db) {
+  if (!sql::MetaTable::DoesTableExist(&db)) {
+    return 0;
+  }
+  // Not sql::MetaTable::Init(): it opens a write transaction and may create
+  // the table, which a read-only connection must not attempt.
+  sql::Statement s(
+      db.GetUniqueStatement("SELECT value FROM meta WHERE key='version'"));
+  return s.Step() ? s.ColumnInt(0) : 0;
+}
+
+}  // namespace
+
+CookieDbRow::CookieDbRow() = default;
+CookieDbRow::CookieDbRow(const CookieDbRow&) = default;
+CookieDbRow::CookieDbRow(CookieDbRow&&) = default;
+CookieDbRow& CookieDbRow::operator=(const CookieDbRow&) = default;
+CookieDbRow& CookieDbRow::operator=(CookieDbRow&&) = default;
+CookieDbRow::~CookieDbRow() = default;
+
+CookieDbSnapshot::CookieDbSnapshot() = default;
+CookieDbSnapshot::CookieDbSnapshot(CookieDbSnapshot&&) = default;
+CookieDbSnapshot& CookieDbSnapshot::operator=(CookieDbSnapshot&&) = default;
+CookieDbSnapshot::~CookieDbSnapshot() = default;
+
+base::expected<CookieDbSnapshot, CookieDbReadError> ReadCookieDbRows(
+    const base::FilePath& cookies_db,
+    const CookieDbReadLimits& limits) {
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+
+  if (!base::PathExists(cookies_db) || base::DirectoryExists(cookies_db)) {
+    return base::unexpected(CookieDbReadError::kSourceMissing);
+  }
+
+  // Declared before `db` so the connection closes before the directory is
+  // deleted.
+  base::ScopedTempDir temp_dir;
+  if (!MakePrivateDir(temp_dir)) {
+    return base::unexpected(CookieDbReadError::kTempDirFailed);
+  }
+
+  // The copy keeps one base name so SQLite finds "<name>-wal" next to it.
+  const base::FilePath copy = temp_dir.GetPath().Append(kCopyName);
+  RETURN_IF_ERROR(CopyPrivateCapped(cookies_db, copy, limits.max_file_bytes));
+  for (const base::FilePath::CharType* suffix : kSidecarSuffixes) {
+    const base::FilePath from = WithSuffix(cookies_db, suffix);
+    if (base::PathExists(from)) {
+      RETURN_IF_ERROR(CopyPrivateCapped(from, WithSuffix(copy, suffix),
+                                        limits.max_file_bytes));
+    }
+  }
+
+  // Read-only on the private copy. Exclusive locking is turned off on
+  // purpose: a read-only connection in EXCLUSIVE mode cannot replay a copied
+  // -wal (SQLite reports a disk I/O error), and Chromium's sql defaults to
+  // EXCLUSIVE.
+  //
+  // TODO(rac): "Cookie" reuses the cookie store's histogram tag. A dedicated
+  // tag means editing tools/metrics/histograms/metadata/sql/histograms.xml.
+  sql::Database db(
+      sql::DatabaseOptions().set_read_only(true).set_exclusive_locking(false),
+      "Cookie");
+  if (!db.Open(copy)) {
+    return base::unexpected(CookieDbReadError::kOpenFailed);
+  }
+  if (!db.DoesTableExist("cookies")) {
+    return base::unexpected(CookieDbReadError::kNoCookiesTable);
+  }
+
+  std::vector<const ColumnSpec*> present;
+  for (const ColumnSpec& column : kColumns) {
+    if (db.DoesColumnExist("cookies", column.name)) {
+      present.push_back(&column);
+    } else if (column.required) {
+      return base::unexpected(CookieDbReadError::kMissingRequiredColumn);
+    }
+  }
+
+  std::vector<std::string_view> names = base::ToVector(
+      present, [](const ColumnSpec* c) { return std::string_view(c->name); });
+  const std::string query =
+      base::StrCat({"SELECT ", base::JoinString(names, ", "), " FROM cookies"});
+
+  CookieDbSnapshot snapshot;
+  snapshot.meta_version = ReadMetaVersion(db);
+
+  sql::Statement s(db.GetUniqueStatement(query));
+  if (!s.is_valid()) {
+    return base::unexpected(CookieDbReadError::kQueryFailed);
+  }
+  while (s.Step()) {
+    if (snapshot.rows.size() >= limits.max_rows) {
+      snapshot.rows_truncated = true;
+      break;
+    }
+    CookieDbRow& row = snapshot.rows.emplace_back();
+    for (size_t i = 0; i < present.size(); ++i) {
+      present[i]->read(s, static_cast<int>(i), row);
+    }
+  }
+  if (!snapshot.rows_truncated && !s.Succeeded()) {
+    return base::unexpected(CookieDbReadError::kQueryFailed);
+  }
+
+  // `s` and then `db` close as they go out of scope, before `temp_dir` is
+  // deleted. Calling db.Close() here would trip its DCHECK that no statement
+  // is still open.
+  return snapshot;
+}
+
+}  // namespace rac::import

+  base::FilePath db_path_;
+};
+
+TEST_P(CookieDbRowsTest, RoundTripsEveryColumn) {
+  const int version = GetParam();
+  FixtureCookieRow full = FullRow();
+  FixtureCookieRow legacy;  // Pre-encryption style: plaintext, empty blob.
+  legacy.host_key = ".example.org";
+  legacy.name = "legacy";
+  legacy.value = "plain";
+  {
+    auto fixture = CookieFixtureDb::Create(db_path_, {.meta_version = version});
+    ASSERT_TRUE(fixture);
+    const std::vector<FixtureCookieRow> rows = {full, legacy};
+    ASSERT_TRUE(fixture->AddRows(rows));
+  }
+
+  auto result = ReadCookieDbRows(db_path_);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(version, result->meta_version);
+  ASSERT_EQ(2u, result->rows.size());
+  ASSERT_TRUE(RowNamed(*result, "session"));
+  ASSERT_TRUE(RowNamed(*result, "legacy"));
+  ExpectSameRow(full, *RowNamed(*result, "session"));
+  ExpectSameRow(legacy, *RowNamed(*result, "legacy"));
+}
+
+INSTANTIATE_TEST_SUITE_P(MetaVersions,
+                         CookieDbRowsTest,
+                         testing::Values(23, 24));
+
+class CookieDbRowsFileTest : public CookieDbRowsTest {};
+
+// Every test vector's blob, including ones with NUL bytes and the empty one,
+// comes back byte for byte.
+TEST_F(CookieDbRowsFileTest, KeepsEncryptedValueOpaque) {
+  std::vector<FixtureCookieRow> rows;
+  for (const CookieTestVector& v : kCookieTestVectors) {
+    FixtureCookieRow row;
+    row.host_key = v.host_key;
+    row.name = v.name;  // Unique, so the unique index never collides.
+    row.encrypted_value = FromHex(v.encrypted_hex);
+    rows.push_back(row);
+  }
+  {
+    auto fixture = CookieFixtureDb::Create(db_path_, {});
+    ASSERT_TRUE(fixture);
+    ASSERT_TRUE(fixture->AddRows(rows));
+  }
+
+  auto result = ReadCookieDbRows(db_path_);
+  ASSERT_TRUE(result.has_value());
+  ASSERT_EQ(rows.size(), result->rows.size());
+  for (const FixtureCookieRow& want : rows) {
+    SCOPED_TRACE(want.name);
+    const CookieDbRow* got = RowNamed(*result, want.name);
+    ASSERT_TRUE(got);
+    EXPECT_EQ(want.encrypted_value, got->encrypted_value);
+  }
+}
+
+TEST_F(CookieDbRowsFileTest, LeavesSourceUntouched) {
+  {
+    auto fixture = CookieFixtureDb::Create(db_path_, {});
+    ASSERT_TRUE(fixture);
+    ASSERT_TRUE(fixture->AddRow(FullRow()));
+  }
+  const base::FilePath before = temp_dir_.GetPath().AppendASCII("before");
+  ASSERT_TRUE(base::CopyFile(db_path_, before));
+  // The fixture's own TRUNCATE journal may leave an empty -journal behind, so
+  // compare existence before and after rather than asserting absence.
+  const base::FilePath journal(db_path_.value() +
+                               FILE_PATH_LITERAL("-journal"));
+  const base::FilePath wal(db_path_.value() + FILE_PATH_LITERAL("-wal"));
+  const base::FilePath shm(db_path_.value() + FILE_PATH_LITERAL("-shm"));
+  const bool had_journal = base::PathExists(journal);
+  base::File::Info info_before;
+  ASSERT_TRUE(base::GetFileInfo(db_path_, &info_before));
+
+  ASSERT_TRUE(ReadCookieDbRows(db_path_).has_value());
+
+  EXPECT_TRUE(base::ContentsEqual(before, db_path_));
+  base::File::Info info_after;
+  ASSERT_TRUE(base::GetFileInfo(db_path_, &info_after));
+  EXPECT_EQ(info_before.last_modified, info_after.last_modified);
+  EXPECT_EQ(had_journal, base::PathExists(journal));
+  EXPECT_FALSE(base::PathExists(wal));
+  EXPECT_FALSE(base::PathExists(shm));
+}
+
+// The writer stays open, so the table and row live only in -wal. Without
+// copying -wal the reader would see no cookies table at all.
+TEST_F(CookieDbRowsFileTest, ReadsRowsStillInWal) {
+  auto fixture = CookieFixtureDb::Create(db_path_, {.wal_mode = true});
+  ASSERT_TRUE(fixture);
+  ASSERT_TRUE(fixture->AddRow(FullRow()));
+  ASSERT_TRUE(base::PathExists(
+      base::FilePath(db_path_.value() + FILE_PATH_LITERAL("-wal"))));
+  ASSERT_TRUE(base::PathExists(
+      base::FilePath(db_path_.value() + FILE_PATH_LITERAL("-shm"))));
+
+  auto result = ReadCookieDbRows(db_path_);
+  ASSERT_TRUE(result.has_value());
+  ASSERT_EQ(1u, result->rows.size());
+  ExpectSameRow(FullRow(), result->rows[0]);
+}
+
+// Columns are found by name: a table with only the required columns, in a
+// different order, still loads and the rest keep their defaults.
+TEST_F(CookieDbRowsFileTest, LooksUpColumnsByName) {
+  {
+    sql::Database db(sql::test::kTestTag);
+    ASSERT_TRUE(db.Open(db_path_));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE cookies(path TEXT, encrypted_value BLOB, value TEXT, "
+        "name TEXT, host_key TEXT)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO cookies VALUES('/p', X'763130ff00', '', 'n', 'h.test')"));
+  }
+
+  auto result = ReadCookieDbRows(db_path_);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(0, result->meta_version);
+  ASSERT_EQ(1u, result->rows.size());
+  const CookieDbRow& row = result->rows[0];
+  EXPECT_EQ("h.test", row.host_key);
+  EXPECT_EQ("n", row.name);
+  EXPECT_EQ("/p", row.path);
+  EXPECT_EQ((std::vector<uint8_t>{'v', '1', '0', 0xff, 0x00}),
+            row.encrypted_value);
+  EXPECT_EQ(-1, row.source_port);
+  EXPECT_EQ(-1, row.samesite);
+}
+
+TEST_F(CookieDbRowsFileTest, MissingRequiredColumn) {
+  {
+    sql::Database db(sql::test::kTestTag);
+    ASSERT_TRUE(db.Open(db_path_));
+    ASSERT_TRUE(
+        db.Execute("CREATE TABLE cookies(host_key TEXT, name TEXT, value TEXT, "
+                   "path TEXT)"));
+  }
+  EXPECT_EQ(CookieDbReadError::kMissingRequiredColumn,
+            ReadCookieDbRows(db_path_).error());
+}
+
+TEST_F(CookieDbRowsFileTest, NoCookiesTable) {
+  {
+    sql::Database db(sql::test::kTestTag);
+    ASSERT_TRUE(db.Open(db_path_));
+    ASSERT_TRUE(db.Execute("CREATE TABLE other(x INTEGER)"));
+  }
+  EXPECT_EQ(CookieDbReadError::kNoCookiesTable,
+            ReadCookieDbRows(db_path_).error());
+}
+
+TEST_F(CookieDbRowsFileTest, MissingSource) {
+  EXPECT_EQ(CookieDbReadError::kSourceMissing,
+            ReadCookieDbRows(db_path_).error());
+}
+
+TEST_F(CookieDbRowsFileTest, NotADatabase) {
+  ASSERT_TRUE(base::WriteFile(db_path_, "this is not sqlite"));
+  auto result = ReadCookieDbRows(db_path_);
+  ASSERT_FALSE(result.has_value());
+  // Read-only open is lazy, so garbage may surface as either error.
+  EXPECT_TRUE(result.error() == CookieDbReadError::kOpenFailed ||
+              result.error() == CookieDbReadError::kNoCookiesTable);
+}
+
+std::vector<FixtureCookieRow> NumberedRows(int count) {
+  std::vector<FixtureCookieRow> rows;
+  for (int i = 0; i < count; ++i) {
+    FixtureCookieRow row;
+    row.host_key = "example.com";
+    row.name = "c" + base::NumberToString(i);  // Unique for the index.
+    row.value = "v";
+    rows.push_back(row);
+  }
+  return rows;
+}
+
+// Rows past the cap are left unread, and the snapshot says some were.
+TEST_F(CookieDbRowsFileTest, StopsAtRowCap) {
+  {
+    auto fixture = CookieFixtureDb::Create(db_path_, {});
+    ASSERT_TRUE(fixture);
+    ASSERT_TRUE(fixture->AddRows(NumberedRows(5)));
+  }
+
+  auto capped = ReadCookieDbRows(db_path_, {.max_rows = 3});
+  ASSERT_TRUE(capped.has_value());
+  EXPECT_EQ(3u, capped->rows.size());
+  EXPECT_TRUE(capped->rows_truncated);
+
+  // Exactly at the cap is not truncated.
+  auto exact = ReadCookieDbRows(db_path_, {.max_rows = 5});
+  ASSERT_TRUE(exact.has_value());
+  EXPECT_EQ(5u, exact->rows.size());
+  EXPECT_FALSE(exact->rows_truncated);
+
+  auto uncapped = ReadCookieDbRows(db_path_);
+  ASSERT_TRUE(uncapped.has_value());
+  EXPECT_EQ(5u, uncapped->rows.size());
+  EXPECT_FALSE(uncapped->rows_truncated);
+}
+
+TEST_F(CookieDbRowsFileTest, RefusesDbOverSizeCap) {
+  {
+    auto fixture = CookieFixtureDb::Create(db_path_, {});
+    ASSERT_TRUE(fixture);
+    ASSERT_TRUE(fixture->AddRow(FullRow()));
+  }
+  std::optional<int64_t> size = base::GetFileSize(db_path_);
+  ASSERT_TRUE(size);
+
+  EXPECT_EQ(CookieDbReadError::kSourceTooLarge,
+            ReadCookieDbRows(db_path_, {.max_file_bytes = *size - 1}).error());
+  auto at_cap = ReadCookieDbRows(db_path_, {.max_file_bytes = *size});
+  ASSERT_TRUE(at_cap.has_value());
+  EXPECT_EQ(1u, at_cap->rows.size());
+}
+
+// The -wal is capped on its own: a small DB with a large -wal is refused.
+TEST_F(CookieDbRowsFileTest, RefusesWalOverSizeCap) {
+  auto fixture = CookieFixtureDb::Create(db_path_, {.wal_mode = true});
+  ASSERT_TRUE(fixture);
+  ASSERT_TRUE(fixture->AddRows(NumberedRows(2000)));
+  const base::FilePath wal(db_path_.value() + FILE_PATH_LITERAL("-wal"));
+  const base::FilePath shm(db_path_.value() + FILE_PATH_LITERAL("-shm"));
+  std::optional<int64_t> db_size = base::GetFileSize(db_path_);
+  std::optional<int64_t> wal_size = base::GetFileSize(wal);
+  std::optional<int64_t> shm_size = base::GetFileSize(shm);
+  ASSERT_TRUE(db_size && wal_size && shm_size);
+  // Only the -wal is over the cap below.
+  ASSERT_LT(*db_size, *wal_size);
+  ASSERT_LT(*shm_size, *wal_size);
+
+  EXPECT_EQ(
+      CookieDbReadError::kSourceTooLarge,
+      ReadCookieDbRows(db_path_, {.max_file_bytes = *wal_size - 1}).error());
+}
+
+TEST_F(CookieDbRowsFileTest, FixtureRejectsUnsupportedVersion) {
+  EXPECT_FALSE(CookieFixtureDb::Create(db_path_, {.meta_version = 22}));
+  EXPECT_FALSE(base::PathExists(db_path_));
+}

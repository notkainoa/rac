+std::vector<ArcKeptPin> PlanKeptPins(
+    const std::vector<ArcUndoPinEntry>& entries,
+    const base::flat_set<std::string>& run_ids);
+
+// Which spaces Undo works with before it deletes a run's spaces.
+struct ArcUndoSpaces {
+  ArcUndoSpaces();
+  ArcUndoSpaces(const ArcUndoSpaces&);
+  ArcUndoSpaces& operator=(const ArcUndoSpaces&);
+  ~ArcUndoSpaces();
+
+  // Put back the blank space the run replaced, at the front. Not when it's
+  // already there: on a retry after a partial Undo the first try put it
+  // back, and it stays as the user has had it since, rather than being
+  // overwritten by the snapshot's copy.
+  bool restore_blank = false;
+  // Make a new space first: every space left is the run's, and deleting
+  // them all would leave none.
+  bool create_space = false;
+  // Where the user's own pins in a run space go: the blank space if the run
+  // replaced one, else the first space the run didn't make. Empty with
+  // `create_space`: the new space.
+  std::string target_space;
+};
+
+// `profile_spaces` are the profile's spaces in switcher order and
+// `run_spaces` the run's, as lowercase ids; `blank_space` is the run's
+// replaced blank space, or empty.
+ArcUndoSpaces PlanUndoSpaces(const std::vector<std::string>& profile_spaces,
+                             const std::vector<std::string>& run_spaces,
+                             const std::string& blank_space);
+

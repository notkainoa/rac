+bool IsHexColor(const std::string& text) {
+  if (text.size() != 7 || text[0] != '#') {
+    return false;
+  }
+  for (size_t i = 1; i < text.size(); ++i) {
+    const char c = text[i];
+    if (!((c >= '0' && c <= '9') || (c >= 'A' && c <= 'F'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// "tab:<id>" or "folder:<title>[<tab ids>]", so a pinned list reads as one
+// vector of strings. The path separator is " \xE2\x80\xBA " (U+203A).
+std::string Describe(const ArcApplyEntry& entry) {
+  if (const ArcApplyTab* tab = std::get_if<ArcApplyTab>(&entry)) {
+    return "tab:" + tab->source_id;
+  }
+  const ArcApplyFolder& folder = std::get<ArcApplyFolder>(entry);
+  std::string out = "folder:" + base::UTF16ToUTF8(folder.title) + "[";
+  for (size_t i = 0; i < folder.tabs.size(); ++i) {
+    if (i > 0) {
+      out += ",";
+    }
+    out += folder.tabs[i].source_id;
+  }
+  return out + "]";
+}
+
+std::vector<std::string> DescribeAll(const std::vector<ArcApplyEntry>& list) {
+  std::vector<std::string> out;
+  for (const ArcApplyEntry& entry : list) {
+    out.push_back(Describe(entry));
+  }
+  return out;
+}
+
+std::vector<std::string> Ids(const std::vector<ArcApplyTab>& tabs) {
+  std::vector<std::string> out;
+  for (const ArcApplyTab& tab : tabs) {
+    out.push_back(tab.source_id);
+  }
+  return out;
+}
+
+// Maps against an empty record and an empty profile.
+ArcApplyPlan MapFresh(const ImportProfile& profile,
+                      const ArcImportOptions& options = ArcImportOptions()) {
+  return MapArcProfile(profile, ArcImportRecord(), ArcLiveSidebar(), options);
+}
+
+// The pinned list of the plan's only space.
+std::vector<std::string> OnlyPinned(const ArcApplyPlan& plan) {
+  EXPECT_EQ(plan.spaces.size(), 1u);
+  if (plan.spaces.empty()) {
+    return {};
+  }
+  return DescribeAll(plan.spaces[0].pinned);
+}

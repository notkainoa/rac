+// A flat-color theme whose looks come from `content` only.
+ImportTheme FlatTheme(const ImportColor& color,
+                      ImportThemeVariant::Content content =
+                          ImportThemeVariant::Content::kUnknown) {
+  return SingleTheme(Variant(ImportThemeVariant::Origin::kSingleColor, color,
+                             std::nullopt, content));
+}

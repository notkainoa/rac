+// ---------------------------------------------------------------------------
+// Undo.
+
+ArcUndoPinEntry UndoItem(const std::string& id) {
+  ArcUndoPinEntry entry;
+  entry.id = id;
+  return entry;
+}
+
+ArcUndoPinEntry UndoFolder(const std::string& id,
+                           std::vector<std::string> item_ids) {
+  ArcUndoPinEntry entry;
+  entry.id = id;
+  entry.is_folder = true;
+  entry.item_ids = std::move(item_ids);
+  return entry;
+}
+
+// "item:<id>" or "folder:<id>[<item ids>]", like Describe() for the apply
+// plan.
+std::string DescribeKept(const ArcKeptPin& pin) {
+  if (pin.folder_id.empty()) {
+    return "item:" + pin.item_ids[0];
+  }
+  return "folder:" + pin.folder_id + "[" +
+         base::JoinString(pin.item_ids, ",") + "]";
+}
+
+std::vector<std::string> DescribeAllKept(const std::vector<ArcKeptPin>& pins) {
+  std::vector<std::string> out;
+  for (const ArcKeptPin& pin : pins) {
+    out.push_back(DescribeKept(pin));
+  }
+  return out;
+}

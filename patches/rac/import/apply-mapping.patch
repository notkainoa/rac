+TEST(ArcImportMappingTest, GamutMapEdgeCases) {
+  // In gamut: unchanged, alpha kept.
+  const ImportColor inside = C(0.2, 0.4, 0.6, 0.5);
+  EXPECT_EQ(GamutMapToSrgb(inside), inside);
+
+  // Lightness past either end: white or black.
+  EXPECT_EQ(GamutMapToSrgb(C(1.3, 1.3, 1.3)), C(1, 1, 1));
+  EXPECT_EQ(GamutMapToSrgb(C(-0.1, -0.1, -0.1)), C(0, 0, 0));
+  EXPECT_EQ(GamutMapToSrgb(C(-0.1, -0.1, -0.1, 0.25)), C(0, 0, 0, 0.25));
+
+  // A channel that isn't a number must not crash, and still gives a color.
+  const ImportColor nan_color =
+      GamutMapToSrgb(C(std::numeric_limits<double>::quiet_NaN(), 0.5, 0.5));
+  EXPECT_GE(nan_color.red, 0.0);
+  EXPECT_LE(nan_color.red, 1.0);
+  EXPECT_TRUE(IsHexColor(ToSrgbHex(nan_color)));
+  EXPECT_TRUE(IsHexColor(ToSrgbHex(
+      C(std::numeric_limits<double>::infinity(),
+        -std::numeric_limits<double>::infinity(),
+        std::numeric_limits<double>::quiet_NaN(),
+        std::numeric_limits<double>::quiet_NaN()))));
+}

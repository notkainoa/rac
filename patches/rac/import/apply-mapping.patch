+// static
+ArcImportRecord::ReadResult ArcImportRecord::Read(
+    const base::FilePath& profile_dir) {
+  const base::FilePath path = PathFor(profile_dir);
+  if (!base::PathExists(path)) {
+    return {};
+  }
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(path, &json, kMaxFileSize)) {
+    return {.status = ReadStatus::kUnreadable};
+  }
+  return Parse(json);
+}
+
+bool ArcImportRecord::Write(const base::FilePath& profile_dir) const {
+  const std::string json = Serialize();
+  if (json.empty()) {
+    return false;
+  }
+  const base::FilePath dir = DirFor(profile_dir);
+  if (!base::CreateDirectory(dir) ||
+      !base::SetPosixFilePermissions(dir, 0700)) {
+    return false;
+  }
+  return base::ImportantFileWriter::WriteFileAtomically(PathFor(profile_dir),
+                                                        json);
+}

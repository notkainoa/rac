+// ---------------------------------------------------------------------------
+// Planned ids.
+
+// Every rac id in `plan`, by kind: "space:<id>", "folder:<id>", "pin:<id>",
+// "favorite:<id>", and "open:<id>" for open tabs, in plan order.
+std::vector<std::string> DescribeIds(const ArcApplyPlan& plan) {
+  std::vector<std::string> out;
+  for (const ArcApplySpace& space : plan.spaces) {
+    if (space.is_new()) {
+      out.push_back("space:" + space.rac_id);
+    }
+    for (const ArcApplyEntry& entry : space.pinned) {
+      if (const auto* tab = std::get_if<ArcApplyTab>(&entry)) {
+        out.push_back("pin:" + tab->rac_id);
+        continue;
+      }
+      const ArcApplyFolder& folder = std::get<ArcApplyFolder>(entry);
+      if (folder.existing_id.empty()) {
+        out.push_back("folder:" + folder.rac_id);
+      }
+      for (const ArcApplyTab& tab : folder.tabs) {
+        out.push_back("pin:" + tab.rac_id);
+      }
+    }
+    for (const ArcApplyTab& tab : space.open_tabs) {
+      out.push_back("open:" + tab.rac_id);
+    }
+  }
+  for (const ArcApplyTab& favorite : plan.favorites) {
+    out.push_back("favorite:" + favorite.rac_id);
+  }
+  return out;
+}
+
+TEST(ArcImportMappingTest, AssignRacIdsMapsEverythingTheRecordKeeps) {
+  const ImportProfile profile = BigProfile();
+  ArcImportRecord record;
+  ArcApplyPlan plan =
+      MapArcProfile(profile, record, ArcLiveSidebar(), ArcImportOptions());
+  int next = 0;
+  AssignRacIds(plan, record, "run-1",
+               [&] { return "id-" + std::to_string(++next); });
+
+  // Spaces, folders, pins, and favorites get ids, in plan order; open tabs
+  // don't.
+  EXPECT_THAT(
+      DescribeIds(plan),
+      ElementsAre("space:id-1", "pin:id-2", "folder:id-3", "pin:id-4",
+                  "folder:id-5", "pin:id-6", "pin:id-7", "pin:id-8", "open:",
+                  "open:", "open:", "space:id-9", "pin:id-10", "folder:id-11",
+                  "open:", "favorite:id-12", "favorite:id-13"));
+
+  // The record maps each under the run, with its kind.
+  ASSERT_TRUE(record.FindSpace("S1"));
+  EXPECT_EQ(record.FindSpace("S1")->rac_id, "id-1");
+  EXPECT_EQ(record.FindSpace("S1")->run_id, "run-1");
+  ASSERT_TRUE(record.FindItem("P"));
+  EXPECT_EQ(record.FindItem("P")->rac_id, "id-3");
+  EXPECT_EQ(record.FindItem("P")->kind, ArcImportRecord::ItemKind::kFolder);
+  ASSERT_TRUE(record.FindItem("t1"));
+  EXPECT_EQ(record.FindItem("t1")->kind,
+            ArcImportRecord::ItemKind::kPinnedTab);
+  ASSERT_TRUE(record.FindItem("fav2"));
+  EXPECT_EQ(record.FindItem("fav2")->rac_id, "id-13");
+  EXPECT_EQ(record.FindItem("fav2")->kind,
+            ArcImportRecord::ItemKind::kFavorite);
+  EXPECT_FALSE(record.FindItem("o1"));
+  EXPECT_THAT(record.SpacesOfRun("run-1"), ElementsAre("id-1", "id-9"));
+  EXPECT_EQ(record.ItemsOfRun("run-1", ArcImportRecord::ItemKind::kPinnedTab)
+                .size(),
+            6u);
+  EXPECT_EQ(
+      record.ItemsOfRun("run-1", ArcImportRecord::ItemKind::kFolder).size(),
+      3u);
+}

+ArcUndoSpaces::ArcUndoSpaces() = default;
+ArcUndoSpaces::ArcUndoSpaces(const ArcUndoSpaces&) = default;
+ArcUndoSpaces& ArcUndoSpaces::operator=(const ArcUndoSpaces&) = default;
+ArcUndoSpaces::~ArcUndoSpaces() = default;
+
+ArcUndoSpaces PlanUndoSpaces(const std::vector<std::string>& profile_spaces,
+                             const std::vector<std::string>& run_spaces,
+                             const std::string& blank_space) {
+  ArcUndoSpaces plan;
+  std::vector<std::string> spaces = profile_spaces;
+  if (!blank_space.empty() && !std::ranges::contains(spaces, blank_space)) {
+    plan.restore_blank = true;
+    spaces.insert(spaces.begin(), blank_space);
+  }
+  plan.create_space =
+      std::ranges::all_of(spaces, [&](const std::string& space) {
+        return std::ranges::contains(run_spaces, space);
+      });
+  if (!blank_space.empty()) {
+    plan.target_space = blank_space;
+    return plan;
+  }
+  for (const std::string& space : spaces) {
+    if (!std::ranges::contains(run_spaces, space)) {
+      plan.target_space = space;
+      break;
+    }
+  }
+  return plan;
+}

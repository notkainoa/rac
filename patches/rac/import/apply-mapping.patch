+// Builders. ImportItem and ImportSpace have user-declared constructors, so
+// they are built by assignment, not aggregate initialization. The space
+// builder isn't called Space(): that would clash with rac::Space.
+
+ImportItem Tab(const std::string& id,
+               const std::string& url,
+               const std::string& title = std::string()) {
+  ImportItem item;
+  item.kind = ImportItem::Kind::kTab;
+  item.source_id = id;
+  item.url = url;
+  item.title = title;
+  return item;
+}
+
+ImportItem Folder(const std::string& id,
+                  const std::string& title,
+                  std::vector<ImportItem> children,
+                  ImportItem::Group group = ImportItem::Group::kNone) {
+  ImportItem item;
+  item.kind = ImportItem::Kind::kFolder;
+  item.source_id = id;
+  item.title = title;
+  item.group = group;
+  item.children = std::move(children);
+  return item;
+}
+
+ImportItem SplitView(const std::string& id, std::vector<ImportItem> children) {
+  return Folder(id, std::string(), std::move(children),
+                ImportItem::Group::kSplitView);
+}
+
+ImportItem TabGroup(const std::string& id, std::vector<ImportItem> children) {
+  return Folder(id, std::string(), std::move(children),
+                ImportItem::Group::kTabGroup);
+}
+
+ImportSpace MakeSpace(const std::string& id,
+                      const std::string& title,
+                      std::vector<ImportItem> pinned,
+                      std::vector<ImportItem> open_tabs = {}) {
+  ImportSpace space;
+  space.source_id = id;
+  space.title = title;
+  space.pinned = std::move(pinned);
+  space.open_tabs = std::move(open_tabs);
+  return space;
+}
+
+ImportProfile ProfileOf(std::vector<ImportSpace> spaces) {
+  ImportProfile profile;
+  profile.source_key = "default";
+  profile.is_default = true;
+  profile.spaces = std::move(spaces);
+  return profile;
+}
+
+ImportProfile ProfileOf(ImportSpace space) {
+  std::vector<ImportSpace> spaces;
+  spaces.push_back(std::move(space));
+  return ProfileOf(std::move(spaces));
+}
+
+ImportColor C(double r, double g, double b, double a = 1) {
+  ImportColor color;
+  color.red = r;
+  color.green = g;
+  color.blue = b;
+  color.alpha = a;
+  return color;
+}

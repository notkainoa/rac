+ImportThemeVariant Variant(
+    ImportThemeVariant::Origin origin,
+    std::optional<ImportColor> color1,
+    std::optional<ImportColor> color2 = std::nullopt,
+    ImportThemeVariant::Content content =
+        ImportThemeVariant::Content::kUnknown) {

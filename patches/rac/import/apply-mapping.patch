+// Simulates the applier: writes `plan` into the fake live sidebar and
+// records what it made, the way ArcImporter does. Open tabs aren't recorded.
+void FakeApply(const ArcApplyPlan& plan,
+               const std::string& run_id,
+               ArcImportRecord& record,
+               ArcLiveSidebar& live) {
+  int next = 0;
+  auto new_id = [&](const char* kind) {
+    return run_id + "-" + kind + "-" + std::to_string(++next);
+  };
+  auto add_tab = [&](const ArcApplyTab& tab, ArcImportRecord::ItemKind kind) {
+    const std::string id = new_id("item");
+    record.MapItem(tab.source_id, id, kind, run_id);
+    live.sidebar_ids.insert(id);
+    if (kind == ArcImportRecord::ItemKind::kFavorite) {
+      live.favorite_urls.insert(tab.url.spec());
+    }
+  };
+
+  for (const ArcApplySpace& space : plan.spaces) {
+    if (space.is_new()) {
+      const std::string id = new_id("space");
+      record.MapSpace(space.source_id, id, run_id);
+      live.space_ids.insert(id);
+    }
+    for (const ArcApplyEntry& entry : space.pinned) {
+      if (const ArcApplyTab* tab = std::get_if<ArcApplyTab>(&entry)) {
+        add_tab(*tab, ArcImportRecord::ItemKind::kPinnedTab);
+        continue;
+      }
+      const ArcApplyFolder& folder = std::get<ArcApplyFolder>(entry);
+      if (folder.existing_id.empty()) {
+        const std::string id = new_id("folder");
+        record.MapItem(folder.source_id, id, ArcImportRecord::ItemKind::kFolder,
+                       run_id);
+        live.sidebar_ids.insert(id);
+      }
+      for (const ArcApplyTab& tab : folder.tabs) {
+        add_tab(tab, ArcImportRecord::ItemKind::kPinnedTab);
+      }
+    }
+  }
+  for (const ArcApplyTab& favorite : plan.favorites) {
+    add_tab(favorite, ArcImportRecord::ItemKind::kFavorite);
+  }
+  if (!plan.replace_blank_space.empty()) {
+    live.blank_space_id.clear();
+  }
+}

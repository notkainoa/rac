+  ~ArcApplyTab();
+
+  // ImportItem::source_id.
+  std::string source_id;
+  GURL url;
+  // The page's own title (SidebarItem::title).
+  std::u16string page_title;
+  // The name the user gave it in Arc (SidebarItem::name). Empty: show the
+  // page title.
+  std::u16string name;
+  // Arc's cached favicon file. Empty if none. Not read yet.
+  base::FilePath favicon_path;
+  base::Time created;
+  // The SidebarItem id the applier gives a pin or favorite (AssignRacIds()).
+  // Empty for open tabs, which the record doesn't map.
+  std::string rac_id;
+};
+
+// A rac folder to make, or one an earlier import made, with tabs to add.
+struct ArcApplyFolder {

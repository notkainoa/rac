+// Undo where a page kept one of the run's spaces open: that space and the
+// pins in it aren't removed, so they aren't forgotten. The run stays the
+// one Undo takes out, and a second Undo finishes it.
+TEST(ArcImportRecordTest, SpaceAPageKeptLeavesTheRunUndoable) {
+  ArcImportRecord record;
+  ImportRun run = MakeRun("run-R", 1000);
+  run.undo_until = At(9000);
+  record.AddRun(run);
+  record.MapSpace("s1", "sp1", "run-R");
+  record.MapSpace("s2", "sp2", "run-R");
+  record.MapItem("i1", "pin1", ItemKind::kPinnedTab, "run-R");
+  record.MapItem("i2", "pin2", ItemKind::kPinnedTab, "run-R");
+  record.MapItem("i3", "folder3", ItemKind::kFolder, "run-R");
+  record.MapItem("i4", "fav4", ItemKind::kFavorite, "run-R");
+
+  // sp2 stayed, with pin2 and folder3 in it. sp1, pin1, and the favorite
+  // went.
+  record.ForgetRemoved("run-R", {"sp1", "pin1", "fav4"}, At(5000));
+
+  ASSERT_TRUE(record.UndoableRun(At(5001)));
+  EXPECT_EQ(record.UndoableRun(At(5001))->id, "run-R");
+  EXPECT_FALSE(record.FindRun("run-R")->undone);
+  EXPECT_THAT(record.SpacesOfRun("run-R"), ElementsAre("sp2"));
+  EXPECT_THAT(record.ItemsOfRun("run-R", ItemKind::kPinnedTab),
+              ElementsAre("pin2"));
+  EXPECT_THAT(record.ItemsOfRun("run-R", ItemKind::kFolder),
+              ElementsAre("folder3"));
+  EXPECT_THAT(record.ItemsOfRun("run-R", ItemKind::kFavorite), IsEmpty());
+  // A rerun sees the kept space as imported, and the removed ones as new.
+  EXPECT_TRUE(record.FindSpace("s2"));
+  EXPECT_FALSE(record.FindSpace("s1"));
+  EXPECT_EQ(record.StateAt(At(5001)).status,
+            ArcImportState::Status::kUndoable);
+
+  // The page let go: the second Undo takes out the rest.
+  record.ForgetRemoved("run-R", {"sp2", "pin2", "folder3"}, At(6000));
+  EXPECT_TRUE(record.FindRun("run-R")->undone);
+  EXPECT_EQ(record.FindRun("run-R")->undone_at, At(6000));
+  EXPECT_FALSE(record.has_mappings());
+  const ArcImportState state = record.StateAt(At(6001));
+  EXPECT_EQ(state.status, ArcImportState::Status::kUndone);
+  EXPECT_EQ(state.undone_at, At(6000));
+}

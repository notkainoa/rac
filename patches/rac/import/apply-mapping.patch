+ArcApplyPlan MapArcProfile(const ImportProfile& profile,
+                           const ArcImportRecord& record,
+                           const ArcLiveSidebar& live,
+                           const ArcImportOptions& options) {
+  ArcApplyPlan plan;
+  ArcImportCounts& counts = plan.counts;
+  plan.record_was_stale = record.IsStale(live.space_ids, live.sidebar_ids);
+  const ArcImportRecord* mapped = plan.record_was_stale ? nullptr : &record;
+
+  for (const ImportSpace& space : profile.spaces) {
+    ArcApplySpace out;
+    out.source_id = space.source_id;
+    const ArcImportRecord::SpaceMapping* mapping =
+        mapped ? mapped->FindSpace(space.source_id) : nullptr;
+
+    if (mapping && !live.space_ids.contains(mapping->rac_id)) {
+      // The user deleted the space an earlier import made. Respect that:
+      // what Arc has added to it since stays out.
+      counts.removed_since += static_cast<int>(CountTabs(space.pinned, mapped));
+      continue;
+    }
+
+    if (mapping) {
+      out.existing_id = mapping->rac_id;
+      ++counts.already_imported;
+      if (options.open_tabs) {
+        counts.open_tabs_not_reopened +=
+            static_cast<int>(CountTabs(space.open_tabs));
+      }
+    } else {
+      out.name = ImportedSpaceName(space);
+      out.icon = ImportedSpaceIcon(space);
+      out.theme = MaybeToSpaceTheme(space.theme);
+      ++counts.spaces;
+    }
+
+    PinnedMapper(mapped, live, counts, out.pinned).MapTopLevel(space.pinned);
+
+    if (out.is_new() && options.open_tabs) {
+      FlattenTabs(space.open_tabs, mapped, counts, out.open_tabs);
+      counts.open_tabs += static_cast<int>(out.open_tabs.size());
+    }
+
+    if (out.is_new() || !out.pinned.empty()) {
+      plan.spaces.push_back(std::move(out));
+    }
+  }
+
+  std::vector<ArcApplyTab> favorites;
+  FlattenTabs(profile.favorites, mapped, counts, favorites);
+  base::flat_set<std::string> seen = live.favorite_urls;
+  for (ArcApplyTab& favorite : favorites) {
+    if (!seen.insert(favorite.url.spec()).second) {
+      ++counts.favorites_already_there;
+      continue;
+    }
+    plan.favorites.push_back(std::move(favorite));
+  }
+  counts.favorites = static_cast<int>(plan.favorites.size());
+
+  if (counts.spaces > 0) {
+    plan.replace_blank_space = live.blank_space_id;
+  }
+  return plan;
+}
+
+void AssignRacIds(ArcApplyPlan& plan,
+                  ArcImportRecord& record,
+                  const std::string& run_id,
+                  base::FunctionRef<std::string()> new_id) {
+  using Kind = ArcImportRecord::ItemKind;
+  auto map_tab = [&](ArcApplyTab& tab, Kind kind) {
+    tab.rac_id = new_id();
+    record.MapItem(tab.source_id, tab.rac_id, kind, run_id);
+  };
+  for (ArcApplySpace& space : plan.spaces) {
+    if (space.is_new()) {
+      space.rac_id = new_id();
+      record.MapSpace(space.source_id, space.rac_id, run_id);
+    }
+    for (ArcApplyEntry& entry : space.pinned) {
+      if (auto* tab = std::get_if<ArcApplyTab>(&entry)) {
+        map_tab(*tab, Kind::kPinnedTab);
+        continue;
+      }
+      ArcApplyFolder& folder = std::get<ArcApplyFolder>(entry);
+      if (folder.existing_id.empty()) {
+        folder.rac_id = new_id();
+        record.MapItem(folder.source_id, folder.rac_id, Kind::kFolder, run_id);
+      }
+      for (ArcApplyTab& tab : folder.tabs) {
+        map_tab(tab, Kind::kPinnedTab);
+      }
+    }
+  }
+  for (ArcApplyTab& favorite : plan.favorites) {
+    map_tab(favorite, Kind::kFavorite);
+  }
+}
+
+void TakePlannedRacIds(ArcApplyPlan& plan,
+                       const ArcImportRecord& record,
+                       std::string_view run_id) {
+  using Kind = ArcImportRecord::ItemKind;
+  auto planned = [&](const std::string& arc_id, Kind kind) {
+    const ArcImportRecord::ItemMapping* mapping = record.FindItem(arc_id);
+    return mapping && mapping->run_id == run_id && mapping->kind == kind
+               ? mapping->rac_id
+               : std::string();
+  };
+  auto drop_tab = [&](ArcApplyTab& tab, Kind kind) {
+    tab.rac_id = planned(tab.source_id, kind);
+    return tab.rac_id.empty();
+  };
+  std::erase_if(plan.spaces, [&](ArcApplySpace& space) {
+    if (space.is_new()) {
+      const ArcImportRecord::SpaceMapping* mapping =
+          record.FindSpace(space.source_id);
+      if (!mapping || mapping->run_id != run_id) {
+        return true;
+      }
+      space.rac_id = mapping->rac_id;
+    }
+    std::erase_if(space.pinned, [&](ArcApplyEntry& entry) {
+      if (auto* tab = std::get_if<ArcApplyTab>(&entry)) {
+        return drop_tab(*tab, Kind::kPinnedTab);
+      }
+      ArcApplyFolder& folder = std::get<ArcApplyFolder>(entry);
+      if (folder.existing_id.empty()) {
+        folder.rac_id = planned(folder.source_id, Kind::kFolder);
+        if (folder.rac_id.empty()) {
+          return true;
+        }
+      }
+      std::erase_if(folder.tabs, [&](ArcApplyTab& tab) {
+        return drop_tab(tab, Kind::kPinnedTab);
+      });
+      // A folder an earlier import made with nothing left to add.
+      return !folder.existing_id.empty() && folder.tabs.empty();
+    });
+    // A space an earlier import made with nothing left to add.
+    return !space.is_new() && space.pinned.empty();
+  });
+  std::erase_if(plan.favorites, [&](ArcApplyTab& favorite) {
+    return drop_tab(favorite, Kind::kFavorite);
+  });
+
+  ArcImportCounts& counts = plan.counts;
+  counts.spaces = 0;
+  counts.folders = 0;
+  counts.pinned_tabs = 0;
+  counts.open_tabs = 0;
+  counts.favorites = static_cast<int>(plan.favorites.size());
+  for (const ArcApplySpace& space : plan.spaces) {
+    counts.spaces += space.is_new() ? 1 : 0;
+    counts.open_tabs += static_cast<int>(space.open_tabs.size());
+    for (const ArcApplyEntry& entry : space.pinned) {
+      if (const auto* folder = std::get_if<ArcApplyFolder>(&entry)) {
+        counts.folders += folder->existing_id.empty() ? 1 : 0;
+        counts.pinned_tabs += static_cast<int>(folder->tabs.size());
+      } else {
+        ++counts.pinned_tabs;
+      }
+    }
+  }
+  if (counts.spaces == 0) {
+    plan.replace_blank_space.clear();
+  }
+}
+
+std::optional<SpaceTheme> MaybeToSpaceTheme(const ImportTheme& theme) {
+  const ImportThemeVariant* primary = nullptr;
+  const ImportThemeVariant* dark = nullptr;
+  switch (theme.kind) {
+    case ImportTheme::Kind::kNone:
+      return std::nullopt;
+    case ImportTheme::Kind::kSingle:
+      if (IsUsable(theme.single)) {
+        primary = &*theme.single;
+      }
+      break;
+    case ImportTheme::Kind::kAppearanceBased:
+      if (IsUsable(theme.light) && IsUsable(theme.dark)) {
+        primary = &*theme.light;
+        dark = &*theme.dark;
+      } else if (IsUsable(theme.light)) {
+        primary = &*theme.light;
+      } else if (IsUsable(theme.dark)) {
+        primary = &*theme.dark;
+      }
+      break;
+  }
+  if (!primary) {
+    return std::nullopt;
+  }
+
+  auto [first, second] = *VariantStops(*primary);
+  first = GamutMapToSrgb(first);
+  second = GamutMapToSrgb(second);
+  SpaceTheme out;
+  out.color1 = ToSrgbHex(first);
+  out.color2 = ToSrgbHex(second);
+  if (dark) {
+    // Arc follows macOS between the two looks, and so does Auto.
+    out.mode = SpaceTheme::Mode::kAuto;
+    const auto [dark1, dark2] = *VariantStops(*dark);
+    out.unknown_fields.Set(kDarkStop1Key, ToSrgbHex(GamutMapToSrgb(dark1)));
+    out.unknown_fields.Set(kDarkStop2Key, ToSrgbHex(GamutMapToSrgb(dark2)));
+  } else {
+    out.mode = ModeFor(*primary, first, second);
+  }
+  return out;
+}
+
+SpaceTheme ToSpaceTheme(const ImportTheme& theme) {
+  std::optional<SpaceTheme> mapped = MaybeToSpaceTheme(theme);
+  return mapped ? std::move(*mapped) : SpaceTheme();
+}
+
+ImportColor GamutMapToSrgb(const ImportColor& color) {
+  const double alpha = std::clamp(Finite(color.alpha), 0.0, 1.0);
+  const Rgb encoded{Finite(color.red), Finite(color.green), Finite(color.blue)};
+  if (InUnitRange(encoded.r) && InUnitRange(encoded.g) &&
+      InUnitRange(encoded.b)) {
+    return {std::clamp(encoded.r, 0.0, 1.0), std::clamp(encoded.g, 0.0, 1.0),
+            std::clamp(encoded.b, 0.0, 1.0), alpha};
+  }
+  const Rgb linear{SrgbToLinear(encoded.r), SrgbToLinear(encoded.g),
+                   SrgbToLinear(encoded.b)};
+  const Oklab lab = LinearSrgbToOklab(linear);
+  if (!std::isfinite(lab.l) || lab.l <= 0) {
+    return {0, 0, 0, alpha};
+  }
+  if (lab.l >= 1) {
+    return {1, 1, 1, alpha};
+  }
+  const double chroma = std::hypot(lab.a, lab.b);
+  const double hue = std::atan2(lab.b, lab.a);
+  // Binary search for the largest chroma, at this lightness and hue, that's
+  // inside sRGB. Chroma zero is gray, which always is.
+  double low = 0;
+  double high = chroma;
+  for (int i = 0; i < 32; ++i) {
+    const double mid = (low + high) / 2;
+    if (InGamut(OklabToLinearSrgb(
+            {lab.l, mid * std::cos(hue), mid * std::sin(hue)}))) {
+      low = mid;
+    } else {
+      high = mid;
+    }
+  }
+  return FromLinear(
+      OklabToLinearSrgb({lab.l, low * std::cos(hue), low * std::sin(hue)}),
+      alpha);
+}
+
+std::string ToSrgbHex(const ImportColor& color) {
+  auto channel = [](double value) {
+    return static_cast<int>(
+        std::lround(std::clamp(Finite(value), 0.0, 1.0) * 255));
+  };
+  return base::StringPrintf("#%02X%02X%02X", channel(color.red),
+                            channel(color.green), channel(color.blue));
+}
+
+double RelativeLuminance(const ImportColor& color) {
+  auto linear = [](double value) {
+    return SrgbToLinear(std::clamp(Finite(value), 0.0, 1.0));
+  };
+  return 0.2126 * linear(color.red) + 0.7152 * linear(color.green) +
+         0.0722 * linear(color.blue);
+}
+
+std::string ImportedSpaceName(const ImportSpace& space) {
+  const std::string name = base::CollapseWhitespaceASCII(
+      space.title, /*trim_sequences_with_line_breaks=*/false);
+  return std::string(base::TruncateUTF8ToByteSize(name, kMaxSpaceNameBytes));
+}
+
+std::string ImportedSpaceIcon(const ImportSpace& space) {
+  const std::string_view icon =
+      base::TrimWhitespaceASCII(space.emoji, base::TRIM_ALL);
+  if (icon.empty() || icon.size() > 32 || !base::IsStringUTF8(icon)) {
+    return std::string();
+  }
+  return std::string(icon);
+}
+
+ArcProfileLabel ArcProfileLabelFor(const ImportPlan& plan, size_t index) {
+  CHECK_LT(index, plan.profiles.size());
+  const ImportProfile& profile = plan.profiles[index];
+  std::string name = base::CollapseWhitespaceASCII(
+      profile.display_name, /*trim_sequences_with_line_breaks=*/false);
+  // A name equal to the folder name is Chromium's, not the user's.
+  if (!name.empty() && name != profile.directory) {
+    return {.name = std::move(name)};
+  }
+  if (profile.is_default) {
+    return {.fallback = ArcProfileLabel::Fallback::kDefault};
+  }
+  int number = 1;
+  for (size_t i = 0; i <= index; ++i) {
+    if (!plan.profiles[i].is_default) {
+      ++number;
+    }
+  }
+  return {.fallback = ArcProfileLabel::Fallback::kNumbered, .number = number};
+}
+
+std::string JoinFolderPath(const std::vector<std::string>& titles) {
+  std::vector<std::string> parts;
+  for (const std::string& title : titles) {
+    std::string part = base::CollapseWhitespaceASCII(
+        title, /*trim_sequences_with_line_breaks=*/false);
+    if (!part.empty()) {
+      parts.push_back(std::move(part));
+    }
+  }
+  return base::JoinString(parts, kFolderPathSeparator);
+}
+
+bool IsImportableUrl(const GURL& url) {
+  return url.is_valid() && (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile() ||
+                            url.IsAboutBlank());
+}

+TEST(ArcImportRecordTest, StateAtNamesWhatUndoWouldDo) {
+  // No record, or a record with no runs: never imported.
+  {
+    ArcImportRecord record;
+    const ArcImportState state = record.StateAt(At(1000));
+    EXPECT_EQ(state.status, ArcImportState::Status::kNone);
+    EXPECT_FALSE(state.last_import);
+    EXPECT_FALSE(state.undo_until);
+    EXPECT_FALSE(state.undo_snapshot_time);
+    EXPECT_TRUE(state.undone_at.is_null());
+  }
+  ImportRun run = MakeRun("run", 1000);
+  run.undo_until = At(2000);
+  // In its deadline: undoable.
+  {
+    ArcImportRecord record;
+    record.last_import = At(1000);
+    record.AddRun(run);
+    const ArcImportState state = record.StateAt(At(1999));
+    EXPECT_EQ(state.status, ArcImportState::Status::kUndoable);
+    EXPECT_EQ(state.last_import, At(1000));
+    EXPECT_EQ(state.undo_until, At(2000));
+    EXPECT_EQ(state.undo_snapshot_time, At(1001));
+    EXPECT_TRUE(state.undone_at.is_null());
+  }
+  // Past it, or without one: expired, with no Undo times.
+  for (base::Time until : {At(2000), base::Time()}) {
+    ImportRun expiring = run;
+    expiring.undo_until = until;
+    ArcImportRecord record;
+    record.last_import = At(1000);
+    record.AddRun(expiring);
+    const ArcImportState state = record.StateAt(At(2000));
+    EXPECT_EQ(state.status, ArcImportState::Status::kExpired);
+    EXPECT_EQ(state.last_import, At(1000));
+    EXPECT_FALSE(state.undo_until);
+    EXPECT_FALSE(state.undo_snapshot_time);
+  }
+  // Undone, even once its deadline is past: undone, not expired.
+  {
+    ImportRun undone = run;
+    undone.undone = true;
+    undone.undone_at = At(1500);
+    ArcImportRecord record;
+    record.AddRun(undone);
+    for (base::Time now : {At(1600), At(5000)}) {
+      const ArcImportState state = record.StateAt(now);
+      EXPECT_EQ(state.status, ArcImportState::Status::kUndone);
+      EXPECT_EQ(state.undone_at, At(1500));
+      EXPECT_FALSE(state.undo_until);
+    }
+  }
+  // An interrupted run is the newest import: undoable.
+  {
+    ImportRun interrupted = run;
+    interrupted.in_progress = true;
+    ArcImportRecord record;
+    record.AddRun(interrupted);
+    EXPECT_EQ(record.StateAt(At(1500)).status,
+              ArcImportState::Status::kUndoable);
+  }
+}

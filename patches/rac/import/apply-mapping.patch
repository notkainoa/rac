+  EXPECT_TRUE(record.FindSpace("e1"));
+  ASSERT_TRUE(record.UndoableRun(At(2500)));
+  EXPECT_EQ(record.UndoableRun(At(2500))->id, "cut");
+
+  // Settled once: a second call has nothing to do.
+  EXPECT_EQ(record.FinishInterrupted({}, {}),
+            ArcImportRecord::Interrupted::kNone);

+TEST(ArcImportRecordTest, OpaqueArcIdsRoundTrip) {
+  const std::vector<std::string> ids = {
+      "a.b.c", "https://x.example/p?q=1", "with spaces",
+      "4F3C2A10-5B6D-4E7F-8A9B-0C1D2E3F4A5B"};
+  ArcImportRecord record;
+  for (const std::string& id : ids) {
+    record.MapSpace(id, "rac-space-for-" + id, "run-1");
+    record.MapItem(id, "rac-item-for-" + id, ItemKind::kFolder, "run-1");
+  }
+
+  base::DictValue written = SerializedDict(record);
+  const base::DictValue* spaces = written.FindDict("spaces");
+  ASSERT_TRUE(spaces);
+  // Dots must not split the key into nested dicts.
+  ASSERT_TRUE(spaces->FindDict("a.b.c"));
+  EXPECT_FALSE(spaces->Find("a"));
+  EXPECT_EQ(spaces->size(), ids.size());
+  const base::DictValue* items = written.FindDict("items");
+  ASSERT_TRUE(items);
+  ASSERT_TRUE(items->FindDict("a.b.c"));
+  EXPECT_FALSE(items->Find("a"));
+  EXPECT_EQ(items->size(), ids.size());
+
+  ArcImportRecord parsed = ParseOk(record.Serialize());
+  for (const std::string& id : ids) {
+    ASSERT_TRUE(parsed.FindSpace(id)) << id;
+    EXPECT_EQ(parsed.FindSpace(id)->rac_id, "rac-space-for-" + id);
+    ASSERT_TRUE(parsed.FindItem(id)) << id;
+    EXPECT_EQ(parsed.FindItem(id)->rac_id, "rac-item-for-" + id);
+    EXPECT_EQ(parsed.FindItem(id)->kind, ItemKind::kFolder);
+  }
+  EXPECT_FALSE(parsed.FindSpace("a"));
+  EXPECT_FALSE(parsed.FindSpace("a.b"));
+}

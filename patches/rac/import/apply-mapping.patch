+TEST(ArcImportMappingTest, RerunAddsNothing) {
+  const ImportProfile profile = BigProfile();
+  ArcImportRecord record;
+  ArcLiveSidebar live;
+
+  const ArcApplyPlan first =
+      MapArcProfile(profile, record, live, ArcImportOptions());
+  ASSERT_FALSE(first.IsEmpty());
+  EXPECT_EQ(first.counts.spaces, 2);
+  // t1, p1, q1, s1, s2, u1.
+  EXPECT_EQ(first.counts.pinned_tabs, 6);
+  // Parent, Child, Empty.
+  EXPECT_EQ(first.counts.folders, 3);
+  EXPECT_EQ(first.counts.favorites, 2);
+  EXPECT_EQ(first.counts.open_tabs, 4);
+  FakeApply(first, "run-1", record, live);
+  ASSERT_TRUE(record.has_mappings());
+
+  const ArcApplyPlan second =
+      MapArcProfile(profile, record, live, ArcImportOptions());
+
+  EXPECT_TRUE(second.IsEmpty());
+  EXPECT_THAT(second.spaces, IsEmpty());
+  EXPECT_THAT(second.favorites, IsEmpty());
+  EXPECT_FALSE(second.record_was_stale);
+  EXPECT_EQ(second.counts.spaces, 0);
+  EXPECT_EQ(second.counts.pinned_tabs, 0);
+  EXPECT_EQ(second.counts.folders, 0);
+  EXPECT_EQ(second.counts.favorites, 0);
+  EXPECT_EQ(second.counts.open_tabs, 0);
+  EXPECT_GT(second.counts.already_imported, 0);
+  // o1, o2, o3, v1: a space this import made isn't given its tabs again.
+  EXPECT_EQ(second.counts.open_tabs_not_reopened, 4);
+  EXPECT_EQ(second.counts.removed_since, 0);
+}

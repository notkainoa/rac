+#include "chrome/browser/rac/import/arc_import_record.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+using ::testing::ElementsAre;
+using ::testing::IsEmpty;
+
+using ItemKind = ArcImportRecord::ItemKind;
+using ReadStatus = ArcImportRecord::ReadStatus;
+using ImportRun = ArcImportRecord::Run;
+
+// A fixed time, `seconds` after the Unix epoch.
+base::Time At(double seconds) {
+  return base::Time::FromSecondsSinceUnixEpoch(seconds);
+}
+
+// A run with every field set. `undone` is false.
+ImportRun MakeRun(const std::string& id, double base_seconds) {
+  ImportRun run;
+  run.id = id;
+  run.time = At(base_seconds);
+  run.snapshot_id = "snapshot-" + id;
+  run.snapshot_time = At(base_seconds + 1);
+  run.undo_until = At(base_seconds + 7 * 24 * 3600);
+  run.replaced_blank_space = "blank-space-" + id;
+  run.other_profiles = {"Profile 2", "Profile 3"};
+  run.undone = false;
+  return run;
+}
+
+// A record with every field filled in. See ExpectFullRecord().
+ArcImportRecord MakeFullRecord() {
+  ArcImportRecord record;
+  record.arc_profile_key = "custom:Profile 1";
+  record.first_import = At(1760000000);
+  record.last_import = At(1760100000);
+  record.history_imported = At(1760050000);
+
+  record.MapSpace("arc-space-1", "11111111-1111-4111-8111-111111111111",
+                  "run-1");
+  record.MapSpace("arc-space-2", "22222222-2222-4222-8222-222222222222",
+                  "run-2");
+  record.MapItem("arc-pin-1", "rac-pin-1", ItemKind::kPinnedTab, "run-1");
+  record.MapItem("arc-folder-1", "rac-folder-1", ItemKind::kFolder, "run-1");
+  record.MapItem("arc-fav-1", "rac-fav-1", ItemKind::kFavorite, "run-2");
+
+  record.AddRun(MakeRun("run-1", 1760000000));
+  ImportRun second = MakeRun("run-2", 1760100000);
+  second.undone = true;
+  second.undone_at = At(1760200000);
+  second.other_profiles = {"Profile 2"};
+  record.AddRun(std::move(second));
+
+  record.handoffs.routing_rules_json = {R"({"match":"a.test","to":"space-1"})",
+                                        R"({"match":"b.test","to":"space-2"})"};
+  record.handoffs.routing_default_json = R"({"to":"space-1"})";
+  record.handoffs.auto_archive_raw = "sevenDays";
+  record.handoffs.auto_archive_after = base::Days(7);
+  record.handoffs.archive_path =
+      base::FilePath("/tmp/arc-test/StorableArchiveItems.json");
+
+  record.pinned_extension_ids = {"aaaabbbbccccddddeeeeffffgggghhhh",
+                                 "ppppoooonnnnmmmmllllkkkkjjjjiiii"};
+  return record;
+}
+
+// Checks `record` against MakeFullRecord().
+void ExpectFullRecord(const ArcImportRecord& record) {
+  EXPECT_EQ(record.arc_profile_key, "custom:Profile 1");
+  EXPECT_EQ(record.first_import, At(1760000000));
+  EXPECT_EQ(record.last_import, At(1760100000));
+  EXPECT_EQ(record.history_imported, At(1760050000));
+
+  const ArcImportRecord::SpaceMapping* space1 = record.FindSpace("arc-space-1");
+  ASSERT_TRUE(space1);
+  EXPECT_EQ(space1->rac_id, "11111111-1111-4111-8111-111111111111");
+  EXPECT_EQ(space1->run_id, "run-1");
+  const ArcImportRecord::SpaceMapping* space2 = record.FindSpace("arc-space-2");
+  ASSERT_TRUE(space2);
+  EXPECT_EQ(space2->rac_id, "22222222-2222-4222-8222-222222222222");
+  EXPECT_EQ(space2->run_id, "run-2");
+  EXPECT_FALSE(record.FindSpace("arc-space-3"));
+
+  const ArcImportRecord::ItemMapping* pin = record.FindItem("arc-pin-1");
+  ASSERT_TRUE(pin);
+  EXPECT_EQ(pin->rac_id, "rac-pin-1");
+  EXPECT_EQ(pin->run_id, "run-1");
+  EXPECT_EQ(pin->kind, ItemKind::kPinnedTab);
+  const ArcImportRecord::ItemMapping* folder = record.FindItem("arc-folder-1");
+  ASSERT_TRUE(folder);
+  EXPECT_EQ(folder->rac_id, "rac-folder-1");
+  EXPECT_EQ(folder->run_id, "run-1");
+  EXPECT_EQ(folder->kind, ItemKind::kFolder);
+  const ArcImportRecord::ItemMapping* favorite = record.FindItem("arc-fav-1");
+  ASSERT_TRUE(favorite);
+  EXPECT_EQ(favorite->rac_id, "rac-fav-1");
+  EXPECT_EQ(favorite->run_id, "run-2");
+  EXPECT_EQ(favorite->kind, ItemKind::kFavorite);
+  EXPECT_TRUE(record.has_mappings());
+
+  ASSERT_EQ(record.runs().size(), 2u);
+  EXPECT_EQ(record.runs()[0].id, "run-1");

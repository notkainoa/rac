+TEST(ArcImportRecordTest, IsStale) {
+  const base::flat_set<std::string> none{};
+
+  // No mappings: nothing to be stale.
+  ArcImportRecord empty;
+  EXPECT_FALSE(empty.IsStale(none, none));
+  EXPECT_FALSE(empty.IsStale({"x"}, {"y"}));
+
+  // One mapped space, live.
+  ArcImportRecord with_space;
+  with_space.MapSpace("s1", "rac-space", "run-1");
+  EXPECT_FALSE(with_space.IsStale({"rac-space"}, none));
+  EXPECT_TRUE(with_space.IsStale(none, none));
+  EXPECT_TRUE(with_space.IsStale({"other-space"}, none));
+  // Space ids and sidebar ids are separate sets.
+  EXPECT_TRUE(with_space.IsStale(none, {"rac-space"}));
+
+  // One mapped item, live.
+  ArcImportRecord with_item;
+  with_item.MapItem("i1", "rac-item", ItemKind::kPinnedTab, "run-1");
+  EXPECT_FALSE(with_item.IsStale(none, {"rac-item"}));
+  EXPECT_TRUE(with_item.IsStale(none, none));
+  EXPECT_TRUE(with_item.IsStale({"rac-item"}, none));
+
+  // Several mappings: one live one is enough.
+  ArcImportRecord mixed;
+  mixed.MapSpace("s1", "rac-space-1", "run-1");
+  mixed.MapSpace("s2", "rac-space-2", "run-1");
+  mixed.MapItem("i1", "rac-item-1", ItemKind::kFolder, "run-1");
+  mixed.MapItem("i2", "rac-item-2", ItemKind::kFavorite, "run-1");
+  EXPECT_TRUE(mixed.IsStale(none, none));
+  EXPECT_FALSE(mixed.IsStale({"rac-space-2"}, none));
+  EXPECT_FALSE(mixed.IsStale(none, {"rac-item-2"}));
+  EXPECT_TRUE(mixed.IsStale({"rac-item-1"}, {"rac-space-1"}));
+}

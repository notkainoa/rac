+#ifndef CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_RECORD_H_
+#define CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_RECORD_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/rac/import/arc_import_types.h"
+#include "chrome/browser/rac/import/import_plan.h"
+
+namespace rac {
+
+// What an Arc import put into one rac profile, so a rerun adds only what's
+// new and Undo removes only what the import added. Saved as
+// `<profile>/rac imports/arc.json`, 0600 in a 0700 folder, outside
+// `Preferences`, so a `Preferences` reset doesn't make the next import add
+// everything twice.
+//
+// It holds ids, times, counts, and the hand-offs later features pick up.
+// No URLs or titles of tabs: those are in the sidebar itself, and in the
+// pre-import snapshot for its 7 days.
+//
+//   { "version": 1, "min_reader_version": 1, "source": "arc",
+//     "arc_profile": "default",
+//     "first_import": <time>, "last_import": <time>,
+//     "history_imported": <time>,
+//     "spaces": { "<arc space id>": { "rac": "<uuid>", "run": "<run id>" } },
+//     "items":  { "<arc item id>":  { "rac": "<sidebar id>", "run": "<run id>",
+//                                     "kind": "pinned" | "folder" | "favorite" } },
+//     "runs": [ { "id": "<uuid>", "time": <time>, "snapshot": "<backup id>",
+//                 "snapshot_time": <time>, "undo_until": <time>,
+//                 "replaced_blank_space": "<uuid>",
+//                 "profiles": ["Profile 2"], "undone": false,
+//                 "undone_at": <time>, "in_progress": true } ],
+//     "handoffs": { "routing_rules": ["<json>"], "routing_default": "<json>",
+//                   "auto_archive": "sevenDays", "auto_archive_after": <delta>,
+//                   "archive_path": "<path>" },
+//     "pinned_extensions": ["<extension id>"] }
+//
+// Times use base::TimeToValue. Top-level keys this build doesn't know are
+// kept and written back; unknown keys inside an entry are not. Pure: reading
+// and writing are blocking file calls, made on a MayBlock sequence by the
+// applier.
+class ArcImportRecord {
+ public:
+  // The newest format this build writes, and the oldest build that can read
+  // it. Builds only ever raise them. A record whose `min_reader_version` is
+  // above kVersion isn't read, and the import refuses to run rather than
+  // overwrite it.
+  static constexpr int kVersion = 1;
+  static constexpr int kMinReaderVersion = 1;
+
+  static constexpr char kDirName[] = "rac imports";
+  static constexpr char kFileName[] = "arc.json";
+  // Where a record that couldn't be parsed is moved before a fresh one is
+  // written. One copy is kept.
+  static constexpr char kBadFileName[] = "arc.json.bad";
+  // Files over this size are not read; Read() reports them as kUnreadable.
+  static constexpr size_t kMaxFileSize = 16 * 1024 * 1024;
+  // Older runs are dropped from `runs`. Their mappings stay.
+  static constexpr size_t kMaxRuns = 20;
+
+  enum class ItemKind { kPinnedTab, kFolder, kFavorite };
+
+  struct SpaceMapping {
+    // SpaceId::AsLowercaseString().
+    std::string rac_id;
+    std::string run_id;
+
+    bool operator==(const SpaceMapping&) const = default;
+  };
+
+  struct ItemMapping {
+    // A SidebarItem or SidebarFolder id.
+    std::string rac_id;
+    std::string run_id;
+    ItemKind kind = ItemKind::kPinnedTab;
+
+    bool operator==(const ItemMapping&) const = default;
+  };
+
+  // One import into this profile.
+  struct Run {
+    Run();
+    Run(const Run&);
+    Run& operator=(const Run&);
+    ~Run();
+
+    // Shared by every profile the same import touched.
+    std::string id;
+    base::Time time;
+    // The pinned pre-import DataBackups snapshot.
+    std::string snapshot_id;
+    // When the snapshot was taken.
+    base::Time snapshot_time;
+    // DataBackups::kSnapshotLifetime after the snapshot.
+    base::Time undo_until;
+    // The blank space the import replaced, if it did. Undo puts it back.
+    std::string replaced_blank_space;
+    // Other rac profiles the same import touched, as profile folder base
+    // names. Only in the record of the profile the import started from.
+    std::vector<std::string> other_profiles;
+    bool undone = false;
+    // When Undo took the run out. Null if it hasn't.
+    base::Time undone_at;
+    // Saved before the import touches the sidebar, with every rac id it is
+    // about to write already mapped, and cleared once it has written them.
+    // A run still in progress when a record is read was interrupted (a
+    // crash, a power cut); FinishInterrupted() settles it.
+    bool in_progress = false;
+
+    bool operator==(const Run&) const;
+  };
+
+  enum class ReadStatus {
+    // No record: this profile never received an Arc import.
+    kMissing,
+    kOk,
+    // Not a record this build understands. The applier moves it aside.
+    kCorrupt,
+    // The file exists but couldn't be read, or is over kMaxFileSize. Not
+    // known to be damaged, so it is left alone and the import refuses to
+    // run.
+    kUnreadable,
+    // Written by a newer rac. Leave it alone.
+    kTooNew,
+  };
+
+  struct ReadResult;
+
+  ArcImportRecord();
+  ArcImportRecord(const ArcImportRecord&);
+  ArcImportRecord(ArcImportRecord&&) noexcept;
+  ArcImportRecord& operator=(const ArcImportRecord&);
+  ArcImportRecord& operator=(ArcImportRecord&&) noexcept;
+  ~ArcImportRecord();
+
+  static base::FilePath DirFor(const base::FilePath& profile_dir);
+  static base::FilePath PathFor(const base::FilePath& profile_dir);
+
+  // Blocking. Never creates anything.
+  static ReadResult Read(const base::FilePath& profile_dir);
+  // Blocking. Creates the folder 0700 if needed, re-asserts 0700, and
+  // replaces the file atomically with ImportantFileWriter, whose temp file is
+  // 0600 from creation. Returns false if any step failed; the old file is
+  // then still in place.
+  bool Write(const base::FilePath& profile_dir) const;
+  // Blocking. Renames an unreadable record to kBadFileName, replacing an
+  // older one.
+  static bool MoveAside(const base::FilePath& profile_dir);
+
+  static ReadResult Parse(std::string_view json);
+  std::string Serialize() const;
+
+  // Lookups by Arc id. Null if not mapped.
+  const SpaceMapping* FindSpace(std::string_view arc_id) const;
+  const ItemMapping* FindItem(std::string_view arc_id) const;
+
+  void MapSpace(std::string arc_id, std::string rac_id, std::string run_id);
+  void MapItem(std::string arc_id,
+               std::string rac_id,
+               ItemKind kind,
+               std::string run_id);
+  bool has_mappings() const { return !spaces_.empty() || !items_.empty(); }
+  void ClearMappings();
+  // Forgets `arc_id`'s mapping if `run_id` made it. For an item the run
+  // mapped but couldn't add, such as one whose id the sidebar already has:
+  // that id is live, so FinishInterrupted() would keep it. Returns whether
+  // a mapping was forgotten.
+  bool UnmapItem(std::string_view arc_id, std::string_view run_id);
+  // Points `run_id`'s item mapped to `old_rac_id` at `new_rac_id` instead.
+  // For a folder of the run that Undo made again under a new id, holding
+  // the user's own pins, so a later Undo of the run still finds it. Returns
+  // whether a mapping changed.
+  bool RemapItem(std::string_view run_id,
+                 std::string_view old_rac_id,
+                 std::string new_rac_id);
+
+  // True when the record maps something but none of it is in the profile
+  // any more: `Preferences` was reset and not restored, or the user removed
+  // everything the import brought. A rerun then imports as if for the first
+  // time, instead of skipping everything.
+  bool IsStale(const base::flat_set<std::string>& live_space_ids,
+               const base::flat_set<std::string>& live_sidebar_ids) const;
+
+  // Runs, oldest first.
+  const std::vector<Run>& runs() const { return runs_; }
+  // Appends `run`, dropping the oldest beyond kMaxRuns. A run with the same
+  // id is replaced where it is instead, so an in-progress run can be marked
+  // done.
+  void AddRun(Run run);
+  const Run* FindRun(std::string_view run_id) const;
+  // The newest run that isn't undone. Null if every run is.
+  const Run* NewestActiveRun() const;
+  // NewestActiveRun(), if `now` is before its undo_until. Runs are undone
+  // newest first, one per Undo: an older run's additions may have been
+  // extended by a newer one, so it can be undone only once every newer run
+  // is.
+  const Run* UndoableRun(base::Time now) const;
+  // What the import screens and Settings show for this profile at `now`.
+  ArcImportState StateAt(base::Time now) const;
+
+  // The run still marked in progress, or null. There is at most one: each
+  // import settles an interrupted one before it starts.
+  const Run* InterruptedRun() const;
+  enum class Interrupted {
+    // No run was in progress.
+    kNone,
+    // Some of it was in the profile: the run is done now, mapping only that.
+    kFinished,
+    // None of it was in the profile: the run is gone. Its snapshot (read it
+    // from InterruptedRun() first) can be unpinned.
+    kDropped,
+  };
+  // Settles InterruptedRun() against what the profile holds: its mappings
+  // whose rac ids aren't live are forgotten, since those writes never
+  // reached disk; its replaced blank space is forgotten if that space is
+  // still there. Then it's marked done, or dropped if nothing of it is left.
+  Interrupted FinishInterrupted(
+      const base::flat_set<std::string>& live_space_ids,
+      const base::flat_set<std::string>& live_sidebar_ids);
+
+  // rac ids a run added, in mapping order.
+  std::vector<std::string> SpacesOfRun(std::string_view run_id) const;
+  std::vector<std::string> ItemsOfRun(std::string_view run_id,
+                                      ItemKind kind) const;
+  // Forgets the mappings of `run_id` whose rac id is in `removed`, so a later
+  // import brings those back. Marks the run undone at `now` when none of its
+  // mappings are left, including a run that never had any (one that only
+  // names the other profiles an import touched). A run with mappings left,
+  // such as a space a page kept open, stays undoable, so Undo can be tried
+  // again.
+  void ForgetRemoved(std::string_view run_id,
+                     const base::flat_set<std::string>& removed,
+                     base::Time now);
+
+  // Which Arc profile went into this rac profile (ImportProfile::source_key).
+  std::string arc_profile_key;
+  base::Time first_import;
+  base::Time last_import;
+  // When Helium's importer last brought this profile's history. Null if it
+  // never did. History isn't imported twice: it would duplicate visits.
+  base::Time history_imported;
+  // Hand-offs for later features (link routing, tab archive), kept, not
+  // applied. Only in the record of the profile the import started from.
+  ImportHandoffs handoffs;
+  // ImportProfile::pinned_extension_ids, kept, never installed.
+  std::vector<std::string> pinned_extension_ids;
+
+ private:
+  std::map<std::string, SpaceMapping, std::less<>> spaces_;
+  std::map<std::string, ItemMapping, std::less<>> items_;
+  std::vector<Run> runs_;
+  // Top-level keys this build doesn't read.
+  base::DictValue unknown_fields_;
+};
+
+struct ArcImportRecord::ReadResult {
+  ReadStatus status = ReadStatus::kMissing;
+  // Empty unless kOk.
+  ArcImportRecord record;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_RECORD_H_

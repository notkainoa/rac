+constexpr char kVersionKey[] = "version";
+constexpr char kMinReaderVersionKey[] = "min_reader_version";
+constexpr char kSourceKey[] = "source";
+constexpr char kSourceArc[] = "arc";
+constexpr char kArcProfileKey[] = "arc_profile";
+constexpr char kFirstImportKey[] = "first_import";
+constexpr char kLastImportKey[] = "last_import";
+constexpr char kHistoryImportedKey[] = "history_imported";
+constexpr char kSpacesKey[] = "spaces";
+constexpr char kItemsKey[] = "items";
+constexpr char kRunsKey[] = "runs";
+constexpr char kHandoffsKey[] = "handoffs";
+constexpr char kPinnedExtensionsKey[] = "pinned_extensions";
+
+constexpr char kRacKey[] = "rac";
+constexpr char kRunKey[] = "run";
+constexpr char kKindKey[] = "kind";
+constexpr char kKindPinned[] = "pinned";
+constexpr char kKindFolder[] = "folder";
+constexpr char kKindFavorite[] = "favorite";
+
+constexpr char kRunIdKey[] = "id";
+constexpr char kRunTimeKey[] = "time";
+constexpr char kRunSnapshotKey[] = "snapshot";
+constexpr char kRunSnapshotTimeKey[] = "snapshot_time";
+constexpr char kRunUndoUntilKey[] = "undo_until";
+constexpr char kRunReplacedBlankKey[] = "replaced_blank_space";
+constexpr char kRunProfilesKey[] = "profiles";
+constexpr char kRunUndoneKey[] = "undone";
+constexpr char kRunUndoneAtKey[] = "undone_at";
+constexpr char kRunInProgressKey[] = "in_progress";
+
+constexpr char kRoutingRulesKey[] = "routing_rules";
+constexpr char kRoutingDefaultKey[] = "routing_default";
+constexpr char kAutoArchiveKey[] = "auto_archive";
+constexpr char kAutoArchiveAfterKey[] = "auto_archive_after";
+constexpr char kArchivePathKey[] = "archive_path";
+
+// Every key this build reads at the top level. Anything else is kept.
+constexpr const char* kKnownKeys[] = {
+    kVersionKey,       kMinReaderVersionKey, kSourceKey,   kArcProfileKey,
+    kFirstImportKey,   kLastImportKey,       kHistoryImportedKey,
+    kSpacesKey,        kItemsKey,            kRunsKey,     kHandoffsKey,
+    kPinnedExtensionsKey};
+
+const char* KindToString(ArcImportRecord::ItemKind kind) {
+  switch (kind) {
+    case ArcImportRecord::ItemKind::kPinnedTab:
+      return kKindPinned;
+    case ArcImportRecord::ItemKind::kFolder:
+      return kKindFolder;
+    case ArcImportRecord::ItemKind::kFavorite:
+      return kKindFavorite;
+  }
+}
+
+std::optional<ArcImportRecord::ItemKind> KindFromString(
+    const std::string& kind) {
+  if (kind == kKindPinned) {
+    return ArcImportRecord::ItemKind::kPinnedTab;
+  }
+  if (kind == kKindFolder) {
+    return ArcImportRecord::ItemKind::kFolder;
+  }
+  if (kind == kKindFavorite) {
+    return ArcImportRecord::ItemKind::kFavorite;
+  }
+  return std::nullopt;
+}
+
+void SetTime(base::DictValue& dict, const char* key, base::Time time) {
+  if (!time.is_null()) {
+    dict.Set(key, base::TimeToValue(time));
+  }
+}
+
+base::Time GetTime(const base::DictValue& dict, const char* key) {
+  return base::ValueToTime(dict.Find(key)).value_or(base::Time());
+}
+
+std::string GetString(const base::DictValue& dict, const char* key) {
+  const std::string* value = dict.FindString(key);
+  return value ? *value : std::string();
+}
+
+base::ListValue StringsToList(const std::vector<std::string>& strings) {
+  base::ListValue list;
+  for (const std::string& value : strings) {
+    list.Append(value);
+  }
+  return list;
+}
+
+std::vector<std::string> ListToStrings(const base::ListValue* list) {
+  std::vector<std::string> strings;
+  if (!list) {
+    return strings;
+  }
+  for (const base::Value& value : *list) {
+    if (value.is_string()) {
+      strings.push_back(value.GetString());
+    }
+  }
+  return strings;
+}
+
+base::DictValue RunToDict(const ArcImportRecord::Run& run) {
+  base::DictValue dict;
+  dict.Set(kRunIdKey, run.id);
+  SetTime(dict, kRunTimeKey, run.time);
+  if (!run.snapshot_id.empty()) {
+    dict.Set(kRunSnapshotKey, run.snapshot_id);
+  }
+  SetTime(dict, kRunSnapshotTimeKey, run.snapshot_time);
+  SetTime(dict, kRunUndoUntilKey, run.undo_until);
+  if (!run.replaced_blank_space.empty()) {
+    dict.Set(kRunReplacedBlankKey, run.replaced_blank_space);
+  }
+  if (!run.other_profiles.empty()) {
+    dict.Set(kRunProfilesKey, StringsToList(run.other_profiles));
+  }
+  dict.Set(kRunUndoneKey, run.undone);
+  SetTime(dict, kRunUndoneAtKey, run.undone_at);
+  if (run.in_progress) {
+    dict.Set(kRunInProgressKey, true);
+  }
+  return dict;
+}
+
+std::optional<ArcImportRecord::Run> RunFromDict(const base::DictValue& dict) {
+  ArcImportRecord::Run run;
+  run.id = GetString(dict, kRunIdKey);
+  if (run.id.empty()) {
+    return std::nullopt;
+  }
+  run.time = GetTime(dict, kRunTimeKey);
+  run.snapshot_id = GetString(dict, kRunSnapshotKey);
+  run.snapshot_time = GetTime(dict, kRunSnapshotTimeKey);
+  run.undo_until = GetTime(dict, kRunUndoUntilKey);
+  run.replaced_blank_space = GetString(dict, kRunReplacedBlankKey);
+  run.other_profiles = ListToStrings(dict.FindList(kRunProfilesKey));
+  // A profile name must be one folder name. Anything else is dropped so
+  // Undo can never be pointed outside the user data folder.
+  std::erase_if(run.other_profiles, [](const std::string& name) {
+    return name.empty() || name == "." || name == ".." ||
+           name.find('/') != std::string::npos ||
+           name.find('\\') != std::string::npos;
+  });
+  run.undone = dict.FindBool(kRunUndoneKey).value_or(false);
+  run.undone_at = GetTime(dict, kRunUndoneAtKey);
+  run.in_progress = dict.FindBool(kRunInProgressKey).value_or(false);
+  return run;
+}
+
+base::DictValue HandoffsToDict(const ImportHandoffs& handoffs) {
+  base::DictValue dict;
+  if (!handoffs.routing_rules_json.empty()) {
+    dict.Set(kRoutingRulesKey, StringsToList(handoffs.routing_rules_json));
+  }
+  if (!handoffs.routing_default_json.empty()) {
+    dict.Set(kRoutingDefaultKey, handoffs.routing_default_json);
+  }
+  if (!handoffs.auto_archive_raw.empty()) {
+    dict.Set(kAutoArchiveKey, handoffs.auto_archive_raw);
+  }
+  if (handoffs.auto_archive_after) {
+    dict.Set(kAutoArchiveAfterKey,
+             base::TimeDeltaToValue(*handoffs.auto_archive_after));
+  }
+  if (!handoffs.archive_path.empty()) {
+    dict.Set(kArchivePathKey, base::FilePathToValue(handoffs.archive_path));
+  }
+  return dict;
+}
+
+ImportHandoffs HandoffsFromDict(const base::DictValue* dict) {
+  ImportHandoffs handoffs;
+  if (!dict) {
+    return handoffs;
+  }
+  handoffs.routing_rules_json = ListToStrings(dict->FindList(kRoutingRulesKey));
+  handoffs.routing_default_json = GetString(*dict, kRoutingDefaultKey);
+  handoffs.auto_archive_raw = GetString(*dict, kAutoArchiveKey);
+  handoffs.auto_archive_after =
+      base::ValueToTimeDelta(dict->Find(kAutoArchiveAfterKey));
+  if (std::optional<base::FilePath> path =
+          base::ValueToFilePath(dict->Find(kArchivePathKey))) {
+    handoffs.archive_path = std::move(*path);
+  }
+  return handoffs;
+}

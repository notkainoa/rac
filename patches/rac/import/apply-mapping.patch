+
+std::vector<ArcKeptPin> PlanKeptPins(
+    const std::vector<ArcUndoPinEntry>& entries,
+    const base::flat_set<std::string>& run_ids) {
+  std::vector<ArcKeptPin> kept;
+  for (size_t i = 0; i < entries.size(); ++i) {
+    const ArcUndoPinEntry& entry = entries[i];
+    ArcKeptPin pin;
+    pin.index = i;
+    if (!entry.is_folder) {
+      if (run_ids.contains(entry.id)) {
+        continue;
+      }
+      pin.item_ids.push_back(entry.id);
+    } else {
+      pin.folder_id = entry.id;
+      for (size_t j = 0; j < entry.item_ids.size(); ++j) {
+        if (!run_ids.contains(entry.item_ids[j])) {
+          pin.item_ids.push_back(entry.item_ids[j]);
+          pin.item_indices.push_back(j);
+        }
+      }
+      if (pin.item_ids.empty()) {
+        continue;
+      }
+    }
+    kept.push_back(std::move(pin));
+  }
+  return kept;
+}

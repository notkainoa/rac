+  ASSERT_TRUE(record.FindRun("cut"));
+  EXPECT_FALSE(record.FindRun("cut")->in_progress);
+  EXPECT_FALSE(record.FindRun("cut")->undone);
+  // The blank space is gone, so the import did replace it: Undo puts it
+  // back.

+// static
+bool ArcImportRecord::MoveAside(const base::FilePath& profile_dir) {
+  const base::FilePath dir = DirFor(profile_dir);
+  return base::ReplaceFile(dir.AppendASCII(kFileName),
+                           dir.AppendASCII(kBadFileName), nullptr);
+}

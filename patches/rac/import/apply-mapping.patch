+// ---------------------------------------------------------------------------
+// Colors.
+
+double SrgbToLinear(double encoded) {
+  // Extended sRGB: the curve is mirrored below zero and continues above one.
+  const double magnitude = std::abs(encoded);
+  const double linear = magnitude <= 0.04045
+                            ? magnitude / 12.92
+                            : std::pow((magnitude + 0.055) / 1.055, 2.4);
+  return std::copysign(linear, encoded);
+}
+
+double LinearToSrgb(double linear) {
+  const double magnitude = std::abs(linear);
+  const double encoded = magnitude <= 0.0031308
+                             ? magnitude * 12.92
+                             : 1.055 * std::pow(magnitude, 1 / 2.4) - 0.055;
+  return std::copysign(encoded, linear);
+}
+
+struct Rgb {
+  double r = 0;
+  double g = 0;
+  double b = 0;
+};
+
+struct Oklab {
+  double l = 0;
+  double a = 0;
+  double b = 0;
+};
+
+// Björn Ottosson's OKLab, from linear sRGB (public domain matrices).
+Oklab LinearSrgbToOklab(const Rgb& c) {
+  const double l = std::cbrt(0.4122214708 * c.r + 0.5363325363 * c.g +
+                             0.0514459929 * c.b);
+  const double m = std::cbrt(0.2119034982 * c.r + 0.6806995451 * c.g +
+                             0.1073969566 * c.b);
+  const double s = std::cbrt(0.0883024619 * c.r + 0.2817188376 * c.g +
+                             0.6299787005 * c.b);
+  return {0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+          1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+          0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s};
+}
+
+Rgb OklabToLinearSrgb(const Oklab& c) {
+  const double l_ = c.l + 0.3963377774 * c.a + 0.2158037573 * c.b;
+  const double m_ = c.l - 0.1055613458 * c.a - 0.0638541728 * c.b;
+  const double s_ = c.l - 0.0894841775 * c.a - 1.2914855480 * c.b;
+  const double l = l_ * l_ * l_;
+  const double m = m_ * m_ * m_;
+  const double s = s_ * s_ * s_;
+  return {4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+          -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+          -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s};
+}
+
+constexpr double kGamutEpsilon = 1e-6;
+
+bool InUnitRange(double value) {
+  return value >= -kGamutEpsilon && value <= 1 + kGamutEpsilon;
+}
+
+bool InGamut(const Rgb& linear) {
+  return InUnitRange(linear.r) && InUnitRange(linear.g) &&
+         InUnitRange(linear.b);
+}
+
+double Finite(double value) {
+  return std::isfinite(value) ? value : 0;
+}
+
+ImportColor FromLinear(const Rgb& linear, double alpha) {
+  return {std::clamp(LinearToSrgb(linear.r), 0.0, 1.0),
+          std::clamp(LinearToSrgb(linear.g), 0.0, 1.0),
+          std::clamp(LinearToSrgb(linear.b), 0.0, 1.0), alpha};
+}
+
+// Which of a variant's colors make its two stops.
+std::optional<std::pair<ImportColor, ImportColor>> VariantStops(
+    const ImportThemeVariant& variant) {
+  const std::optional<ImportColor>& first =
+      variant.color1 ? variant.color1 : variant.color2;
+  if (!first) {
+    return std::nullopt;
+  }
+  switch (variant.origin) {
+    case ImportThemeVariant::Origin::kUnknown:
+      return std::nullopt;
+    case ImportThemeVariant::Origin::kGradient:
+      return std::make_pair(
+          *first, variant.color1 && variant.color2 ? *variant.color2 : *first);
+    case ImportThemeVariant::Origin::kSingleColor:
+    case ImportThemeVariant::Origin::kPalette:
+      // One flat color: Arc's `shaded`, or the single color.
+      return std::make_pair(*first, *first);
+  }
+}
+
+bool IsUsable(const std::optional<ImportThemeVariant>& variant) {
+  return variant && VariantStops(*variant).has_value();
+}
+
+SpaceTheme::Mode ModeFor(const ImportThemeVariant& variant,
+                         const ImportColor& stop1,
+                         const ImportColor& stop2) {
+  switch (variant.content) {
+    case ImportThemeVariant::Content::kLight:
+      return SpaceTheme::Mode::kLight;
+    case ImportThemeVariant::Content::kDark:
+      return SpaceTheme::Mode::kDark;
+    case ImportThemeVariant::Content::kUnknown:
+      break;
+  }
+  const double luminance =
+      (RelativeLuminance(stop1) + RelativeLuminance(stop2)) / 2;
+  return luminance >= kLightLuminance ? SpaceTheme::Mode::kLight
+                                      : SpaceTheme::Mode::kDark;
+}
+
+// ---------------------------------------------------------------------------
+// Items.
+
+std::u16string ItemText(const std::string& text) {
+  return base::UTF8ToUTF16(base::CollapseWhitespaceASCII(
+      text, /*trim_sequences_with_line_breaks=*/false));
+}
+
+// Tabs in `items`, at any depth, that `record` doesn't map.
+size_t CountTabs(const std::vector<ImportItem>& items,
+                 const ArcImportRecord* record = nullptr) {
+  size_t count = 0;
+  for (const ImportItem& item : items) {
+    if (item.kind == ImportItem::Kind::kFolder) {
+      count += CountTabs(item.children, record);
+    } else if (!record || !record->FindItem(item.source_id)) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+// Converts a tab, or counts why it's left out.
+std::optional<ArcApplyTab> ConvertTab(const ImportItem& item,
+                                      ArcImportCounts& counts) {
+  GURL url(item.url);
+  if (!url.is_valid()) {
+    ++counts.invalid_urls;
+    return std::nullopt;
+  }
+  if (!IsImportableUrl(url)) {
+    ++counts.unsupported_urls;
+    return std::nullopt;
+  }
+  ArcApplyTab tab;
+  tab.source_id = item.source_id;
+  tab.url = std::move(url);
+  tab.page_title = ItemText(item.page_title);
+  tab.name = ItemText(item.title);
+  tab.favicon_path = item.favicon_path;
+  tab.created = item.created;
+  return tab;
+}
+
+void CountGroup(const ImportItem& group, ArcImportCounts& counts) {
+  switch (group.group) {
+    case ImportItem::Group::kSplitView:
+      ++counts.split_views;
+      break;
+    case ImportItem::Group::kTabGroup:
+      ++counts.tab_groups;
+      break;
+    case ImportItem::Group::kNone:
+      break;
+  }
+}
+
+bool IsGroup(const ImportItem& item) {
+  return item.kind == ImportItem::Kind::kFolder &&
+         item.group != ImportItem::Group::kNone;
+}
+
+// Every tab in `items`, through folders, split views, and groups, for open
+// tabs and favorites. Groups are counted when one of their tabs is kept.
+void FlattenTabs(const std::vector<ImportItem>& items,
+                 const ArcImportRecord* record,
+                 ArcImportCounts& counts,
+                 std::vector<ArcApplyTab>& out) {
+  for (const ImportItem& item : items) {
+    if (item.kind == ImportItem::Kind::kFolder) {
+      const size_t before = out.size();
+      FlattenTabs(item.children, record, counts, out);
+      if (IsGroup(item) && out.size() > before) {
+        CountGroup(item, counts);
+      }
+      continue;
+    }
+    if (record && record->FindItem(item.source_id)) {
+      ++counts.already_imported;
+      continue;
+    }
+    if (std::optional<ArcApplyTab> tab = ConvertTab(item, counts)) {
+      out.push_back(std::move(*tab));
+    }
+  }
+}
+
+// Maps one space's pinned tree onto a one-level rac pinned list.
+class PinnedMapper {
+ public:
+  PinnedMapper(const ArcImportRecord* record,
+               const ArcLiveSidebar& live,
+               ArcImportCounts& counts,
+               std::vector<ArcApplyEntry>& out)
+      : record_(record), live_(live), counts_(counts), out_(out) {}
+
+  PinnedMapper(const PinnedMapper&) = delete;
+  PinnedMapper& operator=(const PinnedMapper&) = delete;
+
+  void MapTopLevel(const std::vector<ImportItem>& items) {
+    for (const ImportItem& item : items) {
+      if (item.kind == ImportItem::Kind::kTab) {
+        AddLooseTab(item);
+      } else if (IsGroup(item)) {
+        const int before = written_tabs_;
+        MapTopLevel(item.children);
+        if (written_tabs_ > before) {
+          CountGroup(item, *counts_);
+        }
+      } else {
+        MapFolder(item, {item.title});
+      }
+    }
+  }
+
+ private:
+  using Path = std::vector<std::string>;
+  using Nested = std::vector<std::pair<const ImportItem*, Path>>;
+
+  bool IsMapped(const ImportItem& item) const {
+    return record_ && record_->FindItem(item.source_id);
+  }
+
+  void AddLooseTab(const ImportItem& item) {
+    if (IsMapped(item)) {
+      ++counts_->already_imported;
+      return;
+    }
+    if (std::optional<ArcApplyTab> tab = ConvertTab(item, *counts_)) {
+      ++written_tabs_;
+      ++counts_->pinned_tabs;
+      out_->emplace_back(std::move(*tab));
+    }
+  }
+
+  // Emits `folder` as one rac folder, then its nested folders after it,
+  // depth first, each as its own rac folder named by its path.
+  void MapFolder(const ImportItem& folder, const Path& path) {
+    const ArcImportRecord::ItemMapping* mapping =
+        record_ ? record_->FindItem(folder.source_id) : nullptr;
+    ArcApplyFolder out;
+    out.source_id = folder.source_id;
+    out.title = base::UTF8ToUTF16(JoinFolderPath(path));
+    bool removed = false;
+    if (mapping) {
+      if (live_->sidebar_ids.contains(mapping->rac_id)) {
+        out.existing_id = mapping->rac_id;
+        ++counts_->already_imported;
+      } else {
+        removed = true;
+      }
+    }
+
+    Nested nested;
+    Collect(folder.children, path, removed, out, nested);
+
+    bool emit = false;
+    if (removed) {
+      emit = false;
+    } else if (!out.existing_id.empty()) {
+      emit = !out.tabs.empty();
+    } else {
+      // A new folder. One left with no tabs of its own is dropped, unless
+      // Arc's folder was empty to begin with: the user made it that way.
+      emit = !out.tabs.empty() || folder.children.empty();
+    }
+    if (emit) {
+      if (out.existing_id.empty()) {
+        ++counts_->folders;
+        if (path.size() > 1) {
+          ++counts_->nested_folders;
+          if (counts_->first_flattened_name.empty() &&
+              std::ranges::none_of(path, [](const std::string& title) {
+                return base::CollapseWhitespaceASCII(title, false).empty();
+              })) {
+            counts_->first_flattened_name = JoinFolderPath(path);
+          }
+        }
+      }
+      counts_->pinned_tabs += static_cast<int>(out.tabs.size());
+      out_->emplace_back(std::move(out));
+    }
+
+    for (const auto& [child, child_path] : nested) {
+      MapFolder(*child, child_path);
+    }
+  }
+
+  // The tabs directly in a folder, through split views and groups, go into
+  // `folder`; plain folders inside are queued in `nested`.
+  void Collect(const std::vector<ImportItem>& items,
+               const Path& path,
+               bool removed,
+               ArcApplyFolder& folder,
+               Nested& nested) {
+    for (const ImportItem& item : items) {
+      if (item.kind == ImportItem::Kind::kFolder) {
+        if (IsGroup(item)) {
+          const size_t before = folder.tabs.size();
+          Collect(item.children, path, removed, folder, nested);
+          if (folder.tabs.size() > before) {
+            CountGroup(item, *counts_);
+          }
+        } else {
+          Path child_path = path;
+          child_path.push_back(item.title);
+          nested.emplace_back(&item, std::move(child_path));
+        }
+        continue;
+      }
+      if (IsMapped(item)) {
+        ++counts_->already_imported;
+        continue;
+      }
+      if (removed) {
+        ++counts_->removed_since;
+        continue;
+      }
+      if (std::optional<ArcApplyTab> tab = ConvertTab(item, *counts_)) {
+        ++written_tabs_;
+        folder.tabs.push_back(std::move(*tab));
+      }
+    }
+  }
+
+  const raw_ptr<const ArcImportRecord> record_;
+  const raw_ref<const ArcLiveSidebar> live_;
+  const raw_ref<ArcImportCounts> counts_;
+  const raw_ref<std::vector<ArcApplyEntry>> out_;
+  int written_tabs_ = 0;
+};
+

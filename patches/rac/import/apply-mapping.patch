+TEST(ArcImportMappingTest, GamutMapLowersChromaInsteadOfClipping) {
+  const ImportColor mapped = GamutMapToSrgb(C(1.5, -0.5, 0.25));
+
+  EXPECT_GE(mapped.red, 0.0);
+  EXPECT_LE(mapped.red, 1.0);
+  EXPECT_GE(mapped.green, 0.0);
+  EXPECT_LE(mapped.green, 1.0);
+  EXPECT_GE(mapped.blue, 0.0);
+  EXPECT_LE(mapped.blue, 1.0);
+  EXPECT_DOUBLE_EQ(mapped.alpha, 1.0);

+// static
+ArcImportRecord::ReadResult ArcImportRecord::Parse(std::string_view json) {
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return {.status = ReadStatus::kCorrupt};
+  }
+  const std::optional<int> version = dict->FindInt(kVersionKey);
+  if (!version || *version < 1) {
+    return {.status = ReadStatus::kCorrupt};
+  }
+  const int min_reader = dict->FindInt(kMinReaderVersionKey).value_or(*version);
+  if (min_reader > kVersion) {
+    return {.status = ReadStatus::kTooNew};
+  }
+  if (const std::string* source = dict->FindString(kSourceKey);
+      source && *source != kSourceArc) {
+    return {.status = ReadStatus::kCorrupt};
+  }
+
+  ReadResult result;
+  result.status = ReadStatus::kOk;
+  ArcImportRecord& record = result.record;
+  record.arc_profile_key = GetString(*dict, kArcProfileKey);
+  record.first_import = GetTime(*dict, kFirstImportKey);
+  record.last_import = GetTime(*dict, kLastImportKey);
+  record.history_imported = GetTime(*dict, kHistoryImportedKey);
+
+  // Entries that don't parse are dropped one by one, so a damaged entry
+  // costs only itself.
+  if (const base::DictValue* spaces = dict->FindDict(kSpacesKey)) {
+    for (const auto [arc_id, value] : *spaces) {
+      const base::DictValue* entry = value.GetIfDict();
+      if (!entry || arc_id.empty()) {
+        continue;
+      }
+      std::string rac_id = GetString(*entry, kRacKey);
+      if (rac_id.empty()) {
+        continue;
+      }
+      record.spaces_[arc_id] = {std::move(rac_id), GetString(*entry, kRunKey)};
+    }
+  }
+  if (const base::DictValue* items = dict->FindDict(kItemsKey)) {
+    for (const auto [arc_id, value] : *items) {
+      const base::DictValue* entry = value.GetIfDict();
+      if (!entry || arc_id.empty()) {
+        continue;
+      }
+      std::string rac_id = GetString(*entry, kRacKey);
+      const std::optional<ItemKind> kind =
+          KindFromString(GetString(*entry, kKindKey));
+      if (rac_id.empty() || !kind) {
+        continue;
+      }
+      record.items_[arc_id] = {std::move(rac_id), GetString(*entry, kRunKey),
+                               *kind};
+    }
+  }
+  if (const base::ListValue* runs = dict->FindList(kRunsKey)) {
+    for (const base::Value& value : *runs) {
+      if (const base::DictValue* run_dict = value.GetIfDict()) {
+        if (std::optional<Run> run = RunFromDict(*run_dict)) {
+          record.runs_.push_back(std::move(*run));
+        }
+      }
+    }
+  }
+  record.handoffs = HandoffsFromDict(dict->FindDict(kHandoffsKey));
+  record.pinned_extension_ids =
+      ListToStrings(dict->FindList(kPinnedExtensionsKey));
+
+  record.unknown_fields_ = std::move(*dict);
+  for (const char* key : kKnownKeys) {
+    record.unknown_fields_.Remove(key);
+  }
+  return result;
+}
+
+std::string ArcImportRecord::Serialize() const {
+  base::DictValue dict = unknown_fields_.Clone();
+  dict.Set(kVersionKey, kVersion);
+  dict.Set(kMinReaderVersionKey, kMinReaderVersion);
+  dict.Set(kSourceKey, kSourceArc);
+  dict.Set(kArcProfileKey, arc_profile_key);
+  SetTime(dict, kFirstImportKey, first_import);
+  SetTime(dict, kLastImportKey, last_import);
+  SetTime(dict, kHistoryImportedKey, history_imported);
+
+  base::DictValue spaces;
+  for (const auto& [arc_id, mapping] : spaces_) {
+    base::DictValue entry;
+    entry.Set(kRacKey, mapping.rac_id);
+    entry.Set(kRunKey, mapping.run_id);
+    // Arc ids are opaque and may hold dots; Set() never splits a key.
+    spaces.Set(arc_id, std::move(entry));
+  }
+  dict.Set(kSpacesKey, std::move(spaces));
+
+  base::DictValue items;
+  for (const auto& [arc_id, mapping] : items_) {
+    base::DictValue entry;
+    entry.Set(kRacKey, mapping.rac_id);
+    entry.Set(kRunKey, mapping.run_id);
+    entry.Set(kKindKey, KindToString(mapping.kind));
+    items.Set(arc_id, std::move(entry));
+  }
+  dict.Set(kItemsKey, std::move(items));
+
+  base::ListValue runs;
+  for (const Run& run : runs_) {
+    runs.Append(RunToDict(run));
+  }
+  dict.Set(kRunsKey, std::move(runs));
+
+  base::DictValue handoffs_dict = HandoffsToDict(handoffs);
+  if (!handoffs_dict.empty()) {
+    dict.Set(kHandoffsKey, std::move(handoffs_dict));
+  }
+  if (!pinned_extension_ids.empty()) {
+    dict.Set(kPinnedExtensionsKey, StringsToList(pinned_extension_ids));
+  }
+
+  // Fails only on binary values or too deep a nesting, which this record
+  // never holds. Write() refuses to write an empty result anyway.
+  return base::WriteJsonWithOptions(dict,
+                                    base::JSONWriter::OPTIONS_PRETTY_PRINT)
+      .value_or(std::string());
+}
+
+const ArcImportRecord::SpaceMapping* ArcImportRecord::FindSpace(
+    std::string_view arc_id) const {
+  auto it = spaces_.find(arc_id);
+  return it == spaces_.end() ? nullptr : &it->second;
+}
+
+const ArcImportRecord::ItemMapping* ArcImportRecord::FindItem(
+    std::string_view arc_id) const {
+  auto it = items_.find(arc_id);
+  return it == items_.end() ? nullptr : &it->second;
+}
+
+void ArcImportRecord::MapSpace(std::string arc_id,
+                               std::string rac_id,
+                               std::string run_id) {
+  spaces_[std::move(arc_id)] = {std::move(rac_id), std::move(run_id)};
+}
+
+void ArcImportRecord::MapItem(std::string arc_id,
+                              std::string rac_id,
+                              ItemKind kind,
+                              std::string run_id) {
+  items_[std::move(arc_id)] = {std::move(rac_id), std::move(run_id), kind};
+}
+
+void ArcImportRecord::ClearMappings() {
+  spaces_.clear();
+  items_.clear();
+}
+
+bool ArcImportRecord::UnmapItem(std::string_view arc_id,
+                                std::string_view run_id) {
+  auto it = items_.find(arc_id);
+  if (it == items_.end() || it->second.run_id != run_id) {
+    return false;
+  }
+  items_.erase(it);
+  return true;
+}
+
+bool ArcImportRecord::RemapItem(std::string_view run_id,
+                                std::string_view old_rac_id,
+                                std::string new_rac_id) {
+  for (auto& [arc_id, mapping] : items_) {
+    if (mapping.run_id == run_id && mapping.rac_id == old_rac_id) {
+      mapping.rac_id = std::move(new_rac_id);
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ArcImportRecord::IsStale(
+    const base::flat_set<std::string>& live_space_ids,
+    const base::flat_set<std::string>& live_sidebar_ids) const {
+  if (!has_mappings()) {
+    return false;
+  }
+  for (const auto& [arc_id, mapping] : spaces_) {
+    if (live_space_ids.contains(mapping.rac_id)) {
+      return false;
+    }
+  }
+  for (const auto& [arc_id, mapping] : items_) {
+    if (live_sidebar_ids.contains(mapping.rac_id)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void ArcImportRecord::AddRun(Run run) {
+  if (auto it = std::ranges::find(runs_, run.id, &Run::id); it != runs_.end()) {
+    *it = std::move(run);
+    return;
+  }
+  runs_.push_back(std::move(run));
+  if (runs_.size() > kMaxRuns) {
+    runs_.erase(runs_.begin(),
+                runs_.begin() + static_cast<std::ptrdiff_t>(runs_.size() -
+                                                            kMaxRuns));
+  }
+}
+
+const ArcImportRecord::Run* ArcImportRecord::FindRun(
+    std::string_view run_id) const {
+  auto it = std::ranges::find(runs_, run_id, &Run::id);
+  return it == runs_.end() ? nullptr : &*it;
+}
+
+const ArcImportRecord::Run* ArcImportRecord::NewestActiveRun() const {
+  for (auto it = runs_.rbegin(); it != runs_.rend(); ++it) {
+    if (!it->undone) {
+      return &*it;
+    }
+  }
+  return nullptr;
+}
+
+const ArcImportRecord::Run* ArcImportRecord::UndoableRun(
+    base::Time now) const {
+  const Run* run = NewestActiveRun();
+  if (!run || run->undo_until.is_null() || now >= run->undo_until) {
+    return nullptr;
+  }
+  return run;
+}
+
+ArcImportState ArcImportRecord::StateAt(base::Time now) const {
+  ArcImportState state;
+  if (!last_import.is_null()) {
+    state.last_import = last_import;
+  }
+  if (runs_.empty()) {
+    return state;
+  }
+  if (const Run* run = NewestActiveRun()) {
+    if (run->undo_until.is_null() || now >= run->undo_until) {
+      state.status = ArcImportState::Status::kExpired;
+      return state;
+    }
+    state.status = ArcImportState::Status::kUndoable;
+    state.undo_until = run->undo_until;
+    if (!run->snapshot_time.is_null()) {
+      state.undo_snapshot_time = run->snapshot_time;
+    }
+    return state;
+  }
+  state.status = ArcImportState::Status::kUndone;
+  state.undone_at = runs_.back().undone_at;
+  return state;
+}
+
+const ArcImportRecord::Run* ArcImportRecord::InterruptedRun() const {
+  auto it = std::ranges::find_if(runs_, &Run::in_progress);
+  return it == runs_.end() ? nullptr : &*it;
+}
+
+ArcImportRecord::Interrupted ArcImportRecord::FinishInterrupted(
+    const base::flat_set<std::string>& live_space_ids,
+    const base::flat_set<std::string>& live_sidebar_ids) {
+  auto run = std::ranges::find_if(runs_, &Run::in_progress);
+  if (run == runs_.end()) {
+    return Interrupted::kNone;
+  }
+  bool left = false;
+  auto keep_live = [&](auto& map, const base::flat_set<std::string>& live) {
+    for (auto it = map.begin(); it != map.end();) {
+      if (it->second.run_id != run->id) {
+        ++it;
+      } else if (!live.contains(it->second.rac_id)) {
+        it = map.erase(it);
+      } else {
+        left = true;
+        ++it;
+      }
+    }
+  };
+  keep_live(spaces_, live_space_ids);
+  keep_live(items_, live_sidebar_ids);
+  // The blank space is still there: the import never got to replace it.
+  if (live_space_ids.contains(run->replaced_blank_space)) {
+    run->replaced_blank_space.clear();
+  }
+  if (!left) {
+    runs_.erase(run);
+    return Interrupted::kDropped;
+  }
+  run->in_progress = false;
+  return Interrupted::kFinished;
+}
+
+std::vector<std::string> ArcImportRecord::SpacesOfRun(
+    std::string_view run_id) const {
+  std::vector<std::string> ids;
+  for (const auto& [arc_id, mapping] : spaces_) {
+    if (mapping.run_id == run_id) {
+      ids.push_back(mapping.rac_id);
+    }
+  }
+  return ids;
+}
+
+std::vector<std::string> ArcImportRecord::ItemsOfRun(std::string_view run_id,
+                                                     ItemKind kind) const {
+  std::vector<std::string> ids;
+  for (const auto& [arc_id, mapping] : items_) {
+    if (mapping.run_id == run_id && mapping.kind == kind) {
+      ids.push_back(mapping.rac_id);
+    }
+  }
+  return ids;
+}
+
+void ArcImportRecord::ForgetRemoved(
+    std::string_view run_id,
+    const base::flat_set<std::string>& removed,
+    base::Time now) {
+  bool left = false;
+  auto forget = [&](auto& map) {
+    for (auto it = map.begin(); it != map.end();) {
+      if (it->second.run_id != run_id) {
+        ++it;
+      } else if (removed.contains(it->second.rac_id)) {
+        it = map.erase(it);
+      } else {
+        left = true;
+        ++it;
+      }
+    }
+  };
+  forget(spaces_);
+  forget(items_);
+  if (left) {
+    return;
+  }
+  for (Run& run : runs_) {
+    if (run.id == run_id) {
+      run.undone = true;
+      run.undone_at = now;
+      run.in_progress = false;
+    }
+  }
+}
+
+}  // namespace rac

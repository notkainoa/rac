+TEST(ArcImportRecordTest, UndoableRunIsTheNewestNotUndone) {
+  ImportRun older = MakeRun("older", 1000);
+  older.undo_until = At(2000);
+  ImportRun newer = MakeRun("newer", 2000);
+  newer.undo_until = At(3000);
+
+  // Both in their deadline: the newest is returned.
+  {
+    ArcImportRecord record;
+    record.AddRun(older);
+    record.AddRun(newer);
+    const ImportRun* undoable = record.UndoableRun(At(1500));
+    ASSERT_TRUE(undoable);
+    EXPECT_EQ(undoable->id, "newer");
+  }
+
+  // Just before the deadline still counts.
+  {
+    ArcImportRecord record;
+    record.AddRun(older);
+    record.AddRun(newer);
+    const ImportRun* undoable = record.UndoableRun(At(2999));
+    ASSERT_TRUE(undoable);
+    EXPECT_EQ(undoable->id, "newer");
+  }
+
+  // The newest is undone: the older one is next, while in its deadline.
+  {
+    ImportRun undone = newer;
+    undone.undone = true;
+    ArcImportRecord record;
+    record.AddRun(older);
+    record.AddRun(undone);
+    ASSERT_TRUE(record.UndoableRun(At(1500)));
+    EXPECT_EQ(record.UndoableRun(At(1500))->id, "older");
+    EXPECT_FALSE(record.UndoableRun(At(2000)));
+    ASSERT_TRUE(record.NewestActiveRun());
+    EXPECT_EQ(record.NewestActiveRun()->id, "older");
+  }
+
+  // Both undone: nothing.
+  {
+    ImportRun undone_older = older;
+    undone_older.undone = true;
+    ImportRun undone_newer = newer;
+    undone_newer.undone = true;
+    ArcImportRecord record;
+    record.AddRun(undone_older);
+    record.AddRun(undone_newer);
+    EXPECT_FALSE(record.UndoableRun(At(1500)));
+    EXPECT_FALSE(record.NewestActiveRun());
+  }
+
+  // The newest is past its deadline. now == undo_until counts as past. An
+  // older run is never undone before a newer one that isn't undone.
+  {
+    ImportRun older_but_later = older;
+    older_but_later.undo_until = At(4000);
+    ArcImportRecord record;
+    record.AddRun(older_but_later);
+    record.AddRun(newer);
+    EXPECT_FALSE(record.UndoableRun(At(3000)));
+    EXPECT_FALSE(record.UndoableRun(At(3001)));
+  }
+
+  // The newest has no deadline.
+  {
+    ImportRun no_deadline = newer;
+    no_deadline.undo_until = base::Time();
+    ArcImportRecord record;
+    record.AddRun(older);
+    record.AddRun(no_deadline);
+    EXPECT_FALSE(record.UndoableRun(At(1500)));
+  }
+
+  // A single run in its deadline.
+  {
+    ArcImportRecord record;
+    record.AddRun(newer);
+    ASSERT_TRUE(record.UndoableRun(At(2500)));
+    EXPECT_EQ(record.UndoableRun(At(2500))->id, "newer");
+  }
+
+  // No runs.
+  {
+    ArcImportRecord record;
+    EXPECT_FALSE(record.UndoableRun(At(1500)));
+  }
+}

+  record.ForgetRemoved("cut", {"sp1"}, At(3000));
+  EXPECT_TRUE(record.FindRun("cut")->undone);
+  EXPECT_FALSE(record.FindRun("cut")->in_progress);
+  EXPECT_FALSE(record.InterruptedRun());
+}
+
+TEST(ArcImportRecordTest, CopyKeepsUnknownFields) {
+  constexpr char kJson[] = R"({
+    "version": 1,
+    "arc_profile": "default",
+    "future_key": {"keep": ["me", 1]},
+    "another_future_key": "text",
+    "spaces": {"s1": {"rac": "rac-s1", "run": "run-1"}}
+  })";
+  ArcImportRecord original = ParseOk(kJson);
+
+  std::optional<base::DictValue> source =
+      base::JSONReader::ReadDict(kJson, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(source.has_value());
+  const base::Value* expected_future = source->Find("future_key");
+  ASSERT_TRUE(expected_future);
+
+  auto expect_keeps_unknown = [&](const ArcImportRecord& record) {
+    base::DictValue written = SerializedDict(record);
+    const base::Value* future = written.Find("future_key");
+    ASSERT_TRUE(future);
+    EXPECT_EQ(*future, *expected_future);
+    ASSERT_TRUE(written.FindString("another_future_key"));
+    EXPECT_EQ(*written.FindString("another_future_key"), "text");
+  };
+
+  expect_keeps_unknown(original);
+
+  ArcImportRecord copy_constructed(original);
+  expect_keeps_unknown(copy_constructed);
+  ASSERT_TRUE(copy_constructed.FindSpace("s1"));
+
+  // Copy-assign over a record with its own, different unknown field.
+  ArcImportRecord assigned = ParseOk(R"({"version":1,"old_key":true})");
+  assigned = original;
+  expect_keeps_unknown(assigned);
+  EXPECT_FALSE(SerializedDict(assigned).Find("old_key"));
+  ASSERT_TRUE(assigned.FindSpace("s1"));
+
+  // The original is unchanged by the copies.
+  expect_keeps_unknown(original);
+
+  ArcImportRecord moved(std::move(copy_constructed));
+  expect_keeps_unknown(moved);
+}
+
+TEST(ArcImportRecordTest, MapItemOverwrites) {
+  ArcImportRecord record;
+  record.MapItem("arc-item", "rac-1", ItemKind::kPinnedTab, "run-1");
+  record.MapItem("arc-item", "rac-2", ItemKind::kFolder, "run-2");
+
+  const ArcImportRecord::ItemMapping* mapping = record.FindItem("arc-item");
+  ASSERT_TRUE(mapping);
+  EXPECT_EQ(mapping->rac_id, "rac-2");
+  EXPECT_EQ(mapping->kind, ItemKind::kFolder);
+  EXPECT_EQ(mapping->run_id, "run-2");
+  EXPECT_THAT(record.ItemsOfRun("run-1", ItemKind::kPinnedTab), IsEmpty());
+  EXPECT_THAT(record.ItemsOfRun("run-2", ItemKind::kFolder),
+              ElementsAre("rac-2"));
+
+  ArcImportRecord parsed = ParseOk(record.Serialize());
+  ASSERT_TRUE(parsed.FindItem("arc-item"));
+  EXPECT_EQ(parsed.FindItem("arc-item")->rac_id, "rac-2");
+  EXPECT_EQ(parsed.FindItem("arc-item")->kind, ItemKind::kFolder);
+}
+
+TEST(ArcImportRecordTest, MapSpaceOverwrites) {
+  ArcImportRecord record;
+  record.MapSpace("arc-space", "rac-1", "run-1");
+  record.MapSpace("arc-space", "rac-2", "run-2");
+
+  const ArcImportRecord::SpaceMapping* mapping = record.FindSpace("arc-space");
+  ASSERT_TRUE(mapping);
+  EXPECT_EQ(mapping->rac_id, "rac-2");
+  EXPECT_EQ(mapping->run_id, "run-2");
+  EXPECT_THAT(record.SpacesOfRun("run-1"), IsEmpty());
+  EXPECT_THAT(record.SpacesOfRun("run-2"), ElementsAre("rac-2"));
+}
+
+TEST(ArcImportRecordTest, LargeFileIsUnreadable) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath profile = temp.GetPath();
+  ASSERT_TRUE(base::CreateDirectory(ArcImportRecord::DirFor(profile)));
+
+  // One byte over the limit, so the file is never parsed.
+  const std::string text(ArcImportRecord::kMaxFileSize + 1, ' ');
+  ASSERT_TRUE(WriteText(ArcImportRecord::PathFor(profile), text));
+
+  EXPECT_EQ(ArcImportRecord::Read(profile).status, ReadStatus::kUnreadable);
+}
+
+TEST(ArcImportRecordTest, FileAtMaxSizeIsRead) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath profile = temp.GetPath();
+  ASSERT_TRUE(base::CreateDirectory(ArcImportRecord::DirFor(profile)));
+
+  std::string text = R"({"version":1})";
+  text.resize(ArcImportRecord::kMaxFileSize, ' ');
+  ASSERT_TRUE(WriteText(ArcImportRecord::PathFor(profile), text));
+
+  EXPECT_EQ(ArcImportRecord::Read(profile).status, ReadStatus::kOk);
+}
+
+// An item the run couldn't add because its id was taken: that id is live,
+// so FinishInterrupted() would keep the mapping, and Undo would remove the
+// other item. UnmapItem() forgets it, and only for the run that made it.
+TEST(ArcImportRecordTest, UnmapItemForgetsOnlyThatRunsMapping) {
+  ArcImportRecord record;
+  ImportRun run = MakeRun("now", 2000);
+  run.in_progress = true;
+  record.AddRun(run);
+  record.MapItem("taken", "someone-elses-id", ItemKind::kPinnedTab, "now");
+  record.MapItem("added", "pin-1", ItemKind::kPinnedTab, "now");
+  record.MapItem("older", "pin-0", ItemKind::kPinnedTab, "before");
+
+  EXPECT_FALSE(record.UnmapItem("older", "now"));
+  EXPECT_FALSE(record.UnmapItem("missing", "now"));
+  EXPECT_TRUE(record.UnmapItem("taken", "now"));
+  EXPECT_FALSE(record.FindItem("taken"));
+  EXPECT_TRUE(record.FindItem("older"));
+
+  EXPECT_EQ(record.FinishInterrupted({}, {"someone-elses-id", "pin-1"}),
+            ArcImportRecord::Interrupted::kFinished);
+  EXPECT_THAT(record.ItemsOfRun("now", ItemKind::kPinnedTab),
+              ElementsAre("pin-1"));
+}
+
+// Undo deleted a space the run made, and moved a folder of the run that
+// held the user's own pins out of it under a new id. The record follows the
+// folder, so the run's Undo still finds it, and once the user empties it a
+// later Undo takes it out and ends the run.
+TEST(ArcImportRecordTest, RemapItemFollowsAFolderUndoMoved) {
+  ArcImportRecord record;
+  record.AddRun(MakeRun("run", 1000));
+  record.MapSpace("arc-space", "space-1", "run");
+  record.MapItem("arc-folder", "folder-1", ItemKind::kFolder, "run");
+  record.MapItem("arc-pin", "pin-1", ItemKind::kPinnedTab, "run");
+  // Another run with the same rac id isn't touched.
+  record.MapItem("other-folder", "folder-1", ItemKind::kFolder, "other");
+
+  EXPECT_FALSE(record.RemapItem("run", "no-such-id", "x"));
+  EXPECT_TRUE(record.RemapItem("run", "folder-1", "folder-copy"));
+  ASSERT_TRUE(record.FindItem("arc-folder"));
+  EXPECT_EQ(record.FindItem("arc-folder")->rac_id, "folder-copy");
+  EXPECT_EQ(record.FindItem("arc-folder")->kind, ItemKind::kFolder);
+  EXPECT_EQ(record.FindItem("other-folder")->rac_id, "folder-1");
+
+  // The first Undo: the space and the run's pin went; the old folder id
+  // reads as removed, and the copy stays, holding the user's pins.
+  record.ForgetRemoved("run", {"space-1", "pin-1", "folder-1"}, At(2000));
+  EXPECT_THAT(record.ItemsOfRun("run", ItemKind::kFolder),
+              ElementsAre("folder-copy"));
+  EXPECT_FALSE(record.FindRun("run")->undone);
+  ASSERT_TRUE(record.UndoableRun(At(2000)));
+
+  // Saved and read back, the new id holds.
+  ArcImportRecord parsed = ParseOk(record.Serialize());
+  ASSERT_TRUE(parsed.FindItem("arc-folder"));
+  EXPECT_EQ(parsed.FindItem("arc-folder")->rac_id, "folder-copy");
+
+  // A later Undo, once the copy is empty and removed.
+  parsed.ForgetRemoved("run", {"folder-copy"}, At(3000));
+  EXPECT_TRUE(parsed.FindRun("run")->undone);
+  EXPECT_FALSE(parsed.FindItem("arc-folder"));
+}

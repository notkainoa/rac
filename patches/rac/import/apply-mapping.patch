+// ---------------------------------------------------------------------------
+// Putting kept pins back.
+
+TEST(ArcImportMappingTest, KeptPinsRecordWhereTheyWere) {
+  const std::vector<ArcUndoPinEntry> entries = {
+      UndoItem("r1"),
+      UndoItem("u1"),
+      UndoFolder("fa", {"r2", "ua1", "r3", "ua2"}),
+      UndoFolder("fb", {"ub1"}),
+      UndoItem("u2")};
+
+  const std::vector<ArcKeptPin> kept =
+      PlanKeptPins(entries, {"r1", "r2", "r3"});
+
+  ASSERT_EQ(kept.size(), 4u);
+  EXPECT_EQ(kept[0].index, 1u);
+  EXPECT_THAT(kept[0].item_indices, IsEmpty());
+  EXPECT_EQ(kept[1].folder_id, "fa");
+  EXPECT_EQ(kept[1].index, 2u);
+  EXPECT_THAT(kept[1].item_indices, ElementsAre(1u, 3u));
+  EXPECT_EQ(kept[2].index, 3u);
+  EXPECT_THAT(kept[2].item_indices, ElementsAre(0u));
+  EXPECT_EQ(kept[3].index, 4u);
+}
+
+// A pinned list as the sidebar holds it: entries that are an item id or a
+// folder with item ids.
+struct FakeEntry {
+  std::string id;
+  bool is_folder = false;
+  std::vector<std::string> items;
+
+  bool operator==(const FakeEntry&) const = default;
+};
+using FakeList = std::vector<FakeEntry>;
+
+// Moving kept pins out of `list`, as Undo does before deleting a space: a
+// loose item leaves; a folder loses its kept items, and goes if that
+// empties it, as SidebarItems removes a folder its last item leaves.
+FakeList MoveOut(FakeList list, const std::vector<ArcKeptPin>& kept) {
+  for (const ArcKeptPin& pin : kept) {
+    for (const std::string& id : pin.item_ids) {
+      for (FakeEntry& entry : list) {
+        std::erase(entry.items, id);
+      }
+      std::erase_if(list, [&](const FakeEntry& entry) {
+        return !entry.is_folder && entry.id == id;
+      });
+    }
+    std::erase_if(list, [&](const FakeEntry& entry) {
+      return entry.is_folder && entry.id == pin.folder_id &&
+             entry.items.empty();
+    });
+  }
+  return list;
+}
+
+// Putting them back as PutKeptPinsBack() does: in order, each at its index,
+// a removed folder made again in its place first.
+FakeList PutBack(FakeList list, const std::vector<ArcKeptPin>& kept) {
+  for (const ArcKeptPin& pin : kept) {
+    if (pin.folder_id.empty()) {
+      FakeEntry item{pin.item_ids.front()};
+      list.insert(list.begin() + std::min(pin.index, list.size()), item);
+      continue;
+    }
+    auto folder = std::ranges::find(list, pin.folder_id, &FakeEntry::id);
+    if (folder == list.end()) {
+      folder = list.insert(list.begin() + std::min(pin.index, list.size()),
+                           FakeEntry{pin.folder_id, true});
+    }
+    for (size_t j = 0; j < pin.item_ids.size(); ++j) {
+      std::vector<std::string>& items = folder->items;
+      items.insert(items.begin() + std::min(pin.item_indices[j], items.size()),
+                   pin.item_ids[j]);
+    }
+  }
+  return list;
+}
+
+TEST(ArcImportMappingTest, KeptPinsPutBackRebuildTheList) {
+  const FakeList original = {
+      {"u0"},
+      {"r1"},
+      {"fa", true, {"r2", "ua1", "r3", "ua2"}},
+      {"u1"},
+      {"fb", true, {"ub1", "ub2"}},
+      {"rf", true, {"r4"}},
+      {"fc", true, {"uc1", "r5"}},
+      {"u2"}};
+  std::vector<ArcUndoPinEntry> entries;
+  for (const FakeEntry& entry : original) {
+    entries.push_back(entry.is_folder ? UndoFolder(entry.id, entry.items)
+                                      : UndoItem(entry.id));
+  }
+  const base::flat_set<std::string> run_ids = {"r1", "r2", "r3",
+                                               "r4", "r5", "rf"};
+  const std::vector<ArcKeptPin> kept = PlanKeptPins(entries, run_ids);
+
+  // What stays in the space while it's deleted: the run's own entries, and
+  // the folders that still hold some of them.
+  const FakeList moved_out = MoveOut(original, kept);
+  EXPECT_EQ(moved_out,
+            (FakeList{{"r1"},
+                      {"fa", true, {"r2", "r3"}},
+                      {"rf", true, {"r4"}},
+                      {"fc", true, {"r5"}}}));
+
+  // The space stayed: everything goes back exactly where it was.
+  EXPECT_EQ(PutBack(moved_out, kept), original);
+}
+
+TEST(ArcUndoOutcomeTest, StartsWithNothingToUndoAndNoNames) {
+  const ArcUndoOutcome outcome;
+  EXPECT_EQ(outcome.result, ArcUndoResult::kNothingToUndo);
+  EXPECT_TRUE(outcome.kept_spaces.empty());
+  EXPECT_TRUE(outcome.blocked_profiles.empty());
+}
+
+TEST(ArcUndoOutcomeTest, CopiesAndMovesKeepTheNames) {
+  ArcUndoOutcome outcome;
+  outcome.result = ArcUndoResult::kPartlyUndone;
+  outcome.kept_spaces = {u"Work", u"Space 3"};
+  outcome.blocked_profiles = {u"Personal"};
+
+  const ArcUndoOutcome copy = outcome;
+  EXPECT_EQ(copy.result, ArcUndoResult::kPartlyUndone);
+  EXPECT_THAT(copy.kept_spaces, testing::ElementsAre(u"Work", u"Space 3"));
+  EXPECT_THAT(copy.blocked_profiles, testing::ElementsAre(u"Personal"));
+
+  const ArcUndoOutcome moved = std::move(outcome);
+  EXPECT_EQ(moved.kept_spaces, copy.kept_spaces);
+  EXPECT_EQ(moved.blocked_profiles, copy.blocked_profiles);
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_TYPES_H_
+#define CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_TYPES_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+
+// What the import screens send to the Arc applier and get back from it. Plain
+// structs: no profile, no browser state. The applier lives under
+// chrome/browser/ui/rac/import/.
+
+namespace rac {
+
+// The choices on the Arc step.
+struct ArcImportOptions {
+  ArcImportOptions();
+  ArcImportOptions(const ArcImportOptions&);
+  ArcImportOptions& operator=(const ArcImportOptions&);
+  ~ArcImportOptions();
+
+  // ImportProfile::source_key of each profile left unchecked. A checked
+  // default profile goes into the profile that started the import; other
+  // checked ones go into new rac profiles, made by the sign-ins step.
+  base::flat_set<std::string> skipped_profile_keys;
+  // Arc's Today tabs, created unloaded, for spaces this import creates.
+  bool open_tabs = true;
+  // Arc's browsing history, through Helium's importer, history only.
+  bool history = true;
+  // Ignored until the sign-ins step is built.
+  bool sign_ins = false;
+};
+
+// Sent while an import runs. A fast import sends these in a burst; the page
+// decides what to show.
+struct ArcImportProgress {
+  enum class Step {
+    // DataBackups::CreateSnapshot, before anything is written.
+    kSnapshot,
+    // One event per Arc space, written or already there.
+    kSpaces,
+    // Helium's importer, run separately.
+    kHistory,
+    // During the sign-ins step, one event per profile.
+    kSignIns,
+    // macOS is showing its Keychain prompt.
+    kWaitingForMac,
+  };
+
+  ArcImportProgress();
+  ArcImportProgress(const ArcImportProgress&);
+  ArcImportProgress& operator=(const ArcImportProgress&);
+  ~ArcImportProgress();
+
+  Step step = Step::kSnapshot;
+  // kSpaces: Arc spaces handled so far and in all, across checked profiles.
+  int done = 0;
+  int total = 0;
+  // kSpaces: ImportSpace::source_id just handled.
+  std::string space_id;
+  // kSpaces: the name the sidebar shows for it, with rac's fallback for an
+  // unnamed space. UTF-8.
+  std::string space_title;
+};
+
+// What an import wrote, or would write, into one profile. Every count is of
+// what was actually written, so a rerun counts only what's new.
+struct ArcImportCounts {
+  // Came over.
+  int spaces = 0;
+  int pinned_tabs = 0;
+  // rac folders made, including lifted ones.
+  int folders = 0;
+  int favorites = 0;
+  int open_tabs = 0;
+
+  // Changed on the way.
+  // Arc folders inside folders, lifted to the top as "Parent › Child".
+  int nested_folders = 0;
+  // The first lifted folder's name whose path has a title at every level,
+  // for the result screen. Empty if none.
+  std::string first_flattened_name;
+  // Split views and tab groups whose tabs came over as separate tabs.
+  int split_views = 0;
+  int tab_groups = 0;
+
+  // Left out by the applier. The reader's own skips are in ImportReport.
+  // URLs GURL rejects. Belongs on the "couldn't be read" line.
+  int invalid_urls = 0;
+  // Valid URLs rac won't open from the sidebar: javascript:, data:, Arc's
+  // own pages, extension pages, and so on.
+  int unsupported_urls = 0;
+  // Favorites already in the profile, by URL. Not added a second time.
+  int favorites_already_there = 0;
+  // Already imported by an earlier run (the import record maps them).
+  int already_imported = 0;
+  // In a space or folder an earlier import made and the user deleted since.
+  // Not brought back.
+  int removed_since = 0;
+  // Open tabs of spaces an earlier run made. Only a new space gets its open
+  // tabs, so a rerun never adds tabs to a space the user has been using.
+  int open_tabs_not_reopened = 0;
+
+  // Whether applying writes anything at all.
+  bool AddsAnything() const {
+    return spaces || pinned_tabs || folders || favorites || open_tabs;
+  }
+  ArcImportCounts& operator+=(const ArcImportCounts& other);
+};
+
+// Why an import into a profile changed nothing.
+enum class ArcImportFailure {
+  kNone,
+  // Another import, Undo, or restore is running.
+  kBusy,
+  // The pre-import snapshot couldn't be written.
+  kSnapshotFailed,
+  // The import record was written by a newer rac. Importing again could
+  // lose what it records.
+  kRecordTooNew,
+  // The import record exists but couldn't be read, so it was left alone
+  // and the import refused to run.
+  kRecordUnreadable,
+  // The import record couldn't be saved before the sidebar was touched, so
+  // nothing was imported.
+  kRecordNotSaved,
+  // Imports and Undo go into regular profiles only.
+  kOffTheRecord,
+  // The profile went away while importing.
+  kProfileGone,
+};
+
+// One Arc profile's part of an import.
+struct ArcProfileResult {
+  enum class Status {
+    kDone,
+    kNothingNew,
+    // Unchecked on the Arc step.
+    kSkipped,
+    // Not the default profile, and no sign-ins step to make its rac profile
+    // yet.
+    kNeedsProfile,
+    kFailed,
+  };
+  enum class History {
+    kNotRequested,
+    kImported,
+    // An earlier run of this import already brought it.
+    kAlreadyImported,
+    // Arc has no history file for this profile, or no profile folder.
+    kNotAvailable,
+    kFailed,
+  };
+
+  ArcProfileResult();
+  ArcProfileResult(const ArcProfileResult&);
+  ArcProfileResult& operator=(const ArcProfileResult&);
+  ~ArcProfileResult();
+
+  std::string source_key;
+  Status status = Status::kSkipped;
+  // kFailed only.
+  ArcImportFailure failure = ArcImportFailure::kNone;
+  // The rac profile it went into. Empty when nothing went anywhere.
+  base::FilePath profile_path;
+  // True if the sign-ins step made that profile for this import.
+  bool new_profile = false;
+  ArcImportCounts counts;
+  History history = History::kNotRequested;
+  // Arc's pinned extensions. Kept in the import record, never installed.
+  int pinned_extensions = 0;
+  // Until when this profile's part can be undone. Unset if nothing was
+  // written.
+  std::optional<base::Time> undo_until;
+};
+
+// Sent once, when everything has ended.
+struct ArcImportResult {
+  enum class Status {
+    kDone,
+    // Every checked profile was already imported, Arc has nothing new, and
+    // no history came over either.
+    kNothingNew,
+    // Nothing was changed anywhere: either nothing was written, or what was
+    // written was taken back.
+    kFailed,
+  };
+  using Failure = ArcImportFailure;
+
+  ArcImportResult();
+  ArcImportResult(const ArcImportResult&);
+  ArcImportResult& operator=(const ArcImportResult&);
+  ~ArcImportResult();
+
+  Status status = Status::kFailed;
+  Failure failure = ArcImportFailure::kNone;
+  // All profiles together.
+  ArcImportCounts counts;
+  std::vector<ArcProfileResult> profiles;
+  // Routing rules or the auto-archive setting were kept for later.
+  bool handoffs_saved = false;
+  int pinned_extensions = 0;
+  // Until when "Undo Arc import" works: the latest of the profiles'. Unset
+  // when nothing was written.
+  std::optional<base::Time> undo_until;
+};
+
+// For onboarding and Settings. Each profile has its own: Undo there takes
+// out that profile's newest import that isn't undone yet, and the parts of
+// the same import in the profiles it made.
+struct ArcImportState {
+  enum class Status {
+    // This profile never received an Arc import.
+    kNone,
+    // Undo would take out the newest import: until `undo_until`.
+    kUndoable,
+    // Every import into this profile was undone, the newest at `undone_at`.
+    kUndone,
+    // The newest import that isn't undone is past its 7 days.
+    kExpired,
+  };
+
+  Status status = Status::kNone;
+  // Null if this profile never received an Arc import.
+  std::optional<base::Time> last_import;
+  // kUndoable only.
+  std::optional<base::Time> undo_until;
+  // kUndoable only: when the pre-import snapshot was taken, for "Your
+  // sidebar goes back to how it was on <date>".
+  std::optional<base::Time> undo_snapshot_time;
+  // kUndone only. Null if not undone, or if the record predates the field.
+  base::Time undone_at;
+};
+
+enum class ArcUndoResult {
+  kUndone,
+  // Some of it stayed, and Undo can be tried again: a page asked before
+  // closing and the user stayed, so its space stayed as it was, with the
+  // user's own pins in it; or another profile the import touched has had a
+  // newer import since, which has to be undone there first. Everything else
+  // was undone.
+  kPartlyUndone,
+  // Another import, Undo, or restore is running. Nothing changed.
+  kBusy,
+  // The 7 days are over. Nothing changed.
+  kExpired,
+  // No import to undo. Nothing changed.
+  kNothingToUndo,
+  // The import record couldn't be read or saved. Nothing changed.
+  kFailed,
+};
+
+// What Undo reports: the result, and for kPartlyUndone what stayed, as the
+// copy needs it. Both lists are empty for every other result.
+struct ArcUndoOutcome {
+  ArcUndoOutcome();
+  ArcUndoOutcome(const ArcUndoOutcome&);
+  ArcUndoOutcome& operator=(const ArcUndoOutcome&);
+  ArcUndoOutcome(ArcUndoOutcome&&);
+  ArcUndoOutcome& operator=(ArcUndoOutcome&&);
+  ~ArcUndoOutcome();
+
+  ArcUndoResult result = ArcUndoResult::kNothingToUndo;
+  // Spaces a page kept open (the user chose to stay), in sidebar order, as
+  // display names with rac's "Space N" fallback for empty names.
+  std::vector<std::u16string> kept_spaces;
+  // Display names of other profiles whose newer Arc import has to be undone
+  // there first.
+  std::vector<std::u16string> blocked_profiles;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_ARC_IMPORT_TYPES_H_

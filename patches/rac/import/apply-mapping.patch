+// Parses `json` and expects kOk.
+ArcImportRecord ParseOk(std::string_view json) {
+  ArcImportRecord::ReadResult result = ArcImportRecord::Parse(json);
+  EXPECT_EQ(result.status, ReadStatus::kOk);
+  return std::move(result.record);
+}
+
+// Serializes `record` and reads the text back as a dict.
+base::DictValue SerializedDict(const ArcImportRecord& record) {
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(record.Serialize(), base::JSON_PARSE_RFC);
+  EXPECT_TRUE(dict.has_value());
+  return dict ? std::move(*dict) : base::DictValue();
+}
+
+bool WriteText(const base::FilePath& path, std::string_view text) {
+  return base::WriteFile(path, text);
+}
+
+// The permission bits of `path`, or -1.
+int ModeOf(const base::FilePath& path) {
+  int mode = 0;
+  if (!base::GetPosixFilePermissions(path, &mode)) {
+    return -1;
+  }
+  return mode & 0777;
+}
+
+// Base names of everything directly inside `dir`, files and folders.
+std::vector<std::string> NamesIn(const base::FilePath& dir) {
+  std::vector<std::string> names;
+  base::FileEnumerator enumerator(
+      dir, /*recursive=*/false,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    names.push_back(path.BaseName().value());
+  }
+  return names;
+}

+      MapArcProfile(second_read, base, live, ArcImportOptions());
+  TakePlannedRacIds(none, base, "run-2");
+  EXPECT_THAT(none.spaces, IsEmpty());
+  EXPECT_TRUE(none.IsEmpty());
+}

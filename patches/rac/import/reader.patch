+
+// Where an Arc install keeps the files the reader uses.
+struct ArcSourcePaths {
+  // The current user's Arc.
+  static ArcSourcePaths ForCurrentUser();
+  // A folder laid out like Arc's support folder, holding Arc's defaults too,
+  // as `company.thebrowser.Browser.plist`. For tests and copies of Arc's
+  // files.
+  static ArcSourcePaths ForSourceRoot(const base::FilePath& root);
+
+  // Arc's support folder: `StorableSidebar.json`, `StorableLinkRouting.json`,
+  // `StorableArchiveItems.json`, `SidebarItemsFaviconCache/`, and Arc's
+  // Chromium profiles in `User Data/`.
+  base::FilePath support_dir;
+  // Arc's defaults domain as a property list file. Read as a file, never
+  // through NSUserDefaults.
+  base::FilePath defaults_plist;
+};
+
+// Why Arc's sidebar couldn't be read. Only `StorableSidebar.json` can fail
+// the read; problems with other files are reported in the plan.
+enum class ArcReadError {
+  // There's no `StorableSidebar.json`, so Arc isn't installed or never ran.
+  kNotFound,
+  kTooLarge,
+  // The file exists but couldn't be read.
+  kUnreadable,
+  // Not JSON, or not a JSON object.
+  kMalformed,
+  // JSON, but without Arc's list of spaces.
+  kUnexpectedShape,
+};
+
+// Size and depth limits, so a damaged or hostile file can't exhaust memory
+// or the stack. Tests lower them.
+struct ArcReadLimits {
+  size_t max_sidebar_bytes = 64 * 1024 * 1024;
+  // Arc's Chromium `Local State` and `Preferences`.
+  size_t max_profile_file_bytes = 32 * 1024 * 1024;
+  // `StorableLinkRouting.json` and the defaults file.
+  size_t max_settings_file_bytes = 4 * 1024 * 1024;
+  size_t max_json_depth = 64;
+  // Folder nesting. Items below it are left out and counted.
+  int max_item_depth = 16;
+  // Spaces and favorites for profiles past this many are left out.
+  size_t max_profiles = 32;
+  // A tab URL longer than this is dropped as invalid.
+  size_t max_url_chars = url::kMaxURLChars;
+  size_t max_favicon_files = 100'000;
+};

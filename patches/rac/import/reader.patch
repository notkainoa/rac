+
+import("//testing/test.gni")
+
+# The import plan, a source-neutral tree of what another browser has.
+source_set("plan") {
+  sources = [
+    "import_plan.cc",
+    "import_plan.h",
+  ]
+  public_deps = [ "//base" ]
+}
+
+# Reads Arc's files into a plan. Pure parsing: no profile or browser state,
+# so it builds and tests without the browser.
+source_set("arc_reader") {
+  sources = [
+    "arc_defaults.h",
+    "arc_defaults_mac.mm",
+    "arc_reader.cc",
+    "arc_reader.h",
+  ]
+  public_deps = [
+    ":plan",
+    "//base",
+  ]
+  deps = [
+    "//third_party/boringssl",
+    "//url",
+  ]
+  frameworks = [ "Foundation.framework" ]
+}
+
+# Where the import reads Arc from, with the dev-only switch.
+source_set("arc_source") {
+  sources = [
+    "arc_source_root.cc",
+    "arc_source_root.h",
+  ]
+  public_deps = [ ":arc_reader" ]
+  deps = [
+    "//base",
+    "//chrome/browser/rac/dev:buildflags",
+  ]
+}
+
+# Build with `autoninja -C out/Default
+# chrome/browser/rac/import:rac_import_unittests`. It's separate from
+# Chromium's unit_tests, which takes hours to build.
+test("rac_import_unittests") {
+  sources = [
+    "arc_reader_unittest.cc",
+    "arc_source_root_unittest.cc",
+  ]
+  deps = [
+    ":arc_reader",
+    ":arc_source",
+    "//base",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+    "//chrome/browser/rac/dev:buildflags",
+    "//testing/gmock",
+    "//testing/gtest",
+  ]
+  data = [ "//chrome/test/data/rac/import/" ]
+}

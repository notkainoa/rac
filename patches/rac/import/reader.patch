+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_IMPORT_IMPORT_PLAN_H_
+#define CHROME_BROWSER_RAC_IMPORT_IMPORT_PLAN_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+
+// What a reader found in another browser's files, before anything is written.
+//
+// A reader (arc_reader.h; Zen and others later) fills in an ImportPlan. The
+// import screens show it, and the applier maps it onto rac's spaces,
+// favorites, and pinned tabs. The plan is faithful to the source: it keeps
+// nested folders, split views, and tab groups as they were, and the applier
+// decides how to flatten them. Nothing here touches a profile, so a plan can
+// be built on a background sequence, copied, and dropped freely.
+//
+// Strings are UTF-8 as the source stored them. URLs are not parsed or
+// checked; the applier does that. This header is owned by the import reader
+// stream: other code reads it, and asks before changing it.
+
+namespace rac {
+
+// Which browser a plan came from.
+enum class ImportSource {
+  kArc,
+};
+
+// One color, as the source stored it. Nothing is clamped or converted: Arc's
+// colors are `extendedSRGB` (sRGB primaries), so a wide-gamut channel may be
+// below 0 or above 1. Gamut mapping into the display's range is the job of a
+// later step, which should look at `color_space`. Channels are always finite;
+// a reader treats a color with a NaN or infinite channel as missing.
+struct ImportColor {
+  double red = 0;
+  double green = 0;
+  double blue = 0;
+  double alpha = 1;
+  // The source's name for the color space, such as "extendedSRGB". Empty if
+  // the source didn't give one.
+  std::string color_space;
+
+  bool operator==(const ImportColor&) const = default;
+};
+
+// One look of a space's background: up to two colors, which rac's themes can
+// show, and the rest kept as raw JSON for later use.
+struct ImportThemeVariant {
+  // Whether the space's content is drawn in light or dark mode over this
+  // background. Arc: `contentOverBackgroundAppearance`. In real Arc data a
+  // light background says "light" and a darker one "dark", so kLight means
+  // light mode (dark text).
+  enum class Content { kUnknown, kLight, kDark };
+
+  // Where `color1` and `color2` came from.
+  enum class Origin {
+    // No colors the reader understood. `content` and `raw_json` may still be
+    // set.
+    kUnknown,
+    // A gradient: its first two base colors. Arc: `blendedGradient`.
+    kGradient,
+    // One flat color, in `color1`. Arc: `blendedSingleColor`.
+    kSingleColor,
+    // Not the background itself: the background had no colors, so the
+    // reader picked them from the source's palette, and `content` from how
+    // light `color1` is. `raw_json` is empty; the palette is in
+    // `ImportTheme::raw_json`. Arc: `primaryColorPalette`.
+    kPalette,
+  };
+
+  ImportThemeVariant();
+  ImportThemeVariant(const ImportThemeVariant&);
+  ImportThemeVariant(ImportThemeVariant&&) noexcept;
+  ImportThemeVariant& operator=(const ImportThemeVariant&);
+  ImportThemeVariant& operator=(ImportThemeVariant&&) noexcept;
+  ~ImportThemeVariant();
+
+  // The first and second colors, as `origin` says. `color2` is empty when
+  // there is only one.
+  std::optional<ImportColor> color1;
+  std::optional<ImportColor> color2;
+  Origin origin = Origin::kUnknown;
+  Content content = Content::kUnknown;
+  bool vibrant = false;
+
+  // The whole variant as the source stored it, as compact JSON: overlay
+  // colors, intensity, noise, and anything else a mapping drops. Empty if
+  // there was none.
+  std::string raw_json;
+};
+
+// A space's background. Arc stores either one look for both light and dark
+// mode, or one look for each.
+struct ImportTheme {
+  enum class Kind {
+    // The source had no theme, or none this reader understood.
+    kNone,
+    // `single` applies in both light and dark mode. Also a theme picked
+    // from the source's palette; see `ImportThemeVariant::Origin::kPalette`.
+    kSingle,
+    // `light` and `dark` each apply in their mode. Either may be missing.
+    kAppearanceBased,
+  };
+
+  ImportTheme();
+  ImportTheme(const ImportTheme&);
+  ImportTheme(ImportTheme&&) noexcept;
+  ImportTheme& operator=(const ImportTheme&);
+  ImportTheme& operator=(ImportTheme&&) noexcept;
+  ~ImportTheme();
+
+  Kind kind = Kind::kNone;
+  std::optional<ImportThemeVariant> single;
+  std::optional<ImportThemeVariant> light;
+  std::optional<ImportThemeVariant> dark;
+
+  // The source's whole theme as compact JSON, including what no variant
+  // uses, for later theme work. Arc: `customInfo.windowTheme`, with its
+  // `background`, `primaryColorPalette`, and `semanticColorPalette`. May be
+  // set when `kind` is kNone. Empty if the source had no theme.
+  std::string raw_json;
+};
+
+// A tab or a folder in a sidebar list.
+struct ImportItem {
+  enum class Kind { kTab, kFolder };
+
+  // Where a folder came from. Split views and tab groups arrive as folders of
+  // tabs so the tree stays faithful; the applier flattens them.
+  enum class Group { kNone, kSplitView, kTabGroup };
+
+  ImportItem();
+  ImportItem(const ImportItem&);
+  ImportItem(ImportItem&&) noexcept;
+  ImportItem& operator=(const ImportItem&);
+  ImportItem& operator=(ImportItem&&) noexcept;
+  ~ImportItem();
+
+  Kind kind = Kind::kTab;
+
+  // The source's id for the item. Arc: the sidebar item id. Stable across
+  // reads, so the applier can record what it already imported. An opaque
+  // string: Arc's are often UUIDs but not always, and some look like URLs.
+  std::string source_id;
+
+  // When the item was created, or null if the source didn't say.
+  base::Time created;
+
+  // The name the user gave the item. For a tab, empty means "show the page
+  // title". For a folder, empty means the source had no name.
+  std::string title;
+
+  // Tabs only.
+  std::string url;
+  // The page's own title when it was saved.
+  std::string page_title;
+  // A favicon the source cached for this tab, as an existing file. Empty if
+  // there is none. Not read or decoded; the applier checks it is an image.
+  base::FilePath favicon_path;
+  // An emoji the user chose as the tab's icon, read like a space's `emoji`.
+  // Empty if the tab shows its favicon.
+  std::string icon_emoji;
+
+  // Folders only.
+  Group group = Group::kNone;
+  std::vector<ImportItem> children;
+};
+
+// A space and its lists.
+struct ImportSpace {
+  ImportSpace();
+  ImportSpace(const ImportSpace&);
+  ImportSpace(ImportSpace&&) noexcept;
+  ImportSpace& operator=(const ImportSpace&);
+  ImportSpace& operator=(ImportSpace&&) noexcept;
+  ~ImportSpace();
+
+  // The source's id for the space. Arc: the space id. Opaque, like
+  // `ImportItem::source_id`.
+  std::string source_id;
+  // Empty if the source has no name for it. The applier picks a fallback.
+  // Two spaces may share a title; they are still two spaces.
+  std::string title;
+  // One emoji, possibly several code points (ZWJ sequences, flags). Empty if
+  // the space has no emoji.
+  std::string emoji;
+  ImportTheme theme;
+
+  // Pinned tabs and folders, in sidebar order.
+  std::vector<ImportItem> pinned;
+  // Open tabs, in sidebar order. Arc: the "Today" section. Tab groups and
+  // split views here arrive as folders with a `group`.
+  std::vector<ImportItem> open_tabs;
+};
+
+// A profile of the source browser. Each becomes one rac profile.
+struct ImportProfile {
+  ImportProfile();
+  ImportProfile(const ImportProfile&);
+  ImportProfile(ImportProfile&&) noexcept;
+  ImportProfile& operator=(const ImportProfile&);
+  ImportProfile& operator=(ImportProfile&&) noexcept;
+  ~ImportProfile();
+
+  // Identifies the profile within this plan, and across reads of the same
+  // source. Arc: "default", "custom:<directory>", or "raw:<json>" for a
+  // profile value this reader doesn't recognize.
+  std::string source_key;
+
+  // The name the source shows for the profile, or empty if it has none. The
+  // import screens pick a fallback.
+  std::string display_name;
+
+  // The default profile goes into the current rac profile. There is at most
+  // one per plan.
+  bool is_default = false;
+
+  // The source's own Chromium profile folder, such as "Default" or
+  // "Profile 1", for later steps that read it (sign-ins). Always a single
+  // folder name; empty if unknown.
+  std::string directory;
+
+  // Favorites, shared by the profile's spaces, in order. Arc: Top Apps.
+  std::vector<ImportItem> favorites;
+
+  // In the source's order.
+  std::vector<ImportSpace> spaces;
+
+  // Extensions pinned to the toolbar, as extension ids, in order. A hand-off:
+  // the applier passes them on and doesn't install anything.
+  std::vector<std::string> pinned_extension_ids;
+};
+
+// Settings that other plans pick up later. Kept, not applied now.
+struct ImportHandoffs {
+  ImportHandoffs();
+  ImportHandoffs(const ImportHandoffs&);
+  ImportHandoffs(ImportHandoffs&&) noexcept;
+  ImportHandoffs& operator=(const ImportHandoffs&);
+  ImportHandoffs& operator=(ImportHandoffs&&) noexcept;
+  ~ImportHandoffs();
+
+  // Link routing rules as raw compact JSON, one string per rule, for the
+  // link hand-off feature. Arc: `StorableLinkRouting.json` `rules[]`.
+  // Destinations name source space ids and profiles.
+  std::vector<std::string> routing_rules_json;
+  // Where links go when no rule matches, as raw JSON. Empty if unset.
+  std::string routing_default_json;
+
+  // How long an idle open tab lives before it's archived, for the tab
+  // archive feature.
+  // `auto_archive_raw` is the source's value, such as "sevenDays";
+  // `auto_archive_after` is set only when the reader knows that value.
+  std::string auto_archive_raw;
+  std::optional<base::TimeDelta> auto_archive_after;
+
+  // The source's archive of closed tabs, which a later step may read from
+  // the source folder. Set only if the file exists; it isn't read now.
+  base::FilePath archive_path;
+};
+
+// Non-fatal problems: a file that exists but couldn't be used. A missing
+// optional file is normal and isn't reported.
+enum class ImportIssue {
+  kRoutingRulesUnreadable,
+  kSettingsUnreadable,
+  kExtensionsUnreadable,
+  kProfileNamesUnreadable,
+};
+
+// Counts for the result screen. Items counted under "skipped" are not in the
+// plan; the rest are.
+struct ImportReport {
+  ImportReport();
+  ImportReport(const ImportReport&);
+  ImportReport(ImportReport&&) noexcept;
+  ImportReport& operator=(const ImportReport&);
+  ImportReport& operator=(ImportReport&&) noexcept;
+  ~ImportReport();
+
+  int profiles = 0;
+  int spaces = 0;
+  // Tabs in favorites, pinned lists, and open tabs, including inside folders.
+  int favorites = 0;
+  int pinned_tabs = 0;
+  int open_tabs = 0;
+  // Folders with `group == kNone`.
+  int folders = 0;
+  // Folders inside another folder, at any depth. rac's folders are one level
+  // deep, so the applier flattens these.
+  int nested_folders = 0;
+  int split_views = 0;
+  int tab_groups = 0;
+
+  // The first nested folder in reading order (spaces in order, each one's
+  // pinned then open tabs, then favorites) whose folders all have titles,
+  // as its folder titles from the top joined with " › " (U+203A), such as
+  // "Parent › Child". An example for the result screen. Empty if there is
+  // none.
+  std::string first_nested_folder_path;
+
+  // Skipped, with what they held. Not damage: the source has these, and rac
+  // has nothing to put them in. Arc's own onboarding item ("Welcome to
+  // Arc") is dropped without being counted anywhere.
+  int skipped_live_folders = 0;
+  int skipped_easels = 0;
+  int skipped_notes = 0;
+  int skipped_unknown = 0;
+  // Tabs with no URL at all.
+  int skipped_tabs_without_url = 0;
+
+  // Damage in the source, repaired by leaving things out.
+  // A child id that names no item.
+  int missing_items = 0;
+  // An item listed under itself, or listed in two places (kept in the first).
+  int repeated_items = 0;
+  // Items below the depth limit, dropped with their children.
+  int too_deep = 0;
+  // Malformed entries in the source's lists.
+  int malformed_entries = 0;
+  // Tabs whose URL is there but is empty, not a string, or longer than the
+  // reader's limit. The reader doesn't parse URLs; the applier drops ones
+  // that don't parse and counts its own.
+  int invalid_urls = 0;
+
+  // All the damage above, for one "some items couldn't be read" line.
+  int damage_total() const {
+    return missing_items + repeated_items + too_deep + malformed_entries +
+           invalid_urls;
+  }
+
+  std::vector<ImportIssue> issues;
+};
+
+struct ImportPlan {
+  ImportPlan();
+  ImportPlan(const ImportPlan&);
+  ImportPlan(ImportPlan&&) noexcept;
+  ImportPlan& operator=(const ImportPlan&);
+  ImportPlan& operator=(ImportPlan&&) noexcept;
+  ~ImportPlan();
+
+  ImportSource source = ImportSource::kArc;
+  // The default profile first, then the others in the source's order.
+  std::vector<ImportProfile> profiles;
+  ImportHandoffs handoffs;
+  ImportReport report;
+
+  // The folder the reader read from (Arc: its support folder), so later steps
+  // such as history import read from the same place. Absolute. Files named in
+  // the plan, such as `favicon_path` and `handoffs.archive_path`, are under
+  // it.
+  base::FilePath source_dir;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_IMPORT_IMPORT_PLAN_H_

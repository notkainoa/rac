+      R"json(["pppppppppppppppppppppppppppppppp"]}})json";
+  // Where an unchecked name would lead: outside `User Data`, and deeper.
+  WriteTo("evil/Preferences", kIds);
+  WriteTo("User Data/a/b/Preferences", kIds);
+  WriteTo("User Data/Profile 2/Preferences", kIds);
+  WriteTo("User Data/Local State",
+          R"json({"profile":{"info_cache":{"../evil":{"name":"x"},)json"
+          R"json("a/b":{"name":"y"},"Profile 2":{"name":"ok"}}}})json");
+
+  const std::string long_name(256, 'x');
+  for (const std::string& name : {std::string("../evil"), std::string("a/b"),
+                                  std::string(".."), std::string("."),
+                                  long_name, std::string("Profile 2")}) {
+    SCOPED_TRACE(name);
+    WriteTo("StorableSidebar.json",
+            SidebarJson(base::StrCat(
+                {R"json({"custom":{"_0":{"directoryBasename":")json", name,
+                 R"json("}}})json"})));
+    base::expected<ImportPlan, ArcReadError> result = ReadArc(Paths());
+    ASSERT_TRUE(result.has_value());
+    ASSERT_EQ(result->profiles.size(), 1u);

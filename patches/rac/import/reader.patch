+namespace rac {
+
+namespace {
+
+constexpr base::FilePath::CharType kSidebarFile[] =
+    FILE_PATH_LITERAL("StorableSidebar.json");
+constexpr base::FilePath::CharType kLinkRoutingFile[] =
+    FILE_PATH_LITERAL("StorableLinkRouting.json");
+constexpr base::FilePath::CharType kArchiveFile[] =
+    FILE_PATH_LITERAL("StorableArchiveItems.json");
+constexpr base::FilePath::CharType kFaviconDir[] =
+    FILE_PATH_LITERAL("SidebarItemsFaviconCache");
+constexpr base::FilePath::CharType kUserDataDir[] =
+    FILE_PATH_LITERAL("User Data");
+constexpr base::FilePath::CharType kLocalStateFile[] =
+    FILE_PATH_LITERAL("Local State");
+constexpr base::FilePath::CharType kPreferencesFile[] =
+    FILE_PATH_LITERAL("Preferences");
+constexpr base::FilePath::CharType kDefaultsFile[] =
+    FILE_PATH_LITERAL("company.thebrowser.Browser.plist");
+
+// Arc stores dates as seconds since 2001-01-01 UTC, Apple's reference date.
+constexpr double kSecondsFrom1970To2001 = 978307200;
+
+// A ZWJ family emoji is about 25 bytes; anything far longer isn't one emoji.
+constexpr size_t kMaxEmojiBytes = 64;
+
+// How deep to look inside a `custom` profile value for its folder name.
+constexpr int kMaxProfileSearchDepth = 4;
+
+constexpr char kDefaultProfileKey[] = "default";
+constexpr char kDefaultProfileDirectory[] = "Default";
+
+// Strict JSON, but a stray invalid UTF-8 byte doesn't fail the whole file.
+constexpr int kJsonOptions =
+    base::JSON_PARSE_RFC | base::JSON_REPLACE_INVALID_CHARACTERS;
+
+enum class FileResult { kOk, kMissing, kTooLarge, kUnreadable };
+
+FileResult ReadFile(const base::FilePath& path,
+                    size_t max_bytes,
+                    std::string* contents) {
+  if (!base::PathExists(path)) {
+    return FileResult::kMissing;
+  }
+  if (base::DirectoryExists(path)) {
+    return FileResult::kUnreadable;
+  }
+  std::optional<int64_t> size = base::GetFileSize(path);
+  if (!size) {
+    return FileResult::kUnreadable;
+  }
+  if (static_cast<uint64_t>(*size) > max_bytes) {
+    return FileResult::kTooLarge;
+  }
+  if (!base::ReadFileToStringWithMaxSize(path, contents, max_bytes)) {
+    // The file may have grown since GetFileSize().
+    return contents->size() >= max_bytes ? FileResult::kTooLarge
+                                         : FileResult::kUnreadable;
+  }
+  return FileResult::kOk;
+}
+
+// Reads an optional JSON file into a dict. Returns nullopt and sets
+// `*unusable` if the file exists but can't be used.
+std::optional<base::DictValue> ReadOptionalJsonDict(
+    const base::FilePath& path,
+    size_t max_bytes,
+    size_t max_depth,
+    bool* unusable) {
+  std::string contents;
+  FileResult result = ReadFile(path, max_bytes, &contents);
+  if (result == FileResult::kMissing) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> dict;
+  if (result == FileResult::kOk) {
+    dict = base::JSONReader::ReadDict(contents, kJsonOptions, max_depth);
+  }
+  if (!dict) {
+    *unusable = true;
+  }
+  return dict;
+}
+
+std::string ToCompactJson(base::ValueView value) {
+  return base::WriteJson(value).value_or(std::string());
+}
+
+std::string StringOrEmpty(const base::DictValue& dict, std::string_view key) {
+  const std::string* value = dict.FindString(key);
+  return value ? *value : std::string();
+}
+
+base::Time ArcTime(const base::DictValue& dict, std::string_view key) {
+  // FindDouble() also accepts integers.
+  std::optional<double> seconds = dict.FindDouble(key);
+  if (!seconds) {
+    return base::Time();
+  }
+  return base::Time::FromSecondsSinceUnixEpoch(*seconds +
+                                               kSecondsFrom1970To2001);
+}
+
+bool IsSafeDirectoryName(const std::string& name) {
+  return !name.empty() && name.size() <= 255 && name != "." && name != ".." &&
+         name.find('/') == std::string::npos &&
+         name.find('\0') == std::string::npos;
+}
+
+// Chromium extension ids are 32 letters from 'a' to 'p'.
+bool IsExtensionId(const std::string& id) {
+  if (id.size() != 32) {
+    return false;
+  }
+  for (char c : id) {
+    if (c < 'a' || c > 'p') {
+      return false;
+    }
+  }
+  return true;
+}
+
+const std::string* FindDirectoryBasename(const base::Value& value,
+                                         int depth) {
+  if (depth > kMaxProfileSearchDepth) {
+    return nullptr;
+  }
+  if (const base::DictValue* dict = value.GetIfDict()) {
+    if (const std::string* name = dict->FindString("directoryBasename")) {
+      return name;
+    }
+    for (const auto [key, child] : *dict) {
+      if (const std::string* name = FindDirectoryBasename(child, depth + 1)) {
+        return name;
+      }
+    }
+  }
+  return nullptr;
+}
+
+struct ProfileKey {
+  std::string key;
+  std::string directory;
+  bool is_default = false;
+};
+
+// Arc names a profile with a value such as `{"default": true}` or
+// `{"custom": {"_0": {"directoryBasename": "Profile 1"}}}`. A missing value
+// means the default profile.
+ProfileKey ToProfileKey(const base::Value* value) {
+  ProfileKey result;
+  const base::DictValue* dict = value ? value->GetIfDict() : nullptr;
+  if (!value || (dict && dict->Find("default"))) {
+    result.key = kDefaultProfileKey;
+    result.directory = kDefaultProfileDirectory;
+    result.is_default = true;
+    return result;
+  }
+  if (dict) {
+    if (const base::Value* custom = dict->Find("custom")) {
+      if (const std::string* name = FindDirectoryBasename(*custom, 0)) {
+        result.key = "custom:" + *name;
+        if (IsSafeDirectoryName(*name)) {
+          result.directory = *name;
+        }
+        return result;
+      }
+    }
+  }
+  result.key = "raw:" + ToCompactJson(*value);
+  return result;
+}
+
+std::string ReadEmoji(const base::DictValue* icon) {
+  if (!icon) {
+    return std::string();
+  }
+  if (const std::string* emoji = icon->FindString("emoji_v2");
+      emoji && !emoji->empty() && emoji->size() <= kMaxEmojiBytes) {
+    return *emoji;
+  }
+  // Older spaces store one code point.
+  std::optional<int> code_point = icon->FindInt("emoji");
+  if (!code_point || !base::IsValidCharacter(*code_point)) {
+    return std::string();
+  }
+  std::string emoji;
+  base::WriteUnicodeCharacter(*code_point, &emoji);
+  return emoji;
+}
+
+// A color channel as stored, or `fallback` if it's missing or not a number.
+// Not clamped: Arc colors are extended sRGB, so a wide-gamut channel may be
+// below 0 or above 1, and a later step maps them into the display's gamut.
+double Channel(const base::DictValue& color,
+               std::string_view key,
+               double fallback) {
+  return color.FindDouble(key).value_or(fallback);
+}
+
+// Arc colors are `{"red", "green", "blue", "alpha", "colorSpace"}`. The
+// channels and the color space name are kept as stored, with alpha 1 and a
+// channel of 0 when missing, and an empty color space when absent or not a
+// string. A color with a channel that isn't a finite number is no color.
+// (The JSON parser already refuses the NaN and infinity literals and numbers
+// too big for a double, so this guards a future parser, not today's input.)
+std::optional<ImportColor> ReadColor(const base::Value* value) {
+  const base::DictValue* color = value ? value->GetIfDict() : nullptr;
+  if (!color) {
+    return std::nullopt;
+  }
+  ImportColor result;
+  result.red = Channel(*color, "red", 0);
+  result.green = Channel(*color, "green", 0);
+  result.blue = Channel(*color, "blue", 0);
+  result.alpha = Channel(*color, "alpha", 1);
+  if (!std::isfinite(result.red) || !std::isfinite(result.green) ||
+      !std::isfinite(result.blue) || !std::isfinite(result.alpha)) {
+    return std::nullopt;
+  }
+  if (const std::string* color_space = color->FindString("colorSpace")) {
+    result.color_space = *color_space;
+  }
+  return result;
+}
+
+std::optional<ImportColor> ReadColor(const base::ListValue& colors,
+                                     size_t index) {
+  return index < colors.size() ? ReadColor(&colors[index]) : std::nullopt;
+}
+
+// WCAG relative luminance of an sRGB color, 0 (black) to 1 (white). The
+// channels are clamped to 0..1 first, so a wide-gamut color is judged by its
+// nearest in-gamut one; this only picks light or dark mode.
+double RelativeLuminance(const ImportColor& color) {
+  auto linear = [](double c) {
+    c = std::clamp(c, 0.0, 1.0);
+    return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4);
+  };
+  return 0.2126 * linear(color.red) + 0.7152 * linear(color.green) +
+         0.0722 * linear(color.blue);
+}
+
+// Colors at least this light get light mode: CIE L* 50, the perceptual
+// middle. Matches Arc's own choice for every themed space in a real sample.
+constexpr double kLightModeMinLuminance = 0.18;
+
+std::optional<ImportThemeVariant> ReadThemeVariant(const base::Value* value) {
+  const base::DictValue* variant = value ? value->GetIfDict() : nullptr;
+  if (!variant) {
+    return std::nullopt;
+  }
+  ImportThemeVariant result;
+  if (const base::DictValue* style =
+          variant->FindDictByDottedPath("style.color._0")) {
+    if (const base::ListValue* colors =
+            style->FindListByDottedPath("blendedGradient._0.baseColors")) {
+      result.color1 = ReadColor(*colors, 0);
+      result.color2 = ReadColor(*colors, 1);
+      if (result.color1) {
+        result.origin = ImportThemeVariant::Origin::kGradient;
+      }
+    } else if (const base::Value* color = style->FindByDottedPath(
+                   "blendedSingleColor._0.color")) {
+      result.color1 = ReadColor(color);
+      if (result.color1) {
+        result.origin = ImportThemeVariant::Origin::kSingleColor;
+      }
+    }
+  }
+  if (const std::string* content =
+          variant->FindString("contentOverBackgroundAppearance")) {
+    if (*content == "light") {
+      result.content = ImportThemeVariant::Content::kLight;
+    } else if (*content == "dark") {
+      result.content = ImportThemeVariant::Content::kDark;
+    }
+  }
+  result.vibrant = variant->FindBool("isVibrant").value_or(false);
+  result.raw_json = ToCompactJson(*variant);
+  return result;
+}
+
+// Picks a look from Arc's `primaryColorPalette`, for a space whose
+// background has no colors: `shaded` (the gradient's first base color when
+// a space has both) then `midTone`, or `midTone` alone.
+std::optional<ImportThemeVariant> ReadPaletteVariant(
+    const base::DictValue* palette) {
+  if (!palette) {
+    return std::nullopt;
+  }
+  ImportThemeVariant result;
+  result.color1 = ReadColor(palette->Find("shaded"));
+  if (result.color1) {
+    result.color2 = ReadColor(palette->Find("midTone"));
+  } else {
+    result.color1 = ReadColor(palette->Find("midTone"));
+  }
+  if (!result.color1) {
+    return std::nullopt;
+  }
+  result.origin = ImportThemeVariant::Origin::kPalette;
+  result.content =
+      RelativeLuminance(*result.color1) >= kLightModeMinLuminance
+          ? ImportThemeVariant::Content::kLight
+          : ImportThemeVariant::Content::kDark;
+  return result;
+}
+
+bool HasColor(const std::optional<ImportThemeVariant>& variant) {
+  return variant && variant->color1;
+}
+
+ImportTheme ReadTheme(const base::DictValue* custom_info) {
+  ImportTheme theme;
+  const base::DictValue* window_theme =
+      custom_info ? custom_info->FindDict("windowTheme") : nullptr;
+  if (!window_theme) {
+    return theme;
+  }
+  theme.raw_json = ToCompactJson(*window_theme);
+  if (const base::DictValue* background =
+          window_theme->FindDict("background")) {
+    if (const base::DictValue* appearance =
+            background->FindDict("appearanceBased")) {
+      theme.light = ReadThemeVariant(appearance->Find("light"));
+      theme.dark = ReadThemeVariant(appearance->Find("dark"));
+      if (theme.light || theme.dark) {
+        theme.kind = ImportTheme::Kind::kAppearanceBased;
+      }
+    } else if (const base::DictValue* single =
+                   background->FindDict("single")) {
+      theme.single = ReadThemeVariant(single->Find("_0"));
+      if (theme.single) {
+        theme.kind = ImportTheme::Kind::kSingle;
+      }
+    }
+  }
+  if (HasColor(theme.single) || HasColor(theme.light) ||
+      HasColor(theme.dark)) {
+    return theme;
+  }
+  // No background, or none with colors: fall back to the palette, which
+  // Arc writes for every themed space.
+  if (std::optional<ImportThemeVariant> palette = ReadPaletteVariant(
+          window_theme->FindDict("primaryColorPalette"))) {
+    theme.kind = ImportTheme::Kind::kSingle;
+    theme.single = std::move(palette);
+    theme.light.reset();
+    theme.dark.reset();
+  }
+  return theme;
+}
+
+std::optional<base::TimeDelta> AutoArchiveDelay(std::string_view value) {
+  if (value == "twelveHours") {
+    return base::Hours(12);
+  }
+  if (value == "twentyFourHours") {
+    return base::Hours(24);
+  }
+  if (value == "sevenDays") {
+    return base::Days(7);
+  }
+  if (value == "thirtyDays") {
+    return base::Days(30);
+  }
+  return std::nullopt;
+}
+
+// Which list a tab is in, for the report.
+enum class Section { kFavorites, kPinned, kOpen };
+
+// Reads the data container of `StorableSidebar.json` into a plan. Every item
+// is read at most once, so cycles and repeats in Arc's `childrenIds` end, and
+// recursion stops at the depth limit.
+class SidebarReader {
+ public:
+  SidebarReader(const base::DictValue& container,
+                const ArcSourcePaths& paths,
+                const ArcReadLimits& limits,
+                ImportPlan& plan)
+      : container_(container),
+        paths_(paths),
+        limits_(limits),
+        plan_(plan),
+        report_(plan.report) {}
+
+  SidebarReader(const SidebarReader&) = delete;
+  SidebarReader& operator=(const SidebarReader&) = delete;
+
+  void Read() {
+    ReadFaviconNames();
+    IndexItems();
+    ReadSpaces();
+    ReadFavorites();
+    // The default profile comes first, even when its spaces come later.
+    std::stable_partition(
+        plan_->profiles.begin(), plan_->profiles.end(),
+        [](const ImportProfile& profile) { return profile.is_default; });
+  }
+
+ private:
+  // Arc writes ordered dictionaries as flat lists, `[key, value, ...]`.
+  // Calls `fn` for each pair whose key is a string and value a dict. A bad
+  // entry is skipped one element at a time, so it doesn't shift the rest.
+  template <typename Fn>
+  void ForEachPair(const base::ListValue& list, Fn fn) {
+    size_t i = 0;
+    while (i + 1 < list.size()) {
+      const std::string* key = list[i].GetIfString();
+      const base::DictValue* value = list[i + 1].GetIfDict();
+      if (key && value) {
+        fn(*key, *value);
+        i += 2;
+      } else {
+        ++report_->malformed_entries;
+        ++i;
+      }
+    }
+    if (i < list.size()) {
+      ++report_->malformed_entries;
+    }
+  }
+
+  void ReadFaviconNames() {
+    base::FileEnumerator files(paths_->support_dir.Append(kFaviconDir),
+                               /*recursive=*/false,
+                               base::FileEnumerator::FILES);
+    for (base::FilePath file = files.Next(); !file.empty();
+         file = files.Next()) {
+      if (favicon_names_.size() >= limits_->max_favicon_files) {
+        break;
+      }
+      favicon_names_.insert(file.BaseName().value());
+    }
+  }
+
+  void IndexItems() {
+    const base::ListValue* items = container_->FindList("items");
+    if (!items) {
+      return;
+    }
+    ForEachPair(*items, [&](const std::string& id,
+                            const base::DictValue& item) {
+      if (!items_.emplace(id, &item).second) {
+        ++report_->malformed_entries;
+      }
+    });
+  }
+
+  // The profile for a `profile` value, created on first use. Null when a
+  // new key would pass `max_profiles`: the caller drops what it was
+  // reading and counts it.
+  ImportProfile* ProfileFor(const base::Value* value) {
+    ProfileKey key = ToProfileKey(value);
+    auto it = profile_index_.find(key.key);
+    if (it != profile_index_.end()) {
+      return &plan_->profiles[it->second];
+    }
+    if (plan_->profiles.size() >= limits_->max_profiles) {
+      return nullptr;
+    }
+    profile_index_.emplace(key.key, plan_->profiles.size());
+    ImportProfile& profile = plan_->profiles.emplace_back();
+    profile.source_key = std::move(key.key);
+    profile.directory = std::move(key.directory);
+    profile.is_default = key.is_default;
+    return &profile;
+  }
+
+  void ReadSpaces() {
+    const base::ListValue* spaces = container_->FindList("spaces");
+    if (!spaces) {
+      return;
+    }
+    ForEachPair(*spaces, [&](const std::string& id,
+                             const base::DictValue& space) {
+      ImportProfile* profile = ProfileFor(space.Find("profile"));
+      if (!profile) {
+        ++report_->malformed_entries;
+        return;
+      }
+      ImportSpace result;
+      result.source_id = id;
+      result.title = StringOrEmpty(space, "title");
+      const base::DictValue* custom_info = space.FindDict("customInfo");
+      result.emoji = ReadEmoji(
+          custom_info ? custom_info->FindDict("iconType") : nullptr);
+      result.theme = ReadTheme(custom_info);
+      ReadSpaceContainers(space, result);
+      profile->spaces.push_back(std::move(result));
+    });
+  }
+
+  // A space's container ids, by section.
+  struct SpaceContainer {
+    std::string_view kind;  // "pinned", "unpinned", or another key.
+    std::string_view id;
+  };
+
+  // Reads `[kind, id, kind, id, ...]`. `containerIDs` writes each kind as a
+  // string; `newContainerIDs` as a dict keyed by it, such as `{"pinned": {}}`
+  // or `{"unpinned": {"_0": {"shared": {}}}}`.
+  std::vector<SpaceContainer> ContainerPairs(const base::ListValue& list) {
+    std::vector<SpaceContainer> result;
+    size_t i = 0;
+    while (i + 1 < list.size()) {
+      std::optional<std::string_view> kind = ContainerKind(list[i]);
+      const std::string* id = list[i + 1].GetIfString();
+      if (!kind || !id) {
+        ++report_->malformed_entries;
+        ++i;
+        continue;
+      }
+      result.push_back({*kind, *id});
+      i += 2;
+    }
+    if (i < list.size()) {
+      ++report_->malformed_entries;
+    }
+    return result;
+  }
+
+  static std::optional<std::string_view> ContainerKind(
+      const base::Value& value) {
+    if (const std::string* kind = value.GetIfString()) {
+      return *kind;
+    }
+    if (const base::DictValue* dict = value.GetIfDict()) {
+      for (std::string_view kind : {"pinned", "unpinned"}) {
+        if (dict->Find(kind)) {
+          return kind;
+        }
+      }
+      return std::string_view();
+    }
+    return std::nullopt;
+  }
+
+  // `containerIDs` is `["pinned", id, "unpinned", id]`. Newer Arc also
+  // writes `newContainerIDs`; it's read only for a section `containerIDs`
+  // lacks, including when `containerIDs` is missing.
+  void ReadSpaceContainers(const base::DictValue& space, ImportSpace& result) {
+    std::vector<SpaceContainer> containers;
+    if (const base::ListValue* list = space.FindList("containerIDs")) {
+      containers = ContainerPairs(*list);
+    }
+    auto has = [&](std::string_view kind) {
+      return std::ranges::any_of(containers, [&](const SpaceContainer& c) {
+        return c.kind == kind;
+      });
+    };
+    const bool has_pinned = has("pinned");
+    const bool has_unpinned = has("unpinned");
+    if (!has_pinned || !has_unpinned) {
+      if (const base::ListValue* list = space.FindList("newContainerIDs")) {
+        for (const SpaceContainer& c : ContainerPairs(*list)) {
+          if ((c.kind == "pinned" && !has_pinned) ||
+              (c.kind == "unpinned" && !has_unpinned)) {
+            containers.push_back(c);
+          }
+        }
+      }
+    }
+    for (const SpaceContainer& c : containers) {
+      if (c.kind == "pinned") {
+        ReadContainer(c.id, Section::kPinned, result.pinned);
+      } else if (c.kind == "unpinned") {
+        ReadContainer(c.id, Section::kOpen, result.open_tabs);
+      }
+    }
+  }
+
+  void ReadFavorites() {
+    if (const base::ListValue* top_apps =
+            container_->FindList("topAppsContainerIDs")) {
+      // `[profile, id, profile, id, ...]`, keyed by the profile value.
+      size_t i = 0;
+      while (i + 1 < top_apps->size()) {
+        const std::string* id = (*top_apps)[i + 1].GetIfString();
+        if (!id) {
+          ++report_->malformed_entries;
+          ++i;
+          continue;
+        }
+        if (ImportProfile* profile = ProfileFor(&(*top_apps)[i])) {
+          ReadContainer(*id, Section::kFavorites, profile->favorites);
+        } else {
+          ++report_->malformed_entries;
+        }
+        i += 2;
+      }
+      if (i < top_apps->size()) {
+        ++report_->malformed_entries;
+      }
+      return;
+    }
+
+    // Without the list, find the containers among the items, as Cra does.
+    const base::ListValue* items = container_->FindList("items");
+    if (!items) {
+      return;
+    }
+    for (size_t i = 0; i + 1 < items->size(); ++i) {
+      const std::string* id = (*items)[i].GetIfString();
+      const base::DictValue* item = (*items)[i + 1].GetIfDict();
+      if (!id || !item) {
+        continue;
+      }
+      const base::DictValue* top_apps = item->FindDictByDottedPath(
+          "data.itemContainer.containerType.topApps");
+      if (top_apps) {
+        if (ImportProfile* profile = ProfileFor(top_apps->Find("_0"))) {
+          ReadContainer(*id, Section::kFavorites, profile->favorites);
+        } else {
+          ++report_->malformed_entries;
+        }
+      }
+    }
+  }
+
+  // Reads the children of container `id` into `out`.
+  void ReadContainer(std::string_view id,
+                     Section section,
+                     std::vector<ImportItem>& out) {
+    auto it = items_.find(id);
+    if (it == items_.end()) {
+      ++report_->missing_items;
+      return;
+    }
+    if (!read_.insert(std::string(id)).second) {
+      ++report_->repeated_items;
+      return;
+    }
+    ReadChildren(*it->second, section, /*depth=*/1, /*in_folder=*/false, out);
+  }
+
+  void ReadChildren(const base::DictValue& parent,
+                    Section section,
+                    int depth,
+                    bool in_folder,
+                    std::vector<ImportItem>& out) {
+    const base::ListValue* children = parent.FindList("childrenIds");
+    if (!children) {
+      return;
+    }
+    for (const base::Value& child : *children) {
+      const std::string* id = child.GetIfString();
+      if (!id) {
+        ++report_->malformed_entries;
+        continue;
+      }
+      if (std::optional<ImportItem> item =
+              ReadItem(*id, section, depth, in_folder)) {
+        out.push_back(std::move(*item));
+      }
+    }
+  }
+
+  std::optional<ImportItem> ReadItem(const std::string& id,
+                                     Section section,
+                                     int depth,
+                                     bool in_folder) {
+    auto it = items_.find(id);
+    if (it == items_.end()) {
+      ++report_->missing_items;
+      return std::nullopt;
+    }
+    if (read_.contains(id)) {
+      ++report_->repeated_items;
+      return std::nullopt;
+    }
+    if (depth > limits_->max_item_depth) {
+      ++report_->too_deep;
+      return std::nullopt;
+    }
+    read_.insert(id);
+
+    const base::DictValue& item = *it->second;
+    const base::DictValue* data = item.FindDict("data");
+    if (!data) {
+      ++report_->skipped_unknown;
+      return std::nullopt;
+    }
+    // Arc's onboarding tab. Not the user's, so not "something we couldn't
+    // bring": dropped without a count.
+    if (data->Find("welcomeToArc")) {
+      return std::nullopt;
+    }
+
+    ImportItem result;
+    result.source_id = id;
+    result.title = StringOrEmpty(item, "title");
+    result.created = ArcTime(item, "createdAt");
+
+    if (const base::DictValue* tab = data->FindDict("tab")) {
+      const base::Value* url_value = tab->Find("savedURL");
+      if (!url_value) {
+        ++report_->skipped_tabs_without_url;
+        return std::nullopt;
+      }
+      const std::string* url = url_value->GetIfString();
+      if (!url || url->empty() || url->size() > limits_->max_url_chars) {
+        ++report_->invalid_urls;
+        return std::nullopt;
+      }
+      result.kind = ImportItem::Kind::kTab;
+      result.url = *url;
+      result.page_title = StringOrEmpty(*tab, "savedTitle");
+      result.icon_emoji =
+          ReadEmoji(tab->FindDictByDottedPath("customInfo.iconType"));
+      std::string favicon = ArcFaviconFileName(id);
+      if (favicon_names_.contains(favicon)) {
+        result.favicon_path =
+            paths_->support_dir.Append(kFaviconDir).AppendASCII(favicon);
+      }
+      CountTab(section);
+      return result;
+    }
+
+    if (const base::DictValue* list = data->FindDict("list")) {
+      if (list->Find("automaticLiveFolderData")) {
+        ++report_->skipped_live_folders;
+        return std::nullopt;
+      }
+      ++report_->folders;
+      if (in_folder) {
+        ++report_->nested_folders;
+      }
+    } else if (data->FindDict("splitView")) {
+      result.group = ImportItem::Group::kSplitView;
+      ++report_->split_views;
+    } else if (data->FindDict("tabGroup")) {
+      result.group = ImportItem::Group::kTabGroup;
+      ++report_->tab_groups;
+    } else if (data->Find("easel")) {
+      ++report_->skipped_easels;
+      return std::nullopt;
+    } else if (data->Find("arcDocument")) {
+      ++report_->skipped_notes;
+      return std::nullopt;
+    } else {
+      ++report_->skipped_unknown;
+      return std::nullopt;
+    }
+
+    result.kind = ImportItem::Kind::kFolder;
+    if (result.group == ImportItem::Group::kNone && in_folder) {
+      NoteNestedFolder(result.title);
+    }
+    folder_titles_.push_back(result.title);
+    ReadChildren(item, section, depth + 1, /*in_folder=*/true,
+                 result.children);
+    folder_titles_.pop_back();
+    return result;
+  }
+
+  // Sets `first_nested_folder_path` from the first nested folder that, with
+  // the folders it's in, has a title.
+  void NoteNestedFolder(const std::string& title) {
+    if (!report_->first_nested_folder_path.empty() || title.empty() ||
+        std::ranges::any_of(folder_titles_, [](const std::string& parent) {
+          return parent.empty();
+        })) {
+      return;
+    }
+    std::string path;
+    for (const std::string& parent : folder_titles_) {
+      // " › ", U+203A.
+      base::StrAppend(&path, {parent, " \xE2\x80\xBA "});
+    }
+    path += title;
+    report_->first_nested_folder_path = std::move(path);
+  }
+
+  void CountTab(Section section) {
+    switch (section) {
+      case Section::kFavorites:
+        ++report_->favorites;
+        break;
+      case Section::kPinned:
+        ++report_->pinned_tabs;
+        break;
+      case Section::kOpen:
+        ++report_->open_tabs;
+        break;
+    }
+  }
+
+  const raw_ref<const base::DictValue> container_;
+  const raw_ref<const ArcSourcePaths> paths_;
+  const raw_ref<const ArcReadLimits> limits_;
+  const raw_ref<ImportPlan> plan_;
+  const raw_ref<ImportReport> report_;
+
+  // Items by id, pointing into the parsed sidebar.
+  std::map<std::string, const base::DictValue*, std::less<>> items_;
+  // Ids of items and containers already read. Ids are opaque strings, not
+  // necessarily UUIDs.
+  std::set<std::string, std::less<>> read_;
+  // Titles of the folders the item being read is in, outermost first.
+  std::vector<std::string> folder_titles_;
+  std::set<base::FilePath::StringType> favicon_names_;
+  // Index into `plan_->profiles` by profile key.
+  std::map<std::string, size_t> profile_index_;
+};
+
+void ReadProfileNames(const ArcSourcePaths& paths,
+                      const ArcReadLimits& limits,
+                      ImportPlan& plan) {
+  bool unusable = false;
+  std::optional<base::DictValue> local_state = ReadOptionalJsonDict(
+      paths.support_dir.Append(kUserDataDir).Append(kLocalStateFile),
+      limits.max_profile_file_bytes, limits.max_json_depth, &unusable);
+  if (unusable) {
+    plan.report.issues.push_back(ImportIssue::kProfileNamesUnreadable);
+  }
+  if (!local_state) {
+    return;
+  }
+  const base::DictValue* info_cache =
+      local_state->FindDictByDottedPath("profile.info_cache");
+  if (!info_cache) {
+    return;
+  }
+  for (ImportProfile& profile : plan.profiles) {
+    if (profile.directory.empty()) {
+      continue;
+    }
+    if (const base::DictValue* info = info_cache->FindDict(profile.directory)) {
+      profile.display_name = StringOrEmpty(*info, "name");
+    }
+  }
+}
+
+void ReadPinnedExtensions(const ArcSourcePaths& paths,
+                          const ArcReadLimits& limits,
+                          ImportPlan& plan) {
+  bool unusable = false;
+  for (ImportProfile& profile : plan.profiles) {
+    if (profile.directory.empty()) {
+      continue;
+    }
+    std::optional<base::DictValue> preferences = ReadOptionalJsonDict(
+        paths.support_dir.Append(kUserDataDir)
+            .Append(base::FilePath::FromUTF8Unsafe(profile.directory))
+            .Append(kPreferencesFile),
+        limits.max_profile_file_bytes, limits.max_json_depth, &unusable);
+    if (!preferences) {
+      continue;
+    }
+    const base::ListValue* pinned =
+        preferences->FindListByDottedPath("extensions.pinned_extensions");
+    if (!pinned) {
+      continue;
+    }
+    for (const base::Value& id : *pinned) {
+      const std::string* value = id.GetIfString();
+      if (value && IsExtensionId(*value)) {
+        profile.pinned_extension_ids.push_back(*value);
+      } else {
+        ++plan.report.malformed_entries;
+      }
+    }
+  }
+  if (unusable) {
+    plan.report.issues.push_back(ImportIssue::kExtensionsUnreadable);
+  }
+}
+
+void ReadLinkRouting(const ArcSourcePaths& paths,
+                     const ArcReadLimits& limits,
+                     ImportPlan& plan) {
+  bool unusable = false;
+  std::optional<base::DictValue> routing = ReadOptionalJsonDict(
+      paths.support_dir.Append(kLinkRoutingFile),
+      limits.max_settings_file_bytes, limits.max_json_depth, &unusable);
+  if (routing) {
+    const base::Value* rules = routing->Find("rules");
+    if (rules && rules->is_list()) {
+      for (const base::Value& rule : rules->GetList()) {
+        plan.handoffs.routing_rules_json.push_back(ToCompactJson(rule));
+      }
+    } else if (rules) {
+      unusable = true;
+    }
+    if (const base::Value* destination = routing->Find("defaultDestination")) {
+      plan.handoffs.routing_default_json = ToCompactJson(*destination);
+    }
+  }
+  if (unusable) {
+    plan.report.issues.push_back(ImportIssue::kRoutingRulesUnreadable);
+  }
+}
+
+void ReadDefaults(const ArcSourcePaths& paths,
+                  const ArcReadLimits& limits,
+                  ImportPlan& plan) {
+  std::string threshold;
+  switch (ReadArcAutoArchiveThreshold(paths.defaults_plist,
+                                      limits.max_settings_file_bytes,
+                                      &threshold)) {
+    case ArcDefaultsResult::kMissing:
+      return;
+    case ArcDefaultsResult::kUnreadable:
+      plan.report.issues.push_back(ImportIssue::kSettingsUnreadable);
+      return;
+    case ArcDefaultsResult::kRead:
+      break;
+  }
+  plan.handoffs.auto_archive_after = AutoArchiveDelay(threshold);
+  plan.handoffs.auto_archive_raw = std::move(threshold);
+}
+
+}  // namespace
+
+// static
+ArcSourcePaths ArcSourcePaths::ForCurrentUser() {
+  const base::FilePath library =
+      base::GetHomeDir().Append(FILE_PATH_LITERAL("Library"));
+  ArcSourcePaths paths;
+  paths.support_dir = library.Append(FILE_PATH_LITERAL("Application Support"))
+                          .Append(FILE_PATH_LITERAL("Arc"));
+  paths.defaults_plist =
+      library.Append(FILE_PATH_LITERAL("Preferences")).Append(kDefaultsFile);
+  return paths;
+}
+
+// static
+ArcSourcePaths ArcSourcePaths::ForSourceRoot(const base::FilePath& root) {
+  ArcSourcePaths paths;
+  paths.support_dir = root;
+  paths.defaults_plist = root.Append(kDefaultsFile);
+  return paths;
+}
+
+bool ArcSourceExists(const ArcSourcePaths& paths) {
+  if (!paths.support_dir.IsAbsolute()) {
+    return false;
+  }
+  // One stat(), which also tells a file from a directory.
+  base::File::Info info;
+  return base::GetFileInfo(paths.support_dir.Append(kSidebarFile), &info) &&
+         !info.is_directory;
+}
+
+base::expected<ImportPlan, ArcReadError> ReadArc(const ArcSourcePaths& paths,
+                                                 const ArcReadLimits& limits) {
+  // Relative paths would resolve against the working directory.
+  if (!paths.support_dir.IsAbsolute()) {
+    return base::unexpected(ArcReadError::kNotFound);
+  }
+  std::optional<base::Value> root;
+  {
+    std::string contents;
+    switch (ReadFile(paths.support_dir.Append(kSidebarFile),
+                     limits.max_sidebar_bytes, &contents)) {
+      case FileResult::kOk:
+        break;
+      case FileResult::kMissing:
+        return base::unexpected(ArcReadError::kNotFound);
+      case FileResult::kTooLarge:
+        return base::unexpected(ArcReadError::kTooLarge);
+      case FileResult::kUnreadable:
+        return base::unexpected(ArcReadError::kUnreadable);
+    }
+    root = base::JSONReader::Read(contents, kJsonOptions,
+                                  limits.max_json_depth);
+  }
+  if (!root || !root->is_dict()) {
+    return base::unexpected(ArcReadError::kMalformed);
+  }
+
+  // Find the container that holds the spaces. Its index has changed between
+  // Arc versions, so don't rely on it. Read only `sidebar`: the file's
+  // `sidebarSyncState` (a CloudKit mirror) and `firebaseSyncState` hold
+  // copies of spaces and items that may be stale.
+  const base::ListValue* containers =
+      root->GetDict().FindListByDottedPath("sidebar.containers");
+  if (!containers) {
+    return base::unexpected(ArcReadError::kUnexpectedShape);
+  }
+  const base::DictValue* data_container = nullptr;
+  for (const base::Value& container : *containers) {
+    const base::DictValue* dict = container.GetIfDict();
+    if (dict && dict->Find("spaces")) {
+      data_container = dict;
+      break;
+    }
+  }
+  if (!data_container) {
+    return base::unexpected(ArcReadError::kUnexpectedShape);
+  }
+
+  ImportPlan plan;
+  plan.source = ImportSource::kArc;
+  plan.source_dir = paths.support_dir;
+  SidebarReader(*data_container, paths, limits, plan).Read();
+
+  ReadProfileNames(paths, limits, plan);
+  ReadPinnedExtensions(paths, limits, plan);
+  ReadLinkRouting(paths, limits, plan);
+  if (paths.defaults_plist.IsAbsolute()) {
+    ReadDefaults(paths, limits, plan);
+  }
+  const base::FilePath archive = paths.support_dir.Append(kArchiveFile);
+  if (base::PathExists(archive)) {
+    plan.handoffs.archive_path = archive;
+  }
+
+  plan.report.profiles = static_cast<int>(plan.profiles.size());
+  for (const ImportProfile& profile : plan.profiles) {
+    plan.report.spaces += static_cast<int>(profile.spaces.size());
+  }
+  return plan;
+}
+
+std::string ArcFaviconFileName(std::string_view item_id) {
+  const base::span<const uint8_t> bytes = base::as_byte_span(item_id);
+  std::array<uint8_t, MD5_DIGEST_LENGTH> digest;
+  MD5(bytes.data(), bytes.size(), digest.data());
+  return base::HexEncodeLower(digest);
+}

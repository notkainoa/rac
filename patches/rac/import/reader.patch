+// A gradient variant, as the synthetic fixtures write them.
+void ExpectVariant(const std::optional<ImportThemeVariant>& variant,
+                   ImportThemeVariant::Content content,
+                   bool vibrant) {
+  ASSERT_TRUE(variant.has_value());
+  EXPECT_EQ(variant->origin, ImportThemeVariant::Origin::kGradient);
+  EXPECT_EQ(variant->content, content);
+  EXPECT_EQ(variant->vibrant, vibrant);
+  // The whole variant, as compact JSON.
+  EXPECT_NE(variant->raw_json.find("\"intensityFactor\""), std::string::npos);
+  EXPECT_NE(variant->raw_json.find("\"overlayColors\""), std::string::npos);
+  EXPECT_EQ(variant->raw_json.find('\n'), std::string::npos);

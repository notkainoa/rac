+#if BUILDFLAG(RAC_DEV_SWITCHES)
+
+TEST(ArcSourceRootTest, SwitchPointsAtCopy) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath root = base::MakeAbsoluteFilePath(temp.GetPath());
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchPath(kSwitch, root);
+  ArcSourcePaths paths = GetArcSourcePaths();
+  EXPECT_EQ(paths.support_dir, root);
+  EXPECT_EQ(paths.defaults_plist,
+            root.Append("company.thebrowser.Browser.plist"));
+}
+
+// A relative path must never fall back to the real Arc.
+TEST(ArcSourceRootTest, RelativeSwitchReadsNothing) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchPath(
+      kSwitch, base::FilePath("sample"));
+  ArcSourcePaths paths = GetArcSourcePaths();
+  EXPECT_TRUE(paths.support_dir.empty());
+  EXPECT_TRUE(paths.defaults_plist.empty());
+}
+
+TEST(ArcSourceRootTest, MissingFolderReadsNothing) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchPath(
+      kSwitch, temp.GetPath().Append("missing"));
+  EXPECT_TRUE(GetArcSourcePaths().support_dir.empty());
+}
+
+// The dev import trigger needs the switch; without it nothing is read.
+TEST(ArcSourceRootTest, TriggerNeedsSourceRootSwitch) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch("rac-import-arc-now");
+  EXPECT_FALSE(HasDevArcSourceRootSwitch(
+      *base::CommandLine::ForCurrentProcess()));
+  command_line.GetProcessCommandLine()->AppendSwitchPath(
+      kSwitch, base::FilePath("/x"));
+  EXPECT_TRUE(HasDevArcSourceRootSwitch(
+      *base::CommandLine::ForCurrentProcess()));
+}
+
+// A temporary folder stands in for the real Arc one, so the test never
+// touches the user's Arc data.
+class SafeDevSourceRootTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_.CreateUniqueTempDir());
+    base_ = base::MakeAbsoluteFilePath(temp_.GetPath());
+    real_arc_ = base_.Append("Application Support").Append("Arc");
+    ASSERT_TRUE(base::CreateDirectory(real_arc_));
+    copy_ = base_.Append("copy");
+    ASSERT_TRUE(base::CreateDirectory(copy_));
+  }
+
+  base::ScopedTempDir temp_;
+  base::FilePath base_;
+  base::FilePath real_arc_;
+  base::FilePath copy_;
+};
+
+TEST_F(SafeDevSourceRootTest, AcceptsACopy) {
+  EXPECT_EQ(internal::SafeDevSourceRoot(copy_, real_arc_), copy_);
+}
+
+TEST_F(SafeDevSourceRootTest, RefusesTheRealArcFolder) {
+  EXPECT_FALSE(internal::SafeDevSourceRoot(real_arc_, real_arc_));
+}
+
+TEST_F(SafeDevSourceRootTest, RefusesTheRealArcFolderInAnyCase) {
+  const base::FilePath upper(base::ToUpperASCII(real_arc_.value()));
+  EXPECT_FALSE(internal::SafeDevSourceRoot(real_arc_, upper));
+}
+
+TEST_F(SafeDevSourceRootTest, RefusesAFolderInsideTheRealArc) {
+  const base::FilePath inside = real_arc_.Append("User Data");
+  ASSERT_TRUE(base::CreateDirectory(inside));
+  EXPECT_FALSE(internal::SafeDevSourceRoot(inside, real_arc_));
+}
+
+TEST_F(SafeDevSourceRootTest, RefusesASymlinkToTheRealArc) {
+  const base::FilePath link = base_.Append("link");
+  ASSERT_TRUE(base::CreateSymbolicLink(real_arc_, link));
+  EXPECT_FALSE(internal::SafeDevSourceRoot(link, real_arc_));
+}
+
+TEST_F(SafeDevSourceRootTest, RefusesDotDotIntoTheRealArc) {
+  const base::FilePath sneaky =
+      copy_.Append("..").Append("Application Support").Append("Arc");
+  EXPECT_FALSE(internal::SafeDevSourceRoot(sneaky, real_arc_));
+}
+
+TEST_F(SafeDevSourceRootTest, AcceptsASiblingWithASharedPrefix) {
+  const base::FilePath sibling =
+      base_.Append("Application Support").Append("Arc copy");
+  ASSERT_TRUE(base::CreateDirectory(sibling));
+  EXPECT_EQ(internal::SafeDevSourceRoot(sibling, real_arc_), sibling);
+}
+
+TEST_F(SafeDevSourceRootTest, RefusesAFile) {
+  const base::FilePath file = base_.Append("file");
+  ASSERT_TRUE(base::WriteFile(file, "x"));
+  EXPECT_FALSE(internal::SafeDevSourceRoot(file, real_arc_));
+}
+
+#else
+
+TEST(ArcSourceRootTest, ReleaseIgnoresSwitch) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchPath(
+      kSwitch, base::FilePath("/tmp/rac-arc-sample"));
+  EXPECT_EQ(GetArcSourcePaths().support_dir,
+            ArcSourcePaths::ForCurrentUser().support_dir);
+}
+
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+

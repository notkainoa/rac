+TEST(ArcReaderTest, ThemePaletteFallback) {
+  base::expected<ImportPlan, ArcReadError> result =
+      ReadFixture("theme_palette");
+  ASSERT_TRUE(result.has_value());
+  const ImportPlan& plan = *result;
+
+  ASSERT_EQ(plan.profiles.size(), 1u);
+  const std::vector<ImportSpace>& spaces = plan.profiles[0].spaces;
+  ASSERT_EQ(spaces.size(), 8u);
+  using Content = ImportThemeVariant::Content;
+  using Origin = ImportThemeVariant::Origin;
+
+  // No background: `shaded` and `midTone`, and dark mode because `shaded`
+  // is dark. The palette stays in the theme's raw JSON.
+  {
+    SCOPED_TRACE("Palette dark");
+    const ImportTheme& theme = spaces[0].theme;
+    EXPECT_EQ(theme.kind, ImportTheme::Kind::kSingle);
+    EXPECT_FALSE(theme.light.has_value());
+    EXPECT_FALSE(theme.dark.has_value());
+    ASSERT_TRUE(theme.single.has_value());
+    EXPECT_EQ(theme.single->origin, Origin::kPalette);
+    ExpectColor(theme.single->color1, 0.4, 0.4, 0.54);
+    ExpectColor(theme.single->color2, 0.58, 0.59, 0.69);
+    EXPECT_EQ(theme.single->content, Content::kDark);
+    EXPECT_FALSE(theme.single->vibrant);
+    EXPECT_TRUE(theme.single->raw_json.empty());
+    EXPECT_NE(theme.raw_json.find("\"semanticColorPalette\""),
+              std::string::npos);
+  }
+  {
+    SCOPED_TRACE("Palette light");
+    const ImportTheme& theme = spaces[1].theme;
+    EXPECT_EQ(theme.kind, ImportTheme::Kind::kSingle);
+    ASSERT_TRUE(theme.single.has_value());
+    EXPECT_EQ(theme.single->origin, Origin::kPalette);
+    ExpectColor(theme.single->color1, 0.82, 0.71, 0.63);
+    ExpectColor(theme.single->color2, 0.82, 0.71, 0.63);
+    EXPECT_EQ(theme.single->content, Content::kLight);
+  }
+  // A flat color is the background's own; the palette isn't used.
+  {
+    SCOPED_TRACE("Single color");
+    const ImportTheme& theme = spaces[2].theme;
+    EXPECT_EQ(theme.kind, ImportTheme::Kind::kSingle);
+    ASSERT_TRUE(theme.single.has_value());
+    EXPECT_EQ(theme.single->origin, Origin::kSingleColor);
+    ExpectColor(theme.single->color1, 0.95, 0.92, 0.89);
+    EXPECT_FALSE(theme.single->color2.has_value());
+    EXPECT_EQ(theme.single->content, Content::kLight);
+    EXPECT_TRUE(theme.single->vibrant);
+    EXPECT_NE(theme.single->raw_json.find("\"blendedSingleColor\""),
+              std::string::npos);
+  }
+  // A background style the reader doesn't know has no colors, so the
+  // palette is used, and the background is still in the raw JSON.
+  {
+    SCOPED_TRACE("Unknown style");
+    const ImportTheme& theme = spaces[3].theme;
+    EXPECT_EQ(theme.kind, ImportTheme::Kind::kSingle);
+    ASSERT_TRUE(theme.single.has_value());
+    EXPECT_EQ(theme.single->origin, Origin::kPalette);
+    ExpectColor(theme.single->color1, 0.4, 0.4, 0.54);
+    EXPECT_EQ(theme.single->content, Content::kDark);
+    EXPECT_NE(theme.raw_json.find("\"futureStyle\""), std::string::npos);
+  }
+  {
+    SCOPED_TRACE("Midtone only");
+    const ImportTheme& theme = spaces[4].theme;
+    ASSERT_TRUE(theme.single.has_value());
+    EXPECT_EQ(theme.single->origin, Origin::kPalette);
+    ExpectColor(theme.single->color1, 0.2, 0.3, 0.4);
+    EXPECT_FALSE(theme.single->color2.has_value());
+    EXPECT_EQ(theme.single->content, Content::kDark);
+  }
+  // `customInfo: {}` is no theme at all.

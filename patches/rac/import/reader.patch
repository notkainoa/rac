+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_source_root.h"
+
+#include "chrome/browser/rac/dev/buildflags.h"
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#endif
+
+namespace rac {
+
+namespace {
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+// Not in release builds, so a release can only ever read the real Arc.
+constexpr char kImportSourceRootSwitch[] = "rac-import-source-root";
+#endif
+
+}  // namespace
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+namespace internal {
+
+std::optional<base::FilePath> SafeDevSourceRoot(
+    const base::FilePath& root,
+    const base::FilePath& real_arc_dir) {
+  if (!root.IsAbsolute()) {
+    LOG(ERROR) << "--" << kImportSourceRootSwitch
+               << " needs an absolute path";
+    return std::nullopt;
+  }
+  // Resolves symlinks and "..". Only the given root is looked at; the real
+  // Arc folder is compared by its path and never opened.
+  const base::FilePath resolved = base::MakeAbsoluteFilePath(root);
+  if (resolved.empty() || !base::DirectoryExists(resolved)) {
+    LOG(ERROR) << "--" << kImportSourceRootSwitch
+               << " must be an existing folder";
+    return std::nullopt;
+  }
+  // The Mac's disk is usually case-insensitive, so compare that way.
+  const std::string candidate = base::ToLowerASCII(resolved.value());
+  const std::string real = base::ToLowerASCII(real_arc_dir.value());
+  if (candidate == real ||
+      base::StartsWith(candidate, real + "/", base::CompareCase::SENSITIVE)) {
+    LOG(ERROR) << "--" << kImportSourceRootSwitch
+               << " points at the real Arc folder; reading nothing";
+    return std::nullopt;
+  }
+  return resolved;
+}
+
+}  // namespace internal
+
+namespace {
+
+base::FilePath RealArcSupportDirForComparison() {
+  // The home folder is resolved, so a symlinked home still matches. The Arc
+  // folder under it is only ever a string here.
+  base::FilePath home = base::MakeAbsoluteFilePath(base::GetHomeDir());
+  if (home.empty()) {
+    home = base::GetHomeDir();
+  }
+  return home.Append(FILE_PATH_LITERAL("Library"))
+      .Append(FILE_PATH_LITERAL("Application Support"))
+      .Append(FILE_PATH_LITERAL("Arc"));
+}
+
+}  // namespace
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+
+ArcSourcePaths GetArcSourcePaths() {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(kImportSourceRootSwitch)) {
+    std::optional<base::FilePath> root = internal::SafeDevSourceRoot(
+        command_line.GetSwitchValuePath(kImportSourceRootSwitch),
+        RealArcSupportDirForComparison());
+    if (root) {
+      return ArcSourcePaths::ForSourceRoot(*root);
+    }
+    // Never fall back to the real Arc when a copy was asked for. ReadArc()
+    // finds nothing at empty paths.
+    return ArcSourcePaths();
+  }
+#endif
+  return ArcSourcePaths::ForCurrentUser();
+}
+
+bool HasDevArcSourceRootSwitch(const base::CommandLine& command_line) {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  return command_line.HasSwitch(kImportSourceRootSwitch);
+#else
+  return false;
+#endif
+}
+
+}  // namespace rac

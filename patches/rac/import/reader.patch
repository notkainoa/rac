+class ArcReaderTempDirTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath PathTo(std::string_view relative) const {
+    return temp_dir_.GetPath().AppendASCII(relative);
+  }
+
+  // Writes `contents` to `relative` under the source root, making folders.
+  void WriteTo(std::string_view relative, std::string_view contents) {
+    const base::FilePath path = PathTo(relative);
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  ArcSourcePaths Paths() const {
+    return ArcSourcePaths::ForSourceRoot(temp_dir_.GetPath());
+  }
+
+  base::ScopedTempDir temp_dir_;
+};

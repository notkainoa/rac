+}
+
+// Walks a chain of single-child folders named "Level 1", "Level 2", ... that
+// starts in `items`, and expects exactly `levels` of them.
+void ExpectFolderChain(const std::vector<ImportItem>& items, int levels) {
+  const std::vector<ImportItem>* level = &items;
+  for (int depth = 1; depth <= levels; ++depth) {
+    SCOPED_TRACE(depth);
+    ASSERT_EQ(level->size(), 1u);
+    const ImportItem& folder = (*level)[0];
+    ExpectFolder(folder, "Level " + std::to_string(depth),
+                 ImportItem::Group::kNone, depth < levels ? 1u : 0u);
+    level = &folder.children;
+  }
+}

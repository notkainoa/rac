+    EXPECT_EQ(profile.source_key, "custom:" + name);
+    EXPECT_FALSE(profile.is_default);
+    EXPECT_TRUE(result->report.issues.empty());
+    EXPECT_EQ(result->report.malformed_entries, 0);
+
+    if (name == "Profile 2") {
+      // Control: a safe name finds the same kind of file.
+      ExpectProfile(profile, "custom:Profile 2", "Profile 2",
+                    /*is_default=*/false, "ok");
+      EXPECT_EQ(profile.pinned_extension_ids,
+                (std::vector<std::string>{std::string(32, 'p')}));
+    } else {
+      EXPECT_TRUE(profile.directory.empty());
+      EXPECT_TRUE(profile.display_name.empty());
+      EXPECT_TRUE(profile.pinned_extension_ids.empty());
+    }
+  }
+}
+
+TEST_F(ArcReaderTempDirTest, FavoritesComeFromItemsWithoutTopAppsList) {
+  WriteTo("StorableSidebar.json",
+          R"json({"sidebar":{"containers":[{"spaces":["space-1",)json"

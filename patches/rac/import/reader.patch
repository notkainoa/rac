+TEST(ArcSourceRootTest, DefaultsToCurrentUsersArc) {
+  base::test::ScopedCommandLine command_line;
+  ArcSourcePaths paths = GetArcSourcePaths();
+  EXPECT_EQ(paths.support_dir, ArcSourcePaths::ForCurrentUser().support_dir);
+  EXPECT_EQ(paths.defaults_plist,
+            ArcSourcePaths::ForCurrentUser().defaults_plist);
+  EXPECT_EQ(paths.support_dir.BaseName().value(), "Arc");
+  EXPECT_EQ(paths.defaults_plist.BaseName().value(),
+            "company.thebrowser.Browser.plist");
+}

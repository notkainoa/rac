+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/import/arc_defaults.h"
+
+#import <Foundation/Foundation.h>
+
+#include "base/apple/foundation_util.h"
+#include "base/files/file_util.h"
+#include "base/strings/sys_string_conversions.h"
+
+namespace rac {
+
+ArcDefaultsResult ReadArcAutoArchiveThreshold(const base::FilePath& plist,
+                                              size_t max_bytes,
+                                              std::string* threshold) {
+  if (!base::PathExists(plist)) {
+    return ArcDefaultsResult::kMissing;
+  }
+  std::string contents;
+  if (base::DirectoryExists(plist) ||
+      !base::ReadFileToStringWithMaxSize(plist, &contents, max_bytes)) {
+    return ArcDefaultsResult::kUnreadable;
+  }
+
+  @autoreleasepool {
+    NSData* data = [NSData dataWithBytes:contents.data()
+                                  length:contents.size()];
+    // Accepts both the binary and the XML format.
+    NSDictionary* defaults = base::apple::ObjCCast<NSDictionary>(
+        [NSPropertyListSerialization propertyListWithData:data
+                                                  options:NSPropertyListImmutable
+                                                   format:nil
+                                                    error:nil]);
+    if (!defaults) {
+      return ArcDefaultsResult::kUnreadable;
+    }
+    NSString* value = base::apple::ObjCCast<NSString>(
+        defaults[@"autoArchiveTimeThreshold"]);
+    if (value) {
+      *threshold = base::SysNSStringToUTF8(value);
+    }
+  }
+  return ArcDefaultsResult::kRead;
+}
+
+}  // namespace rac

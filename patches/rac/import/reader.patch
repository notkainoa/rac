+TEST(ArcReaderTest, MaintainerSample) {
+  base::expected<ImportPlan, ArcReadError> result =
+      ReadFixture("maintainer_sample");
+  ASSERT_TRUE(result.has_value());
+  const ImportPlan& plan = *result;
+
+  // `profile` is `{"default": true}` everywhere; the name is from Local
+  // State.
+  ASSERT_EQ(plan.profiles.size(), 1u);
+  const ImportProfile& profile = plan.profiles[0];
+  ExpectProfile(profile, "default", "Default", /*is_default=*/true,
+                "Title 20");
+  EXPECT_TRUE(profile.pinned_extension_ids.empty());
+  ASSERT_EQ(profile.favorites.size(), 1u);
+  ExpectTab(profile.favorites[0], "https://example.com/12", "Title 7");
+  ExpectFavicon(profile.favorites[0]);
+
+  // Ten spaces in order; two share a title and both are kept.
+  constexpr std::array<std::string_view, 10> kTitles = {
+      "",         "Title 19", "Title 17", "Title 18", "Title 16",
+      "Title 15", "Title 12", "Title 15", "Title 14", "Title 13"};
+  ASSERT_EQ(profile.spaces.size(), kTitles.size());
+  for (size_t i = 0; i < kTitles.size(); ++i) {
+    SCOPED_TRACE(i);
+    ExpectSpace(profile.spaces[i], kTitles[i]);
+  }
+  EXPECT_NE(profile.spaces[5].source_id, profile.spaces[7].source_id);
+
+  // The first space's id was not a UUID; the scrub made it URL-shaped.
+  const ImportSpace& first = profile.spaces[0];
+  EXPECT_EQ(first.source_id, "https://example.com/1");
+  EXPECT_TRUE(first.open_tabs.empty());
+  ASSERT_EQ(first.pinned.size(), 2u);
+  ExpectTab(first.pinned[0], "https://example.com/3", "Title 1");
+  ExpectFavicon(first.pinned[0]);
+
+  // A folder of four tabs and a split view. Arc's welcome item, first in
+  // the folder, is dropped without a count.
+  const ImportItem& folder = first.pinned[1];
+  EXPECT_EQ(folder.source_id, "https://example.com/4");
+  ExpectFolder(folder, "Title 6", ImportItem::Group::kNone, 5u);
+  constexpr std::array<std::string_view, 4> kFolderIds = {"s14", "s10", "s16",
+                                                          "s12"};
+  for (size_t i = 0; i < kFolderIds.size(); ++i) {
+    SCOPED_TRACE(i);
+    EXPECT_EQ(folder.children[i].source_id, kFolderIds[i]);
+    EXPECT_EQ(folder.children[i].kind, ImportItem::Kind::kTab);
+    // The scrub keeps favicons for non-UUID ids too.
+    ExpectFavicon(folder.children[i]);
+  }
+  const ImportItem& split = folder.children[4];
+  ExpectFolder(split, "", ImportItem::Group::kSplitView, 2u);
+  ExpectTab(split.children[0], "https://example.com/15", "Title 11",
+            "Title 11");
+  ExpectTab(split.children[1], "https://example.com/14", "Title 9",
+            "Title 9");
+  ExpectFavicon(split.children[0]);
+  // The one emoji in the sample is a tab's icon, not a space's. That tab has
+  // no favicon file.
+  EXPECT_EQ(split.children[1].source_id, "s25");
+  EXPECT_TRUE(split.children[1].favicon_path.empty());
+  EXPECT_EQ(split.children[1].icon_emoji, kCyclone);
+  for (const ImportSpace& space : profile.spaces) {
+    EXPECT_TRUE(space.emoji.empty());
+  }
+
+  ASSERT_EQ(profile.spaces[1].open_tabs.size(), 1u);
+  ExpectTab(profile.spaces[1].open_tabs[0], "https://example.com/13",
+            "Title 8");
+
+  // Themes. Spaces 0 and 4 have one flat color, space 1 a gradient, and the
+  // rest `customInfo: {}`. All three themed spaces keep their palettes in
+  // the raw JSON.
+  using Content = ImportThemeVariant::Content;
+  using Origin = ImportThemeVariant::Origin;
+  for (size_t i : {0u, 4u}) {
+    SCOPED_TRACE(i);
+    const ImportTheme& theme = profile.spaces[i].theme;
+    EXPECT_EQ(theme.kind, ImportTheme::Kind::kSingle);
+    ASSERT_TRUE(theme.single.has_value());
+    EXPECT_EQ(theme.single->origin, Origin::kSingleColor);
+    ASSERT_TRUE(theme.single->color1.has_value());
+    EXPECT_NEAR(theme.single->color1->red, 0.95, 1e-6);
+    // Arc's real colors say `extendedSRGB`.
+    EXPECT_EQ(theme.single->color1->color_space, "extendedSRGB");
+    EXPECT_NEAR(theme.single->color1->green, 0.918, 1e-6);
+    EXPECT_NEAR(theme.single->color1->blue, 0.894, 1e-6);
+    EXPECT_FALSE(theme.single->color2.has_value());
+    EXPECT_EQ(theme.single->content, Content::kLight);
+    EXPECT_TRUE(theme.single->vibrant);
+  }
+  {
+    const ImportTheme& theme = profile.spaces[1].theme;
+    EXPECT_EQ(theme.kind, ImportTheme::Kind::kSingle);
+    ExpectVariant(theme.single, Content::kDark, /*vibrant=*/true);
+    ASSERT_TRUE(theme.single->color1.has_value());
+    EXPECT_NEAR(theme.single->color1->red, 0.40031713, 1e-6);
+    ASSERT_TRUE(theme.single->color2.has_value());
+    EXPECT_NEAR(theme.single->color2->red, 0.49800211, 1e-6);
+  }
+  for (size_t i = 0; i < profile.spaces.size(); ++i) {
+    SCOPED_TRACE(i);
+    const ImportTheme& theme = profile.spaces[i].theme;
+    if (i == 0 || i == 1 || i == 4) {
+      EXPECT_NE(theme.raw_json.find("\"primaryColorPalette\""),
+                std::string::npos);
+      EXPECT_NE(theme.raw_json.find("\"semanticColorPalette\""),
+                std::string::npos);
+    } else {
+      EXPECT_EQ(theme.kind, ImportTheme::Kind::kNone);
+      EXPECT_TRUE(theme.raw_json.empty());
+    }
+  }
+
+  ImportReport expected;
+  expected.profiles = 1;
+  expected.spaces = 10;
+  expected.favorites = 1;
+  expected.pinned_tabs = 7;
+  expected.open_tabs = 1;
+  expected.folders = 1;
+  expected.split_views = 1;
+  ExpectReport(plan.report, expected);
+
+  const ImportHandoffs& handoffs = plan.handoffs;
+  ASSERT_EQ(handoffs.routing_rules_json.size(), 1u);
+  EXPECT_NE(handoffs.routing_default_json.find("\"littleArc\""),
+            std::string::npos);
+  EXPECT_TRUE(handoffs.auto_archive_raw.empty());
+  EXPECT_TRUE(handoffs.archive_path.empty());
+}

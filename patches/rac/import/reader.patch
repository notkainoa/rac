+TEST(ArcReaderTest, UnicodeRoundTrips) {
+  base::expected<ImportPlan, ArcReadError> result = ReadFixture("unicode");
+  ASSERT_TRUE(result.has_value());
+  const ImportPlan& plan = *result;
+
+  struct Expected {
+    std::string_view title;
+    std::string_view url;
+  };
+  // Adjacent literals keep a hex escape from swallowing the letter after it.
+  const std::array<Expected, 6> kExpected = {{
+      {"\xE6\x9D\xB1\xE4\xBA\xAC\xE3\x81\xAE\xE5\x9C\xB0\xE5\x9B\xB3",
+       "https://\xE4\xBE\x8B\xE3\x81\x88.jp/\xE3\x83\x91\xE3\x82\xB9"},
+      {"\xD9\x85\xD8\xB1\xD8\xAD\xD8\xA8\xD8\xA7 "
+       "\xD8\xA8\xD8\xA7\xD9\x84\xD8\xB9\xD8\xA7\xD9\x84\xD9\x85",
+       "https://example.com/%E2%9C%93?q=\xC3\xBC"},
+      {"\xD7\xA9\xD7\x9C\xD7\x95\xD7\x9D", "https://example.com/3"},
+      // "e" followed by U+0301, not the precomposed U+00E9.
+      {"e\xCC\x81", "https://example.com/4"},
+      // U+202E (right-to-left override) around "evil".
+      {"\xE2\x80\xAE"
+       "evil"
+       "\xE2\x80\xAE",
+       "https://example.com/5"},
+      {"\xF0\x9F\x8F\xB3\xEF\xB8\x8F\xE2\x80\x8D\xF0\x9F\x8C\x88 flag",
+       "https://example.com/6"},
+  }};
+
+  ASSERT_EQ(plan.profiles.size(), 1u);
+  ASSERT_EQ(plan.profiles[0].spaces.size(), 1u);
+  const std::vector<ImportItem>& pinned = plan.profiles[0].spaces[0].pinned;
+  ASSERT_EQ(pinned.size(), kExpected.size());
+  for (size_t i = 0; i < kExpected.size(); ++i) {
+    SCOPED_TRACE(i);
+    // The fixture gives each tab the same custom title and page title.
+    ExpectTab(pinned[i], kExpected[i].url, kExpected[i].title,
+              kExpected[i].title);
+    EXPECT_EQ(pinned[i].created, FixtureCreated());
+  }
+
+  ImportReport expected;
+  expected.profiles = 1;
+  expected.spaces = 1;
+  expected.pinned_tabs = 6;
+  ExpectReport(plan.report, expected);
+}

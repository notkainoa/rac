+// Compares every field of `actual` with `expected`. A test sets only the
+// nonzero fields of `expected`. Issues compare as a set, in any order.
+void ExpectReport(const ImportReport& actual, const ImportReport& expected) {
+  EXPECT_EQ(actual.profiles, expected.profiles) << "profiles";
+  EXPECT_EQ(actual.spaces, expected.spaces) << "spaces";
+  EXPECT_EQ(actual.favorites, expected.favorites) << "favorites";
+  EXPECT_EQ(actual.pinned_tabs, expected.pinned_tabs) << "pinned_tabs";
+  EXPECT_EQ(actual.open_tabs, expected.open_tabs) << "open_tabs";
+  EXPECT_EQ(actual.folders, expected.folders) << "folders";
+  EXPECT_EQ(actual.nested_folders, expected.nested_folders)
+      << "nested_folders";
+  EXPECT_EQ(actual.split_views, expected.split_views) << "split_views";
+  EXPECT_EQ(actual.tab_groups, expected.tab_groups) << "tab_groups";
+  EXPECT_EQ(actual.skipped_live_folders, expected.skipped_live_folders)
+      << "skipped_live_folders";
+  EXPECT_EQ(actual.skipped_easels, expected.skipped_easels)
+      << "skipped_easels";
+  EXPECT_EQ(actual.skipped_notes, expected.skipped_notes) << "skipped_notes";
+  EXPECT_EQ(actual.skipped_unknown, expected.skipped_unknown)
+      << "skipped_unknown";
+  EXPECT_EQ(actual.skipped_tabs_without_url, expected.skipped_tabs_without_url)
+      << "skipped_tabs_without_url";
+  EXPECT_EQ(actual.missing_items, expected.missing_items) << "missing_items";
+  EXPECT_EQ(actual.repeated_items, expected.repeated_items)
+      << "repeated_items";
+  EXPECT_EQ(actual.too_deep, expected.too_deep) << "too_deep";
+  EXPECT_EQ(actual.malformed_entries, expected.malformed_entries)
+      << "malformed_entries";
+  EXPECT_EQ(actual.invalid_urls, expected.invalid_urls) << "invalid_urls";
+  EXPECT_EQ(actual.damage_total(), expected.damage_total()) << "damage_total";
+  EXPECT_EQ(actual.first_nested_folder_path, expected.first_nested_folder_path)
+      << "first_nested_folder_path";
+  EXPECT_EQ(actual.issues.size(), expected.issues.size()) << "issues";
+  for (ImportIssue issue : expected.issues) {
+    EXPECT_TRUE(HasIssue(actual.issues, issue))
+        << "missing issue " << static_cast<int>(issue);
+  }
+}

+// Whether `paths` has an Arc sidebar to import: one file-system check of
+// `StorableSidebar.json`, no reading or parsing. Cheap enough to call while
+// onboarding opens, but still file I/O, so call it on a sequence that may
+// block. `ReadArc()` can still fail on a file this accepts.
+bool ArcSourceExists(const ArcSourcePaths& paths);
+
+// Reads Arc's spaces, favorites, pinned tabs, open tabs, and hand-offs into
+// a plan. Reads only files under `paths`, and changes nothing. Blocks on file
+// I/O, so call it on a sequence that may block. Never crashes on bad input:
+// damaged parts are left out and counted in `ImportPlan::report`.
+base::expected<ImportPlan, ArcReadError> ReadArc(
+    const ArcSourcePaths& paths,
+    const ArcReadLimits& limits = ArcReadLimits());
+
+// The name of an item's file in `SidebarItemsFaviconCache/`: the lowercase
+// hex MD5 of its id's UTF-8 bytes. Any id works, UUID or not.
+std::string ArcFaviconFileName(std::string_view item_id);

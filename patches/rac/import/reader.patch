+// A tab with no children. `title` is the user's name for it; empty means
+// "show the page title".
+void ExpectTab(const ImportItem& item,
+               std::string_view url,
+               std::string_view page_title = std::string_view(),
+               std::string_view title = std::string_view()) {
+  EXPECT_EQ(item.kind, ImportItem::Kind::kTab);
+  EXPECT_FALSE(item.source_id.empty());
+  EXPECT_EQ(item.url, url);
+  EXPECT_EQ(item.page_title, page_title);
+  EXPECT_EQ(item.title, title);
+  EXPECT_EQ(item.group, ImportItem::Group::kNone);
+  EXPECT_TRUE(item.children.empty());
+}
+
+void ExpectFolder(const ImportItem& item,
+                  std::string_view title,
+                  ImportItem::Group group,
+                  size_t child_count) {
+  EXPECT_EQ(item.kind, ImportItem::Kind::kFolder);
+  EXPECT_FALSE(item.source_id.empty());
+  EXPECT_EQ(item.title, title);
+  EXPECT_EQ(item.group, group);
+  EXPECT_TRUE(item.url.empty());
+  EXPECT_TRUE(item.page_title.empty());
+  EXPECT_TRUE(item.favicon_path.empty());
+  EXPECT_EQ(item.children.size(), child_count);
+}
+
+void ExpectFavicon(const ImportItem& item) {
+  EXPECT_TRUE(item.favicon_path.IsAbsolute());
+  EXPECT_EQ(item.favicon_path.BaseName().AsUTF8Unsafe(),
+            ArcFaviconFileName(item.source_id));
+  EXPECT_EQ(item.favicon_path.DirName().BaseName().AsUTF8Unsafe(),
+            kFaviconDirName);
+  EXPECT_TRUE(base::PathExists(item.favicon_path));
+}
+
+int CountFavicons(const std::vector<ImportItem>& items) {
+  int count = 0;
+  for (const ImportItem& item : items) {
+    if (!item.favicon_path.empty()) {
+      ++count;
+    }
+    count += CountFavicons(item.children);
+  }
+  return count;
+}

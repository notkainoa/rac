 #include <variant>
 
 #include "base/base_paths.h"
+#include "base/base_switches.h"
 #include "base/check.h"
 #include "base/command_line.h"
 #include "base/compiler_specific.h"
@@ -1186,6 +1187,22 @@ std::optional<int> ChromeMainDelegate::B
       *base::CommandLine::ForCurrentProcess();
 #endif  // !defined(BUILDING_CHROME_RENDERER)
 
+  // rac: turn on automatic picture-in-picture. Its features are off by
+  // default, and the Blink runtime feature is backed by a base::Feature, and changing the default
+  // in runtime_enabled_features.json5 would rebuild most of Blink. Child
+  // processes inherit --enable-features, so renderers see it too.
+  {
+    base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+    std::string enabled = cl->GetSwitchValueASCII(switches::kEnableFeatures);
+    if (!enabled.empty()) {
+      enabled += ",";
+    }
+    enabled +=
+        "BrowserInitiatedAutomaticPictureInPicture,"
+        "AutoPictureInPictureOnWindowOccluded";
+    cl->AppendSwitchASCII(switches::kEnableFeatures, enabled);
+  }

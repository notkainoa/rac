@@ -0,0 +1,71 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#import "chrome/browser/rac/pip/app_focus_observer_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include <optional>
+
+namespace rac {
+
+namespace {
+
+// Returns whether activating `app` changes which app is in front, or nullopt
+// when it should be ignored (a menu bar app or launcher).
+std::optional<bool> IsAnotherAppInFrontAfterActivating(
+    NSRunningApplication* app) {
+  if (!app || [app isEqual:NSRunningApplication.currentApplication]) {
+    return false;
+  }
+  if (app.activationPolicy != NSApplicationActivationPolicyRegular) {
+    return std::nullopt;
+  }
+  return true;
+}
+
+}  // namespace
+
+struct AppFocusObserver::ObjCStorage {
+  id __strong observer;
+};
+
+AppFocusObserver::AppFocusObserver(base::RepeatingClosure on_change)
+    : on_change_(std::move(on_change)),
+      objc_storage_(std::make_unique<ObjCStorage>()) {
+  another_app_in_front_ =
+      IsAnotherAppInFrontAfterActivating(
+          NSWorkspace.sharedWorkspace.frontmostApplication)
+          .value_or(false);
+
+  base::WeakPtr<AppFocusObserver> weak_this = weak_factory_.GetWeakPtr();
+  objc_storage_->observer = [NSWorkspace.sharedWorkspace.notificationCenter
+      addObserverForName:NSWorkspaceDidActivateApplicationNotification
+                  object:nil
+                   queue:nil
+              usingBlock:^(NSNotification* notification) {
+                NSRunningApplication* app =
+                    notification.userInfo[NSWorkspaceApplicationKey];
+                std::optional<bool> in_front =
+                    IsAnotherAppInFrontAfterActivating(app);
+                if (weak_this && in_front.has_value()) {
+                  weak_this->SetAnotherAppInFront(*in_front);
+                }
+              }];
+}
+
+AppFocusObserver::~AppFocusObserver() {
+  [NSWorkspace.sharedWorkspace.notificationCenter
+      removeObserver:objc_storage_->observer];
+}
+
+void AppFocusObserver::SetAnotherAppInFront(bool another_app_in_front) {
+  if (another_app_in_front_ == another_app_in_front) {
+    return;
+  }
+  another_app_in_front_ = another_app_in_front;
+  on_change_.Run();
+}
+
+}  // namespace rac

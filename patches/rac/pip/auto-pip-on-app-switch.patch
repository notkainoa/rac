+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_PIP_APP_FOCUS_OBSERVER_MAC_H_
+#define CHROME_BROWSER_RAC_PIP_APP_FOCUS_OBSERVER_MAC_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+
+namespace rac {
+
+// Tracks whether another regular app (one with a Dock icon) has taken focus
+// from rac. Menu bar apps and launchers such as Spotlight, Raycast, or
+// 1Password's quick access open briefly over whatever the user is looking at,
+// so they leave the state unchanged.
+class AppFocusObserver {
+ public:
+  // `on_change` runs whenever IsAnotherAppInFront() changes.
+  explicit AppFocusObserver(base::RepeatingClosure on_change);
+  AppFocusObserver(const AppFocusObserver&) = delete;
+  AppFocusObserver& operator=(const AppFocusObserver&) = delete;
+  ~AppFocusObserver();
+
+  bool IsAnotherAppInFront() const { return another_app_in_front_; }
+
+ private:
+  struct ObjCStorage;
+
+  void SetAnotherAppInFront(bool another_app_in_front);
+
+  base::RepeatingClosure on_change_;
+  bool another_app_in_front_ = false;
+  std::unique_ptr<ObjCStorage> objc_storage_;
+  base::WeakPtrFactory<AppFocusObserver> weak_factory_{this};
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_PIP_APP_FOCUS_OBSERVER_MAC_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_PIP_AUTO_PIP_PREFS_H_
+#define CHROME_BROWSER_RAC_PIP_AUTO_PIP_PREFS_H_
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace rac {
+
+// Profile pref: whether videos in this profile's incognito windows enter
+// picture-in-picture automatically. Off by default.
+inline constexpr char kAutoPipInIncognito[] = "rac.auto_pip_in_incognito";
+
+void RegisterAutoPipProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// `prefs` belongs to the regular profile, not the incognito one.
+bool IsAutoPipAllowedInIncognito(const PrefService& prefs);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_PIP_AUTO_PIP_PREFS_H_

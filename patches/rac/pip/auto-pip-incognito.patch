+
+#include "chrome/browser/rac/pip/auto_pip_prefs.h"
+
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+void RegisterAutoPipProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kAutoPipInIncognito, false);
+}
+
+bool IsAutoPipAllowedInIncognito(const PrefService& prefs) {
+  return prefs.GetBoolean(kAutoPipInIncognito);
+}
+

+namespace rac {
+namespace {
+
+using AutoPipPermissionsTest = ChromeRenderViewHostTestHarness;
+
+TEST_F(AutoPipPermissionsTest, RegularProfileHasNoIncognitoRestriction) {
+  ChromePageInfoUiDelegate delegate(web_contents(),
+                                    GURL("https://example.com"));
+  EXPECT_TRUE(
+      delegate.ShouldShowAllow(ContentSettingsType::AUTO_PICTURE_IN_PICTURE));
+  EXPECT_TRUE(delegate
+                  .GetAutomaticallyBlockedReason(
+                      ContentSettingsType::AUTO_PICTURE_IN_PICTURE)
+                  .empty());
+}
+
+TEST_F(AutoPipPermissionsTest, IncognitoControlExplainsProfileGate) {
+  auto contents = content::WebContentsTester::CreateTestWebContents(
+      profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true), nullptr);
+  ChromePageInfoUiDelegate delegate(contents.get(),
+                                    GURL("https://example.com"));
+  EXPECT_FALSE(
+      delegate.ShouldShowAllow(ContentSettingsType::AUTO_PICTURE_IN_PICTURE));
+  EXPECT_EQ(l10n_util::GetStringUTF16(
+                IDS_PAGE_INFO_STATE_TEXT_NOT_ALLOWED_IN_INCOGNITO),
+            delegate.GetAutomaticallyBlockedReason(
+                ContentSettingsType::AUTO_PICTURE_IN_PICTURE));
+
+  profile()->GetPrefs()->SetBoolean(kAutoPipInIncognito, true);
+  EXPECT_TRUE(
+      delegate.ShouldShowAllow(ContentSettingsType::AUTO_PICTURE_IN_PICTURE));
+  EXPECT_TRUE(delegate
+                  .GetAutomaticallyBlockedReason(
+                      ContentSettingsType::AUTO_PICTURE_IN_PICTURE)
+                  .empty());
+
+  profile()->GetPrefs()->SetBoolean(kAutoPipInIncognito, false);
+  EXPECT_FALSE(delegate
+                   .GetAutomaticallyBlockedReason(
+                       ContentSettingsType::AUTO_PICTURE_IN_PICTURE)
+                   .empty());
+}
+

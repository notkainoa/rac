+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#import "chrome/browser/rac/pip/app_focus_observer_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include "base/test/bind.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/rac/pip/auto_pip_prefs.h"
+#include "chrome/test/base/chrome_render_view_host_test_harness.h"
+#include "chrome/test/base/testing_profile.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+// Only the activation policy and NSObject's identity comparison are needed.
+// Posting a synthetic notification avoids driving real apps during unit tests.
+@interface RacPipTestApplication : NSObject
+@property(nonatomic) NSApplicationActivationPolicy activationPolicy;
+@end
+
+@implementation RacPipTestApplication
+@synthesize activationPolicy = _activationPolicy;
+@end
+
+namespace rac {
+namespace {
+
+void ActivateApplication(id app) {
+  [NSWorkspace.sharedWorkspace.notificationCenter
+      postNotificationName:NSWorkspaceDidActivateApplicationNotification
+                    object:nil
+                  userInfo:@{NSWorkspaceApplicationKey : app}];
+}
+
+class AppFocusObserverTest : public ChromeRenderViewHostTestHarness {
+ protected:
+  void SetUp() override {
+    ChromeRenderViewHostTestHarness::SetUp();
+    NavigateAndCommit(url_);
+  }
+
+  void TearDown() override {
+    observer_.reset();
+    incognito_contents_.reset();
+    ChromeRenderViewHostTestHarness::TearDown();
+  }
+
+  HostContentSettingsMap* settings() {
+    return HostContentSettingsMapFactory::GetForProfile(profile());
+  }
+
+  void Observe(content::WebContents* contents) {
+    observer_ = std::make_unique<AppFocusObserver>(
+        contents, base::BindLambdaForTesting([this] { ++changes_; }));
+    ActivateApplication(NSRunningApplication.currentApplication);
+    changes_ = 0;
+  }
+
+  void ActivateOtherApp(NSApplicationActivationPolicy policy =
+                            NSApplicationActivationPolicyRegular) {
+    RacPipTestApplication* app = [[RacPipTestApplication alloc] init];
+    app.activationPolicy = policy;
+    ActivateApplication(app);
+  }
+
+  const GURL url_{"https://example.com/video"};
+  int changes_ = 0;
+  std::unique_ptr<content::WebContents> incognito_contents_;
+  std::unique_ptr<AppFocusObserver> observer_;
+};
+
+TEST_F(AppFocusObserverTest, BlockedAtCreationDoesNotSubscribe) {
+  settings()->SetDefaultContentSetting(
+      ContentSettingsType::AUTO_PICTURE_IN_PICTURE, CONTENT_SETTING_BLOCK);
+  Observe(web_contents());
+  EXPECT_FALSE(observer_->IsObservingAppActivationForTesting());
+  ActivateOtherApp();
+  EXPECT_FALSE(observer_->IsAnotherAppInFront());
+  EXPECT_EQ(0, changes_);
+}
+
+TEST_F(AppFocusObserverTest, GlobalPermissionChangesStopAndRestartObservation) {
+  Observe(web_contents());
+  EXPECT_TRUE(observer_->IsObservingAppActivationForTesting());
+  ActivateOtherApp();
+  EXPECT_TRUE(observer_->IsAnotherAppInFront());
+  EXPECT_EQ(1, changes_);
+
+  settings()->SetDefaultContentSetting(
+      ContentSettingsType::AUTO_PICTURE_IN_PICTURE, CONTENT_SETTING_BLOCK);
+  EXPECT_FALSE(observer_->IsObservingAppActivationForTesting());
+  EXPECT_FALSE(observer_->IsAnotherAppInFront());
+  const int changes_after_block = changes_;
+  ActivateOtherApp();
+  EXPECT_EQ(changes_after_block, changes_);
+
+  settings()->SetDefaultContentSetting(
+      ContentSettingsType::AUTO_PICTURE_IN_PICTURE, CONTENT_SETTING_ALLOW);
+  EXPECT_TRUE(observer_->IsObservingAppActivationForTesting());
+  ActivateApplication(NSRunningApplication.currentApplication);
+  ActivateOtherApp();
+  EXPECT_TRUE(observer_->IsAnotherAppInFront());
+}
+
+TEST_F(AppFocusObserverTest, SiteExceptionsOverrideTheDefault) {
+  Observe(web_contents());
+  settings()->SetContentSettingDefaultScope(
+      url_, url_, ContentSettingsType::AUTO_PICTURE_IN_PICTURE,
+      CONTENT_SETTING_BLOCK);
+  EXPECT_FALSE(observer_->IsObservingAppActivationForTesting());
+  settings()->SetContentSettingDefaultScope(
+      url_, url_, ContentSettingsType::AUTO_PICTURE_IN_PICTURE,
+      CONTENT_SETTING_ALLOW);
+  settings()->SetDefaultContentSetting(
+      ContentSettingsType::AUTO_PICTURE_IN_PICTURE, CONTENT_SETTING_BLOCK);
+  EXPECT_TRUE(observer_->IsObservingAppActivationForTesting());
+}
+
+TEST_F(AppFocusObserverTest, NavigationRechecksTheSitePermission) {
+  Observe(web_contents());
+  const GURL blocked("https://blocked.example/video");
+  settings()->SetContentSettingDefaultScope(
+      blocked, blocked, ContentSettingsType::AUTO_PICTURE_IN_PICTURE,
+      CONTENT_SETTING_BLOCK);
+  EXPECT_TRUE(observer_->IsObservingAppActivationForTesting());
+  NavigateAndCommit(blocked);
+  EXPECT_FALSE(observer_->IsObservingAppActivationForTesting());
+  NavigateAndCommit(url_);
+  EXPECT_TRUE(observer_->IsObservingAppActivationForTesting());
+}
+
+TEST_F(AppFocusObserverTest,
+       IncognitoToggleUpdatesObservationWithoutReloading) {
+  auto* incognito = profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  incognito_contents_ =
+      content::WebContentsTester::CreateTestWebContents(incognito, nullptr);
+  content::WebContentsTester::For(incognito_contents_.get())
+      ->NavigateAndCommit(url_);
+  Observe(incognito_contents_.get());
+  EXPECT_FALSE(observer_->IsObservingAppActivationForTesting());
+  ActivateOtherApp();
+  EXPECT_EQ(0, changes_);
+
+  profile()->GetPrefs()->SetBoolean(kAutoPipInIncognito, true);
+  EXPECT_TRUE(observer_->IsObservingAppActivationForTesting());
+  profile()->GetPrefs()->SetBoolean(kAutoPipInIncognito, false);
+  EXPECT_FALSE(observer_->IsObservingAppActivationForTesting());
+
+  profile()->GetPrefs()->SetBoolean(kAutoPipInIncognito, true);
+  auto* incognito_settings =
+      HostContentSettingsMapFactory::GetForProfile(incognito);
+  incognito_settings->SetDefaultContentSetting(
+      ContentSettingsType::AUTO_PICTURE_IN_PICTURE, CONTENT_SETTING_ASK);
+  EXPECT_FALSE(observer_->IsObservingAppActivationForTesting());
+}
+
+TEST_F(AppFocusObserverTest, LaunchersDoNotChangeAppFocus) {
+  Observe(web_contents());
+  ActivateOtherApp(NSApplicationActivationPolicyAccessory);
+  EXPECT_FALSE(observer_->IsAnotherAppInFront());
+  EXPECT_EQ(0, changes_);
+  ActivateOtherApp();
+  EXPECT_TRUE(observer_->IsAnotherAppInFront());
+  ActivateOtherApp(NSApplicationActivationPolicyAccessory);
+  EXPECT_TRUE(observer_->IsAnotherAppInFront());
+  ActivateApplication(NSRunningApplication.currentApplication);
+  EXPECT_FALSE(observer_->IsAnotherAppInFront());
+}
+
+TEST_F(AppFocusObserverTest, DestructionUnsubscribes) {
+  Observe(web_contents());
+  observer_.reset();
+  ActivateOtherApp();
+  profile()->GetPrefs()->SetBoolean(kAutoPipInIncognito, true);
+  settings()->SetDefaultContentSetting(
+      ContentSettingsType::AUTO_PICTURE_IN_PICTURE, CONTENT_SETTING_BLOCK);
+  EXPECT_EQ(0, changes_);
+}
+
+}  // namespace
+}  // namespace rac

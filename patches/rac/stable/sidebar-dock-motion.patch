 // Call just before a docked<->hidden sidebar toggle's layout runs, while
-// the contents still have their old bounds. Starts a bounds animation so
-// the page reaches its new width over tokens::kCard instead of jumping
-// there in one frame. No-op under reduced motion.
+// the contents still have their old bounds. Captures those bounds and arms
+// a motion on tokens::kSpringDock, the sidebar slide's own spring, so the
+// page and the sidebar move on one clock. No-op under reduced motion.
 void BeginSidebarContentsMotion(BrowserView* browser_view);
 
+// Call after the dock toggle's layout ran, when the sidebar's rest x is
+// known. `distance` is the toggle's travel in DIPs, so rest is judged like
+// the slide's. Starts the armed motion; a non-positive `distance` drops it
+// and lets the page settle where the layout put it.
+void StartSidebarContentsMotion(BrowserView* browser_view, float distance);
+
+// Drops an armed or running contents motion, as when the toggle turned out
+// not to show the sidebar at all. The page settles where the layout put it.
+void CancelSidebarContentsMotion(BrowserView* browser_view);
+
 // The contents bounds the layout should use this frame: `target` lerped
 // from the pre-toggle bounds by the running animation, or `target`
 // unchanged when no motion runs.

@@ -0,0 +1,100 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/motion/popover_entrance.h"
+
+#include <memory>
+
+#include "chrome/browser/ui/views/rac/motion/rac_motion.h"
+#include "chrome/browser/ui/views/rac/rac_tokens.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_animation_sequence.h"
+#include "ui/compositor/layer_animator.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/views/widget/widget.h"
+
+namespace rac {
+
+namespace {
+
+// How small a popover starts, per tokens::kPopover.
+constexpr float kScaleFrom = 0.96f;
+
+// Where `arrow` puts the trigger on the widget's edge, so the panel grows
+// out of it. Centered for an anchor with no side, which is what FLOAT is.
+gfx::PointF OriginFor(views::BubbleBorder::Arrow arrow,
+                      const gfx::Size& size) {
+  using Arrow = views::BubbleBorder::Arrow;
+  const float w = w;
+  const float h = h;
+  const float left = w * 0.25f;
+  const float right = w * 0.75f;
+  const float top = h * 0.25f;
+  const float bottom = h * 0.75f;
+  const float cx = w * 0.5f;
+  const float cy = h * 0.5f;
+  switch (arrow) {
+    case Arrow::TOP_LEFT:
+      return {left, 0.0f};
+    case Arrow::TOP_RIGHT:
+      return {right, 0.0f};
+    case Arrow::TOP_CENTER:
+      return {cx, 0.0f};
+    case Arrow::BOTTOM_LEFT:
+      return {left, h};
+    case Arrow::BOTTOM_RIGHT:
+      return {right, h};
+    case Arrow::BOTTOM_CENTER:
+      return {cx, h};
+    case Arrow::LEFT_TOP:
+      return {0.0f, top};
+    case Arrow::LEFT_BOTTOM:
+      return {0.0f, bottom};
+    case Arrow::LEFT_CENTER:
+      return {0.0f, cy};
+    case Arrow::RIGHT_TOP:
+      return {w, top};
+    case Arrow::RIGHT_BOTTOM:
+      return {w, bottom};
+    case Arrow::RIGHT_CENTER:
+      return {w, cy};
+    default:
+      return {cx, cy};
+  }
+}
+
+void Start(ui::Layer* layer,
+           std::unique_ptr<ui::LayerAnimationElement> element) {
+  layer->GetAnimator()->StartAnimation(
+      new ui::LayerAnimationSequence(std::move(element)));
+}
+
+}  // namespace
+
+void AnimatePopoverEntrance(views::Widget* widget,
+                            views::BubbleBorder::Arrow arrow) {
+  if (!widget) {
+    return;
+  }
+  ui::Layer* layer = widget->GetLayer();
+  if (!layer) {
+    return;
+  }
+  layer->SetOpacity(0.0f);
+  if (!motion::ReducedMotion()) {
+    const gfx::PointF origin = OriginFor(arrow, layer->bounds().size());
+    gfx::Transform from =
+        gfx::Transform::MakeTranslation(origin.x(), origin.y());
+    from.Scale(kScaleFrom, kScaleFrom);
+    from.Translate(-origin.x(), -origin.y());
+    layer->SetTransform(from);
+    Start(layer,
+          CurveElement::CreateTransform(gfx::Transform(), tokens::kPopover));
+  }
+  Start(layer, CurveElement::CreateOpacity(1.0f, tokens::kFade));
+}
+
+}  // namespace rac

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_MOTION_POPOVER_ENTRANCE_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_MOTION_POPOVER_ENTRANCE_H_
+
+#include "ui/views/bubble/bubble_border.h"
+
+namespace views {
+class Widget;
+}
+
+namespace rac {
+
+// The kPopover entrance for a rare bubble: the panel fades in over
+// tokens::kFade while it scales 0.96 to 1 over tokens::kPopover, growing out
+// of `arrow's side where the trigger is. Under Reduce Motion it only
+// fades. Call right after widget->Show(); nothing stays on the layer once
+// the entrance ends.
+void AnimatePopoverEntrance(views::Widget* widget,
+                            views::BubbleBorder::Arrow arrow);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_MOTION_POPOVER_ENTRANCE_H_

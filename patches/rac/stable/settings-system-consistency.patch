+/* rac: one chip for removable list items — shortcut keys and the assistant
+   page's site rules and models. */
+.rac-chip {
+  align-items: center;
+  background: var(--cr-hover-background-color);
+  border: 1px solid transparent;
+  border-radius: 8px;
+  color: var(--cr-primary-text-color);
+  display: inline-flex;
+  font-size: 12px;
+  font-weight: 500;
+  gap: 2px;
+  line-height: 20px;
+  max-width: 100%;
+  min-height: 28px;
+  overflow: hidden;
+  padding-inline-end: 2px;
+  padding-inline-start: 10px;
+  white-space: nowrap;
+}
+
+.rac-chip cr-icon-button {
+  --cr-icon-button-icon-size: 16px;
+  --cr-icon-button-margin-end: 0;
+  --cr-icon-button-margin-start: 0;
+  --cr-icon-button-size: 24px;
+  flex-shrink: 0;
+  margin-inline-start: 4px;
+}
+
+/* rac: an in-card notice box, like the shortcuts page's macOS note. */
+.rac-notice {
+  background: var(--cr-hover-background-color);
+  border-radius: 8px;
+  line-height: 20px;
+  margin: 0 var(--cr-section-padding) 12px;
+  min-height: 0;
+  padding: 12px 16px;
+}
+
 /* rac: a search bubble on a row that opens a subpage sits in the row, by its
    arrow, instead of below the row over the next row's title. */
 cr-link-row > .search-bubble {

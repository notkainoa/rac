+void PinnedTabContainerView::SetFavoriteDropTargetActive(bool active) {
+  if (rac_drop_target_active_ == active) {
+    return;
+  }
+  rac_drop_target_active_ = active;
+  SchedulePaint();
+}
+
+void PinnedTabContainerView::OnPaint(gfx::Canvas* canvas) {
+  if (!rac_drop_target_active_) {
+    return;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(
+      GetColorProvider()->GetColor(kColorRacTabBackgroundHovered));
+  canvas->DrawRoundRect(
+      GetLocalBounds(),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), flags);
+}
+
 const views::ProposedLayout& PinnedTabContainerView::GetLayoutForDrag() const {
   return layout_manager_->target_layout();
 }

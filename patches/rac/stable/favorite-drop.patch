+
+#import <AppKit/AppKit.h>
+
+namespace rac {
+
+void PlayFavoriteDropHaptic() {
+  @autoreleasepool {
+    [[NSHapticFeedbackManager defaultPerformer]
+        performHapticPattern:NSHapticFeedbackPatternAlignment
+                      atTime:NSHapticFeedbackTimeDefault
+             completionBlock:nil];
+  }
+}
+
+}  // namespace rac

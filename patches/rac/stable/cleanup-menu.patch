+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_CLEANUP_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_CLEANUP_BUTTON_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/views/controls/button/button.h"

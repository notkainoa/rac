--- /dev/null
+++ src/chrome/browser/ui/views/rac/sidebar/cleanup_button.cc
@@ -0,0 +1,200 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar/cleanup_button.h"
+
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/rac/cleanup/clear_tabs.h"
+#include "chrome/browser/ui/views/frame/base_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/rac/rac_tokens.h"
+#include "chrome/browser/ui/views/rac/sidebar/pinned_section.h"
+#include "chrome/browser/ui/views/tabs/common/unpinned_tab_container_view.h"
+#include "chrome/grit/rac_strings.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/menus/simple_menu_model.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/view_tracker.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace rac {
+
+namespace {
+
+// Matches the app menu button the button mirrors.
+constexpr int kButtonSize = 28;
+constexpr int kIconSize = 16;
+
+// The submenu's choices, in order, as "clear tabs inactive for this long".
+constexpr base::TimeDelta kInactiveFor[] = {
+    base::Hours(5),
+    base::Days(1),
+    base::Days(2),
+    base::Days(5),
+};
+
+enum Command {
+  kClearAll = 1,
+  kInactiveBase = 100,
+};
+
+// Shows the sidebar's notes for the tabs the Clear kept, under them, the
+// same thing the divider's Clear did after running.
+void ShowKeptRows(views::View* button) {
+  for (views::View* view = button->parent(); view; view = view->parent()) {
+    auto* region = views::AsViewClass<BaseTabStripRegionView>(view);
+    if (!region) {
+      continue;
+    }
+    if (PinnedSection* section =
+            PinnedSection::GetMutable(region->GetUnpinnedTabsContainer())) {
+      section->ShowKeptRows();
+    }
+    return;
+  }
+}
+
+class CleanupMenuModel : public ui::SimpleMenuModel,
+                         public ui::SimpleMenuModel::Delegate {
+ public:
+  CleanupMenuModel(views::View* button, BrowserWindowInterface* browser)
+      : ui::SimpleMenuModel(this), browser_(browser) {
+    button_tracker_.SetView(button);
+    auto inactive = std::make_unique<ui::SimpleMenuModel>(this);
+    inactive->AddItemWithStringId(kInactiveBase + 0, IDS_RAC_CLEAR_INACTIVE_5H);
+    inactive->AddItemWithStringId(kInactiveBase + 1, IDS_RAC_CLEAR_INACTIVE_1D);
+    inactive->AddItemWithStringId(kInactiveBase + 2, IDS_RAC_CLEAR_INACTIVE_2D);
+    inactive->AddItemWithStringId(kInactiveBase + 3, IDS_RAC_CLEAR_INACTIVE_5D);
+    AddSubMenuWithStringId(kInactiveBase, IDS_RAC_CLEAR_INACTIVE_MENU,
+                           inactive.release());
+    AddSeparator(ui::NORMAL_SEPARATOR);
+    AddItemWithStringId(kClearAll, IDS_RAC_CLEAR_ALL);
+  }
+  CleanupMenuModel(const CleanupMenuModel&) = delete;
+  CleanupMenuModel& operator=(const CleanupMenuModel&) = delete;
+  ~CleanupMenuModel() override = default;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (command_id == kClearAll) {
+      cleanup::ClearTabs(browser_);
+    } else {
+      const size_t which = static_cast<size_t>(command_id - kInactiveBase);
+      if (which >= std::size(kInactiveFor)) {
+        return;
+      }
+      cleanup::ClearTabsOlderThan(browser_, kInactiveFor[which]);
+    }
+    if (views::View* button = button_tracker_.view()) {
+      ShowKeptRows(button);
+    }
+  }
+
+ private:
+  views::ViewTracker button_tracker_;
+  raw_ptr<BrowserWindowInterface> browser_;
+};
+
+}  // namespace
+
+CleanupButton::CleanupButton(BrowserView* browser_view)
+    : views::Button(base::BindRepeating(&CleanupButton::ShowMenu,
+                                        base::Unretained(this))),
+      browser_view_(browser_view) {
+  icon_ = AddChildView(std::make_unique<views::ImageView>());
+  icon_->SetCanProcessEventsWithinSubtree(false);
+  const std::u16string name =
+      l10n_util::GetStringUTF16(IDS_RAC_CLEANUP_BUTTON);
+  GetViewAccessibility().SetName(name);
+  SetTooltipText(name);
+  SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  SetAnimationDuration(tokens::kHoverControl.duration);
+  icon_->SetImage(ui::ImageModel::FromVectorIcon(
+      vector_icons::kBroomIcon, kColorRacTextSecondary, kIconSize));
+}
+
+CleanupButton::~CleanupButton() = default;
+
+gfx::Size CleanupButton::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kButtonSize, kButtonSize);
+}
+
+void CleanupButton::Layout(PassKey) {
+  icon_->SetBounds((width() - kIconSize) / 2, (height() - kIconSize) / 2,
+                   kIconSize, kIconSize);
+}
+
+void CleanupButton::StateChanged(ButtonState old_state) {
+  UpdateColor();
+}
+
+void CleanupButton::PaintButtonContents(gfx::Canvas* canvas) {
+  const double hover = hover_animation().GetCurrentValue();
+  if (hover <= 0 && GetState() != STATE_PRESSED) {
+    return;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(
+      GetColorProvider()->GetColor(kColorRacTabBackgroundHovered),
+      GetState() == STATE_PRESSED
+          ? SK_AlphaOPAQUE
+          : static_cast<U8CPU>(hover * SK_AlphaOPAQUE)));
+  canvas->DrawRoundRect(GetLocalBounds(), tokens::kRadiusMenuRow, flags);
+}
+
+void CleanupButton::ShowMenu() {
+  BrowserWindowInterface* browser =
+      browser_view_ ? browser_view_->browser() : nullptr;
+  if (!browser) {
+    return;
+  }
+  menu_ = std::make_unique<CleanupMenuModel>(this, browser);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_.get(), views::MenuRunner::HAS_MNEMONICS,
+      base::BindRepeating(&CleanupButton::OnMenuClosed,
+                          base::Unretained(this)));
+  menu_runner_->RunMenuAt(
+      GetWidget(), nullptr, GetBoundsInScreen(),
+      views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kMouse);
+  SetState(STATE_PRESSED);
+}
+
+void CleanupButton::OnMenuClosed() {
+  SetState(STATE_NORMAL);
+  menu_runner_.reset();
+  menu_.reset();
+}
+
+void CleanupButton::UpdateColor() {
+  const bool active =
+      GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  icon_->SetImage(ui::ImageModel::FromVectorIcon(
+      vector_icons::kBroomIcon,
+      active ? kColorRacTextSecondary : kColorRacTextTertiary, kIconSize));
+}
+
+BEGIN_METADATA(CleanupButton)
+END_METADATA
+
+}  // namespace rac

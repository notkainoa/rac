+class BrowserView;
+
+namespace views {
+class ImageView;
+class MenuRunner;
+}  // namespace views
+
+namespace ui {
+class SimpleMenuModel;
+}  // namespace ui
+
+namespace rac {
+
+// The clean-up button at the end of the sidebar opposite the app menu. Its
+// dropdown clears the space's open tabs by how long they've been inactive,
+// or all of them, the way Clear's action does.
+class CleanupButton : public views::Button {
+  METADATA_HEADER(CleanupButton, views::Button)
+
+ public:
+  explicit CleanupButton(BrowserView* browser_view);
+  CleanupButton(const CleanupButton&) = delete;
+  CleanupButton& operator=(const CleanupButton&) = delete;
+  ~CleanupButton() override;
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void StateChanged(ButtonState old_state) override;
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+
+ private:
+  void ShowMenu();
+  void OnMenuClosed();
+  void UpdateColor();
+
+  const raw_ptr<BrowserView> browser_view_;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  std::unique_ptr<ui::SimpleMenuModel> menu_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_CLEANUP_BUTTON_H_

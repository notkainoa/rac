+void PinnedSection::OnViewHierarchyWillBeDeleted(views::View* observed_view) {
+  // ~View deletes its children, the rows among them, before it calls
+  // OnViewIsDeleting. Their raw_ptrs have to be released while they're still
+  // alive: releasing one that dangles trips DanglingRawPtrReleased.
+  Teardown();
+}
+
 void PinnedSection::OnViewIsDeleting(views::View* observed_view) {
+  Teardown();
+}
+
+void PinnedSection::Teardown() {
   // The container deletes its children, the rows among them, before it
   // deletes this.
   divider_ = nullptr;

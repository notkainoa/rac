+bool IsDefaultBrowserInfoBar(const views::View* view) {
+  if (!views::IsViewClass<InfoBarView>(view)) {
+    return false;
+  }
+  const auto* infobar = static_cast<const InfoBarView*>(view);
+  return infobar->delegate() &&
+         infobar->delegate()->GetIdentifier() ==
+             infobars::InfoBarDelegate::DEFAULT_BROWSER_INFOBAR_DELEGATE;
+}

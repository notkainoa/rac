+gfx::Rect GetInfoBarBottomCardBounds(const gfx::Rect& area,
+                                     const gfx::Size& preferred) {
+  const int width =
+      std::min(preferred.width(), area.width() - 2 * kInfoBarCardMargin);
+  return gfx::Rect(area.x() + (area.width() - width) / 2,
+                   area.bottom() - kInfoBarCardMargin - preferred.height(),
+                   width, preferred.height());
+}

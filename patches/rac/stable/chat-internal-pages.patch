+// The assistant is page-scoped: internal pages (rac://, chrome:// inside)
+// have nothing for it to read and must not show it.
+bool AssistantAllowedOnActiveTab(BrowserWindowInterface* browser) {
+  content::WebContents* contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  return !contents ||
+         !contents->GetLastCommittedURL().SchemeIs(content::kChromeUIScheme);
+}
+
+// Applies the internal-page rule for `browser`: an open panel closes on a
+// rac:// page, and the views that gate on the page refresh. Owns itself; it
+// lives as long as the window.
+class PageGate : public TabStripModelObserver,
+                 public content::WebContentsObserver {
+ public:
+  DECLARE_USER_DATA(PageGate);
+
+  static PageGate* From(BrowserWindowInterface* browser) {
+    return Get(browser->GetUnownedUserDataHost());
+  }
+
+  static PageGate* GetOrCreate(BrowserWindowInterface* browser) {
+    if (PageGate* gate = From(browser)) {
+      return gate;
+    }
+    return new PageGate(browser);
+  }
+
+  PageGate(const PageGate&) = delete;
+  PageGate& operator=(const PageGate&) = delete;
+
+ private:
+  explicit PageGate(BrowserWindowInterface* browser)
+      : browser_(browser),
+        scoped_data_(browser->GetUnownedUserDataHost(), *this) {
+    browser_->GetTabStripModel()->AddObserver(this);
+    Update();
+  }
+
+  ~PageGate() override {
+    browser_->GetTabStripModel()->RemoveObserver(this);
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel*,
+                              const TabStripModelChange&,
+                              const TabStripSelectionChange&) override {
+    Update();
+  }
+
+  void OnTabChangedAt(tabs::TabInterface* tab, TabChangeType) override {
+    if (tab == browser_->GetActiveTabInterface()) {
+      Update();
+    }
+  }
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page&) override { Update(); }
+
+  void Update() {
+    content::WebContents* contents =
+        browser_->GetTabStripModel()->GetActiveWebContents();
+    if (contents != web_contents()) {
+      Observe(contents);
+    }
+    const bool allowed = AssistantAllowedOnActiveTab(browser_);
+    if (AssistantPanelState* state = AssistantPanelState::From(browser_)) {
+      state->NotifyPageChanged();
+      if (!allowed) {
+        if (SidePanelUI* ui = SidePanelUI::From(browser_);
+            ui && ui->IsSidePanelEntryShowing(
+                      SidePanelEntry::Key(SidePanelEntry::Id::kRacAi))) {
+          ui->Close();
+        }
+      }
+    }
+    // Menus and shortcuts follow the active page.
+    chrome::BrowserCommandController::From(browser_)
+        ->UpdateCommandEnabled(IDC_RAC_ASSISTANT_TOGGLE,
+                               CanRunAssistantCommand(browser_));
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  ui::ScopedUnownedUserData<PageGate> scoped_data_;
+};
+
+DEFINE_USER_DATA(PageGate);
+
+}  // namespace

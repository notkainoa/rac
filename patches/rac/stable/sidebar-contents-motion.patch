===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/rac/sidebar_reveal/sidebar_contents_motion.cc
@@ -0,0 +1,142 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_reveal/sidebar_contents_motion.h"
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/multi_contents_view.h"
+#include "chrome/browser/ui/views/rac/motion/rac_motion.h"
+#include "chrome/browser/ui/views/rac/rac_tokens.h"
+#include "ui/base/class_property.h"
+#include "ui/gfx/animation/linear_animation.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace rac {
+class SidebarContentsMotion;
+}
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(rac::SidebarContentsMotion*)
+
+namespace rac {
+
+namespace {
+
+void EndSidebarContentsMotion(BrowserView* browser_view);
+
+}  // namespace
+
+// One resize of the page when the sidebar docks or hides, from the bounds
+// the contents had before the toggle to what each layout now computes.
+// The sidebar itself moves as a layer (SidebarSlide); this moves the page
+// alongside it so sites relayout per frame instead of teleporting to the
+// new width. Lives on the browser view only while its animation runs, so
+// it costs nothing between toggles.
+class SidebarContentsMotion : public gfx::AnimationDelegate {
+ public:
+  explicit SidebarContentsMotion(BrowserView* browser_view)
+      : browser_view_(browser_view),
+        animation_(tokens::kCard.duration,
+                   gfx::LinearAnimation::kDefaultFrameRate,
+                   this) {}
+  SidebarContentsMotion(const SidebarContentsMotion&) = delete;
+  SidebarContentsMotion& operator=(const SidebarContentsMotion&) = delete;
+  // No callbacks while dying: animation_'s teardown could otherwise report
+  // a cancel into this object, and its ClearProperty would free whatever
+  // newer motion already took the key.
+  ~SidebarContentsMotion() override { animation_.set_delegate(nullptr); }
+
+  void Begin(const gfx::Rect& from) {
+    from_ = from;
+    animation_.Start();
+  }
+
+  gfx::Rect Bounds(const gfx::Rect& target) const {
+    const double eased = gfx::Tween::CalculateValue(
+        gfx::Tween::EASE_IN_OUT, animation_.GetCurrentValue());
+    return gfx::Tween::RectValueBetween(eased, from_, target);
+  }
+
+ private:
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    Relayout(browser_view_);
+  }
+  void AnimationEnded(const gfx::Animation* animation) override {
+    EndSidebarContentsMotion(browser_view_);
+  }
+  void AnimationCanceled(const gfx::Animation* animation) override {
+    AnimationEnded(animation);
+  }
+
+  // Lays out right away, so every tick lands on its own frame rather than
+  // whenever the next paint happens to arrive.
+  static void Relayout(BrowserView* browser_view) {
+    if (!browser_view) {
+      return;
+    }
+    browser_view->InvalidateLayout();
+    if (views::Widget* widget = browser_view->GetWidget()) {
+      widget->LayoutRootViewIfNecessary();
+    }
+  }
+
+  const raw_ptr<BrowserView> browser_view_;
+  gfx::Rect from_;
+  gfx::LinearAnimation animation_;
+};
+
+namespace {
+
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(SidebarContentsMotion,
+                                   kSidebarContentsMotionKey)
+
+// Frees the finished motion and settles the page on its final bounds.
+// Called from AnimationEnded: ClearProperty deletes the motion, so this
+// must live outside it.
+void EndSidebarContentsMotion(BrowserView* browser_view) {
+  if (!browser_view) {
+    return;
+  }
+  browser_view->ClearProperty(kSidebarContentsMotionKey);
+  browser_view->InvalidateLayout();
+  if (views::Widget* widget = browser_view->GetWidget()) {
+    widget->LayoutRootViewIfNecessary();
+  }
+}
+
+}  // namespace
+
+void BeginSidebarContentsMotion(BrowserView* browser_view) {
+  if (!browser_view || motion::ReducedMotion()) {
+    return;
+  }
+  views::View* contents = browser_view->multi_contents_view();
+  if (!contents) {
+    return;
+  }
+  auto* motion = browser_view->SetProperty(
+      kSidebarContentsMotionKey,
+      std::make_unique<SidebarContentsMotion>(browser_view));
+  motion->Begin(contents->bounds());
+}
+
+gfx::Rect SidebarContentsBounds(BrowserView* browser_view,
+                                const gfx::Rect& target) {
+  auto* motion = browser_view
+                     ? browser_view->GetProperty(kSidebarContentsMotionKey)
+                     : nullptr;
+  return motion ? motion->Bounds(target) : target;
+}
+
+bool SidebarContentsMotionRunning(BrowserView* browser_view) {
+  return browser_view &&
+         browser_view->GetProperty(kSidebarContentsMotionKey) != nullptr;
+}
+
+}  // namespace rac

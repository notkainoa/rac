@@ -0,0 +1,32 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_CONTENTS_MOTION_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_CONTENTS_MOTION_H_
+
+#include "ui/gfx/geometry/rect.h"
+
+class BrowserView;
+
+namespace rac {
+
+// Call just before a docked<->hidden sidebar toggle's layout runs, while
+// the contents still have their old bounds. Starts a bounds animation so
+// the page reaches its new width over tokens::kCard instead of jumping
+// there in one frame. No-op under reduced motion.
+void BeginSidebarContentsMotion(BrowserView* browser_view);
+
+// The contents bounds the layout should use this frame: `target` lerped
+// from the pre-toggle bounds by the running animation, or `target`
+// unchanged when no motion runs.
+gfx::Rect SidebarContentsBounds(BrowserView* browser_view,
+                                const gfx::Rect& target);
+
+// True while a bounds animation runs, so the contents can treat itself as
+// animating.
+bool SidebarContentsMotionRunning(BrowserView* browser_view);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_CONTENTS_MOTION_H_

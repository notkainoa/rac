+
+// Picking an agent in the shared picker puts chats in agent mode. The page
+// only offers installed ones, but the check that matters (the recipe) is the
+// same one the chat page's picker makes.
+void RacAiHandler::HandleSelectAgent(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  const std::string& id = args[1].GetString();
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_) ||
+      profile_->IsOffTheRecord() ||
+      (!id.empty() && !rac::ai::FindAgentRecipe(id))) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  profile_->GetPrefs()->SetString(rac::ai::kAgentId, id);
   ResolveJavascriptCallback(args[0], CreateState());
 }
 

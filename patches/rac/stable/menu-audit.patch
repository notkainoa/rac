+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+// The Help menu's row in the action table. Pure data, like every row; joins
+// All() through rac_actions_groups.h.
+
+#include "base/containers/span.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/rac/actions/rac_action_ids.h"
+#include "chrome/browser/rac/actions/rac_actions.h"
+#include "chrome/browser/rac/actions/rac_actions_groups.h"
+#include "chrome/grit/rac_strings.h"
+
+namespace rac::action_table {
+
+namespace {
+
+constexpr char kNoArgs[] =
+    R"json({"additionalProperties":false,"properties":{},"required":[],"type":"object"})json";
+
+constexpr Action kHelpActions[] = {
+    // The Help menu's one item: opens rac's issue tracker in a new tab.
+    // Dispatch::kBrowser sends it to ReportIssue() in
+    // chrome/browser/ui/rac/rac_action_handlers.cc.
+    {
+        .id = "report_issue",
+        .command_id = IDC_RAC_REPORT_ISSUE,
+        .label_id = IDS_RAC_MENU_REPORT_ISSUE,
+        .description = "Open rac's issue tracker.",
+        .args_json = kNoArgs,
+        .surfaces = {Surface::kMenu},
+        .menu = Menu::kHelp,
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = McpHints{.read_only = false,
+                          .destructive = false,
+                          .idempotent = false,
+                          .open_world = false},
+        .dispatch = Dispatch::kBrowser,
+    },
+};
+
+}  // namespace
+
+base::span<const Action> HelpActions() {
+  return kHelpActions;
+}
+
+}  // namespace rac::action_table

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_CARD_GATE_H_
+#define CHROME_BROWSER_RAC_AI_CARD_GATE_H_
+
+#include <map>
+#include <string>
+
+namespace rac::ai {
+
+// Which agent approval card the assistant page may answer. A window has one
+// chat page, and the page shows one tab's conversation at a time, so an
+// answer names the conversation, the agent action the card asks about, and
+// the nonce the browser gave the card when it last put it on show. The
+// browser checks all three before the agent hears the answer:
+//
+// - The page must be on screen, and the conversation must be the one it
+//   shows, so after a tab switch a click never reaches another tab's card.
+// - The action must be the one the conversation waits on.
+// - The nonce must be the newest: a card drawn again (the user came back to
+//   its tab, or the page drew the conversation again) gets a new one, and a
+//   click from the copy it replaced is refused.
+//
+// A card is answered once. Ending a conversation (its last tab closed, the
+// user closed its chat, AI turned off) takes its card back.
+class CardGate {
+ public:
+  CardGate();
+  CardGate(const CardGate&) = delete;
+  CardGate& operator=(const CardGate&) = delete;
+  ~CardGate();
+
+  // `conversation` waits on the card for `action_id`, in place of any card
+  // it had. It has no nonce until it is shown.
+  void SetPending(const std::string& conversation,
+                  const std::string& action_id);
+
+  // The page shows `conversation`'s card, with `nonce`. Every earlier nonce
+  // stops working. False, changing nothing, if it has no card.
+  bool Show(const std::string& conversation, const std::string& nonce);
+
+  // The page no longer shows `conversation`: no answer counts until its card
+  // is shown again.
+  void Hide(const std::string& conversation);
+
+  // The action `conversation` waits on, or null.
+  const std::string* PendingAction(const std::string& conversation) const;
+
+  // True if an answer naming `conversation`, `action_id` and `nonce` is for
+  // the card on show now, while the page shows `shown_conversation` and is
+  // itself on screen (`page_showing`: a side panel page is hidden while its
+  // panel is closed, and then no card is on show). Never true for an empty
+  // field.
+  bool Check(bool page_showing,
+             const std::string& shown_conversation,
+             const std::string& conversation,
+             const std::string& action_id,
+             const std::string& nonce) const;
+
+  // Check(), and on success the card is used up.
+  bool Take(bool page_showing,
+            const std::string& shown_conversation,
+            const std::string& conversation,
+            const std::string& action_id,
+            const std::string& nonce);
+
+  // Takes back `conversation`'s card.
+  void Revoke(const std::string& conversation);
+
+  // Takes back every card.
+  void Clear();
+
+ private:
+  struct Card {
+    std::string action_id;
+    // Empty while the card isn't on show.
+    std::string nonce;
+  };
+  // At most one card per conversation: an agent turn waits on one at a time.
+  std::map<std::string, Card> cards_;
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CARD_GATE_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_placement.h"
+
+namespace rac::ai {
+
+ChatMove DecideChatMove(const ActiveTabState& state) {
+  if (state.blocked) {
+    // The assistant never sits beside an internal page.
+    return state.chat_showing ? ChatMove::kStepAside : ChatMove::kNone;
+  }
+  // Another side panel the user opened since keeps its place.
+  if (state.panel_showing) {
+    return ChatMove::kNone;
+  }
+  if (state.has_chat) {
+    return state.stepped_aside ? ChatMove::kComeBack : ChatMove::kNone;
+  }
+  // The two tabs of a split view are read side by side, so moving between
+  // them keeps the chat in view instead of closing it on every click.
+  return state.split_partner_chat_open ? ChatMove::kShareWithSplit
+                                       : ChatMove::kNone;
+}
+
+bool ReleasesChat(ChatHideReason reason, bool window_closing) {
+  return reason == ChatHideReason::kClosed && !window_closing;
+}
+
+bool ViewNeedsWindowPage(const void* view_window, const void* tab_window) {
+  return tab_window && view_window != tab_window;
+}
+
+bool MaySendTo(const std::string& key,
+               const std::string& shown,
+               const std::string& previous) {
+  return !key.empty() && (key == shown || key == previous);
+}
+
+bool MayStopTask(const std::string& key, const std::string& owner) {
+  return !key.empty() && key == owner;
+}
+
+bool MayResumeTask(const std::string& key,
+                   const std::string& owner,
+                   const std::string& shown) {
+  return MayStopTask(key, owner) && key == shown;
+}
+
+}  // namespace rac::ai

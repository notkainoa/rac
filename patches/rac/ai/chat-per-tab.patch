+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_REPLY_LOG_H_
+#define CHROME_BROWSER_RAC_AI_REPLY_LOG_H_
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+
+namespace rac::ai {
+
+// What the browser sent the assistant page about one reply, kept so the
+// page can draw the reply again: its tab was in the background while the
+// reply went on, or the user left and came back. One per conversation, for
+// its latest reply. Text arrives a few words at a time, and consecutive text
+// for the same reply is joined into one entry, so the log grows with the
+// reply, not with the number of updates.
+class ReplyLog {
+ public:
+  // The most a log holds, counted as its events' text and JSON sizes. A
+  // reply that would pass it is stopped (the caller's job) and ends with
+  // AppendFinal(), so a background reply can't grow without bound.
+  static constexpr size_t kMaxBytes = 512 * 1024;
+
+  struct Entry {
+    // The WebUI listener the event went to.
+    std::string name;
+    base::Value value;
+  };
+
+  ReplyLog();
+  ReplyLog(const ReplyLog&) = delete;
+  ReplyLog& operator=(const ReplyLog&) = delete;
+  ~ReplyLog();
+
+  // Forgets the last reply and starts one for `send_id`.
+  void Start(int send_id);
+  void Clear();
+
+  int send_id() const { return send_id_; }
+  bool empty() const { return entries_.empty(); }
+  size_t bytes() const { return bytes_; }
+  const std::vector<Entry>& entries() const { return entries_; }
+
+  // Adds an event of the current reply. False, keeping nothing, when it
+  // would take the log past kMaxBytes, or when no reply was started.
+  bool Append(const std::string& name, const base::Value& value);
+
+  // Adds the reply's last event even at the cap. Later events are refused.
+  void AppendFinal(const std::string& name, const base::Value& value);
+
+  // Starts the log for `send_id` as a reply that was cut short: its text so
+  // far, if any, then a browser stop with `reason`. For a conversation that
+  // came from another window, whose reply stopped on the way.
+  void StartStopped(int send_id,
+                    const std::string& text,
+                    const std::string& reason);
+
+  // True once the log refused an event or took its final one.
+  bool closed() const { return closed_; }
+
+ private:
+  static size_t SizeOf(const base::Value& value);
+  // A text-only update ({id, delta}) for the current reply.
+  bool IsText(const std::string& name, const base::Value& value) const;
+
+  int send_id_ = 0;
+  size_t bytes_ = 0;
+  bool closed_ = false;
+  std::vector<Entry> entries_;
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_REPLY_LOG_H_

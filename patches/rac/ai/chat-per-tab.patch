+  if (!tab->IsActivated()) {
+    // Open on the tab, so it shows when the user goes there.
+    SidePanelRegistry::From(tab)->SetActiveEntry(tab_chat->entry());
+    return;
+  }
+  SidePanelUI* ui = SidePanelUI::From(browser);
+  if (ui && !ui->IsSidePanelShowing() && !IsAssistantBlockedHere(browser)) {
+    ShowTabChat(tab, SidePanelOpenTrigger::kTabChanged, /*keep_focus=*/true,

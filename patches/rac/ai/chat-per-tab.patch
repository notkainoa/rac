+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/card_gate.h"
+
+namespace rac::ai {
+
+CardGate::CardGate() = default;
+CardGate::~CardGate() = default;
+
+void CardGate::SetPending(const std::string& conversation,
+                          const std::string& action_id) {
+  if (conversation.empty() || action_id.empty()) {
+    Revoke(conversation);
+    return;
+  }
+  cards_[conversation] = {action_id, std::string()};
+}
+
+bool CardGate::Show(const std::string& conversation, const std::string& nonce) {
+  auto it = cards_.find(conversation);
+  if (it == cards_.end() || nonce.empty()) {
+    return false;
+  }
+  it->second.nonce = nonce;
+  return true;
+}
+
+void CardGate::Hide(const std::string& conversation) {
+  if (auto it = cards_.find(conversation); it != cards_.end()) {
+    it->second.nonce.clear();
+  }
+}
+
+const std::string* CardGate::PendingAction(
+    const std::string& conversation) const {
+  auto it = cards_.find(conversation);
+  return it == cards_.end() ? nullptr : &it->second.action_id;
+}
+
+bool CardGate::Check(bool page_showing,
+                     const std::string& shown_conversation,
+                     const std::string& conversation,
+                     const std::string& action_id,
+                     const std::string& nonce) const {
+  if (!page_showing || conversation.empty() || action_id.empty() ||
+      nonce.empty() || conversation != shown_conversation) {
+    return false;
+  }
+  auto it = cards_.find(conversation);
+  return it != cards_.end() && it->second.action_id == action_id &&
+         !it->second.nonce.empty() && it->second.nonce == nonce;
+}
+
+bool CardGate::Take(bool page_showing,
+                    const std::string& shown_conversation,
+                    const std::string& conversation,
+                    const std::string& action_id,
+                    const std::string& nonce) {
+  if (!Check(page_showing, shown_conversation, conversation, action_id,
+             nonce)) {
+    return false;
+  }
+  cards_.erase(conversation);
+  return true;
+}
+
+void CardGate::Revoke(const std::string& conversation) {
+  cards_.erase(conversation);
+}
+
+void CardGate::Clear() {
+  cards_.clear();
+}
+
+}  // namespace rac::ai

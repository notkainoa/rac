+base::DictValue PageHandler::DescribeChat(Chat& chat) {
+  base::DictValue dict;
+  dict.Set("key", chat.key);
+  dict.Set("id", chat.history_id);
+  dict.Set("title", chat.title);
+  dict.Set("titleRequested", chat.title_requested);
+  dict.Set("messages", MessagesToPage(chat.messages));
+  if (chat.log.send_id() == 0) {
+    return dict;
+  }
+  // The card the conversation waits on is drawn again with a new nonce, so
+  // a click from the copy it replaces no longer counts.
+  const std::string* pending = cards_.PendingAction(chat.key);
+  const ReplyLog::Entry* card = nullptr;
+  for (const ReplyLog::Entry& entry : chat.log.entries()) {
+    const base::DictValue* event = entry.value.GetIfDict();
+    const std::string* id =
+        pending && entry.name == kAgentEvent && event && IsCardEvent(*event)
+            ? event->FindString("id")
+            : nullptr;
+    if (id && *id == *pending) {
+      card = &entry;
+    }
+  }
+  base::ListValue events;
+  for (const ReplyLog::Entry& entry : chat.log.entries()) {
+    base::Value value = entry.value.Clone();
+    if (&entry == card) {
+      std::string nonce = NewToken();
+      if (cards_.Show(chat.key, nonce)) {
+        value.GetDict().Set("nonce", std::move(nonce));
+      }
+    }
+    events.Append(base::DictValue()
+                      .Set("name", entry.name)
+                      .Set("value", std::move(value)));
+  }
+  dict.Set("reply", base::DictValue()
+                        .Set("sendId", chat.log.send_id())
+                        .Set("open", chat.reply_open)
+                        .Set("agentId", chat.agent_id)
+                        .Set("agentName", chat.agent_name)
+                        .Set("events", std::move(events)));
+  return dict;
+}

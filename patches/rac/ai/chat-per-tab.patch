+void ShowAssistantConversationBesideTab(tabs::TabInterface* tab,
+                                        const std::string& conversation) {
+  BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (conversation.empty() || !CanHaveAssistant(browser)) {
+    return;

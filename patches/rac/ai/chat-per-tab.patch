+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_CHAT_PLACEMENT_H_
+#define CHROME_BROWSER_RAC_AI_CHAT_PLACEMENT_H_
+
+#include <string>
+
+namespace rac::ai {
+
+// The assistant's chat belongs to tabs, not to the window: each tab shows its
+// own chat, opened on that tab, and the side panel follows the active tab.
+// These decide the few moves rac makes on top of what Chromium's per-tab side
+// panel entries already do.
+
+// The window's active tab, or the page in it, has just changed.
+struct ActiveTabState {
+  // The tab shows an internal page (IsAssistantBlockedHere()).
+  bool blocked = false;
+  // The side panel shows this tab's chat, and isn't closing.
+  bool chat_showing = false;
+  // The side panel shows anything at all.
+  bool panel_showing = false;
+  // This tab's chat stepped aside for an internal page and hasn't come back.
+  bool stepped_aside = false;
+  // This tab has a chat (its own, or one it shares).
+  bool has_chat = false;
+  // The tab active just before this one shares a split view with it, and
+  // its chat was open when the user left it.
+  bool split_partner_chat_open = false;
+};
+
+enum class ChatMove {
+  kNone,
+  // Close the panel and keep the chat: the tab now shows an internal page.
+  kStepAside,
+  // Open the tab's chat again: the tab is back on a web page.
+  kComeBack,
+  // Show the split partner's chat beside this tab too.
+  kShareWithSplit,
+};
+
+ChatMove DecideChatMove(const ActiveTabState& state);
+
+// Why a tab's chat left the panel. Mirrors SidePanelEntryHideReason.
+enum class ChatHideReason {
+  // The panel closed: the user closed it, or something else did.
+  kClosed,
+  // Another side panel took its place.
+  kReplaced,
+  // The user, the agent, or a closing tab switched to another tab.
+  kTabSwitched,
+};
+
+// Whether the tab lets its chat go. Only closing the panel does that, and not
+// while the window is closing, when the chat goes with its tabs. A chat shared
+// with other tabs stays with them; one with no tab left ends.
+bool ReleasesChat(ChatHideReason reason, bool window_closing);
+
+// A side panel view shows the chat page of the window its tab is in now. A
+// cached view that moved with its tab to another window still holds the old
+// window's page, and must take the new window's instead. `view_window` and
+// `tab_window` only compare.
+bool ViewNeedsWindowPage(const void* view_window, const void* tab_window);
+
+// Which conversation a send from the side panel page may go to: the one on
+// show, or the one shown just before it, for a send that crossed a tab switch
+// on its way. Never an empty key.
+bool MaySendTo(const std::string& key,
+               const std::string& shown,
+               const std::string& previous);
+
+// Stop names the conversation whose task it stops, and stops only that
+// conversation's own task.
+bool MayStopTask(const std::string& key, const std::string& owner);
+
+// Resume also needs the conversation to be on show: the user resumes the task
+// they are looking at.
+bool MayResumeTask(const std::string& key,
+                   const std::string& owner,
+                   const std::string& shown);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CHAT_PLACEMENT_H_

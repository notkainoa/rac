+base::Value PageHandler::CarrySnapshot(const Chat& chat) {
+  base::DictValue snapshot;
+  snapshot.Set("id", chat.history_id);
+  snapshot.Set("title", chat.title);
+  snapshot.Set("titleRequested", chat.title_requested);
+  std::vector<StoredMessage> messages = chat.messages;
+  if (chat.reply_open) {
+    // The reply stops with the move: the new window draws what it had, and
+    // says why it ended, even before its first word.
+    snapshot.Set("stopped", true);
+    snapshot.Set("partialReply", chat.reply_text);
+  } else if (!chat.reply_text.empty()) {
+    messages.push_back({"assistant", chat.reply_text, {}});
+  }
+  snapshot.Set("messages", MessagesToPage(messages));
+  return base::Value(std::move(snapshot));
+}
+
+void PageHandler::EndChat(const std::string& key) {
+  auto it = chats_.find(key);
+  if (it == chats_.end()) {
+    return;
+  }
+  // Its reply, its ACP run, and its agent turn with any card waiting.
+  VLOG(1) << "rac assistant: a conversation ended"
+          << (OwnerChat() == it->second.get() ? ", and its agent task with it"
+                                              : "");
+  StopChat(*it->second);
+  cards_.Revoke(key);
+  if (shown_key_ == key) {
+    shown_key_.clear();
+  }
+  if (previous_shown_key_ == key) {
+    previous_shown_key_.clear();
+  }
+  chats_.erase(it);
+}

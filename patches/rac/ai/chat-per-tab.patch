+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_placement.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+TEST(RacAiChatPlacementTest, AWebTabWithNothingToDoStaysAsItIs) {
+  EXPECT_EQ(DecideChatMove({}), ChatMove::kNone);
+  EXPECT_EQ(
+      DecideChatMove(
+          {.chat_showing = true, .panel_showing = true, .has_chat = true}),
+      ChatMove::kNone);
+  // A tab with a chat that is merely closed keeps it closed.
+  EXPECT_EQ(DecideChatMove({.has_chat = true}), ChatMove::kNone);
+}
+
+TEST(RacAiChatPlacementTest, AnInternalPageSendsAShowingChatAside) {
+  EXPECT_EQ(DecideChatMove({.blocked = true,
+                            .chat_showing = true,
+                            .panel_showing = true,
+                            .has_chat = true}),
+            ChatMove::kStepAside);
+  // Nothing to send aside: the panel is closed, or shows something else.
+  EXPECT_EQ(DecideChatMove({.blocked = true, .has_chat = true}),
+            ChatMove::kNone);
+  EXPECT_EQ(DecideChatMove(
+                {.blocked = true, .panel_showing = true, .has_chat = true}),
+            ChatMove::kNone);
+}
+
+TEST(RacAiChatPlacementTest, AnInternalPageNeverBringsAChatBack) {
+  EXPECT_EQ(DecideChatMove(
+                {.blocked = true, .has_chat = true, .stepped_aside = true}),
+            ChatMove::kNone);
+  EXPECT_EQ(DecideChatMove({.blocked = true, .split_partner_chat_open = true}),
+            ChatMove::kNone);
+}
+
+TEST(RacAiChatPlacementTest, BackOnAWebPageTheChatReturns) {
+  EXPECT_EQ(DecideChatMove({.has_chat = true, .stepped_aside = true}),
+            ChatMove::kComeBack);
+}
+
+TEST(RacAiChatPlacementTest, AnotherPanelKeepsItsPlace) {
+  EXPECT_EQ(
+      DecideChatMove(
+          {.panel_showing = true, .has_chat = true, .stepped_aside = true}),
+      ChatMove::kNone);
+  EXPECT_EQ(
+      DecideChatMove({.panel_showing = true, .split_partner_chat_open = true}),
+      ChatMove::kNone);
+}
+
+TEST(RacAiChatPlacementTest, ASplitPartnerSharesItsOpenChat) {
+  EXPECT_EQ(DecideChatMove({.split_partner_chat_open = true}),
+            ChatMove::kShareWithSplit);
+  // A tab with a chat of its own shows that one instead.
+  EXPECT_EQ(DecideChatMove({.has_chat = true, .split_partner_chat_open = true}),
+            ChatMove::kNone);
+}
+
+TEST(RacAiChatPlacementTest, OnlyClosingThePanelReleasesTheChat) {
+  EXPECT_TRUE(ReleasesChat(ChatHideReason::kClosed, false));
+  EXPECT_FALSE(ReleasesChat(ChatHideReason::kTabSwitched, false));
+  EXPECT_FALSE(ReleasesChat(ChatHideReason::kReplaced, false));
+  // A closing window takes the chat with its tabs.
+  EXPECT_FALSE(ReleasesChat(ChatHideReason::kClosed, true));
+}
+
+}  // namespace
+}  // namespace rac::ai

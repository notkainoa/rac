+void PageHandler::SaveInBackground(Chat& chat, bool failed) {
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  if (!service || !profile_->GetPrefs()->GetBoolean(kSaveHistory) ||
+      !IsValidConversationId(chat.history_id)) {
+    return;
+  }
+  Conversation conversation;
+  conversation.id = chat.history_id;
+  conversation.title = chat.title;
+  conversation.updated = base::Time::Now();
+  conversation.messages = chat.messages;
+  if (!failed && !chat.reply_text.empty()) {
+    conversation.messages.push_back({"assistant", chat.reply_text, {}});
+  }
+  if (!conversation.messages.empty()) {
+    service->history_store().Save(std::move(conversation));
+  }
+}

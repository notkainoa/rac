+void AssistantWebView::TakePage() {
+  tabs::TabInterface* tab = tab_.Get();
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  // Chromium keeps the cached view of a tab's open entry, so a view can come
+  // with its tab from another window. It shows this window's page then,
+  // never the old window's: that page belongs to the other window's tabs.
+  if (ViewNeedsWindowPage(chat_->window(), window)) {
+    VLOG(1) << "rac assistant: a chat view came with its tab from another "
+               "window, so it takes this window's page";
+    chat_->Hide(this);
+    scoped_refptr<AssistantChat> old =
+        std::exchange(chat_, AssistantChat::GetOrCreate(window));
+    // This runs while the tab is inserted into its new window, and the old
+    // page may end with this reference: let it go after, as
+    // TabChat::ReleasePage() does.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce([](scoped_refptr<AssistantChat>) {}, std::move(old)));
+  }
+  // A cached view shown again after its tab's chat closed starts a new
+  // conversation, as a new view would; a tab that moved holds its new
+  // window's page.
+  if (TabChat* tab_chat = tab ? TabChat::From(tab) : nullptr) {
+    tab_chat->EnsureConversation();
+  }
+  chat_->Show(this, tab);
+}

+bool PageHandler::Emit(Chat& chat, const char* name, base::Value value) {
+  if (chat.log.send_id() != 0) {
+    if (chat.log.closed()) {
+      return false;
+    }
+    if (!chat.log.Append(name, value)) {
+      StopForCap(chat);
+      return false;
+    }
+  }
+  if (!IsJavascriptAllowed() || chat.key != shown_key_) {
+    return true;
+  }
+  base::DictValue& event = value.GetDict();
+  event.Set("conversation", chat.key);
+  if (std::string_view(name) == kAgentEvent && IsCardEvent(event)) {
+    const std::string* id = event.FindString("id");
+    const std::string* pending = cards_.PendingAction(chat.key);
+    std::string nonce = NewToken();
+    if (id && pending && *id == *pending && cards_.Show(chat.key, nonce)) {
+      event.Set("nonce", std::move(nonce));
+    }
+  }
+  FireWebUIListener(name, value);
+  return true;
+}

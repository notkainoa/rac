+void ShowAssistantForTab(tabs::TabInterface* tab, bool suppress_animations) {
+  BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!CanHaveAssistant(browser)) {
+    return;
+  }
+  if (!tab->IsActivated()) {
+    TabStripModel* tabs = browser->GetTabStripModel();
+    const int index = tabs ? tabs->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    if (index == TabStripModel::kNoTab) {
+      return;
+    }
+    tabs->ActivateTabAt(index);
+  }
+  // The panel never opens beside an internal page.
+  if (IsAssistantBlockedHere(browser)) {
+    return;
+  }
+  ShowTabChat(tab, SidePanelOpenTrigger::kToolbarButton, /*keep_focus=*/false,
+              suppress_animations);
+}
+
+void ToggleAssistantPanel(BrowserWindowInterface* browser) {
+  SidePanelUI* ui = SidePanelUI::From(browser);
+  if (!ui) {
+    return;
+  }
+  if (IsAssistantPanelOpen(browser)) {
+    ui->Close();
+    return;
+  }
+  ShowAssistantForTab(browser->GetActiveTabInterface(),
+                      /*suppress_animations=*/false);
+}

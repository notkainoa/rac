+std::optional<std::vector<StoredMessage>> ReadMessages(
+    const base::ListValue& list) {
+  if (list.size() > kMaxMessages) {
+    return std::nullopt;
+  }
+  std::vector<StoredMessage> messages;
+  size_t total = 0;
+  for (const base::Value& value : list) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* role = dict ? dict->FindString("role") : nullptr;
+    const std::string* text = dict ? dict->FindString("text") : nullptr;
+    if (!role || !text || (*role != "user" && *role != "assistant") ||
+        !base::IsStringUTF8(*text)) {

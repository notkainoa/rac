+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/card_gate.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+// Tab A's conversation waits on card "c1", shown with nonce "n1".
+class RacAiCardGateTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    gate_.SetPending("A", "c1");
+    ASSERT_TRUE(gate_.Show("A", "n1"));
+  }
+
+  CardGate gate_;
+};
+
+TEST_F(RacAiCardGateTest, TakesTheAnswerForTheCardOnShow) {
+  EXPECT_TRUE(gate_.Check(true, "A", "A", "c1", "n1"));
+  EXPECT_TRUE(gate_.Take(true, "A", "A", "c1", "n1"));
+}
+
+// 1. The answer is bound to the conversation and to the action.
+TEST_F(RacAiCardGateTest, NeedsTheConversationAndTheAction) {
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c2", "n1"));
+  EXPECT_FALSE(gate_.Take(true, "A", "B", "c1", "n1"));
+  EXPECT_FALSE(gate_.Take(true, "A", "", "c1", "n1"));
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "", "n1"));
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c1", ""));
+  // None of them used the card up.
+  EXPECT_TRUE(gate_.Take(true, "A", "A", "c1", "n1"));
+}
+
+// 2. After a switch to tab B, a click left over from A's card, or one that
+// names A's action from B, does nothing.
+TEST_F(RacAiCardGateTest, ATabSwitchStopsTheOtherTabsCard) {
+  gate_.SetPending("B", "c9");
+  ASSERT_TRUE(gate_.Show("B", "n9"));
+  gate_.Hide("A");
+  EXPECT_FALSE(gate_.Take(true, "B", "A", "c1", "n1"));
+  EXPECT_FALSE(gate_.Take(true, "B", "B", "c1", "n1"));
+  EXPECT_FALSE(gate_.Take(true, "B", "B", "c1", "n9"));
+  EXPECT_TRUE(gate_.Take(true, "B", "B", "c9", "n9"));
+  // Back on A, its card counts only once it is drawn again.
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c1", "n1"));
+  ASSERT_TRUE(gate_.Show("A", "n2"));
+  EXPECT_TRUE(gate_.Take(true, "A", "A", "c1", "n2"));
+}
+
+TEST_F(RacAiCardGateTest, AHiddenCardTakesNoAnswer) {
+  // The panel closed on a tab with no chat of its own: the page still shows
+  // A's card, off screen. The handler passes whether the page is showing.
+  EXPECT_FALSE(gate_.Check(false, "A", "A", "c1", "n1"));
+  EXPECT_FALSE(gate_.Take(false, "A", "A", "c1", "n1"));
+  // The card isn't used up: on screen again, it answers.
+  EXPECT_TRUE(gate_.Check(true, "A", "A", "c1", "n1"));
+  gate_.Hide("A");
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c1", "n1"));
+}
+
+// 3. A card drawn again gets a new nonce; the copy it replaced is stale.
+TEST_F(RacAiCardGateTest, AReplacedCardsClickIsStale) {
+  ASSERT_TRUE(gate_.Show("A", "n2"));
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c1", "n1"));
+  EXPECT_TRUE(gate_.Take(true, "A", "A", "c1", "n2"));
+}
+
+TEST_F(RacAiCardGateTest, ANewCardReplacesTheOld) {
+  gate_.SetPending("A", "c2");
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c2", "n1"));
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c1", "n1"));
+  ASSERT_TRUE(gate_.Show("A", "n3"));
+  EXPECT_FALSE(gate_.Take(true, "A", "A", "c1", "n3"));
+  EXPECT_TRUE(gate_.Take(true, "A", "A", "c2", "n3"));
+}
+
+TEST_F(RacAiCardGateTest, ACardIsAnsweredOnce) {
+  ASSERT_TRUE(gate_.Take(true, "A", "A", "c1", "n1"));
+  EXPECT_FALSE(gate_.Check(true, "A", "A", "c1", "n1"));
+  EXPECT_EQ(gate_.PendingAction("A"), nullptr);
+  EXPECT_FALSE(gate_.Show("A", "n2"));
+}
+
+// 4. Closing the conversation's tab (or its chat) takes its card back.
+TEST_F(RacAiCardGateTest, EndingTheConversationTakesItsCardBack) {
+  gate_.SetPending("B", "c9");
+  ASSERT_TRUE(gate_.Show("B", "n9"));
+  gate_.Revoke("A");
+  EXPECT_EQ(gate_.PendingAction("A"), nullptr);

+void ShowTabChat(tabs::TabInterface* tab,
+                 SidePanelOpenTrigger trigger,
+                 bool keep_focus,
+                 bool suppress_animations) {
+  BrowserWindowInterface* browser = tab->GetBrowserWindowInterface();
+  SidePanelUI* ui = browser ? SidePanelUI::From(browser) : nullptr;
+  if (!ui || !TabChat::GetOrCreate(tab)) {
+    return;
+  }
+  // Showing the panel focuses it. When the chat comes back on its own,
+  // focus stays where the user put it.
+  BrowserView* browser_view =
+      keep_focus ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  views::FocusManager* focus =
+      browser_view ? browser_view->GetFocusManager() : nullptr;
+  views::ViewTracker focused(focus ? focus->GetFocusedView() : nullptr);
+  ui->Show(ChatKey(), trigger, suppress_animations);
+  if (focus && focused.view()) {
+    focus->SetFocusedView(focused.view());
+  }

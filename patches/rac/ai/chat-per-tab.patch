+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/reply_log.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/json/json_writer.h"
+
+namespace rac::ai {
+
+namespace {
+constexpr char kUpdate[] = "rac-ai-update";
+}  // namespace
+
+ReplyLog::ReplyLog() = default;
+ReplyLog::~ReplyLog() = default;
+
+void ReplyLog::Start(int send_id) {
+  Clear();
+  send_id_ = send_id;
+}
+
+void ReplyLog::Clear() {
+  send_id_ = 0;
+  bytes_ = 0;
+  closed_ = false;
+  entries_.clear();
+}
+
+// static
+size_t ReplyLog::SizeOf(const base::Value& value) {
+  std::string json;
+  base::JSONWriter::Write(value, &json);
+  // The listener name and the entry itself, roughly.
+  return json.size() + 32;
+}
+
+bool ReplyLog::IsText(const std::string& name, const base::Value& value) const {
+  const base::DictValue* dict = value.GetIfDict();
+  if (name != kUpdate || !dict || dict->size() != 2u) {
+    return false;
+  }
+  const std::optional<int> id = dict->FindInt("id");
+  return id && *id == send_id_ && dict->FindString("delta");
+}
+
+bool ReplyLog::Append(const std::string& name, const base::Value& value) {
+  if (send_id_ == 0 || closed_) {
+    return false;
+  }
+  if (IsText(name, value) && !entries_.empty() &&
+      IsText(entries_.back().name, entries_.back().value)) {
+    const std::string& delta = *value.GetDict().FindString("delta");
+    if (bytes_ + delta.size() > kMaxBytes) {
+      closed_ = true;
+      return false;
+    }
+    std::string* joined = entries_.back().value.GetDict().FindString("delta");
+    joined->append(delta);
+    bytes_ += delta.size();
+    return true;
+  }
+  const size_t size = SizeOf(value);
+  if (bytes_ + size > kMaxBytes) {
+    closed_ = true;
+    return false;
+  }
+  entries_.push_back({name, value.Clone()});
+  bytes_ += size;
+  return true;
+}
+
+void ReplyLog::StartStopped(int send_id,
+                            const std::string& text,
+                            const std::string& reason) {
+  Start(send_id);
+  if (!text.empty()) {
+    Append(
+        kUpdate,
+        base::Value(base::DictValue().Set("id", send_id).Set("delta", text)));
+  }
+  AppendFinal(kUpdate, base::Value(base::DictValue()
+                                       .Set("id", send_id)
+                                       .Set("error", reason)
+                                       .Set("stopped", true)
+                                       .Set("done", true)));
+}
+
+void ReplyLog::AppendFinal(const std::string& name, const base::Value& value) {
+  if (send_id_ == 0) {
+    return;
+  }
+  entries_.push_back({name, value.Clone()});
+  bytes_ += SizeOf(value);
+  closed_ = true;
+}
+

+
+TEST(RacAiReplyLogTest, TextForOneReplyIsJoined) {
+  ReplyLog log;
+  log.Start(7);
+  EXPECT_TRUE(log.Append("rac-ai-update", Delta(7, "Apples ")));
+  EXPECT_TRUE(log.Append("rac-ai-update", Delta(7, "grow ")));
+  EXPECT_TRUE(log.Append("rac-ai-update", Delta(7, "on trees.")));
+  ASSERT_EQ(log.entries().size(), 1u);
+  EXPECT_EQ(*log.entries()[0].value.GetDict().FindString("delta"),
+            "Apples grow on trees.");
+}
+
+TEST(RacAiReplyLogTest, OtherEventsKeepTheirOrder) {
+  ReplyLog log;
+  log.Start(7);
+  log.Append("rac-ai-update", Delta(7, "One "));
+  log.Append("racAiAgentEvent",
+             base::Value(base::DictValue().Set("type", "step_started")));
+  log.Append("rac-ai-update", Delta(7, "two"));
+  log.Append("rac-ai-update",
+             base::Value(base::DictValue().Set("id", 7).Set("done", true)));
+  ASSERT_EQ(log.entries().size(), 4u);
+  EXPECT_EQ(log.entries()[1].name, "racAiAgentEvent");
+  EXPECT_EQ(*log.entries()[2].value.GetDict().FindString("delta"), "two");
+  EXPECT_TRUE(log.entries()[3].value.GetDict().FindBool("done").value());
+}
+
+TEST(RacAiReplyLogTest, AnotherRepliesTextIsNotJoined) {
+  ReplyLog log;
+  log.Start(7);
+  log.Append("rac-ai-update", Delta(7, "mine"));
+  log.Append("rac-ai-update", Delta(6, "an older reply's"));
+  EXPECT_EQ(log.entries().size(), 2u);
+}
+
+TEST(RacAiReplyLogTest, NothingIsKeptWithoutAReply) {
+  ReplyLog log;
+  EXPECT_FALSE(log.Append("rac-ai-update", Delta(1, "lost")));
+  EXPECT_TRUE(log.empty());
+}
+
+TEST(RacAiReplyLogTest, StartingAReplyForgetsTheLast) {
+  ReplyLog log;
+  log.Start(1);
+  log.Append("rac-ai-update", Delta(1, "old"));
+  log.Start(2);
+  EXPECT_TRUE(log.empty());
+  EXPECT_EQ(log.send_id(), 2);
+  EXPECT_EQ(log.bytes(), 0u);
+}
+
+TEST(RacAiReplyLogTest, TheCapStopsGrowthAndKeepsTheTranscriptWhole) {
+  ReplyLog log;
+  log.Start(3);
+  const std::string chunk(4096, 'a');
+  size_t appended = 0;
+  while (log.Append("rac-ai-update", Delta(3, chunk))) {
+    ++appended;
+    ASSERT_LT(appended, 1000u);
+  }
+  EXPECT_TRUE(log.closed());
+  EXPECT_LE(log.bytes(), ReplyLog::kMaxBytes);
+  // The refused chunk left no partial text behind: the reply is whole
+  // chunks only.
+  const std::string& text =
+      *log.entries().back().value.GetDict().FindString("delta");
+  EXPECT_EQ(text.size(), appended * chunk.size());
+  // Nothing more gets in, text or not.
+  EXPECT_FALSE(log.Append("rac-ai-update", Delta(3, "x")));
+  EXPECT_FALSE(log.Append("racAiAgentEvent", base::Value(base::DictValue())));
+  // The reply still ends, with the browser's reason.
+  log.AppendFinal("rac-ai-update", base::Value(base::DictValue()
+                                                   .Set("id", 3)
+                                                   .Set("error", "too long")
+                                                   .Set("stopped", true)
+                                                   .Set("done", true)));
+  EXPECT_TRUE(log.entries().back().value.GetDict().FindBool("done").value());
+  EXPECT_FALSE(log.Append("rac-ai-update", Delta(3, "after")));
+}
+
+// A reply cut short by its tab moving draws as its text, then the stop.
+TEST(RacAiReplyLogTest, AStoppedReplyKeepsItsTextAndSaysWhy) {
+  ReplyLog log;
+  log.StartStopped(1, "Apples grow", "Stopped because the tab moved.");
+  ASSERT_EQ(log.entries().size(), 2u);
+  EXPECT_EQ(log.send_id(), 1);
+  EXPECT_EQ(*log.entries()[0].value.GetDict().FindString("delta"),
+            "Apples grow");
+  const base::DictValue& end = log.entries()[1].value.GetDict();
+  EXPECT_EQ(*end.FindString("error"), "Stopped because the tab moved.");
+  EXPECT_TRUE(end.FindBool("stopped").value());
+  EXPECT_TRUE(end.FindBool("done").value());
+  EXPECT_TRUE(log.closed());
+}
+
+// A reply with no text yet still says it stopped.
+TEST(RacAiReplyLogTest, AStoppedReplyWithNoTextStillSaysWhy) {
+  ReplyLog log;
+  log.StartStopped(1, "", "Stopped because the tab moved.");
+  ASSERT_EQ(log.entries().size(), 1u);
+  EXPECT_EQ(*log.entries()[0].value.GetDict().FindString("error"),
+            "Stopped because the tab moved.");
+}
+
+TEST(RacAiReplyLogTest, ManySmallEventsHitTheCapToo) {
+  ReplyLog log;
+  log.Start(3);
+  base::DictValue event;
+  event.Set("type", "step_finished");
+  event.Set("result", std::string(1000, 'r'));
+  size_t appended = 0;
+  while (log.Append("racAiAgentEvent", base::Value(event.Clone()))) {
+    ++appended;
+    ASSERT_LT(appended, 10000u);
+  }
+  EXPECT_GT(appended, 100u);
+  EXPECT_LE(log.bytes(), ReplyLog::kMaxBytes);
+}

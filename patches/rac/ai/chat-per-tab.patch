+  // Another window shows the tab next, so this happens now.
+  if (reason == AssistantTabLeave::kMoved) {
+    CarryAssistantConversation(tab, CarrySnapshot(*chat));
+  }
+  // The tab may be closing: end the conversation after, if no tab of this
+  // window shows it any more.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<PageHandler> self, std::string key) {
+                       BrowserWindowInterface* browser =
+                           self ? self->GetBrowser() : nullptr;
+                       if (!self || (browser && CountAssistantConversationTabs(
+                                                    browser, key) > 0)) {
+                         return;
+                       }
+                       self->EndChat(key);
+                     },
+                     weak_factory_.GetWeakPtr(), key));
+}

+void PageHandler::StopForCap(Chat& chat) {
+  const int send_id = chat.log.send_id();
+  VLOG(1) << "rac assistant: a reply filled its " << ReplyLog::kMaxBytes
+          << "-byte log, so it stops";
+  base::DictValue update;
+  update.Set("id", send_id);
+  update.Set("error", kTooLongError);
+  update.Set("stopped", true);
+  update.Set("done", true);
+  chat.log.AppendFinal(kUpdateEvent, base::Value(update.Clone()));
+  chat.finished_send_id = send_id;
+  const bool open = std::exchange(chat.reply_open, false);
+  cards_.Revoke(chat.key);
+  if (IsJavascriptAllowed() && chat.key == shown_key_) {
+    update.Set("conversation", chat.key);
+    FireWebUIListener(kUpdateEvent, update);
+  } else if (open) {
+    SaveInBackground(chat, /*failed=*/true);
+  }
+  // The reply's own callback may be what is running: stop it after.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](PageHandler* self, base::WeakPtr<Chat> chat, int send_id) {
+            if (chat && chat->active_send_id == send_id) {
+              self->StopChat(*chat);
+            }
+          },
+          base::Unretained(this), chat.weak_factory.GetWeakPtr(), send_id));
+}

+
+base::FilePath AbsoluteOverride(const PrefService* prefs,
+                                std::string_view agent_id) {
+  const std::string* value = prefs->GetDict(kAgentPaths).FindString(agent_id);
+  if (!value || value->empty() || (*value)[0] != '/') {
+    return base::FilePath();
+  }
+  return base::FilePath(*value);
+}
+
+std::vector<std::string> CustomArgv(const PrefService* prefs) {
+  std::vector<std::string> argv;
+  for (std::string_view part : base::SplitStringPiece(
+           prefs->GetString(kAgentCustomCommand), " ", base::TRIM_WHITESPACE,
+           base::SPLIT_WANT_NONEMPTY)) {
+    argv.emplace_back(part);
+  }
+  return argv;
+}
+
+}  // namespace
+
+AcpService::AcpService(PrefService* prefs, base::FilePath profile_path)
+    : prefs_(prefs), profile_path_(std::move(profile_path)) {
+  VLOG(1) << "rac ACP service created";
+}
+
+AcpService::~AcpService() {
+  Shutdown();
+}
+
+void AcpService::Shutdown() {
+  shutting_down_ = true;
+  Stop();
+  path_cache_.Invalidate();
+  if (io_thread_) {
+    io_thread_->Stop();
+    io_thread_.reset();
+  }
+}
+
+void AcpService::EnsureIoThread() {
+  if (io_thread_) {
+    return;
+  }
+  io_thread_ = std::make_unique<base::Thread>("RacAcpIo");
+  base::Thread::Options options;
+  options.message_pump_type = base::MessagePumpType::IO;
+  CHECK(io_thread_->StartWithOptions(std::move(options)));
+}
+
+base::FilePath AcpService::CacheRoot() const {
+  return profile_path_.AppendASCII("Cache").AppendASCII("rac-agent");
+}
+
+base::FilePath AcpService::ScratchDirFor(std::string_view agent_id) const {
+  return CacheRoot().AppendASCII("scratch").AppendASCII(agent_id);
+}
+
+void AcpService::ListAgents(AgentListCallback done) {
+  if (shutting_down_ || !IsAiEnabled(prefs_)) {
+    std::move(done).Run(base::ListValue());
+    return;
+  }
+  path_cache_.Ensure(base::BindOnce(
+      &AcpService::OnPathReady, weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void AcpService::OnPathReady(AgentListCallback done,
+                             std::string search_path,
+                             std::string error) {
+  base::ListValue agents;
+  const std::string selected = prefs_->GetString(kAgentId);
+  for (const AgentRecipe& recipe : GetAgentRecipes()) {
+    base::DictValue row;
+    row.Set("id", recipe.id);
+    row.Set("name", recipe.name);
+    row.Set("kind", "agent");
+    row.Set("authHelp", recipe.auth_help);
+    row.Set("selected", selected == recipe.id);
+    bool installed = false;
+    if (std::string_view(recipe.id) == "custom") {
+      const auto argv = CustomArgv(prefs_);
+      installed = !argv.empty() && argv[0][0] == '/' &&
+                  access(argv[0].c_str(), X_OK) == 0;
+      if (!argv.empty()) {
+        row.Set("path", argv[0]);
+      }
+    } else {
+      base::FilePath resolved = AbsoluteOverride(prefs_, recipe.id);
+      if (resolved.empty() && !search_path.empty()) {
+        for (const char* name : recipe.executables) {
+          resolved = FindExecutableOnPath(name, search_path);
+          if (!resolved.empty()) {
+            break;
+          }
+        }
+      }
+      if (!resolved.empty()) {
+        installed = access(resolved.value().c_str(), X_OK) == 0;
+        row.Set("path", resolved.value());
+      }
+      if (recipe.uses_npx && !search_path.empty()) {
+        const char* companion =
+            std::string_view(recipe.id) == "codex" ? "codex" : "claude";
+        base::FilePath companion_path = AbsoluteOverride(prefs_, companion);
+        if (companion_path.empty()) {
+          companion_path = FindExecutableOnPath(companion, search_path);
+        }
+        installed = installed && !companion_path.empty();
+        if (!companion_path.empty()) {
+          row.Set("companionPath", companion_path.value());
+        }
+      }
+    }
+    row.Set("installed", installed);
+    if (!error.empty()) {
+      row.Set("probeError", error);
+    }
+    agents.Append(std::move(row));
+  }
+  std::move(done).Run(std::move(agents));
+}
+
+void AcpService::Prompt(std::string agent_id,
+                        std::string text,
+                        UpdateCallback on_update,
+                        AgentEventCallback on_agent_event,
+                        DoneCallback done) {
+  finishing_ = false;
+  on_update_ = std::move(on_update);
+  on_agent_event_ = std::move(on_agent_event);
+  prompt_done_ = std::move(done);
+  if (shutting_down_ || !IsAiEnabled(prefs_)) {
+    FinishPrompt("The assistant is turned off.");
+    return;
+  }
+
+  if (session_ && session_->agent_id == agent_id && session_->ready &&
+      session_->client &&
+      session_->client->state() == AcpClient::State::kReady) {
+    OnSessionReady(std::move(text), "");
+    return;
+  }
+
+  path_cache_.Ensure(base::BindOnce(
+      [](base::WeakPtr<AcpService> self, std::string agent_id, std::string text,
+         std::string search_path, std::string error) {
+        if (!self) {
+          return;
+        }
+        if (search_path.empty() && std::string_view(agent_id) != "custom") {
+          self->FinishPrompt(error.empty() ? "Could not discover agent PATH."
+                                           : error);
+          return;
+        }
+        self->BeginLaunch(
+            std::move(agent_id), std::move(search_path),
+            base::BindOnce(&AcpService::OnSessionReady, self, std::move(text)));
+      },
+      weak_factory_.GetWeakPtr(), std::move(agent_id), std::move(text)));
+}
+
+void AcpService::TeardownSession() {
+  if (session_ && session_->client) {
+    session_->client->Stop();
+  }
+  if (session_) {
+    session_->transport.AsyncCall(&AcpTransport::Kill);
+    session_->transport.Reset();
+  }
+  session_.reset();
+}
+
+void AcpService::BeginLaunch(std::string agent_id,
+                             std::string search_path,
+                             DoneCallback ready) {
+  TeardownSession();
+  if (!IsAiEnabled(prefs_)) {
+    std::move(ready).Run("The assistant is turned off.");
+    return;
+  }
+  const AgentRecipe* recipe = FindAgentRecipe(agent_id);
+  if (!recipe) {
+    std::move(ready).Run("Unknown agent.");
+    return;
+  }
+
+  PreparedLaunch seed;
+  seed.agent_id = agent_id;
+  seed.scratch = ScratchDirFor(agent_id);
+  seed.recipe = recipe;
+  AgentLaunchPaths paths;
+  paths.search_path = search_path;
+  std::vector<std::string> custom_argv;
+  if (std::string_view(agent_id) == "custom") {
+    custom_argv = CustomArgv(prefs_);
+  } else {
+    paths.executable = AbsoluteOverride(prefs_, agent_id);
+    if (paths.executable.empty()) {
+      for (const char* name : recipe->executables) {
+        paths.executable = FindExecutableOnPath(name, search_path);
+        if (!paths.executable.empty()) {
+          break;
+        }
+      }
+    }
+    if (recipe->uses_npx) {
+      const char* companion =
+          std::string_view(agent_id) == "codex" ? "codex" : "claude";
+      paths.companion = AbsoluteOverride(prefs_, companion);
+      if (paths.companion.empty()) {
+        paths.companion = FindExecutableOnPath(companion, search_path);
+      }
+    }
+  }
+  const base::FilePath cache_root = CacheRoot();
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](PreparedLaunch seed, AgentLaunchPaths paths,
+             std::vector<std::string> custom_argv, base::FilePath cache_root) {
+            if (std::string_view(seed.agent_id) == "custom") {
+              seed.ok = PrepareCustomAgentLaunch(
+                  custom_argv, seed.scratch, paths.search_path, seed.launch);
+            } else if (seed.recipe) {
+              seed.ok = PrepareAgentLaunch(*seed.recipe, paths, seed.scratch,
+                                           cache_root, seed.launch,
+                                           seed.session_extra);
+            }
+            return seed;
+          },
+          std::move(seed), std::move(paths), std::move(custom_argv),
+          cache_root),
+      base::BindOnce(&AcpService::ContinueLaunch, weak_factory_.GetWeakPtr(),
+                     std::move(ready)));
+}
+
+void AcpService::ContinueLaunch(DoneCallback ready, PreparedLaunch prepared) {
+  if (shutting_down_ || !IsAiEnabled(prefs_)) {
+    std::move(ready).Run("The assistant is turned off.");
+    return;
+  }
+  if (!prepared.ok || prepared.launch.argv.empty()) {
+    std::move(ready).Run("That agent is not installed.");
+    return;
+  }
+
+  EnsureIoThread();
+  auto session = std::make_unique<Session>();
+  session->agent_id = prepared.agent_id;
+  session->scratch = prepared.scratch;
+  session->transport =
+      base::SequenceBound<AcpTransport>(io_thread_->task_runner());
+
+  base::WeakPtr<AcpService> self = weak_factory_.GetWeakPtr();
+  session->client = std::make_unique<AcpClient>(
+      base::BindRepeating(
+          [](base::WeakPtr<AcpService> self, base::DictValue message) {
+            if (self && self->session_) {
+              self->session_->transport.AsyncCall(&AcpTransport::Write)
+                  .WithArgs(std::move(message));
+            }
+          },
+          self),
+      base::BindRepeating(
+          [](base::WeakPtr<AcpService> self) {
+            if (self && self->session_) {
+              self->session_->transport.AsyncCall(&AcpTransport::Stop);
+            }
+          },
+          self),
+      base::BindRepeating(&AcpService::OnClientUpdate, self));
+  session->client->SetPermissionPolicy(
+      base::BindRepeating(&AcpService::OnPermission, self));
+
+  prepared.session_extra.Set("cwd", prepared.scratch.value());
+  if (!prepared.session_extra.contains("mcpServers")) {
+    prepared.session_extra.Set("mcpServers", base::ListValue());
+  }
+
+  VLOG(1) << "rac ACP initialize fs.readTextFile=false "
+          << "fs.writeTextFile=false terminal=false cwd="
+          << prepared.scratch.value();
+
+  const AgentRecipe* recipe = prepared.recipe;
+  // Publish before any IO so early agent replies are not dropped when
+  // OnTransportMessage runs on the UI thread.
+  session_ = std::move(session);
+
+  auto ui = base::SequencedTaskRunner::GetCurrentDefault();
+  session_->transport.AsyncCall(&AcpTransport::Start)
+      .WithArgs(
+          std::move(prepared.launch),
+          base::BindRepeating(
+              [](scoped_refptr<base::SequencedTaskRunner> ui,
+                 base::WeakPtr<AcpService> self, base::DictValue message) {
+                ui->PostTask(FROM_HERE,
+                             base::BindOnce(&AcpService::OnTransportMessage,
+                                            self, std::move(message)));
+              },
+              ui, self),
+          base::BindOnce(
+              [](scoped_refptr<base::SequencedTaskRunner> ui,
+                 base::WeakPtr<AcpService> self, std::string error) {
+                ui->PostTask(FROM_HERE,
+                             base::BindOnce(&AcpService::OnTransportClosed,
+                                            self, std::move(error)));
+              },
+              ui, self));
+
+  session_->client->Start(
+      std::move(prepared.session_extra),
+      base::BindOnce(
+          [](base::WeakPtr<AcpService> self, const AgentRecipe* recipe,
+             DoneCallback ready, std::string error) {
+            if (!self || !self->session_) {
+              std::move(ready).Run(error.empty() ? "Cancelled" : error);
+              return;
+            }
+            if (self->session_->client->state() ==
+                AcpClient::State::kNeedsAuth) {
+              std::string help = "Sign in required";
+              if (recipe && recipe->auth_help[0]) {
+                help = std::string("Sign in required: ") + recipe->auth_help;
+              }
+              std::move(ready).Run(std::move(help));
+              return;
+            }
+            self->session_->ready = error.empty();
+            std::move(ready).Run(std::move(error));
+          },
+          self, recipe, std::move(ready)));
+}
+
+void AcpService::OnSessionReady(std::string text, std::string error) {
+  if (!error.empty()) {
+    FinishPrompt(std::move(error));
+    return;
+  }
+  if (!session_ || !session_->client) {
+    FinishPrompt("The agent session failed.");
+    return;
+  }
+  session_->client->Prompt(
+      std::move(text),
+      base::BindOnce(&AcpService::FinishPrompt, weak_factory_.GetWeakPtr()));
+}
+
+void AcpService::OnTransportMessage(base::DictValue message) {
+  if (session_ && session_->client) {
+    session_->client->Receive(std::move(message));
+  }
+}
+
+void AcpService::OnTransportClosed(std::string error) {
+  if (shutting_down_) {
+    return;
+  }
+  if (session_ && session_->client) {
+    session_->client->Fail(error.empty() ? "The agent exited." : error);
+  }
+  FinishPrompt(error.empty() ? "The agent exited." : std::move(error));
+}
+
+void AcpService::OnClientUpdate(base::DictValue update) {
+  const std::string* kind = update.FindString("sessionUpdate");
+  if (!kind) {
+    return;
+  }
+  if (*kind == "agent_message_chunk") {
+    const base::DictValue* content = update.FindDict("content");
+    const std::string* text = content ? content->FindString("text") : nullptr;
+    if (text && on_update_) {
+      on_update_.Run(StreamUpdate{.text_delta = *text});
+    }
+    return;
+  }
+  if (on_agent_event_) {
+    on_agent_event_.Run(std::move(update));
+  }
+}
+
+void AcpService::OnPermission(const base::DictValue& tool,
+                              base::OnceCallback<void(bool)> decide) {
+  std::move(decide).Run(IsApprovedRacMcpTool(tool));
+}
+
+void AcpService::FinishPrompt(std::string error) {
+  if (finishing_) {
+    return;
+  }
+  finishing_ = true;
+  if (on_update_) {
+    StreamUpdate update;
+    update.done = true;
+    if (!error.empty()) {
+      update.error = error;
+    }
+    on_update_.Run(std::move(update));
+  }
+  on_update_.Reset();
+  on_agent_event_.Reset();
+  if (prompt_done_) {
+    std::move(prompt_done_).Run(std::move(error));
+  }
+}
+
+void AcpService::Cancel() {
+  if (session_ && session_->client) {
+    session_->client->Cancel();
+  }
+}
+
+void AcpService::Stop() {
+  TeardownSession();
+  FinishPrompt("Cancelled");
+}
+
+}  // namespace rac::ai

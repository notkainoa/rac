+
+bool WriteScratchFile(const base::FilePath& path, std::string_view contents) {
+  return base::CreateDirectory(path.DirName()) &&
+         base::WriteFile(path, contents);
+}
+
+void PutEnv(std::map<std::string, std::string>& env,
+            const char* key,
+            std::string value) {
+  env[key] = std::move(value);
+}
+
+void BaseEnv(std::map<std::string, std::string>& env,
+             const AgentLaunchPaths& paths,
+             const base::FilePath& scratch,
+             const base::FilePath& cache_root) {
+  // The agent starts from an empty environment (`clear_environment`), so a
+  // browser started from a terminal doesn't hand it that shell's API keys and
+  // tokens. Only the user's identity, locale, and network settings carry over.
+  static constexpr base::cstring_view kKept[] = {
+      "HOME",
+      "USER",
+      "LOGNAME",
+      "SHELL",
+      "LANG",
+      "LC_ALL",
+      "LC_CTYPE",
+      "__CF_USER_TEXT_ENCODING",
+      "HTTP_PROXY",
+      "HTTPS_PROXY",
+      "NO_PROXY",
+      "ALL_PROXY",
+      "http_proxy",
+      "https_proxy",
+      "no_proxy",
+      "all_proxy",
+      "NODE_EXTRA_CA_CERTS",
+      "SSL_CERT_FILE",
+      "SSL_CERT_DIR",
+      // Where the user keeps an agent's own config and login, and where
+      // their Node version manager lives. None of these are secrets; keys
+      // and tokens stay behind.
+      "CLAUDE_CONFIG_DIR",
+      "CODEX_HOME",
+      "GEMINI_CLI_HOME",
+      "GOOGLE_CLOUD_PROJECT",
+      "GOOGLE_CLOUD_LOCATION",
+      "COPILOT_HOME",
+      "GOOSE_CONFIG_DIR",
+      "XDG_CONFIG_HOME",
+      "XDG_DATA_HOME",
+      "XDG_CACHE_HOME",
+      "XDG_STATE_HOME",
+      "NPM_CONFIG_USERCONFIG",
+      "npm_config_userconfig",
+      "NPM_CONFIG_REGISTRY",
+      "npm_config_registry",
+      "NPM_CONFIG_PREFIX",
+      "npm_config_prefix",
+      "VOLTA_HOME",
+      "ASDF_DIR",
+      "ASDF_DATA_DIR",
+      "NVM_DIR",
+      "FNM_DIR",
+      "MISE_DATA_DIR",
+      "MISE_CONFIG_DIR",
+  };
+  auto process_env = base::Environment::Create();
+  for (base::cstring_view key : kKept) {
+    if (auto value = process_env->GetVar(key)) {
+      PutEnv(env, key.c_str(), *value);
+    }
+  }
+  if (auto tmp = process_env->GetVar("TMPDIR")) {
+    PutEnv(env, "TMPDIR", *tmp);
+  } else {
+    PutEnv(env, "TMPDIR", scratch.AppendASCII("tmp").value());
+  }
+  PutEnv(env, "PATH", paths.search_path);
+  PutEnv(env, "TERM", "dumb");
+  PutEnv(env, "NO_COLOR", "1");
+  PutEnv(env, "PYTHONUNBUFFERED", "1");
+  base::CreateDirectory(scratch.AppendASCII("tmp"));
+  base::CreateDirectory(cache_root.AppendASCII("npx"));
+  PutEnv(env, "npm_config_cache", cache_root.AppendASCII("npx").value());
+}
+
+bool PrepareOpenCode(const AgentLaunchPaths& paths,
+                     const base::FilePath& scratch,
+                     AcpLaunchSpec& launch) {
+  const std::string config = R"({
+  "$schema":"https://opencode.ai/config.json",
+  "share":"disabled",
+  "autoupdate":false,
+  "plugin":[],
+  "permission":{"*":"deny","rac_*":"allow"},
+  "tools":{"bash":false,"edit":false,"write":false,"patch":false,
+           "webfetch":false,"websearch":false,"task":false,"read":false,
+           "glob":false,"grep":false,"list":false}
+})";
+  if (!WriteScratchFile(scratch.AppendASCII("opencode.json"), config)) {
+    return false;
+  }
+  PutEnv(launch.environment, "OPENCODE_CONFIG_CONTENT", config);
+  PutEnv(launch.environment, "OPENCODE_DISABLE_PROJECT_CONFIG", "true");
+  PutEnv(launch.environment, "OPENCODE_DISABLE_AUTOUPDATE", "true");
+  PutEnv(launch.environment, "OPENCODE_DISABLE_DEFAULT_PLUGINS", "true");
+  PutEnv(launch.environment, "OPENCODE_PERMISSION",
+         R"({"*":"deny","rac_*":"allow"})");
+  for (const char* name : {"config", "data", "cache", "state"}) {
+    base::FilePath dir = scratch.AppendASCII(name);
+    base::CreateDirectory(dir);
+    std::string key = std::string("XDG_") + base::ToUpperASCII(name) + "_HOME";
+    PutEnv(launch.environment, key.c_str(), dir.value());
+  }
+  launch.argv = {paths.executable.value(), "acp"};
+  return true;
+}
+
+bool PrepareCursor(const AgentLaunchPaths& paths,
+                   const base::FilePath& scratch,
+                   AcpLaunchSpec& launch) {
+  const std::string config =
+      R"json({"permissions":{"allow":["Mcp(rac:*)"],"deny":["Shell(*)","Write(**)","WebFetch(*)","Read(**)"]}})json";
+  if (!WriteScratchFile(scratch.AppendASCII(".cursor").AppendASCII("cli.json"),
+                        config)) {
+    return false;
+  }
+  PutEnv(launch.environment, "CURSOR_CONFIG_DIR",
+         scratch.AppendASCII(".cursor-config").value());
+  PutEnv(launch.environment, "CURSOR_DATA_DIR",
+         scratch.AppendASCII(".cursor-data").value());
+  PutEnv(launch.environment, "CURSOR_AGENT_STORE_DIR",
+         scratch.AppendASCII(".cursor-store").value());
+  PutEnv(launch.environment, "CURSOR_PROJECT_DIR", scratch.value());
+  base::CreateDirectory(scratch.AppendASCII(".cursor-config"));
+  base::CreateDirectory(scratch.AppendASCII(".cursor-data"));
+  base::CreateDirectory(scratch.AppendASCII(".cursor-store"));
+  launch.argv = {paths.executable.value(), "acp"};
+  return true;
+}
+
+bool PrepareGemini(const AgentLaunchPaths& paths,
+                   const base::FilePath& scratch,
+                   AcpLaunchSpec& launch) {
+  const std::string config = R"({
+  "tools":{"exclude":["run_shell_command","write_file","replace","web_fetch",
+                      "google_web_search"]},
+  "privacy":{"usageStatisticsEnabled":false},
+  "telemetry":{"enabled":false},
+  "general":{"enableAutoUpdate":false}
+})";
+  if (!WriteScratchFile(
+          scratch.AppendASCII(".gemini").AppendASCII("settings.json"),
+          config)) {
+    return false;
+  }
+  PutEnv(launch.environment, "GEMINI_TELEMETRY_ENABLED", "false");
+  launch.argv = {paths.executable.value(), "--acp"};
+  return true;
+}
+
+bool PrepareCopilot(const AgentLaunchPaths& paths, AcpLaunchSpec& launch) {
+  launch.argv = {paths.executable.value()};
+  for (const char* arg : kCopilotArgs) {
+    launch.argv.push_back(arg);
+  }
+  return true;
+}
+
+bool PrepareCodex(const AgentLaunchPaths& paths,
+                  const base::FilePath& scratch,
+                  const base::FilePath& cache_root,
+                  AcpLaunchSpec& launch) {
+  if (paths.companion.empty()) {
+    return false;
+  }
+  base::DictValue features;
+  features.Set("shell_tool", false);
+  features.Set("unified_exec", false);
+  features.Set("apply_patch_freeform", false);
+  features.Set("multi_agent", false);
+  features.Set("hooks", false);
+  features.Set("memory_tool", false);
+  base::DictValue analytics;
+  analytics.Set("enabled", false);
+  base::DictValue otel;
+  otel.Set("exporter", "none");
+  otel.Set("trace_exporter", "none");
+  otel.Set("metrics_exporter", "none");
+  base::DictValue history;
+  history.Set("persistence", "none");
+  base::DictValue config;
+  config.Set("sandbox_mode", "read-only");
+  config.Set("approval_policy", "on-request");
+  config.Set("web_search", "disabled");
+  config.Set("features", std::move(features));
+  config.Set("analytics", std::move(analytics));
+  config.Set("otel", std::move(otel));
+  config.Set("history", std::move(history));
+  config.Set("log_dir", scratch.AppendASCII("codex-logs").value());
+  std::optional<std::string> json = base::WriteJson(config);
+  if (!json) {
+    return false;
+  }
+  PutEnv(launch.environment, "CODEX_PATH", paths.companion.value());
+  PutEnv(launch.environment, "CODEX_CONFIG", std::move(*json));
+  PutEnv(launch.environment, "INITIAL_AGENT_MODE", "read-only");
+  PutEnv(launch.environment, "APP_SERVER_LOGS",
+         scratch.AppendASCII("codex-logs").value());
+  base::CreateDirectory(scratch.AppendASCII("codex-logs"));
+  launch.argv = {paths.executable.value(), "-y",
+                 "@agentclientprotocol/codex-acp@2.2.2"};
+  return true;
+}
+
+bool PrepareClaude(const AgentLaunchPaths& paths,
+                   const base::FilePath& scratch,
+                   base::DictValue& session_extra,
+                   AcpLaunchSpec& launch) {
+  if (paths.companion.empty()) {
+    return false;
+  }
+  PutEnv(launch.environment, "CLAUDE_CODE_EXECUTABLE", paths.companion.value());
+  PutEnv(launch.environment, "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "1");
+  PutEnv(launch.environment, "DISABLE_TELEMETRY", "1");
+  PutEnv(launch.environment, "DISABLE_ERROR_REPORTING", "1");
+  PutEnv(launch.environment, "DISABLE_AUTOUPDATER", "1");
+  PutEnv(launch.environment, "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION", "false");
+  base::DictValue extra_args;
+  extra_args.Set("strict-mcp-config", "");
+  extra_args.Set("no-session-persistence", "");
+  extra_args.Set("disable-slash-commands", "");
+  base::DictValue settings;
+  settings.Set("disableAllHooks", true);
+  base::ListValue setting_sources;
+  setting_sources.Append("user");
+  base::DictValue options;
+  options.Set("tools", base::ListValue());
+  options.Set("settingSources", std::move(setting_sources));
+  options.Set("settings", std::move(settings));
+  options.Set("allowDangerouslySkipPermissions", false);
+  options.Set("persistSession", false);
+  options.Set("promptSuggestions", false);
+  options.Set("extraArgs", std::move(extra_args));
+  base::DictValue claude_code;
+  claude_code.Set("options", std::move(options));
+  base::DictValue meta;
+  meta.Set("claudeCode", std::move(claude_code));
+  session_extra.Set("_meta", std::move(meta));
+  launch.argv = {paths.executable.value(), "-y",
+                 "@agentclientprotocol/claude-agent-acp@0.93.0"};
+  return true;
+}
+
+bool PrepareGoose(const AgentLaunchPaths& paths,
+                  const base::FilePath& scratch,
+                  AcpLaunchSpec& launch) {
+  PutEnv(launch.environment, "GOOSE_MODE", "approve");
+  PutEnv(launch.environment, "GOOSE_TELEMETRY_ENABLED", "false");
+  PutEnv(launch.environment, "OTEL_SDK_DISABLED", "true");
+  PutEnv(launch.environment, "GOOSE_DISABLE_SESSION_NAMING", "true");
+  launch.argv = {paths.executable.value(), "acp"};
+  return true;
+}
+
+}  // namespace
+
+base::span<const AgentRecipe> GetAgentRecipes() {
+  return kRecipes;
+}
+
+const AgentRecipe* FindAgentRecipe(std::string_view id) {
+  for (const AgentRecipe& recipe : kRecipes) {
+    if (recipe.id == id) {
+      return &recipe;
+    }
+  }
+  return nullptr;
+}
+
+bool PrepareAgentLaunch(const AgentRecipe& recipe,
+                        const AgentLaunchPaths& paths,
+                        const base::FilePath& scratch,
+                        const base::FilePath& cache_root,
+                        AcpLaunchSpec& launch,
+                        base::DictValue& session_extra) {
+  if (paths.executable.empty() || scratch.empty()) {
+    return false;
+  }
+  if (!base::CreateDirectory(scratch)) {
+    return false;
+  }
+  launch = AcpLaunchSpec();
+  launch.cwd = scratch;
+  launch.clear_environment = true;
+  BaseEnv(launch.environment, paths, scratch, cache_root);
+  if (std::string_view(recipe.id) == "opencode") {
+    return PrepareOpenCode(paths, scratch, launch);
+  }
+  if (std::string_view(recipe.id) == "cursor") {
+    return PrepareCursor(paths, scratch, launch);
+  }
+  if (std::string_view(recipe.id) == "gemini") {
+    return PrepareGemini(paths, scratch, launch);
+  }
+  if (std::string_view(recipe.id) == "copilot") {
+    return PrepareCopilot(paths, launch);
+  }
+  if (std::string_view(recipe.id) == "codex") {
+    return PrepareCodex(paths, scratch, cache_root, launch);
+  }
+  if (std::string_view(recipe.id) == "claude") {
+    return PrepareClaude(paths, scratch, session_extra, launch);
+  }
+  if (std::string_view(recipe.id) == "goose") {
+    return PrepareGoose(paths, scratch, launch);
+  }
+  return false;
+}
+
+bool PrepareCustomAgentLaunch(const std::vector<std::string>& argv,
+                              const base::FilePath& scratch,
+                              const std::string& search_path,
+                              AcpLaunchSpec& launch) {
+  if (argv.empty() || argv[0].empty() || argv[0][0] != '/' || scratch.empty()) {
+    return false;
+  }
+  if (!base::CreateDirectory(scratch)) {
+    return false;
+  }
+  launch = AcpLaunchSpec();
+  launch.cwd = scratch;
+  launch.argv = argv;
+  AgentLaunchPaths paths;
+  paths.search_path = search_path;
+  launch.clear_environment = true;
+  BaseEnv(launch.environment, paths, scratch, scratch);
+  return true;
+}
+
+bool IsApprovedRacMcpTool(const base::DictValue& tool) {
+  // WP6 owns real approval. Until then, reject every permission request.
+  // Correlate only structured names so titles alone cannot authorize.
+  const std::string* name = tool.FindString("name");
+  if (name && base::StartsWith(*name, "mcp__rac__")) {
+    return false;
+  }
+  const std::string* title = tool.FindString("title");
+  if (title && base::StartsWith(*title, "rac:")) {
+    return false;
+  }
+  const base::DictValue* raw = tool.FindDict("rawInput");
+  if (raw) {
+    const std::string* server = raw->FindString("server");
+    const std::string* provider = raw->FindString("providerIdentifier");
+    if ((server && *server == "rac") || (provider && *provider == "rac")) {
+      return false;
+    }
+  }
+  return false;
+}
+
+}  // namespace rac::ai

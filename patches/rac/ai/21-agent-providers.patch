+#ifndef CHROME_BROWSER_RAC_AI_ACP_ACP_SERVICE_H_
+#define CHROME_BROWSER_RAC_AI_ACP_ACP_SERVICE_H_
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+#include "base/threading/thread.h"
+#include "base/values.h"
+#include "chrome/browser/rac/ai/acp/acp_client.h"
+#include "chrome/browser/rac/ai/acp/acp_transport.h"
+#include "chrome/browser/rac/ai/acp/agent_path.h"
+#include "chrome/browser/rac/ai/acp/agent_recipes.h"
+#include "chrome/browser/rac/ai/chat_protocol.h"
+
+class PrefService;
+
+namespace rac::ai {
+
+// Per-profile ACP owner. Created lazily by AiService only while AI is on.
+// Shutdown tears down child processes immediately.
+class AcpService {
+ public:
+  using AgentListCallback = base::OnceCallback<void(base::ListValue agents)>;
+  using UpdateCallback = base::RepeatingCallback<void(StreamUpdate)>;
+  using AgentEventCallback = base::RepeatingCallback<void(base::DictValue)>;
+  using DoneCallback = base::OnceCallback<void(std::string error)>;
+
+  AcpService(PrefService* prefs, base::FilePath profile_path);
+  AcpService(const AcpService&) = delete;
+  AcpService& operator=(const AcpService&) = delete;
+  ~AcpService();
+
+  void Shutdown();
+
+  void ListAgents(AgentListCallback done);
+
+  // `text` should already include any wrapped page context.
+  void Prompt(std::string agent_id,
+              std::string text,
+              UpdateCallback on_update,
+              AgentEventCallback on_agent_event,
+              DoneCallback done);
+
+  void Cancel();
+  void Stop();
+
+ private:
+  struct Session {
+    std::string agent_id;
+    base::FilePath scratch;
+    std::unique_ptr<AcpClient> client;
+    base::SequenceBound<AcpTransport> transport;
+    bool ready = false;
+  };
+
+  void OnPathReady(AgentListCallback done,
+                   std::string search_path,
+                   std::string error);
+  struct PreparedLaunch {
+    bool ok = false;
+    std::string agent_id;
+    base::FilePath scratch;
+    AcpLaunchSpec launch;
+    base::DictValue session_extra;
+    // Non-owning; recipes are static.
+    raw_ptr<const AgentRecipe> recipe = nullptr;
+  };
+
+  void BeginLaunch(std::string agent_id,
+                   std::string search_path,
+                   DoneCallback ready);
+  void ContinueLaunch(DoneCallback ready, PreparedLaunch prepared);
+  void OnSessionReady(std::string text, std::string error);
+  void OnTransportMessage(base::DictValue message);
+  void OnTransportClosed(std::string error);
+  void OnClientUpdate(base::DictValue update);
+  void OnPermission(const base::DictValue& tool,
+                    base::OnceCallback<void(bool)> decide);
+  void FinishPrompt(std::string error);
+  void TeardownSession();
+  base::FilePath ScratchDirFor(std::string_view agent_id) const;
+  base::FilePath CacheRoot() const;
+
+  // FileDescriptorWatcher needs an IO pump; ThreadPool cannot host the pipes.
+  void EnsureIoThread();
+
+  raw_ptr<PrefService> prefs_;
+  base::FilePath profile_path_;
+  AgentPathCache path_cache_;
+  std::unique_ptr<base::Thread> io_thread_;
+  std::unique_ptr<Session> session_;
+  UpdateCallback on_update_;
+  AgentEventCallback on_agent_event_;
+  DoneCallback prompt_done_;
+  bool finishing_ = false;
+  bool shutting_down_ = false;
+  base::WeakPtrFactory<AcpService> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_ACP_ACP_SERVICE_H_

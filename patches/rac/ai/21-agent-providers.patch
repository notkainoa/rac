+
+#include "chrome/browser/rac/ai/acp/agent_recipes.h"
+
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+
+TEST(AgentRecipesTest, ListsExpectedAgents) {
+  auto recipes = GetAgentRecipes();
+  ASSERT_GE(recipes.size(), 8u);
+  EXPECT_TRUE(FindAgentRecipe("opencode"));
+  EXPECT_TRUE(FindAgentRecipe("cursor"));
+  EXPECT_TRUE(FindAgentRecipe("claude"));
+  EXPECT_TRUE(FindAgentRecipe("codex"));
+  EXPECT_TRUE(FindAgentRecipe("custom"));
+  EXPECT_EQ(FindAgentRecipe("claude")->name,
+            std::string("Claude (your Claude Code login)"));
+}
+
+TEST(AgentRecipesTest, PermissionHookRejectsByDefault) {
+  base::DictValue rac_tool;
+  rac_tool.Set("name", "mcp__rac__rac_echo");
+  rac_tool.Set("title", "rac: rac_echo");
+  EXPECT_FALSE(IsApprovedRacMcpTool(rac_tool));
+  base::DictValue shell;
+  shell.Set("name", "Shell");
+  shell.Set("kind", "execute");
+  EXPECT_FALSE(IsApprovedRacMcpTool(shell));
+}
+
+TEST(AgentRecipesTest, CustomLaunchRequiresAbsoluteExecutable) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  AcpLaunchSpec launch;
+  EXPECT_FALSE(PrepareCustomAgentLaunch({"python3", "x"}, temp.GetPath(),
+                                        "/usr/bin", launch));
+  EXPECT_TRUE(PrepareCustomAgentLaunch(
+      {"/usr/bin/env", "python3", "/tmp/rac-ai/fake_acp_agent.py"},
+      temp.GetPath(), "/usr/bin:/bin", launch));
+  ASSERT_FALSE(launch.argv.empty());
+  EXPECT_EQ(launch.argv[0], "/usr/bin/env");
+  EXPECT_EQ(launch.cwd, temp.GetPath());
+}
+
+}  // namespace rac::ai

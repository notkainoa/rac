+void PageHandler::StartAgentSession(std::unique_ptr<PendingSend> send,
+                                    const std::string& agent_id) {
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  if (!service || profile_->IsOffTheRecord()) {
+    OnUpdate(send->send_id,
+             {.error = profile_->IsOffTheRecord()
+                           ? "Agents are not available in Incognito."
+                           : "The assistant is turned off."});
+    return;
+  }
+  if (!FindAgentRecipe(agent_id)) {
+    OnUpdate(send->send_id, {.error = "Unknown agent."});
+    return;
+  }
+  page_context_.Apply(send->request);
+  std::string prompt =
+      BuildSystemPrompt(send->request.system_prompt, send->request.pages);
+  for (const ChatMessage& message : send->request.messages) {
+    prompt.append("\n\n");
+    prompt.append(message.role == ChatMessage::Role::kUser ? "User: "
+                                                           : "Assistant: ");
+    prompt.append(message.text);
+  }
+  const int send_id = send->send_id;
+  service->acp_service()->Prompt(
+      agent_id, std::move(prompt),
+      base::BindRepeating(&PageHandler::OnUpdate, weak_factory_.GetWeakPtr(),
+                          send_id),
+      base::BindRepeating(&PageHandler::OnAgentEvent,
+                          weak_factory_.GetWeakPtr(), send_id),
+      base::DoNothing());
+}

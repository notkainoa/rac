+  const std::string id = args[0].GetString();
+  const std::string path = args[1].GetString();
+  if (!FindAgentRecipe(id)) {
+    return;
+  }
+  if (!path.empty() && path[0] != '/') {
+    return;
+  }
+  ScopedDictPrefUpdate update(profile_->GetPrefs(), kAgentPaths);
+  if (path.empty()) {
+    update->Remove(id);
+  } else {
+    update->Set(id, path);
+  }

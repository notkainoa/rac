+// Reap without Process::WaitForExit (friend-gated on ThreadPool).
+void ReapPid(base::ProcessId pid, base::TimeDelta timeout) {
+  if (pid <= 1) {
+    return;
+  }
+  const base::TimeTicks deadline = base::TimeTicks::Now() + timeout;
+  int status = 0;
+  for (;;) {
+    const pid_t got = HANDLE_EINTR(waitpid(pid, &status, WNOHANG));
+    if (got == pid || (got < 0 && errno == ECHILD)) {
+      return;
+    }
+    if (base::TimeTicks::Now() >= deadline) {
+      kill(pid, SIGKILL);
+      HANDLE_EINTR(waitpid(pid, &status, 0));
+      return;
+    }
+    usleep(20 * 1000);
+  }
+}
+
+std::optional<std::string> RunAndCapture(const std::vector<std::string>& argv,
+                                         base::TimeDelta timeout) {
+  if (argv.empty()) {
+    return std::nullopt;
+  }
+  base::ScopedFD read_fd;
+  base::ScopedFD write_fd;
+  if (!base::CreatePipe(&read_fd, &write_fd, false)) {
+    return std::nullopt;
+  }
+  base::LaunchOptions options;
+  options.fds_to_remap.emplace_back(write_fd.get(), STDOUT_FILENO);
+  options.fds_to_remap.emplace_back(write_fd.get(), STDERR_FILENO);
+  base::Process process = base::LaunchProcess(argv, options);
+  write_fd.reset();
+  if (!process.IsValid()) {
+    return std::nullopt;
+  }
+  std::string out;
+  char buffer[4096];
+  const base::TimeTicks deadline = base::TimeTicks::Now() + timeout;
+  while (read_fd.is_valid()) {
+    const ssize_t got =
+        HANDLE_EINTR(read(read_fd.get(), buffer, sizeof(buffer)));
+    if (got > 0) {
+      if (out.size() < 64 * 1024) {
+        out.append(buffer, static_cast<size_t>(got));
+      }
+    } else {
+      read_fd.reset();
+    }
+    if (base::TimeTicks::Now() >= deadline) {
+      break;
+    }
+  }
+  ReapPid(process.Pid(), base::Seconds(1));
+  process.Close();
+  base::TrimString(out, "\r\n", &out);
+  if (out.empty() || out.find('\0') != std::string::npos) {
+    return std::nullopt;
+  }
+  return out;
+}

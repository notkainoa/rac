+
+struct AgentRecipe {
+  const char* id;
+  const char* name;
+  // Primary executable names probed on PATH, in order.
+  base::span<const char* const> executables;
+  // True when the recipe runs through npx and needs a companion CLI path env.
+  bool uses_npx = false;
+  const char* npx_package = nullptr;  // pinned package@version when uses_npx
+  // Extra fixed argv after the resolved executable (e.g. "acp", "--acp").
+  base::span<const char* const> fixed_args;
+  // Human sign-in guidance shown when auth is required.
+  const char* auth_help = "";
+};
+
+base::span<const AgentRecipe> GetAgentRecipes();
+const AgentRecipe* FindAgentRecipe(std::string_view id);
+
+// Absolute path overrides and resolved PATH feed BuildAgentLaunch.
+struct AgentLaunchPaths {
+  base::FilePath executable;  // primary binary or npx
+  base::FilePath companion;   // e.g. codex / claude / cursor-agent
+  std::string search_path;    // PATH for the child
+};
+
+// Writes per-agent restriction files under `scratch` and returns launch argv,
+// environment, and optional session/new `_meta`. Never reads credential files.
+bool PrepareAgentLaunch(const AgentRecipe& recipe,
+                        const AgentLaunchPaths& paths,
+                        const base::FilePath& scratch,
+                        const base::FilePath& cache_root,
+                        AcpLaunchSpec& launch,
+                        base::DictValue& session_extra);
+
+// Custom ACP command: absolute executable + argv from prefs.
+bool PrepareCustomAgentLaunch(const std::vector<std::string>& argv,
+                              const base::FilePath& scratch,
+                              const std::string& search_path,
+                              AcpLaunchSpec& launch);
+
+// Default-deny permission helper used until WP6 registers rac MCP tools.
+bool IsApprovedRacMcpTool(const base::DictValue& tool);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_ACP_AGENT_RECIPES_H_

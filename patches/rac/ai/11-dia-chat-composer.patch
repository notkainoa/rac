+std::vector<std::string> ParseModelList(std::string_view json) {
+  std::vector<std::string> ids;
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  const base::ListValue* data = dict ? dict->FindList("data") : nullptr;
+  if (!data) {
+    return ids;
+  }
+  for (const base::Value& entry : *data) {
+    const base::DictValue* model = entry.GetIfDict();
+    const std::string* id = model ? model->FindString("id") : nullptr;
+    if (!id || id->empty() || id->size() > kMaxModelIdChars ||
+        !base::IsStringUTF8(*id) ||
+        std::ranges::find(ids, *id) != ids.end()) {
+      continue;
+    }
+    ids.push_back(*id);
+    if (ids.size() >= kMaxListedModels) {
+      break;
+    }
+  }
+  return ids;
+}
+
 }  // namespace rac::ai

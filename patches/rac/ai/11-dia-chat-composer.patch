+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/model_list.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "chrome/browser/rac/ai/chat_protocol.h"
+#include "chrome/browser/rac/ai/providers.h"
+#include "net/base/load_flags.h"
+#include "net/base/url_util.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr size_t kMaxBodyBytes = 256 * 1024;
+// Servers on this computer answer at once, or not at all.
+constexpr base::TimeDelta kTimeout = base::Seconds(3);
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("rac_ai_models", R"(
+      semantics {
+        sender: "rac assistant"
+        description:
+          "Asks an AI server running on this computer, such as Ollama, "
+          "which models it has, so the user can pick one."
+        trigger: "The user opens the model menu in the assistant."
+        data: "None."
+        destination: LOCAL
+        internal { contacts { email: "noreply@example.com" } }
+        user_data { type: NONE }
+        last_reviewed: "2026-10-13"
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "Off by default. Turn the assistant on or off in Settings > Privacy "
+          "and security > Assistant."
+        policy_exception_justification: "Not implemented."
+      })");
+
+void OnBody(std::unique_ptr<network::SimpleURLLoader> loader,
+            base::OnceCallback<void(std::vector<std::string>)> callback,
+            std::optional<std::string> body) {
+  std::move(callback).Run(body ? ParseModelList(*body)
+                               : std::vector<std::string>());
+}
+
+}  // namespace
+
+void FetchModelList(
+    network::SharedURLLoaderFactory* factory,
+    const std::string& base_url,
+    base::OnceCallback<void(std::vector<std::string>)> callback) {
+  std::string_view trimmed =
+      base::TrimString(base_url, "/", base::TRIM_TRAILING);
+  const GURL url(std::string(trimmed) + "/models");
+  if (!factory || !IsAcceptableBaseUrl(url) ||
+      !net::IsLocalhost(url)) {
+    std::move(callback).Run({});
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader->SetTimeoutDuration(kTimeout);
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      factory, base::BindOnce(&OnBody, std::move(loader), std::move(callback)),
+      kMaxBodyBytes);
+}
+
+}  // namespace rac::ai

+TEST(RacAiModelListTest, ReadsIdsInOrder) {
+  EXPECT_EQ(ParseModelList(R"({"object":"list","data":[{"id":"llama3"},
+      {"id":"qwen3:8b","object":"model"}]})"),
+            (std::vector<std::string>{"llama3", "qwen3:8b"}));
+}
+
+TEST(RacAiModelListTest, SkipsBadAndRepeatedIds) {
+  EXPECT_EQ(ParseModelList(R"({"data":[{"id":""},{"id":7},"llama3",
+      {"name":"x"},{"id":"a"},{"id":"a"},{"id":"b"}]})"),
+            (std::vector<std::string>{"a", "b"}));
+  EXPECT_EQ(ParseModelList(
+                R"({"data":[{"id":")" + std::string(201, 'x') + R"("}]})"),
+            std::vector<std::string>());
+}
+
+TEST(RacAiModelListTest, IgnoresOtherBodies) {
+  EXPECT_TRUE(ParseModelList("").empty());
+  EXPECT_TRUE(ParseModelList("<html></html>").empty());
+  EXPECT_TRUE(ParseModelList(R"({"data":{"id":"a"}})").empty());
+  EXPECT_TRUE(ParseModelList(R"([{"id":"a"}])").empty());
+}
+
+TEST(RacAiModelListTest, StopsAtTheLimit) {
+  std::string json = R"({"data":[)";
+  for (size_t i = 0; i < kMaxListedModels + 5; ++i) {
+    json += (i ? "," : "") + std::string(R"({"id":"m)") +
+            base::NumberToString(i) + R"("})";
+  }
+  json += "]}";
+  EXPECT_EQ(ParseModelList(json).size(), kMaxListedModels);
+}

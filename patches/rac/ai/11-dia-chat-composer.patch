+std::string CleanGeneratedTitle(std::string_view reply) {
+  // Reasoning models think out loud before they answer.
+  reply = base::TrimWhitespaceASCII(reply, base::TRIM_LEADING);
+  if (base::StartsWith(reply, "<think>")) {
+    const size_t end = reply.find("</think>");
+    reply = end == std::string_view::npos
+                ? std::string_view()
+                : reply.substr(end + sizeof("</think>") - 1);
+  }
+  std::string_view line;
+  for (std::string_view candidate : base::SplitStringPiece(
+           reply, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    line = candidate;
+    break;
+  }
+  if (base::StartsWith(line, "title:",
+                       base::CompareCase::INSENSITIVE_ASCII)) {
+    line.remove_prefix(6);
+  }
+  // Models like to dress titles up as Markdown or quote them.
+  line = base::TrimString(line, " \t\"'`*#_", base::TRIM_ALL);
+  line = base::TrimString(line, " .\"'`*_", base::TRIM_TRAILING);
+  return base::IsStringUTF8(line) ? MakeTitle(line) : std::string();
+}

             std::vector<std::string>{"A page"});
 }
 
+TEST(RacAiChatHistoryTest, PrefersTheTitleThePageSends) {
+  Conversation conversation;
+  base::DictValue sent = Sent("conversation-1", "What is rac?");
+  sent.Set("title", "  About rac\n");
+  ASSERT_TRUE(ConversationFromValue(sent, base::Time::Now(), &conversation));
+  EXPECT_EQ(conversation.title, "About rac");
+  sent.Set("title", "   ");
+  ASSERT_TRUE(ConversationFromValue(sent, base::Time::Now(), &conversation));
+  EXPECT_EQ(conversation.title, "What is rac?");
+}
+
+TEST(RacAiChatHistoryTest, CleansGeneratedTitles) {
+  EXPECT_EQ(CleanGeneratedTitle("\n\"Kumquat Test Page\".\nMore text"),
+            "Kumquat Test Page");
+  EXPECT_EQ(CleanGeneratedTitle("Title: **Browser QA notes**"),
+            "Browser QA notes");
+  EXPECT_EQ(CleanGeneratedTitle("# Trip ideas"), "Trip ideas");
+  EXPECT_EQ(CleanGeneratedTitle(" \n\"\"\n"), "");
+  EXPECT_EQ(CleanGeneratedTitle("<think>\nA title.\n</think>\n\nTrip ideas"),
+            "Trip ideas");
+  EXPECT_EQ(CleanGeneratedTitle("<think>never finished"), "");
+}

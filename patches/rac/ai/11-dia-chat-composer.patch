+
+namespace network {
+class SharedURLLoaderFactory;
+}
+
+namespace rac::ai {
+
+// Asks the OpenAI-compatible server at `base_url` which models it has. Only
+// for servers on this computer, which need no key. Runs `callback` with an
+// empty list if the server can't be reached or answers with something else.
+void FetchModelList(
+    network::SharedURLLoaderFactory* factory,
+    const std::string& base_url,
+    base::OnceCallback<void(std::vector<std::string>)> callback);
+
+}  // namespace rac::ai

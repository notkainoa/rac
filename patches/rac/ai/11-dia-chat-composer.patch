+void PageHandler::HandleGetModels(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AllowJavascript();
+  auto query = std::make_unique<ModelQuery>();
+  query->callback_id = args[0].Clone();
+  if (AiService* service = AiServiceFactory::GetForProfile(profile_)) {
+    PrefService* prefs = profile_->GetPrefs();
+    const std::string active = prefs->GetString(kProvider);
+    const base::DictValue& saved = prefs->GetDict(kProviderSettings);
+    for (const ProviderInfo& info : GetProviders()) {
+      if (info.id != active && !saved.Find(info.id)) {
+        continue;
+      }
+      if (info.requires_key && !service->key_store().HasKey(info.id)) {
+        continue;
+      }
+      const ProviderSettings settings = GetProviderSettings(prefs, info.id);
+      if (settings.base_url.empty()) {
+        continue;
+      }
+      ModelQuery::Entry entry;
+      entry.id = info.id;
+      entry.name = info.name;
+      entry.base_url = settings.base_url;
+      entry.local = !info.requires_key;
+      if (!settings.model.empty()) {
+        entry.models.push_back(settings.model);
+      }
+      query->entries.push_back(std::move(entry));
+    }
+  }
+  ListNextModels(std::move(query));
+}
+
+void PageHandler::ListNextModels(std::unique_ptr<ModelQuery> query) {
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  while (service && query->next < query->entries.size()) {
+    if (query->entries[query->next].local) {
+      const std::string base_url = query->entries[query->next].base_url;
+      FetchModelList(service->url_loader_factory(), base_url,
+                     base::BindOnce(&PageHandler::OnModelsListed,
+                                    weak_factory_.GetWeakPtr(),
+                                    std::move(query)));
+      return;
+    }
+    ++query->next;
+  }
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  const std::string active = prefs->GetString(kProvider);
+  base::ListValue providers;
+  for (ModelQuery::Entry& entry : query->entries) {
+    base::ListValue models;
+    for (std::string& model : entry.models) {
+      models.Append(std::move(model));
+    }
+    providers.Append(base::DictValue()
+                         .Set("id", entry.id)
+                         .Set("name", entry.name)
+                         .Set("models", std::move(models)));
+  }
+  ResolveJavascriptCallback(
+      query->callback_id,
+      base::DictValue()
+          .Set("provider", active)
+          .Set("model", GetProviderSettings(prefs, active).model)
+          .Set("providers", std::move(providers)));
+}
+
+void PageHandler::OnModelsListed(std::unique_ptr<ModelQuery> query,
+                                 std::vector<std::string> models) {
+  ModelQuery::Entry& entry = query->entries[query->next];
+  for (std::string& model : models) {
+    if (entry.models.size() < kMaxListedModels &&
+        std::ranges::find(entry.models, model) == entry.models.end()) {
+      entry.models.push_back(std::move(model));
+    }
+  }
+  ++query->next;
+  ListNextModels(std::move(query));
+}
+
+void PageHandler::HandleSelectModel(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  const std::string* provider_id = args[0].GetIfString();
+  const std::string* model = args[1].GetIfString();
+  const ProviderInfo* info =
+      provider_id ? FindProvider(*provider_id) : nullptr;
+  if (!AiServiceFactory::GetForProfile(profile_) || !info || !model ||
+      model->empty() || model->size() > kMaxModelChars ||
+      !base::IsStringUTF8(*model)) {
+    return;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  ProviderSettings settings = GetProviderSettings(prefs, info->id);
+  settings.model = *model;
+  SetProviderSettings(prefs, info->id, settings);
+  prefs->SetString(kProvider, info->id);
+}
+
+void PageHandler::HandleMakeTitle(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 3u);
+  AllowJavascript();
+  // Only the newest chat gets a title.
+  FinishTitle(base::Value());
+  title_callback_ = args[0].Clone();
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  const std::string* question = args[1].GetIfString();
+  const std::string* answer = args[2].GetIfString();
+  if (!service || !question || !answer || question->empty()) {
+    FinishTitle(base::Value());
+    return;
+  }
+  std::string cut_question;
+  std::string cut_answer;
+  base::TruncateUTF8ToByteSize(*question, kMaxTitleSourceChars,
+                               &cut_question);
+  base::TruncateUTF8ToByteSize(*answer, kMaxTitleSourceChars, &cut_answer);
+  ChatRequest request;
+  request.system_prompt = kTitlePrompt;
+  request.messages.push_back(
+      {ChatMessage::Role::kUser,
+       base::StrCat({"Question:\n", cut_question, "\n\nAnswer:\n",
+                     cut_answer})});
+  title_text_.clear();
+  title_session_ = std::make_unique<ChatSession>(
+      service, std::move(request),
+      base::BindRepeating(&PageHandler::OnTitleUpdate,
+                          weak_factory_.GetWeakPtr()));
+  title_session_->Start();
+}
+
+void PageHandler::OnTitleUpdate(StreamUpdate update) {
+  if (title_callback_.is_none()) {
+    return;
+  }
+  if (title_text_.size() < kMaxTitleReplyChars) {
+    title_text_ += update.text_delta;
+  }
+  if (update.error) {
+    FinishTitle(base::Value());
+  } else if (update.done) {
+    std::string title = CleanGeneratedTitle(title_text_);
+    FinishTitle(title.empty() ? base::Value() : base::Value(std::move(title)));
+  }
+}
+
+// Leaves `title_session_` alone: this can run inside its callback.
+void PageHandler::FinishTitle(base::Value title) {
+  if (title_callback_.is_none()) {
+    return;
+  }
+  base::Value callback_id = std::move(title_callback_);
+  title_callback_ = base::Value();
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(callback_id, title);
+  }
+}

@@ -0,0 +1,88 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/sse_parser.h"
+
+#include <utility>
+
+namespace rac::ai {
+
+SseParser::SseParser() = default;
+SseParser::~SseParser() = default;
+
+std::vector<SseParser::Event> SseParser::Feed(std::string_view chunk) {
+  std::vector<Event> events;
+  if (overflowed_) {
+    return events;
+  }
+  for (char c : chunk) {
+    if (in_bom_check_) {
+      // A UTF-8 byte order mark at the start of the stream is ignored.
+      line_.push_back(c);
+      constexpr std::string_view kBom = "\xEF\xBB\xBF";
+      if (line_.size() <= kBom.size() &&
+          line_ == kBom.substr(0, line_.size())) {
+        if (line_.size() == kBom.size()) {
+          line_.clear();
+          in_bom_check_ = false;
+        }
+        continue;
+      }
+      in_bom_check_ = false;
+      line_.pop_back();
+    }
+    if (c == '\n' && last_was_cr_) {
+      last_was_cr_ = false;
+      continue;
+    }
+    last_was_cr_ = (c == '\r');
+    if (c == '\r' || c == '\n') {
+      ProcessLine(line_, events);
+      line_.clear();
+      continue;
+    }
+    line_.push_back(c);
+    if (line_.size() + pending_data_.size() > kMaxPendingBytes) {
+      overflowed_ = true;
+      return events;
+    }
+  }
+  return events;
+}
+
+void SseParser::ProcessLine(const std::string& line,
+                            std::vector<Event>& events) {
+  if (line.empty()) {
+    if (has_data_) {
+      events.push_back({std::move(pending_type_), std::move(pending_data_)});
+    }
+    pending_type_.clear();
+    pending_data_.clear();
+    has_data_ = false;
+    return;
+  }
+  if (line[0] == ':') {
+    return;
+  }
+  std::string_view field(line);
+  std::string_view value;
+  if (size_t colon = line.find(':'); colon != std::string::npos) {
+    field = std::string_view(line).substr(0, colon);
+    value = std::string_view(line).substr(colon + 1);
+    if (!value.empty() && value[0] == ' ') {
+      value.remove_prefix(1);
+    }
+  }
+  if (field == "data") {
+    if (has_data_) {
+      pending_data_.push_back('\n');
+    }
+    pending_data_.append(value);
+    has_data_ = true;
+  } else if (field == "event") {
+    pending_type_ = std::string(value);
+  }
+}
+
+}  // namespace rac::ai

@@ -0,0 +1,51 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_SSE_PARSER_H_
+#define CHROME_BROWSER_RAC_AI_SSE_PARSER_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rac::ai {
+
+// Incremental parser for the text/event-stream format
+// (https://html.spec.whatwg.org/multipage/server-sent-events.html). Bytes may
+// arrive split anywhere, including inside a UTF-8 sequence or between "\r" and
+// "\n".
+class SseParser {
+ public:
+  struct Event {
+    std::string type;  // Empty if the server sent no "event:" line.
+    std::string data;
+  };
+
+  // Input beyond this size without a complete event is dropped, and
+  // overflowed() becomes true.
+  static constexpr size_t kMaxPendingBytes = 1024 * 1024;
+
+  SseParser();
+  ~SseParser();
+
+  // Returns the events completed by `chunk`.
+  std::vector<Event> Feed(std::string_view chunk);
+
+  bool overflowed() const { return overflowed_; }
+
+ private:
+  void ProcessLine(const std::string& line, std::vector<Event>& events);
+
+  std::string line_;
+  bool last_was_cr_ = false;
+  bool in_bom_check_ = true;
+  std::string pending_type_;
+  std::string pending_data_;
+  bool has_data_ = false;
+  bool overflowed_ = false;
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_SSE_PARSER_H_

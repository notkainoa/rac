+
+#ifndef CHROME_BROWSER_RAC_AI_CHAT_STREAM_H_
+#define CHROME_BROWSER_RAC_AI_CHAT_STREAM_H_
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/rac/ai/chat_protocol.h"
+#include "services/network/public/cpp/simple_url_loader_stream_consumer.h"
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace rac::ai {
+
+// One streamed HTTP request to a provider. The request carries no cookies and
+// follows no redirects (so a key can't be forwarded to another host), and the
+// whole exchange has a time and size limit.
+//
+// `on_update` receives text deltas and then exactly one terminal update
+// (`done` or `error`). Destroying the stream cancels the request and no
+// further updates arrive.
+class ChatStream : public network::SimpleURLLoaderStreamConsumer {
+ public:
+  using UpdateCallback = base::RepeatingCallback<void(StreamUpdate)>;
+
+  static constexpr size_t kMaxResponseBytes = 16 * 1024 * 1024;
+  static constexpr size_t kMaxErrorBodyBytes = 16 * 1024;
+
+  ChatStream(scoped_refptr<network::SharedURLLoaderFactory> factory,
+             ProviderType type,
+             HttpRequestSpec spec,
+             UpdateCallback on_update);
+  ChatStream(const ChatStream&) = delete;
+  ChatStream& operator=(const ChatStream&) = delete;
+  ~ChatStream() override;
+
+  void Start();
+
+  // network::SimpleURLLoaderStreamConsumer:
+  void OnDataReceived(std::string_view data, base::OnceClosure resume) override;
+  void OnComplete(bool success) override;
+  void OnRetry(base::OnceClosure start_retry) override;
+
+ private:
+  void OnResponseStarted(int http_status);
+  void Finish(StreamUpdate update);
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  HttpRequestSpec spec_;
+  UpdateCallback on_update_;
+  StreamDecoder decoder_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  int http_status_ = 0;
+  size_t received_bytes_ = 0;
+  std::string error_body_;
+  bool finished_ = false;
+  base::WeakPtrFactory<ChatStream> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CHAT_STREAM_H_

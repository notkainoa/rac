===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/chat_protocol.cc	2026-10-12 07:49:43.425690166 -0700
@@ -0,0 +1,184 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_protocol.h"
+
+#include <string_view>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr int kAnthropicMaxTokens = 8192;
+
+const char* RoleName(ChatMessage::Role role) {
+  return role == ChatMessage::Role::kUser ? "user" : "assistant";
+}
+
+std::string JoinUrl(const std::string& base_url, std::string_view suffix) {
+  std::string base = base_url;
+  while (!base.empty() && base.back() == '/') {
+    base.pop_back();
+  }
+  return base + std::string(suffix);
+}
+
+std::optional<std::string> ErrorFromDict(const base::DictValue& dict) {
+  const base::Value* error = dict.Find("error");
+  if (!error) {
+    return std::nullopt;
+  }
+  if (const base::DictValue* error_dict = error->GetIfDict()) {
+    if (const std::string* message = error_dict->FindString("message")) {
+      return *message;
+    }
+    return std::string("The provider reported an error.");
+  }
+  if (const std::string* message = error->GetIfString()) {
+    return *message;
+  }
+  return std::string("The provider reported an error.");
+}
+
+void DecodeOpenAi(const SseParser::Event& event,
+                  std::vector<StreamUpdate>& updates) {
+  if (event.data == "[DONE]") {
+    updates.push_back({.done = true});
+    return;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(event.data, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return;
+  }
+  if (std::optional<std::string> error = ErrorFromDict(*dict)) {
+    updates.push_back({.error = std::move(error)});
+    return;
+  }
+  const base::ListValue* choices = dict->FindList("choices");
+  if (!choices || choices->empty() || !(*choices)[0].is_dict()) {
+    return;
+  }
+  const base::DictValue& choice = (*choices)[0].GetDict();
+  if (const base::DictValue* delta = choice.FindDict("delta")) {
+    if (const std::string* content = delta->FindString("content");
+        content && !content->empty()) {
+      updates.push_back({.text_delta = *content});
+    }
+  }
+  if (const std::string* finish = choice.FindString("finish_reason");
+      finish && !finish->empty()) {
+    updates.push_back({.done = true});
+  }
+}
+
+void DecodeAnthropic(const SseParser::Event& event,
+                     std::vector<StreamUpdate>& updates) {
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(event.data, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return;
+  }
+  const std::string* type = dict->FindString("type");
+  const std::string& kind = type ? *type : event.type;
+  if (kind == "error") {
+    updates.push_back({.error = ErrorFromDict(*dict)});
+  } else if (kind == "content_block_delta") {
+    const base::DictValue* delta = dict->FindDict("delta");
+    const std::string* delta_type = delta ? delta->FindString("type") : nullptr;
+    const std::string* text = delta ? delta->FindString("text") : nullptr;
+    if (delta_type && *delta_type == "text_delta" && text && !text->empty()) {
+      updates.push_back({.text_delta = *text});
+    }
+  } else if (kind == "message_stop") {
+    updates.push_back({.done = true});
+  }
+}
+
+}  // namespace
+
+std::optional<HttpRequestSpec> BuildChatRequest(const ProviderInfo& info,
+                                                const std::string& base_url,
+                                                const std::string& model,
+                                                const std::string& api_key,
+                                                const ChatRequest& request) {
+  HttpRequestSpec spec;
+  spec.headers.emplace_back("Content-Type", "application/json");
+  spec.headers.emplace_back("Accept", "text/event-stream");
+
+  base::DictValue body;
+  body.Set("model", model);
+  body.Set("stream", true);
+  base::ListValue messages;
+
+  switch (info.type) {
+    case ProviderType::kOpenAiCompatible:
+      spec.url = GURL(JoinUrl(base_url, "/chat/completions"));
+      if (!api_key.empty()) {
+        spec.headers.emplace_back("Authorization", "Bearer " + api_key);
+      }
+      if (!request.system_prompt.empty()) {
+        messages.Append(base::DictValue()
+                            .Set("role", "system")
+                            .Set("content", request.system_prompt));
+      }
+      break;
+    case ProviderType::kAnthropic:
+      spec.url = GURL(JoinUrl(base_url, "/v1/messages"));
+      spec.headers.emplace_back("x-api-key", api_key);
+      spec.headers.emplace_back("anthropic-version", "2023-06-01");
+      body.Set("max_tokens", kAnthropicMaxTokens);
+      if (!request.system_prompt.empty()) {
+        body.Set("system", request.system_prompt);
+      }
+      break;
+  }
+  if (!IsAcceptableBaseUrl(GURL(base_url)) || !spec.url.is_valid()) {
+    return std::nullopt;
+  }
+
+  for (const ChatMessage& message : request.messages) {
+    messages.Append(base::DictValue()
+                        .Set("role", RoleName(message.role))
+                        .Set("content", message.text));
+  }
+  body.Set("messages", std::move(messages));
+  if (!base::JSONWriter::Write(body, &spec.body)) {
+    return std::nullopt;
+  }
+  return spec;
+}
+
+StreamDecoder::StreamDecoder(ProviderType type) : type_(type) {}
+StreamDecoder::~StreamDecoder() = default;
+
+std::vector<StreamUpdate> StreamDecoder::Feed(std::string_view chunk) {
+  std::vector<StreamUpdate> updates;
+  for (const SseParser::Event& event : parser_.Feed(chunk)) {
+    switch (type_) {
+      case ProviderType::kOpenAiCompatible:
+        DecodeOpenAi(event, updates);
+        break;
+      case ProviderType::kAnthropic:
+        DecodeAnthropic(event, updates);
+        break;
+    }
+  }
+  return updates;
+}
+
+std::string ExtractErrorMessage(std::string_view body) {
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(body, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::string();
+  }
+  return ErrorFromDict(*dict).value_or(std::string());
+}
+
+}  // namespace rac::ai

+++ src/chrome/browser/rac/ai/chat_protocol.h	2026-10-12 07:45:41.863723843 -0700
@@ -0,0 +1,73 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_CHAT_PROTOCOL_H_
+#define CHROME_BROWSER_RAC_AI_CHAT_PROTOCOL_H_
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/rac/ai/providers.h"
+#include "chrome/browser/rac/ai/sse_parser.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+
+struct ChatMessage {
+  enum class Role { kUser, kAssistant };
+  Role role = Role::kUser;
+  std::string text;
+};
+
+struct ChatRequest {
+  std::string system_prompt;
+  std::vector<ChatMessage> messages;
+};
+
+struct HttpRequestSpec {
+  GURL url;
+  std::vector<std::pair<std::string, std::string>> headers;
+  std::string body;
+};
+
+// Describes the HTTP request that streams a reply from `info`'s protocol.
+// Returns nullopt if `base_url` isn't acceptable (see IsAcceptableBaseUrl).
+std::optional<HttpRequestSpec> BuildChatRequest(const ProviderInfo& info,
+                                                const std::string& base_url,
+                                                const std::string& model,
+                                                const std::string& api_key,
+                                                const ChatRequest& request);
+
+// One decoded step of a streamed reply.
+struct StreamUpdate {
+  std::string text_delta;
+  bool done = false;
+  // Set when the stream carries an error. The text is the provider's, so it
+  // may be shown to the user but must not be trusted.
+  std::optional<std::string> error;
+};
+
+// Turns the bytes of a provider's event stream into text.
+class StreamDecoder {
+ public:
+  explicit StreamDecoder(ProviderType type);
+  ~StreamDecoder();
+
+  std::vector<StreamUpdate> Feed(std::string_view chunk);
+  bool overflowed() const { return parser_.overflowed(); }
+
+ private:
+  ProviderType type_;
+  SseParser parser_;
+};
+
+// Pulls the human-readable message out of a provider's JSON error body, or
+// returns an empty string.
+std::string ExtractErrorMessage(std::string_view body);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CHAT_PROTOCOL_H_
Index: src/chrome/browser/rac/ai/chat_protocol_unittest.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/chat_protocol_unittest.cc	2026-10-12 07:49:43.439706773 -0700
@@ -0,0 +1,169 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_protocol.h"
+
+#include "base/json/json_reader.h"
+#include "chrome/browser/rac/ai/providers.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+ChatRequest MakeRequest() {
+  ChatRequest request;
+  request.system_prompt = "Be brief.";
+  request.messages.push_back({ChatMessage::Role::kUser, "hi"});
+  request.messages.push_back({ChatMessage::Role::kAssistant, "hello"});
+  request.messages.push_back({ChatMessage::Role::kUser, "bye"});
+  return request;
+}
+
+std::string Collect(StreamDecoder& decoder,
+                    std::string_view input,
+                    bool* done,
+                    std::optional<std::string>* error) {
+  std::string text;
+  for (const StreamUpdate& update : decoder.Feed(input)) {
+    text += update.text_delta;
+    if (update.done) {
+      *done = true;
+    }
+    if (update.error) {
+      *error = update.error;
+    }
+  }
+  return text;
+}
+
+}  // namespace
+
+TEST(RacAiChatProtocolTest, OpenAiRequest) {
+  const ProviderInfo* info = FindProvider("openai");
+  ASSERT_TRUE(info);
+  auto spec = BuildChatRequest(*info, "https://api.openai.com/v1/", "m",
+                               "sk-test", MakeRequest());
+  ASSERT_TRUE(spec);
+  EXPECT_EQ(spec->url.spec(), "https://api.openai.com/v1/chat/completions");
+  bool has_auth = false;
+  for (const auto& [name, value] : spec->headers) {
+    has_auth |= name == "Authorization" && value == "Bearer sk-test";
+  }
+  EXPECT_TRUE(has_auth);
+  auto body = base::JSONReader::ReadDict(spec->body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(body);
+  EXPECT_EQ(*body->FindString("model"), "m");
+  EXPECT_TRUE(*body->FindBool("stream"));
+  const base::ListValue* messages = body->FindList("messages");
+  ASSERT_TRUE(messages);
+  ASSERT_EQ(messages->size(), 4u);
+  EXPECT_EQ(*(*messages)[0].GetDict().FindString("role"), "system");
+  EXPECT_EQ(*(*messages)[2].GetDict().FindString("role"), "assistant");
+}
+
+TEST(RacAiChatProtocolTest, AnthropicRequest) {
+  const ProviderInfo* info = FindProvider("anthropic");
+  ASSERT_TRUE(info);
+  auto spec = BuildChatRequest(*info, "https://api.anthropic.com", "m", "k",
+                               MakeRequest());
+  ASSERT_TRUE(spec);
+  EXPECT_EQ(spec->url.spec(), "https://api.anthropic.com/v1/messages");
+  auto body = base::JSONReader::ReadDict(spec->body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(body);
+  EXPECT_EQ(*body->FindString("system"), "Be brief.");
+  EXPECT_TRUE(body->FindInt("max_tokens"));
+  EXPECT_EQ(body->FindList("messages")->size(), 3u);
+}
+
+TEST(RacAiChatProtocolTest, RejectsInsecureRemoteServers) {
+  const ProviderInfo* info = FindProvider("custom");
+  ASSERT_TRUE(info);
+  EXPECT_FALSE(BuildChatRequest(*info, "http://example.com/v1", "m", "k",
+                                MakeRequest()));
+  EXPECT_FALSE(BuildChatRequest(*info, "https://user:pw@example.com/v1", "m",
+                                "k", MakeRequest()));
+  EXPECT_FALSE(
+      BuildChatRequest(*info, "ftp://example.com", "m", "k", MakeRequest()));
+  EXPECT_TRUE(BuildChatRequest(*info, "http://localhost:11434/v1", "m", "",
+                               MakeRequest()));
+}
+
+TEST(RacAiChatProtocolTest, OpenAiStream) {
+  StreamDecoder decoder(ProviderType::kOpenAiCompatible);
+  bool done = false;
+  std::optional<std::string> error;
+  std::string text =
+      Collect(decoder,
+              "data: {\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}\n\n"
+              "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\n"
+              "data: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\n"
+              "data: not json\n\n"
+              "data: [DONE]\n\n",
+              &done, &error);
+  EXPECT_EQ(text, "Hello");
+  EXPECT_TRUE(done);
+  EXPECT_FALSE(error);
+}
+
+TEST(RacAiChatProtocolTest, AnthropicStream) {
+  StreamDecoder decoder(ProviderType::kAnthropic);
+  bool done = false;
+  std::optional<std::string> error;
+  std::string text = Collect(
+      decoder,
+      "event: message_start\ndata: {\"type\":\"message_start\"}\n\n"
+      "event: content_block_delta\ndata: {\"type\":\"content_block_delta\","
+      "\"delta\":{\"type\":\"text_delta\",\"text\":\"Hi\"}}\n\n"
+      "event: content_block_delta\ndata: {\"type\":\"content_block_delta\","
+      "\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{}\"}}\n\n"
+      "event: message_stop\ndata: {\"type\":\"message_stop\"}\n\n",
+      &done, &error);
+  EXPECT_EQ(text, "Hi");
+  EXPECT_TRUE(done);
+}
+
+TEST(RacAiChatProtocolTest, StreamErrors) {
+  bool done = false;
+  std::optional<std::string> error;
+  StreamDecoder openai(ProviderType::kOpenAiCompatible);
+  Collect(openai, "data: {\"error\":{\"message\":\"bad key\"}}\n\n", &done,
+          &error);
+  EXPECT_EQ(error, "bad key");
+
+  error.reset();
+  StreamDecoder anthropic(ProviderType::kAnthropic);
+  Collect(anthropic,
+          "event: error\ndata: {\"type\":\"error\",\"error\":{\"message\":"
+          "\"overloaded\"}}\n\n",
+          &done, &error);
+  EXPECT_EQ(error, "overloaded");
+}
+
+TEST(RacAiChatProtocolTest, ExtractsErrorMessage) {
+  EXPECT_EQ(ExtractErrorMessage("{\"error\":{\"message\":\"nope\"}}"), "nope");
+  EXPECT_EQ(ExtractErrorMessage("<html>"), "");
+}
+
+TEST(RacAiProvidersTest, BaseUrlRules) {
+  EXPECT_TRUE(IsAcceptableBaseUrl(GURL("https://api.example.com/v1")));
+  EXPECT_TRUE(IsAcceptableBaseUrl(GURL("http://localhost:1234/v1")));
+  EXPECT_TRUE(IsAcceptableBaseUrl(GURL("http://127.0.0.1:11434")));
+  EXPECT_FALSE(IsAcceptableBaseUrl(GURL("http://example.com")));
+  EXPECT_FALSE(IsAcceptableBaseUrl(GURL("https://example.com/?a=b")));
+  EXPECT_FALSE(IsAcceptableBaseUrl(GURL("not a url")));
+}
+
+TEST(RacAiProvidersTest, EveryDefaultIsUsable) {
+  for (const ProviderInfo& info : GetProviders()) {
+    EXPECT_EQ(FindProvider(info.id), &info);
+    if (info.default_base_url[0]) {
+      EXPECT_TRUE(IsAcceptableBaseUrl(GURL(info.default_base_url))) << info.id;
+    }
+    if (info.requires_key) {
+      EXPECT_NE(std::string(info.id), "ollama");
+    }
+  }
+}
+
+}  // namespace rac::ai

@@ -0,0 +1,170 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_stream.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr base::TimeDelta kRequestTimeout = base::Minutes(5);
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("rac_ai_chat", R"(
+      semantics {
+        sender: "rac assistant"
+        description:
+          "Sends the user's message, and any page the user attached, to the "
+          "AI provider the user configured, and streams the reply back."
+        trigger: "The user sends a message in the assistant."
+        data:
+          "The conversation, attached page text and the user's own API key."
+        destination: OTHER
+        internal { contacts { email: "noreply@example.com" } }
+        user_data { type: SENSITIVE_URL type: USER_CONTENT }
+        last_reviewed: "2026-10-12"
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "Off by default. Turn the assistant on or off in Settings > Privacy "
+          "and security > Assistant."
+        policy_exception_justification: "Not implemented."
+      })");
+
+}  // namespace
+
+ChatStream::ChatStream(scoped_refptr<network::SharedURLLoaderFactory> factory,
+                       ProviderType type,
+                       HttpRequestSpec spec,
+                       UpdateCallback on_update)
+    : factory_(std::move(factory)),
+      spec_(std::move(spec)),
+      on_update_(std::move(on_update)),
+      decoder_(type) {}
+
+ChatStream::~ChatStream() = default;
+
+void ChatStream::Start() {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = spec_.url;
+  request->method = "POST";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  for (const auto& [name, value] : spec_.headers) {
+    request->headers.SetHeader(name, value);
+  }
+  loader_ =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->AttachStringForUpload(spec_.body, "application/json");
+  loader_->SetTimeoutDuration(kRequestTimeout);
+  loader_->SetOnResponseStartedCallback(base::BindOnce(
+      [](base::WeakPtr<ChatStream> self, const GURL&,
+         const network::mojom::URLResponseHead& head) {
+        if (self) {
+          self->OnResponseStarted(head.headers ? head.headers->response_code()
+                                               : 0);
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  loader_->DownloadAsStream(factory_.get(), this);
+}
+
+void ChatStream::OnResponseStarted(int http_status) {
+  http_status_ = http_status;
+}
+
+void ChatStream::OnDataReceived(std::string_view data,
+                                base::OnceClosure resume) {
+  if (finished_) {
+    return;
+  }
+  received_bytes_ += data.size();
+  const bool ok_status = http_status_ >= 200 && http_status_ < 300;
+  if (!ok_status) {
+    if (error_body_.size() < kMaxErrorBodyBytes) {
+      error_body_.append(
+          data.substr(0, kMaxErrorBodyBytes - error_body_.size()));
+    }
+    std::move(resume).Run();
+    return;
+  }
+  if (received_bytes_ > kMaxResponseBytes || decoder_.overflowed()) {
+    Finish({.error = "The reply was too large."});
+    return;
+  }
+  for (StreamUpdate& update : decoder_.Feed(data)) {
+    if (finished_) {
+      break;
+    }
+    if (update.done || update.error) {
+      Finish(std::move(update));
+      return;
+    }
+    on_update_.Run(std::move(update));
+  }
+  if (decoder_.overflowed()) {
+    Finish({.error = "The reply was malformed."});
+    return;
+  }
+  std::move(resume).Run();
+}
+
+void ChatStream::OnComplete(bool success) {
+  if (finished_) {
+    return;
+  }
+  if (http_status_ != 0 && (http_status_ < 200 || http_status_ >= 300)) {
+    std::string message = ExtractErrorMessage(error_body_);
+    std::string text = base::StrCat({"The provider returned an error (HTTP ",
+                                     base::NumberToString(http_status_), ")"});
+    if (!message.empty()) {
+      text += ": " + message.substr(0, 500);
+    }
+    Finish({.error = std::move(text)});
+    return;
+  }
+  if (!success) {
+    const int net_error = loader_ ? loader_->NetError() : net::ERR_FAILED;
+    Finish({.error = base::StrCat({"Couldn't reach the provider (",
+                                   net::ErrorToShortString(net_error), ")."})});
+    return;
+  }
+  Finish({.done = true});
+}
+
+void ChatStream::OnRetry(base::OnceClosure start_retry) {
+  // Retries are never requested.
+  Finish({.error = "The request was interrupted."});
+}
+
+void ChatStream::Finish(StreamUpdate update) {
+  if (finished_) {
+    return;
+  }
+  finished_ = true;
+  // This may run inside one of the loader's own callbacks.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(loader_));
+  on_update_.Run(std::move(update));
+}
+
+}  // namespace rac::ai

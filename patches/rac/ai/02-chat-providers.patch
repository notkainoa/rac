+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/sse_parser.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+
+TEST(RacAiSseParserTest, ParsesEventsAcrossArbitrarySplits) {
+  const std::string stream =
+      ": comment\r\nevent: a\r\ndata: one\r\n\r\ndata: two\ndata: lines\n\n";
+  for (size_t split = 0; split <= stream.size(); ++split) {
+    SseParser parser;
+    auto events = parser.Feed(stream.substr(0, split));
+    auto rest = parser.Feed(stream.substr(split));
+    events.insert(events.end(), rest.begin(), rest.end());
+    ASSERT_EQ(events.size(), 2u) << "split " << split;
+    EXPECT_EQ(events[0].type, "a");
+    EXPECT_EQ(events[0].data, "one");
+    EXPECT_EQ(events[1].type, "");
+    EXPECT_EQ(events[1].data, "two\nlines");
+  }
+}
+
+TEST(RacAiSseParserTest, IgnoresIncompleteEventAndBom) {
+  SseParser parser;
+  auto events = parser.Feed(
+      "\xEF\xBB\xBF"
+      "data: x\n\ndata: unfinished\n");
+  ASSERT_EQ(events.size(), 1u);
+  EXPECT_EQ(events[0].data, "x");
+}
+
+TEST(RacAiSseParserTest, KeepsUtf8SplitInsideSequence) {
+  SseParser parser;
+  EXPECT_TRUE(parser.Feed("data: \xC3").empty());
+  auto events = parser.Feed("\xA9\n\n");
+  ASSERT_EQ(events.size(), 1u);
+  EXPECT_EQ(events[0].data, "\xC3\xA9");
+}
+
+TEST(RacAiSseParserTest, StopsOnOversizedEvent) {
+  SseParser parser;
+  std::string big(SseParser::kMaxPendingBytes + 10, 'x');
+  EXPECT_TRUE(parser.Feed("data: " + big).empty());
+  EXPECT_TRUE(parser.overflowed());
+  EXPECT_TRUE(parser.Feed("\n\n").empty());
+}
+
+}  // namespace rac::ai

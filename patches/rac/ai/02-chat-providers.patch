@@ -0,0 +1,76 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_session.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/ai/ai_service.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac::ai {
+
+ChatSession::ChatSession(AiService* service,
+                         ChatRequest request,
+                         ChatStream::UpdateCallback on_update)
+    : service_(service),
+      request_(std::move(request)),
+      on_update_(std::move(on_update)) {}
+
+ChatSession::~ChatSession() = default;
+
+void ChatSession::Start() {
+  provider_id_ = service_->prefs()->GetString(kProvider);
+  const ProviderInfo* info = FindProvider(provider_id_);
+  if (!info) {
+    Fail("Choose a provider in Settings > Privacy and security > Assistant.");
+    return;
+  }
+  if (!info->requires_key) {
+    OnKey(std::string());
+    return;
+  }
+  service_->key_store().GetKey(
+      provider_id_,
+      base::BindOnce(&ChatSession::OnKey, weak_factory_.GetWeakPtr()));
+}
+
+void ChatSession::OnKey(std::optional<std::string> key) {
+  const ProviderInfo* info = FindProvider(provider_id_);
+  if (!info || !key) {
+    Fail("Add an API key in Settings > Privacy and security > Assistant.");
+    return;
+  }
+  const ProviderSettings settings =
+      GetProviderSettings(service_->prefs(), provider_id_);
+  if (settings.base_url.empty()) {
+    Fail(
+        "Set the server address in Settings > Privacy and security > "
+        "Assistant.");
+    return;
+  }
+  if (settings.model.empty()) {
+    Fail("Set a model in Settings > Privacy and security > Assistant.");
+    return;
+  }
+  std::optional<HttpRequestSpec> spec = BuildChatRequest(
+      *info, settings.base_url, settings.model, *key, request_);
+  if (!spec) {
+    Fail(
+        "The server address isn't usable. Use https, or http for a server on "
+        "this computer.");
+    return;
+  }
+  stream_ = std::make_unique<ChatStream>(
+      service_->url_loader_factory(), info->type, std::move(*spec), on_update_);
+  stream_->Start();
+}
+
+void ChatSession::Fail(const std::string& message) {
+  on_update_.Run({.error = message});
+}
+
+}  // namespace rac::ai

+// it ended. It exists only while AI is on.
+class ActivePageWatch : public content::WebContentsObserver {
+ public:
+  ActivePageWatch(BrowserWindowInterface* browser,
+                  base::RepeatingClosure on_change)
+      : on_change_(std::move(on_change)) {
+    active_tab_subscription_ =
+        browser->RegisterActiveTabDidChange(base::BindRepeating(
+            &ActivePageWatch::OnActiveTabChanged, base::Unretained(this)));
+    tabs::TabInterface* tab = browser->GetActiveTabInterface();
+    Observe(tab ? tab->GetContents() : nullptr);
+    VLOG(1) << "rac assistant: watching the active tab";
+  }
+
+  ActivePageWatch(const ActivePageWatch&) = delete;
+  ActivePageWatch& operator=(const ActivePageWatch&) = delete;
+  ~ActivePageWatch() override = default;
+
+ private:
+  void OnActiveTabChanged(BrowserWindowInterface* browser) {
+    tabs::TabInterface* tab = browser->GetActiveTabInterface();
+    Observe(tab ? tab->GetContents() : nullptr);
+    on_change_.Run();
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+      on_change_.Run();
+    }
+  }
+
+  void WebContentsDestroyed() override { Observe(nullptr); }
+
+  base::RepeatingClosure on_change_;
+  base::CallbackListSubscription active_tab_subscription_;
+};

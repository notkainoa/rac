+bool IsAssistantBlockedHere(BrowserWindowInterface* browser) {
+  if (!IsAiEnabled(browser->GetProfile()->GetPrefs())) {
+    return false;
+  }
+  tabs::TabInterface* tab = browser->GetActiveTabInterface();
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return true;
+  }
+  // The address bar's address, so a tab on its way to a web page keeps the
+  // assistant. A blank tab isn't an internal page either: the agent opens
+  // its tabs blank first, and closing the panel there would hide its cards
+  // mid-task. What the assistant may read is IsInternalTab()'s call.
+  const GURL& url = contents->GetVisibleURL();
+  return !url.is_empty() && !url.IsAboutBlank() &&
+         IsInternalPageUrl(url, GURL());
+}

+// Cursor sends its words with no message id. A tool call between two of its
+// sentences still starts a new paragraph.
+TEST_F(AcpServiceTest, ActionsBreakParagraphsInTextWithoutIds) {
+  const std::string tool_call =
+      R"({"jsonrpc":"2.0","method":"session/update","params":{"sessionId":)"
+      R"("s1","update":{"sessionUpdate":"tool_call","toolCallId":"c1",)"
+      R"("title":"snapshot","status":"in_progress"}}})"
+      "\n";
+  ASSERT_TRUE(base::WriteFile(log_.AppendASCII("reply"),
+                              Chunk("I'll look.", "") + tool_call +
+                                  Chunk("The page loaded.", "") +
+                                  Chunk(" Pip.", "") + kEndTurn));
+  Result result;
+  base::RunLoop loop;
+  Prompt("hello agent", &result, nullptr, loop.QuitClosure());
+  loop.Run();
+  EXPECT_EQ(result.error, "");
+  EXPECT_EQ(result.text, "I'll look.\n\nThe page loaded. Pip.");
+}

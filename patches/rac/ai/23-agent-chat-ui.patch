+
+// A row that opens and closes its body in place, so the chevron can turn
+// without the thread redrawing.
+function makeFold(
+    run: AgentRun, key: string, label: Node[],
+    fill: (body: HTMLElement) => void, hasBody = true): HTMLElement {
+  const wrap = document.createElement('div');
+  wrap.className = 'step';
+  const open = hasBody && run.expanded.has(key);
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.className = 'step-row';
+  // A step with nothing to show stays a plain line.
+  button.disabled = !hasBody;
+  button.dataset['stepKey'] = key;
+  button.id = `row-${key}`;
+  button.setAttribute('aria-expanded', String(open));
+  button.setAttribute('aria-controls', `body-${key}`);
+  const text = document.createElement('span');
+  text.className = 'step-label';
+  text.append(...label);
+  button.append(makeChevron(), text);
+  const body = document.createElement('div');
+  body.className = 'step-body';
+  body.id = `body-${key}`;
+  body.setAttribute('role', 'group');
+  body.setAttribute('aria-labelledby', button.id);
+  body.hidden = !open;
+  fill(body);
+  button.addEventListener('click', () => {
+    const now = button.getAttribute('aria-expanded') !== 'true';
+    button.setAttribute('aria-expanded', String(now));
+    body.hidden = !now;
+    if (now) {
+      run.expanded.add(key);
+    } else {
+      run.expanded.delete(key);
+    }
+  });
+  wrap.append(button, body);
+  return wrap;
+}
+
+function makeStepRow(run: AgentRun, step: Step): HTMLElement {
+  const label: Node[] = [document.createTextNode(stepLabel(run, step))];
+  if (step.status === 'failed' && !isBlockedCommand(step)) {
+    const failed = document.createElement('span');
+    failed.className = 'step-failed';
+    failed.textContent = loadTimeData.getString('stepFailed');
+    label.push(failed);
+  }
+  const hasBody = step.kind === 'thought' ? step.text.trim() !== '' :
+                                            step.details.length > 0;
+  return makeFold(run, step.key, label, body => {
+    if (step.kind === 'thought') {
+      body.textContent = step.text.trim();
+      return;
+    }
+    for (const [key, value] of step.details) {
+      const row = document.createElement('div');
+      row.className = 'step-detail';
+      const name = document.createElement('span');
+      name.className = 'step-key';
+      name.textContent = `${key}: `;
+      const text = document.createElement('span');
+      text.className = 'step-value';
+      text.textContent = value;
+      row.append(name, text);
+      body.appendChild(row);
+    }
+  }, hasBody);
+}
+
+function makeSteps(run: AgentRun): HTMLElement {
+  const list = document.createElement('div');
+  list.className = 'steps';
+  const shown = run.steps.slice(0, MAX_OPEN_STEPS);
+  const folded = run.steps.slice(MAX_OPEN_STEPS);
+  for (const step of shown) {
+    list.appendChild(makeStepRow(run, step));
+  }
+  if (folded.length > 0) {
+    const label = loadTimeData.getStringF(
+        folded.length === 1 ? 'usedMoreTool' : 'usedMoreTools',
+        String(folded.length));
+    list.appendChild(
+        makeFold(run, 'more', [document.createTextNode(label)], body => {
+          for (const step of folded) {
+            body.appendChild(makeStepRow(run, step));
+          }
+        }));
+  }
+  return list;
+}
+
+function makePlan(run: AgentRun): HTMLElement {
+  const plan = document.createElement('div');
+  plan.className = 'plan';
+  const heading = document.createElement('div');
+  heading.className = 'plan-heading';
+  heading.textContent = loadTimeData.getString('planLabel');
+  const list = document.createElement('ul');
+  for (const entry of run.plan) {
+    const item = document.createElement('li');
+    item.dataset['status'] = entry.status;
+    const mark = document.createElement('span');
+    mark.className = 'plan-mark';
+    mark.setAttribute('aria-hidden', 'true');
+    if (entry.status === 'completed') {
+      mark.appendChild(makeIcon(CHECK_ICON));
+    }
+    item.append(mark, document.createTextNode(entry.content));
+    list.appendChild(item);
+  }
+  plan.append(heading, list);
+  return plan;

+
+// What a step row says: plain past tense when it's over, the agent's own
+// words and an ellipsis while it runs.
+function stepLabel(run: AgentRun, step: Step): string {
+  if (step.kind === 'thought') {
+    if (step.status === 'running') {
+      return loadTimeData.getString('thinkingDots');
+    }
+    const ms = (step.endMs ?? Date.now()) - step.startMs;
+    return ms < 1000 ? loadTimeData.getString('thoughtShort') :
+                       loadTimeData.getStringF('thoughtFor', formatSeconds(ms));
+  }
+  if (isBlockedCommand(step)) {
+    return loadTimeData.getStringF('blockedCommand', run.name);
+  }
+  const title = step.title || loadTimeData.getString('toolFallback');
+  return step.status === 'running' && !title.endsWith('\u2026') ?
+      `${title}\u2026` :
+      title;
+}
+
+// rac gives agents only its own browser tools, so a command they ask to run
+// is refused.
+function isBlockedCommand(step: Step): boolean {
+  return step.kind === 'tool' && step.toolKind === 'execute' &&
+      step.status === 'failed';
+}

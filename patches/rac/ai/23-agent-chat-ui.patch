+    error.appendChild(detail);
+  }
+  if (active) {
+    const actions = document.createElement('div');
+    actions.className = 'error-actions';
+    view.actions.forEach((action, i) => {
+      const primary = i === 0;
+      if (action === 'retry') {
+        actions.appendChild(
+            makeAction(loadTimeData.getString('retry'), retry, primary));
+      } else if (action === 'settings') {
+        actions.appendChild(makeAction(
+            loadTimeData.getString('agentSettings'), openSettings, primary));
+      } else {
+        actions.appendChild(makeAction(
+            loadTimeData.getString('chooseProvider'), openProviderMenu,
+            primary));
+      }
+    });
+    error.appendChild(actions);
+  }
+  return error;
+}

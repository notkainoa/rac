+  const raw = message.error;
+  if (!raw) {
+    agentIssues.delete(run.id);
+  } else if (raw.startsWith('Sign in required')) {
+    agentIssues.set(run.id, 'signin');
+  } else if (
+      raw === 'That agent is not installed.' || raw.startsWith('Could not')) {
+    agentIssues.set(run.id, 'fix');
+  }
+}

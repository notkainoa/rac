+      run ? describeAgentError(run, message.error!, !!message.text) : {
+        title: loadTimeData.getString('errorTitle'),
+        detail: message.error!,
+        actions: ['retry'],
+      };
+  const error = document.createElement('div');
+  error.className = 'error';
+  const title = document.createElement('p');
+  title.className = 'error-title';
+  title.textContent = view.title;
+  error.appendChild(title);
+  if (view.detail) {
+    const detail = document.createElement('p');
+    detail.className = 'error-detail';
+    if (view.command) {
+      const [before, after] = view.detail.split(view.command);
+      const code = document.createElement('code');
+      code.className = 'error-command';
+      code.textContent = view.command;
+      detail.append(before ?? '', code, after ?? '');
+      const command = view.command;

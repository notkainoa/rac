+    label: string, onClick: () => void, primary = false): HTMLElement {
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.className = primary ? 'pill-action primary' : 'pill-action';
+  button.textContent = label;
+  button.addEventListener('click', onClick);
+  return button;
+}

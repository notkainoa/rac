+interface ErrorView {
+  title: string;
+  detail: string;
+  // A command to show in the detail, and offer to copy.
+  command?: string;
+  actions: Array<'retry'|'settings'|'provider'>;
+}
+
+// What went wrong with an agent, in the words of the design: a plain title,
+// one line on what to do, and the buttons that do it. `raw` is the backend's
+// own text.
+function describeAgentError(
+    run: AgentRun, raw: string, hadReply: boolean): ErrorView {
+  const name = run.name;
+  const info = agentInfos.get(run.id);
+  if (raw.startsWith('Sign in required')) {
+    const help = raw.split(': ').slice(1).join(': ').trim();
+    const isCommand = /^[a-z0-9-]+( [a-z0-9-]+){0,2}$/.test(help);
+    return {
+      title: loadTimeData.getStringF('errSignInTitle', name),
+      detail: isCommand ? loadTimeData.getStringF('errSignInDetail', help) :
+                          loadTimeData.getStringF('errSignInGeneric', name),
+      command: isCommand ? help : undefined,
+      actions: ['retry'],
+    };
+  }
+  if (raw === 'That agent is not installed.') {
+    if (info?.needsNode) {
+      return {
+        title: loadTimeData.getStringF('errNodeTitle', name),
+        detail: loadTimeData.getString('errNodeDetail'),
+        actions: ['retry'],
+      };
+    }
+    return {
+      title: loadTimeData.getStringF('errNotFoundTitle', name),
+      detail: loadTimeData.getString('errNotFoundDetail'),
+      actions: ['settings'],
+    };
+  }
+  if (raw === 'Agents are not available in Incognito.') {
+    return {
+      title: loadTimeData.getString('noAgentsIncognito'),
+      detail: '',
+      actions: ['provider'],
+    };
+  }
+  if (/^Could not (start|create|configure|discover)|^The agent (command is|process id)/
+          .test(raw) ||
+      (raw === 'The agent timed out.' && !run.heard)) {
+    return {
+      title: loadTimeData.getStringF('errStartTitle', name),
+      detail: loadTimeData.getStringF('errStartDetail', cliName()),
+      actions: ['retry', 'settings'],
+    };
+  }
+  if (/^The agent (exited|closed|sent|timed out)|^Lost the agent|^Invalid agent|^The agent (session|connection|is not|does not)/
+          .test(raw)) {
+    return {
+      title: loadTimeData.getStringF('errStoppedTitle', name),
+      detail: loadTimeData.getString('errStoppedDetail'),
+      actions: ['retry'],
+    };
+  }
+  if (/limit|quota|rate/i.test(raw)) {
+    return {
+      title: loadTimeData.getStringF('errLimitTitle', name),
+      detail: raw.split('\n')[0]!.slice(0, 240),
+      actions: ['retry'],
+    };
+  }
+  return {
+    title: loadTimeData.getString('errorTitle'),
+    detail: raw.split('\n')[0]!.slice(0, 240),
+    actions: hadReply ? ['retry'] : ['retry', 'settings'],
+  };
+}

--- src.orig/chrome/browser/rac/ai/acp/agent_path_unittest.cc
+++ src/chrome/browser/rac/ai/acp/agent_path_unittest.cc
@@ -6,6 +6,8 @@
 #include <string>
 #include <vector>
 
+#include "base/functional/bind.h"
+#include "base/test/task_environment.h"
 #include "testing/gtest/include/gtest/gtest.h"
 
 namespace rac::ai {
@@ -36,5 +38,20 @@ TEST(LoginShellArgvTest, NeverAsksForJob
   }
 }
 
+// A refresh while the probe is running must not drop callers that are
+// already waiting: their WebUI promises have to settle. Both the early and
+// the late waiter get the fresh probe's answer.
+TEST(AgentPathCacheTest, InvalidateKeepsWaitersForTheNextProbe) {
+  base::test::TaskEnvironment env;
+  AgentPathCache cache;
+  int answered = 0;
+  auto counter = [](int* answered, std::string, std::string) { ++*answered; };
+  cache.Ensure(base::BindOnce(counter, &answered));
+  cache.Invalidate();
+  cache.Ensure(base::BindOnce(counter, &answered));
+  env.RunUntilIdle();
+  EXPECT_EQ(answered, 2);
+}
+
 }  // namespace
 }  // namespace rac::ai

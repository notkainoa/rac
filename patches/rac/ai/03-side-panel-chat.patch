+struct Str {
+  const char* name;
+  const char* value;
+};
+
+// English only for now; rac has no translation pipeline yet.
+constexpr Str kStrings[] = {
+    {"title", "Assistant"},
+    {"placeholder", "Ask anything"},
+    {"send", "Send"},
+    {"stop", "Stop"},
+    {"newChat", "New chat"},
+    {"settings", "Assistant settings"},
+    {"greeting", "What can I help with?"},
+    {"copy", "Copy"},
+    {"copied", "Copied"},
+    {"retry", "Try again"},
+    {"setupTitle", "Set up the assistant"},
+    {"setupBody",
+     "Add your own AI provider to start chatting. Your messages go straight "
+     "to it, never through rac."},
+    {"setupButton", "Open settings"},
+    {"disabled", "The assistant is turned off."},
+    {"thinking", "Thinking"},
+    {"you", "You"},
+};
+

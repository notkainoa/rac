+class ChatSession;
+
+// Messages between the assistant page (chrome://rac-ai) and the browser. The
+// page only ever holds text; keys and network access stay here.
+class PageHandler : public content::WebUIMessageHandler {
+ public:
+  explicit PageHandler(Profile* profile);
+  PageHandler(const PageHandler&) = delete;
+  PageHandler& operator=(const PageHandler&) = delete;
+  ~PageHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void HandleInit(const base::ListValue& args);
+  void HandleSend(const base::ListValue& args);
+  void HandleStop(const base::ListValue& args);
+  void HandleOpenUrl(const base::ListValue& args);
+  void HandleOpenSettings(const base::ListValue& args);
+
+  void OnUpdate(int send_id, StreamUpdate update);
+  void OnEnabledChanged();
+  void StopSession();
+
+  raw_ptr<Profile> profile_;
+  PrefChangeRegistrar pref_registrar_;
+  std::unique_ptr<ChatSession> session_;
+  int active_send_id_ = 0;
+  base::WeakPtrFactory<PageHandler> weak_factory_{this};
+};
+

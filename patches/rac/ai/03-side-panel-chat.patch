+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// The assistant page talks to its WebUIMessageHandler with chrome.send, not
+// Mojo: the handler is a few text messages and a stream of events, and Mojo
+// would add a .mojom, generated bindings, and a factory for no gain. The lint
+// rules that steer new pages to Mojo are switched off here, in the one file
+// that uses the old calls.
+/* eslint-disable no-restricted-properties, no-restricted-imports */
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export function sendToBrowser(message: string, args: unknown[] = []) {
+  chrome.send(message, args);
+}
+

+
+RacAiUIConfig::RacAiUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kHost) {}
+
+bool RacAiUIConfig::IsWebUIEnabled(content::BrowserContext* browser_context) {
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  return profile->IsRegularProfile() &&
+         profile->GetPrefs()->GetBoolean(kEnabled);
+}
+
+RacAiUI::RacAiUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, kHost);
+  for (const Str& str : kStrings) {
+    source->AddString(str.name, str.value);
+  }
+  webui::SetupWebUIDataSource(source, kRacAiResources, IDR_RAC_AI_INDEX_HTML);
+  web_ui->AddMessageHandler(std::make_unique<PageHandler>(profile));
+}
+
+RacAiUI::~RacAiUI() = default;
+

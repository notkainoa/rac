+// The chat page, hosted directly in the side panel. It has no toolbar or
+// extras of its own; the side panel's header supplies the title and the
+// close button.
+class AssistantWebView : public views::WebView {
+  METADATA_HEADER(AssistantWebView, views::WebView)
+
+ public:
+  AssistantWebView(Profile* profile, BrowserWindowInterface* browser)
+      : views::WebView(profile) {
+    webui::SetBrowserWindowInterface(GetWebContents(), browser);
+    LoadInitialURL(GURL(kPanelUrl));
+  }
+
+  ~AssistantWebView() override = default;
+
+ protected:
+  // views::View:
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override {
+    views::WebView::VisibilityChanged(starting_from, is_visible);
+    if (is_visible && starting_from == this) {
+      // Let the user type straight away.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&AssistantWebView::FocusPage,
+                                    weak_factory_.GetWeakPtr()));
+    }
+  }
+
+ private:
+  void FocusPage() {
+    if (GetVisible() && GetWidget()) {
+      RequestFocus();
+    }
+  }
+
+  base::WeakPtrFactory<AssistantWebView> weak_factory_{this};
+};

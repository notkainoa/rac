+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import '/strings.m.js';
+
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {getRequiredElement} from 'chrome://resources/js/util.js';
+
+import {addWebUiListener, sendToBrowser, sendWithPromise} from './browser_proxy.js';
+import {renderMarkdown} from './markdown.js';
+
+interface InitState {
+  enabled: boolean;
+  configured?: boolean;
+  needsKey?: boolean;
+  providerName?: string;
+  model?: string;
+}
+
+interface UpdateEvent {
+  id: number;
+  delta?: string;
+  done?: boolean;
+  error?: string;
+}
+
+interface Message {
+  role: 'user'|'assistant';
+  text: string;
+  error?: string;
+  element?: HTMLElement;
+}
+
+const messages: Message[] = [];
+let activeId = 0;
+let streaming = false;
+let configured = false;
+let renderQueued = false;
+
+const thread = getRequiredElement('thread');
+const scroller = getRequiredElement('scroll');
+const input = getRequiredElement<HTMLTextAreaElement>('input');
+const sendButton = getRequiredElement<HTMLButtonElement>('send');
+const stopButton = getRequiredElement<HTMLButtonElement>('stop');
+const emptyState = getRequiredElement('empty');
+const setupState = getRequiredElement('setup');
+const modelChip = getRequiredElement('modelChip');
+const modelName = getRequiredElement('modelName');
+
+function openUrl(url: string) {
+  sendToBrowser('racAiOpenUrl', [url]);
+}
+
+function applyStrings() {
+  for (const element of document.querySelectorAll<HTMLElement>(
+           '[data-i18n]')) {
+    element.textContent = loadTimeData.getString(element.dataset['i18n']!);
+  }
+  for (const element of document.querySelectorAll<HTMLElement>(
+           '[data-i18n-label]')) {
+    const text = loadTimeData.getString(element.dataset['i18nLabel']!);
+    element.setAttribute('aria-label', text);
+    element.title = text;
+  }
+  for (const element of document.querySelectorAll<HTMLTextAreaElement>(
+           '[data-i18n-placeholder]')) {
+    element.placeholder =
+        loadTimeData.getString(element.dataset['i18nPlaceholder']!);
+  }
+}
+
+function updateControls() {
+  const hasText = input.value.trim().length > 0;
+  sendButton.disabled = !configured || !hasText;
+  sendButton.hidden = streaming;
+  stopButton.hidden = !streaming;
+  input.disabled = !configured;
+  emptyState.hidden = !configured || messages.length > 0;
+  setupState.hidden = configured;
+  thread.hidden = !configured;
+}
+
+function scrollToEnd() {
+  scroller.scrollTop = scroller.scrollHeight;
+}
+
+function isNearEnd(): boolean {
+  return scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight <
+      80;
+}
+
+function makeActionButton(label: string, onClick: () => void): HTMLElement {
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.textContent = label;
+  button.addEventListener('click', onClick);
+  return button;
+}
+
+function renderMessage(message: Message, isLast: boolean) {
+  let element = message.element;
+  if (!element) {
+    element = document.createElement('div');
+    message.element = element;
+    thread.appendChild(element);
+  }
+  element.className =
+      message.role === 'user' ? 'message-user' : 'message-assistant';
+  if (message.role === 'user') {
+    element.textContent = message.text;
+    return;
+  }
+
+  element.replaceChildren();
+  if (message.text) {
+    element.appendChild(renderMarkdown(message.text, openUrl));
+  } else if (streaming && isLast && !message.error) {
+    const thinking = document.createElement('div');
+    thinking.className = 'thinking';
+    thinking.dataset['text'] = loadTimeData.getString('thinking');
+    thinking.setAttribute('role', 'status');
+    thinking.setAttribute('aria-label', loadTimeData.getString('thinking'));
+    element.appendChild(thinking);
+  }
+  if (message.error) {
+    const error = document.createElement('div');
+    error.className = 'message-error';
+    error.textContent = message.error;
+    if (isLast && !streaming) {
+      error.appendChild(
+          makeActionButton(loadTimeData.getString('retry'), retry));
+    }
+    element.appendChild(error);
+  }
+  if (message.text && !(streaming && isLast)) {
+    const actions = document.createElement('div');
+    actions.className = 'message-actions';
+    const copy = makeActionButton(loadTimeData.getString('copy'), () => {
+      navigator.clipboard.writeText(message.text).then(() => {
+        copy.textContent = loadTimeData.getString('copied');
+        setTimeout(() => {
+          copy.textContent = loadTimeData.getString('copy');
+        }, 1500);
+      });
+    });
+    actions.appendChild(copy);
+    element.appendChild(actions);
+  }
+}
+
+function render() {
+  renderQueued = false;
+  const follow = isNearEnd();
+  messages.forEach((message, index) => {
+    renderMessage(message, index === messages.length - 1);
+  });
+  updateControls();
+  if (follow) {
+    scrollToEnd();
+  }
+}
+
+// Streaming deltas arrive often; draw at most once per frame.
+function queueRender() {
+  if (!renderQueued) {
+    renderQueued = true;
+    requestAnimationFrame(render);
+  }
+}
+
+function transcript() {
+  return messages.filter(m => m.text && !m.error)
+      .map(m => ({role: m.role, text: m.text}));
+}
+
+function startReply() {
+  activeId++;
+  streaming = true;
+  messages.push({role: 'assistant', text: ''});
+  sendToBrowser('racAiSend', [activeId, transcript()]);
+  render();
+}
+
+function send() {
+  const text = input.value.trim();
+  if (!configured || streaming || !text) {
+    return;
+  }
+  messages.push({role: 'user', text});
+  input.value = '';
+  resizeInput();
+  startReply();
+  scrollToEnd();
+}
+
+function retry() {
+  if (streaming) {
+    return;
+  }
+  const last = messages[messages.length - 1];
+  if (last && last.role === 'assistant' && last.error) {
+    last.element?.remove();
+    messages.pop();
+    startReply();
+  }
+}
+
+function stop() {
+  if (!streaming) {
+    return;
+  }
+  sendToBrowser('racAiStop');
+  streaming = false;
+  const last = messages[messages.length - 1];
+  if (last && last.role === 'assistant' && !last.text && !last.error) {
+    last.element?.remove();
+    messages.pop();
+  }
+  render();
+}
+
+function newChat() {
+  if (streaming) {
+    sendToBrowser('racAiStop');
+  }
+  streaming = false;
+  activeId++;
+  messages.length = 0;
+  thread.replaceChildren();
+  render();
+  input.focus();
+}
+
+function onUpdate(event: UpdateEvent) {
+  if (event.id !== activeId) {
+    return;
+  }
+  const last = messages[messages.length - 1];
+  if (!last || last.role !== 'assistant') {
+    return;
+  }
+  if (event.delta) {
+    last.text += event.delta;
+  }
+  if (event.error) {
+    last.error = event.error;
+    streaming = false;
+  }
+  if (event.done) {
+    streaming = false;
+  }
+  if (!streaming && !last.text && !last.error) {
+    last.element?.remove();
+    messages.pop();
+  }
+  queueRender();
+}
+
+function resizeInput() {
+  input.style.height = 'auto';
+  input.style.height = `${Math.min(input.scrollHeight, 200)}px`;
+}
+
+function applyState(state: InitState) {
+  configured = state.enabled && !!state.configured;
+  if (state.enabled && state.providerName) {
+    modelChip.hidden = false;
+    modelName.textContent = state.model ?
+        `${state.providerName} · ${state.model}` :
+        state.providerName;
+  } else {
+    modelChip.hidden = true;
+  }
+  updateControls();
+}
+
+function init() {
+  applyStrings();
+  document.body.dataset['mode'] =
+      new URLSearchParams(location.search).get('mode') === 'page' ? 'page' :
+                                                                    'panel';
+
+  input.addEventListener('input', () => {
+    resizeInput();
+    updateControls();
+  });
+  input.addEventListener('keydown', (event: KeyboardEvent) => {
+    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
+      event.preventDefault();
+      send();
+    }
+  });
+  sendButton.addEventListener('click', send);
+  stopButton.addEventListener('click', stop);
+  getRequiredElement('newChat').addEventListener('click', newChat);
+  const openSettings = () => sendToBrowser('racAiOpenSettings');
+  getRequiredElement('openSettings').addEventListener('click', openSettings);
+  getRequiredElement('setupButton').addEventListener('click', openSettings);
+  modelChip.addEventListener('click', openSettings);
+
+  addWebUiListener('rac-ai-update', onUpdate);
+  addWebUiListener('rac-ai-disabled', () => {
+    streaming = false;
+    configured = false;
+    updateControls();
+  });
+  // The page can be reopened after its settings changed, so look again
+  // whenever it becomes visible.
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') {
+      sendWithPromise<InitState>('racAiInit').then(applyState);
+    }
+  });
+
+  sendWithPromise<InitState>('racAiInit').then(state => {
+    applyState(state);
+    const question = new URLSearchParams(location.search).get('q');
+    if (question && configured) {
+      input.value = question.slice(0, 20000);
+      send();
+    } else {
+      input.focus();
+    }
+  });
+}
+
+init();

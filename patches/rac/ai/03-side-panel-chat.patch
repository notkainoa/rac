+void ToggleAssistant(BrowserWindowInterface* browser) {
+  Profile* profile = browser->GetProfile();
+  if (!profile->IsRegularProfile()) {
+    return;
+  }
+  if (!profile->GetPrefs()->GetBoolean(kEnabled)) {
+    browser->OpenGURL(GURL("chrome://settings/assistant"),
+                      WindowOpenDisposition::NEW_FOREGROUND_TAB);
+    return;
+  }
+  if (SidePanelUI* ui = SidePanelUI::From(browser)) {
+    ui->Toggle(SidePanelEntryKey(SidePanelEntryId::kRacAi),
+               SidePanelOpenTrigger::kToolbarButton);
+  }
+}
+
+void AddAssistantAction(actions::ActionItem* root,
+                        BrowserWindowInterface* browser) {
+  if (!browser->GetProfile()->IsRegularProfile()) {
+    return;
+  }
+  root->AddChild(
+      actions::ActionItem::Builder(
+          CreateToggleSidePanelActionCallback(
+              SidePanelEntryKey(SidePanelEntryId::kRacAi), browser))
+          .SetActionId(kActionSidePanelShowRacAi)
+          .SetText(u"Assistant")
+          .SetTooltipText(u"Assistant")
+          .SetImage(
+              ui::ImageModel::FromVectorIcon(kAssistantIcon, ui::kColorIcon))
+          .SetProperty(actions::kActionItemPinnableKey,
+                       std::underlying_type_t<actions::ActionPinnableState>(
+                           actions::ActionPinnableState::kNotPinnable))
+          .Build());
+}
+

+/* Copyright 2026 The rac Authors
+ * You can use, redistribute, and/or modify this source code under
+ * the terms of the GPL-3.0 license that can be found in the LICENSE file.
+ *
+ * Measurements follow Dia's chat: 15px body, 17px bubbles, 10px cards, pill
+ * controls. The font is the system font. */
+
+:root {
+  color-scheme: light dark;
+  --surface-page: light-dark(#f3f3f3, #202020);
+  --surface-raised: light-dark(#fff, #2c2c2c);
+  --text: light-dark(rgb(0 0 0 / 85%), rgb(255 255 255 / 85%));
+  --text-muted: color-mix(in srgb, CanvasText 60%, var(--surface-page));
+  --text-faint: color-mix(in srgb, CanvasText 30%, var(--surface-page));
+  --bubble: color-mix(in srgb, CanvasText 8%, var(--surface-page));
+  --token: color-mix(in srgb, CanvasText 5%, var(--surface-page));
+  --token-hover: color-mix(in srgb, CanvasText 9%, var(--surface-page));
+  --hairline: light-dark(rgb(0 0 0 / 8%), rgb(255 255 255 / 10%));
+  --accent: #fcbf49;
+  --accent-text: #2a2000;
+  --error: light-dark(#c1575c, #cc4a55);
+  --radius-bubble: 17px;
+  --radius-card: 10px;
+  --column: 720px;
+  font: 15px/1.5 system-ui, -apple-system, sans-serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  background: var(--surface-page);
+  color: var(--text);
+  height: 100%;
+  margin: 0;
+}
+
+.app {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+}
+
+button {
+  color: inherit;
+  cursor: pointer;
+  font: inherit;
+}
+
+button:focus-visible,
+textarea:focus-visible,
+a:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+/* Header */
+
+.header {
+  align-items: center;
+  display: flex;
+  flex: none;
+  gap: 4px;
+  height: 44px;
+  padding: 0 10px 0 14px;
+}
+
+.spacer {
+  flex: 1;
+}
+
+.chip {
+  background: var(--token);
+  border: 0;
+  border-radius: 999px;
+  color: var(--text-muted);
+  font-size: 13px;
+  max-width: 70%;
+  overflow: hidden;
+  padding: 4px 12px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.chip:hover {
+  background: var(--token-hover);
+}
+
+.icon-button {
+  align-items: center;
+  background: none;
+  border: 0;
+  border-radius: 8px;
+  color: var(--text-faint);
+  display: flex;
+  height: 28px;
+  justify-content: center;
+  width: 28px;
+}
+
+.icon-button:hover {
+  background: light-dark(rgb(0 0 0 / 5%), rgb(255 255 255 / 5%));
+  color: color-mix(in srgb, CanvasText 85%, var(--surface-page));
+}
+
+svg {
+  fill: none;
+  height: 18px;
+  stroke: currentcolor;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 1.6;
+  width: 18px;
+}
+
+/* Thread */
+
+.scroll {
+  flex: 1;
+  overflow-y: auto;
+  padding: 8px 16px 16px;
+}
+
+.thread,
+.empty,
+.setup {
+  margin: 0 auto;
+  max-width: var(--column);
+}
+
+.thread {
+  display: flex;
+  flex-direction: column;
+  gap: 22px;
+}
+
+.message-user {
+  align-self: flex-end;
+  background: var(--bubble);
+  border-radius: var(--radius-bubble);
+  font-size: 14px;
+  max-width: 80%;
+  overflow-wrap: anywhere;
+  padding: 14px 16px;
+  white-space: pre-wrap;
+}
+
+.message-assistant {
+  overflow-wrap: anywhere;
+}
+
+.message-assistant > :first-child {
+  margin-top: 0;
+}
+
+.message-assistant > :last-child {
+  margin-bottom: 0;
+}
+
+.message-assistant p {
+  margin: 0 0 14px;
+}
+
+.message-assistant h1,
+.message-assistant h2,
+.message-assistant h3,
+.message-assistant h4 {
+  font-weight: 600;
+  line-height: 1.3;
+  margin: 18px 0 8px;
+}
+
+.message-assistant h1 {
+  font-size: 22px;
+  font-weight: 500;
+}
+
+.message-assistant h2 {
+  font-size: 17px;
+}
+
+.message-assistant h3 {
+  font-size: 16px;
+}
+
+.message-assistant h4 {
+  font-size: 15px;
+  font-weight: 500;
+}
+
+.message-assistant ul,
+.message-assistant ol {
+  margin: 0 0 14px;
+  padding-inline-start: 22px;
+}
+
+.message-assistant li {
+  margin: 6px 0;
+}
+
+.message-assistant blockquote {
+  border-inline-start: 2px solid var(--hairline);
+  color: var(--text-muted);
+  margin: 0 0 14px;
+  padding-inline-start: 12px;
+}
+
+.message-assistant hr {
+  border: 0;
+  border-top: 1px solid var(--hairline);
+  margin: 16px 0;
+}
+
+.message-assistant a {
+  color: light-dark(#3a88c4, #5aaee0);
+}
+
+.message-assistant code {
+  background: var(--token);
+  border-radius: 5px;
+  font: 14px ui-monospace, 'SF Mono', Menlo, monospace;
+  padding: 1px 5px;
+}
+
+.message-assistant pre {
+  background: var(--surface-raised);
+  border-radius: 12px;
+  margin: 0 0 14px;
+  overflow-x: auto;
+  padding: 12px 14px;
+}
+
+.message-assistant pre code {
+  background: none;
+  padding: 0;
+}
+
+.message-error {
+  background: color-mix(in srgb, var(--error) 12%, var(--surface-page));
+  border-radius: var(--radius-card);
+  color: var(--error);
+  font-size: 14px;
+  margin-top: 10px;
+  padding: 10px 12px;
+}
+
+.message-error button {
+  background: none;
+  border: 0;
+  color: inherit;
+  display: block;
+  font-size: 13px;
+  font-weight: 500;
+  margin-top: 6px;
+  padding: 0;
+  text-decoration: underline;
+}
+
+.message-actions {
+  display: flex;
+  gap: 4px;
+  margin-top: 6px;
+}
+
+.message-actions button {
+  background: none;
+  border: 0;
+  border-radius: 6px;
+  color: var(--text-faint);
+  font-size: 12px;
+  padding: 2px 6px;
+}
+
+.message-actions button:hover {
+  background: var(--token);
+  color: var(--text-muted);
+}
+
+/* The only looping animation: shown while waiting for the first token. */
+.thinking {
+  color: var(--text-muted);
+  font-size: 13px;
+}
+
+.thinking::before {
+  background: linear-gradient(
+      90deg, var(--text-faint), var(--text), var(--text-faint)) 0 0 / 200% 100%;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  content: attr(data-text);
+  animation: shimmer 1.6s linear infinite;
+}
+
+@keyframes shimmer {
+  to {
+    background-position: -200% 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .thinking::before {
+    animation: none;
+    color: var(--text-muted);
+  }
+}
+
+/* Empty state and setup */
+
+.empty {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding-top: 18vh;
+  text-align: center;
+}
+
+.empty h1 {
+  font-size: 22px;
+  font-weight: 500;
+  margin: 0;
+}
+
+.orb {
+  background: radial-gradient(circle at 35% 30%, #ffe3a3, var(--accent));
+  border-radius: 50%;
+  height: 24px;
+  width: 24px;
+}
+
+.setup {
+  background: var(--surface-raised);
+  border-radius: var(--radius-card);
+  margin-top: 8vh;
+  padding: 20px;
+}
+
+.setup h2 {
+  font-size: 17px;
+  font-weight: 600;
+  margin: 0 0 8px;
+}
+
+.setup p {
+  color: var(--text-muted);
+  font-size: 14px;
+  margin: 0 0 16px;
+}
+
+.pill-button {
+  background: var(--accent);
+  border: 0;
+  border-radius: 999px;
+  color: var(--accent-text);
+  font-weight: 500;
+  padding: 7px 16px;
+}
+
+/* Composer */
+
+.composer-wrap {
+  flex: none;
+  padding: 0 12px 12px;
+}
+
+.composer {
+  align-items: flex-end;
+  background: var(--surface-raised);
+  border-radius: var(--radius-bubble);
+  box-shadow: 0 0 0 0.5px var(--hairline), 0 1px 3px rgb(0 0 0 / 8%);
+  display: flex;
+  gap: 8px;
+  margin: 0 auto;
+  max-width: var(--column);
+  padding: 10px 10px 10px 16px;
+}
+
+.composer:focus-within {
+  box-shadow: 0 0 0 1.5px var(--accent), 0 1px 3px rgb(0 0 0 / 8%);
+}
+
+textarea {
+  background: none;
+  border: 0;
+  color: inherit;
+  flex: 1;
+  font: inherit;
+  max-height: 200px;
+  min-height: 24px;
+  outline: none !important;
+  padding: 3px 0;
+  resize: none;
+}
+
+textarea::placeholder {
+  color: var(--text-faint);
+}
+
+.send {
+  align-items: center;
+  background: var(--accent);
+  border: 0;
+  border-radius: 50%;
+  color: var(--accent-text);
+  display: flex;
+  flex: none;
+  height: 28px;
+  justify-content: center;
+  width: 28px;
+}
+
+.send:disabled {
+  background: var(--token);
+  color: var(--text-faint);
+  cursor: default;
+}
+
+.send[hidden] {
+  display: none;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+/* Full-page chat, opened from the new tab page. */
+body[data-mode='page'] .header {
+  padding-inline: 24px;
+}
+
+body[data-mode='page'] .empty {
+  padding-top: 24vh;
+}

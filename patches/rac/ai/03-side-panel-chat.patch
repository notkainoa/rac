+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// A small Markdown renderer for assistant replies. It builds DOM nodes with
+// textContent only, never parses HTML, never loads images, and sends link
+// clicks to the browser. A reply can't run script or fetch anything through
+// this code, whatever it contains.
+
+export type LinkHandler = (url: string) => void;
+
+const INLINE_PATTERN =
+    /(`[^`\n]+`)|(\*\*[^*\n]+\*\*)|(__[^_\n]+__)|(\*[^*\s][^*\n]*\*)|(\[[^\]\n]+\]\([^)\s]+\))|(https?:\/\/[^\s<>)\]]+)/g;
+
+function safeUrl(raw: string): string|null {
+  try {
+    const url = new URL(raw);
+    return url.protocol === 'https:' || url.protocol === 'http:' ? url.href :
+                                                                   null;
+  } catch {
+    return null;
+  }
+}
+
+function makeLink(label: string, raw: string, onLink: LinkHandler): Node {
+  const href = safeUrl(raw);
+  if (!href) {
+    return document.createTextNode(label);
+  }
+  const anchor = document.createElement('a');
+  anchor.textContent = label;
+  anchor.href = '#';
+  anchor.title = href;
+  anchor.addEventListener('click', (event: Event) => {
+    event.preventDefault();
+    onLink(href);
+  });
+  return anchor;
+}
+
+function appendInline(parent: Node, text: string, onLink: LinkHandler) {
+  let last = 0;
+  for (const match of text.matchAll(INLINE_PATTERN)) {
+    const index = match.index ?? 0;
+    if (index > last) {
+      parent.appendChild(document.createTextNode(text.slice(last, index)));
+    }
+    const token = match[0];
+    if (match[1]) {
+      const code = document.createElement('code');
+      code.textContent = token.slice(1, -1);
+      parent.appendChild(code);
+    } else if (match[2] || match[3]) {
+      const strong = document.createElement('strong');
+      appendInline(strong, token.slice(2, -2), onLink);
+      parent.appendChild(strong);
+    } else if (match[4]) {
+      const em = document.createElement('em');
+      appendInline(em, token.slice(1, -1), onLink);
+      parent.appendChild(em);
+    } else if (match[5]) {
+      const close = token.indexOf('](');
+      parent.appendChild(makeLink(
+          token.slice(1, close), token.slice(close + 2, -1), onLink));
+    } else {
+      // A bare address may end in punctuation that belongs to the sentence.
+      const trimmed = token.replace(/[.,;:!?]+$/, '');
+      parent.appendChild(makeLink(trimmed, trimmed, onLink));
+      if (trimmed.length < token.length) {
+        parent.appendChild(
+            document.createTextNode(token.slice(trimmed.length)));
+      }
+    }
+    last = index + token.length;
+  }
+  if (last < text.length) {
+    parent.appendChild(document.createTextNode(text.slice(last)));
+  }
+}
+
+const HEADING = /^(#{1,4})\s+(.*)$/;
+const BULLET = /^\s*[-*+]\s+(.*)$/;
+const NUMBERED = /^\s*\d+[.)]\s+(.*)$/;
+const QUOTE = /^>\s?(.*)$/;
+const RULE = /^\s*([-*_])(\s*\1){2,}\s*$/;
+const FENCE = /^\s*```/;
+
+function isBlockStart(line: string): boolean {
+  return HEADING.test(line) || BULLET.test(line) || NUMBERED.test(line) ||
+      QUOTE.test(line) || FENCE.test(line) || RULE.test(line);
+}
+
+export function renderMarkdown(
+    source: string, onLink: LinkHandler): DocumentFragment {
+  const fragment = document.createDocumentFragment();
+  const lines = source.replace(/\r\n?/g, '\n').split('\n');
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i] ?? '';
+    if (line.trim() === '') {
+      i++;
+      continue;
+    }
+
+    if (FENCE.test(line)) {
+      const body: string[] = [];
+      i++;
+      // An unclosed fence is normal while a reply is still streaming.
+      while (i < lines.length && !FENCE.test(lines[i] ?? '')) {
+        body.push(lines[i] ?? '');
+        i++;
+      }
+      i++;
+      const pre = document.createElement('pre');
+      const code = document.createElement('code');
+      code.textContent = body.join('\n');
+      pre.appendChild(code);
+      fragment.appendChild(pre);
+      continue;
+    }
+
+    const heading = HEADING.exec(line);
+    if (heading) {
+      const level = (heading[1] ?? '#').length;
+      const element = document.createElement(`h${level}`);
+      appendInline(element, heading[2] ?? '', onLink);
+      fragment.appendChild(element);
+      i++;
+      continue;
+    }
+
+    if (RULE.test(line)) {
+      fragment.appendChild(document.createElement('hr'));
+      i++;
+      continue;
+    }
+
+    const listPattern = BULLET.test(line) ? BULLET :
+        NUMBERED.test(line)               ? NUMBERED :
+                                            null;
+    if (listPattern) {
+      const list = document.createElement(listPattern === BULLET ? 'ul' : 'ol');
+      while (i < lines.length) {
+        const item = listPattern.exec(lines[i] ?? '');
+        if (!item) {
+          break;
+        }
+        const li = document.createElement('li');
+        appendInline(li, item[1] ?? '', onLink);
+        list.appendChild(li);
+        i++;
+      }
+      fragment.appendChild(list);
+      continue;
+    }
+
+    if (QUOTE.test(line)) {
+      const quote = document.createElement('blockquote');
+      const parts: string[] = [];
+      while (i < lines.length) {
+        const match = QUOTE.exec(lines[i] ?? '');
+        if (!match) {
+          break;
+        }
+        parts.push(match[1] ?? '');
+        i++;
+      }
+      appendInline(quote, parts.join(' '), onLink);
+      fragment.appendChild(quote);
+      continue;
+    }
+
+    const parts: string[] = [];
+    while (i < lines.length && (lines[i] ?? '').trim() !== '' &&
+           !(parts.length > 0 && isBlockStart(lines[i] ?? ''))) {
+      parts.push((lines[i] ?? '').trim());
+      i++;
+    }
+    const paragraph = document.createElement('p');
+    appendInline(paragraph, parts.join(' '), onLink);
+    fragment.appendChild(paragraph);
+  }
+  return fragment;
+}

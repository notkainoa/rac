+std::unique_ptr<views::View> CreateView(SidePanelEntryScope& scope) {
+  BrowserWindowInterface& browser = scope.GetBrowserWindowInterface();
+  return std::make_unique<AssistantWebView>(browser.GetProfile(), &browser);
+}
+
+// Registers and removes the entry as the pref changes. It deletes itself
+// when its window closes.
+class EntryRegistrar {
+ public:
+  EntryRegistrar(BrowserWindowInterface* browser, SidePanelRegistry* registry)
+      : browser_(browser), registry_(registry) {
+    close_subscription_ = browser_->RegisterBrowserDidClose(base::BindRepeating(
+        [](EntryRegistrar* self, BrowserWindowInterface*) { delete self; },
+        base::Unretained(this)));
+    pref_registrar_.Init(browser_->GetProfile()->GetPrefs());
+    pref_registrar_.Add(kEnabled, base::BindRepeating(&EntryRegistrar::Update,
+                                                      base::Unretained(this)));
+    Update();
+  }
+
+  EntryRegistrar(const EntryRegistrar&) = delete;
+  EntryRegistrar& operator=(const EntryRegistrar&) = delete;
+
+ private:
+  ~EntryRegistrar() = default;
+
+  void Update() {
+    const SidePanelEntry::Key key(SidePanelEntry::Id::kRacAi);
+    const bool enabled =
+        browser_->GetProfile()->GetPrefs()->GetBoolean(kEnabled);
+    const bool registered = registry_->GetEntryForKey(key) != nullptr;
+    if (enabled && !registered) {
+      registry_->Register(std::make_unique<SidePanelEntry>(
+          key, base::BindRepeating(&CreateView),
+          base::BindRepeating([] { return kDefaultWidth; })));
+    } else if (!enabled && registered) {
+      if (SidePanelUI* ui = SidePanelUI::From(browser_);
+          ui && ui->IsSidePanelEntryShowing(key)) {
+        ui->Close();
+      }
+      registry_->Deregister(key);
+    }
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<SidePanelRegistry> registry_;
+  PrefChangeRegistrar pref_registrar_;
+  base::CallbackListSubscription close_subscription_;
+};
+
+}  // namespace
+
+void RegisterAssistantSidePanel(BrowserWindowInterface* browser,
+                                SidePanelRegistry* registry) {
+  if (!browser->GetProfile()->IsRegularProfile() ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return;
+  }
+  // Owns itself; see EntryRegistrar.
+  new EntryRegistrar(browser, registry);
+}
+
+}  // namespace rac::ai

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_ACP_AGENT_SIGN_IN_H_
+#define CHROME_BROWSER_RAC_AI_ACP_AGENT_SIGN_IN_H_
+
+#include <set>
+#include <string>
+#include <string_view>
+
+namespace rac::ai {
+
+// How an agent's run ended, as far as signing in goes.
+enum class AgentRunOutcome {
+  // The prompt finished without an error.
+  kSucceeded,
+  // The agent answered ACP's auth_required (-32000) on session/new or on
+  // the prompt. Nothing else counts: a crash, a timeout, a rate limit, or
+  // Stop says nothing about signing in.
+  kNeedsSignIn,
+  // Anything else.
+  kOther,
+};
+
+// The agents whose last run said the user isn't signed in, so Settings and
+// the chat's model menu can say "Sign in to use" before the next try. It
+// holds agent ids only, never the agent's words, and lives in memory with
+// the profile's AcpService: it goes when AI turns off or the browser quits.
+//
+// Signing in happens in Terminal, where rac can't see it, so nothing here
+// is proof either way. A mark goes once a run of that agent succeeds, when
+// the user asks to check again, or when they change what runs for it (its
+// path or command).
+class AgentSignInMemory {
+ public:
+  AgentSignInMemory();
+  AgentSignInMemory(const AgentSignInMemory&) = delete;
+  AgentSignInMemory& operator=(const AgentSignInMemory&) = delete;
+  ~AgentSignInMemory();
+
+  // Each of these returns whether what it remembers changed.
+  bool OnRunEnded(std::string_view agent_id, AgentRunOutcome outcome);
+  bool Forget(std::string_view agent_id);
+  bool ForgetAll();
+
+  bool NeedsSignIn(std::string_view agent_id) const;
+
+ private:
+  std::set<std::string, std::less<>> agents_;
+};
+
+// The command that signs in to `agent_id`, like "codex login", when its
+// recipe's sign-in help is one (a few lowercase words). Empty when the help
+// is prose ("Configure the Goose CLI") or there is none (Custom).
+std::string AgentSignInCommand(std::string_view agent_id);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_ACP_AGENT_SIGN_IN_H_

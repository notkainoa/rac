+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/acp/agent_sign_in.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "base/strings/string_split.h"
+#include "chrome/browser/rac/ai/acp/agent_recipes.h"
+
+namespace rac::ai {
+namespace {
+
+bool IsCommandWord(std::string_view word) {
+  return !word.empty() && std::ranges::all_of(word, [](char c) {
+    return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-';
+  });
+}
+
+}  // namespace
+
+AgentSignInMemory::AgentSignInMemory() = default;
+AgentSignInMemory::~AgentSignInMemory() = default;
+
+bool AgentSignInMemory::OnRunEnded(std::string_view agent_id,
+                                   AgentRunOutcome outcome) {
+  switch (outcome) {
+    case AgentRunOutcome::kNeedsSignIn:
+      return agents_.emplace(agent_id).second;
+    case AgentRunOutcome::kSucceeded:
+      return Forget(agent_id);
+    case AgentRunOutcome::kOther:
+      return false;
+  }
+}
+
+bool AgentSignInMemory::Forget(std::string_view agent_id) {
+  const auto it = agents_.find(agent_id);
+  if (it == agents_.end()) {
+    return false;
+  }
+  agents_.erase(it);
+  return true;
+}
+
+bool AgentSignInMemory::ForgetAll() {
+  const bool had_any = !agents_.empty();
+  agents_.clear();
+  return had_any;
+}
+
+bool AgentSignInMemory::NeedsSignIn(std::string_view agent_id) const {
+  return agents_.contains(agent_id);
+}
+
+std::string AgentSignInCommand(std::string_view agent_id) {
+  const AgentRecipe* recipe = FindAgentRecipe(agent_id);
+  if (!recipe) {
+    return std::string();
+  }
+  const std::string_view help = recipe->auth_help;
+  const std::vector<std::string_view> words = base::SplitStringPiece(
+      help, " ", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (help.empty() || words.size() > 3 ||
+      !std::ranges::all_of(words, &IsCommandWord)) {
+    return std::string();
+  }
+  return std::string(help);
+}
+
+}  // namespace rac::ai

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/acp/agent_sign_in.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+TEST(RacAgentSignInTest, StartsKnowingNothing) {
+  AgentSignInMemory memory;
+  EXPECT_FALSE(memory.NeedsSignIn("claude"));
+  EXPECT_FALSE(memory.ForgetAll());
+}
+
+TEST(RacAgentSignInTest, AuthRequiredMarksOnlyThatAgent) {
+  AgentSignInMemory memory;
+  EXPECT_TRUE(memory.OnRunEnded("claude", AgentRunOutcome::kNeedsSignIn));
+  EXPECT_TRUE(memory.NeedsSignIn("claude"));
+  EXPECT_FALSE(memory.NeedsSignIn("codex"));
+  // Saying it again changes nothing.
+  EXPECT_FALSE(memory.OnRunEnded("claude", AgentRunOutcome::kNeedsSignIn));
+  EXPECT_TRUE(memory.NeedsSignIn("claude"));
+}
+
+// A crash, a timeout, a rate limit or Stop says nothing about signing in,
+// so it neither marks an agent nor clears one.
+TEST(RacAgentSignInTest, OtherEndingsLeaveTheMarkAsItIs) {
+  AgentSignInMemory memory;
+  EXPECT_FALSE(memory.OnRunEnded("codex", AgentRunOutcome::kOther));
+  EXPECT_FALSE(memory.NeedsSignIn("codex"));
+  memory.OnRunEnded("claude", AgentRunOutcome::kNeedsSignIn);
+  EXPECT_FALSE(memory.OnRunEnded("claude", AgentRunOutcome::kOther));
+  EXPECT_TRUE(memory.NeedsSignIn("claude"));
+}
+
+TEST(RacAgentSignInTest, ASuccessfulRunClearsIt) {
+  AgentSignInMemory memory;
+  memory.OnRunEnded("claude", AgentRunOutcome::kNeedsSignIn);
+  memory.OnRunEnded("codex", AgentRunOutcome::kNeedsSignIn);
+  EXPECT_TRUE(memory.OnRunEnded("claude", AgentRunOutcome::kSucceeded));
+  EXPECT_FALSE(memory.NeedsSignIn("claude"));
+  EXPECT_TRUE(memory.NeedsSignIn("codex"));
+  EXPECT_FALSE(memory.OnRunEnded("claude", AgentRunOutcome::kSucceeded));
+}
+
+// A new path or command is a different program, which may be signed in.
+TEST(RacAgentSignInTest, ForgettingOneAgentKeepsTheOthers) {
+  AgentSignInMemory memory;
+  memory.OnRunEnded("cursor", AgentRunOutcome::kNeedsSignIn);
+  memory.OnRunEnded("custom", AgentRunOutcome::kNeedsSignIn);
+  EXPECT_TRUE(memory.Forget("cursor"));
+  EXPECT_FALSE(memory.Forget("cursor"));
+  EXPECT_FALSE(memory.NeedsSignIn("cursor"));
+  EXPECT_TRUE(memory.NeedsSignIn("custom"));
+}
+
+// "Check again" is the user saying they fixed it.
+TEST(RacAgentSignInTest, CheckingAgainForgetsEveryAgent) {
+  AgentSignInMemory memory;
+  memory.OnRunEnded("cursor", AgentRunOutcome::kNeedsSignIn);
+  memory.OnRunEnded("claude", AgentRunOutcome::kNeedsSignIn);
+  EXPECT_TRUE(memory.ForgetAll());
+  EXPECT_FALSE(memory.NeedsSignIn("cursor"));
+  EXPECT_FALSE(memory.NeedsSignIn("claude"));
+  EXPECT_FALSE(memory.ForgetAll());
+}
+
+TEST(RacAgentSignInTest, OnlyACommandIsOfferedToRun) {
+  EXPECT_EQ(AgentSignInCommand("codex"), "codex login");
+  EXPECT_EQ(AgentSignInCommand("claude"), "claude auth login");
+  EXPECT_EQ(AgentSignInCommand("cursor"), "cursor-agent login");
+  // Prose isn't a command.
+  EXPECT_EQ(AgentSignInCommand("gemini"), "");
+  EXPECT_EQ(AgentSignInCommand("goose"), "");
+  EXPECT_EQ(AgentSignInCommand("custom"), "");
+  EXPECT_EQ(AgentSignInCommand("nope"), "");
+}
+
+}  // namespace
+}  // namespace rac::ai

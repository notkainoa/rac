+bool HasInteractiveDescendant(const proto::ContentNode& node, int depth = 0) {
+  if (depth > kMaxDepth) {
+    return false;
+  }
+  for (const auto& child : node.children_nodes()) {
+    if (IsAgentNodeExcluded(child)) {
+      continue;

+TEST(SnapshotSerializerTest, RowsCellsAndDialogsKeepTheirControlsReachable) {
+  auto page = MakePage();
+  auto* root = page.mutable_root_node();
+  // <tr> styled with tr:hover, holding a link in a cell.
+  auto* table = Node(root, proto::CONTENT_ATTRIBUTE_TABLE);
+  auto* row = Node(table, proto::CONTENT_ATTRIBUTE_TABLE_ROW);
+  DomId(row, 71);
+  Visible(row);
+  AddReason(row, proto::CLICKABILITY_REASON_HOVER_PSEUDO_CLASS);
+  auto* cell = Node(row, proto::CONTENT_ATTRIBUTE_TABLE_CELL);
+  DomId(cell, 72);
+  Visible(cell);
+  AddReason(cell, proto::CLICKABILITY_REASON_HOVER_PSEUDO_CLASS);
+  auto* link = Node(cell, proto::CONTENT_ATTRIBUTE_ANCHOR);
+  DomId(link, 73);
+  Visible(link);
+  link->mutable_content_attributes()->mutable_anchor_data()->set_url(
+      "https://example.com/invoice/7");
+  AddText(link, "Invoice 7");
+  AddText(cell, "Paid");
+  // A <dialog> with its own keydown listener, holding a text field.
+  auto* dialog = Node(root, proto::CONTENT_ATTRIBUTE_DIALOG_MODAL);
+  DomId(dialog, 74);
+  Visible(dialog);
+  AddReason(dialog, proto::CLICKABILITY_REASON_KEY_EVENTS);
+  AddText(dialog, "Rename");
+  auto* field = Node(dialog, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  DomId(field, 75);
+  Visible(field);
+  field->mutable_content_attributes()->set_label("New name");
+  field->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_form_control_type(proto::FORM_CONTROL_TYPE_INPUT_TEXT);
+  // A row whose own click opens it, with nothing interactive inside, is still
+  // a target.
+  auto* clickable_row = Node(table, proto::CONTENT_ATTRIBUTE_TABLE_ROW);
+  DomId(clickable_row, 76);
+  Visible(clickable_row);
+  AddReason(clickable_row, proto::CLICKABILITY_REASON_CLICK_HANDLER);
+  AddText(Node(clickable_row, proto::CONTENT_ATTRIBUTE_TABLE_CELL),
+          "Invoice 8");
+  // A leaf keeps the old rule: any reason makes it a target.
+  auto* image = Node(root, proto::CONTENT_ATTRIBUTE_IMAGE);
+  DomId(image, 77);
+  Visible(image);
+  image->mutable_content_attributes()->set_label("Avatar");
+  AddReason(image, proto::CLICKABILITY_REASON_HOVER_PSEUDO_CLASS);
+
+  RefTable refs;
+  auto snapshot = SerializeAgentSnapshot(page, refs, SnapshotOptions(), 1);
+  EXPECT_NE(snapshot.text.find("- link \"Invoice 7\""), std::string::npos)
+      << snapshot.text;
+  EXPECT_EQ(snapshot.text.find("button \"Invoice 7"), std::string::npos)
+      << snapshot.text;
+  EXPECT_NE(snapshot.text.find("- textbox \"New name\""), std::string::npos)
+      << snapshot.text;
+  EXPECT_EQ(snapshot.text.find("button \"Rename"), std::string::npos)
+      << snapshot.text;
+  EXPECT_NE(snapshot.text.find("- button \"Invoice 8\""), std::string::npos)
+      << snapshot.text;
+  EXPECT_NE(snapshot.text.find("- button \"Avatar\""), std::string::npos)
+      << snapshot.text;
+}

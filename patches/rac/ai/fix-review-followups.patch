+TEST(SnapshotSerializerTest, LongPagesNeverEvictPrintedRefs) {
+  auto page = MakePage();
+  auto* root = page.mutable_root_node();
+  auto add_button = [&](int id, bool visible) {
+    auto* node = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+    DomId(node, id);
+    if (visible) {
+      Visible(node);
+    } else {
+      Offscreen(node);
+    }
+    node->mutable_content_attributes()->set_label("Item " +
+                                                  base::NumberToString(id));
+    node->mutable_content_attributes()
+        ->mutable_form_control_data()
+        ->set_form_control_type(proto::FORM_CONTROL_TYPE_BUTTON_BUTTON);
+  };
+  for (int id = 1; id <= 5; ++id) {
+    add_button(id, /*visible=*/true);
+  }
+  // Far more offscreen targets than the table's hard cap (4 * 4).
+  for (int id = 6; id <= 80; ++id) {
+    add_button(id, /*visible=*/false);
+  }
+  RefTable refs(4);
+  auto snapshot = SerializeAgentSnapshot(page, refs, SnapshotOptions(), 1);
+  int printed = 0;
+  for (const auto& line : snapshot.lines) {
+    if (line.ref.empty()) {
+      continue;
+    }
+    ++printed;
+    EXPECT_NE(refs.Lookup(line.ref), nullptr) << line.ref;
+  }
+  EXPECT_EQ(printed, 5) << snapshot.text;
+}

+    switch (child.content_attributes().attribute_type()) {
+      case proto::CONTENT_ATTRIBUTE_ANCHOR:
+      case proto::CONTENT_ATTRIBUTE_FORM_CONTROL:
+      case proto::CONTENT_ATTRIBUTE_IFRAME:
+        return true;
+      default:

+// A long page gives every offscreen target a ref without using the snapshot
+// budget, so the table can reach its hard cap while every entry is in the
+// snapshot being built. Then the refs already printed must stay.
+TEST(RefTableTest, EvictionAtTheHardCapKeepsPrintedRefs) {
+  RefTable refs(4);  // Hard cap: 16.
+  RefEntry meta;
+  refs.BeginSnapshot("t1", 1);
+  std::vector<std::string> shown;
+  for (int id = 1; id <= 6; ++id) {
+    shown.push_back(refs.GetOrCreate(
+        {.tab_id = "t1", .document_token = "d", .dom_node_id = id}, meta));
+    refs.MarkSeen(shown.back(), /*in_viewport=*/true);
+    refs.MarkShown(shown.back());
+  }
+  for (int id = 7; id <= 60; ++id) {
+    const std::string ref = refs.GetOrCreate(
+        {.tab_id = "t1", .document_token = "d", .dom_node_id = id}, meta);
+    refs.MarkSeen(ref, /*in_viewport=*/false);
+  }
+  for (const auto& ref : shown) {
+    EXPECT_NE(refs.Lookup(ref), nullptr) << ref;
+  }
+  EXPECT_LE(refs.size(), 16u);
+  refs.EndSnapshot("t1");
+
+  // The next snapshot starts over: those refs are no longer protected.
+  refs.BeginSnapshot("t1", 2);
+  EXPECT_FALSE(refs.Lookup(shown[0])->shown_in_latest);
+}

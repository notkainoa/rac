+// Clickability reasons that mean a click on the node itself does something.
+// A :hover style, a hover or key listener, or a tabindex (often -1 on a
+// focus-managed wrapper) also mark a node clickable, but on a container they
+// usually just mean a wrapper.
+bool HasActivationSignal(const proto::ContentNode& node) {
+  const auto& a = node.content_attributes();
+  if (!a.has_interaction_info()) {
+    return false;
+  }
+  const auto& info = a.interaction_info();
+  if (info.is_clickable()) {
+    return true;
+  }
+  for (int reason : info.clickability_reasons()) {
+    switch (static_cast<proto::ClickabilityReason>(reason)) {
+      case proto::CLICKABILITY_REASON_CLICKABLE_CONTROL:
+      case proto::CLICKABILITY_REASON_CLICK_HANDLER:
+      case proto::CLICKABILITY_REASON_MOUSE_CLICK:
+      case proto::CLICKABILITY_REASON_CURSOR_POINTER:
+      case proto::CLICKABILITY_REASON_ARIA_ROLE:
+      case proto::CLICKABILITY_REASON_ARIA_HAS_POPUP:
+      case proto::CLICKABILITY_REASON_ARIA_EXPANDED_TRUE:
+      case proto::CLICKABILITY_REASON_ARIA_EXPANDED_FALSE:
+      case proto::CLICKABILITY_REASON_ARIA_TOGGLE:
+      case proto::CLICKABILITY_REASON_ARIA_SELECTABLE:
+        return true;
+      default:
+        break;
+    }
+  }
+  return false;
+}

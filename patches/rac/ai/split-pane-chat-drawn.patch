+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_draw_hold.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+
+namespace rac::ai {
+
+ChatDrawHold::ChatDrawHold(TakeHold take_hold,
+                           AwaitsVisible awaits_visible,
+                           scoped_refptr<base::SequencedTaskRunner> task_runner)
+    : take_hold_(std::move(take_hold)),
+      awaits_visible_(std::move(awaits_visible)),
+      task_runner_(std::move(task_runner)) {
+  cap_timer_.SetTaskRunner(task_runner_);
+}
+
+ChatDrawHold::~ChatDrawHold() {
+  Drop("the page ended");
+}
+
+void ChatDrawHold::Keep(bool keep) {
+  if (keep) {
+    keep_ = true;
+    waiting_ = false;
+    cap_timer_.Stop();
+    if (!hold_) {
+      hold_ = take_hold_.Run();
+      VLOG(1) << "rac assistant: draw hold taken";
+    }
+    return;
+  }
+  if (!keep_) {
+    return;
+  }
+  keep_ = false;
+  if (!hold_) {
+    return;
+  }
+  task_runner_->PostTask(FROM_HERE, base::BindOnce(&ChatDrawHold::Release,
+                                                   weak_factory_.GetWeakPtr()));
+  cap_timer_.Start(
+      FROM_HERE, kChatDrawHoldCap,
+      base::BindOnce(&ChatDrawHold::Drop, base::Unretained(this), "the cap"));
+}
+
+void ChatDrawHold::OnVisible() {
+  if (!waiting_) {
+    return;
+  }
+  waiting_ = false;
+  task_runner_->PostTask(FROM_HERE, base::BindOnce(&ChatDrawHold::Release,
+                                                   weak_factory_.GetWeakPtr()));
+}
+
+void ChatDrawHold::Release() {
+  if (keep_ || !hold_) {
+    return;
+  }
+  if (awaits_visible_.Run()) {
+    waiting_ = true;
+    return;
+  }
+  Drop("the page is visible");
+}
+
+void ChatDrawHold::Drop(const char* why) {
+  cap_timer_.Stop();
+  waiting_ = false;
+  if (hold_) {
+    hold_.RunAndReset();
+    VLOG(1) << "rac assistant: draw hold released (" << why << ")";
+  }
+}
+
+}  // namespace rac::ai

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_CHAT_DRAW_HOLD_H_
+#define CHROME_BROWSER_RAC_AI_CHAT_DRAW_HOLD_H_
+
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace rac::ai {
+
+// The longest a hold outlives its condition. A page that is showing becomes
+// visible within a moment, but never while its window is occluded or
+// minimized, and a hold that waited on that would keep the page drawing for as
+// long as the window stays hidden.
+inline constexpr base::TimeDelta kChatDrawHoldCap = base::Seconds(5);
+
+// Keeps the window's chat page drawing while no view shows it (see
+// KeepsChatPageDrawn()), and lets go in a way that never strands the hold.
+//
+// A returning view shows the page in the same task as the tab switch, but the
+// page counts as visible only a moment later, and letting go before then
+// hides it again and drops the frame it kept. So letting go takes a task, then
+// waits for the page to be visible if it is showing, and a timer ends the wait
+// at the cap. At most one hold is taken at a time, and it is let go when this
+// is destroyed.
+class ChatDrawHold {
+ public:
+  // Takes one hold on the page. The hold ends when the runner is destroyed.
+  using TakeHold = base::RepeatingCallback<base::ScopedClosureRunner()>;
+  // Whether the page is showing in a view but isn't visible yet.
+  using AwaitsVisible = base::RepeatingCallback<bool()>;
+
+  ChatDrawHold(TakeHold take_hold,
+               AwaitsVisible awaits_visible,
+               scoped_refptr<base::SequencedTaskRunner> task_runner =
+                   base::SequencedTaskRunner::GetCurrentDefault());
+  ChatDrawHold(const ChatDrawHold&) = delete;
+  ChatDrawHold& operator=(const ChatDrawHold&) = delete;
+  ~ChatDrawHold();
+
+  // While `keep`, the page has a hold. Keep(false) starts to let go; a later
+  // Keep(true) cancels that.
+  void Keep(bool keep);
+
+  // The page became visible.
+  void OnVisible();
+
+  // Whether the page has a hold now.
+  bool held() const { return !!hold_; }
+
+ private:
+  void Release();
+  void Drop(const char* why);
+
+  const TakeHold take_hold_;
+  const AwaitsVisible awaits_visible_;
+  const scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  base::ScopedClosureRunner hold_;
+  // The last Keep() was true.
+  bool keep_ = false;
+  // Letting go waits for OnVisible().
+  bool waiting_ = false;
+  base::OneShotTimer cap_timer_;
+  base::WeakPtrFactory<ChatDrawHold> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CHAT_DRAW_HOLD_H_

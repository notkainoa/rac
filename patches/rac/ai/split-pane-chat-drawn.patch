+namespace rac::ai {
+namespace {
+
+// A stand-in for the page: counts the holds on it and says whether it is
+// showing in a view without being visible yet.
+class RacAiChatDrawHoldTest : public testing::Test {
+ protected:
+  std::unique_ptr<ChatDrawHold> MakeHold() {
+    return std::make_unique<ChatDrawHold>(
+        base::BindRepeating(&RacAiChatDrawHoldTest::Take,
+                            base::Unretained(this)),
+        base::BindRepeating([](bool* awaiting) { return *awaiting; },
+                            base::Unretained(&awaiting_visible_)));
+  }
+
+  base::ScopedClosureRunner Take() {
+    ++holds_;
+    ++taken_;
+    max_holds_ = std::max(max_holds_, holds_);
+    return base::ScopedClosureRunner(base::BindOnce(
+        [](int* holds) { --*holds; }, base::Unretained(&holds_)));
+  }
+
+  base::test::SingleThreadTaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  int holds_ = 0;
+  int taken_ = 0;
+  int max_holds_ = 0;
+  bool awaiting_visible_ = false;
+};
+
+TEST_F(RacAiChatDrawHoldTest, KeepTakesOneHoldAndLettingGoTakesATask) {
+  auto hold = MakeHold();
+  hold->Keep(true);
+  hold->Keep(true);
+  EXPECT_EQ(holds_, 1);
+  EXPECT_TRUE(hold->held());
+
+  hold->Keep(false);
+  // The side panel shows the returning view in this same task, so the hold
+  // stays until the next one.
+  EXPECT_EQ(holds_, 1);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(holds_, 0);
+  EXPECT_FALSE(hold->held());
+}
+
+TEST_F(RacAiChatDrawHoldTest, LettingGoWaitsForAShowingPageToBeVisible) {
+  auto hold = MakeHold();
+  hold->Keep(true);
+  awaiting_visible_ = true;
+  hold->Keep(false);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(holds_, 1);
+
+  // Not visible yet, nothing happens until it is.
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(holds_, 1);
+
+  awaiting_visible_ = false;
+  hold->OnVisible();
+  EXPECT_EQ(holds_, 1);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(holds_, 0);
+}
+
+TEST_F(RacAiChatDrawHoldTest, APageThatNeverShowsLosesTheHoldAtTheCap) {
+  auto hold = MakeHold();
+  hold->Keep(true);
+  awaiting_visible_ = true;
+  hold->Keep(false);
+  task_environment_.RunUntilIdle();
+
+  task_environment_.FastForwardBy(kChatDrawHoldCap - base::Milliseconds(1));
+  EXPECT_EQ(holds_, 1);
+  task_environment_.FastForwardBy(base::Milliseconds(1));
+  EXPECT_EQ(holds_, 0);
+  EXPECT_FALSE(hold->held());
+
+  // A late visibility change has nothing left to do.
+  hold->OnVisible();
+  task_environment_.FastForwardUntilNoTasksRemain();
+  EXPECT_EQ(holds_, 0);
+}
+
+TEST_F(RacAiChatDrawHoldTest, KeepingAgainBeforeTheReleaseRunsKeepsTheHold) {
+  auto hold = MakeHold();
+  hold->Keep(true);
+  hold->Keep(false);
+  hold->Keep(true);
+  task_environment_.FastForwardBy(kChatDrawHoldCap * 2);
+  EXPECT_EQ(holds_, 1);
+  EXPECT_EQ(taken_, 1);
+
+  // And a wait that was under way is over: the cap no longer applies.
+  awaiting_visible_ = true;
+  hold->Keep(false);
+  task_environment_.RunUntilIdle();
+  hold->Keep(true);
+  task_environment_.FastForwardBy(kChatDrawHoldCap * 2);
+  EXPECT_EQ(holds_, 1);
+  EXPECT_EQ(taken_, 1);
+}
+
+TEST_F(RacAiChatDrawHoldTest, DestroyingWhileHeldLetsGo) {
+  auto hold = MakeHold();
+  hold->Keep(true);
+  EXPECT_EQ(holds_, 1);
+  hold.reset();
+  EXPECT_EQ(holds_, 0);
+  // A task or timer it left behind finds nothing to touch.
+  task_environment_.FastForwardUntilNoTasksRemain();
+  EXPECT_EQ(holds_, 0);
+
+  hold = MakeHold();
+  hold->Keep(true);
+  awaiting_visible_ = true;
+  hold->Keep(false);
+  task_environment_.RunUntilIdle();
+  hold.reset();
+  EXPECT_EQ(holds_, 0);
+  task_environment_.FastForwardUntilNoTasksRemain();
+}
+
+TEST_F(RacAiChatDrawHoldTest, RepeatedCyclesNeverStackAndEndAtZero) {
+  auto hold = MakeHold();
+  for (int i = 0; i < 20; ++i) {
+    hold->Keep(true);
+    hold->Keep(true);
+    // Every other round the page is showing and not yet visible.
+    awaiting_visible_ = i % 2 == 1;
+    hold->Keep(false);
+    hold->Keep(false);
+    task_environment_.RunUntilIdle();
+    if (awaiting_visible_) {
+      awaiting_visible_ = false;
+      hold->OnVisible();
+    }
+    task_environment_.RunUntilIdle();
+    EXPECT_EQ(holds_, 0) << i;
+  }
+  EXPECT_EQ(max_holds_, 1);
+  EXPECT_EQ(taken_, 20);
+  task_environment_.FastForwardUntilNoTasksRemain();
+  EXPECT_EQ(holds_, 0);
+}

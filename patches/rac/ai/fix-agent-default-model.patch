+// Codex on a ChatGPT plan opens a session on a model the plan can't use.
+// The agent's own list is right, so the session switches to one of those
+// (with the same reasoning suffix) before the prompt.
+TEST_F(AcpClientTest, SessionModelOutsideTheListIsReplaced) {
+  bool ready = false;
+  client_->Start(base::DictValue().Set("cwd", "/tmp"),
+                 base::BindLambdaForTesting([&](std::string error) {
+                   EXPECT_TRUE(error.empty());
+                   ready = true;
+                 }));
+  Deliver(R"({"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1}})");
+  Deliver(R"({"jsonrpc":"2.0","id":2,"result":{"sessionId":"s1","models":{
+      "currentModelId":"gpt-5.6-sol[medium]","availableModels":[
+      {"modelId":"gpt-6-luna[low]"},{"modelId":"gpt-6-luna[medium]"}]}}})");
+  EXPECT_FALSE(ready);
+  ASSERT_EQ(written_.size(), 3u);
+  EXPECT_EQ(*written_[2].FindString("method"), "session/set_model");
+  EXPECT_EQ(*written_[2].FindDict("params")->FindString("modelId"),
+            "gpt-6-luna[medium]");
+  EXPECT_EQ(client_->fallback_model(), "gpt-6-luna[medium]");
+  Deliver(R"({"jsonrpc":"2.0","id":3,"result":{}})");
+  EXPECT_TRUE(ready);
+  EXPECT_EQ(client_->state(), AcpClient::State::kReady);
+}
+
+TEST_F(AcpClientTest, SessionModelInTheListIsKept) {
+  bool ready = false;
+  client_->Start(
+      base::DictValue().Set("cwd", "/tmp"),
+      base::BindLambdaForTesting([&](std::string) { ready = true; }));
+  Deliver(R"({"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1}})");
+  Deliver(R"({"jsonrpc":"2.0","id":2,"result":{"sessionId":"s1","models":{
+      "currentModelId":"a","availableModels":[{"modelId":"a"}]}}})");
+  EXPECT_TRUE(ready);
+  EXPECT_EQ(written_.size(), 2u);
+  EXPECT_EQ(client_->fallback_model(), "");
+}
+
+TEST_F(AcpClientTest, RefusedModelSwitchStillReadiesTheSession) {
+  bool ready = false;
+  client_->Start(
+      base::DictValue().Set("cwd", "/tmp"),
+      base::BindLambdaForTesting([&](std::string) { ready = true; }));
+  Deliver(R"({"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1}})");
+  Deliver(R"({"jsonrpc":"2.0","id":2,"result":{"sessionId":"s1","models":{
+      "currentModelId":"x","availableModels":[{"modelId":"a"}]}}})");
+  EXPECT_FALSE(ready);
+  Deliver(R"({"jsonrpc":"2.0","id":3,"error":{"code":-32601,"message":"no"}})");
+  EXPECT_TRUE(ready);
+  EXPECT_EQ(client_->fallback_model(), "");
+  EXPECT_EQ(client_->state(), AcpClient::State::kReady);
+}

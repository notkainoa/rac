+// The model to switch a new session to, or empty when its current model is
+// one it lists as available (or it lists none). Codex on a ChatGPT plan
+// starts with a model the plan can't use and fails the first prompt with
+// "not supported"; the plan's own list is right. The first listed model
+// with the same reasoning suffix ("[medium]") is preferred, then the first.
+std::string FallbackModel(const base::DictValue& session) {
+  const base::DictValue* models = session.FindDict("models");
+  const std::string* current =
+      models ? models->FindString("currentModelId") : nullptr;
+  const base::ListValue* available =
+      models ? models->FindList("availableModels") : nullptr;
+  if (!current || !available || available->empty()) {
+    return "";
+  }
+  std::vector<std::string> ids;
+  for (const base::Value& entry : *available) {
+    const base::DictValue* model = entry.GetIfDict();
+    const std::string* id = model ? model->FindString("modelId") : nullptr;
+    if (id && !id->empty()) {
+      ids.push_back(*id);
+    }
+  }
+  if (ids.empty() || std::ranges::contains(ids, *current)) {
+    return "";
+  }
+  const size_t bracket = current->find('[');
+  if (bracket != std::string::npos) {
+    const std::string suffix = current->substr(bracket);
+    for (const std::string& id : ids) {
+      if (id.ends_with(suffix)) {
+        return id;
+      }
+    }
+  }
+  return ids.front();
+}

Index: src/chrome/browser/resources/rac_ai/intent.ts
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/resources/rac_ai/intent.ts	2026-10-23 19:05:18.872015045 -0700
@@ -0,0 +1,122 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Decides, from the text alone, whether the new tab page's composer should
+// search or ask the assistant. Everything here is local and cheap enough to
+// run on every keystroke; no model is ever involved.
+
+export type Mode = 'search'|'ask';
+
+export interface Intent {
+  mode: Mode;
+  // The text looks like an address. It still searches (the browser opens it),
+  // but the composer says "Open".
+  url: boolean;
+}
+
+// "who is x" asks at three words. Verbs that begin a yes/no question also
+// begin product names ("can opener reviews"), so they need a fourth word.
+const WH_WORDS = new Set([
+  'who',
+  'whom',
+  'whose',
+  'what',
+  'when',
+  'where',
+  'why',
+  'which',
+  'how',
+  'what\'s',
+  'who\'s',
+  'where\'s',
+  'how\'s',
+  'when\'s',
+  'why\'s',
+]);
+
+const AUX_WORDS = new Set([
+  'is',     'are',      'am',     'was',    'were',  'do',     'does',
+  'did',    'can',      'could',  'should', 'would', 'will',   'shall',
+  'may',    'might',    'have',   'has',    'had',   'isn\'t', 'aren\'t',
+  'don\'t', 'doesn\'t', 'can\'t', 'won\'t',
+]);
+
+// Verbs people start a request to an assistant with.
+const REQUEST_WORDS = new Set([
+  'explain', 'summarize',  'summarise', 'describe', 'compare', 'translate',
+  'suggest', 'recommend',  'rewrite',   'draft',    'write',   'generate',
+  'create',  'brainstorm', 'teach',     'help',     'tell',    'give',
+  'show',    'list',       'make',      'plan',     'analyze', 'analyse',
+]);
+
+const FIRST_PERSON =
+    new Set(['i', 'i\'m', 'i\'ve', 'my', 'me', 'we', 'you', 'your']);
+
+// Google-style operators mean the user knows exactly what they want to search.
+const OPERATOR =
+    /(^|\s)(site|filetype|intitle|inurl|before|after|related|cache):\S/i;
+
+const SCHEME = /^[a-z][a-z0-9+.-]*:\/\/\S+$/i;
+const HOST_PORT =
+    /^(localhost|\d{1,3}(\.\d{1,3}){3}|\[[0-9a-f:]+\])(:\d+)?([/?#]\S*)?$/i;
+const DOMAIN = /^([a-z0-9-]+\.)+[a-z]{2,}(:\d+)?([/?#]\S*)?$/i;
+
+const QUESTION_MARKS = ['?', '\uFF1F', '\u061F', '\u037E'];
+
+// CJK text has no spaces between words: count characters instead.
+const CJK =
+    /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u;
+const CJK_LONG = 15;
+const WORDS_LONG = 8;
+const WORDS_WITH_PRONOUN = 5;
+
+export function looksLikeUrl(text: string): boolean {
+  const trimmed = text.trim();
+  if (!trimmed || /\s/.test(trimmed)) {
+    return false;
+  }
+  return SCHEME.test(trimmed) || HOST_PORT.test(trimmed) ||
+      DOMAIN.test(trimmed) || /^(www|localhost)\b/i.test(trimmed);
+}
+
+function words(text: string): string[] {
+  return text.toLowerCase().split(/\s+/).filter(Boolean);
+}
+
+export function classify(text: string): Intent {
+  const trimmed = text.trim();
+  if (!trimmed) {
+    return {mode: 'search', url: false};
+  }
+  if (looksLikeUrl(trimmed)) {
+    return {mode: 'search', url: true};
+  }
+  const search: Intent = {mode: 'search', url: false};
+  const ask: Intent = {mode: 'ask', url: false};
+  if (OPERATOR.test(trimmed) || /^".*"$/.test(trimmed)) {
+    return search;
+  }
+  if (QUESTION_MARKS.includes(trimmed.slice(-1))) {
+    return ask;
+  }
+  const list = words(trimmed);
+  const first = (list[0] ?? '').replace(/[^\p{L}\p{N}']/gu, '');
+  if (list.length === 1) {
+    return CJK.test(trimmed) && trimmed.length >= CJK_LONG ? ask : search;
+  }
+  if (list.length >= WORDS_LONG) {
+    return ask;
+  }
+  if (list.length >= 3 && (WH_WORDS.has(first) || REQUEST_WORDS.has(first))) {
+    return ask;
+  }
+  if (list.length >= 4 && AUX_WORDS.has(first)) {
+    return ask;
+  }
+  if (list.length >= WORDS_WITH_PRONOUN &&
+      list.some(w => FIRST_PERSON.has(w))) {
+    return ask;
+  }
+  return search;
+}

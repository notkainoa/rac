===================================================================
--- src.orig/chrome/browser/resources/rac_ai/app.css	2026-10-23 19:05:16.815289370 -0700
+++ src/chrome/browser/resources/rac_ai/app.css	2026-10-23 19:05:18.870770808 -0700
@@ -1094,3 +1094,95 @@
 body[data-mode='panel'] .composer-wrap {
   padding: 0 7px 7px 0;
 }
+
+/* New tab page: the composer searches or asks. The chip says which; it only
+ * exists once there is text to act on. */
+
+.mode-chip {
+  align-items: center;
+  background: var(--token);
+  border: 0;
+  border-radius: 16px;
+  color: var(--text-muted);
+  display: inline-flex;
+  flex: none;
+  font: 500 13px/1 system-ui, -apple-system, sans-serif;
+  gap: 6px;
+  height: 32px;
+  margin-inline-start: 4px;
+  overflow: hidden;
+  padding: 0 10px 0 8px;
+  transition: background-color 120ms, color 120ms;
+  white-space: nowrap;
+}
+
+.mode-chip[hidden] {
+  display: none;
+}
+
+.mode-chip:hover {
+  background: var(--token-hover);
+  color: var(--text);
+}
+
+.mode-chip svg {
+  height: 16px;
+  stroke-width: 1.5;
+  width: 16px;
+}
+
+.mode-chip .orb {
+  animation: none;
+  height: 12px;
+  margin: 2px;
+  width: 12px;
+}
+
+.mode-chip:not([data-mode='search']) .mode-icon-search,
+.mode-chip:not([data-mode='open']) .mode-icon-open,
+.mode-chip:not([data-mode='ask']) .mode-icon-ask {
+  display: none;
+}
+
+.kbd {
+  border: 1px solid var(--hairline);
+  border-radius: 4px;
+  color: var(--text-faint);
+  font: 11px/14px system-ui, -apple-system, sans-serif;
+  height: 16px;
+  padding: 0 4px;
+}
+
+.mode-chip:not(.show-kbd) .kbd {
+  display: none;
+}
+
+.visually-hidden {
+  block-size: 1px;
+  clip-path: inset(50%);
+  inline-size: 1px;
+  overflow: hidden;
+  position: absolute;
+  white-space: nowrap;
+}
+
+.send .arrow-right,
+.composer:is([data-intent='search'], [data-intent='open']) .send .arrow-up {
+  display: none;
+}
+
+.composer:is([data-intent='search'], [data-intent='open']) .send .arrow-right {
+  display: inline;
+}
+
+.composer:is([data-intent='search'], [data-intent='open'])
+    .send:not(:disabled, .stop) {
+  background: light-dark(rgb(0 0 0 / 85%), rgb(255 255 255 / 85%));
+  color: light-dark(#fff, #1b1b1b);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .mode-chip {
+    transition: none;
+  }
+}

+// The new tab page's Search: opens `text` in this tab the way the address bar
+// would, as an address or as a search with the default search engine.
+void PageHandler::HandleSearch(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  content::WebContents* contents = web_ui()->GetWebContents();
+  AutocompleteClassifier* classifier =
+      AutocompleteClassifierFactory::GetForProfile(profile_);
+  if (!args[0].is_string() || !classifier ||
+      !tabs::TabInterface::MaybeGetFromContents(contents) ||
+      !AiServiceFactory::GetForProfile(profile_)) {
+    return;
+  }
+  std::string text;
+  base::TruncateUTF8ToByteSize(args[0].GetString(), kMaxSearchBytes, &text);
+  const std::u16string query = std::u16string(
+      base::TrimWhitespace(base::UTF8ToUTF16(text), base::TRIM_ALL));
+  if (query.empty()) {
+    return;
+  }
+  AutocompleteMatch match;
+  classifier->Classify(query, /*in_keyword_mode=*/false,
+                       /*allow_exact_keyword_match=*/false,
+                       metrics::OmniboxEventProto::OTHER, &match, nullptr);
+  const GURL url = match.destination_url;
+  // A page here must not become a way to run script or reach local files.
+  if (!url.is_valid() ||
+      !(url.SchemeIsHTTPOrHTTPS() || url.SchemeIs(content::kChromeUIScheme))) {
+    return;
+  }
+  const ui::PageTransition transition =
+      AutocompleteMatch::IsSearchType(match.type)
+          ? ui::PAGE_TRANSITION_GENERATED
+          : ui::PAGE_TRANSITION_TYPED;
+  // Leave this handler before the page it belongs to is replaced.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<content::WebContents> contents, GURL url,
+                        ui::PageTransition transition) {
+                       if (!contents) {
+                         return;
+                       }
+                       content::NavigationController::LoadURLParams params(url);
+                       params.transition_type = transition;
+                       contents->GetController().LoadURLWithParams(params);
+                     },
+                     contents->GetWeakPtr(), url, transition));
+}

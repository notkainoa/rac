+class RacAgentChoiceTest : public testing::Test {
+ protected:
+  void SetUp() override { RegisterProfilePrefs(prefs_.registry()); }
+
+  std::string AgentPref() const { return prefs_.GetString(kAgentId); }
+
+  // The browser's whole path for a choice from the chat: build the menu,
+  // show it with `shown_lines`, pick `line`, and ask for `agent`.
+  bool Choose(const ModelMenuInput& input,
+              const std::vector<std::string>& shown_lines,
+              const std::string& line,
+              const std::string& agent) {
+    const std::set<std::string> shown = AgentsInShownMenu(
+        shown_lines, OfferedAgentIds(BuildModelMenu(input)));
+    return ChooseOfferedAgent(&prefs_, AgentForPick(line, shown), agent);
+  }
+
+  TestingPrefServiceSimple prefs_;
+};

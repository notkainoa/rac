+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/model_menu.h"
+
+#include <algorithm>
+#include <iterator>
+#include <string_view>
+#include <utility>
+
+#include "base/strings/strcat.h"
+#include "chrome/browser/rac/ai/active_provider.h"
+
+namespace rac::ai {
+
+namespace {
+
+using Row = ModelMenuRow;
+
+constexpr std::string_view kAgentOrder[] = {
+    "codex", "claude", "cursor", "gemini", "copilot", "opencode", "goose"};
+
+size_t AgentRank(std::string_view id) {
+  const auto* found = std::ranges::find(kAgentOrder, id);
+  return static_cast<size_t>(std::distance(std::begin(kAgentOrder), found));
+}
+
+class Builder {
+ public:
+  explicit Builder(const ModelMenuInput& input) : input_(input) {}
+
+  std::vector<Row> Build() && {
+    bool has_models = false;
+    for (const ModelMenuProvider& provider : input_.providers) {
+      has_models = has_models || !provider.models.empty();
+    }
+    const bool agents_first = !input_.configured || !has_models;
+    if (agents_first) {
+      AddInstalledAgents();
+      AddProviders();
+    } else {
+      AddProviders();
+      AddInstalledAgents();
+    }
+    AddMissingAgents();
+    AddFooter(agents_first);
+    return std::move(rows_);
+  }
+
+ private:
+  bool AgentActive() const {
+    return input_.configured && !input_.incognito && !input_.agent_id.empty();
+  }
+
+  Row& Add(Row::Type type) {
+    Row& row = rows_.emplace_back();
+    row.type = type;
+    return row;
+  }
+
+  void Separate() {
+    if (!rows_.empty() && rows_.back().type != Row::Type::kSeparator) {
+      Add(Row::Type::kSeparator);
+    }
+  }
+
+  void AddNote(std::string text) {
+    Add(Row::Type::kNote).text = std::move(text);
+  }
+
+  void AddProviders() {
+    bool first = true;
+    for (const ModelMenuProvider& provider : input_.providers) {
+      if (provider.models.empty()) {
+        continue;
+      }
+      if (first) {
+        Separate();
+        first = false;
+      }
+      Add(Row::Type::kHeading).label = provider.name;
+      for (const std::string& model : provider.models) {
+        Row& row = Add(Row::Type::kItem);
+        row.action = Row::Action::kChooseModel;
+        row.label = model;
+        row.provider_id = provider.id;
+        row.provider_name = provider.name;
+        row.model = model;
+        row.checked = input_.configured && !AgentActive() &&
+                      provider.id == input_.provider_id &&
+                      model == input_.model;
+      }
+    }
+  }
+
+  bool HasInstalledAgent() const {
+    return input_.agents &&
+           std::ranges::any_of(*input_.agents, &ModelMenuAgent::installed);
+  }
+
+  void AddInstalledAgents() {
+    if (input_.incognito) {
+      Separate();
+      AddNote("noAgentsIncognito");
+      return;
+    }
+    if (!input_.agents) {
+      Separate();
+      AddNote("lookingForAgents");
+      return;
+    }
+    if (!HasInstalledAgent()) {
+      return;
+    }
+    Separate();
+    Add(Row::Type::kHeading).text = "agentsHeading";
+    for (const ModelMenuAgent& agent : *input_.agents) {
+      if (!agent.installed) {
+        continue;
+      }
+      Row& row = Add(Row::Type::kItem);
+      row.label = agent.name;
+      row.agent_id = agent.id;
+      const auto issue = input_.issues.find(agent.id);
+      if (issue != input_.issues.end()) {
+        // It didn't work this session: the line leads to what fixes it.
+        row.action = Row::Action::kOpenSettings;
+        row.detail = issue->second == AgentIssue::kSignIn ? "signInToUse"
+                                                          : "fixInSettings";
+        row.settings_icon = true;
+        continue;
+      }
+      row.action = Row::Action::kChooseAgent;
+      row.line_id = AgentMenuLineId(agent.id);
+      row.checked = AgentActive() && agent.id == input_.agent_id;
+    }
+    AddNote("modelsLater");
+  }
+
+  void AddMissingAgents() {
+    if (input_.incognito || !input_.agents) {
+      return;
+    }
+    bool first = true;
+    for (const ModelMenuAgent& agent : *input_.agents) {
+      // Custom with no working command has nothing to install; Settings is
+      // where it's set up.
+      if (agent.installed || agent.id == "custom") {
+        continue;
+      }
+      if (first) {
+        Separate();
+        Add(Row::Type::kHeading).text = "notInstalledHeading";
+        first = false;
+      }
+      Row& row = Add(Row::Type::kItem);
+      row.label = agent.name;
+      row.agent_id = agent.id;
+      row.enabled = false;
+      row.detail = agent.needs_node ? "needsNodeDetail" : std::string();
+      row.tooltip = agent.needs_node ? "needsNodeTip" : "notInstalledTip";
+    }
+  }
+
+  void AddFooter(bool agents_first) {
+    Separate();
+    // For someone who has only an agent, one quiet line on what still
+    // needs a key or a local model.
+    if (!input_.direct_ready && !input_.incognito &&
+        (AgentActive() || HasInstalledAgent())) {
+      AddNote("needsDirectProvider");
+    }
+    Row& row = Add(Row::Type::kItem);
+    row.action = Row::Action::kOpenSettings;
+    row.text = agents_first ? "setUpInSettings" : "settings";
+    row.settings_icon = true;
+  }
+
+  const ModelMenuInput& input_;
+  std::vector<Row> rows_;
+};
+
+}  // namespace
+
+ModelMenuInput::ModelMenuInput() = default;
+ModelMenuInput::ModelMenuInput(const ModelMenuInput&) = default;
+ModelMenuInput& ModelMenuInput::operator=(const ModelMenuInput&) = default;
+ModelMenuInput::ModelMenuInput(ModelMenuInput&&) = default;
+ModelMenuInput& ModelMenuInput::operator=(ModelMenuInput&&) = default;
+ModelMenuInput::~ModelMenuInput() = default;
+
+ModelMenuRow::ModelMenuRow() = default;
+ModelMenuRow::ModelMenuRow(const ModelMenuRow&) = default;
+ModelMenuRow& ModelMenuRow::operator=(const ModelMenuRow&) = default;
+ModelMenuRow::ModelMenuRow(ModelMenuRow&&) = default;
+ModelMenuRow& ModelMenuRow::operator=(ModelMenuRow&&) = default;
+ModelMenuRow::~ModelMenuRow() = default;
+
+void SortAgentsForMenu(std::vector<ModelMenuAgent>& agents) {
+  std::ranges::stable_sort(agents, {}, [](const ModelMenuAgent& agent) {
+    return AgentRank(agent.id);
+  });
+}
+
+std::vector<ModelMenuRow> BuildModelMenu(const ModelMenuInput& input) {
+  return Builder(input).Build();
+}
+
+std::set<std::string> OfferedAgentIds(const std::vector<ModelMenuRow>& rows) {
+  std::set<std::string> offered;
+  for (const ModelMenuRow& row : rows) {
+    if (row.action == Row::Action::kChooseAgent && row.enabled &&
+        !row.agent_id.empty()) {
+      offered.insert(row.agent_id);
+    }
+  }
+  return offered;
+}
+
+std::string AgentMenuLineId(std::string_view agent_id) {
+  return base::StrCat({"agent:", agent_id});
+}
+
+std::set<std::string> AgentsInShownMenu(
+    const std::vector<std::string>& line_ids,
+    const std::set<std::string>& offered) {
+  std::set<std::string> shown;
+  for (const std::string& agent : offered) {
+    if (std::ranges::contains(line_ids, AgentMenuLineId(agent))) {
+      shown.insert(agent);
+    }
+  }
+  return shown;
+}
+
+std::string AgentForPick(std::string_view line_id,
+                         const std::set<std::string>& shown) {
+  for (const std::string& agent : shown) {
+    if (line_id == AgentMenuLineId(agent)) {
+      return agent;
+    }
+  }
+  return std::string();
+}
+
+bool ChooseOfferedAgent(PrefService* prefs,
+                        std::string_view picked,
+                        std::string_view agent_id) {
+  if (picked.empty() || picked != agent_id) {
+    return false;
+  }
+  return SelectAgent(prefs, agent_id);
+}
+
+}  // namespace rac::ai

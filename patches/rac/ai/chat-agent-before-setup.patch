+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/model_menu.h"
+
+#include <string>
+#include <vector>
+
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+using testing::ElementsAre;
+using Row = ModelMenuRow;
+
+ModelMenuAgent Agent(std::string id, bool installed, bool needs_node = false) {
+  ModelMenuAgent agent;
+  agent.name = id + " name";
+  agent.id = std::move(id);
+  agent.installed = installed;
+  agent.needs_node = needs_node;
+  return agent;
+}
+
+// The Pro's set in the proof runs: Claude Code found, Cursor needing Node,
+// the rest missing, Custom without a command.
+std::vector<ModelMenuAgent> SomeAgents() {
+  return {Agent("claude", true), Agent("codex", true),
+          Agent("cursor", false, /*needs_node=*/true), Agent("gemini", false),
+          Agent("custom", false)};
+}
+
+ModelMenuProvider Provider(std::string id, std::vector<std::string> models) {
+  ModelMenuProvider provider;
+  provider.name = id + " name";
+  provider.id = std::move(id);
+  provider.models = std::move(models);
+  return provider;
+}
+
+// One line per row: what it is, what it chooses or says, `*` when checked,
+// `(off)` when it can't be picked, and its detail.
+std::vector<std::string> Lines(const std::vector<Row>& rows) {
+  std::vector<std::string> lines;
+  for (const Row& row : rows) {
+    std::string line;
+    switch (row.type) {
+      case Row::Type::kSeparator:
+        line = "---";
+        break;
+      case Row::Type::kHeading:
+        line = "# " + (row.text.empty() ? row.label : row.text);
+        break;
+      case Row::Type::kNote:
+        line = "note " + row.text;
+        break;
+      case Row::Type::kItem:
+        switch (row.action) {
+          case Row::Action::kChooseModel:
+            line = "model " + row.provider_id + "/" + row.model;
+            break;
+          case Row::Action::kChooseAgent:
+            line = "agent " + row.agent_id;
+            break;
+          case Row::Action::kOpenSettings:
+            line = "settings " + (row.text.empty() ? row.agent_id : row.text);
+            break;
+          case Row::Action::kNone:
+            line = "line " + row.agent_id;
+            break;
+        }
+        break;
+    }
+    if (row.checked) {
+      line += " *";
+    }
+    if (!row.enabled) {
+      line += " (off)";
+    }
+    if (!row.detail.empty()) {
+      line += " [" + row.detail + "]";
+    }
+    lines.push_back(std::move(line));
+  }
+  return lines;
+}
+
+bool AnyChecked(const std::vector<Row>& rows) {
+  for (const Row& row : rows) {
+    if (row.checked) {
+      return true;
+    }
+  }
+  return false;
+}
+
+TEST(RacModelMenuTest, SortsAgentsMostUsedFirstAndCustomLast) {
+  std::vector<ModelMenuAgent> agents = {
+      Agent("custom", true), Agent("goose", true), Agent("claude", true),
+      Agent("opencode", true), Agent("codex", true)};
+  SortAgentsForMenu(agents);
+  std::vector<std::string> ids;
+  for (const ModelMenuAgent& agent : agents) {
+    ids.push_back(agent.id);
+  }
+  EXPECT_THAT(ids, ElementsAre("codex", "claude", "opencode", "goose",
+                               "custom"));
+}
+
+// #124: someone whose only AI is an agent can choose it here, before any
+// setup. Installed agents first, then the ones not installed, then Settings.
+TEST(RacModelMenuTest, BeforeSetupListsInstalledAgentsFirst) {
+  ModelMenuInput input;
+  input.agents = SomeAgents();
+  SortAgentsForMenu(*input.agents);
+
+  EXPECT_THAT(Lines(BuildModelMenu(input)),
+              ElementsAre("# agentsHeading", "agent codex", "agent claude",
+                          "note modelsLater", "---", "# notInstalledHeading",
+                          "line cursor (off) [needsNodeDetail]",
+                          "line gemini (off)", "---",
+                          "note needsDirectProvider",
+                          "settings setUpInSettings"));
+}
+
+TEST(RacModelMenuTest, BeforeSetupDirectProvidersComeAfterAgents) {
+  // A key saved for a provider that isn't the chosen one: its models list,
+  // but nothing is set up yet.
+  ModelMenuInput input;
+  input.provider_id = "openai";
+  input.model = "gpt";
+  input.providers = {Provider("anthropic", {"sonnet", "haiku"})};
+  input.agents = {Agent("claude", true)};
+
+  EXPECT_THAT(Lines(BuildModelMenu(input)),
+              ElementsAre("# agentsHeading", "agent claude",
+                          "note modelsLater", "---", "# anthropic name",
+                          "model anthropic/sonnet", "model anthropic/haiku",
+                          "---", "note needsDirectProvider",
+                          "settings setUpInSettings"));
+}
+
+// Choosing is the consent: one agent found is still not chosen for you.
+TEST(RacModelMenuTest, NeverPreselectsTheOnlyAgent) {
+  ModelMenuInput input;
+  input.agents = {Agent("claude", true)};
+  const std::vector<Row> rows = BuildModelMenu(input);
+  EXPECT_FALSE(AnyChecked(rows));
+
+  // Even if the pref names it, a menu that isn't set up checks nothing.
+  input.agent_id = "claude";
+  EXPECT_FALSE(AnyChecked(BuildModelMenu(input)));
+}
+
+TEST(RacModelMenuTest, NeverPreselectsADirectModelBeforeSetup) {
+  ModelMenuInput input;
+  input.provider_id = "anthropic";
+  input.model = "sonnet";
+  input.providers = {Provider("anthropic", {"sonnet"})};
+  input.agents = {Agent("claude", true)};
+  EXPECT_FALSE(AnyChecked(BuildModelMenu(input)));
+}
+
+TEST(RacModelMenuTest, NotInstalledAgentsCantBeChosen) {
+  ModelMenuInput input;
+  input.agents = {Agent("cursor", false, /*needs_node=*/true),
+                  Agent("gemini", false)};
+  for (const Row& row : BuildModelMenu(input)) {
+    EXPECT_NE(row.action, Row::Action::kChooseAgent) << row.agent_id;
+    if (!row.agent_id.empty()) {
+      EXPECT_FALSE(row.enabled) << row.agent_id;
+      EXPECT_FALSE(row.tooltip.empty()) << row.agent_id;
+    }
+  }
+}
+
+TEST(RacModelMenuTest, CustomWithoutACommandIsNotListed) {
+  ModelMenuInput input;
+  input.agents = {Agent("custom", false)};
+  EXPECT_THAT(Lines(BuildModelMenu(input)),

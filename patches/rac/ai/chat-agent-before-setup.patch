+
+TEST(RacModelMenuTest, ChoiceLinesCarryWhatTheyChoose) {
+  ModelMenuInput input;
+  input.providers = {Provider("anthropic", {"sonnet"})};
+  input.agents = {Agent("claude", true)};
+  bool saw_model = false;
+  bool saw_agent = false;
+  for (const Row& row : BuildModelMenu(input)) {
+    if (row.action == Row::Action::kChooseModel) {
+      saw_model = true;
+      EXPECT_EQ(row.provider_id, "anthropic");
+      EXPECT_EQ(row.provider_name, "anthropic name");
+      EXPECT_EQ(row.model, "sonnet");
+    }

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_MODEL_MENU_H_
+#define CHROME_BROWSER_RAC_AI_MODEL_MENU_H_
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+class PrefService;
+
+namespace rac::ai {
+
+// What the chat's model button offers: the lines of its menu, in order. The
+// page draws them with its own strings and acts on the line picked, so the
+// order and what can be chosen live here, where they're tested.
+//
+// Nothing here chooses for the user. A line is checked only when the prefs
+// already name its provider, never because it's the only one found.
+
+struct ModelMenuAgent {
+  std::string id;
+  std::string name;
+  // Found and runnable. Only these can be chosen.
+  bool installed = false;
+  // The adapter's CLI is there but npx isn't.
+  bool needs_node = false;
+};
+
+struct ModelMenuProvider {
+  std::string id;
+  std::string name;
+  std::vector<std::string> models;
+};
+
+// What the chat page learned this session about an agent it couldn't use.
+enum class AgentIssue { kSignIn, kFix };
+
+struct ModelMenuInput {
+  ModelMenuInput();
+  ModelMenuInput(const ModelMenuInput&);
+  ModelMenuInput& operator=(const ModelMenuInput&);
+  ModelMenuInput(ModelMenuInput&&);
+  ModelMenuInput& operator=(ModelMenuInput&&);
+  ~ModelMenuInput();
+
+  // A message can be sent: an agent is chosen, or the direct provider is
+  // ready.
+  bool configured = false;
+  // The direct provider is ready. Link summaries and the safety check need
+  // it even when an agent answers the chat.
+  bool direct_ready = false;
+  bool incognito = false;
+  // The choice the prefs hold.
+  std::string agent_id;
+  std::string provider_id;
+  std::string model;
+  // Direct providers with a key or a server, and the models each offers.
+  std::vector<ModelMenuProvider> providers;
+  // Unset while the search for agents hasn't answered.
+  std::optional<std::vector<ModelMenuAgent>> agents;
+  std::map<std::string, AgentIssue> issues;
+};
+
+struct ModelMenuRow {
+  enum class Type { kHeading, kSeparator, kNote, kItem };
+  enum class Action { kNone, kChooseModel, kChooseAgent, kOpenSettings };
+
+  ModelMenuRow();
+  ModelMenuRow(const ModelMenuRow&);
+  ModelMenuRow& operator=(const ModelMenuRow&);
+  ModelMenuRow(ModelMenuRow&&);
+  ModelMenuRow& operator=(ModelMenuRow&&);
+  ~ModelMenuRow();
+
+  Type type = Type::kItem;
+  Action action = Action::kNone;
+  // The page's string for the line, like "agentsHeading", or empty when
+  // `label` is a name: a provider's, a model's or an agent's.
+  std::string text;
+  std::string label;
+  // The page's strings for the quieter text after the label and the tip.
+  // The tip takes `label` as its $1.
+  std::string detail;
+  std::string tooltip;
+  bool enabled = true;
+  bool checked = false;
+  bool settings_icon = false;
+  // The page's id for a line that chooses an agent (AgentMenuLineId).
+  std::string line_id;
+  // What a choice line chooses.
+  std::string provider_id;
+  std::string provider_name;
+  std::string model;
+  std::string agent_id;
+};
+
+// The agents in the order the menu lists them: the most used first, then
+// any others in the order given (Custom is last).
+void SortAgentsForMenu(std::vector<ModelMenuAgent>& agents);
+
+// The lines of the model menu.
+//
+// With a direct provider's models to list, they come first, then the
+// installed agents, then the ones not installed, then Assistant settings.
+// Before any setup, or when no direct provider has models (an agent-only
+// user), the installed agents come first, then any direct providers' models,
+// then the ones not installed, and the last line is "Set up in Settings…".
+// An agent that isn't installed is shown greyed out and can't be chosen;
+// Custom without a command isn't listed. Agents never show in Incognito.
+std::vector<ModelMenuRow> BuildModelMenu(const ModelMenuInput& input);
+
+// Choosing an agent from the chat goes through three steps, and the browser
+// checks each one, because the page that sends the choice could send any id:
+//
+// 1. BuildModelMenu offers only installed agents with no sign-in or fix
+//    problem this session: OfferedAgentIds.
+// 2. The page shows a menu. Only offered agents whose line is in it, and can
+//    be picked, stay choosable: AgentsInShownMenu. The set ends when that
+//    menu closes.
+// 3. A pick of one of those lines names the agent: AgentForPick. Only that
+//    agent can then be made active, once: ChooseOfferedAgent.
+//
+// This can't tell who sent the message. It holds a choice to what the menu
+// offered: never an agent that isn't installed, and never one the user
+// wasn't shown.
+
+// The agents `rows` lets the user choose.
+std::set<std::string> OfferedAgentIds(const std::vector<ModelMenuRow>& rows);
+
+// The id of the menu line that chooses `agent_id`.
+std::string AgentMenuLineId(std::string_view agent_id);
+
+// The offered agents a shown menu has a line for. `line_ids` are the ids of
+// the lines that can be picked.
+std::set<std::string> AgentsInShownMenu(
+    const std::vector<std::string>& line_ids,
+    const std::set<std::string>& offered);
+
+// The agent a pick of line `line_id` chooses, or empty when the line isn't
+// one of `shown`'s.
+std::string AgentForPick(std::string_view line_id,
+                         const std::set<std::string>& shown);
+
+// Makes `agent_id` active if it is `picked`, the agent the user just picked
+// in the menu. Returns whether it did; otherwise the prefs are unchanged.
+bool ChooseOfferedAgent(PrefService* prefs,
+                        std::string_view picked,
+                        std::string_view agent_id);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_MODEL_MENU_H_

+
+void PageHandler::OnMenuAgentsListed(base::Value callback_id,
+                                     ModelMenuInput input,
+                                     base::ListValue agents) {
+  std::vector<ModelMenuAgent> found;
+  for (const base::Value& value : agents) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* id = dict ? dict->FindString("id") : nullptr;
+    const std::string* name = dict ? dict->FindString("name") : nullptr;
+    if (!id || !name) {
+      continue;
+    }
+    ModelMenuAgent& agent = found.emplace_back();
+    agent.id = *id;
+    agent.name = *name;
+    agent.installed = dict->FindBool("installed").value_or(false);
+    agent.needs_node = dict->FindBool("needsNode").value_or(false);
+  }
+  SortAgentsForMenu(found);
+  input.agents = std::move(found);
+  ResolveModelMenu(callback_id, input);
+}
+
+void PageHandler::ResolveModelMenu(const base::Value& callback_id,
+                                   const ModelMenuInput& input) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  offered_agents_.clear();
+  base::ListValue rows;
+  for (const ModelMenuRow& row : BuildModelMenu(input)) {
+    base::DictValue dict;
+    switch (row.type) {
+      case ModelMenuRow::Type::kHeading:
+        dict.Set("type", "heading");
+        break;
+      case ModelMenuRow::Type::kSeparator:
+        dict.Set("type", "separator");
+        break;
+      case ModelMenuRow::Type::kNote:
+        dict.Set("type", "note");
+        break;
+      case ModelMenuRow::Type::kItem:
+        dict.Set("type", "item");
+        break;
+    }
+    const auto set_text = [&dict](const char* key, const std::string& text) {
+      if (!text.empty()) {
+        dict.Set(key, text);
+      }
+    };
+    set_text("text", row.text);
+    set_text("label", row.label);
+    set_text("detail", row.detail);
+    set_text("tooltip", row.tooltip);
+    if (!row.enabled) {
+      dict.Set("enabled", false);
+    }
+    if (row.checked) {
+      dict.Set("checked", true);
+    }
+    if (row.settings_icon) {
+      dict.Set("icon", "settings");
+    }
+    switch (row.action) {
+      case ModelMenuRow::Action::kNone:
+        break;
+      case ModelMenuRow::Action::kChooseModel:
+        dict.Set("action", "model");
+        dict.Set("provider", row.provider_id);
+        dict.Set("providerName", row.provider_name);
+        dict.Set("model", row.model);
+        break;
+      case ModelMenuRow::Action::kChooseAgent:
+        dict.Set("action", "agent");
+        dict.Set("agent", row.agent_id);
+        offered_agents_.insert(row.agent_id);
+        break;
+      case ModelMenuRow::Action::kOpenSettings:
+        dict.Set("action", "settings");
+        break;
+    }
+    rows.Append(std::move(dict));
+  }
+  ResolveJavascriptCallback(callback_id, rows);
 }
 

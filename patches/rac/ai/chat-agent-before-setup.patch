+// Draws the browser's lines with this page's strings. Choosing an agent here
+// is the consent to run it; nothing is ever chosen for the user.
+function showModelMenu(lines: ModelMenuLine[]) {
+  const actions = new Map<string, () => void>();
+  const entries = lines.map((line, i): MenuEntry => {
+    const label =
+        line.text ? loadTimeData.getString(line.text) : line.label ?? '';
+    if (line.type !== 'item') {
+      return line.type === 'separator' ? {type: 'separator'} :
+                                         {type: line.type, label};
+    }
+    const entry: MenuEntry = {label, checked: !!line.checked};
+    if (line.enabled === false) {
+      entry.enabled = false;
+    }
+    if (line.detail) {
+      entry.detail = loadTimeData.getString(line.detail);
+    }
+    if (line.tooltip) {
+      entry.tooltip = loadTimeData.getStringF(line.tooltip, label);
+    }
+    if (line.icon) {
+      entry.icon = line.icon;
+    }
+    const {provider, model, agent} = line;
+    if (line.action === 'model' && provider && model) {
+      entry.id = `model:${i}`;
+      const providerName = line.providerName ?? '';
+      actions.set(entry.id, () => selectModel(provider, providerName, model));
+    } else if (line.action === 'agent' && agent) {
+      entry.id = `agent:${agent}`;

+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_AI_ASSISTANT_EDGE_HANDLE_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_AI_ASSISTANT_EDGE_HANDLE_H_
+
+class BrowserView;
+
+namespace rac::ai {
+
+// The sidebar layout has no Chat button, so the margin between the page card
+// and the window edge on the side the assistant opens takes its place:
+// clicking it opens the assistant, and dragging it pulls the panel out to
+// the width the user drags to. Does nothing for windows that can't have the
+// assistant. Call once all of `browser_view`'s page views exist, since the
+// handle must sit above them.
+void AddAssistantEdgeHandle(BrowserView* browser_view);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_AI_ASSISTANT_EDGE_HANDLE_H_

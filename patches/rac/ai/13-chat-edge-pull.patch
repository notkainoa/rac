+#include "chrome/browser/ui/views/frame/multi_contents_view.h"
+#include "chrome/browser/ui/views/rac/ai/assistant_actions.h"
+#include "chrome/browser/ui/views/side_panel/side_panel.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/cursor/cursor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+#include "ui/views/view_targeter.h"
+#include "ui/views/view_targeter_delegate.h"
+
+namespace rac::ai {
+namespace {
+
+// AppKit resizes the window from 3 points inside its edge, so the handle
+// stops there and leaves those points to the window.
+constexpr int kWindowResizeMargin = 3;
+
+// Covers the whole browser view so it never needs laying out, but takes
+// events only over the margin, which it works out as each event arrives.
+class AssistantEdgeHandle : public views::View,
+                            public views::ViewTargeterDelegate,
+                            public views::ViewObserver {
+  METADATA_HEADER(AssistantEdgeHandle, views::View)
+
+ public:
+  explicit AssistantEdgeHandle(BrowserView* browser_view)
+      : browser_view_(browser_view) {
+    SetEventTargeter(std::make_unique<views::ViewTargeter>(this));
+    GetViewAccessibility().SetIsIgnored(true);
+    observation_.Observe(browser_view);
+  }
+
+  AssistantEdgeHandle(const AssistantEdgeHandle&) = delete;
+  AssistantEdgeHandle& operator=(const AssistantEdgeHandle&) = delete;
+  ~AssistantEdgeHandle() override = default;
+
+  // views::View:
+  ui::Cursor GetCursor(const ui::MouseEvent& event) override {
+    // Not the window's edge-resize arrows, which sit a few points away.
+    return ui::mojom::CursorType::kColumnResize;
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    press_x_ = event.x();
+    pulling_ = false;
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (pulling_) {
+      if (SidePanel* panel = browser_view_->side_panel()) {
+        panel_width_ = GetPanelWidth(event, *panel);
+        panel->SetPanelWidth(panel_width_);
+      }
+      return true;
+    }
+    const int inward =
+        right_side_ ? press_x_ - event.x() : event.x() - press_x_;
+    if (inward <= 0 ||
+        !views::View::ExceededDragThreshold(gfx::Vector2d(inward, 0))) {
+      return true;
+    }
+    SidePanel* panel = browser_view_->side_panel();
+    SidePanelUI* ui = SidePanelUI::From(browser_view_->browser());
+    if (!panel || !ui) {
+      return true;
+    }
+    pulling_ = true;
+    // The panel takes its width from the pref as it opens, and it opens
+    // without sliding so its edge stays under the pointer.
+    panel_width_ = GetPanelWidth(event, *panel);
+    SaveWidth();
+    ui->Show(SidePanelEntryKey(SidePanelEntryId::kRacAi),
+             SidePanelOpenTrigger::kToolbarButton,
+             /*suppress_animations=*/true);
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (pulling_) {
+      pulling_ = false;
+      SaveWidth();
+      return;
+    }
+    if (event.IsLeftMouseButton() && HitTestPoint(event.location())) {
+      ToggleAssistant(browser_view_->browser());
+    }
+  }
+
+  void OnMouseCaptureLost() override {
+    if (pulling_) {
+      pulling_ = false;
+      SaveWidth();
+    }
+  }
+
+  // views::ViewTargeterDelegate:
+  bool DoesIntersectRect(const views::View* target,
+                         const gfx::Rect& rect) const override {
+    return GetHandleBounds().Intersects(rect);
+  }
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override {
+    SetBoundsRect(observed_view->GetLocalBounds());
+  }
+
+  void OnViewIsDeleting(views::View* observed_view) override {
+    observation_.Reset();
+  }
+
+ private:
+  // In this view's coordinates, which are the browser view's. Empty while
+  // the handle has nothing to do.
+  gfx::Rect GetHandleBounds() const {
+    const SidePanel* panel = browser_view_->side_panel();
+    // With any panel open, the margin no longer meets the window edge.
+    if (!panel || panel->GetVisible()) {
+      return gfx::Rect();
+    }
+    // The top bar layout has the Chat button instead.
+    const PrefService* prefs =
+        browser_view_->browser()->GetProfile()->GetPrefs();
+    if (rac::GetLayout(prefs) == rac::Layout::kTopBar ||
+        !prefs->GetBoolean(kEnabled)) {
+      return gfx::Rect();
+    }
+    const MultiContentsView* page = browser_view_->multi_contents_view();
+    if (!page || !page->GetVisible()) {
+      return gfx::Rect();
+    }
+    gfx::Rect cards;
+    for (const auto& card : page->contents_container_views()) {
+      if (card->GetVisible()) {
+        cards.Union(views::View::ConvertRectToTarget(card, this,
+                                                     card->GetLocalBounds()));
+      }
+    }
+    if (cards.IsEmpty()) {
+      return gfx::Rect();
+    }
+    right_side_ = panel->IsRightAligned();
+    const int left = right_side_ ? cards.right() : kWindowResizeMargin;
+    const int right = right_side_ ? width() - kWindowResizeMargin : cards.x();
+    if (right <= left) {
+      return gfx::Rect();
+    }
+    return gfx::Rect(left, cards.y(), right - left, cards.height());
+  }
+
+  // The width that puts the panel's inner edge under the pointer.
+  int GetPanelWidth(const ui::MouseEvent& event, const SidePanel& panel) const {
+    const int from_edge = right_side_ ? width() - event.x() : event.x();
+    return std::max(panel.GetMinimumSize().width(), from_edge);
+  }
+
+  void SaveWidth() {
+    if (SidePanel* panel = browser_view_->side_panel()) {
+      panel->UpdateSidePanelWidthPref(
+          SidePanelEntryIdToString(SidePanelEntryId::kRacAi), panel_width_);
+    }
+  }
+
+  const raw_ptr<BrowserView> browser_view_;
+  // Which side the margin was on at the last hit test, so a drag keeps it.
+  mutable bool right_side_ = true;
+  int press_x_ = 0;
+  bool pulling_ = false;
+  int panel_width_ = 0;
+  base::ScopedObservation<views::View, views::ViewObserver> observation_{this};
+};
+
+BEGIN_METADATA(AssistantEdgeHandle)
+END_METADATA
+
+}  // namespace
+
+void AddAssistantEdgeHandle(BrowserView* browser_view) {
+  if (!browser_view->GetIsNormalType() ||
+      !browser_view->browser()->GetProfile()->IsRegularProfile()) {
+    return;
+  }
+  browser_view
+      ->AddChildView(std::make_unique<AssistantEdgeHandle>(browser_view))
+      ->SetBoundsRect(browser_view->GetLocalBounds());
+}
+
+}  // namespace rac::ai

+TEST(RacAiPageTextTest, HiddenRolesAndAriaHiddenSuppressSubtrees) {
+  proto::AnnotatedPageContent page;
+  auto* root = page.mutable_root_node();
+  auto* hidden = Node(root, proto::CONTENT_ATTRIBUTE_CONTAINER);
+  hidden->mutable_content_attributes()->add_annotated_roles(
+      proto::ANNOTATED_ROLE_CONTENT_HIDDEN);
+  Paragraph(hidden, "Hidden until found");
+  auto* aria = Node(root, proto::CONTENT_ATTRIBUTE_CONTAINER);
+  aria->mutable_content_attributes()
+      ->mutable_interaction_info()
+      ->add_interaction_disabled_reasons(
+          proto::INTERACTION_DISABLED_REASON_ARIA_HIDDEN);
+  Paragraph(aria, "ARIA hidden");
+  auto* disabled = Paragraph(root, "Disabled but visible");
+  disabled->mutable_content_attributes()
+      ->mutable_interaction_info()
+      ->add_interaction_disabled_reasons(
+          proto::INTERACTION_DISABLED_REASON_ARIA_DISABLED);
+  EXPECT_EQ(SerializePageContent(page).text, "Disabled but visible");
+}
+
+TEST(RacAiPageTextTest, EmptyGeometrySuppressesEvenVisibleChildren) {
+  for (const bool outer : {true, false}) {
+    proto::AnnotatedPageContent page;
+    auto* container =
+        Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_CONTAINER);
+    auto* geometry =
+        container->mutable_content_attributes()->mutable_geometry();
+    auto* box = outer ? geometry->mutable_outer_bounding_box()
+                      : geometry->mutable_visible_bounding_box();
+    box->set_width(0);
+    box->set_height(20);
+    Visible(Paragraph(container, "Hidden child"));
+    EXPECT_TRUE(SerializePageContent(page).text.empty());
+    box->set_width(20);
+    box->set_height(0);
+    EXPECT_TRUE(IsPageNodeHidden(*container));
+  }
+}
+
+TEST(RacAiPageTextTest, OffscreenAndFullyClippedContentIsDropped) {
+  proto::AnnotatedPageContent page;
+  auto* root = page.mutable_root_node();
+  for (const int position : {-200, 20000}) {
+    auto* offscreen = Paragraph(root, "Offscreen");
+    auto* geometry =
+        offscreen->mutable_content_attributes()->mutable_geometry();
+    auto* outer = geometry->mutable_outer_bounding_box();
+    outer->set_y(position);
+    outer->set_width(100);
+    outer->set_height(20);
+    geometry->mutable_visible_bounding_box();
+    EXPECT_TRUE(IsPageNodeHidden(*offscreen));
+  }
+  auto* partially = Paragraph(root, "Partially visible");
+  auto* geometry = partially->mutable_content_attributes()->mutable_geometry();
+  auto* outer = geometry->mutable_outer_bounding_box();
+  outer->set_x(-10);
+  outer->set_y(-10);
+  outer->set_width(100);
+  outer->set_height(20);
+  Visible(partially);
+  EXPECT_EQ(SerializePageContent(page).text, "Partially visible");
+  outer->set_x(-100);
+  geometry->clear_visible_bounding_box();
+  EXPECT_TRUE(IsPageNodeHidden(*partially));
+}
+
+TEST(RacAiPageTextTest, TinyTextNeedsGeometrySoLegibleFootnotesRemain) {
+  proto::AnnotatedPageContent page;
+  auto* text = Text(page.mutable_root_node(), "Footnote");
+  text->mutable_content_attributes()
+      ->mutable_text_data()
+      ->mutable_text_style()
+      ->set_text_size(proto::TEXT_SIZE_XS);
+  EXPECT_FALSE(IsPageNodeHidden(*text));
+  auto* box = text->mutable_content_attributes()
+                  ->mutable_geometry()
+                  ->mutable_outer_bounding_box();
+  box->set_width(100);
+  box->set_height(12);
+  EXPECT_FALSE(IsPageNodeHidden(*text));
+  box->set_height(4);
+  EXPECT_TRUE(IsPageNodeHidden(*text));
+  EXPECT_TRUE(SerializePageContent(page).text.empty());
+}
+
+TEST(RacAiPageTextTest, TransparentTextColorIsDroppedButMissingColorIsNot) {
+  proto::AnnotatedPageContent page;
+  auto* transparent = Text(page.mutable_root_node(), "Transparent");
+  auto* style = transparent->mutable_content_attributes()
+                    ->mutable_text_data()
+                    ->mutable_text_style();
+  EXPECT_FALSE(IsPageNodeHidden(*transparent));
+  style->set_color(0x00ffffff);
+  EXPECT_TRUE(IsPageNodeHidden(*transparent));
+  style->set_color(0xff000000);
+  EXPECT_FALSE(IsPageNodeHidden(*transparent));
+}
+
+TEST(RacAiPageTextTest, InlineHiddenTextAndHiddenFrameSelectionsAreDropped) {
+  proto::AnnotatedPageContent page;
+  auto* paragraph =
+      Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_PARAGRAPH);
+  Text(paragraph, "Before");
+  auto* hidden = Text(paragraph, "Injected instruction");
+  hidden->mutable_content_attributes()->add_annotated_roles(
+      proto::ANNOTATED_ROLE_CONTENT_HIDDEN);
+  Text(paragraph, "After");
+  auto* frame = Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_IFRAME);
+  frame->mutable_content_attributes()->add_annotated_roles(
+      proto::ANNOTATED_ROLE_CONTENT_HIDDEN);
+  frame->mutable_content_attributes()
+      ->mutable_iframe_data()
+      ->mutable_frame_data()
+      ->mutable_frame_interaction_info()
+      ->mutable_selection()
+      ->set_selected_text("Hidden selection");
+  EXPECT_EQ(SerializePageContent(page).text, "Before After");
+}
+
+TEST(RacAiPageTextTest, MissingGeometryDoesNotDiscardDefaultModeContent) {
+  proto::AnnotatedPageContent page;
+  Paragraph(page.mutable_root_node(), "Unknown geometry");
+  auto* node = Paragraph(page.mutable_root_node(), "Empty geometry message");
+  node->mutable_content_attributes()->mutable_geometry();
+  EXPECT_EQ(SerializePageContent(page).text,
+            "Unknown geometry\n\nEmpty geometry message");
+}

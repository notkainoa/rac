+TEST(RacAiPageTextTest, ContentOutsideTheViewportIsKept) {
+  // Actionable APC clips the visible box to the viewport, so a long article
+  // has empty visible boxes below the fold and above the scroll position.
+  proto::AnnotatedPageContent page;
+  auto* root = page.mutable_root_node();
+  for (const int position : {-200, 20000}) {
+    auto* offscreen =
+        Paragraph(root, position < 0 ? "Scrolled past" : "Below the fold");
+    auto* geometry =
+        offscreen->mutable_content_attributes()->mutable_geometry();
+    auto* outer = geometry->mutable_outer_bounding_box();
+    outer->set_y(position);
+    outer->set_width(100);
+    outer->set_height(20);
+    geometry->mutable_visible_bounding_box();
+    EXPECT_FALSE(IsPageNodeHidden(*offscreen));
+  }
+  const std::string text = SerializePageContent(page).text;
+  EXPECT_NE(text.find("Scrolled past"), std::string::npos);
+  EXPECT_NE(text.find("Below the fold"), std::string::npos);
+}

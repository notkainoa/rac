+bool IsPageNodeHidden(const proto::ContentNode& node) {
+  const auto& a = node.content_attributes();
+  if (std::ranges::find(a.annotated_roles(),
+                        proto::ANNOTATED_ROLE_CONTENT_HIDDEN) !=
+      a.annotated_roles().end()) {
+    return true;
+  }
+  const auto& reasons = a.interaction_info().interaction_disabled_reasons();
+  if (std::ranges::find(reasons,
+                        proto::INTERACTION_DISABLED_REASON_ARIA_HIDDEN) !=
+      reasons.end()) {
+    return true;
+  }
+  if (a.has_geometry()) {
+    const auto& geometry = a.geometry();
+    if (geometry.has_visible_bounding_box()) {
+      const auto& box = geometry.visible_bounding_box();
+      if (box.width() <= 0 || box.height() <= 0) {
+        return true;
+      }
+    }
+    if (geometry.has_outer_bounding_box()) {
+      const auto& box = geometry.outer_bounding_box();
+      if (box.width() <= 0 || box.height() <= 0) {
+        return true;
+      }
+      // Scale-independent checks; APC's viewport size uses a different scale.
+      if (static_cast<int64_t>(box.x()) + box.width() <= 0 ||
+          static_cast<int64_t>(box.y()) + box.height() <= 0) {
+        return true;
+      }
+      // XS alone also describes legible footnotes. Suppress it only when the
+      // actual rendered line is at most four captured pixels tall.
+      if (a.has_text_data() &&
+          a.text_data().text_style().text_size() == proto::TEXT_SIZE_XS &&
+          box.height() <= 4) {
+        return true;
+      }
+    }
+  }
+  if (a.has_text_data()) {
+    const auto& style = a.text_data().text_style();
+    // Blink's RGBA32 packs alpha in the high byte. This is text color, not
+    // CSS opacity; opacity on an ancestor is not exposed by APC.
+    if (style.has_color() && (style.color() >> 24) == 0) {
+      return true;
+    }
+  }
+  return false;
+}

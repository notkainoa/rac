+#include "chrome/browser/rac/ai/new_tab_page.h"
+
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac::ai {
+
+bool ShouldUseAssistantNewTabPage(const PrefService* prefs) {
+  return prefs->GetBoolean(kEnabled) && prefs->GetBoolean(kNewTabPage);
+}
+
+bool IsAssistantNewTabPageUrl(const GURL& url) {
+  return url.is_valid() && url.spec() == kNewTabPageUrl;
+}
+
+}  // namespace rac::ai
Index: src/chrome/browser/rac/ai/new_tab_page.h
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/new_tab_page.h	2026-10-12 08:24:38.076558619 -0700
@@ -0,0 +1,28 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_NEW_TAB_PAGE_H_
+#define CHROME_BROWSER_RAC_AI_NEW_TAB_PAGE_H_
+
+#include "url/gurl.h"
+
+class PrefService;
+
+namespace rac::ai {
+
+// The assistant's own page, shown as the new tab page when the assistant is on
+// and the user keeps "new tab page" turned on in its settings.
+inline constexpr char kNewTabPageUrl[] = "chrome://rac-ai/?mode=page";
+
+// False while the assistant is off, so a profile that never turned it on keeps
+// Helium's new tab page and does no extra work.
+bool ShouldUseAssistantNewTabPage(const PrefService* prefs);
+
+// True for the exact address the new tab page is rewritten to, so the address
+// bar can show it as a plain new tab.
+bool IsAssistantNewTabPageUrl(const GURL& url);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_NEW_TAB_PAGE_H_
Index: src/chrome/browser/rac/ai/new_tab_page_unittest.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/new_tab_page_unittest.cc	2026-10-12 08:25:01.254345085 -0700
@@ -0,0 +1,41 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/new_tab_page.h"
+
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+
+TEST(RacAiNewTabPageTest, NeedsTheAssistantAndTheSetting) {
+  TestingPrefServiceSimple prefs;
+  RegisterProfilePrefs(prefs.registry());
+  EXPECT_FALSE(ShouldUseAssistantNewTabPage(&prefs));
+
+  prefs.SetBoolean(kEnabled, true);
+  EXPECT_TRUE(ShouldUseAssistantNewTabPage(&prefs));
+
+  prefs.SetBoolean(kNewTabPage, false);
+  EXPECT_FALSE(ShouldUseAssistantNewTabPage(&prefs));
+
+  prefs.SetBoolean(kEnabled, false);
+  prefs.SetBoolean(kNewTabPage, true);
+  EXPECT_FALSE(ShouldUseAssistantNewTabPage(&prefs));
+}
+
+TEST(RacAiNewTabPageTest, RecognizesOnlyItsOwnAddress) {
+  EXPECT_TRUE(IsAssistantNewTabPageUrl(GURL(kNewTabPageUrl)));
+  EXPECT_FALSE(IsAssistantNewTabPageUrl(GURL("chrome://rac-ai/?mode=panel")));
+  EXPECT_FALSE(
+      IsAssistantNewTabPageUrl(GURL("chrome://rac-ai/?mode=page&q=a")));
+  EXPECT_FALSE(IsAssistantNewTabPageUrl(GURL("chrome://rac-ai/")));
+  EXPECT_FALSE(IsAssistantNewTabPageUrl(GURL("https://rac-ai/?mode=page")));
+  EXPECT_FALSE(IsAssistantNewTabPageUrl(GURL("chrome://newtab/")));
+  EXPECT_FALSE(IsAssistantNewTabPageUrl(GURL()));
+}
+
+}  // namespace rac::ai

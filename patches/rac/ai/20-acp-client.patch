+#include "chrome/browser/rac/ai/acp/acp_client.h"
+
+#include <limits>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+
+namespace rac::ai {
+namespace {
+
+bool ValidId(const base::Value& id) {
+  // Reject non-exact numeric IDs rather than rounding an int64 through double.
+  return id.is_int() || id.is_string() || id.is_none();
+}
+
+base::DictValue Envelope() {
+  return base::DictValue().Set("jsonrpc", "2.0");
+}
+
+void MergeTool(base::DictValue& target, const base::DictValue& source) {
+  for (const auto [key, value] : source) {
+    if (!value.is_none()) {
+      target.Set(key, value.Clone());
+    }
+  }
+}
+
+}  // namespace
+
+bool AcpFramer::Feed(std::string_view bytes,
+                     std::vector<base::DictValue>& frames) {
+  if (failed_) {
+    return false;
+  }
+  while (!bytes.empty()) {
+    const size_t end = bytes.find('\n');
+    const size_t count = end == std::string_view::npos ? bytes.size() : end;
+    if (buffer_.size() + count > kAcpMaxFrameBytes) {
+      failed_ = true;
+      return false;
+    }
+    buffer_.append(bytes.substr(0, count));
+    bytes.remove_prefix(count);
+    if (end == std::string_view::npos) {
+      break;
+    }
+    bytes.remove_prefix(1);
+    if (!buffer_.empty() && buffer_.back() == '\r') {
+      buffer_.pop_back();
+    }
+    // A stray blank line is noise, not a broken frame.
+    if (buffer_.empty()) {
+      continue;
+    }
+    if (!base::IsStringUTF8(buffer_)) {
+      failed_ = true;
+      return false;
+    }
+    auto parsed = base::JSONReader::ReadAndReturnValueWithError(
+        buffer_, base::JSON_PARSE_RFC);
+    if (!parsed.has_value() || !parsed->is_dict()) {
+      failed_ = true;
+      return false;
+    }
+    auto dict = std::move(*parsed).TakeDict();
+    const std::string* version = dict.FindString("jsonrpc");
+    const base::Value* id = dict.Find("id");
+    const base::Value* method = dict.Find("method");
+    const bool response = dict.contains("result") != dict.contains("error");
+    if (!version || *version != "2.0" || (id && !ValidId(*id)) ||
+        (method && (!method->is_string() || method->GetString().empty() ||
+                    dict.contains("result") || dict.contains("error"))) ||
+        (!method && (!id || !response))) {
+      failed_ = true;
+      return false;
+    }
+    frames.push_back(std::move(dict));
+    buffer_.clear();
+  }
+  return true;
+}
+
+bool AcpFramer::Finish() {
+  failed_ = failed_ || !buffer_.empty();
+  return !failed_;
+}
+
+AcpClient::AcpClient(Write write, base::RepeatingClosure close, Update update)
+    : write_(std::move(write)),
+      close_(std::move(close)),
+      update_(std::move(update)) {}
+
+AcpClient::~AcpClient() {
+  Stop();
+}
+
+void AcpClient::SetPermissionPolicy(PermissionPolicy policy) {
+  policy_ = std::move(policy);
+}
+
+void AcpClient::ArmDeadline(base::TimeDelta timeout) {
+  deadline_.Start(FROM_HERE, timeout,
+                  base::BindOnce(&AcpClient::Fail, weak_factory_.GetWeakPtr(),
+                                 "The agent timed out."));
+}
+
+void AcpClient::Start(base::DictValue session_params, Completion ready) {
+  CHECK_EQ(state_, State::kStopped);
+  session_params_ = std::move(session_params);
+  ready_ = std::move(ready);
+  state_ = State::kInitializing;
+  ArmDeadline(base::Seconds(45));
+  Send(Request::kInitialize, "initialize",
+       base::DictValue()
+           .Set("protocolVersion", 1)
+           .Set("clientInfo",
+                base::DictValue().Set("name", "rac").Set("version", "0.1"))
+           .Set("clientCapabilities",
+                base::DictValue()
+                    .Set("fs", base::DictValue()
+                                   .Set("readTextFile", false)
+                                   .Set("writeTextFile", false))
+                    .Set("terminal", false)));
+}
+
+void AcpClient::Send(Request request,
+                     std::string method,
+                     base::DictValue params) {
+  if (next_id_ == std::numeric_limits<int>::max()) {
+    Fail("The agent connection needs to restart.");
+    return;
+  }
+  const int id = next_id_++;
+  pending_.emplace(id, request);
+  write_.Run(Envelope()
+                 .Set("id", id)
+                 .Set("method", std::move(method))
+                 .Set("params", std::move(params)));
+}
+
+void AcpClient::Notify(std::string method, base::DictValue params) {
+  write_.Run(Envelope()
+                 .Set("method", std::move(method))
+                 .Set("params", std::move(params)));
+}
+
+void AcpClient::CreateSession() {
+  state_ = State::kCreating;
+  Send(Request::kNew, "session/new", session_params_.Clone());
+}
+
+void AcpClient::Authenticate(std::string method_id, Completion ready) {
+  if (state_ != State::kNeedsAuth) {
+    std::move(ready).Run("The agent is not waiting for sign-in.");
+    return;
+  }
+  const base::ListValue* methods = initialize_result_.FindList("authMethods");
+  bool found = false;
+  if (methods) {
+    for (const auto& method : *methods) {
+      if (method.is_dict() && method.GetDict().FindString("id") &&
+          *method.GetDict().FindString("id") == method_id) {
+        found = true;
+      }
+    }
+  }
+  if (!found) {
+    std::move(ready).Run("The agent did not offer that sign-in method.");
+    return;
+  }
+  ready_ = std::move(ready);
+  state_ = State::kInitializing;
+  ArmDeadline(base::Minutes(5));
+  Send(Request::kAuthenticate, "authenticate",
+       base::DictValue().Set("methodId", std::move(method_id)));
+}
+
+void AcpClient::Prompt(std::string text, Completion done) {
+  if (state_ != State::kReady) {
+    std::move(done).Run("The agent is not ready for another message.");
+    return;
+  }
+  idle_.Stop();
+  tools_.clear();
+  tool_bytes_ = 0;
+  done_ = std::move(done);
+  state_ = State::kPrompting;
+  ArmDeadline(base::Minutes(10));
+  Send(Request::kPrompt, "session/prompt",
+       base::DictValue()
+           .Set("sessionId", session_id_)
+           .Set("prompt",
+                base::ListValue().Append(base::DictValue()
+                                             .Set("type", "text")
+                                             .Set("text", std::move(text)))));
+}
+
+void AcpClient::Receive(base::DictValue message) {
+  if (state_ == State::kFailed || state_ == State::kStopped) {
+    return;
+  }
+  const std::string* method = message.FindString("method");
+  const base::Value* id = message.Find("id");
+  if (!method) {
+    const std::optional<int> number = message.FindInt("id");
+    if (!number) {
+      return;
+    }
+    const auto it = pending_.find(*number);
+    if (it == pending_.end()) {
+      return;
+    }
+    const Request request = it->second;
+    pending_.erase(it);
+    OnResponse(request, message);
+    return;
+  }
+  const base::DictValue* params = message.FindDict("params");
+  if (id) {
+    if (*method == "session/request_permission" && params) {
+      OnPermission(id->Clone(), *params);
+    } else {
+      write_.Run(Envelope()
+                     .Set("id", id->Clone())
+                     .Set("error",
+                          base::DictValue()
+                              .Set("code", params ? -32601 : -32602)
+                              .Set("message", "Method not supported by rac")));
+    }
+    return;
+  }
+  if (*method != "session/update") {
+    return;
+  }
+  const std::string* session =
+      params ? params->FindString("sessionId") : nullptr;
+  const base::DictValue* update = params ? params->FindDict("update") : nullptr;
+  const std::string* kind =
+      update ? update->FindString("sessionUpdate") : nullptr;
+  if (!session || !update || !kind) {
+    Fail("Invalid agent session update.");
+    return;
+  }
+  if (*session != session_id_ || state_ == State::kCancelling) {
+    return;
+  }
+  if (*kind == "tool_call" || *kind == "tool_call_update") {
+    const std::string* tool_id = update->FindString("toolCallId");
+    if (!tool_id || tool_id->empty()) {
+      Fail("Invalid agent tool update.");
+      return;
+    }
+    tool_bytes_ += base::WriteJson(*update).value_or("").size();
+    if (tools_.size() >= 1024 || tool_bytes_ > kAcpMaxFrameBytes) {
+      Fail("Agent tool state is too large.");
+      return;
+    }
+    MergeTool(tools_[*tool_id], *update);
+  }
+  update_.Run(update->Clone());
+}
+
+void AcpClient::OnResponse(Request request, const base::DictValue& message) {
+  const base::DictValue* error = message.FindDict("error");
+  if (error) {
+    const std::string* text = error->FindString("message");
+    std::string reason = text ? *text : "The agent reported an error.";
+    if (request == Request::kNew && error->FindInt("code") == -32000) {
+      state_ = State::kNeedsAuth;
+      deadline_.Stop();
+      if (ready_) {
+        std::move(ready_).Run(reason);
+      }
+      return;
+    }
+    Fail(std::move(reason));
+    return;
+  }
+  const base::DictValue* result = message.FindDict("result");
+  if (!result) {
+    Fail("Invalid agent response.");
+    return;
+  }
+  switch (request) {
+    case Request::kInitialize:
+      if (result->FindInt("protocolVersion") != 1) {
+        Fail("The agent does not support ACP v1.");
+        return;
+      }
+      initialize_result_ = result->Clone();
+      CreateSession();
+      break;
+    case Request::kAuthenticate:
+      CreateSession();
+      break;
+    case Request::kNew: {
+      const std::string* session = result->FindString("sessionId");
+      if (!session || session->empty()) {
+        Fail("The agent did not create a session.");
+        return;
+      }
+      session_id_ = *session;
+      session_info_ = result->Clone();
+      state_ = State::kReady;
+      deadline_.Stop();
+      idle_.Start(FROM_HERE, base::Seconds(120), this, &AcpClient::Stop);
+      if (ready_) {
+        std::move(ready_).Run("");
+      }
+      break;
+    }
+    case Request::kPrompt:
+      if (!result->FindString("stopReason")) {
+        Fail("Invalid agent prompt result.");
+        return;
+      }
+      state_ = State::kReady;
+      deadline_.Stop();
+      CancelPermissions();
+      idle_.Start(FROM_HERE, base::Seconds(120), this, &AcpClient::Stop);
+      FinishTurn("");
+      break;
+  }
+}
+
+void AcpClient::OnPermission(base::Value id, const base::DictValue& params) {
+  const base::DictValue* tool = params.FindDict("toolCall");
+  const std::string* tool_id = tool ? tool->FindString("toolCallId") : nullptr;
+  const base::ListValue* options = params.FindList("options");
+  const std::string* session = params.FindString("sessionId");
+  if (!tool_id || !options || !session || *session != session_id_ ||
+      state_ != State::kPrompting) {
+    ReplyPermission(std::move(id), "");
+    return;
+  }
+  Permission permission{.id = std::move(id)};
+  for (const auto& value : *options) {
+    const base::DictValue* option = value.GetIfDict();
+    const std::string* kind = option ? option->FindString("kind") : nullptr;
+    const std::string* option_id =
+        option ? option->FindString("optionId") : nullptr;
+    if (!kind || !option_id || option_id->empty()) {
+      continue;
+    }
+    if (*kind == "allow_once") {
+      permission.allow = *option_id;
+    }
+    if (*kind == "reject_once" ||
+        (*kind == "reject_always" && permission.reject.empty())) {
+      permission.reject = *option_id;
+    }
+  }
+  if (permissions_.size() >= 64) {
+    ReplyPermission(std::move(permission.id), "");
+    Cancel();
+    return;
+  }
+  const int token = next_permission_++;
+  permissions_.emplace(token, std::move(permission));
+  base::DictValue merged;
+  if (auto it = tools_.find(*tool_id); it != tools_.end()) {
+    merged = it->second.Clone();
+  }
+  MergeTool(merged, *tool);
+  if (!policy_) {
+    DecidePermission(token, false);
+    return;
+  }
+  policy_.Run(merged, base::BindOnce(&AcpClient::DecidePermission,
+                                     weak_factory_.GetWeakPtr(), token));
+}
+
+void AcpClient::ReplyPermission(base::Value id, std::string option_id) {
+  base::DictValue outcome;
+  if (option_id.empty()) {
+    outcome.Set("outcome", "cancelled");
+  } else {
+    outcome.Set("outcome", "selected");
+    outcome.Set("optionId", std::move(option_id));
+  }
+  write_.Run(
+      Envelope()
+          .Set("id", std::move(id))
+          .Set("result", base::DictValue().Set("outcome", std::move(outcome))));
+}
+
+void AcpClient::DecidePermission(int token, bool allow) {
+  auto it = permissions_.find(token);
+  if (it == permissions_.end()) {
+    return;
+  }
+  Permission permission = std::move(it->second);
+  permissions_.erase(it);
+  std::string option = allow ? permission.allow : permission.reject;
+  const bool cancel = option.empty();
+  ReplyPermission(std::move(permission.id), std::move(option));
+  if (cancel) {
+    Cancel();
+  }
+}
+
+void AcpClient::CancelPermissions() {
+  auto permissions = std::move(permissions_);
+  permissions_.clear();
+  for (auto& [token, permission] : permissions) {
+    ReplyPermission(std::move(permission.id), "");
+  }
+}
+
+void AcpClient::FinishTurn(std::string error) {
+  if (done_) {
+    std::move(done_).Run(std::move(error));
+  }
+}
+
+void AcpClient::Cancel() {
+  if (state_ != State::kPrompting) {
+    return;
+  }
+  state_ = State::kCancelling;
+  Notify("session/cancel", base::DictValue().Set("sessionId", session_id_));
+  CancelPermissions();
+  ArmDeadline(base::Seconds(3));
+  FinishTurn("Cancelled");
+}
+
+void AcpClient::TearDown(State next, std::string error, bool send_cancel) {
+  if (state_ == State::kFailed || state_ == State::kStopped) {
+    return;
+  }
+  if (send_cancel && state_ == State::kPrompting && !session_id_.empty()) {
+    Notify("session/cancel", base::DictValue().Set("sessionId", session_id_));
+  }
+  CancelPermissions();
+  state_ = next;
+  deadline_.Stop();
+  idle_.Stop();
+  pending_.clear();
+  close_.Run();
+  if (ready_) {
+    std::move(ready_).Run(error.empty() ? "Cancelled" : error);
+  }
+  FinishTurn(std::move(error));
+}
+
+void AcpClient::Stop() {
+  TearDown(State::kStopped, "Cancelled", /*send_cancel=*/true);
+}
+
+void AcpClient::Fail(std::string error) {
+  TearDown(State::kFailed, std::move(error), /*send_cancel=*/true);
+}
+
+}  // namespace rac::ai

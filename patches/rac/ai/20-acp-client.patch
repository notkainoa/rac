+#ifndef CHROME_BROWSER_RAC_AI_ACP_ACP_CLIENT_H_
+#define CHROME_BROWSER_RAC_AI_ACP_ACP_CLIENT_H_
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+
+namespace rac::ai {
+
+inline constexpr size_t kAcpMaxFrameBytes = 8 * 1024 * 1024;
+
+// Fatal on any malformed frame, including an incomplete final line.
+class AcpFramer {
+ public:
+  bool Feed(std::string_view bytes, std::vector<base::DictValue>& frames);
+  bool Finish();
+  bool failed() const { return failed_; }
+
+ private:
+  std::string buffer_;
+  bool failed_ = false;
+};
+
+// Sequence-confined protocol state machine. Write and close must not delete
+// the client synchronously. No process or thread is created by this class.
+class AcpClient {
+ public:
+  enum class State {
+    kStopped,
+    kInitializing,
+    kNeedsAuth,
+    kCreating,
+    kReady,
+    kPrompting,
+    kCancelling,
+    kFailed,
+  };
+
+  using Write = base::RepeatingCallback<void(base::DictValue)>;
+  using Update = base::RepeatingCallback<void(base::DictValue)>;
+  using Completion = base::OnceCallback<void(std::string error)>;
+  // Merged tool state is untrusted metadata. Only approve an identified rac
+  // tool; the MCP server must authorize every browser action independently.
+  using PermissionPolicy = base::RepeatingCallback<void(
+      const base::DictValue& tool,
+      base::OnceCallback<void(bool allow)> decision)>;
+
+  AcpClient(Write write, base::RepeatingClosure close, Update update);
+  ~AcpClient();
+
+  void Start(base::DictValue session_params, Completion ready);
+  void Authenticate(std::string method_id, Completion ready);
+  void Prompt(std::string text, Completion done);
+  void Cancel();
+  void Stop();
+  void Receive(base::DictValue message);
+  void Fail(std::string error);
+  void SetPermissionPolicy(PermissionPolicy policy);
+
+  State state() const { return state_; }
+  const std::string& session_id() const { return session_id_; }
+  const base::DictValue& session_info() const { return session_info_; }
+  const base::DictValue& initialize_result() const {
+    return initialize_result_;
+  }
+
+ private:
+  enum class Request { kInitialize, kAuthenticate, kNew, kPrompt };
+
+  void Send(Request request, std::string method, base::DictValue params);
+  void CreateSession();
+  void OnResponse(Request request, const base::DictValue& message);
+  void OnPermission(base::Value id, const base::DictValue& params);
+  void DecidePermission(int token, bool allow);
+  void ReplyPermission(base::Value id, std::string option_id);
+  void CancelPermissions();
+  void Notify(std::string method, base::DictValue params);
+  void ArmDeadline(base::TimeDelta timeout);
+  void FinishTurn(std::string error);
+  void TearDown(State next, std::string error, bool send_cancel);
+
+  struct Permission {
+    base::Value id;
+    std::string allow;
+    std::string reject;
+  };
+
+  Write write_;
+  base::RepeatingClosure close_;
+  Update update_;
+  PermissionPolicy policy_;
+  State state_ = State::kStopped;
+  int next_id_ = 1;
+  int next_permission_ = 1;
+  std::map<int, Request> pending_;
+  std::map<int, Permission> permissions_;
+  std::map<std::string, base::DictValue> tools_;
+  size_t tool_bytes_ = 0;
+  std::string session_id_;
+  base::DictValue session_params_;
+  base::DictValue initialize_result_;
+  base::DictValue session_info_;
+  Completion ready_;
+  Completion done_;
+  base::OneShotTimer deadline_;
+  base::OneShotTimer idle_;
+  base::WeakPtrFactory<AcpClient> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_ACP_ACP_CLIENT_H_

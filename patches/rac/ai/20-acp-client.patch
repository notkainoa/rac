+base::DictValue Line(std::string_view json) {
+  auto value = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  CHECK(value);
+  CHECK(value->is_dict());
+  return std::move(*value).TakeDict();
+}
+
+class AcpFramerTest : public testing::Test {};
+
+TEST_F(AcpFramerTest, SplitsAcrossChunksAndStripsCr) {
+  AcpFramer framer;
+  std::vector<base::DictValue> frames;
+  EXPECT_TRUE(framer.Feed(R"({"jsonrpc":"2.0","id":1,"result":{})", frames));
+  EXPECT_TRUE(frames.empty());
+  EXPECT_TRUE(framer.Feed("}\r\n", frames));
+  ASSERT_EQ(frames.size(), 1u);
+  EXPECT_EQ(frames[0].FindInt("id"), 1);
+  EXPECT_TRUE(framer.Finish());
+}
+
+TEST_F(AcpFramerTest, BlankLinesAreSkipped) {
+  AcpFramer framer;
+  std::vector<base::DictValue> frames;
+  EXPECT_TRUE(framer.Feed(
+      "\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n\n", frames));
+  EXPECT_EQ(frames.size(), 1u);
+  EXPECT_TRUE(framer.Finish());
+}
+
+TEST_F(AcpFramerTest, MalformedLineIsFatal) {
+  AcpFramer framer;
+  std::vector<base::DictValue> frames;
+  EXPECT_FALSE(framer.Feed("not-json\n", frames));
+  EXPECT_TRUE(framer.failed());
+  EXPECT_FALSE(
+      framer.Feed("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n", frames));
+}
+
+TEST_F(AcpFramerTest, IncompleteEofIsFatal) {
+  AcpFramer framer;
+  std::vector<base::DictValue> frames;
+  EXPECT_TRUE(framer.Feed("{\"jsonrpc\":\"2.0\"", frames));
+  EXPECT_FALSE(framer.Finish());
+}
+
+TEST_F(AcpFramerTest, OversizedFrameIsFatal) {
+  AcpFramer framer;
+  std::vector<base::DictValue> frames;
+  std::string big(kAcpMaxFrameBytes + 1, 'x');
+  EXPECT_FALSE(framer.Feed(big, frames));
+}
+
+class AcpClientTest : public testing::Test {
+ public:
+  AcpClientTest() {
+    client_ = std::make_unique<AcpClient>(
+        base::BindLambdaForTesting([&](base::DictValue message) {
+          written_.push_back(std::move(message));
+        }),
+        base::BindLambdaForTesting([&] { ++closes_; }),
+        base::BindLambdaForTesting([&](base::DictValue update) {
+          updates_.push_back(std::move(update));
+        }));
+  }
+
+  void Deliver(std::string_view json) { client_->Receive(Line(json)); }
+
+  base::test::TaskEnvironment env_;
+  std::unique_ptr<AcpClient> client_;
+  std::vector<base::DictValue> written_;
+  std::vector<base::DictValue> updates_;
+  int closes_ = 0;
+};
+
+TEST_F(AcpClientTest, InitializeAdvertisesNoFsOrTerminal) {
+  bool ready = false;
+  client_->Start(base::DictValue().Set("cwd", "/tmp/scratch"),
+                 base::BindLambdaForTesting([&](std::string error) {
+                   EXPECT_TRUE(error.empty());
+                   ready = true;
+                 }));
+  ASSERT_EQ(written_.size(), 1u);
+  EXPECT_EQ(*written_[0].FindString("method"), "initialize");
+  const base::DictValue* caps =
+      written_[0].FindDict("params")->FindDict("clientCapabilities");
+  ASSERT_TRUE(caps);
+  EXPECT_EQ(caps->FindBool("terminal"), std::optional<bool>(false));
+  const base::DictValue* fs = caps->FindDict("fs");
+  ASSERT_TRUE(fs);
+  EXPECT_EQ(fs->FindBool("readTextFile"), std::optional<bool>(false));
+  EXPECT_EQ(fs->FindBool("writeTextFile"), std::optional<bool>(false));
+
+  Deliver(R"({"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1,
+      "agentInfo":{"name":"fake","version":"1"},
+      "agentCapabilities":{},"authMethods":[]}})");
+  ASSERT_EQ(written_.size(), 2u);
+  EXPECT_EQ(*written_[1].FindString("method"), "session/new");
+  Deliver(R"({"jsonrpc":"2.0","id":2,"result":{"sessionId":"s1"}})");
+  EXPECT_TRUE(ready);
+  EXPECT_EQ(client_->state(), AcpClient::State::kReady);
+}
+
+TEST_F(AcpClientTest, StreamsChunksAndRejectsPermissionsByDefault) {
+  client_->Start(base::DictValue().Set("cwd", "/tmp"),
+                 base::BindLambdaForTesting([](std::string) {}));
+  Deliver(R"({"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1}})");
+  Deliver(R"({"jsonrpc":"2.0","id":2,"result":{"sessionId":"s1"}})");
+
+  std::string done_error = "unset";
+  client_->Prompt("hi", base::BindLambdaForTesting(
+                            [&](std::string error) { done_error = error; }));
+  Deliver(
+      R"({"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"s1",
+      "update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text",
+      "text":"Hello"}}}})");
+  Deliver(
+      R"({"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"s1",
+      "update":{"sessionUpdate":"tool_call","toolCallId":"t1","title":"Shell",
+      "kind":"execute","status":"pending"}}})");
+  Deliver(
+      R"({"jsonrpc":"2.0","id":"permission-1","method":"session/request_permission",
+      "params":{"sessionId":"s1","toolCall":{"toolCallId":"t1"},
+      "options":[{"optionId":"yes","name":"Allow","kind":"allow_once"},
+                 {"optionId":"no","name":"Reject","kind":"reject_once"}]}})");
+
+  ASSERT_FALSE(updates_.empty());
+  EXPECT_EQ(*updates_[0].FindString("sessionUpdate"), "agent_message_chunk");
+  const base::DictValue* reply = nullptr;
+  for (const auto& message : written_) {
+    if (message.FindString("id") &&
+        *message.FindString("id") == "permission-1") {
+      reply = &message;
+    }
+  }
+  ASSERT_TRUE(reply);
+  EXPECT_EQ(
+      *reply->FindDict("result")->FindDict("outcome")->FindString("optionId"),
+      "no");
+
+  Deliver(R"({"jsonrpc":"2.0","id":3,"result":{"stopReason":"end_turn"}})");
+  EXPECT_EQ(done_error, "");
+}
+
+TEST_F(AcpClientTest, CancelAnswersPendingPermissionAndFinishes) {
+  client_->Start(base::DictValue().Set("cwd", "/tmp"),
+                 base::BindLambdaForTesting([](std::string) {}));
+  Deliver(R"({"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1}})");
+  Deliver(R"({"jsonrpc":"2.0","id":2,"result":{"sessionId":"s1"}})");
+  // Hold the permission open until Cancel replies with outcome:cancelled.
+  client_->SetPermissionPolicy(base::BindLambdaForTesting(
+      [](const base::DictValue&, base::OnceCallback<void(bool)>) {}));
+
+  std::string done_error;
+  client_->Prompt("hi", base::BindLambdaForTesting(
+                            [&](std::string error) { done_error = error; }));
+  Deliver(
+      R"({"jsonrpc":"2.0","id":"p1","method":"session/request_permission",
+      "params":{"sessionId":"s1","toolCall":{"toolCallId":"t1"},
+      "options":[{"optionId":"no","name":"Reject","kind":"reject_once"}]}})");
+  client_->Cancel();
+  EXPECT_EQ(done_error, "Cancelled");
+  bool saw_cancel_outcome = false;
+  bool saw_session_cancel = false;
+  for (const auto& message : written_) {
+    if (const std::string* method = message.FindString("method");
+        method && *method == "session/cancel") {
+      saw_session_cancel = true;
+    }
+    if (const std::string* id = message.FindString("id"); id && *id == "p1") {
+      const base::DictValue* outcome =
+          message.FindDict("result")
+              ? message.FindDict("result")->FindDict("outcome")
+              : nullptr;
+      if (outcome && outcome->FindString("outcome") &&
+          *outcome->FindString("outcome") == "cancelled") {
+        saw_cancel_outcome = true;
+      }
+    }
+  }
+  EXPECT_TRUE(saw_session_cancel);
+  EXPECT_TRUE(saw_cancel_outcome);
+}

+
+constexpr char kCommonDirs[] =
+    "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin";
+
+void AppendUnique(std::vector<std::string>& out,
+                  std::string_view entry,
+                  std::string_view home) {
+  if (entry.empty()) {
+    return;
+  }
+  std::string path(entry);
+  if (base::StartsWith(path, "~/")) {
+    if (home.empty()) {
+      return;
+    }
+    path = std::string(home) + path.substr(1);
+  } else if (path == "~") {
+    if (home.empty()) {
+      return;
+    }
+    path = std::string(home);
+  }
+  if (path.empty() || path[0] != '/') {
+    return;
+  }
+  for (const std::string& existing : out) {
+    if (existing == path) {
+      return;
+    }
+  }
+  out.push_back(std::move(path));
+}
+
+void AppendColonList(std::vector<std::string>& out,
+                     std::string_view list,
+                     std::string_view home) {
+  for (std::string_view part : base::SplitStringPiece(
+           list, ":", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    AppendUnique(out, part, home);
+  }
+}
+
+std::string JoinColon(const std::vector<std::string>& parts) {
+  return base::JoinString(parts, ":");
+}
+
+struct ProbeResult {
+  std::string path;
+  std::string error;
+};
+
+ProbeResult ProbeLoginShellPath() {
+  ProbeResult result;
+  auto env = base::Environment::Create();
+  std::string home = env->GetVar("HOME").value_or("");
+  std::string inherited = env->GetVar("PATH").value_or("");
+  std::string shell = env->GetVar("SHELL").value_or("/bin/zsh");
+  if (shell.empty() || shell[0] != '/' || access(shell.c_str(), X_OK) != 0) {
+    shell = "/bin/zsh";
+  }
+
+  const std::string nonce =
+      base::HexEncode(base::as_byte_span(base::RandBytesAsVector(8)));
+  const std::string script = LoginShellPathScript(nonce);
+
+  base::ScopedFD parent_stdout_read;
+  base::ScopedFD child_stdout_write;
+  base::ScopedFD parent_stderr_read;
+  base::ScopedFD child_stderr_write;
+  if (!base::CreatePipe(&parent_stdout_read, &child_stdout_write, false) ||
+      !base::CreatePipe(&parent_stderr_read, &child_stderr_write, false)) {
+    result.error = "Could not create pipes for PATH discovery.";
+    return result;
+  }
+
+  base::FilePath scratch;
+  if (!base::GetTempDir(&scratch)) {
+    result.error = "Could not find a temporary directory.";
+    return result;
+  }
+
+  base::LaunchOptions options;
+  options.current_directory = scratch;
+  options.new_process_group = true;
+  options.fds_to_remap.emplace_back(child_stdout_write.get(), STDOUT_FILENO);
+  options.fds_to_remap.emplace_back(child_stderr_write.get(), STDERR_FILENO);
+#if BUILDFLAG(IS_MAC)
+  options.disclaim_responsibility = true;
+#endif
+
+  std::vector<std::string> argv = {shell, "-ilc", script};
+  base::Process process = base::LaunchProcess(argv, options);
+  child_stdout_write.reset();
+  child_stderr_write.reset();
+  if (!process.IsValid() || process.Pid() <= 1) {
+    result.error = "Could not start the login shell.";
+    return result;
+  }
+
+  const base::ProcessId pid = process.Pid();
+  std::string stdout_text;
+  std::string stderr_text;
+  char buffer[4096];
+  bool timed_out = false;
+  const base::TimeTicks deadline = base::TimeTicks::Now() + base::Seconds(5);
+  for (;;) {
+    bool progressed = false;
+    for (base::ScopedFD* fd : {&parent_stdout_read, &parent_stderr_read}) {
+      if (!fd->is_valid()) {
+        continue;
+      }
+      const ssize_t got = HANDLE_EINTR(read(fd->get(), buffer, sizeof(buffer)));
+      if (got > 0) {
+        progressed = true;
+        std::string* target =
+            fd == &parent_stdout_read ? &stdout_text : &stderr_text;
+        if (target->size() < 64 * 1024) {
+          target->append(buffer, static_cast<size_t>(got));
+        }
+      } else if (got == 0) {
+        fd->reset();
+        progressed = true;
+      }
+    }
+    if (!parent_stdout_read.is_valid() && !parent_stderr_read.is_valid()) {
+      break;
+    }
+    if (base::TimeTicks::Now() >= deadline) {
+      timed_out = true;
+      break;
+    }
+    if (!progressed) {
+      usleep(20 * 1000);
+    }
+  }
+
+  if (timed_out) {
+    kill(-pid, SIGTERM);
+  }
+  if (!process.WaitForExitWithTimeout(base::Seconds(1), nullptr)) {
+    kill(-pid, SIGKILL);
+    process.WaitForExitWithTimeout(base::Seconds(1), nullptr);
+  }
+  process.Close();
+
+  std::optional<std::string> parsed =
+      timed_out ? std::nullopt : ParseLoginShellPath(stdout_text, nonce);
+  if (!parsed) {
+    std::string launchctl_out;
+    int exit_code = 0;
+    if (base::GetAppOutputWithExitCode({"/bin/launchctl", "getenv", "PATH"},
+                                       &launchctl_out, &exit_code) &&
+        exit_code == 0 && !launchctl_out.empty() &&
+        launchctl_out.find('\0') == std::string::npos) {
+      base::TrimString(launchctl_out, "\r\n", &launchctl_out);
+      parsed = launchctl_out;
+    }
+  }
+  if (!parsed) {
+    parsed = inherited;
+  }
+
+  result.path = MergeSearchPath(*parsed, inherited, home);
+  if (result.path.empty()) {
+    result.error = "No executable search path is available.";
+  }
+
+  const base::FilePath npm = FindExecutableOnPath("npm", result.path);
+  if (!npm.empty()) {
+    std::string prefix;
+    int exit_code = 0;
+    if (base::GetAppOutputWithExitCode({npm.value(), "prefix", "--global"},
+                                       &prefix, &exit_code) &&
+        exit_code == 0) {
+      base::TrimString(prefix, "\r\n", &prefix);
+      if (!prefix.empty() && prefix[0] == '/') {
+        result.path = MergeSearchPath(prefix + "/bin", result.path, home);
+      }
+    }
+  }
+
+  // Common user bins that may be missing from a restricted shell.
+  std::string extras;
+  if (!home.empty()) {
+    extras =
+        home + "/.local/bin:" + home + "/.bun/bin:" + home + "/.npm-global/bin";
+  }
+  result.path = MergeSearchPath(result.path, extras, home);
+  result.path = MergeSearchPath(result.path, kCommonDirs, home);
+  return result;
+}
+
+}  // namespace
+
+std::string MergeSearchPath(std::string_view discovered,
+                            std::string_view inherited,
+                            std::string_view home_dir) {
+  std::vector<std::string> parts;
+  AppendColonList(parts, discovered, home_dir);
+  AppendColonList(parts, inherited, home_dir);
+  return JoinColon(parts);
+}
+
+std::optional<std::string> ParseLoginShellPath(std::string_view stdout_text,
+                                               std::string_view nonce) {
+  if (nonce.empty() || stdout_text.find('\0') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  const std::string begin_tag =
+      base::StringPrintf("RAC_PATH_%s_BEGIN", std::string(nonce).c_str());
+  const std::string end_tag =
+      base::StringPrintf("RAC_PATH_%s_END", std::string(nonce).c_str());
+  const size_t first_begin = stdout_text.find(begin_tag);
+  if (first_begin == std::string_view::npos) {
+    return std::nullopt;
+  }
+  if (stdout_text.find(begin_tag, first_begin + begin_tag.size()) !=
+      std::string_view::npos) {
+    return std::nullopt;
+  }
+  const size_t after_begin = first_begin + begin_tag.size();
+  if (after_begin >= stdout_text.size() || stdout_text[after_begin] != '\n') {
+    return std::nullopt;
+  }
+  const size_t path_start = after_begin + 1;
+  const size_t end_pos = stdout_text.find(end_tag, path_start);
+  if (end_pos == std::string_view::npos) {
+    return std::nullopt;
+  }
+  if (stdout_text.find(end_tag, end_pos + end_tag.size()) !=
+      std::string_view::npos) {
+    return std::nullopt;
+  }
+  if (end_pos == 0 || stdout_text[end_pos - 1] != '\n') {
+    return std::nullopt;
+  }
+  std::string_view path =
+      stdout_text.substr(path_start, end_pos - 1 - path_start);
+  if (path.find('\n') != std::string_view::npos ||
+      path.find('\r') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  return std::string(path);
+}
+
+std::string LoginShellPathScript(std::string_view nonce) {
+  return base::StringPrintf(
+      "printf '\\nRAC_PATH_%s_BEGIN\\n%%s\\nRAC_PATH_%s_END\\n' \"$PATH\"",
+      std::string(nonce).c_str(), std::string(nonce).c_str());
+}
+
+base::FilePath FindExecutableOnPath(std::string_view name,
+                                    std::string_view search_path) {
+  if (name.empty() || name.find('/') != std::string_view::npos) {
+    return base::FilePath();
+  }
+  for (std::string_view dir :
+       base::SplitStringPiece(search_path, ":", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (dir.empty() || dir[0] != '/') {
+      continue;
+    }
+    base::FilePath candidate =
+        base::FilePath(dir).Append(base::FilePath::FromUTF8Unsafe(name));
+    if (access(candidate.value().c_str(), X_OK) == 0) {
+      return candidate;
+    }
+  }
+  return base::FilePath();
+}
+
+AgentPathCache::AgentPathCache() = default;
+AgentPathCache::~AgentPathCache() = default;
+
+void AgentPathCache::Invalidate() {
+  search_path_.clear();
+  probing_ = false;
+  waiters_.clear();
+}
+
+void AgentPathCache::SetOverride(std::string name,
+                                 base::FilePath absolute_path) {
+  if (name.empty()) {
+    return;
+  }
+  if (absolute_path.empty()) {
+    overrides_.erase(name);
+    return;
+  }
+  overrides_[std::move(name)] = std::move(absolute_path);
+}
+
+base::FilePath AgentPathCache::Resolve(std::string_view name) const {
+  if (auto it = overrides_.find(std::string(name)); it != overrides_.end()) {
+    return it->second;
+  }
+  if (search_path_.empty()) {
+    return base::FilePath();
+  }
+  return FindExecutableOnPath(name, search_path_);
+}
+
+void AgentPathCache::Ensure(ReadyCallback done) {
+  if (!search_path_.empty()) {
+    std::move(done).Run(search_path_, "");
+    return;
+  }
+  waiters_.push_back(std::move(done));
+  if (probing_) {
+    return;
+  }
+  probing_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ProbeLoginShellPath),
+      base::BindOnce(
+          [](base::WeakPtr<AgentPathCache> self, ProbeResult result) {
+            if (!self) {
+              return;
+            }
+            self->OnProbed(std::move(result.path), std::move(result.error));
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void AgentPathCache::OnProbed(std::string search_path, std::string error) {
+  probing_ = false;
+  search_path_ = std::move(search_path);
+  auto waiters = std::move(waiters_);
+  waiters_.clear();
+  for (auto& waiter : waiters) {
+    std::move(waiter).Run(search_path_, error);
+  }
+}

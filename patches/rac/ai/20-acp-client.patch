+#include "base/values.h"
+#include "chrome/browser/rac/ai/acp/acp_client.h"
+
+namespace rac::ai {
+
+struct AcpLaunchSpec {
+  std::vector<std::string> argv;
+  base::FilePath cwd;
+  std::map<std::string, std::string> environment;
+  // When true, clear the inherited environment first and only apply
+  // `environment`. When false, overlay `environment` on the current process.
+  bool clear_environment = false;
+};
+
+// Owns one ACP child process and its stdio pipes. Construct and use only on a
+// MayBlock sequenced task runner. Frames are newline-delimited JSON objects.
+class AcpTransport {
+ public:
+  using MessageCallback = base::RepeatingCallback<void(base::DictValue)>;
+  using StatusCallback = base::OnceCallback<void(std::string error)>;
+
+  AcpTransport();
+  AcpTransport(const AcpTransport&) = delete;
+  AcpTransport& operator=(const AcpTransport&) = delete;
+  ~AcpTransport();
+
+  // Launch the child. `on_message` and completion callbacks are posted by the
+  // caller if they need another sequence; this class invokes them on its own.
+  void Start(AcpLaunchSpec spec,
+             MessageCallback on_message,
+             StatusCallback on_closed);
+
+  void Write(base::DictValue message);
+  // Graceful stop: close stdin, then TERM/KILL the process group.
+  void Stop();
+  // Immediate process-group escalation without waiting for protocol cancel.
+  void Kill();
+
+  bool running() const;
+  std::string stderr_tail() const { return stderr_tail_; }
+
+ private:
+  void WatchPipes();
+  void OnStdoutReadable();
+  void OnStderrReadable();
+  void OnStdinWritable();
+  void ReadPipe(int fd, bool is_stdout);
+  void EnqueueWrite();
+  void Fail(std::string error);
+  void ClosePipes();
+  void TerminateGroup(bool force_kill);
+  void OnKillEscalate();
+  void ReapChild();
+
+  MessageCallback on_message_;
+  StatusCallback on_closed_;
+  base::Process process_;
+  base::ProcessId launch_pid_ = base::kNullProcessId;
+  base::ScopedFD stdin_write_;
+  base::ScopedFD stdout_read_;
+  base::ScopedFD stderr_read_;
+  std::unique_ptr<base::FileDescriptorWatcher::Controller> stdin_watcher_;
+  std::unique_ptr<base::FileDescriptorWatcher::Controller> stdout_watcher_;
+  std::unique_ptr<base::FileDescriptorWatcher::Controller> stderr_watcher_;
+  AcpFramer framer_;
+  std::deque<std::string> outbox_;
+  size_t outbox_offset_ = 0;
+  std::string stderr_tail_;
+  bool stopping_ = false;
+  bool closed_ = false;
+  base::OneShotTimer kill_timer_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<AcpTransport> weak_factory_{this};
+};
+

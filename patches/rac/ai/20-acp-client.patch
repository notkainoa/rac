+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/ai/acp/acp_transport.h"
+
+#include <signal.h>
+#include <unistd.h>
+
+#include <utility>
+
+#include "base/files/file_descriptor_watcher_posix.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/process/kill.h"
+#include "base/process/launch.h"
+#include "base/strings/string_util.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr size_t kReadChunk = 64 * 1024;
+constexpr size_t kStderrRing = 64 * 1024;
+
+void AppendRing(std::string& ring, std::string_view chunk, size_t max) {
+  if (chunk.size() >= max) {
+    ring.assign(chunk.data() + (chunk.size() - max), max);
+    return;
+  }
+  if (ring.size() + chunk.size() > max) {
+    ring.erase(0, ring.size() + chunk.size() - max);
+  }
+  ring.append(chunk);
+}
+
+}  // namespace
+
+AcpTransport::AcpTransport() {
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+}
+
+AcpTransport::~AcpTransport() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  kill_timer_.Stop();
+  ClosePipes();
+  if (process_.IsValid() && launch_pid_ > 1) {
+    kill(-launch_pid_, SIGKILL);
+  }
+  ReapChild();
+  closed_ = true;
+  on_closed_.Reset();
+  on_message_.Reset();
+}
+
+bool AcpTransport::running() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return process_.IsValid() && !closed_;
+}
+
+void AcpTransport::Start(AcpLaunchSpec spec,
+                         MessageCallback on_message,
+                         StatusCallback on_closed) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(!process_.IsValid());
+  on_message_ = std::move(on_message);
+  on_closed_ = std::move(on_closed);
+
+  if (spec.argv.empty() || spec.argv[0].empty() || spec.cwd.empty()) {
+    Fail("The agent command is incomplete.");
+    return;
+  }
+
+  base::ScopedFD child_stdin_read;
+  base::ScopedFD parent_stdin_write;
+  base::ScopedFD parent_stdout_read;
+  base::ScopedFD child_stdout_write;
+  base::ScopedFD parent_stderr_read;
+  base::ScopedFD child_stderr_write;
+  if (!base::CreatePipe(&child_stdin_read, &parent_stdin_write,
+                        /*non_blocking=*/false) ||
+      !base::CreatePipe(&parent_stdout_read, &child_stdout_write,
+                        /*non_blocking=*/false) ||
+      !base::CreatePipe(&parent_stderr_read, &child_stderr_write,
+                        /*non_blocking=*/false)) {
+    Fail("Could not create pipes for the agent.");
+    return;
+  }
+
+  base::LaunchOptions options;
+  options.current_directory = spec.cwd;
+  options.new_process_group = true;
+#if BUILDFLAG(IS_MAC)
+  options.disclaim_responsibility = true;
+#endif
+  options.clear_environment = spec.clear_environment;
+  for (const auto& [key, value] : spec.environment) {
+    options.environment[key] = value;
+  }
+  options.fds_to_remap.emplace_back(child_stdin_read.get(), STDIN_FILENO);
+  options.fds_to_remap.emplace_back(child_stdout_write.get(), STDOUT_FILENO);
+  options.fds_to_remap.emplace_back(child_stderr_write.get(), STDERR_FILENO);
+
+  process_ = base::LaunchProcess(spec.argv, options);
+  child_stdin_read.reset();
+  child_stdout_write.reset();
+  child_stderr_write.reset();
+  if (!process_.IsValid()) {
+    Fail("Could not start the agent.");
+    return;
+  }
+  launch_pid_ = process_.Pid();
+  if (launch_pid_ <= 1) {
+    Fail("The agent process id is invalid.");
+    return;
+  }
+
+  if (!base::SetNonBlocking(parent_stdin_write.get()) ||
+      !base::SetNonBlocking(parent_stdout_read.get()) ||
+      !base::SetNonBlocking(parent_stderr_read.get())) {
+    Fail("Could not configure agent pipes.");
+    return;
+  }
+
+  stdin_write_ = std::move(parent_stdin_write);
+  stdout_read_ = std::move(parent_stdout_read);
+  stderr_read_ = std::move(parent_stderr_read);
+  WatchPipes();
+}
+
+void AcpTransport::WatchPipes() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  stdout_watcher_ = base::FileDescriptorWatcher::WatchReadable(
+      stdout_read_.get(), base::BindRepeating(&AcpTransport::OnStdoutReadable,
+                                              weak_factory_.GetWeakPtr()));
+  stderr_watcher_ = base::FileDescriptorWatcher::WatchReadable(
+      stderr_read_.get(), base::BindRepeating(&AcpTransport::OnStderrReadable,
+                                              weak_factory_.GetWeakPtr()));
+}
+
+void AcpTransport::Write(base::DictValue message) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closed_ || !stdin_write_.is_valid()) {
+    return;
+  }
+  auto json = base::WriteJson(message);
+  if (!json || json->size() > kAcpMaxFrameBytes) {
+    Fail("Could not encode an agent message.");
+    return;
+  }
+  json->push_back('\n');
+  outbox_.push_back(std::move(*json));
+  EnqueueWrite();
+}
+
+void AcpTransport::EnqueueWrite() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!stdin_write_.is_valid() || outbox_.empty()) {
+    stdin_watcher_.reset();
+    return;
+  }
+  while (!outbox_.empty()) {
+    const std::string& frame = outbox_.front();
+    const char* data = frame.data() + outbox_offset_;
+    const size_t remaining = frame.size() - outbox_offset_;
+    const ssize_t wrote =
+        HANDLE_EINTR(write(stdin_write_.get(), data, remaining));
+    if (wrote < 0) {
+      if (errno == EAGAIN || errno == EWOULDBLOCK) {
+        if (!stdin_watcher_) {
+          stdin_watcher_ = base::FileDescriptorWatcher::WatchWritable(
+              stdin_write_.get(),
+              base::BindRepeating(&AcpTransport::OnStdinWritable,
+                                  weak_factory_.GetWeakPtr()));
+        }
+        return;
+      }
+      Fail("Lost the agent stdin pipe.");
+      return;
+    }
+    outbox_offset_ += static_cast<size_t>(wrote);
+    if (outbox_offset_ < frame.size()) {
+      continue;
+    }
+    outbox_.pop_front();
+    outbox_offset_ = 0;
+  }
+  stdin_watcher_.reset();
+}
+
+void AcpTransport::OnStdinWritable() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnqueueWrite();
+}
+
+void AcpTransport::OnStdoutReadable() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ReadPipe(stdout_read_.get(), /*is_stdout=*/true);
+}
+
+void AcpTransport::OnStderrReadable() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!stderr_read_.is_valid()) {
+    return;
+  }
+  ReadPipe(stderr_read_.get(), /*is_stdout=*/false);
+}
+
+void AcpTransport::ReadPipe(int fd, bool is_stdout) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  char buffer[kReadChunk];
+  for (;;) {
+    const ssize_t got = HANDLE_EINTR(read(fd, buffer, sizeof(buffer)));
+    if (got < 0) {
+      if (errno == EAGAIN || errno == EWOULDBLOCK) {
+        return;
+      }
+      Fail(is_stdout ? "Lost the agent stdout pipe."
+                     : "Lost the agent stderr pipe.");
+      return;
+    }
+    if (got == 0) {
+      if (is_stdout) {
+        if (!framer_.Finish()) {
+          Fail("The agent closed stdout on a partial message.");
+        } else {
+          Fail(stopping_ ? "" : "The agent exited.");
+        }
+      } else {
+        // A closed pipe stays readable, so a watcher left armed would spin.
+        stderr_watcher_.reset();
+        stderr_read_.reset();
+      }
+      return;
+    }
+    const std::string_view chunk(buffer, static_cast<size_t>(got));
+    if (is_stdout) {
+      std::vector<base::DictValue> frames;
+      if (!framer_.Feed(chunk, frames)) {
+        Fail("The agent sent a malformed message.");
+        return;
+      }
+      for (auto& frame : frames) {
+        if (on_message_) {
+          on_message_.Run(std::move(frame));
+        }
+      }
+    } else {
+      AppendRing(stderr_tail_, chunk, kStderrRing);
+    }
+  }
+}
+
+void AcpTransport::Stop() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closed_) {
+    return;
+  }
+  stopping_ = true;
+  stdin_watcher_.reset();
+  stdin_write_.reset();
+  outbox_.clear();
+  outbox_offset_ = 0;
+  TerminateGroup(/*force_kill=*/false);
+}
+
+void AcpTransport::Kill() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  stopping_ = true;
+  TerminateGroup(/*force_kill=*/true);
+}
+
+void AcpTransport::TerminateGroup(bool force_kill) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!process_.IsValid() || launch_pid_ <= 1) {
+    ClosePipes();
+    ReapChild();
+    return;
+  }
+  const int signal = force_kill ? SIGKILL : SIGTERM;
+  if (kill(-launch_pid_, signal) != 0 && errno != ESRCH) {
+    DVLOG(1) << "rac ACP kill(" << -launch_pid_ << ", " << signal
+             << ") failed: " << errno;
+  }
+  if (!force_kill) {
+    kill_timer_.Start(FROM_HERE, base::Seconds(1),
+                      base::BindOnce(&AcpTransport::OnKillEscalate,
+                                     weak_factory_.GetWeakPtr()));
+    return;
+  }
+  kill_timer_.Stop();
+  ClosePipes();
+  ReapChild();
+}
+
+void AcpTransport::OnKillEscalate() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  TerminateGroup(/*force_kill=*/true);
+}
+
+void AcpTransport::ClosePipes() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  stdin_watcher_.reset();
+  stdout_watcher_.reset();
+  stderr_watcher_.reset();
+  stdin_write_.reset();
+  stdout_read_.reset();
+  stderr_read_.reset();
+}
+
+void AcpTransport::ReapChild() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (process_.IsValid()) {
+    int exit_code = 0;
+    process_.WaitForExitWithTimeout(base::Seconds(2), &exit_code);
+    process_.Close();
+  }
+  launch_pid_ = base::kNullProcessId;
+}
+
+void AcpTransport::Fail(std::string error) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closed_) {
+    return;
+  }
+  closed_ = true;
+  kill_timer_.Stop();
+  ClosePipes();
+  if (process_.IsValid() && launch_pid_ > 1) {
+    kill(-launch_pid_, SIGTERM);
+    kill_timer_.Start(FROM_HERE, base::Seconds(1),
+                      base::BindOnce(&AcpTransport::OnKillEscalate,
+                                     weak_factory_.GetWeakPtr()));
+  } else {
+    ReapChild();
+  }
+  if (on_closed_) {
+    std::move(on_closed_).Run(std::move(error));
+  }
+}
+
+}  // namespace rac::ai

+#ifndef CHROME_BROWSER_RAC_AI_ACP_AGENT_PATH_H_
+#define CHROME_BROWSER_RAC_AI_ACP_AGENT_PATH_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+
+namespace rac::ai {
+
+// Pure helpers for login-shell PATH discovery. No process is launched here.
+std::string MergeSearchPath(std::string_view discovered,
+                            std::string_view inherited,
+                            std::string_view home_dir);
+
+// Extracts PATH from login-shell stdout that used markers with `nonce`.
+// Rejects missing/duplicate markers, NULs, or embedded newlines in PATH.
+std::optional<std::string> ParseLoginShellPath(std::string_view stdout_text,
+                                               std::string_view nonce);
+
+// Builds the argv script fragment for `shell -ilc`. Only `nonce` is
+// substituted.
+std::string LoginShellPathScript(std::string_view nonce);
+
+// Resolves `name` against a colon-separated PATH of absolute directories.
+base::FilePath FindExecutableOnPath(std::string_view name,
+                                    std::string_view search_path);
+
+// Cached probe of the login-shell PATH. Callers must only start a probe when
+// AI is enabled and an agent UI asks. Blocking work runs on a MayBlock runner.
+class AgentPathCache {
+ public:
+  using ReadyCallback =
+      base::OnceCallback<void(std::string search_path, std::string error)>;
+
+  AgentPathCache();
+  AgentPathCache(const AgentPathCache&) = delete;
+  AgentPathCache& operator=(const AgentPathCache&) = delete;
+  ~AgentPathCache();
+
+  bool has_value() const { return !search_path_.empty(); }
+  const std::string& search_path() const { return search_path_; }
+
+  // Returns the cached path immediately when present. Otherwise starts at most
+  // one probe and invokes `done` on the calling sequence.
+  void Ensure(ReadyCallback done);
+
+  // Absolute override for one executable name, or empty to clear.
+  void SetOverride(std::string name, base::FilePath absolute_path);
+  base::FilePath Resolve(std::string_view name) const;
+
+  void Invalidate();
+
+ private:
+  void OnProbed(std::string search_path, std::string error);
+
+  std::string search_path_;
+  bool probing_ = false;
+  std::vector<ReadyCallback> waiters_;
+  std::map<std::string, base::FilePath> overrides_;
+  base::WeakPtrFactory<AgentPathCache> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_ACP_AGENT_PATH_H_

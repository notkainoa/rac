+// The command bar's Ask row goes by the assistant's own rule, the one the Chat
+// button and AskAssistant() use, not by the committed page's scheme. A
+// view-source: tab has an http(s) page committed but blocks the assistant; a
+// blank tab has none but doesn't.
+TEST(RacActionsTest, AskRowGoesByTheAssistantsRule) {
+  const Action* ask = Find("ask");
+  ASSERT_TRUE(ask);
+  EXPECT_TRUE(ask->availability.Has(Need::kAssistant));
+  EXPECT_FALSE(ask->availability.Has(Need::kWebPage));
+
+  ActionContext web_page;
+  web_page.ai_enabled = true;
+  web_page.has_tab = true;
+  web_page.has_web_page = true;
+  web_page.can_ask_assistant = true;
+  EXPECT_TRUE(IsAvailable(*ask, web_page));
+
+  ActionContext view_source = web_page;
+  view_source.can_ask_assistant = false;
+  EXPECT_FALSE(IsAvailable(*ask, view_source));
+
+  ActionContext blank_tab = web_page;
+  blank_tab.has_web_page = false;
+  EXPECT_TRUE(IsAvailable(*ask, blank_tab));
+
+  ActionContext ai_off = web_page;
+  ai_off.ai_enabled = false;
+  EXPECT_FALSE(IsAvailable(*ask, ai_off));
+}

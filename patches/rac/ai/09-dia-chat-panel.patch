+// Dia's chat container: the wash under it, deepened in dark mode and lifted
+// in light mode, with the outer half of the card's margin left as plain wash.
+constexpr SkColor kContainerDark = SkColorSetARGB(0x8A, 0x17, 0x17, 0x17);
+constexpr SkColor kContainerLight = SkColorSetARGB(0x8A, 0xFF, 0xFF, 0xFF);
+constexpr int kContainerGap = rac::kContentCardInset / 2;
+
+// In `browser_view`'s coordinates.
+std::optional<gfx::Rect> GetContainerBounds(BrowserView& browser_view) {
+  // The layout gives the panel a top margin only while it sits beside the
+  // card on the wash.
+  const SidePanel* panel = browser_view.side_panel();
+  if (!panel || !panel->GetVisible() || panel->rac_top_margin() <= 0 ||
+      !IsAssistantPanelOpen(browser_view.browser())) {
+    return std::nullopt;
+  }
+  const MultiContentsView* page = browser_view.multi_contents_view();
+  const views::View* card_view =
+      page ? page->GetActiveContentsContainerView() : nullptr;
+  if (!card_view || !card_view->GetVisible()) {
+    return std::nullopt;
+  }
+  gfx::Rect card = views::View::ConvertRectToTarget(
+      card_view, &browser_view, card_view->GetLocalBounds());
+  if (const views::View* top_bar = browser_view.toolbar();
+      top_bar && top_bar->GetVisible() &&
+      rac::IsTopBarOnPageCard(&browser_view)) {
+    const int top = views::View::ConvertRectToTarget(
+                        top_bar, &browser_view, top_bar->GetLocalBounds())
+                        .y();
+    card.SetVerticalBounds(std::min(top, card.y()), card.bottom());
+  }
+  const gfx::Rect panel_bounds = views::View::ConvertRectToTarget(
+      panel, &browser_view, panel->GetLocalBounds());
+  // Beside a docked sidebar the card's margin is thinner than the gap, and
+  // the container reaches into the sidebar's padding, whose wash paints it
+  // too.
+  int left, right;
+  if (panel_bounds.x() >= card.x()) {
+    left = card.x() - kContainerGap;
+    right = panel_bounds.right() - kContainerGap;
+  } else {
+    left = panel_bounds.x() + kContainerGap;
+    right = card.right() + kContainerGap;
+  }
+  const int top = card.y() - kContainerGap;
+  return gfx::Rect(left, top, std::max(0, right - left),
+                   card.bottom() + kContainerGap - top);
+}
+
+void SchedulePaintContainer(BrowserWindowInterface* browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return;
+  }
+  for (views::View* view :
+       {static_cast<views::View*>(browser_view->top_container()),
+        static_cast<views::View*>(browser_view->side_panel())}) {
+    if (view) {
+      view->SchedulePaint();
+    }
+  }
+  for (views::View* child : browser_view->children()) {
+    if (views::IsViewClass<VerticalTabStripRegionView>(child)) {
+      child->SchedulePaint();
+    }
+  }
+  if (MultiContentsView* page = browser_view->multi_contents_view()) {
+    // The page area's wash is its own layer, behind the cards.
+    for (views::View* child : page->children()) {
+      if (views::IsViewClass<MultiContentsBackgroundView>(child)) {
+        child->SchedulePaint();
+      }
+    }
+  }
+}

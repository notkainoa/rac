+bool IsAssistantPanelContent(const views::View& view) {
+  return views::IsViewClass<AssistantWebView>(&view);
+}
+
+void PaintAssistantContainer(gfx::Canvas* canvas,
+                             const views::View& view,
+                             const SkPath* clip_path) {
+  const ui::ColorProvider* colors = view.GetColorProvider();
+  const views::Widget* widget = view.GetWidget();
+  BrowserView* browser_view =
+      widget ? BrowserView::GetBrowserViewForNativeWindow(
+                   widget->GetNativeWindow())
+             : nullptr;
+  if (!colors || !browser_view) {
+    return;
+  }
+  const std::optional<gfx::Rect> bounds = GetContainerBounds(*browser_view);
+  if (!bounds) {
+    return;
+  }
+  const gfx::Rect local =
+      views::View::ConvertRectToTarget(browser_view, &view, *bounds);
+  if (!local.Intersects(view.GetLocalBounds())) {
+    return;
+  }
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  if (clip_path) {
+    canvas->ClipPath(*clip_path, /*do_anti_alias=*/true);
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  // The window's own scheme: a space can follow it or set its own.
+  const bool dark =
+      color_utils::IsDark(colors->GetColor(ui::kColorPrimaryBackground));
+  flags.setColor(dark ? kContainerDark : kContainerLight);
+  canvas->DrawRoundRect(gfx::RectF(local), GetGenericFrameRadius(), flags);
+}
+
+void SetSidePanelWashBackground(views::View& side_panel) {
+  if (!rac::HasWindowWash(side_panel)) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForNativeWindow(
+      side_panel.GetWidget()->GetNativeWindow());
+  side_panel.SetBackground(
+      std::make_unique<SidePanelWashBackground>(side_panel, *browser_view));
+}

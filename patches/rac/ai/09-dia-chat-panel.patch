 namespace rac::ai {
+
+// Whether the assistant's panel is open in one window, for the views that
+// change with it (the top bar's Chat button hides while it is open, as in
+// Dia). It is made on first use and deletes itself when its window closes.
+class AssistantPanelState {
+ public:
+  DECLARE_USER_DATA(AssistantPanelState);
+
+  static AssistantPanelState* From(BrowserWindowInterface* browser) {
+    return Get(browser->GetUnownedUserDataHost());
+  }
+
+  static AssistantPanelState* GetOrCreate(BrowserWindowInterface* browser) {
+    if (AssistantPanelState* state = From(browser)) {
+      return state;
+    }
+    return new AssistantPanelState(browser);
+  }
+
+  AssistantPanelState(const AssistantPanelState&) = delete;
+  AssistantPanelState& operator=(const AssistantPanelState&) = delete;
+
+  bool open() const { return open_; }
+
+  void SetOpen(bool open) {
+    if (open_ == open) {
+      return;
+    }
+    open_ = open;
+    callbacks_.Notify();
+  }
+
+  base::CallbackListSubscription AddCallback(base::RepeatingClosure callback) {
+    return callbacks_.Add(std::move(callback));
+  }
+
+ private:
+  explicit AssistantPanelState(BrowserWindowInterface* browser)
+      : scoped_data_(browser->GetUnownedUserDataHost(), *this) {
+    close_subscription_ = browser->RegisterBrowserDidClose(base::BindRepeating(
+        [](AssistantPanelState* self, BrowserWindowInterface*) {
+          delete self;
+        },
+        base::Unretained(this)));
+  }
+
+  ~AssistantPanelState() = default;
+
+  bool open_ = false;
+  base::RepeatingClosureList callbacks_;
+  base::CallbackListSubscription close_subscription_;
+  ui::ScopedUnownedUserData<AssistantPanelState> scoped_data_;
+};
+
+DEFINE_USER_DATA(AssistantPanelState);

+/* In the side panel the page is transparent and sits on the window's wash,
+ * like the margins around the page card. */
+body[data-mode='page'] {
+  background: var(--surface-page);
+}
+
 .app {
   display: flex;
   flex-direction: column;
@@ -765,3 +770,65 @@ body[data-mode='page'][data-chat='empty'
 body[data-mode='page'][data-chat='empty'] .composer-wrap {
   padding-top: 20px;
 }
+
+/* Side panel. The panel's content box starts level with the page card's
+ * top and stops 4px short of the window's right and bottom edges. The chat
+ * container under the page stops 5px short of them, so these paddings keep
+ * the composer 6px inside the container, as in Dia.
+ * The header is as tall as the top bar and lines up with it. Fills are
+ * translucent so the space's tint shows through them, as it does through the
+ * top bar's buttons. */
+body[data-mode='panel'] {
+  --text-muted: light-dark(rgb(0 0 0 / 55%), rgb(255 255 255 / 55%));
+  --text-faint: light-dark(rgb(0 0 0 / 28%), rgb(255 255 255 / 28%));
+  --bubble: light-dark(rgb(0 0 0 / 6%), rgb(255 255 255 / 8%));
+  --token: light-dark(rgb(0 0 0 / 4%), rgb(255 255 255 / 6%));
+  --token-hover: light-dark(rgb(0 0 0 / 8%), rgb(255 255 255 / 10%));
+}
+
+body[data-mode='panel'] .header {
+  height: 40px;
+  padding: 0 2px 0 0;
+}
+
+/* Like the header's icon buttons, the model picker shows its fill only
+ * under the pointer or keyboard focus. */
+body[data-mode='panel'] .chip {
+  background: none;
+}
+
+body[data-mode='panel'] .chip:hover,
+body[data-mode='panel'] .chip:focus-visible {
+  background: var(--token-hover);
+}
+
+body[data-mode='panel'] .scroll {
+  padding: 8px 8px 16px 2px;
+}
+
+body[data-mode='panel'] .composer-wrap {
+  padding: 0 7px 7px 0;
+}
+
+body[data-mode='panel'] .drawer {
+  background: none;
+  top: 40px;
+}
+
+body[data-mode='panel'] .drawer-head {
+  padding: 0 2px 8px 0;
+}
+
+body[data-mode='panel'] .drawer-list {
+  padding: 0 7px 0 0;
+}
+
+body[data-mode='panel'] .drawer-foot {
+  padding: 10px 7px 7px 0;
+}
+
+/* The drawer has no fill of its own here, so hide the chat under it. */
+.app:has(.drawer:not([hidden])) .scroll,
+.app:has(.drawer:not([hidden])) .composer-wrap {
+  visibility: hidden;
+}

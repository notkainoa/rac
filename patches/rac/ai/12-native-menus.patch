+// args: a token the page picks, and the menu. Events about the menu carry the
+// token back in "rac-ai-menu".
+void PageHandler::HandleShowMenu(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  AllowJavascript();
+  if (!args[0].is_int() || !args[1].is_dict()) {
+    return;
+  }
+  CloseMenu();
+  std::unique_ptr<MenuRequest> request = ParseMenu(args[1].GetDict());
+  content::WebContents* contents = web_ui()->GetWebContents();
+  views::Widget* widget =
+      views::Widget::GetTopLevelWidgetForNativeView(contents->GetNativeView());
+  const int token = args[0].GetInt();
+  if (!request || !widget) {
+    OnMenuClosed(token);
+    return;
+  }
+  menu_token_ = token;
+  menu_panel_ = std::make_unique<MenuPanel>(
+      widget, std::move(*request),
+      base::BindRepeating(&PageHandler::OnMenuPicked,
+                          menu_factory_.GetWeakPtr(), token),
+      base::BindOnce(&PageHandler::OnMenuClosed, menu_factory_.GetWeakPtr(),
+                     token));
+}

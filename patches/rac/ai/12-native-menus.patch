+// One line that can be picked.
+class MenuPanel::Contents::Row : public views::Button {
+  METADATA_HEADER(Row, views::Button)
+
+ public:
+  Row(Contents* owner, const MenuEntry& entry)
+      : views::Button(base::BindRepeating(&Contents::Pick,
+                                          base::Unretained(owner),
+                                          base::Unretained(this),
+                                          false)),
+        owner_(owner),
+        entry_(entry) {
+    SetFocusBehavior(FocusBehavior::NEVER);
+    SetAccessibleName(entry.label);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kMenuItem);
+    if (entry.checked) {
+      GetViewAccessibility().SetCheckedState(ax::mojom::CheckedState::kTrue);
+    }
+    if (!entry.detail.empty()) {
+      SetTooltipText(entry.label);
+    }
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::VH(0, kRowInset), kRowInset));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    const ui::ImageModel icon = IconFor(entry);
+    if (!icon.IsEmpty()) {
+      auto* image = AddChildView(std::make_unique<views::ImageView>(icon));
+      image->SetImageSize(gfx::Size(kIconSize, kIconSize));
+      image->SetCanProcessEventsWithinSubtree(false);
+    }
+    label_ = AddChildView(std::make_unique<views::Label>(entry.label));
+    label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label_->SetElideBehavior(gfx::ELIDE_TAIL);
+    label_->SetEnabledColor(ui::kColorMenuItemForeground);
+    label_->SetFontList(entry.checked ? PanelFont().DeriveWithWeight(
+                                            gfx::Font::Weight::SEMIBOLD)
+                                      : PanelFont());
+    layout->SetFlexForView(label_, 1);
+    if (!entry.detail.empty()) {
+      AddChildView(MakeQuietLabel(entry.detail));
+    }
+    // A plain choice, like a model, shows the check a menu would. Richer lines
+    // keep the right side for their detail and only go bold.
+    if (entry.checked && entry.detail.empty() && !entry.removable) {
+      auto* check = AddChildView(
+          std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+              views::kCheckIcon, ui::kColorMenuIcon, kIconSize)));
+      check->SetCanProcessEventsWithinSubtree(false);
+    }
+    if (entry.removable) {
+      remove_ = AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+          base::BindRepeating(&Contents::Pick, base::Unretained(owner),
+                              base::Unretained(this), true),
+          vector_icons::kCloseIcon, 14, ui::kColorMenuItemForegroundSecondary,
+          ui::kColorMenuItemForegroundSecondary, ui::kColorMenuItemForeground));
+      remove_->SetFocusBehavior(FocusBehavior::NEVER);
+      remove_->SetAccessibleName(owner->remove_label());

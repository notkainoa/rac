+  Row& operator=(const Row&) = delete;
+  ~Row() override = default;
+
+  const MenuEntry& entry() const { return entry_; }
+
+  void SetSelected(bool selected) {
+    if (selected_ == selected) {
+      return;
+    }
+    selected_ = selected;
+    SetBackground(selected
+                      ? views::CreateRoundedRectBackground(
+                            ui::kColorMenuItemBackgroundSelected, kRowRadius)
+                      : nullptr);
+    label_->SetEnabledColor(selected ? ui::kColorMenuItemForegroundSelected
+                                     : ui::kColorMenuItemForeground);
+    if (remove_) {
+      remove_->SetVisible(selected);
+      // The remove button takes room from the label when it shows.
+      InvalidateLayout();
+    }
+  }
+
+  // views::Button:

+constexpr int kRowRadius = 6;
+constexpr int kRowInset = 8;
+constexpr int kIconSize = 16;
+constexpr int kSearchHeight = 30;
+constexpr int kSearchRadius = 8;
+constexpr int kPanelRadius = 12;
+constexpr int kDefaultWidth = 300;
+// Long lists scroll on their own, so the lines below them stay in reach.
+constexpr int kMaxScrollRows = 10;
+
+// Dia's panels set their lines a point larger than the system menus.
+const gfx::FontList& PanelFont() {
+  static const base::NoDestructor<gfx::FontList> font(
+      gfx::FontList().DeriveWithSizeDelta(1));
+  return *font;
+}
+
+ui::ImageModel IconFor(const MenuEntry& entry) {
+  if (!entry.image.IsEmpty()) {
+    return entry.image;
+  }
+  const gfx::VectorIcon* icon = nullptr;
+  switch (entry.icon) {
+    case MenuEntry::Icon::kNone:
+      return ui::ImageModel();
+    case MenuEntry::Icon::kTabs:
+      icon = &kTabIcon;
+      break;
+    case MenuEntry::Icon::kUpload:
+      icon = &kAttachFileIcon;
+      break;
+    case MenuEntry::Icon::kSettings:
+      icon = &vector_icons::kSettingsIcon;
+      break;
+  }
+  return ui::ImageModel::FromVectorIcon(*icon, ui::kColorMenuIcon, kIconSize);
+}
+
+views::BubbleBorder::Arrow ArrowFor(const MenuRequest& request) {
+  switch (request.align) {
+    case MenuRequest::Align::kStart:
+      return request.above ? views::BubbleBorder::BOTTOM_LEFT
+                           : views::BubbleBorder::TOP_LEFT;
+    case MenuRequest::Align::kCenter:
+      return request.above ? views::BubbleBorder::BOTTOM_CENTER
+                           : views::BubbleBorder::TOP_CENTER;
+    case MenuRequest::Align::kEnd:
+      return request.above ? views::BubbleBorder::BOTTOM_RIGHT
+                           : views::BubbleBorder::TOP_RIGHT;
+  }
+}
+
+bool Matches(const MenuEntry& entry, const std::u16string& query) {
+  if (query.empty()) {
+    return true;
+  }
+  const std::u16string folded = base::i18n::FoldCase(query);
+  return base::i18n::FoldCase(entry.label).find(folded) !=
+             std::u16string::npos ||
+         base::i18n::FoldCase(entry.detail).find(folded) !=
+             std::u16string::npos;
+}
+
+std::unique_ptr<views::Label> MakeQuietLabel(const std::u16string& text) {
+  auto label = std::make_unique<views::Label>(text);
+  label->SetEnabledColor(ui::kColorMenuItemForegroundSecondary);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  return label;
+}

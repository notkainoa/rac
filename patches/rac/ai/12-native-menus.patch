+
+std::unique_ptr<MenuRequest> PageHandler::ParseMenu(
+    const base::DictValue& spec) {
+  const base::ListValue* entries = spec.FindList("entries");
+  const base::DictValue* anchor = spec.FindDict("anchor");
+  content::RenderWidgetHostView* view =
+      web_ui()->GetWebContents()->GetRenderWidgetHostView();
+  if (!entries || entries->size() > kMaxMenuEntries || !anchor || !view) {
+    return nullptr;
+  }
+  auto request = std::make_unique<MenuRequest>();
+  // The page measures in its own pixels, from the top left of its view.
+  const gfx::RectF rect(
+      static_cast<float>(anchor->FindDouble("x").value_or(0)),
+      static_cast<float>(anchor->FindDouble("y").value_or(0)),
+      static_cast<float>(anchor->FindDouble("width").value_or(0)),
+      static_cast<float>(anchor->FindDouble("height").value_or(0)));
+  gfx::Rect bounds = view->GetViewBounds();
+  request->anchor = gfx::ToEnclosingRect(rect);
+  request->anchor.Offset(bounds.OffsetFromOrigin());
+  request->anchor.Intersect(bounds);
+  request->above = spec.FindBool("above").value_or(false);
+  if (const std::string* align = spec.FindString("align")) {
+    if (*align == "center") {
+      request->align = MenuRequest::Align::kCenter;
+    } else if (*align == "end") {
+      request->align = MenuRequest::Align::kEnd;
+    }
+  }
+  request->search_placeholder = MenuText(spec, "search");
+  request->no_matches = MenuText(spec, "noMatches");
+  request->empty_text = MenuText(spec, "emptyText");
+  request->remove_label = MenuText(spec, "removeLabel");
+  request->name = MenuText(spec, "name");
+  request->width =
+      std::clamp(spec.FindInt("width").value_or(0), 0, kMaxMenuWidth);
+
+  BrowserWindowInterface* browser = GetBrowser();
+  for (const base::Value& value : *entries) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      return nullptr;
+    }
+    MenuEntry entry;
+    const std::string* type = dict->FindString("type");
+    if (!type || *type == "item") {
+      entry.type = MenuEntry::Type::kItem;
+    } else if (*type == "heading") {
+      entry.type = MenuEntry::Type::kHeading;
+    } else if (*type == "separator") {
+      entry.type = MenuEntry::Type::kSeparator;
+    } else if (*type == "note") {
+      entry.type = MenuEntry::Type::kNote;
+    } else {
+      return nullptr;
+    }
+    const std::string* id = dict->FindString("id");
+    if (id && id->size() <= kMaxMenuText && base::IsStringUTF8(*id)) {
+      entry.id = *id;
+    }
+    entry.label = MenuText(*dict, "label");
+    entry.detail = MenuText(*dict, "detail");
+    entry.checked = dict->FindBool("checked").value_or(false);
+    entry.removable = dict->FindBool("removable").value_or(false);
+    entry.searchable = dict->FindBool("searchable").value_or(false);
+    if (const std::string* icon = dict->FindString("icon")) {
+      if (*icon == "tabs") {
+        entry.icon = MenuEntry::Icon::kTabs;
+      } else if (*icon == "upload") {
+        entry.icon = MenuEntry::Icon::kUpload;
+      } else if (*icon == "settings") {
+        entry.icon = MenuEntry::Icon::kSettings;
+      }
+    }
+    // Favicons come from the tab itself, never from an address the page names.
+    if (std::optional<int> tab_id = dict->FindInt("tab")) {
+      tabs::TabInterface* tab = tabs::TabHandle(*tab_id).Get();
+      if (tab && browser && tab->GetBrowserWindowInterface() == browser) {
+        entry.image = TabUIHelper::From(tab)->GetFavicon();
+      }
+    }
+    request->entries.push_back(std::move(entry));
+  }
+  return request;
+}
+
+void PageHandler::OnMenuPicked(int token, const std::string& id, bool remove) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  // A pick counts as the user acting on the page, so it can open a file
+  // chooser in answer.
+  if (!remove) {
+    web_ui()->GetWebContents()->GetPrimaryMainFrame()->NotifyUserActivation(
+        blink::mojom::UserActivationNotificationType::kInteraction);
+  }
+  FireWebUIListener("rac-ai-menu", base::DictValue()
+                                       .Set("token", token)
+                                       .Set("id", id)
+                                       .Set("remove", remove));
+}
+
+void PageHandler::OnMenuClosed(int token) {
+  if (token == menu_token_) {
+    menu_token_ = 0;
+    // Deleting the panel from inside its own callback is safe: it runs in a
+    // task of its own.
+    menu_panel_.reset();
+  }
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener(
+        "rac-ai-menu",
+        base::DictValue().Set("token", token).Set("closed", true));
+  }
+}

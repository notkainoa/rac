+
+interface MenuEntry {
+  type?: 'item'|'heading'|'separator'|'note';
+  id?: string;
+  label?: string;
+  // Quieter text after the label.
+  detail?: string;
+  icon?: 'tabs'|'upload'|'settings';
+  // Shows this tab's favicon.
+  tab?: number;
+  checked?: boolean;
+  removable?: boolean;
+  // Stays while searching, if it matches. Other lines hide.
+  searchable?: boolean;
+}
+
+interface MenuSpec {
+  above?: boolean;
+  align?: 'start'|'center'|'end';
+  search?: string;
+  noMatches?: string;
+  emptyText?: string;
+  removeLabel?: string;
+  width?: number;
+  entries: MenuEntry[];
+}
+
+interface MenuEvent {
+  token: number;
+  id?: string;
+  remove?: boolean;
+  closed?: boolean;
+}
+
+interface OpenMenu {
+  token: number;
+  button: HTMLElement;
+  actions: Map<string, () => void>;
+  onRemove?: (id: string) => void;
+}
+
+let menuToken = 0;
+let openMenu: OpenMenu|null = null;
+let menuPending = false;
+// A click on a menu's button closes the menu before the click arrives, so
+// remember which button that was to keep the click from reopening it.
+let lastClosed: {button: HTMLElement, time: number}|null = null;
+
+function showMenu(
+    button: HTMLElement, spec: MenuSpec, actions: Map<string, () => void>,
+    onRemove?: (id: string) => void) {
+  closeMenus();
+  const rect = button.getBoundingClientRect();
+  openMenu = {token: ++menuToken, button, actions, onRemove};
+  button.setAttribute('aria-expanded', 'true');
+  sendToBrowser('racAiShowMenu', [
+    openMenu.token,
+    {
+      ...spec,
+      name: button.getAttribute('aria-label') ?? button.title,
+      anchor: {x: rect.x, y: rect.y, width: rect.width, height: rect.height},
+    },
+  ]);
+}
 

+            scroll->SetBackgroundColor(std::nullopt);
+            scroll->SetHorizontalScrollBarMode(
+                views::ScrollView::ScrollBarMode::kDisabled);
+            scroll->SetDrawOverflowIndicator(false);
+            scroll->ClipHeightTo(0, kMaxScrollRows * kRowHeight);
+            block = scroll->SetContents(std::make_unique<views::View>());
+            block->SetLayoutManager(std::make_unique<views::BoxLayout>(
+                views::BoxLayout::Orientation::kVertical));
+            blocks_.push_back(scroll);
+          }
+          added = block->AddChildView(std::move(row));
+        } else {
+          added = AddChildView(std::move(row));
+        }
+        rows_.push_back(added);
+        if (heading) {
+          heading->rows.push_back(added);
+        }
+        break;
+      }
+    }
+  }
+
+  empty_ = AddChildView(MakeQuietLabel(std::u16string()));
+  empty_->SetMultiLine(true);
+  empty_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, kRowInset)));
+  UpdateEmpty();
+}
+
+MenuPanel::Contents::~Contents() = default;
+
+void MenuPanel::Contents::Select(Row* row) {
+  selected_by_typing_ = false;
+  if (selected_ == row) {
+    return;
+  }
+  if (selected_) {
+    selected_->SetSelected(false);
+  }
+  selected_ = row;
+  if (row) {
+    row->SetSelected(true);
+    row->ScrollViewToVisible();
+    if (search_) {
+      search_->GetViewAccessibility().SetActiveDescendant(*row);
+    }
+  } else if (search_) {
+    search_->GetViewAccessibility().ClearActiveDescendant();
+  }
+}
+
+void MenuPanel::Contents::Pick(Row* row, bool remove) {
+  const std::string id = row->entry().id;
+  if (!remove) {
+    on_pick_.Run(id, false);
+    return;
+  }
+  if (selected_ == row) {
+    Select(nullptr);
+  }
+  std::erase(rows_, row);
+  for (Decoration& decoration : decorations_) {
+    std::erase(decoration.rows, row);
+  }
+  // Hidden rather than deleted: this runs inside the row's remove button.
+  row->SetVisible(false);
+  Filter();
+  // Runs last: the page's answer may close the panel.
+  on_pick_.Run(id, true);
+}
+
+void MenuPanel::Contents::ContentsChanged(views::Textfield* sender,
+                                          const std::u16string& new_contents) {
+  query_ = std::u16string(base::TrimWhitespace(new_contents, base::TRIM_ALL));
+  Select(nullptr);
+  Filter();
+  // Like the search boxes of menus elsewhere, typing points at the first hit.
+  if (!query_.empty()) {
+    MoveSelection(1);
+    selected_by_typing_ = true;
+  }
+}
+
+bool MenuPanel::Contents::HandleKeyEvent(views::Textfield* sender,
+                                         const ui::KeyEvent& key_event) {
+  return key_event.type() == ui::EventType::kKeyPressed && HandleKey(key_event);
+}
+
+bool MenuPanel::Contents::OnKeyPressed(const ui::KeyEvent& event) {
+  return HandleKey(event);
+}
+
+bool MenuPanel::Contents::HandleKey(const ui::KeyEvent& event) {
+  switch (event.key_code()) {
+    case ui::VKEY_DOWN:
+      MoveSelection(1);
+      return true;
+    case ui::VKEY_UP:
+      MoveSelection(-1);
+      return true;
+    case ui::VKEY_RETURN: {
+      Row* row = selected_;
+      if (!row) {
+        std::vector<Row*> visible = VisibleRows();
+        row = visible.empty() ? nullptr : visible.front();
+      }
+      if (row) {
+        Pick(row, false);
+      }
+      return true;
+    }
+    case ui::VKEY_BACK: {
+      // Command-Delete removes, as in Finder. On Mac it arrives as the
+      // delete-to-line-start command, which Views spells Control-Shift. A
+      // row picked only by typing keeps the key for clearing the search.
+      const bool command_delete =
+          event.IsCommandDown() ||
+          (event.IsControlDown() && event.IsShiftDown());
+      if (!command_delete || !selected_ || selected_by_typing_ ||
+          !selected_->entry().removable) {
+        return false;
+      }
+      Row* row = selected_;
+      std::vector<Row*> visible = VisibleRows();
+      auto it = std::ranges::find(visible, row);
+      Row* next = nullptr;
+      if (it != visible.end()) {
+        next = std::next(it) != visible.end() ? *std::next(it)
+               : it != visible.begin()        ? *std::prev(it)
+                                              : nullptr;
+      }
+      Pick(row, true);
+      Select(next);
+      return true;
+    }
+    default:
+      return false;
+  }
+}
+
+void MenuPanel::Contents::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  if (!search_box_) {
+    return;
+  }
+  // A faint fill of the text color reads as a field on any background.
+  search_box_->SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetA(GetColorProvider()->GetColor(ui::kColorMenuItemForeground),
+                  0x14),
+      kSearchRadius));
+}
+
+std::vector<MenuPanel::Contents::Row*> MenuPanel::Contents::VisibleRows()
+    const {
+  std::vector<Row*> visible;
+  for (Row* row : rows_) {
+    if (row->GetVisible()) {
+      visible.push_back(row);
+    }
+  }
+  return visible;
+}
+
+void MenuPanel::Contents::MoveSelection(int delta) {
+  std::vector<Row*> visible = VisibleRows();
+  if (visible.empty()) {
+    return;
+  }
+  auto it = std::ranges::find(visible, selected_.get());
+  if (it == visible.end()) {
+    Select(delta > 0 ? visible.front() : visible.back());
+    return;
+  }
+  const int index = static_cast<int>(it - visible.begin()) + delta;
+  Select(visible[std::clamp(index, 0, static_cast<int>(visible.size()) - 1)]);
+}
+
+void MenuPanel::Contents::Filter() {
+  const bool searching = !query_.empty();
+  for (Row* row : rows_) {
+    row->SetVisible(row->entry().searchable ? Matches(row->entry(), query_)
+                                            : !searching);
+  }
+  for (Decoration& decoration : decorations_) {
+    bool show = !searching;
+    if (!decoration.rows.empty()) {
+      show = std::ranges::any_of(decoration.rows,
+                                 [](Row* row) { return row->GetVisible(); });
+    }
+    decoration.view->SetVisible(show);
+  }
+  for (views::ScrollView* block : blocks_) {
+    block->contents()->InvalidateLayout();
+    block->InvalidateLayout();
+  }
+  UpdateEmpty();
+  PreferredSizeChanged();
+}
+
+void MenuPanel::Contents::UpdateEmpty() {
+  std::u16string text;
+  if (rows_.empty()) {
+    text = empty_text_;
+  } else if (!query_.empty() && VisibleRows().empty()) {
+    text = no_matches_;
+  }
+  empty_->SetText(text);
+  empty_->SetVisible(!text.empty());
+}
+
+BEGIN_METADATA(MenuPanel, Contents)
+END_METADATA
+
+MenuPanel::MenuPanel(views::Widget* parent,
+                     MenuRequest request,
+                     PickCallback on_pick,
+                     base::OnceClosure on_closed)
+    : on_pick_(std::move(on_pick)), on_closed_(std::move(on_closed)) {
+  auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+      nullptr, ArrowFor(request), views::BubbleBorder::STANDARD_SHADOW,
+      /*autosize=*/true);
+  delegate->SetAnchorRect(request.anchor);
+  delegate->set_parent_window(parent->GetNativeView());
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->SetShowCloseButton(false);
+  delegate->set_margins(gfx::Insets());
+  delegate->set_corner_radius(kPanelRadius);
+  delegate->SetBackgroundColor(ui::kColorMenuBackground);
+  delegate->set_highlight_button_when_shown(false);
+  delegate->set_fixed_width(request.width > 0 ? request.width : kDefaultWidth);
+  auto* contents = delegate->SetContentsView(std::make_unique<Contents>(
+      std::move(request),
+      base::BindRepeating(&MenuPanel::OnPicked, weak_factory_.GetWeakPtr())));
+  delegate->SetInitiallyFocusedView(contents->initial_focus());
+  delegate_ = std::move(delegate);
+  widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate_.get(),
+      base::BindOnce(&MenuPanel::OnWidgetClosed, weak_factory_.GetWeakPtr()));
+  widget_->Show();
+}
+
+MenuPanel::~MenuPanel() = default;
+
+void MenuPanel::Close() {
+  if (widget_) {
+    widget_->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+  }
+}
+
+void MenuPanel::OnPicked(const std::string& id, bool remove) {
+  if (!remove) {
+    Close();
+  }
+  on_pick_.Run(id, remove);
+}
+
+void MenuPanel::OnWidgetClosed(views::Widget::ClosedReason reason) {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  // The widget is still on the stack that reported its closing.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<MenuPanel> panel) {
+                       if (panel) {
+                         panel->widget_.reset();
+                         std::move(panel->on_closed_).Run();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+}  // namespace rac::ai

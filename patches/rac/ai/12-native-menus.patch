+namespace rac::ai {
+
+// One line of a menu the assistant page asks the browser to show. The page
+// owns what the lines mean; the browser only reports which one was picked.
+struct MenuEntry {
+  enum class Type { kItem, kHeading, kSeparator, kNote };
+  enum class Icon { kNone, kTabs, kUpload, kSettings };
+
+  MenuEntry();
+  MenuEntry(const MenuEntry&);
+  MenuEntry& operator=(const MenuEntry&);
+  MenuEntry(MenuEntry&&);
+  MenuEntry& operator=(MenuEntry&&);
+  ~MenuEntry();
+
+  Type type = Type::kItem;
+  std::string id;
+  std::u16string label;
+  // Quieter text after the label, like a count or a time.
+  std::u16string detail;
+  // A favicon. Takes the place of `icon` when set.
+  ui::ImageModel image;
+  Icon icon = Icon::kNone;
+  bool checked = false;
+  // Shows a remove button while the pointer is on the line.
+  bool removable = false;
+  // Stays visible while searching, if it matches. Other lines hide.
+  bool searchable = false;
+};
+
+struct MenuRequest {
+  enum class Align { kStart, kCenter, kEnd };
+
+  MenuRequest();
+  MenuRequest(MenuRequest&&);
+  MenuRequest& operator=(MenuRequest&&);
+  ~MenuRequest();
+
+  std::vector<MenuEntry> entries;
+  // The control that opened the menu, in screen coordinates.
+  gfx::Rect anchor;
+  bool above = false;
+  Align align = Align::kStart;
+  // Without a placeholder there is no search box.
+  std::u16string search_placeholder;
+  // Shown when no line matches the search.
+  std::u16string no_matches;
+  // Shown once every line has been removed.
+  std::u16string empty_text;
+  // Names the remove buttons.
+  std::u16string remove_label;
+  // Names the menu for screen readers, usually after the button that opened
+  // it.
+  std::u16string name;
+  int width = 0;
+};
+
+// A floating menu panel, with an optional search box. Picking a line closes
+// it; removing one does not.
+class MenuPanel {
+ public:
+  using PickCallback =
+      base::RepeatingCallback<void(const std::string& id, bool remove)>;
+
+  // `on_closed` runs after the panel has closed, in a task of its own, so it
+  // may delete this.
+  MenuPanel(views::Widget* parent,
+            MenuRequest request,
+            PickCallback on_pick,
+            base::OnceClosure on_closed);
+  MenuPanel(const MenuPanel&) = delete;
+  MenuPanel& operator=(const MenuPanel&) = delete;
+  ~MenuPanel();
+
+  void Close();
+
+ private:
+  class Contents;
+
+  void OnPicked(const std::string& id, bool remove);
+  void OnWidgetClosed(views::Widget::ClosedReason reason);
+
+  PickCallback on_pick_;
+  base::OnceClosure on_closed_;
+  bool closing_ = false;
+  // Outlives `widget_`, which is declared after it.
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  base::WeakPtrFactory<MenuPanel> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_AI_ASSISTANT_MENU_H_

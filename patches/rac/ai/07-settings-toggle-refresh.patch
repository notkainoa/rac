+void RacAiHandler::OnJavascriptAllowed() {
+  pref_registrar_.Add(rac::ai::kEnabled,
+                      base::BindRepeating(&RacAiHandler::OnEnabledChanged,
+                                          base::Unretained(this)));
+}

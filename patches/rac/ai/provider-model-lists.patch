@@ -0,0 +1,86 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/model_catalog.h"
+
+#include <algorithm>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "chrome/browser/rac/ai/chat_protocol.h"
+
+namespace rac::ai {
+namespace {
+
+// Substrings of ids that name a model nobody can chat with: embeddings,
+// speech, images and the API's other non-chat families.
+constexpr std::string_view kNonChatIdParts[] = {
+    "embedding", "embed-",   "tts",   "whisper", "dall-e", "moderation",
+    "realtime",  "transcri", "audio", "image",   "sora",
+};
+
+// Providers whose /models mixes non-chat models in with the chat ones.
+bool FiltersModelIds(std::string_view provider_id) {
+  return provider_id == "openai" || provider_id == "openrouter" ||
+         provider_id == "gemini";
+}
+
+void AppendUnique(std::vector<std::string>* out,
+                  std::string model,
+                  size_t cap) {
+  if (model.empty() || out->size() >= cap ||
+      std::ranges::find(*out, model) != out->end()) {
+    return;
+  }
+  out->push_back(std::move(model));
+}
+
+}  // namespace
+
+std::vector<std::string> FilterChatModelIds(
+    std::string_view provider_id,
+    const std::vector<std::string>& models) {
+  if (!FiltersModelIds(provider_id)) {
+    return models;
+  }
+  std::vector<std::string> chat;
+  for (const std::string& model : models) {
+    const std::string lower = base::ToLowerASCII(model);
+    if (std::ranges::any_of(kNonChatIdParts, [&lower](std::string_view part) {
+          return lower.find(part) != std::string::npos;
+        })) {
+      continue;
+    }
+    AppendUnique(&chat, model, kMaxListedModels);
+  }
+  return chat;
+}
+
+std::vector<std::string> MergeModelChoices(
+    std::vector<std::string> chosen,
+    std::string_view saved,
+    const std::vector<std::string>& fetched,
+    size_t cap) {
+  std::vector<std::string> merged;
+  for (std::string& model : chosen) {
+    AppendUnique(&merged, SanitizeModelId(model), cap);
+  }
+  AppendUnique(&merged, SanitizeModelId(saved), cap);
+  for (const std::string& model : fetched) {
+    AppendUnique(&merged, SanitizeModelId(model), cap);
+  }
+  return merged;
+}
+
+std::string SanitizeModelId(std::string_view id) {
+  std::string trimmed;
+  base::TrimString(id, base::kWhitespaceASCII, &trimmed);
+  if (trimmed.empty() || trimmed.size() > kMaxModelIdChars ||
+      !base::IsStringUTF8(trimmed)) {
+    return std::string();
+  }
+  return trimmed;
+}
+
+}  // namespace rac::ai

@@ -0,0 +1,45 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_MODEL_CATALOG_H_
+#define CHROME_BROWSER_RAC_AI_MODEL_CATALOG_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rac::ai {
+
+// The most models one provider adds to a menu. Cloud providers mix in more
+// than anyone wants to scroll, and the menu has to stay short.
+inline constexpr size_t kMaxMenuModelsPerProvider = 10;
+// How many models the user can pin per provider.
+inline constexpr size_t kMaxChosenModels = 12;
+// Longest model id that is accepted anywhere.
+inline constexpr size_t kMaxModelIdChars = 200;
+
+// Drops ids that aren't chat models, for providers whose /models mixes in
+// other kinds. Providers the user pointed at themselves are left alone,
+// because their ids are whatever that server decided.
+std::vector<std::string> FilterChatModelIds(
+    std::string_view provider_id,
+    const std::vector<std::string>& models);
+
+// The models a menu offers for one provider: the ones the user chose first,
+// then the saved default, then the list the server returned. Deduplicated,
+// capped at `cap`. `chosen` and `saved` are used as given; `fetched` is
+// filtered for providers that need it.
+std::vector<std::string> MergeModelChoices(
+    std::vector<std::string> chosen,
+    std::string_view saved,
+    const std::vector<std::string>& fetched,
+    size_t cap);
+
+// A model id a user or a server offered, trimmed and size-checked. Empty if
+// the id can't be used.
+std::string SanitizeModelId(std::string_view id);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_MODEL_CATALOG_H_
Index: src/chrome/browser/rac/ai/model_catalog_unittest.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/model_catalog_unittest.cc	2026-10-19 17:57:28.904894577 -0700
@@ -0,0 +1,109 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/model_catalog.h"
+
+#include <string>
+#include <vector>
+
+#include "chrome/browser/rac/ai/chat_protocol.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+TEST(ModelCatalogTest, FiltersOpenAiNonChatModels) {
+  const std::vector<std::string> models = {
+      "gpt-4.1-mini",
+      "text-embedding-3-small",
+      "gpt-4o-mini",
+      "tts-1",
+      "whisper-1",
+      "dall-e-3",
+      "omni-moderation-latest",
+      "gpt-4o-realtime-preview",
+      "gpt-4o-audio-preview",
+      "chatgpt-4o-latest",
+      "gpt-image-1",
+      "sora-2",
+  };
+  EXPECT_EQ(FilterChatModelIds("openai", models),
+            (std::vector<std::string>{"gpt-4.1-mini", "gpt-4o-mini",
+                                      "chatgpt-4o-latest"}));
+}
+
+TEST(ModelCatalogTest, FiltersOpenRouterAudioVariants) {
+  const std::vector<std::string> models = {"openai/gpt-4o",
+                                           "openai/gpt-4o-audio-preview",
+                                           "anthropic/claude-sonnet-4-5"};
+  EXPECT_EQ(FilterChatModelIds("openrouter", models),
+            (std::vector<std::string>{"openai/gpt-4o",
+                                      "anthropic/claude-sonnet-4-5"}));
+}
+
+TEST(ModelCatalogTest, LeavesCustomAndLocalProvidersAlone) {
+  const std::vector<std::string> models = {"my-embedding-model",
+                                           "audio-helper"};
+  EXPECT_EQ(FilterChatModelIds("custom", models), models);
+  EXPECT_EQ(FilterChatModelIds("ollama", models), models);
+  EXPECT_EQ(FilterChatModelIds("lmstudio", models), models);
+  EXPECT_EQ(FilterChatModelIds("anthropic", models), models);
+}
+
+TEST(ModelCatalogTest, MergePutsChosenFirstThenSavedThenFetched) {
+  const std::vector<std::string> fetched = {"a", "b", "c"};
+  std::vector<std::string> chosen = {"b", "gone"};
+  auto merged = MergeModelChoices(std::move(chosen), "c", fetched, 10);
+  EXPECT_EQ(merged, (std::vector<std::string>{"b", "gone", "c", "a"}));
+}
+
+TEST(ModelCatalogTest, MergeAlwaysIncludesTheSavedModel) {
+  auto merged = MergeModelChoices({}, "saved", {}, 10);
+  EXPECT_EQ(merged, (std::vector<std::string>{"saved"}));
+}
+
+TEST(ModelCatalogTest, MergeCapsAndDeduplicates) {
+  std::vector<std::string> fetched;
+  for (int i = 0; i < 40; ++i) {
+    fetched.push_back("m" + std::to_string(i));
+  }
+  auto merged = MergeModelChoices({"m1", "m1", " saved "}, "m1", fetched, 10);
+  ASSERT_EQ(merged.size(), 10u);
+  EXPECT_EQ(merged[0], "m1");
+  EXPECT_EQ(merged[1], "saved");
+  EXPECT_EQ(merged[2], "m0");
+}
+
+TEST(ModelCatalogTest, MergeNeverEndsUpEmptyWhenSomethingWasSaved) {
+  auto merged = MergeModelChoices({}, "saved", {}, 10);
+  EXPECT_FALSE(merged.empty());
+}
+
+TEST(ModelCatalogTest, SanitizeTrimsAndRejects) {
+  EXPECT_EQ(SanitizeModelId("  gpt-4.1 \n"), "gpt-4.1");
+  EXPECT_EQ(SanitizeModelId("   "), "");
+  EXPECT_EQ(SanitizeModelId(std::string(201, 'a')), "");
+  EXPECT_EQ(SanitizeModelId("\xff\xfe"), "");
+}
+
+// Both /models response shapes the fetch parses: OpenAI-style and
+// Anthropic-style, which both put ids under "data".
+TEST(ModelCatalogTest, ParseModelListHandlesBothShapes) {
+  const std::string openai = R"({"object":"list","data":[
+      {"id":"gpt-4.1-mini","object":"model"},
+      {"id":"gpt-4.1","object":"model"}]})";
+  EXPECT_EQ(ParseModelList(openai),
+            (std::vector<std::string>{"gpt-4.1-mini", "gpt-4.1"}));
+
+  const std::string anthropic = R"({"data":[
+      {"type":"model","id":"claude-sonnet-4-5","display_name":"Sonnet"},
+      {"type":"model","id":"claude-haiku-4-5"}],"has_more":false,
+      "first_id":"claude-sonnet-4-5","last_id":"claude-haiku-4-5"})";
+  EXPECT_EQ(
+      ParseModelList(anthropic),
+      (std::vector<std::string>{"claude-sonnet-4-5", "claude-haiku-4-5"}));
+}
+
+}  // namespace
+}  // namespace rac::ai

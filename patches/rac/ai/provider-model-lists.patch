+// The model picker's list for one provider: what its server offers plus the
+// saved model. Only asked while the page is open with the assistant on.
+void RacAiHandler::HandleGetProviderModels(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  AllowJavascript();
+  const std::string& id = args[1].GetString();
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_) ||
+      !rac::ai::FindProvider(id)) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  FetchProviderModels(args[0].Clone(), id);
+}
+
+void RacAiHandler::FetchProviderModels(base::Value callback_id,
+                                       std::string provider_id) {
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  const rac::ai::ProviderInfo* info = rac::ai::FindProvider(provider_id);
+  if (!service || !info) {
+    RejectJavascriptCallback(std::move(callback_id), base::Value());
+    return;
+  }
+  const rac::ai::ProviderSettings settings =
+      rac::ai::GetProviderSettings(profile_->GetPrefs(), provider_id);
+  if (settings.base_url.empty()) {
+    ResolveJavascriptCallback(
+        std::move(callback_id),
+        base::DictValue().Set("models", base::ListValue()));
+    return;
+  }
+  if (const std::vector<std::string>* cached =
+          service->model_list_cache().Find(provider_id)) {
+    ResolveJavascriptCallback(
+        std::move(callback_id),
+        base::DictValue().Set(
+            "models",
+            ModelListValue(rac::ai::MergeModelChoices(
+                {}, settings.model, *cached,
+                info->requires_key ? rac::ai::kMaxMenuModelsPerProvider
+                                   : rac::ai::kMaxListedModels))));
+    return;
+  }
+  if (!info->requires_key) {
+    model_loader_ = rac::ai::FetchProviderModels(
+        service->url_loader_factory(), *info, settings.base_url, std::string(),
+        base::BindOnce(&RacAiHandler::OnProviderModelsListed,
+                       weak_factory_.GetWeakPtr(), std::move(callback_id),
+                       provider_id));
+    return;
+  }
+  service->key_store().GetKey(
+      provider_id,
+      base::BindOnce(&RacAiHandler::OnProviderKey, weak_factory_.GetWeakPtr(),
+                     std::move(callback_id), provider_id));
+}
+
+void RacAiHandler::OnProviderKey(base::Value callback_id,
+                                 std::string provider_id,
+                                 std::optional<std::string> key) {
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  const rac::ai::ProviderInfo* info = rac::ai::FindProvider(provider_id);
+  if (service && info && key) {
+    const rac::ai::ProviderSettings settings =
+        rac::ai::GetProviderSettings(profile_->GetPrefs(), provider_id);
+    model_loader_ = rac::ai::FetchProviderModels(
+        service->url_loader_factory(), *info, settings.base_url, *key,
+        base::BindOnce(&RacAiHandler::OnProviderModelsListed,
+                       weak_factory_.GetWeakPtr(), std::move(callback_id),
+                       provider_id));
+    return;
+  }
+  OnProviderModelsListed(std::move(callback_id), provider_id, {});
+}
+
+void RacAiHandler::OnProviderModelsListed(base::Value callback_id,
+                                          std::string provider_id,
+                                          std::vector<std::string> models) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (rac::ai::AiService* service =
+          rac::ai::AiServiceFactory::GetForProfile(profile_)) {
+    service->model_list_cache().Store(provider_id, models);
+    const rac::ai::ProviderSettings settings =
+        rac::ai::GetProviderSettings(profile_->GetPrefs(), provider_id);
+    ResolveJavascriptCallback(
+        std::move(callback_id),
+        base::DictValue().Set(
+            "models",
+            ModelListValue(rac::ai::MergeModelChoices(
+                {}, settings.model, models,
+                rac::ai::FindProvider(provider_id) &&
+                        rac::ai::FindProvider(provider_id)->requires_key
+                    ? rac::ai::kMaxMenuModelsPerProvider
+                    : rac::ai::kMaxListedModels))));
+  }
+}

   }
+  settings.models = DedupeModels(std::move(settings.models));
   return settings;
 }
 
 void SetProviderSettings(PrefService* prefs,
                          const std::string& provider_id,
                          const ProviderSettings& settings) {
+  std::vector<std::string> models = DedupeModels(settings.models);
   ScopedDictPrefUpdate update(prefs, kProviderSettings);
-  update->Set(provider_id, base::DictValue()
-                               .Set("base_url", settings.base_url)
-                               .Set("model", settings.model));
+  base::DictValue saved;
+  saved.Set("base_url", settings.base_url);
+  saved.Set("model", settings.model);
+  base::ListValue list;
+  for (const std::string& model : models) {
+    list.Append(model);
+  }
+  saved.Set("models", std::move(list));
+  update->Set(provider_id, std::move(saved));
+}
+
+std::vector<std::string> DedupeModels(std::vector<std::string> models) {
+  std::vector<std::string> kept;
+  for (std::string& model : models) {
+    std::string id = SanitizeModelId(model);
+    if (id.empty() || std::ranges::find(kept, id) != kept.end()) {
+      continue;
+    }
+    if (kept.size() >= kMaxChosenModels) {
+      break;
+    }
+    kept.push_back(std::move(id));
+  }
+  return kept;
 }
 
 }  // namespace rac::ai

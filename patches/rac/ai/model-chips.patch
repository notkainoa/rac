+
+TEST(RacAiPrefsTest, ProviderSettingsRoundTripWithModels) {
+  TestingPrefServiceSimple prefs;
+  RegisterProfilePrefs(prefs.registry());
+  ProviderSettings settings;
+  settings.base_url = "https://example.com/v1";
+  settings.model = "a";
+  settings.models = {"a", "b"};
+  SetProviderSettings(&prefs, "custom", settings);
+  const ProviderSettings read = GetProviderSettings(&prefs, "custom");
+  EXPECT_EQ(read.base_url, "https://example.com/v1");
+  EXPECT_EQ(read.model, "a");
+  EXPECT_EQ(read.models, (std::vector<std::string>{"a", "b"}));
+}
+
+TEST(RacAiPrefsTest, SingleModelPrefMigratesIntoTheList) {
+  TestingPrefServiceSimple prefs;
+  RegisterProfilePrefs(prefs.registry());
+  // The shape saved before model lists existed.
+  prefs.SetDict(kProviderSettings,
+                base::DictValue().Set(
+                    "custom", base::DictValue()
+                                  .Set("base_url", "https://example.com/v1")
+                                  .Set("model", "old-model")));
+  const ProviderSettings read = GetProviderSettings(&prefs, "custom");
+  EXPECT_EQ(read.model, "old-model");
+  EXPECT_EQ(read.models, (std::vector<std::string>{"old-model"}));
+}
+
+TEST(RacAiPrefsTest, UntouchedProviderKeepsNoChosenModels) {
+  TestingPrefServiceSimple prefs;
+  RegisterProfilePrefs(prefs.registry());
+  const ProviderInfo* info = FindProvider("openai");
+  ASSERT_TRUE(info);
+  const ProviderSettings read = GetProviderSettings(&prefs, "openai");
+  EXPECT_EQ(read.model, info->default_model);
+  EXPECT_TRUE(read.models.empty());
+}
+
+TEST(RacAiPrefsTest, DedupeModelsTrimsDedupesAndCaps) {
+  EXPECT_EQ(DedupeModels({" a ", "a", "b", "", std::string(300, 'x')}),
+            (std::vector<std::string>{"a", "b"}));
+  std::vector<std::string> many;
+  for (int i = 0; i < 30; ++i) {
+    many.push_back("m" + std::to_string(i));
+  }
+  EXPECT_EQ(DedupeModels(std::move(many)).size(), kMaxChosenModels);
+}
 }  // namespace rac::ai

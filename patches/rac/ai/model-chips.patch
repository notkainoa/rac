+
+// The model chips: the whole chosen list at once, with the default model.
+// An empty `model` means the first chip becomes the default.
+void RacAiHandler::HandleSaveModels(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 4u);
+  const std::string& id = args[1].GetString();
+  const std::string& model = rac::ai::SanitizeModelId(args[2].GetString());
+  const base::ListValue* models = args[3].GetIfList();
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_) ||
+      !rac::ai::FindProvider(id) || !models) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  rac::ai::ProviderSettings settings =
+      rac::ai::GetProviderSettings(profile_->GetPrefs(), id);
+  settings.models.clear();
+  for (const base::Value& value : *models) {
+    const std::string* entry = value.GetIfString();
+    if (entry) {
+      settings.models.push_back(*entry);
+    }
+  }
+  settings.models = rac::ai::DedupeModels(std::move(settings.models));
+  settings.model =
+      model.empty()
+          ? (settings.models.empty() ? std::string() : settings.models[0])
+          : model;
+  if (!settings.model.empty() &&
+      std::ranges::find(settings.models, settings.model) ==
+          settings.models.end()) {
+    settings.models.insert(settings.models.begin(), settings.model);
+    settings.models = rac::ai::DedupeModels(std::move(settings.models));
+  }
+  rac::ai::SetProviderSettings(profile_->GetPrefs(), id, settings);
   ResolveJavascriptCallback(args[0], CreateState());
 }
 

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/active_provider.h"
+
+#include <string>
+
+#include "chrome/browser/rac/ai/acp/agent_recipes.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+class RacActiveProviderTest : public testing::Test {
+ protected:
+  void SetUp() override { RegisterProfilePrefs(prefs_.registry()); }
+
+  // What a new message goes to: an agent id, or the direct provider's id.
+  std::string Active() const {
+    const AgentRecipe* agent = GetActiveAgent(&prefs_, false);
+    return agent ? std::string("agent:") + agent->id
+                 : "direct:" + prefs_.GetString(kProvider);
+  }
+
+  TestingPrefServiceSimple prefs_;
+};
+
+TEST_F(RacActiveProviderTest, ChoosingAnApiKeyProviderClearsTheAgent) {
+  ASSERT_TRUE(SelectAgent(&prefs_, "claude"));
+  ASSERT_EQ(Active(), "agent:claude");
+
+  EXPECT_TRUE(SelectDirectProvider(&prefs_, "anthropic"));
+  EXPECT_EQ(prefs_.GetString(kAgentId), "");
+  EXPECT_EQ(Active(), "direct:anthropic");
+}
+
+// The bug in #124: Settings already showed OpenAI, so choosing it again has
+// to clear the agent too.
+TEST_F(RacActiveProviderTest, ChoosingTheSameDirectProviderClearsTheAgent) {
+  ASSERT_TRUE(SelectDirectProvider(&prefs_, "openai"));
+  ASSERT_TRUE(SelectAgent(&prefs_, "codex"));
+
+  EXPECT_TRUE(SelectDirectProvider(&prefs_, "openai"));
+  EXPECT_EQ(Active(), "direct:openai");
+}
+
+TEST_F(RacActiveProviderTest, ChoosingALocalModelClearsTheAgent) {
+  ASSERT_TRUE(SelectAgent(&prefs_, "codex"));
+  EXPECT_TRUE(SelectDirectProvider(&prefs_, "ollama"));
+  EXPECT_EQ(Active(), "direct:ollama");
+
+  ASSERT_TRUE(SelectAgent(&prefs_, "claude"));
+  EXPECT_TRUE(SelectDirectProvider(&prefs_, "lmstudio"));
+  EXPECT_EQ(Active(), "direct:lmstudio");
+}
+
+TEST_F(RacActiveProviderTest, ChoosingAnAgentSetsItAndKeepsTheDirectProvider) {
+  ASSERT_TRUE(SelectDirectProvider(&prefs_, "anthropic"));
+
+  EXPECT_TRUE(SelectAgent(&prefs_, "claude"));
+  EXPECT_EQ(prefs_.GetString(kAgentId), "claude");
+  // What the chat sends to, and names on its model button.
+  const AgentRecipe* agent = GetActiveAgent(&prefs_, false);
+  ASSERT_TRUE(agent);
+  EXPECT_STREQ(agent->id, "claude");
+  // Summaries and the safety check still have their provider.
+  EXPECT_EQ(prefs_.GetString(kProvider), "anthropic");
+
+  EXPECT_TRUE(SelectAgent(&prefs_, "codex"));
+  EXPECT_EQ(Active(), "agent:codex");
+}
+
+TEST_F(RacActiveProviderTest, UnknownIdsChangeNothing) {
+  ASSERT_TRUE(SelectDirectProvider(&prefs_, "anthropic"));
+  ASSERT_TRUE(SelectAgent(&prefs_, "claude"));
+
+  EXPECT_FALSE(SelectDirectProvider(&prefs_, "not-a-provider"));
+  EXPECT_FALSE(SelectDirectProvider(&prefs_, ""));
+  EXPECT_FALSE(SelectAgent(&prefs_, "not-an-agent"));
+  EXPECT_FALSE(SelectAgent(&prefs_, ""));
+  EXPECT_EQ(prefs_.GetString(kProvider), "anthropic");
+  EXPECT_EQ(Active(), "agent:claude");
+}
+
+TEST_F(RacActiveProviderTest, AgentsAreNeverActiveOffTheRecord) {
+  ASSERT_TRUE(SelectAgent(&prefs_, "claude"));
+  EXPECT_FALSE(GetActiveAgent(&prefs_, true));
+}
+
+// An id from a recipe a later version dropped names no agent.
+TEST_F(RacActiveProviderTest, AStaleAgentIdReadsAsTheDirectProvider) {
+  prefs_.SetString(kAgentId, "removed-agent");
+  EXPECT_EQ(Active(), "direct:openai");
+}
+

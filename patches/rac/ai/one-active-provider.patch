+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_ACTIVE_PROVIDER_H_
+#define CHROME_BROWSER_RAC_AI_ACTIVE_PROVIDER_H_
+
+#include <string_view>
+
+class PrefService;
+
+namespace rac::ai {
+
+struct AgentRecipe;
+
+// Exactly one provider is active per profile: the agent in kAgentId when it
+// names one, else the direct provider in kProvider. Settings and the chat's
+// model menu change it only through these two, so they always agree.
+//
+// A reply reads the choice once, when it starts, so a change applies to the
+// next message and never to a reply already running.
+
+// Makes the direct provider `provider_id` (an API-key or local provider)
+// active and drops the agent. Changes nothing and returns false for an
+// unknown id.
+bool SelectDirectProvider(PrefService* prefs, std::string_view provider_id);
+
+// Makes the agent `agent_id` active. The direct provider stays chosen
+// underneath, because link summaries and the safety check still use it.
+// Changes nothing and returns false for an unknown id. Callers refuse it off
+// the record, where agents never run.
+bool SelectAgent(PrefService* prefs, std::string_view agent_id);
+
+// The agent a new message goes to, or null when it goes to the direct
+// provider. Agents never run off the record.
+const AgentRecipe* GetActiveAgent(const PrefService* prefs,
+                                  bool off_the_record);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_ACTIVE_PROVIDER_H_

+// What the model button names, and whether a message can be sent. The first
+// draw and every later change read it the same way.
+void SetProviderState(Profile* profile,
+                      AiService* service,
+                      base::DictValue& state) {
+  PrefService* prefs = profile->GetPrefs();
+  const std::string provider_id = prefs->GetString(kProvider);
+  const ProviderInfo* info = FindProvider(provider_id);
+  const ProviderSettings settings = GetProviderSettings(prefs, provider_id);
+  const bool has_key =
+      info && (!info->requires_key || service->key_store().HasKey(provider_id));
+  const AgentRecipe* agent = GetActiveAgent(prefs, profile->IsOffTheRecord());
+  state.Set("providerName", agent ? agent->name : (info ? info->name : ""));
+  state.Set("model", agent ? std::string() : settings.model);
+  state.Set("agentId", agent ? agent->id : "");
+  state.Set("incognito", profile->IsOffTheRecord());
+  state.Set("configured", service->HasUsableProvider());
+  state.Set("needsKey", !agent && info && info->requires_key && !has_key);
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/active_provider.h"
+
+#include <string>
+
+#include "chrome/browser/rac/ai/acp/agent_recipes.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/ai/providers.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac::ai {
+
+bool SelectDirectProvider(PrefService* prefs, std::string_view provider_id) {
+  const ProviderInfo* info = FindProvider(provider_id);
+  if (!info) {
+    return false;
+  }
+  prefs->SetString(kProvider, info->id);
+  prefs->SetString(kAgentId, std::string());
+  return true;
+}
+
+bool SelectAgent(PrefService* prefs, std::string_view agent_id) {
+  const AgentRecipe* recipe = FindAgentRecipe(agent_id);
+  if (!recipe) {
+    return false;
+  }
+  prefs->SetString(kAgentId, recipe->id);
+  return true;
+}
+
+const AgentRecipe* GetActiveAgent(const PrefService* prefs,
+                                  bool off_the_record) {
+  if (off_the_record) {
+    return nullptr;
+  }
+  return FindAgentRecipe(prefs->GetString(kAgentId));
+}
+
+}  // namespace rac::ai

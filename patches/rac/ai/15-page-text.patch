--- /dev/null
+++ src/chrome/browser/rac/ai/page_text.cc
@@ -0,0 +1,289 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/ai/page_text.h"
+
+#include <algorithm>
+#include <limits>
+#include <utility>
+#include <vector>
+
+#include "base/hash/sha1.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/optimization_guide/proto/features/common_quality_data.pb.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+namespace {
+namespace proto = optimization_guide::proto;
+constexpr int kMaxDepth = 128;
+constexpr size_t kMaxTableRows = 20;
+constexpr size_t kMaxTableColumns = 8;
+
+std::string Clean(std::string_view text) {
+  std::string repaired = base::IsStringUTF8(text)
+                             ? std::string(text)
+                             : base::UTF16ToUTF8(base::UTF8ToUTF16(text));
+  return base::CollapseWhitespaceASCII(repaired, false);
+}
+
+bool InViewport(const proto::ContentNode& node) {
+  const auto& a = node.content_attributes();
+  if (a.has_geometry() && a.geometry().has_visible_bounding_box()) {
+    const auto& box = a.geometry().visible_bounding_box();
+    return box.width() > 0 && box.height() > 0;
+  }
+  return std::ranges::any_of(node.children_nodes(), &InViewport);
+}
+
+// APC groups H2/H3 in one font-size bucket and doesn't expose HTML levels.
+int HeadingLevel(const proto::ContentNode& node, int depth = 0) {
+  if (depth > kMaxDepth) {
+    return 2;
+  }
+  const auto& a = node.content_attributes();
+  if (a.has_text_data() && a.text_data().has_text_style()) {
+    switch (a.text_data().text_style().text_size()) {
+      case proto::TEXT_SIZE_XL:
+        return 1;
+      case proto::TEXT_SIZE_L:
+        return 2;
+      case proto::TEXT_SIZE_M_DEFAULT:
+        return 4;
+      case proto::TEXT_SIZE_S:
+        return 5;
+      case proto::TEXT_SIZE_XS:
+        return 6;
+      default:
+        return 2;
+    }
+  }
+  for (const auto& child : node.children_nodes()) {
+    if (child.content_attributes().has_text_data()) {
+      return HeadingLevel(child, depth + 1);
+    }
+  }
+  return 2;
+}
+
+std::string Inline(const proto::ContentNode& node, int depth = 0) {
+  if (depth > kMaxDepth) {
+    return {};
+  }
+  const auto& a = node.content_attributes();
+  if (a.has_text_data()) {
+    return Clean(a.text_data().text_content());
+  }
+  if (a.has_image_data()) {
+    const std::string alt = Clean(a.image_data().image_caption());
+    return alt.empty() ? "" : "[image: " + alt + "]";
+  }
+  if (a.has_form_control_data() && a.form_control_data().form_control_type() !=
+                                       proto::FORM_CONTROL_TYPE_FIELDSET) {
+    const auto& control = a.form_control_data();
+    std::string label = Clean(a.label());
+    if (label.empty()) {
+      for (const auto& child : node.children_nodes()) {
+        const std::string part = Inline(child, depth + 1);
+        if (!label.empty() && !part.empty()) {
+          label += ' ';
+        }
+        label += part;
+      }
+    }
+    if (label.empty()) {
+      label = Clean(control.field_name());
+    }
+    if (label.empty()) {
+      label = Clean(control.placeholder());
+    }
+    return "[input: " + (label.empty() ? "unlabelled" : label) + "]";
+  }
+  std::string text;
+  for (const auto& child : node.children_nodes()) {
+    std::string part = Inline(child, depth + 1);
+    if (!part.empty()) {
+      if (!text.empty()) {
+        text += ' ';
+      }
+      text += part;
+    }
+  }
+  if (a.has_anchor_data() && !text.empty()) {
+    const GURL url(a.anchor_data().url());
+    const std::string lower = base::ToLowerASCII(text);
+    // Generic labels and bare URLs add no useful context as markdown links.
+    if (url.SchemeIsHTTPOrHTTPS() && text.size() >= 3 && lower != "here" &&
+        lower != "click here" && lower != "link" && !GURL(text).is_valid() &&
+        text != url.host()) {
+      std::string target = base::StrCat({url.host(), url.path()});
+      base::TruncateUTF8ToByteSize(target, 100, &target);
+      for (char& c : target) {
+        if (c == '(' || c == ')' || c == '[' || c == ']' ||
+            base::IsAsciiWhitespace(c)) {
+          c = '_';
+        }
+      }
+      return "[" + text + "](" + target + ")";
+    }
+  }
+  return text;
+}
+
+struct Block {
+  std::string text;
+  bool visible;
+};
+
+void Collect(const proto::ContentNode& node,
+             std::vector<Block>& blocks,
+             int depth = 0) {
+  if (depth > kMaxDepth) {
+    return;
+  }
+  const auto& attributes = node.content_attributes();
+  if (attributes.has_form_control_data() &&
+      attributes.form_control_data().form_control_type() ==
+          proto::FORM_CONTROL_TYPE_FIELDSET) {
+    for (const auto& child : node.children_nodes()) {
+      Collect(child, blocks, depth + 1);
+    }
+    return;
+  }
+  const auto type = attributes.attribute_type();
+  std::string text;
+  if (type == proto::CONTENT_ATTRIBUTE_TABLE_ROW) {
+    size_t columns = 0;
+    for (const auto& cell : node.children_nodes()) {
+      if (columns++ >= kMaxTableColumns) {
+        break;
+      }
+      std::string value = Inline(cell);
+      base::ReplaceChars(value, "|", "/", &value);
+      base::TruncateUTF8ToByteSize(value, 240, &value);
+      text += "| " + value + " ";
+    }
+    if (!text.empty()) {
+      text += '|';
+    }
+  } else if (type == proto::CONTENT_ATTRIBUTE_TABLE) {
+    size_t rows = 0;
+    for (const auto& row : node.children_nodes()) {
+      if (row.content_attributes().attribute_type() ==
+              proto::CONTENT_ATTRIBUTE_TABLE_ROW &&
+          rows++ >= kMaxTableRows) {
+        break;
+      }
+      Collect(row, blocks, depth + 1);
+    }
+    return;
+  } else if (type == proto::CONTENT_ATTRIBUTE_HEADING) {
+    text = Inline(node);
+    if (!text.empty()) {
+      text = std::string(HeadingLevel(node), '#') + " " + text;
+    }
+  } else if (type == proto::CONTENT_ATTRIBUTE_LIST_ITEM) {
+    // Nested lists remain separate blocks instead of losing their markers.
+    for (const auto& child : node.children_nodes()) {
+      const auto child_type = child.content_attributes().attribute_type();
+      if (child_type == proto::CONTENT_ATTRIBUTE_ORDERED_LIST ||
+          child_type == proto::CONTENT_ATTRIBUTE_UNORDERED_LIST) {
+        continue;
+      }
+      const std::string part = Inline(child);
+      if (!text.empty() && !part.empty()) {
+        text += ' ';
+      }
+      text += part;
+    }
+    if (!text.empty()) {
+      blocks.push_back({"- " + text, InViewport(node)});
+    }
+    for (const auto& child : node.children_nodes()) {
+      const auto child_type = child.content_attributes().attribute_type();
+      if (child_type == proto::CONTENT_ATTRIBUTE_ORDERED_LIST ||
+          child_type == proto::CONTENT_ATTRIBUTE_UNORDERED_LIST) {
+        Collect(child, blocks, depth + 1);
+      }
+    }
+    return;
+  } else if (type == proto::CONTENT_ATTRIBUTE_PARAGRAPH ||
+             type == proto::CONTENT_ATTRIBUTE_ANCHOR ||
+             node.content_attributes().has_text_data() ||
+             node.content_attributes().has_image_data() ||
+             node.content_attributes().has_form_control_data()) {
+    text = Inline(node);
+  } else {
+    // Iframe content is already inline in the APC tree.
+    for (const auto& child : node.children_nodes()) {
+      Collect(child, blocks, depth + 1);
+    }
+    return;
+  }
+  if (!text.empty()) {
+    blocks.push_back({std::move(text), InViewport(node)});
+  }
+}
+
+void Selections(const proto::FrameData& frame, std::vector<Block>& blocks) {
+  std::string text =
+      Clean(frame.frame_interaction_info().selection().selected_text());
+  if (!text.empty()) {
+    blocks.push_back({"Selection: " + text, true});
+  }
+}
+
+void FrameSelections(const proto::ContentNode& node,
+                     std::vector<Block>& blocks,
+                     int depth = 0) {
+  if (depth > kMaxDepth) {
+    return;
+  }
+  if (node.content_attributes().has_iframe_data()) {
+    Selections(node.content_attributes().iframe_data().frame_data(), blocks);
+  }
+  for (const auto& child : node.children_nodes()) {
+    FrameSelections(child, blocks, depth + 1);
+  }
+}
+}  // namespace
+
+std::string HashPageText(std::string_view title,
+                         std::string_view url,
+                         std::string_view text) {
+  const std::string source = base::StrCat({url, "\n", title, "\n", text});
+  return base::HexEncode(base::SHA1HashString(source));
+}
+
+PageText SerializePageContent(const proto::AnnotatedPageContent& page,
+                              size_t max_tokens) {
+  PageText result;
+  result.title = Clean(page.main_frame_data().title());
+  result.url = page.main_frame_data().url();
+  std::vector<Block> blocks;
+  Selections(page.main_frame_data(), blocks);
+  FrameSelections(page.root_node(), blocks);
+  const size_t selection_count = blocks.size();
+  Collect(page.root_node(), blocks);
+  std::stable_partition(blocks.begin() + selection_count, blocks.end(),
+                        [](const Block& block) { return block.visible; });
+  const size_t budget =
+      std::min(max_tokens, std::numeric_limits<size_t>::max() / 4) * 4;
+  for (const auto& block : blocks) {
+    const size_t separator = result.text.empty() ? 0 : 2;
+    if (separator + block.text.size() > budget - result.text.size()) {
+      break;
+    }
+    if (separator) {
+      result.text += "\n\n";
+    }
+    result.text += block.text;
+  }
+  result.approximate_tokens = (result.text.size() + 3) / 4;
+  result.content_hash = HashPageText(result.title, result.url, result.text);
+  return result;
+}
+}  // namespace rac::ai

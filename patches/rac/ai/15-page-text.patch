+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_AI_PAGE_TEXT_H_
+#define CHROME_BROWSER_RAC_AI_PAGE_TEXT_H_
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+
+namespace optimization_guide::proto {
+class AnnotatedPageContent;
+}
+
+namespace rac::ai {
+inline constexpr size_t kDefaultPageTokens = 8192;
+
+struct PageText {
+  std::string title;
+  std::string url;
+  std::string text;
+  std::string content_hash;
+  size_t approximate_tokens = 0;
+};
+
+// Hashes the serialized context, including its source, independently of DOM
+// IDs.
+std::string HashPageText(std::string_view title,
+                         std::string_view url,
+                         std::string_view text);
+
+// Selection, then visible blocks, then remaining blocks in document order.
+// Missing geometry is unknown, never evidence that a node is hidden.
+PageText SerializePageContent(
+    const optimization_guide::proto::AnnotatedPageContent& page,
+    size_t max_tokens = kDefaultPageTokens);
+}  // namespace rac::ai
+#endif  // CHROME_BROWSER_RAC_AI_PAGE_TEXT_H_

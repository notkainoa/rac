-// The system prompt for a reply: `base`, then each attached page in its own
-// <page> block. Page text is untrusted, so it is cut to size, cannot close its
-// block early, and is introduced as reference material only.
+// Callers generate a fresh random nonce for each changed attachment. Only
+// ASCII alphanumeric nonces are accepted. All occurrences in data are defused.
+std::string WrapPageContent(const PageAttachment& page, std::string_view nonce);
 std::string BuildSystemPrompt(std::string_view base,
                               const std::vector<PageAttachment>& pages);
 
+// Owned by a conversation, not by the HTTP request. Stateless providers still
+// receive the original page in a stable system prefix on subsequent turns.
+class PagePromptCache {
+ public:
+  void Apply(ChatRequest& request);
+  void Clear();
+
+ private:
+  struct Entry {
+    std::string key;
+    std::string hash;
+    std::string block;
+    size_t text_bytes = 0;
+  };
+  std::vector<Entry> entries_;
+};

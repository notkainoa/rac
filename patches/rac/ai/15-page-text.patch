@@ -0,0 +1,208 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/ai/page_text.h"
+
+#include "base/strings/string_util.h"
+#include "components/optimization_guide/proto/features/common_quality_data.pb.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+namespace proto = optimization_guide::proto;
+proto::ContentNode* Node(proto::ContentNode* parent,
+                         proto::ContentAttributeType type) {
+  auto* node = parent->add_children_nodes();
+  node->mutable_content_attributes()->set_attribute_type(type);
+  return node;
+}
+proto::ContentNode* Text(proto::ContentNode* parent, std::string text) {
+  auto* node = Node(parent, proto::CONTENT_ATTRIBUTE_TEXT);
+  node->mutable_content_attributes()->mutable_text_data()->set_text_content(
+      text);
+  return node;
+}
+proto::ContentNode* Paragraph(proto::ContentNode* parent, std::string text) {
+  auto* node = Node(parent, proto::CONTENT_ATTRIBUTE_PARAGRAPH);
+  Text(node, text);
+  return node;
+}
+void Visible(proto::ContentNode* node) {
+  auto* box = node->mutable_content_attributes()
+                  ->mutable_geometry()
+                  ->mutable_visible_bounding_box();
+  box->set_width(200);
+  box->set_height(20);
+}
+}  // namespace
+
+TEST(RacAiPageTextTest, HeadingsParagraphsAndNestedLists) {
+  proto::AnnotatedPageContent page;
+  auto* root = page.mutable_root_node();
+  auto* heading = Node(root, proto::CONTENT_ATTRIBUTE_HEADING);
+  auto* title = Text(heading, "A title");
+  title->mutable_content_attributes()
+      ->mutable_text_data()
+      ->mutable_text_style()
+      ->set_text_size(proto::TEXT_SIZE_XL);
+  Paragraph(root, "A paragraph.");
+  auto* list = Node(root, proto::CONTENT_ATTRIBUTE_UNORDERED_LIST);
+  auto* item = Node(list, proto::CONTENT_ATTRIBUTE_LIST_ITEM);
+  Text(item, "First");
+  auto* nested = Node(item, proto::CONTENT_ATTRIBUTE_ORDERED_LIST);
+  Text(Node(nested, proto::CONTENT_ATTRIBUTE_LIST_ITEM), "Nested");
+  Text(Node(list, proto::CONTENT_ATTRIBUTE_LIST_ITEM), "Second");
+  EXPECT_EQ(SerializePageContent(page).text,
+            "# A title\n\nA paragraph.\n\n- First\n\n- Nested\n\n- Second");
+}
+
+TEST(RacAiPageTextTest, HeadingSizeBuckets) {
+  const proto::TextSize sizes[] = {proto::TEXT_SIZE_XL, proto::TEXT_SIZE_L,
+                                   proto::TEXT_SIZE_M_DEFAULT,
+                                   proto::TEXT_SIZE_S, proto::TEXT_SIZE_XS};
+  const int levels[] = {1, 2, 4, 5, 6};
+  for (int i = 0; i < 5; ++i) {
+    proto::AnnotatedPageContent page;
+    auto* heading =
+        Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_HEADING);
+    Text(heading, "Title")
+        ->mutable_content_attributes()
+        ->mutable_text_data()
+        ->mutable_text_style()
+        ->set_text_size(sizes[i]);
+    EXPECT_EQ(SerializePageContent(page).text,
+              std::string(levels[i], '#') + " Title");
+  }
+}
+
+TEST(RacAiPageTextTest, MeaningfulLinksHaveShortDestinations) {
+  proto::AnnotatedPageContent page;
+  auto* paragraph =
+      Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_PARAGRAPH);
+  for (const auto& label :
+       {"Reference manual", "click here", "https://example.com"}) {
+    auto* anchor = Node(paragraph, proto::CONTENT_ATTRIBUTE_ANCHOR);
+    anchor->mutable_content_attributes()->mutable_anchor_data()->set_url(
+        "https://example.com/docs?secret=x#fragment");
+    Text(anchor, label);
+  }
+  const auto text = SerializePageContent(page).text;
+  EXPECT_EQ(
+      text,
+      "[Reference manual](example.com/docs) click here https://example.com");
+  EXPECT_EQ(text.find("secret"), std::string::npos);
+}
+
+TEST(RacAiPageTextTest, TablesAreBoundedAndEscapePipes) {
+  proto::AnnotatedPageContent page;
+  auto* table = Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_TABLE);
+  for (int row = 0; row < 30; ++row) {
+    auto* line = Node(table, proto::CONTENT_ATTRIBUTE_TABLE_ROW);
+    for (int col = 0; col < 12; ++col) {
+      Text(Node(line, proto::CONTENT_ATTRIBUTE_TABLE_CELL), "a|b");
+    }
+  }
+  const auto text = SerializePageContent(page).text;
+  EXPECT_EQ(std::ranges::count(text, '|'), 20 * 9);
+  EXPECT_EQ(std::ranges::count(text, '/'), 20 * 8);
+}
+
+TEST(RacAiPageTextTest, FormLabelsAltTextAndIframes) {
+  proto::AnnotatedPageContent page;
+  auto* root = page.mutable_root_node();
+  auto* form = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  form->mutable_content_attributes()->set_label("Your email");
+  form->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_field_value("private value");
+  auto* image = Node(root, proto::CONTENT_ATTRIBUTE_IMAGE);
+  image->mutable_content_attributes()->mutable_image_data()->set_image_caption(
+      "A diagram");
+  Node(root, proto::CONTENT_ATTRIBUTE_IMAGE)
+      ->mutable_content_attributes()
+      ->mutable_image_data();
+  auto* frame = Node(root, proto::CONTENT_ATTRIBUTE_IFRAME);
+  Paragraph(frame, "Inside iframe");
+  EXPECT_EQ(SerializePageContent(page).text,
+            "[input: Your email]\n\n[image: A diagram]\n\nInside iframe");
+}
+
+TEST(RacAiPageTextTest, FieldsetsPreserveControlsAndButtonLabels) {
+  proto::AnnotatedPageContent page;
+  auto* fieldset =
+      Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  fieldset->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_form_control_type(proto::FORM_CONTROL_TYPE_FIELDSET);
+  Paragraph(fieldset, "Pizza size");
+  auto* radio = Node(fieldset, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  radio->mutable_content_attributes()->set_label("Small");
+  radio->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_form_control_type(proto::FORM_CONTROL_TYPE_INPUT_RADIO);
+  auto* button =
+      Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  button->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_form_control_type(proto::FORM_CONTROL_TYPE_BUTTON_SUBMIT);
+  Text(button, "Submit order");
+  EXPECT_EQ(SerializePageContent(page).text,
+            "Pizza size\n\n[input: Small]\n\n[input: Submit order]");
+}
+
+TEST(RacAiPageTextTest, SelectionThenViewportThenRemainingContent) {
+  proto::AnnotatedPageContent page;
+  auto* root = page.mutable_root_node();
+  Paragraph(root, "Outside");
+  Visible(Paragraph(root, "Visible"));
+  auto* frame = Node(root, proto::CONTENT_ATTRIBUTE_IFRAME);
+  frame->mutable_content_attributes()
+      ->mutable_iframe_data()
+      ->mutable_frame_data()
+      ->mutable_frame_interaction_info()
+      ->mutable_selection()
+      ->set_selected_text("Frame selection");
+  page.mutable_main_frame_data()
+      ->mutable_frame_interaction_info()
+      ->mutable_selection()
+      ->set_selected_text("Chosen text");
+  EXPECT_EQ(SerializePageContent(page).text,
+            "Selection: Chosen text\n\nSelection: Frame "
+            "selection\n\nVisible\n\nOutside");
+}
+
+TEST(RacAiPageTextTest, BudgetStopsAtBlockBoundaries) {
+  proto::AnnotatedPageContent page;
+  Paragraph(page.mutable_root_node(), "One.");
+  Paragraph(page.mutable_root_node(), "Two.");
+  Paragraph(page.mutable_root_node(), "Three.");
+  const auto result = SerializePageContent(page, 3);
+  EXPECT_EQ(result.text, "One.\n\nTwo.");
+  EXPECT_EQ(result.approximate_tokens, 3u);
+  EXPECT_TRUE(SerializePageContent(page, 0).text.empty());
+}
+
+TEST(RacAiPageTextTest, HashIgnoresIdsButIncludesContentAndSource) {
+  proto::AnnotatedPageContent page;
+  page.mutable_main_frame_data()->set_title("Title");
+  page.mutable_main_frame_data()->set_url("https://example.com/");
+  auto* node = Paragraph(page.mutable_root_node(), "Stable");
+  const auto first = SerializePageContent(page);
+  node->mutable_content_attributes()->set_common_ancestor_dom_node_id(42);
+  EXPECT_EQ(first.content_hash, SerializePageContent(page).content_hash);
+  EXPECT_EQ(first.title, "Title");
+  EXPECT_EQ(first.url, "https://example.com/");
+  Text(node, "Change");
+  EXPECT_NE(first.content_hash, SerializePageContent(page).content_hash);
+  EXPECT_NE(HashPageText("a", "b", "c"), HashPageText("a", "c", "b"));
+}
+
+TEST(RacAiPageTextTest, Utf8IsRepairedAndNeverSplitAtBudget) {
+  proto::AnnotatedPageContent page;
+  Paragraph(page.mutable_root_node(), "€");
+  Paragraph(page.mutable_root_node(), "日本語");
+  EXPECT_EQ(SerializePageContent(page, 2).text, "€");
+  Text(page.mutable_root_node(), std::string("bad\xFF"));
+  EXPECT_TRUE(base::IsStringUTF8(SerializePageContent(page).text));
+}
+}  // namespace rac::ai

+// Links on a page may be summarized only when IsOnLinkSummaryPage() is true:
+// !IsInternalTab(), which is !IsInternalEntry() of the tab's last committed
+// entry (the page the link is on), and the address bar's address is a web
+// page too (!IsInternalPageUrl()). These tests build real navigation entries
+// the way a tab holds them.
+
+#include "chrome/browser/rac/ai/internal_tab.h"
+
+#include <memory>
+
+#include "chrome/browser/rac/ai/internal_page.h"
+#include "content/public/browser/content_browser_client.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/common/content_client.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+namespace {
+
+// A committed entry for `url`, shown in the address bar as `shown` (the same
+// address when `shown` is empty).
+std::unique_ptr<content::NavigationEntry> Entry(const char* url,
+                                                const char* shown) {
+  std::unique_ptr<content::NavigationEntry> entry =
+      content::NavigationEntry::Create();
+  entry->SetURL(GURL(url));
+  if (*shown) {
+    entry->SetVirtualURL(GURL(shown));
+  }
+  return entry;
+}
+
+// IsOnLinkSummaryPage() of a tab whose last committed entry is `url` shown
+// as `shown`, while the address bar shows `visible`.
+bool CanSummarizeOn(const char* url, const char* shown, const char* visible) {
+  return !IsInternalEntry(Entry(url, shown).get()) &&
+         !IsInternalPageUrl(GURL(visible), GURL());
+}
+
+// A navigation entry asks the content client for its default favicon.
+class RacLinkSummaryPageTest : public testing::Test {
+ protected:
+  RacLinkSummaryPageTest() {
+    content::SetContentClient(&client_);
+    content::SetBrowserClientForTesting(&browser_client_);
+  }
+  ~RacLinkSummaryPageTest() override {
+    content::SetBrowserClientForTesting(nullptr);
+    content::SetContentClient(nullptr);
+  }
+
+ private:
+  content::ContentClient client_;
+  content::ContentBrowserClient browser_client_;
+};
+
+TEST_F(RacLinkSummaryPageTest, LinksOnWebPagesCanBeSummarized) {
+  EXPECT_TRUE(CanSummarizeOn("https://example.com/post",
+                             "https://example.com/post",
+                             "https://example.com/post"));
+  EXPECT_TRUE(
+      CanSummarizeOn("http://127.0.0.1:8771/", "", "http://127.0.0.1:8771/"));
+  // The address bar may already show the next web page.
+  EXPECT_TRUE(CanSummarizeOn("https://example.com/", "https://example.com/",
+                             "https://example.org/next"));
+}
+
+TEST_F(RacLinkSummaryPageTest, LinksOnInternalPagesAreNeverSummarized) {
+  for (const char* page : {
+           "chrome://history/",
+           "rac://history/",
+           "chrome://downloads/",
+           "chrome://settings/assistant",
+           "rac://settings/",
+           "chrome://newtab/",
+           "rac://newtab/",
+           "chrome://rac-ai/?mode=page",
+           "chrome://bookmarks/",
+           "chrome-extension://abcdefghijklmnop/options.html",
+           "chrome-untrusted://print/",
+           "devtools://devtools/bundled/devtools_app.html",
+           "file:///Users/me/notes.html",
+           "about:blank",
+           "data:text/html,<a href=https://example.com>x</a>",
+       }) {
+    SCOPED_TRACE(page);
+    EXPECT_FALSE(CanSummarizeOn(page, page, page));
+    EXPECT_FALSE(CanSummarizeOn(page, "", page));
+  }
+}
+
+TEST_F(RacLinkSummaryPageTest, ViewSourceIsInternalThoughItsEntryIsTheWebPage) {
+  EXPECT_FALSE(CanSummarizeOn("https://example.com/",
+                              "view-source:https://example.com/",
+                              "view-source:https://example.com/"));
+}
+
+TEST_F(RacLinkSummaryPageTest, ATabBetweenInternalAndWebPagesIsRefused) {
+  // Leaving history for a web page: history's links are still on screen.
+  EXPECT_FALSE(CanSummarizeOn("chrome://history/", "chrome://history/",
+                              "https://example.com/"));
+  // Typed chrome://history on a web page: refused until it settles.
+  EXPECT_FALSE(CanSummarizeOn("https://example.com/", "https://example.com/",
+                              "chrome://history/"));
+  // A web entry that shows an internal address.
+  EXPECT_FALSE(CanSummarizeOn("https://example.com/", "rac://settings/",
+                              "https://example.com/"));
+}
+
+TEST_F(RacLinkSummaryPageTest, NoPageMeansNoSummary) {
+  EXPECT_FALSE(CanSummarizeOn("", "", ""));
+  EXPECT_FALSE(CanSummarizeOn("", "", "https://example.com/"));
+  EXPECT_FALSE(
+      CanSummarizeOn("https://example.com/", "https://example.com/", ""));
+  EXPECT_FALSE(CanSummarizeOn("not a url", "", "https://example.com/"));
+  // A tab that has committed nothing, and no tab at all.
+  EXPECT_TRUE(IsInternalEntry(nullptr));
+  EXPECT_TRUE(IsInternalTab(nullptr));
+}
+

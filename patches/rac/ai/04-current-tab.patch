+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_CHAT_PROMPT_H_
+#define CHROME_BROWSER_RAC_AI_CHAT_PROMPT_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rac::ai {
+
+// The most text taken from one page, and from all pages in one message.
+inline constexpr size_t kMaxPageChars = 60 * 1024;
+inline constexpr size_t kMaxAttachedChars = 150 * 1024;
+
+// Text the user chose to share from a web page.
+struct PageAttachment {
+  std::string title;
+  std::string url;
+  std::string text;
+};
+
+// The system prompt for a reply: `base`, then each attached page in its own
+// <page> block. Page text is untrusted, so it is cut to size, cannot close its
+// block early, and is introduced as reference material only.
+std::string BuildSystemPrompt(std::string_view base,
+                              const std::vector<PageAttachment>& pages);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CHAT_PROMPT_H_

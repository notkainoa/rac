+void PageHandler::ReadNextPage(std::unique_ptr<PendingSend> send) {
+  while (!send->tab_ids.empty()) {
+    const int id = send->tab_ids.front();
+    send->tab_ids.erase(send->tab_ids.begin());
+    tabs::TabInterface* tab = tabs::TabHandle(id).Get();
+    BrowserWindowInterface* browser = GetBrowser();
+    if (!tab || !browser || tab->GetBrowserWindowInterface() != browser ||
+        !IsAttachable(tab)) {
+      send->failed.push_back("A tab you attached");
+      continue;
+    }
+    std::string title = base::UTF16ToUTF8(tab->GetTitle());
+    std::string url = tab->GetContents()->GetLastCommittedURL().spec();
+    if (title.empty()) {
+      title = url;
+    }
+    ExtractPageText(
+        tab->GetContents(),
+        base::BindOnce(&PageHandler::OnPageRead, reading_factory_.GetWeakPtr(),
+                       std::move(send), title, std::move(url)));
+    return;
+  }
+  StartSession(std::move(send));
+}

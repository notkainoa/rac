+void PageHandler::OnCurrentTabChanged() {
+  tab_observer_.reset();
+  BrowserWindowInterface* browser = GetBrowser();
+  tabs::TabInterface* tab =
+      browser ? browser->GetActiveTabInterface() : nullptr;
+  if (tab && tab->GetContents()) {
+    tab_observer_ = std::make_unique<TabObserver>(
+        tab->GetContents(), base::BindRepeating(&PageHandler::NotifyCurrentTab,
+                                                weak_factory_.GetWeakPtr()));
+  }
+  NotifyCurrentTab();
+}

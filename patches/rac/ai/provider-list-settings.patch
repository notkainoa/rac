+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/provider_list.h"
+
+#include <string>
+#include <vector>
+
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/rac/ai/active_provider.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/ai/providers.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+// Every agent rac knows, none found.
+std::vector<FoundAgent> NoneFound() {
+  return {{"opencode"}, {"cursor"}, {"gemini"}, {"copilot"},
+          {"codex"},    {"claude"}, {"goose"},  {"custom"}};
+}
+
+std::vector<FoundAgent> With(std::vector<FoundAgent> agents,
+                             const std::string& id,
+                             bool installed,
+                             bool needs_node = false) {
+  for (FoundAgent& agent : agents) {
+    if (agent.id == id) {
+      agent.installed = installed;
+      agent.needs_node = needs_node;
+    }
+  }
+  return agents;
+}
+
+const char* Name(ProviderGroup group) {
+  switch (group) {
+    case ProviderGroup::kAgents:
+      return "agents";
+    case ProviderGroup::kApiKey:
+      return "apiKey";
+    case ProviderGroup::kLocal:
+      return "local";
+  }
+}
+
+// "agents,apiKey,local"
+std::string Groups(const std::vector<ProviderRowGroup>& list) {
+  std::vector<std::string> names;
+  for (const ProviderRowGroup& group : list) {
+    names.push_back(Name(group.group));
+  }
+  return base::JoinString(names, ",");
+}
+
+// The rows of one group, with missing agents in brackets and the chosen row
+// starred: "claude*,[codex],custom".
+std::string Rows(const std::vector<ProviderRowGroup>& list,
+                 ProviderGroup which) {
+  std::vector<std::string> rows;
+  for (const ProviderRowGroup& group : list) {
+    if (group.group != which) {
+      continue;
+    }
+    for (const ProviderRow& row : group.rows) {
+      std::string text = row.not_installed ? "[" + row.id + "]" : row.id;
+      rows.push_back(row.chosen ? text + "*" : text);
+    }
+  }
+  return base::JoinString(rows, ",");
+}
+
+// The agent rows that can't be chosen: "codex,custom".
+std::string Disabled(const std::vector<ProviderRowGroup>& list) {
+  std::vector<std::string> rows;
+  for (const ProviderRowGroup& group : list) {
+    for (const ProviderRow& row : group.rows) {
+      if (row.disabled) {
+        rows.push_back(row.id);
+      }
+    }
+  }
+  return base::JoinString(rows, ",");
+}
+
+// Every chosen row in the list, as "agent:id" or "direct:id".
+std::vector<std::string> Chosen(const std::vector<ProviderRowGroup>& list) {
+  std::vector<std::string> chosen;
+  for (const ProviderRowGroup& group : list) {
+    for (const ProviderRow& row : group.rows) {
+      if (row.chosen) {
+        chosen.push_back((row.is_agent ? "agent:" : "direct:") + row.id);
+      }
+    }
+  }
+  return chosen;
+}
+
+TEST(RacProviderListTest, AgentsComeFirstWhenOneIsInstalled) {
+  const auto list = BuildProviderList(
+      {.agents = With(NoneFound(), "claude", true), .direct_provider = ""});
+  EXPECT_EQ(Groups(list), "agents,apiKey,local");
+  EXPECT_EQ(Rows(list, ProviderGroup::kAgents),
+            "claude,[codex],[cursor],[gemini],[copilot],[opencode],[goose],"
+            "custom");
+}
+
+TEST(RacProviderListTest, ApiKeyComesFirstWhenNoAgentIsInstalled) {
+  const auto list =
+      BuildProviderList({.agents = NoneFound(), .direct_provider = "openai"});
+  EXPECT_EQ(Groups(list), "apiKey,local,agents");
+  EXPECT_EQ(Rows(list, ProviderGroup::kApiKey),
+            "openai*,anthropic,gemini,openrouter,custom");
+  EXPECT_EQ(Rows(list, ProviderGroup::kLocal), "ollama,lmstudio");
+}
+
+// While the probe hasn't answered, the agents group holds the top, so a
+// found agent fills it in place instead of pushing the list down.
+TEST(RacProviderListTest, AgentsHoldTheTopUntilTheProbeAnswers) {
+  const auto list = BuildProviderList({.direct_provider = "openai"});
+  EXPECT_EQ(Groups(list), "agents,apiKey,local");
+  EXPECT_EQ(Rows(list, ProviderGroup::kAgents), "");
+}
+
+TEST(RacProviderListTest, AgentsKeepAFixedOrderWithCustomLast) {
+  std::vector<FoundAgent> agents = NoneFound();
+  for (FoundAgent& agent : agents) {
+    agent.installed = true;
+  }
+  const auto list = BuildProviderList({.agents = agents});
+  EXPECT_EQ(Rows(list, ProviderGroup::kAgents),
+            "codex,claude,cursor,gemini,copilot,opencode,goose,custom");
+}
+
+// The probe found the program, but its adapter needs Node: the row stays in
+// view so it can say why it can't run. It doesn't count as installed.
+TEST(RacProviderListTest, AnAgentThatNeedsNodeStaysInViewButNotFirst) {
+  const auto list = BuildProviderList(
+      {.agents = With(NoneFound(), "codex", false, /*needs_node=*/true),
+       .direct_provider = "openai"});
+  EXPECT_EQ(Groups(list), "apiKey,local,agents");
+  EXPECT_EQ(Rows(list, ProviderGroup::kAgents),
+            "codex,[claude],[cursor],[gemini],[copilot],[opencode],[goose],"
+            "custom");
+}
+
+TEST(RacProviderListTest, AWorkingCustomCommandPutsAgentsFirst) {
+  const auto list = BuildProviderList(
+      {.agents = With(NoneFound(), "custom", true), .direct_provider = ""});
+  EXPECT_EQ(Groups(list), "agents,apiKey,local");
+}
+
+// Choosing is the consent: one found agent is never chosen for the user.
+TEST(RacProviderListTest, NeverChoosesAnAgentForTheUser) {
+  const auto list = BuildProviderList(
+      {.agents = With(NoneFound(), "claude", true), .direct_provider = ""});
+  EXPECT_TRUE(Chosen(list).empty());
+}
+
+TEST(RacProviderListTest, TheChosenAgentIsTheOnlyChosenRow) {
+  const auto list =
+      BuildProviderList({.agents = With(NoneFound(), "claude", true),
+                         .direct_provider = "anthropic",
+                         .agent = "claude"});
+  EXPECT_EQ(Chosen(list), std::vector<std::string>{"agent:claude"});
+}
+
+TEST(RacProviderListTest, TheDirectProviderIsChosenWithoutAnAgent) {
+  const auto list =
+      BuildProviderList({.agents = With(NoneFound(), "claude", true),
+                         .direct_provider = "ollama"});
+  EXPECT_EQ(Chosen(list), std::vector<std::string>{"direct:ollama"});
+  EXPECT_EQ(Rows(list, ProviderGroup::kLocal), "ollama*,lmstudio");
+}
+
+// The direct provider "custom" and the custom ACP command share an id; only
+// the one the profile uses is chosen.
+TEST(RacProviderListTest, CustomServerAndCustomAgentAreDifferentRows) {
+  auto list = BuildProviderList(
+      {.agents = NoneFound(), .direct_provider = "custom"});
+  EXPECT_EQ(Chosen(list), std::vector<std::string>{"direct:custom"});
+
+  list = BuildProviderList(
+      {.agents = NoneFound(), .direct_provider = "custom", .agent = "custom"});
+  EXPECT_EQ(Chosen(list), std::vector<std::string>{"agent:custom"});
+}
+
+// An agent the user chose stays in view even if it's no longer found, so
+// the list still shows what the chat uses.
+TEST(RacProviderListTest, AChosenAgentThatIsGoneStaysInView) {
+  const auto list = BuildProviderList(
+      {.agents = NoneFound(), .direct_provider = "openai", .agent = "goose"});
+  EXPECT_EQ(Groups(list), "agents,apiKey,local");
+  EXPECT_EQ(Rows(list, ProviderGroup::kAgents),
+            "goose*,[codex],[claude],[cursor],[gemini],[copilot],[opencode],"
+            "custom");
+}
+
+TEST(RacProviderListTest, TheChosenAgentShowsBeforeTheProbeAnswers) {
+  const auto list =
+      BuildProviderList({.direct_provider = "openai", .agent = "codex"});
+  EXPECT_EQ(Rows(list, ProviderGroup::kAgents), "codex*");
+  EXPECT_EQ(Chosen(list), std::vector<std::string>{"agent:codex"});
+}
+
+TEST(RacProviderListTest, UnknownIdsChooseNothing) {
+  const auto list = BuildProviderList({.agents = NoneFound(),
+                                       .direct_provider = "nope",
+                                       .agent = "also-nope"});
+  EXPECT_TRUE(Chosen(list).empty());
+  EXPECT_EQ(Groups(list), "apiKey,local,agents");
+}
+
+// A fresh profile's default provider isn't a choice the user made.
+TEST(RacProviderListTest, AFreshProfileHasNoChosenDirectProvider) {
+  TestingPrefServiceSimple prefs;
+  RegisterProfilePrefs(prefs.registry());
+  EXPECT_EQ(ChosenDirectProvider(prefs, /*usable=*/false), "");
+  // A key saved for the default provider makes it usable, and so chosen.
+  EXPECT_EQ(ChosenDirectProvider(prefs, /*usable=*/true),
+            kDefaultProviderId);
+}
+
+// Choosing the default provider's row in the list is still a choice.
+TEST(RacProviderListTest, ChoosingTheDefaultProviderShowsItChosen) {
+  TestingPrefServiceSimple prefs;
+  RegisterProfilePrefs(prefs.registry());
+  ASSERT_TRUE(SelectDirectProvider(&prefs, kDefaultProviderId));
+  EXPECT_EQ(ChosenDirectProvider(prefs, /*usable=*/false),
+            kDefaultProviderId);
+
+  ASSERT_TRUE(SelectDirectProvider(&prefs, "ollama"));
+  EXPECT_EQ(ChosenDirectProvider(prefs, /*usable=*/false), "ollama");
+}
+
+// Only an agent that can run can be chosen: not one that wasn't found, one
+// that needs Node, or a custom command that's empty or can't run. Direct
+// providers are never disabled.
+TEST(RacProviderListTest, AgentsThatCantRunAreDisabled) {
+  const auto list = BuildProviderList(
+      {.agents = With(With(NoneFound(), "claude", true), "codex", false,
+                      /*needs_node=*/true),
+       .direct_provider = "openai"});
+  EXPECT_EQ(Disabled(list),
+            "codex,cursor,gemini,copilot,opencode,goose,custom");
+}
+
+// The agent the profile already uses stays as it is, even once it's gone,
+// so the list shows what the chat sends to.
+TEST(RacProviderListTest, TheChosenAgentIsNeverDisabled) {
+  const auto list = BuildProviderList(
+      {.agents = NoneFound(), .direct_provider = "openai", .agent = "goose"});
+  EXPECT_EQ(Chosen(list), std::vector<std::string>{"agent:goose"});
+  EXPECT_EQ(Disabled(list),
+            "codex,claude,cursor,gemini,copilot,opencode,custom");
+}
+
+TEST(RacProviderListTest, OnlyARunnableAgentCanBeChosen) {
+  base::ListValue probe;
+  probe.Append(base::DictValue().Set("id", "claude").Set("installed", true));
+  probe.Append(base::DictValue()
+                   .Set("id", "codex")
+                   .Set("installed", false)
+                   .Set("needsNode", true));
+  probe.Append(base::DictValue().Set("id", "goose").Set("installed", false));
+  // Custom with no command, as the probe describes it.
+  probe.Append(base::DictValue()
+                   .Set("id", "custom")
+                   .Set("command", "")
+                   .Set("installed", false));
+
+  EXPECT_TRUE(IsAgentRunnable(probe, "claude"));
+  EXPECT_FALSE(IsAgentRunnable(probe, "codex"));
+  EXPECT_FALSE(IsAgentRunnable(probe, "goose"));
+  EXPECT_FALSE(IsAgentRunnable(probe, "custom"));
+  // Fails closed: no row, an unknown id, or an empty probe.
+  EXPECT_FALSE(IsAgentRunnable(probe, "cursor"));
+  EXPECT_FALSE(IsAgentRunnable(probe, "made-up"));
+  EXPECT_FALSE(IsAgentRunnable(base::ListValue(), "claude"));
+}
+
+TEST(RacProviderListTest, ParsesTheProbeAndDropsUnknownAgents) {
+  base::ListValue probe;
+  probe.Append(base::DictValue().Set("id", "claude").Set("installed", true));
+  probe.Append(base::DictValue()
+                   .Set("id", "codex")
+                   .Set("installed", false)
+                   .Set("needsNode", true));
+  probe.Append(base::DictValue().Set("id", "made-up").Set("installed", true));
+  probe.Append(base::DictValue().Set("installed", true));
+  probe.Append("not a row");
+
+  const std::vector<FoundAgent> found = ParseFoundAgents(probe);
+  ASSERT_EQ(found.size(), 2u);
+  EXPECT_EQ(found[0].id, "claude");
+  EXPECT_TRUE(found[0].installed);
+  EXPECT_FALSE(found[0].needs_node);
+  EXPECT_EQ(found[1].id, "codex");
+  EXPECT_FALSE(found[1].installed);
+  EXPECT_TRUE(found[1].needs_node);
+}
+
+TEST(RacProviderListTest, OnlyAgentsWithAVerifiedIdentityUseTheBrowser) {
+  for (const char* id : {"claude", "codex", "cursor", "opencode", "custom"}) {
+    EXPECT_TRUE(AgentCanUseBrowser(id)) << id;
+  }
+  for (const char* id : {"gemini", "copilot", "goose"}) {
+    EXPECT_FALSE(AgentCanUseBrowser(id)) << id;
+  }
+}
+
+TEST(RacProviderListTest, TheValueNamesRowsForTheList) {
+  const base::ListValue value = ProviderListToValue(
+      BuildProviderList({.agents = With(NoneFound(), "claude", true),
+                         .direct_provider = "ollama",
+                         .agent = "claude"}));
+  ASSERT_EQ(value.size(), 3u);
+  const base::DictValue& agents = value[0].GetDict();
+  EXPECT_EQ(*agents.FindString("group"), "agents");
+  const base::DictValue& claude = (*agents.FindList("rows"))[0].GetDict();
+  EXPECT_EQ(*claude.FindString("id"), "claude");
+  EXPECT_EQ(*claude.FindString("name"), "Claude Code");
+  EXPECT_EQ(claude.FindBool("agent"), true);
+  EXPECT_EQ(claude.FindBool("chosen"), true);
+  EXPECT_EQ(claude.FindBool("canUseBrowser"), true);
+  EXPECT_EQ(claude.FindBool("disabled"), false);
+  const base::DictValue& codex = (*agents.FindList("rows"))[1].GetDict();
+  EXPECT_EQ(*codex.FindString("id"), "codex");
+  EXPECT_EQ(codex.FindBool("disabled"), true);
+
+  const base::DictValue& local = value[2].GetDict();
+  EXPECT_EQ(*local.FindString("group"), "local");
+  const base::DictValue& ollama = (*local.FindList("rows"))[0].GetDict();
+  EXPECT_EQ(*ollama.FindString("name"), "Ollama");
+  EXPECT_EQ(ollama.FindBool("agent"), false);
+  EXPECT_EQ(ollama.FindBool("chosen"), false);
+  EXPECT_FALSE(ollama.FindBool("canUseBrowser").has_value());
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/provider_list.h"
+
+#include <algorithm>
+#include <iterator>
+#include <utility>
+
+#include "chrome/browser/rac/ai/acp/agent_recipes.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/ai/providers.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac::ai {
+namespace {
+
+// The order agents are listed in. Unknown ids sort after these, and the
+// custom command always goes last.
+constexpr std::string_view kAgentOrder[] = {
+    "codex", "claude", "cursor", "gemini", "copilot", "opencode", "goose",
+};
+constexpr char kCustomAgent[] = "custom";
+
+size_t AgentRank(std::string_view id) {
+  if (id == kCustomAgent) {
+    return std::size(kAgentOrder) + 1;
+  }
+  const auto* it = std::ranges::find(kAgentOrder, id);
+  return static_cast<size_t>(it - std::begin(kAgentOrder));
+}
+
+// The names the list shows where the provider's own name says more than
+// the group around it does.
+std::string_view ListName(std::string_view id, bool is_agent) {
+  if (is_agent) {
+    if (id == "claude") {
+      return "Claude Code";
+    }
+    const AgentRecipe* recipe = FindAgentRecipe(id);
+    return recipe ? recipe->name : id;
+  }
+  if (id == "ollama") {
+    return "Ollama";
+  }
+  if (id == "lmstudio") {
+    return "LM Studio";
+  }
+  const ProviderInfo* info = FindProvider(id);
+  return info ? info->name : id;
+}
+
+const char* GroupName(ProviderGroup group) {
+  switch (group) {
+    case ProviderGroup::kAgents:
+      return "agents";
+    case ProviderGroup::kApiKey:
+      return "apiKey";
+    case ProviderGroup::kLocal:
+      return "local";
+  }
+}
+
+}  // namespace
+
+std::vector<ProviderRowGroup> BuildProviderList(
+    const ProviderListInput& input) {
+  const bool agent_chosen = FindAgentRecipe(input.agent) != nullptr;
+
+  ProviderRowGroup agents{ProviderGroup::kAgents, {}};
+  bool any_installed = false;
+  if (input.agents) {
+    std::vector<FoundAgent> sorted = *input.agents;
+    std::ranges::stable_sort(sorted, {}, [](const FoundAgent& agent) {
+      return AgentRank(agent.id);
+    });
+    std::vector<ProviderRow> missing;
+    std::optional<ProviderRow> custom;
+    for (const FoundAgent& agent : sorted) {
+      if (!FindAgentRecipe(agent.id)) {
+        continue;
+      }
+      ProviderRow row{.id = agent.id,
+                      .is_agent = true,
+                      .chosen = agent_chosen && agent.id == input.agent};
+      row.disabled = !row.chosen && !agent.installed;
+      any_installed |= agent.installed;
+      if (agent.id == kCustomAgent) {
+        custom = std::move(row);
+        continue;
+      }
+      // An agent whose program was found but can't start yet (no Node)
+      // stays in view, so its row can say why.
+      if (agent.installed || agent.needs_node || row.chosen) {
+        agents.rows.push_back(std::move(row));
+      } else {
+        row.not_installed = true;
+        missing.push_back(std::move(row));
+      }
+    }
+    std::ranges::move(missing, std::back_inserter(agents.rows));
+    if (custom) {
+      agents.rows.push_back(std::move(*custom));
+    }
+  }
+  // Before the probe answers, the chosen agent is all the list knows.
+  if (agent_chosen &&
+      std::ranges::none_of(agents.rows, &ProviderRow::chosen)) {
+    agents.rows.insert(
+        agents.rows.begin(),
+        ProviderRow{.id = input.agent, .is_agent = true, .chosen = true});
+  }
+
+  ProviderRowGroup api_key{ProviderGroup::kApiKey, {}};
+  ProviderRowGroup local{ProviderGroup::kLocal, {}};
+  for (const ProviderInfo& info : GetProviders()) {
+    ProviderRow row{
+        .id = info.id,
+        .chosen = !agent_chosen && input.direct_provider == info.id};
+    (info.requires_key ? api_key : local).rows.push_back(std::move(row));
+  }
+
+  const bool agents_first = !input.agents || any_installed || agent_chosen;
+  std::vector<ProviderRowGroup> list;
+  if (agents_first) {
+    list.push_back(std::move(agents));
+  }
+  list.push_back(std::move(api_key));
+  list.push_back(std::move(local));
+  if (!agents_first) {
+    list.push_back(std::move(agents));
+  }
+  return list;
+}
+
+std::string ChosenDirectProvider(const PrefService& prefs, bool usable) {
+  if (!usable && prefs.FindPreference(kProvider)->IsDefaultValue()) {
+    return std::string();
+  }
+  return prefs.GetString(kProvider);
+}
+
+std::vector<FoundAgent> ParseFoundAgents(const base::ListValue& agents) {
+  std::vector<FoundAgent> found;
+  for (const base::Value& value : agents) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* id = dict ? dict->FindString("id") : nullptr;
+    if (!id || !FindAgentRecipe(*id)) {
+      continue;
+    }
+    found.push_back(FoundAgent{
+        .id = *id,
+        .installed = dict->FindBool("installed").value_or(false),
+        .needs_node = dict->FindBool("needsNode").value_or(false),
+    });
+  }
+  return found;
+}
+
+bool IsAgentRunnable(const base::ListValue& agents,
+                     std::string_view agent_id) {
+  if (!FindAgentRecipe(agent_id)) {
+    return false;
+  }
+  for (const FoundAgent& agent : ParseFoundAgents(agents)) {
+    if (agent.id == agent_id) {
+      return agent.installed;
+    }
+  }
+  return false;
+}
+
+bool AgentCanUseBrowser(std::string_view agent_id) {
+  // Gemini, Copilot and Goose have no verified MCP identity yet, and their
+  // own configs don't allow rac's tools, so every tool call is refused. A
+  // custom command is the user's own program, so the list claims nothing
+  // about it.
+  static constexpr std::string_view kChatOnly[] = {"gemini", "copilot",
+                                                   "goose"};
+  return std::ranges::find(kChatOnly, agent_id) == std::end(kChatOnly);
+}
+
+base::ListValue ProviderListToValue(const std::vector<ProviderRowGroup>& list) {
+  base::ListValue groups;
+  for (const ProviderRowGroup& group : list) {
+    base::ListValue rows;
+    for (const ProviderRow& row : group.rows) {
+      base::DictValue value;
+      value.Set("id", row.id);
+      value.Set("agent", row.is_agent);
+      value.Set("name", ListName(row.id, row.is_agent));
+      value.Set("chosen", row.chosen);
+      value.Set("notInstalled", row.not_installed);
+      value.Set("disabled", row.disabled);
+      if (row.is_agent) {
+        value.Set("canUseBrowser", AgentCanUseBrowser(row.id));
+      }
+      rows.Append(std::move(value));
+    }
+    groups.Append(base::DictValue()
+                      .Set("group", GroupName(group.group))
+                      .Set("rows", std::move(rows)));
+  }
+  return groups;
+}
+
+}  // namespace rac::ai

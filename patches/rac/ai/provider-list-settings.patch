+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_PROVIDER_LIST_H_
+#define CHROME_BROWSER_RAC_AI_PROVIDER_LIST_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+class PrefService;
+
+namespace rac::ai {
+
+// Settings' one provider list: every way the assistant can answer, in three
+// groups, with the one the profile uses marked. Choosing a row goes through
+// SelectDirectProvider or SelectAgent (active_provider.h), never through
+// here; this only decides what the list shows and in what order.
+
+enum class ProviderGroup {
+  // Agent programs found on this Mac, then the ones that weren't found
+  // (behind "Not installed"), then the custom ACP command.
+  kAgents,
+  // Direct providers that need the user's API key.
+  kApiKey,
+  // Direct providers that run on this Mac (Ollama, LM Studio).
+  kLocal,
+};
+
+// One agent as the login-shell probe (AcpService::ListAgents) saw it.
+struct FoundAgent {
+  std::string id;
+  bool installed = false;
+  // The agent's own program was found, but its adapter needs npx and Node
+  // wasn't found.
+  bool needs_node = false;
+};
+
+struct ProviderRow {
+  std::string id;
+  bool is_agent = false;
+  // The row the profile uses. At most one row in the list is chosen.
+  bool chosen = false;
+  // An agent that wasn't found. These sit behind the "Not installed (n)"
+  // row, unless the user already chose one.
+  bool not_installed = false;
+  // An agent that can't run (not installed, no Node, or a custom command
+  // that's empty or can't run) can't be chosen. One already chosen stays
+  // as it is, so the list still shows what the chat uses.
+  bool disabled = false;
+};
+
+struct ProviderRowGroup {
+  ProviderGroup group;
+  std::vector<ProviderRow> rows;
+};
+
+// What the list is built from. `agents` has no value until the probe has
+// answered (it runs only while the Assistant page is on screen with AI on).
+struct ProviderListInput {
+  std::optional<std::vector<FoundAgent>> agents;
+  // The direct provider the profile chose, or empty when the user never
+  // chose one and it can't be used yet (a fresh profile).
+  std::string direct_provider;
+  // The active agent (GetActiveAgent), or empty.
+  std::string agent;
+};
+
+// The groups in display order. Agents come first once the probe found one
+// that runs, or when an agent is the profile's choice, and also while the
+// probe hasn't answered (so a found agent doesn't push the list down after
+// the page opens). Otherwise API key, local model, then agents. Agents keep
+// a fixed order, with the custom command last. Nothing is ever chosen for
+// the user: an agent is chosen only when `agent` names it.
+std::vector<ProviderRowGroup> BuildProviderList(const ProviderListInput& input);
+
+// The direct provider the list shows as chosen: the profile's provider once
+// the user chose it (even the default one) or set it up so it can be used
+// (`usable`, AiService::HasUsableDirectProvider). A fresh profile's default
+// isn't a choice, so it's empty then and nothing shows chosen.
+std::string ChosenDirectProvider(const PrefService& prefs, bool usable);
+
+// Reads the probe's rows (AcpService::ListAgents) into FoundAgents. Rows
+// without a known agent id are dropped.
+std::vector<FoundAgent> ParseFoundAgents(const base::ListValue& agents);
+
+// Whether the probe's rows (AcpService::ListAgents) say `agent_id` can run
+// now. Settings refuses to choose an agent otherwise. False for an unknown
+// id or a missing row, so a doubt never chooses.
+bool IsAgentRunnable(const base::ListValue& agents, std::string_view agent_id);
+
+// Whether the agent can use the browser's tools. rac auto-approves its own
+// tools only for agents whose runtime identity is verified (see
+// IsApprovedRacMcpTool); Cursor and OpenCode allow them in their own config.
+// The rest can only chat for now.
+bool AgentCanUseBrowser(std::string_view agent_id);
+
+// The list as the Settings page reads it.
+base::ListValue ProviderListToValue(const std::vector<ProviderRowGroup>& list);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_PROVIDER_LIST_H_

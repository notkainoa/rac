+// Choosing an agent launches nothing; it runs only when the user sends. An
+// agent that can't run now (not found, no Node, a custom command that's
+// empty or can't run) is refused, so the page can't choose what the chat
+// can't use. The check looks at the disk again rather than trusting the
+// page's last list.
+void RacAiHandler::HandleSelectAgent(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  const std::string& id = args[1].GetString();
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  if (!service || profile_->IsOffTheRecord() ||
+      !rac::ai::FindAgentRecipe(id)) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  service->acp_service()->ListAgents(
+      base::BindOnce(&RacAiHandler::OnSelectAgentChecked,
+                     weak_factory_.GetWeakPtr(), args[0].Clone(), id));
+}
+
+void RacAiHandler::OnSelectAgentChecked(base::Value callback_id,
+                                        std::string agent_id,
+                                        base::ListValue agents) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_)) {
+    RejectJavascriptCallback(callback_id, base::Value());
+    return;
+  }
+  const bool runnable = rac::ai::IsAgentRunnable(agents, agent_id);
+  agents_ = std::move(agents);
+  if (!runnable) {
+    RejectJavascriptCallback(callback_id, base::Value("not_runnable"));
+    return;
+  }
+  {
+    base::AutoReset<bool> choosing(&choosing_provider_, true);
+    if (!rac::ai::SelectAgent(profile_->GetPrefs(), agent_id)) {
+      RejectJavascriptCallback(callback_id, base::Value());
+      return;
+    }
+  }
+  ResolveJavascriptCallback(callback_id, CreateState());
+}

+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_keep.h"
+
+#include <algorithm>
+#include <utility>
+
+namespace rac::ai {
+
+std::vector<std::string> PickChatsToDrop(std::vector<KeptChat> chats,
+                                         size_t max) {
+  std::vector<std::string> drop;
+  if (chats.size() <= max) {
+    return drop;
+  }
+  size_t extra = chats.size() - max;
+  std::stable_sort(chats.begin(), chats.end(),
+                   [](const KeptChat& a, const KeptChat& b) {
+                     return a.last_shown < b.last_shown;
+                   });
+  for (KeptChat& chat : chats) {
+    if (extra == 0) {
+      break;
+    }
+    if (chat.replying || chat.running_task || chat.card_waiting ||
+        chat.on_show || chat.unseen || chat.key.empty()) {
+      continue;
+    }
+    drop.push_back(std::move(chat.key));
+    --extra;
+  }
+  return drop;
+}
+
+}  // namespace rac::ai

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_CHAT_KEEP_H_
+#define CHROME_BROWSER_RAC_AI_CHAT_KEEP_H_
+
+#include <stddef.h>
+
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+
+namespace rac::ai {
+
+// The most conversations a window's chat page keeps in memory. One holds at
+// most its messages (400 KB, kMaxStoredChars), its latest reply (512 KB in
+// its log, ReplyLog::kMaxBytes, and its text again for saving) and its page
+// cache (150 KB, kMaxAttachedChars): about 1.6 MB. So eight cost 13 MB at
+// worst, beside the 230 MB of the one chat page they share, and ordinary
+// ones a few KB each. Eight is more chats than anyone follows at once in a
+// window, and one that is dropped is still in "New chat ▾".
+inline constexpr size_t kMaxKeptChats = 8;
+
+// One conversation the page keeps, as the cap sees it.
+struct KeptChat {
+  std::string key;
+  // When the page last showed it.
+  base::TimeTicks last_shown;
+  // Any of these keeps it, however long ago it was shown.
+  // A reply is still coming.
+  bool replying = false;
+  // It owns the profile's agent task.
+  bool running_task = false;
+  // An approval card waits on the user.
+  bool card_waiting = false;
+  // The page shows it, or showed it just before: a send that crossed a tab
+  // switch still goes there.
+  bool on_show = false;
+  // A reply ended while it wasn't on show, and the user hasn't seen it yet.
+  // Showing it clears this, so it can be dropped once it is idle again.
+  bool unseen = false;
+};
+
+// The conversations to drop so that at most `max` are kept: idle ones only
+// (none of the flags above set), the one shown longest ago first. While more
+// than `max` are busy, all of those stay. The caller saves each one to
+// history before it drops it.
+std::vector<std::string> PickChatsToDrop(std::vector<KeptChat> chats,
+                                         size_t max = kMaxKeptChats);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CHAT_KEEP_H_

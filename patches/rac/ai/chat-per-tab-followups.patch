+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_keep.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+using Keys = std::vector<std::string>;
+
+// An idle conversation last shown at second `shown`.
+KeptChat Idle(std::string key, int shown) {
+  KeptChat chat;
+  chat.key = std::move(key);
+  chat.last_shown = base::TimeTicks() + base::Seconds(shown);
+  return chat;
+}
+
+// `count` idle conversations, "c0" shown first and so the oldest.
+std::vector<KeptChat> IdleChats(int count) {
+  std::vector<KeptChat> chats;
+  for (int i = 0; i < count; ++i) {
+    chats.push_back(Idle("c" + base::NumberToString(i), i + 1));
+  }
+  return chats;
+}
+
+TEST(RacAiChatKeepTest, KeepsEveryChatUpToTheCap) {
+  EXPECT_EQ(PickChatsToDrop({}), Keys());
+  EXPECT_EQ(PickChatsToDrop(IdleChats(kMaxKeptChats)), Keys());
+}
+
+TEST(RacAiChatKeepTest, TheCapIsBetweenEightAndTen) {
+  EXPECT_GE(kMaxKeptChats, 8u);
+  EXPECT_LE(kMaxKeptChats, 10u);
+}
+
+TEST(RacAiChatKeepTest, DropsTheChatShownLongestAgo) {
+  std::vector<KeptChat> chats = IdleChats(kMaxKeptChats);
+  // Listed out of order: the map the page keeps them in is by key.
+  chats.insert(chats.begin(), Idle("newest", 100));
+  EXPECT_EQ(PickChatsToDrop(chats), Keys({"c0"}));
+}
+
+TEST(RacAiChatKeepTest, DropsDownToTheCap) {
+  EXPECT_EQ(PickChatsToDrop(IdleChats(kMaxKeptChats + 3)),
+            Keys({"c0", "c1", "c2"}));
+  EXPECT_EQ(PickChatsToDrop(IdleChats(5), 2), Keys({"c0", "c1", "c2"}));
+}
+
+// Each of these keeps an old conversation, and the next oldest idle one
+// goes in its place.
+TEST(RacAiChatKeepTest, NeverDropsABusyChat) {
+  for (int busy = 0; busy < 5; ++busy) {
+    SCOPED_TRACE(busy);
+    std::vector<KeptChat> chats = IdleChats(kMaxKeptChats + 1);
+    KeptChat& oldest = chats[0];
+    if (busy == 0) {
+      oldest.replying = true;
+    } else if (busy == 1) {
+      oldest.running_task = true;
+    } else if (busy == 2) {
+      oldest.card_waiting = true;
+    } else if (busy == 3) {
+      oldest.unseen = true;
+    } else {
+      oldest.on_show = true;
+    }
+    EXPECT_EQ(PickChatsToDrop(chats), Keys({"c1"}));
+  }
+}
+
+// A reply that ended in the background and was never seen keeps its
+// conversation, however long ago it was shown. Once shown (unseen cleared,
+// last_shown moved on) and idle again, it can go like any other.
+TEST(RacAiChatKeepTest, KeepsAnUnseenReplyUntilItIsShown) {
+  std::vector<KeptChat> chats = IdleChats(kMaxKeptChats + 2);
+  chats[0].unseen = true;
+  chats[1].unseen = true;
+  EXPECT_EQ(PickChatsToDrop(chats), Keys({"c2", "c3"}));
+  // Every one unseen: nothing goes, however many there are.
+  for (KeptChat& chat : chats) {
+    chat.unseen = true;
+  }
+  EXPECT_EQ(PickChatsToDrop(chats), Keys());
+  // c0 is shown, then the user moves on to newer ones: it is idle and seen,
+  // so it is the one that goes.
+  for (KeptChat& chat : chats) {
+    chat.unseen = false;
+  }
+  chats[1].unseen = true;
+  chats[0].last_shown = base::TimeTicks() + base::Seconds(50);
+  for (size_t i = 2; i < chats.size(); ++i) {
+    chats[i].last_shown =
+        base::TimeTicks() + base::Seconds(100 + static_cast<int>(i));
+  }
+  EXPECT_EQ(PickChatsToDrop(chats), Keys({"c0", "c2"}));
+}
+
+// The one on show is never dropped, even when it was shown longest ago.
+TEST(RacAiChatKeepTest, NeverDropsTheChatOnShow) {
+  std::vector<KeptChat> chats = IdleChats(3);
+  chats[0].on_show = true;
+  EXPECT_EQ(PickChatsToDrop(chats, 1), Keys({"c1", "c2"}));
+}
+
+// More busy conversations than the cap: they all stay, and only the idle
+// ones go.
+TEST(RacAiChatKeepTest, KeepsMoreThanTheCapWhileThatManyAreBusy) {
+  std::vector<KeptChat> chats = IdleChats(kMaxKeptChats + 2);
+  for (size_t i = 0; i < kMaxKeptChats + 1; ++i) {
+    chats[i].replying = true;
+  }
+  EXPECT_EQ(PickChatsToDrop(chats), Keys({"c9"}));
+  for (KeptChat& chat : chats) {
+    chat.running_task = true;
+  }
+  EXPECT_EQ(PickChatsToDrop(chats), Keys());
+}
+
+TEST(RacAiChatKeepTest, NeverPicksAnEmptyKey) {
+  std::vector<KeptChat> chats = IdleChats(2);
+  chats.push_back(Idle("", 0));
+  EXPECT_EQ(PickChatsToDrop(chats, 2), Keys({"c0"}));
+}
+
+}  // namespace
+}  // namespace rac::ai

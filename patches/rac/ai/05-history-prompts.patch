@@ -0,0 +1,57 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/saved_prompts.h"
+
+#include <string>
+
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+
+class RacAiSavedPromptsTest : public testing::Test {
+ protected:
+  RacAiSavedPromptsTest() { RegisterProfilePrefs(prefs_.registry()); }
+  TestingPrefServiceSimple prefs_;
+};
+
+TEST_F(RacAiSavedPromptsTest, StartsEmpty) {
+  EXPECT_TRUE(GetSavedPrompts(&prefs_).empty());
+}
+
+TEST_F(RacAiSavedPromptsTest, AddsAndRemoves) {
+  ASSERT_TRUE(AddSavedPrompt(&prefs_, "Summarize", "Summarize this page."));
+  ASSERT_TRUE(AddSavedPrompt(&prefs_, "", "Translate to French"));
+  std::vector<SavedPrompt> prompts = GetSavedPrompts(&prefs_);
+  ASSERT_EQ(prompts.size(), 2u);
+  EXPECT_EQ(prompts[0].title, "Summarize");
+  EXPECT_EQ(prompts[0].text, "Summarize this page.");
+  EXPECT_EQ(prompts[1].title, "Translate to French");
+  EXPECT_NE(prompts[0].id, prompts[1].id);
+
+  RemoveSavedPrompt(&prefs_, prompts[0].id);
+  prompts = GetSavedPrompts(&prefs_);
+  ASSERT_EQ(prompts.size(), 1u);
+  EXPECT_EQ(prompts[0].text, "Translate to French");
+}
+
+TEST_F(RacAiSavedPromptsTest, RejectsBadPrompts) {
+  EXPECT_FALSE(AddSavedPrompt(&prefs_, "t", "   "));
+  EXPECT_FALSE(
+      AddSavedPrompt(&prefs_, "t", std::string(kMaxPromptChars + 1, 'a')));
+  EXPECT_FALSE(AddSavedPrompt(&prefs_, "t", "bad \xFF utf8"));
+  EXPECT_TRUE(GetSavedPrompts(&prefs_).empty());
+}
+
+TEST_F(RacAiSavedPromptsTest, StopsAtTheLimit) {
+  for (size_t i = 0; i < kMaxSavedPrompts; ++i) {
+    ASSERT_TRUE(AddSavedPrompt(&prefs_, "t", "prompt " + std::to_string(i)));
+  }
+  EXPECT_FALSE(AddSavedPrompt(&prefs_, "t", "one too many"));
+  EXPECT_EQ(GetSavedPrompts(&prefs_).size(), kMaxSavedPrompts);
+}
+
+}  // namespace rac::ai

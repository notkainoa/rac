+namespace {
+
+// The page wants a plain millisecond timestamp, not the stored form.
+base::DictValue ToPage(const Conversation& conversation, bool with_messages) {
+  base::DictValue dict = ConversationToValue(conversation, with_messages);
+  dict.Set("updatedMs", conversation.updated.InMillisecondsFSinceUnixEpoch());
+  return dict;
+}
+
+}  // namespace
+
+void PageHandler::HandleHistoryList(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AllowJavascript();
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  if (!service || !profile_->GetPrefs()->GetBoolean(kSaveHistory)) {
+    ResolveJavascriptCallback(args[0], base::ListValue());
+    return;
+  }
+  service->history_store().List(base::BindOnce(&PageHandler::OnHistoryList,
+                                               weak_factory_.GetWeakPtr(),
+                                               args[0].Clone()));
+}
+
+void PageHandler::OnHistoryList(base::Value callback_id,
+                                std::vector<Conversation> conversations) {
+  base::ListValue list;
+  for (const Conversation& conversation : conversations) {
+    list.Append(ToPage(conversation, /*with_messages=*/false));
+  }
+  ResolveJavascriptCallback(callback_id, list);
+}
+
+void PageHandler::HandleHistoryGet(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  AllowJavascript();
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  const std::string& id = args[1].GetString();
+  if (!service || !IsValidConversationId(id)) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  service->history_store().Get(
+      id, base::BindOnce(&PageHandler::OnHistoryGet, weak_factory_.GetWeakPtr(),
+                         args[0].Clone()));
+}
+
+void PageHandler::OnHistoryGet(base::Value callback_id,
+                               std::optional<Conversation> conversation) {
+  if (conversation) {
+    ResolveJavascriptCallback(callback_id,
+                              ToPage(*conversation, /*with_messages=*/true));
+  } else {
+    ResolveJavascriptCallback(callback_id, base::Value());
+  }
+}
+
+void PageHandler::HandleHistorySave(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  const base::DictValue* dict = args[0].GetIfDict();
+  Conversation conversation;
+  if (!service || !dict || !profile_->GetPrefs()->GetBoolean(kSaveHistory) ||
+      !ConversationFromValue(*dict, base::Time::Now(), &conversation)) {
+    return;
+  }
+  service->history_store().Save(std::move(conversation));
+}
+
+void PageHandler::HandleHistoryDelete(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AiService* service = AiServiceFactory::GetForProfile(profile_);
+  const std::string& id = args[0].GetString();
+  if (service && IsValidConversationId(id)) {
+    service->history_store().Delete(id);
+  }
+}
+
+void PageHandler::HandleHistoryClear(const base::ListValue& args) {
+  if (AiService* service = AiServiceFactory::GetForProfile(profile_)) {
+    service->history_store().Clear();
+  }
+}
+
+void PageHandler::HandleSetSaveHistory(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  if (AiServiceFactory::GetForProfile(profile_) && args[0].is_bool()) {
+    profile_->GetPrefs()->SetBoolean(kSaveHistory, args[0].GetBool());
+  }
+}
+
+void PageHandler::HandlePromptsGet(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AllowJavascript();
+  base::ListValue list;
+  if (AiServiceFactory::GetForProfile(profile_)) {
+    for (const SavedPrompt& prompt : GetSavedPrompts(profile_->GetPrefs())) {
+      list.Append(base::DictValue()
+                      .Set("id", prompt.id)
+                      .Set("title", prompt.title)
+                      .Set("text", prompt.text));
+    }
+  }
+  ResolveJavascriptCallback(args[0], list);
+}
+
+void PageHandler::HandlePromptAdd(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  if (AiServiceFactory::GetForProfile(profile_)) {
+    AddSavedPrompt(profile_->GetPrefs(), args[0].GetString(),
+                   args[1].GetString());
+  }
+}
+
+void PageHandler::HandlePromptRemove(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  if (AiServiceFactory::GetForProfile(profile_)) {
+    RemoveSavedPrompt(profile_->GetPrefs(), args[0].GetString());
+  }
+}
+
 }  // namespace rac::ai

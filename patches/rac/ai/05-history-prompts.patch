+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/rac/ai/chat_history.h"
+
+namespace rac::ai {
+
+// The user's past conversations, kept in one file in the profile folder and
+// nowhere else. The file is read the first time something asks for it, so a
+// profile that never opens the assistant never touches it. Writes are batched
+// and atomic.
+class HistoryStore : public base::ImportantFileWriter::DataSerializer {
+ public:
+  using ListCallback = base::OnceCallback<void(std::vector<Conversation>)>;
+  using GetCallback = base::OnceCallback<void(std::optional<Conversation>)>;
+
+  explicit HistoryStore(const base::FilePath& path);
+  HistoryStore(const HistoryStore&) = delete;
+  HistoryStore& operator=(const HistoryStore&) = delete;
+  ~HistoryStore() override;
+
+  // Newest first, without messages.
+  void List(ListCallback callback);
+  void Get(const std::string& id, GetCallback callback);
+  void Save(Conversation conversation);
+  void Delete(const std::string& id);
+  void Clear();
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+ private:
+  void WhenLoaded(base::OnceClosure task);
+  void OnLoaded(std::string contents);
+
+  base::FilePath path_;
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  base::ImportantFileWriter writer_;
+  bool load_started_ = false;
+  bool loaded_ = false;
+  std::vector<base::OnceClosure> waiting_;
+  std::vector<Conversation> conversations_;
+  base::WeakPtrFactory<HistoryStore> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_HISTORY_STORE_H_

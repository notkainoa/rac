--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/history_store.cc	2026-10-12 08:20:35.445133498 -0700
@@ -0,0 +1,140 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/history_store.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+
+namespace rac::ai {
+namespace {
+
+// Larger than any file we write, so a damaged or hostile file can't make the
+// browser read without limit.
+constexpr int64_t kMaxFileBytes = 16 * 1024 * 1024;
+
+std::string ReadFile(const base::FilePath& path) {
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, kMaxFileBytes)) {
+    contents.clear();
+  }
+  return contents;
+}
+
+}  // namespace
+
+HistoryStore::HistoryStore(const base::FilePath& path)
+    : path_(path),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})),
+      writer_(path, task_runner_, "RacAiHistory") {}
+
+HistoryStore::~HistoryStore() = default;
+
+void HistoryStore::WhenLoaded(base::OnceClosure task) {
+  if (loaded_) {
+    std::move(task).Run();
+    return;
+  }
+  waiting_.push_back(std::move(task));
+  if (load_started_) {
+    return;
+  }
+  load_started_ = true;
+  task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadFile, path_),
+      base::BindOnce(&HistoryStore::OnLoaded, weak_factory_.GetWeakPtr()));
+}
+
+void HistoryStore::OnLoaded(std::string contents) {
+  conversations_ = ParseConversations(contents);
+  loaded_ = true;
+  std::vector<base::OnceClosure> waiting = std::move(waiting_);
+  for (base::OnceClosure& task : waiting) {
+    std::move(task).Run();
+  }
+}
+
+void HistoryStore::List(ListCallback callback) {
+  WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<HistoryStore> self, ListCallback callback) {
+        std::vector<Conversation> result;
+        if (self) {
+          for (const Conversation& conversation : self->conversations_) {
+            Conversation summary;
+            summary.id = conversation.id;
+            summary.title = conversation.title;
+            summary.updated = conversation.updated;
+            result.push_back(std::move(summary));
+          }
+        }
+        std::move(callback).Run(std::move(result));
+      },
+      weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void HistoryStore::Get(const std::string& id, GetCallback callback) {
+  WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<HistoryStore> self, std::string id,
+         GetCallback callback) {
+        std::optional<Conversation> result;
+        if (self) {
+          for (const Conversation& conversation : self->conversations_) {
+            if (conversation.id == id) {
+              result = conversation;
+              break;
+            }
+          }
+        }
+        std::move(callback).Run(std::move(result));
+      },
+      weak_factory_.GetWeakPtr(), id, std::move(callback)));
+}
+
+void HistoryStore::Save(Conversation conversation) {
+  WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<HistoryStore> self, Conversation conversation) {
+        if (!self) {
+          return;
+        }
+        UpsertConversation(self->conversations_, std::move(conversation));
+        self->writer_.ScheduleWrite(self.get());
+      },
+      weak_factory_.GetWeakPtr(), std::move(conversation)));
+}
+
+void HistoryStore::Delete(const std::string& id) {
+  WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<HistoryStore> self, std::string id) {
+        if (!self) {
+          return;
+        }
+        std::erase_if(self->conversations_,
+                      [&](const Conversation& c) { return c.id == id; });
+        self->writer_.ScheduleWrite(self.get());
+      },
+      weak_factory_.GetWeakPtr(), id));
+}
+
+void HistoryStore::Clear() {
+  WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<HistoryStore> self) {
+        if (!self) {
+          return;
+        }
+        self->conversations_.clear();
+        self->writer_.ScheduleWrite(self.get());
+      },
+      weak_factory_.GetWeakPtr()));
+}
+
+std::optional<std::string> HistoryStore::SerializeData() {
+  return SerializeConversations(conversations_);
+}
+
+}  // namespace rac::ai

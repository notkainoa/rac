+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/saved_prompts.h"
+
+#include <utility>
+
+#include "base/strings/string_util.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/ai/chat_history.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace rac::ai {
+
+std::vector<SavedPrompt> GetSavedPrompts(const PrefService* prefs) {
+  std::vector<SavedPrompt> result;
+  for (const base::Value& value : prefs->GetList(kSavedPrompts)) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* id = dict ? dict->FindString("id") : nullptr;
+    const std::string* title = dict ? dict->FindString("title") : nullptr;
+    const std::string* text = dict ? dict->FindString("text") : nullptr;
+    if (id && title && text && result.size() < kMaxSavedPrompts) {
+      result.push_back({*id, *title, *text});
+    }
+  }
+  return result;
+}
+
+bool AddSavedPrompt(PrefService* prefs,
+                    const std::string& title,
+                    const std::string& text) {
+  std::string trimmed_text(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+  if (trimmed_text.empty() || trimmed_text.size() > kMaxPromptChars ||
+      !base::IsStringUTF8(trimmed_text) || !base::IsStringUTF8(title)) {
+    return false;
+  }
+  std::string clean_title = MakeTitle(title.empty() ? trimmed_text : title);
+  if (clean_title.size() > kMaxPromptTitleChars * 4) {
+    clean_title.resize(kMaxPromptTitleChars * 4);
+  }
+  ScopedListPrefUpdate update(prefs, kSavedPrompts);
+  if (update->size() >= kMaxSavedPrompts) {
+    return false;
+  }
+  update->Append(
+      base::DictValue()
+          .Set("id", base::Uuid::GenerateRandomV4().AsLowercaseString())
+          .Set("title", std::move(clean_title))
+          .Set("text", std::move(trimmed_text)));
+  return true;
+}
+
+void RemoveSavedPrompt(PrefService* prefs, const std::string& id) {
+  ScopedListPrefUpdate update(prefs, kSavedPrompts);
+  update->EraseIf([&](const base::Value& value) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* existing = dict ? dict->FindString("id") : nullptr;
+    return existing && *existing == id;
+  });
+}
+
+}  // namespace rac::ai

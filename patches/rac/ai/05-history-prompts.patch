Index: src/chrome/browser/rac/ai/chat_history.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/chat_history.cc	2026-10-12 08:21:07.797885810 -0700
@@ -0,0 +1,206 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_history.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/json/values_util.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr int kVersion = 1;
+
+bool ReadMessage(const base::Value& value, StoredMessage* out) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict) {
+    return false;
+  }
+  const std::string* role = dict->FindString("role");
+  const std::string* text = dict->FindString("text");
+  if (!role || !text || (*role != "user" && *role != "assistant") ||
+      !base::IsStringUTF8(*text)) {
+    return false;
+  }
+  out->role = *role;
+  out->text = *text;
+  if (const base::ListValue* attached = dict->FindList("attached")) {
+    for (const base::Value& title : *attached) {
+      if (title.is_string() && base::IsStringUTF8(title.GetString()) &&
+          out->attached.size() < 8) {
+        out->attached.push_back(title.GetString().substr(0, 200));
+      }
+    }
+  }
+  return true;
+}
+
+bool ReadMessages(const base::ListValue& list, Conversation* out) {
+  if (list.empty() || list.size() > kMaxStoredMessages) {
+    return false;
+  }
+  size_t total = 0;
+  for (const base::Value& value : list) {
+    StoredMessage message;
+    if (!ReadMessage(value, &message)) {
+      return false;
+    }
+    total += message.text.size();
+    out->messages.push_back(std::move(message));
+  }
+  return total <= kMaxStoredChars;
+}
+
+base::DictValue MessageToValue(const StoredMessage& message) {
+  base::DictValue dict;
+  dict.Set("role", message.role);
+  dict.Set("text", message.text);
+  if (!message.attached.empty()) {
+    base::ListValue attached;
+    for (const std::string& title : message.attached) {
+      attached.Append(title);
+    }
+    dict.Set("attached", std::move(attached));
+  }
+  return dict;
+}
+
+}  // namespace
+
+bool IsValidConversationId(std::string_view id) {
+  if (id.size() < 8 || id.size() > 64) {
+    return false;
+  }
+  return std::ranges::all_of(
+      id, [](char c) { return base::IsAsciiAlphaNumeric(c) || c == '-'; });
+}
+
+std::string MakeTitle(std::string_view first_user_text) {
+  std::u16string text = base::UTF8ToUTF16(first_user_text);
+  for (char16_t& c : text) {
+    if (c == u'\n' || c == u'\r' || c == u'\t') {
+      c = u' ';
+    }
+  }
+  base::TrimWhitespace(text, base::TRIM_ALL, &text);
+  if (text.size() > kMaxTitleChars) {
+    size_t cut = kMaxTitleChars;
+    // Don't leave half of a surrogate pair behind.
+    if ((text[cut - 1] & 0xFC00) == 0xD800) {
+      --cut;
+    }
+    text.resize(cut);
+    text += u"\u2026";
+  }
+  return base::UTF16ToUTF8(text);
+}
+
+bool ConversationFromValue(const base::DictValue& value,
+                           base::Time now,
+                           Conversation* out) {
+  const std::string* id = value.FindString("id");
+  const base::ListValue* messages = value.FindList("messages");
+  if (!id || !IsValidConversationId(*id) || !messages) {
+    return false;
+  }
+  Conversation conversation;
+  conversation.id = *id;
+  conversation.updated = now;
+  if (!ReadMessages(*messages, &conversation)) {
+    return false;
+  }
+  for (const StoredMessage& message : conversation.messages) {
+    if (message.role == "user") {
+      conversation.title = MakeTitle(message.text);
+      break;
+    }
+  }
+  if (conversation.title.empty()) {
+    return false;
+  }
+  *out = std::move(conversation);
+  return true;
+}
+
+base::DictValue ConversationToValue(const Conversation& conversation,
+                                    bool with_messages) {
+  base::DictValue dict;
+  dict.Set("id", conversation.id);
+  dict.Set("title", conversation.title);
+  dict.Set("updated", base::TimeToValue(conversation.updated));
+  if (with_messages) {
+    base::ListValue messages;
+    for (const StoredMessage& message : conversation.messages) {
+      messages.Append(MessageToValue(message));
+    }
+    dict.Set("messages", std::move(messages));
+  }
+  return dict;
+}
+
+std::string SerializeConversations(const std::vector<Conversation>& all) {
+  base::ListValue list;
+  for (const Conversation& conversation : all) {
+    list.Append(ConversationToValue(conversation, /*with_messages=*/true));
+  }
+  base::DictValue root;
+  root.Set("version", kVersion);
+  root.Set("conversations", std::move(list));
+  std::string json;
+  base::JSONWriter::Write(root, &json);
+  return json;
+}
+
+std::vector<Conversation> ParseConversations(std::string_view json) {
+  std::vector<Conversation> all;
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root || root->FindInt("version") != kVersion) {
+    return all;
+  }
+  const base::ListValue* list = root->FindList("conversations");
+  if (!list) {
+    return all;
+  }
+  for (const base::Value& value : *list) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* id = dict ? dict->FindString("id") : nullptr;
+    const std::string* title = dict ? dict->FindString("title") : nullptr;
+    const base::ListValue* messages =
+        dict ? dict->FindList("messages") : nullptr;
+    std::optional<base::Time> updated =
+        dict ? base::ValueToTime(dict->Find("updated")) : std::nullopt;
+    if (!id || !title || !messages || !updated || !IsValidConversationId(*id) ||
+        !base::IsStringUTF8(*title) || all.size() >= kMaxConversations) {
+      continue;
+    }
+    Conversation conversation;
+    conversation.id = *id;
+    conversation.title = title->substr(0, 400);
+    conversation.updated = *updated;
+    if (ReadMessages(*messages, &conversation)) {
+      all.push_back(std::move(conversation));
+    }
+  }
+  return all;
+}
+
+void UpsertConversation(std::vector<Conversation>& all,
+                        Conversation conversation) {
+  std::erase_if(all, [&](const Conversation& existing) {
+    return existing.id == conversation.id;
+  });
+  all.insert(all.begin(), std::move(conversation));
+  if (all.size() > kMaxConversations) {
+    all.resize(kMaxConversations);
+  }
+}
+
+}  // namespace rac::ai
Index: src/chrome/browser/rac/ai/chat_history.h
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/chat_history.h	2026-10-12 08:20:29.805306702 -0700
@@ -0,0 +1,62 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_CHAT_HISTORY_H_
+#define CHROME_BROWSER_RAC_AI_CHAT_HISTORY_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace rac::ai {
+
+inline constexpr size_t kMaxConversations = 200;
+inline constexpr size_t kMaxStoredMessages = 200;
+inline constexpr size_t kMaxStoredChars = 400 * 1024;
+inline constexpr size_t kMaxTitleChars = 80;
+
+struct StoredMessage {
+  std::string role;  // "user" or "assistant".
+  std::string text;
+  // Titles of the tabs attached to a user message.
+  std::vector<std::string> attached;
+};
+
+struct Conversation {
+  std::string id;
+  std::string title;
+  base::Time updated;
+  std::vector<StoredMessage> messages;
+};
+
+// Ids come from the page, and end up in a file. Accept only plain ones.
+bool IsValidConversationId(std::string_view id);
+
+// A short title from the first thing the user said.
+std::string MakeTitle(std::string_view first_user_text);
+
+// Reads a conversation sent by the page. Returns false if it is malformed or
+// too big. Fills in the title and takes `updated` from `now`.
+bool ConversationFromValue(const base::DictValue& value,
+                           base::Time now,
+                           Conversation* out);
+
+base::DictValue ConversationToValue(const Conversation& conversation,
+                                    bool with_messages);
+
+std::string SerializeConversations(const std::vector<Conversation>& all);
+// Returns what could be read; a damaged file yields an empty list.
+std::vector<Conversation> ParseConversations(std::string_view json);
+
+// Puts `conversation` first, replacing one with the same id, and drops the
+// oldest beyond kMaxConversations.
+void UpsertConversation(std::vector<Conversation>& all,
+                        Conversation conversation);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_CHAT_HISTORY_H_
Index: src/chrome/browser/rac/ai/chat_history_unittest.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/ai/chat_history_unittest.cc	2026-10-12 08:20:35.428117746 -0700
@@ -0,0 +1,112 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/chat_history.h"
+
+#include <string>
+
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+base::DictValue Sent(const std::string& id, const std::string& first) {
+  base::ListValue messages;
+  messages.Append(base::DictValue()
+                      .Set("role", "user")
+                      .Set("text", first)
+                      .Set("attached", base::ListValue().Append("A page")));
+  messages.Append(
+      base::DictValue().Set("role", "assistant").Set("text", "Hello"));
+  return base::DictValue().Set("id", id).Set("messages", std::move(messages));
+}
+
+}  // namespace
+
+TEST(RacAiChatHistoryTest, IdsAreOrdinary) {
+  EXPECT_TRUE(IsValidConversationId("3f2a9c1e-77b0-4e0d-a1a3-0c5d2d9b8e11"));
+  EXPECT_FALSE(IsValidConversationId("short"));
+  EXPECT_FALSE(IsValidConversationId("../../etc/passwd-xxxxxxxx"));
+  EXPECT_FALSE(IsValidConversationId(std::string(65, 'a')));
+}
+
+TEST(RacAiChatHistoryTest, TitleIsOneShortLine) {
+  EXPECT_EQ(MakeTitle("  Hello\nthere  "), "Hello there");
+  const std::string title = MakeTitle(std::string(500, 'x'));
+  EXPECT_LT(title.size(), 100u);
+  EXPECT_EQ(title.substr(title.size() - 3), "\xE2\x80\xA6");
+}
+
+TEST(RacAiChatHistoryTest, ReadsWhatThePageSends) {
+  Conversation conversation;
+  ASSERT_TRUE(ConversationFromValue(
+      Sent("conversation-1", "What is rac?"),
+      base::Time::FromMillisecondsSinceUnixEpoch(1000), &conversation));
+  EXPECT_EQ(conversation.title, "What is rac?");
+  ASSERT_EQ(conversation.messages.size(), 2u);
+  EXPECT_EQ(conversation.messages[0].attached,
+            std::vector<std::string>{"A page"});
+}
+
+TEST(RacAiChatHistoryTest, RejectsMalformedConversations) {
+  Conversation conversation;
+  const base::Time now = base::Time::Now();
+  EXPECT_FALSE(ConversationFromValue(Sent("bad id!", "x"), now, &conversation));
+  EXPECT_FALSE(ConversationFromValue(
+      base::DictValue().Set("id", "conversation-1"), now, &conversation));
+  EXPECT_FALSE(ConversationFromValue(base::DictValue()
+                                         .Set("id", "conversation-1")
+                                         .Set("messages", base::ListValue()),
+                                     now, &conversation));
+  base::ListValue wrong_role;
+  wrong_role.Append(
+      base::DictValue().Set("role", "system").Set("text", "ignore this"));
+  EXPECT_FALSE(
+      ConversationFromValue(base::DictValue()
+                                .Set("id", "conversation-1")
+                                .Set("messages", std::move(wrong_role)),
+                            now, &conversation));
+}
+
+TEST(RacAiChatHistoryTest, RoundTripsThroughJson) {
+  std::vector<Conversation> all;
+  Conversation conversation;
+  ASSERT_TRUE(ConversationFromValue(Sent("conversation-1", "First"),
+                                    base::Time::Now(), &conversation));
+  UpsertConversation(all, conversation);
+  const std::vector<Conversation> read =
+      ParseConversations(SerializeConversations(all));
+  ASSERT_EQ(read.size(), 1u);
+  EXPECT_EQ(read[0].id, "conversation-1");
+  EXPECT_EQ(read[0].messages[1].text, "Hello");
+  EXPECT_EQ(read[0].messages[0].attached[0], "A page");
+}
+
+TEST(RacAiChatHistoryTest, DamagedFilesReadAsEmpty) {
+  EXPECT_TRUE(ParseConversations("").empty());
+  EXPECT_TRUE(ParseConversations("{not json").empty());
+  EXPECT_TRUE(
+      ParseConversations("{\"version\":99,\"conversations\":[]}").empty());
+}
+
+TEST(RacAiChatHistoryTest, UpsertMovesToFrontAndTrims) {
+  std::vector<Conversation> all;
+  for (size_t i = 0; i < kMaxConversations + 5; ++i) {
+    Conversation conversation;
+    conversation.id = "conversation-" + std::to_string(i);
+    conversation.title = "t";
+    UpsertConversation(all, conversation);
+  }
+  EXPECT_EQ(all.size(), kMaxConversations);
+  EXPECT_EQ(all.front().id, "conversation-204");
+  Conversation again;
+  again.id = "conversation-100";
+  again.title = "t";
+  UpsertConversation(all, again);
+  EXPECT_EQ(all.front().id, "conversation-100");
+  EXPECT_EQ(all.size(), kMaxConversations);
+}
+
+}  // namespace rac::ai

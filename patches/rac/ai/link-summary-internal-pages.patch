+  const content::NavigationEntry* entry =
+      source->GetController().GetLastCommittedEntry();
+  return entry && !entry->IsInitialEntry() &&
+         CanSummarizeLinksOn(entry->GetURL(), entry->GetVirtualURL(),
+                             source->GetVisibleURL());
+}

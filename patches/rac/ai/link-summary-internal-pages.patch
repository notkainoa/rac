+TEST(LinkSummaryTest, LinksToInternalPagesNeverQualify) {
+  const GURL page("https://example.com/post");
+  EXPECT_FALSE(IsSummarizableLink(GURL("chrome://history/"), page));
+  EXPECT_FALSE(IsSummarizableLink(GURL("rac://settings/assistant"), page));
+  EXPECT_FALSE(IsSummarizableLink(GURL("chrome://newtab/"), page));
+  EXPECT_FALSE(
+      IsSummarizableLink(GURL("view-source:https://example.org/"), page));
+  EXPECT_FALSE(IsSummarizableLink(
+      GURL("chrome-extension://abcdefghijklmnop/options.html"), page));
+  EXPECT_FALSE(IsSummarizableLink(GURL("about:blank"), page));
+  EXPECT_FALSE(IsSummarizableLink(GURL("data:text/html,hi"), page));
+}
+
+// The page the link is on: the last committed entry's address and shown
+// address, then the address bar's.
+bool CanSummarizeOn(const char* url,
+                    const char* virtual_url,
+                    const char* visible_url) {
+  return CanSummarizeLinksOn(GURL(url), GURL(virtual_url), GURL(visible_url));
+}
+
+TEST(LinkSummaryTest, LinksOnWebPagesCanBeSummarized) {
+  EXPECT_TRUE(CanSummarizeOn("https://example.com/post",
+                             "https://example.com/post",
+                             "https://example.com/post"));
+  EXPECT_TRUE(
+      CanSummarizeOn("http://127.0.0.1:8771/", "", "http://127.0.0.1:8771/"));
+  // The address bar may already show the next web page.
+  EXPECT_TRUE(CanSummarizeOn("https://example.com/", "https://example.com/",
+                             "https://example.org/next"));
+}
+
+TEST(LinkSummaryTest, LinksOnInternalPagesAreNeverSummarized) {
+  for (const char* page : {
+           "chrome://history/",
+           "rac://history/",
+           "chrome://downloads/",
+           "chrome://settings/assistant",
+           "rac://settings/",
+           "chrome://newtab/",
+           "rac://newtab/",
+           "chrome://rac-ai/?mode=page",
+           "chrome://bookmarks/",
+           "chrome-extension://abcdefghijklmnop/options.html",
+           "chrome-untrusted://print/",
+           "devtools://devtools/bundled/devtools_app.html",
+           "file:///Users/me/notes.html",
+           "about:blank",
+           "data:text/html,<a href=https://example.com>x</a>",
+       }) {
+    SCOPED_TRACE(page);
+    EXPECT_FALSE(CanSummarizeOn(page, page, page));
+    EXPECT_FALSE(CanSummarizeOn(page, "", page));
+  }
+}
+
+TEST(LinkSummaryTest, ViewSourceIsInternalThoughItsEntryIsTheWebPage) {
+  EXPECT_FALSE(CanSummarizeOn("https://example.com/",
+                              "view-source:https://example.com/",
+                              "view-source:https://example.com/"));
+}
+
+TEST(LinkSummaryTest, ATabBetweenInternalAndWebPagesIsRefused) {
+  // Leaving history for a web page: history's links are still on screen.
+  EXPECT_FALSE(CanSummarizeOn("chrome://history/", "chrome://history/",
+                              "https://example.com/"));
+  // Typed chrome://history on a web page: refused until it settles.
+  EXPECT_FALSE(CanSummarizeOn("https://example.com/", "https://example.com/",
+                              "chrome://history/"));
+  // A web entry that shows an internal address.
+  EXPECT_FALSE(CanSummarizeOn("https://example.com/", "rac://settings/",
+                              "https://example.com/"));
+}
+
+TEST(LinkSummaryTest, NoPageMeansNoSummary) {
+  EXPECT_FALSE(CanSummarizeOn("", "", ""));
+  EXPECT_FALSE(CanSummarizeOn("", "", "https://example.com/"));
+  EXPECT_FALSE(
+      CanSummarizeOn("https://example.com/", "https://example.com/", ""));
+  EXPECT_FALSE(CanSummarizeOn("not a url", "", "https://example.com/"));
+}

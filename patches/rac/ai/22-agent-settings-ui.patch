+// Looks for agent programs. This is the only place the page starts the login
+// shell probe, and only once the page asks, with the assistant on.
+void RacAiHandler::HandleListAgents(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  AllowJavascript();
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  if (!service || profile_->IsOffTheRecord()) {
+    ResolveJavascriptCallback(args[0], base::ListValue());
+    return;
+  }
+  auto done = base::BindOnce(&RacAiHandler::OnAgentsListed,
+                             weak_factory_.GetWeakPtr(), args[0].Clone());
+  if (args[1].GetBool()) {
+    service->acp_service()->RefreshAgents(std::move(done));
+  } else {
+    service->acp_service()->ListAgents(std::move(done));
+  }
+}
+
+void RacAiHandler::OnAgentsListed(base::Value callback_id,
+                                  base::ListValue agents) {
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(callback_id, agents);
+  }
+}
+
+// Checking a file touches the disk, so it runs off the UI thread. An empty
+// value clears the setting and needs no check.
+void RacAiHandler::HandleSetAgentPath(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 3u);
+  const std::string& id = args[1].GetString();
+  const std::string& path = args[2].GetString();
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_) ||
+      !rac::ai::FindAgentRecipe(id) || id == "custom") {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  if (path.empty()) {
+    StoreAgentSetting(args[0].Clone(), id, path, true);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&rac::ai::IsRunnableAbsolutePath, path),
+      base::BindOnce(&RacAiHandler::StoreAgentSetting,
+                     weak_factory_.GetWeakPtr(), args[0].Clone(), id, path));
+}
+
+void RacAiHandler::HandleSetCustomAgentCommand(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  const std::string& command = args[1].GetString();
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_)) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  if (command.empty()) {
+    StoreAgentSetting(args[0].Clone(), "custom", command, true);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&rac::ai::IsValidCustomAgentCommand, command),
+      base::BindOnce(&RacAiHandler::StoreAgentSetting,
+                     weak_factory_.GetWeakPtr(), args[0].Clone(), "custom",
+                     command));
+}
+
+void RacAiHandler::StoreAgentSetting(base::Value callback_id,
+                                     std::string agent_id,
+                                     std::string value,
+                                     bool valid) {
+  if (!IsJavascriptAllowed() ||
+      !rac::ai::AiServiceFactory::GetForProfile(profile_)) {
+    return;
+  }
+  if (!valid) {
+    RejectJavascriptCallback(callback_id, base::Value("invalid_path"));
+    return;
+  }
+  if (agent_id == "custom") {
+    profile_->GetPrefs()->SetString(rac::ai::kAgentCustomCommand, value);
+  } else {
+    ScopedDictPrefUpdate update(profile_->GetPrefs(), rac::ai::kAgentPaths);
+    if (value.empty()) {
+      update->Remove(agent_id);
+    } else {
+      update->Set(agent_id, value);
+    }
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(true));
+}

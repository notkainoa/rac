+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/ai/acp/agent_settings.h"
+
+#include <string>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+
+TEST(AgentSettingsTest, PathMustBeAbsoluteRunnableFile) {
+  EXPECT_TRUE(IsRunnableAbsolutePath("/bin/sh"));
+  EXPECT_FALSE(IsRunnableAbsolutePath(""));
+  EXPECT_FALSE(IsRunnableAbsolutePath("sh"));
+  EXPECT_FALSE(IsRunnableAbsolutePath("/bin"));
+  EXPECT_FALSE(IsRunnableAbsolutePath("/does/not/exist"));
+  EXPECT_FALSE(IsRunnableAbsolutePath("/etc/hosts"));
+  EXPECT_FALSE(IsRunnableAbsolutePath("/bin/sh\n"));
+}
+
+TEST(AgentSettingsTest, CustomCommandStartsWithRunnablePath) {
+  EXPECT_TRUE(IsValidCustomAgentCommand("/bin/sh"));
+  EXPECT_TRUE(IsValidCustomAgentCommand("/bin/sh -c exit"));
+  EXPECT_FALSE(IsValidCustomAgentCommand("sh -c exit"));
+  EXPECT_FALSE(IsValidCustomAgentCommand("/nope --acp"));
+  EXPECT_FALSE(IsValidCustomAgentCommand("/bin/sh\t-c"));
+  EXPECT_TRUE(IsValidCustomAgentCommand("\"/bin/sh\" -c exit"));
+  EXPECT_FALSE(IsValidCustomAgentCommand("\"/bin/sh -c exit"));
+}
+
+TEST(AgentSettingsTest, CommandWordsCanHoldSpaces) {
+  using Argv = std::vector<std::string>;
+  EXPECT_EQ(SplitAgentCommand("/a/agent  --acp "), Argv({"/a/agent", "--acp"}));
+  EXPECT_EQ(SplitAgentCommand("\"/My Tools/agent\" --acp"),
+            Argv({"/My Tools/agent", "--acp"}));
+  EXPECT_EQ(SplitAgentCommand("/My\\ Tools/agent"), Argv({"/My Tools/agent"}));
+  EXPECT_EQ(SplitAgentCommand("/a --name \"\""), Argv({"/a", "--name", ""}));
+  EXPECT_EQ(SplitAgentCommand("'/My Tools/agent' 'a\\b'"),
+            Argv({"/My Tools/agent", "a\\b"}));
+  EXPECT_TRUE(SplitAgentCommand("\"/open").empty());
+  EXPECT_TRUE(SplitAgentCommand("'/open").empty());
+  EXPECT_TRUE(SplitAgentCommand("   ").empty());
+}
+
+}  // namespace rac::ai

+// True when `path` is an absolute path to a regular file the user can run.
+bool IsRunnableAbsolutePath(std::string_view path);
+
+// Splits a custom agent command into argv at spaces. A word keeps its spaces
+// in single quotes ('/My Tools/agent'), in double quotes, or with a
+// backslash (/My\ Tools/agent). A backslash escapes any character, also
+// inside double quotes. Empty when a quote doesn't close.
+std::vector<std::string> SplitAgentCommand(std::string_view command);
+
+// True when `command` is an argv (see SplitAgentCommand) whose first word is
+// a runnable absolute path. Control characters are rejected.
+bool IsValidCustomAgentCommand(std::string_view command);
+

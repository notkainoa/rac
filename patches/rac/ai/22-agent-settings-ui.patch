+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/ai/acp/agent_settings.h"
+
+#include <unistd.h>
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/strings/string_util.h"
+
+namespace rac::ai {
+namespace {
+
+bool HasControlCharacter(std::string_view text) {
+  for (char c : text) {
+    if (static_cast<unsigned char>(c) < 0x20 || c == 0x7f) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+bool IsRunnableAbsolutePath(std::string_view path) {
+  if (path.empty() || path.size() > kMaxAgentCommandLength || path[0] != '/' ||
+      HasControlCharacter(path)) {
+    return false;
+  }
+  const base::FilePath file_path{std::string(path)};
+  return base::PathExists(file_path) && !base::DirectoryExists(file_path) &&
+         access(file_path.value().c_str(), X_OK) == 0;
+}
+
+std::vector<std::string> SplitAgentCommand(std::string_view command) {
+  std::vector<std::string> argv;
+  std::string word;
+  bool in_word = false;
+  // The quote that is open, or 0.
+  char quote = 0;
+  for (size_t i = 0; i < command.size(); ++i) {
+    const char c = command[i];
+    if (quote == '\'') {
+      // Nothing is special inside single quotes.
+      if (c == '\'') {
+        quote = 0;
+      } else {
+        word.push_back(c);
+      }
+    } else if (c == '\\' && i + 1 < command.size()) {
+      word.push_back(command[++i]);
+      in_word = true;
+    } else if (quote == '"') {
+      if (c == '"') {
+        quote = 0;
+      } else {
+        word.push_back(c);
+      }
+    } else if (c == '"' || c == '\'') {
+      quote = c;
+      in_word = true;
+    } else if (c == ' ') {
+      if (in_word) {
+        argv.push_back(std::move(word));
+        word.clear();
+        in_word = false;
+      }
+    } else {
+      word.push_back(c);
+      in_word = true;
+    }
+  }
+  if (quote) {
+    return {};
+  }
+  if (in_word) {
+    argv.push_back(std::move(word));
+  }
+  return argv;
+}
+
+bool IsValidCustomAgentCommand(std::string_view command) {
+  if (command.size() > kMaxAgentCommandLength || HasControlCharacter(command)) {
+    return false;
+  }
+  const std::vector<std::string> argv = SplitAgentCommand(command);
+  return !argv.empty() && IsRunnableAbsolutePath(argv[0]);
+}
+
+}  // namespace rac::ai

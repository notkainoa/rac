+class AskButton;
+
+// The "Ask" pill the find bar shows in place of its match count when the
+// query found nothing but reads like a question. The find bar keeps one of
+// these only after the pill has been wanted once, so with the assistant off
+// it never exists.
+class FindAsk {
+ public:
+  FindAsk(FindBarController* controller,
+          BrowserWindowInterface* browser,
+          views::View* match_count);
+  FindAsk(const FindAsk&) = delete;
+  FindAsk& operator=(const FindAsk&) = delete;
+  ~FindAsk();
+
+  void Show(std::u16string_view query);
+  void Hide();
+  bool visible() const { return visible_; }
+  const std::u16string& query() const { return query_; }
+
+  // Sends the query to the assistant and closes the find bar. False, leaving
+  // everything as it was, if the assistant can't take it.
+  bool Run();
+
+ private:
+  raw_ptr<FindBarController> controller_;
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::View> match_count_;
+  raw_ptr<AskButton> button_ = nullptr;
+  std::u16string query_;
+  bool visible_ = false;
+};
+
+// Called with each find result. Shows the pill if there were no matches for a
+// question-like `query` and the assistant can answer in this window; hides it
+// otherwise. `ask` is made when first needed.
+void UpdateFindAsk(std::unique_ptr<FindAsk>& ask,
+                   FindBarController* controller,
+                   views::View* match_count,
+                   int number_of_matches,
+                   bool final_update,
+                   std::u16string_view query);
+
+// Hides the pill and brings back the match count. Safe with no pill.
+void HideFindAsk(std::unique_ptr<FindAsk>& ask);
+
+// For Return in the find box: if the pill is showing for `query`, asks and
+// returns true. Otherwise does nothing and returns false.
+bool TryFindAsk(std::unique_ptr<FindAsk>& ask, std::u16string_view query);
+
+}  // namespace rac::ai

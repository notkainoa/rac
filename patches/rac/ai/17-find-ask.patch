+      const SpaceTheme neutral = SpaceTheme::Preset(0);
+      if (space->theme.color1 != neutral.color1 ||
+          space->theme.color2 != neutral.color2) {
+        const bool dark =
+            widget->GetColorMode() == ui::ColorProviderKey::ColorMode::kDark;
+        const SkColor themed = ParseHex(space->theme.GetStops(dark).first);
+        if (themed != SK_ColorTRANSPARENT) {
+          color = themed;
+        }
+      }
+    }
+    if (color != dot_color_) {
+      dot_color_ = color;
+      SchedulePaint();
+    }
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  SkColor dot_color_ = SK_ColorGRAY;
+};

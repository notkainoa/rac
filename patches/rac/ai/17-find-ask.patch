+namespace rac::ai {
+
+TEST(RacAiAskQueryTest, ThreeWordsAsk) {
+  EXPECT_TRUE(IsAskableQuery(u"how do I cancel"));
+  EXPECT_TRUE(IsAskableQuery(u"  how   do\tI  "));
+  EXPECT_FALSE(IsAskableQuery(u"cancel plan"));
+  EXPECT_FALSE(IsAskableQuery(u"cancel"));
+}
+
+TEST(RacAiAskQueryTest, TrailingQuestionMarkAsks) {
+  EXPECT_TRUE(IsAskableQuery(u"why?"));
+  EXPECT_TRUE(IsAskableQuery(u"why? "));
+  EXPECT_TRUE(IsAskableQuery(u"\u4ec0\u4e48\uff1f"));
+  EXPECT_FALSE(IsAskableQuery(u"what? no"));
+}
+
+TEST(RacAiAskQueryTest, EmptyNeverAsks) {
+  EXPECT_FALSE(IsAskableQuery(u""));
+  EXPECT_FALSE(IsAskableQuery(u"   "));
+}
+

+
+FindAsk::FindAsk(FindBarController* controller,
+                 BrowserWindowInterface* browser,
+                 views::View* match_count)
+    : controller_(controller), browser_(browser), match_count_(match_count) {
+  views::View* row = match_count->parent();
+  auto button = std::make_unique<AskButton>(
+      base::BindRepeating(base::IgnoreResult(&FindAsk::Run),
+                          base::Unretained(this)),
+      browser);
+  button->SetVisible(false);
+  // Same margins as the match count, so the separator after it stays put.
+  button->SetProperty(views::kMarginsKey,
+                      *match_count->GetProperty(views::kMarginsKey));
+  button_ = row->AddChildViewAt(std::move(button),
+                                row->GetIndexOf(match_count).value() + 1);
+}
+
+FindAsk::~FindAsk() {
+  if (button_) {
+    if (views::View* row = button_->parent()) {
+      row->RemoveChildViewT(button_.ExtractAsDangling());
+    }
+  }
+}
+
+void FindAsk::Show(std::u16string_view query) {
+  query_ = std::u16string(base::TrimWhitespace(query, base::TRIM_ALL));
+  button_->SetQuery(query_);
+  if (visible_) {
+    return;
+  }
+  visible_ = true;
+  match_count_->SetVisible(false);
+  button_->SetVisible(true);
+  button_->FadeIn();
+  button_->GetViewAccessibility().AnnouncePolitely(kAnnouncement);
+}
+
+void FindAsk::Hide() {
+  if (!visible_) {
+    return;
+  }
+  visible_ = false;
+  button_->SetVisible(false);
+  match_count_->SetVisible(true);
+}
+
+bool FindAsk::Run() {
+  if (!visible_) {
+    return false;
+  }
+  if (!AskAssistant(browser_, base::UTF16ToUTF8(query_))) {
+    // The assistant went away (AI off, no provider) since the pill appeared.
+    // Hide it so Return goes back to ordinary find.
+    Hide();
+    return false;
+  }
+  // The find bar's job is over once the question has left it.
+  FindBarController* controller = controller_;
+  Hide();
+  controller->EndFindSession(find_in_page::SelectionAction::kKeep,
+                             find_in_page::ResultAction::kClear);
+  return true;
+}
+
+void UpdateFindAsk(std::unique_ptr<FindAsk>& ask,
+                   FindBarController* controller,
+                   views::View* match_count,
+                   int number_of_matches,
+                   bool final_update,
+                   std::u16string_view query) {
+  if (number_of_matches != 0 || !final_update) {
+    HideFindAsk(ask);
+    return;
+  }
+  content::WebContents* contents =
+      controller ? controller->web_contents() : nullptr;
+  if (!contents) {
+    HideFindAsk(ask);
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!IsAiEnabled(profile->GetPrefs()) || !browser || !IsAskableQuery(query) ||
+      !CanAskAssistant(browser)) {
+    HideFindAsk(ask);
+    return;
+  }
+  if (!ask) {
+    ask = std::make_unique<FindAsk>(controller, browser, match_count);
+  }
+  ask->Show(query);
+}
+
+void HideFindAsk(std::unique_ptr<FindAsk>& ask) {
+  if (ask) {
+    ask->Hide();
+  }
+}
+
+bool TryFindAsk(std::unique_ptr<FindAsk>& ask, std::u16string_view query) {
+  return ask && ask->visible() &&
+         base::TrimWhitespace(query, base::TRIM_ALL) == ask->query() &&
+         ask->Run();
+}

+#include "base/strings/string_util.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr size_t kMinWords = 3;
+
+bool IsQuestionMark(char16_t c) {
+  // ASCII, fullwidth (CJK), Arabic and Greek question marks.
+  return c == u'?' || c == u'\uFF1F' || c == u'\u061F' || c == u'\u037E';
+}
+
+}  // namespace
+
+bool IsAskableQuery(std::u16string_view query) {
+  std::u16string_view trimmed = base::TrimWhitespace(query, base::TRIM_ALL);
+  if (trimmed.empty()) {
+    return false;
+  }
+  if (IsQuestionMark(trimmed.back())) {
+    return true;
+  }
+  size_t words = 0;
+  bool in_word = false;
+  for (char16_t c : trimmed) {
+    const bool space = base::IsUnicodeWhitespace(c);
+    if (!space && !in_word) {
+      ++words;
+    }
+    in_word = !space;
+  }
+  return words >= kMinWords;
+}
+
+}  // namespace rac::ai

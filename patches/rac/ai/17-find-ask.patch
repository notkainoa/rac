+// Only the side panel's page asks: it is the one that sends a prompt posted
+// by AskAssistant().
+void PageHandler::HandleTakeAsk(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AllowJavascript();
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || !AiServiceFactory::GetForProfile(profile_)) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  if (!ask_subscription_) {
+    ask_subscription_ = AddAssistantPromptCallback(
+        browser,
+        base::BindRepeating(&PageHandler::OnAskPosted, base::Unretained(this)));
+  }
+  std::optional<std::string> prompt = TakeAssistantPrompt(browser);
+  ResolveJavascriptCallback(args[0],
+                            prompt ? base::Value(*prompt) : base::Value());
+}
+
+void PageHandler::OnAskPosted() {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!IsJavascriptAllowed() || !browser) {
+    return;
+  }
+  if (std::optional<std::string> prompt = TakeAssistantPrompt(browser)) {
+    FireWebUIListener("rac-ai-ask", base::Value(*prompt));
+  }
+}

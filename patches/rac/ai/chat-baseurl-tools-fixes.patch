+std::string NormalizeBaseUrl(ProviderType type, const std::string& base_url) {
+  std::string url;
+  base::TrimString(base_url, base::kWhitespaceASCII, &url);
+  while (!url.empty() && url.back() == '/') {
+    url.pop_back();
+  }
+  // A pasted endpoint, like "https://openrouter.ai/api/v1/chat/completions",
+  // would end up doubled, so drop the request path rac adds itself.
+  // The model list ("/models") and Ollama's own chat API ("/api/chat") are
+  // pasted too.
+  const std::vector<std::string_view> suffixes =
+      type == ProviderType::kAnthropic
+          ? std::vector<std::string_view>{"/v1/messages", "/v1/models"}
+          : std::vector<std::string_view>{"/chat/completions", "/models",
+                                          "/api/chat"};
+  for (std::string_view suffix : suffixes) {
+    if (base::EndsWith(url, suffix) && url.size() > suffix.size()) {
+      url.resize(url.size() - suffix.size());
+      break;
+    }
+  }
+  while (!url.empty() && url.back() == '/') {
+    url.pop_back();
+  }
+  // OpenAI-compatible servers live under /v1, and their documented host
+  // ("http://localhost:11434" for Ollama) leaves it out.
+  if (type == ProviderType::kOpenAiCompatible) {
+    const GURL parsed(url);
+    if (parsed.is_valid() && parsed.has_host() && parsed.path() == "/" &&
+        !parsed.has_query() && !parsed.has_ref()) {
+      url += "/v1";
+    }
+  }
+  return url;
+}
+
 }  // namespace rac::ai

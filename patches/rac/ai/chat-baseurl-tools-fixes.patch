+// What went wrong with a chat, in plain words: a title, one line on what to
+// do, and the buttons that do it. `raw` is the provider's own text.
+function describeChatError(raw: string, hadReply: boolean): ErrorView {
+  const first = raw.split('\n')[0]!.slice(0, 240);
+  // A missing model is also a 404 ("model \"llama3.2\" not found, try
+  // pulling it first", "The model `x` does not exist"), so check it first.
+  if (/\bmodel\b/i.test(raw) &&
+      /not found|does not exist|doesn't exist|unknown model|try pulling/i.test(
+          raw)) {
+    return {
+      title: loadTimeData.getString('errModelTitle'),
+      detail: loadTimeData.getString('errModelDetail'),
+      actions: ['retry', 'settings'],
+    };
+  }
+  // A doubled or wrong server address answers "not found" because the
+  // request lands nowhere. The address is in settings.
+  if (/not found|\b404\b/i.test(raw)) {
+    return {
+      title: loadTimeData.getString('errUrlTitle'),
+      detail: loadTimeData.getString('errUrlDetail'),
+      actions: ['retry', 'settings'],
+    };
+  }
+  if (/401|unauthorized|api key|credential/i.test(raw)) {
+    return {
+      title: loadTimeData.getString('errKeyTitle'),
+      detail: loadTimeData.getString('errKeyDetail'),
+      actions: ['retry', 'settings'],
+    };
+  }
+  // Word boundaries, so "generate" or "accurate" isn't a rate limit.
+  if (/\brate[ -]?limit|\bquota\b|\b429\b|\busage limit|too many requests/i
+          .test(raw)) {
+    return {
+      title: loadTimeData.getString('errLimitChatTitle'),
+      detail: first,
+      actions: ['retry'],
+    };
+  }
+  return {
+    title: loadTimeData.getString('errorTitle'),
+    detail: first,
+    actions: hadReply ? ['retry'] : ['retry', 'settings'],
+  };
+}

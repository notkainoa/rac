+constexpr char kSupersededSnapshot[] =
+    "[superseded by a newer snapshot of this tab]";
+
+// Agent tool results carry page snapshots of up to 48 KB, and every round
+// resends the whole transcript. Once an absolute snapshot of a tab arrives,
+// the older snapshots of that tab only cost tokens and context, so their
+// text becomes a stub. Deltas are kept until then, since they build on the
+// snapshot before them.
+void SupersedeOlderSnapshots(std::vector<ChatMessage>& messages,
+                             const std::string& result) {
+  const auto parsed = base::JSONReader::ReadDict(result, base::JSON_PARSE_RFC);
+  const base::DictValue* data = parsed ? parsed->FindDict("data") : nullptr;
+  if (!data || !data->FindBool("page_snapshot").value_or(false) ||
+      data->FindBool("is_delta").value_or(false)) {
+    return;
+  }
+  const std::string* tab = data->FindString("tab_id");
+  for (auto& message : messages) {
+    if (message.role != ChatMessage::Role::kTool ||
+        message.text.find("\"page_snapshot\":true") == std::string::npos) {
+      continue;
+    }
+    auto old = base::JSONReader::ReadDict(message.text, base::JSON_PARSE_RFC);
+    base::DictValue* old_data = old ? old->FindDict("data") : nullptr;
+    if (!old_data || !old_data->FindBool("page_snapshot").value_or(false)) {
+      continue;
+    }
+    const std::string* old_tab = old_data->FindString("tab_id");
+    if (!tab || !old_tab || *tab != *old_tab) {
+      continue;
+    }
+    old_data->Set("text", kSupersededSnapshot);
+    old_data->Remove("page_snapshot");
+    base::JSONWriter::Write(*old, &message.text);
+  }
+}
+

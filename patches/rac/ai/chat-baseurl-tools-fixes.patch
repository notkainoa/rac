+// The save-time connection check. The page hears the answer as a listener
+// event, because a dead provider can take seconds to time out. Fire-and-forget
+// from the page, so `args` carries no callback id.
+void RacAiHandler::HandleCheckConnection(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  const std::string& id = args[0].GetString();
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  const rac::ai::ProviderInfo* info = rac::ai::FindProvider(id);
+  if (!service || !info) {
+    return;
+  }
+  const rac::ai::ProviderSettings settings =
+      rac::ai::GetProviderSettings(profile_->GetPrefs(), id);
+  if (settings.base_url.empty() ||
+      (info->requires_key && !service->key_store().HasKey(id))) {
+    FireConnectionEvent(id, {.ok = false,
+                             .message = "Add a server address and a key "
+                                        "first."});
+    return;
+  }
+  if (!info->requires_key) {
+    rac::ai::CheckProviderConnection(
+        service->url_loader_factory(), *info, settings.base_url, std::string(),
+        settings.model,
+        base::BindOnce(&RacAiHandler::OnConnectionResult,
+                       weak_factory_.GetWeakPtr(), id));
+    return;
+  }
+  service->key_store().GetKey(id,
+                              base::BindOnce(&RacAiHandler::OnConnectionKey,
+                                             weak_factory_.GetWeakPtr(), id));
+}
+
+void RacAiHandler::OnConnectionKey(std::string provider_id,
+                                   std::optional<std::string> key) {
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  const rac::ai::ProviderInfo* info = rac::ai::FindProvider(provider_id);
+  if (!service || !info || !key) {
+    return;
+  }
+  const rac::ai::ProviderSettings settings =
+      rac::ai::GetProviderSettings(profile_->GetPrefs(), provider_id);
+  rac::ai::CheckProviderConnection(
+      service->url_loader_factory(), *info, settings.base_url, *key,
+      settings.model,
+      base::BindOnce(&RacAiHandler::OnConnectionResult,
+                     weak_factory_.GetWeakPtr(), provider_id));
+}
+
+void RacAiHandler::OnConnectionResult(std::string provider_id,
+                                      rac::ai::ConnectionResult result) {
+  FireConnectionEvent(provider_id, std::move(result));
+}
+
+void RacAiHandler::FireConnectionEvent(const std::string& provider_id,
+                                       rac::ai::ConnectionResult result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  FireWebUIListener("rac-ai-connection", base::DictValue()
+                                             .Set("id", provider_id)
+                                             .Set("ok", result.ok)
+                                             .Set("message", result.message));
+}

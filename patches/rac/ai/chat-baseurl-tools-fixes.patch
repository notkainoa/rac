+#include "chrome/browser/rac/ai/providers.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+TEST(ProvidersTest, NormalizeTrimsSpacesAndSlashes) {
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "  https://openrouter.ai/api/v1/ "),
+            "https://openrouter.ai/api/v1");
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "https://openrouter.ai/api/v1//"),
+            "https://openrouter.ai/api/v1");
+}
+
+TEST(ProvidersTest, NormalizeStripsPastedChatCompletions) {
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "https://openrouter.ai/api/v1/chat/completions"),
+            "https://openrouter.ai/api/v1");
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "https://openrouter.ai/api/v1/chat/completions/"),
+            "https://openrouter.ai/api/v1");
+  // The address the maintainer had saved: doubled before, works after.
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "https://openrouter.ai/api/v1/chat/completions"),
+            "https://openrouter.ai/api/v1");
+}
+
+TEST(ProvidersTest, NormalizeStripsPastedAnthropicMessages) {
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kAnthropic,
+                             "https://api.anthropic.com/v1/messages"),
+            "https://api.anthropic.com");
+}
+
+TEST(ProvidersTest, NormalizeLeavesOrdinaryAddressesAlone) {
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "http://localhost:11434/v1"),
+            "http://localhost:11434/v1");
+  EXPECT_EQ(
+      NormalizeBaseUrl(ProviderType::kAnthropic, "https://api.anthropic.com"),
+      "https://api.anthropic.com");
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible, ""), "");
+}
+
+TEST(ProvidersTest, SavedEndpointsSurviveBuildChatRequest) {
+  // A URL saved with the request path still reaches the right endpoint,
+  // because reads normalize it too.
+  const ProviderInfo* info = FindProvider("openai");
+  ASSERT_TRUE(info);
+  const std::string normalized =
+      NormalizeBaseUrl(info->type, "https://api.openai.com/v1");
+  EXPECT_EQ(normalized, info->default_base_url);
+}
+
+TEST(ProvidersTest, NormalizeHandlesHostsAndOtherPastedPaths) {
+  // Ollama's and LM Studio's documented hosts have no /v1.
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "http://localhost:11434"),
+            "http://localhost:11434/v1");
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "http://localhost:1234/"),
+            "http://localhost:1234/v1");
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "http://localhost:11434/v1/models"),
+            "http://localhost:11434/v1");
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kOpenAiCompatible,
+                             "http://localhost:11434/api/chat"),
+            "http://localhost:11434/v1");
+  EXPECT_EQ(NormalizeBaseUrl(ProviderType::kAnthropic,
+                             "https://api.anthropic.com/v1/models"),
+            "https://api.anthropic.com");
+  // Anthropic's root has no /v1 of its own; rac adds it.
+  EXPECT_EQ(
+      NormalizeBaseUrl(ProviderType::kAnthropic, "https://api.anthropic.com/"),
+      "https://api.anthropic.com");
+}
+
+}  // namespace
+}  // namespace rac::ai

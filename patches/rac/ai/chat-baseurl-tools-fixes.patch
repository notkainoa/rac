+// The save-time connection check. Keeps itself alive until it has run the
+// callback, so the caller doesn't have to hold anything.
+class ConnectionCheck {
+ public:
+  static void Start(scoped_refptr<network::SharedURLLoaderFactory> factory,
+                    const ProviderInfo& info,
+                    const std::string& base_url,
+                    const std::string& api_key,
+                    const std::string& model,
+                    base::OnceCallback<void(ConnectionResult)> callback) {
+    auto check =
+        std::make_shared<ConnectionCheck>(std::move(factory), info, base_url,
+                                          api_key, model, std::move(callback));
+    check->self_ = check;
+    check->CheckModels();
+  }
+
+  ConnectionCheck(scoped_refptr<network::SharedURLLoaderFactory> factory,
+                  const ProviderInfo& info,
+                  const std::string& base_url,
+                  const std::string& api_key,
+                  const std::string& model,
+                  base::OnceCallback<void(ConnectionResult)> callback)
+      : factory_(std::move(factory)),
+        info_(info),
+        base_url_(base_url),
+        api_key_(api_key),
+        model_(model),
+        callback_(std::move(callback)) {}
+  ConnectionCheck(const ConnectionCheck&) = delete;
+  ConnectionCheck& operator=(const ConnectionCheck&) = delete;
+  ~ConnectionCheck() = default;
+
+  void CheckModels() {
+    const GURL url(ModelsUrl(info_, base_url_));
+    if (!factory_ || !IsAcceptableBaseUrl(url)) {
+      Finish({.ok = false, .message = "That address isn't usable."});
+      return;
+    }
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->redirect_mode = network::mojom::RedirectMode::kError;
+    request->load_flags = net::LOAD_DISABLE_CACHE;
+    AddAuthHeaders(info_, api_key_, request.get());
+    loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                               kTrafficAnnotation);
+    loader_->SetAllowHttpErrorResults(true);
+    loader_->SetTimeoutDuration(kCheckTimeout);
+    loader_->DownloadToString(factory_.get(),
+                              base::BindOnce(
+                                  [](std::shared_ptr<ConnectionCheck> self,
+                                     std::optional<std::string> body) {
+                                    self->OnModelsBody(std::move(body));
+                                  },
+                                  self_),
+                              kMaxCheckBodyBytes);
+  }
+
+ private:
+  void OnModelsBody(std::optional<std::string> body) {
+    const int status = ResponseCode(loader_.get());
+    if (status >= 200 && status < 300) {
+      Finish({.ok = true});
+      return;
+    }
+    // Servers without a model list still answer chats, so ask for one word.
+    if (status == 404 || status == 405) {
+      CheckChat();
+      return;
+    }
+    if (status != 0) {
+      Finish({.ok = false,
+              .message = DescribeHttpError(status, body.value_or(""))});
+      return;
+    }
+    const int net_error = loader_ ? loader_->NetError() : net::ERR_FAILED;
+    Finish(
+        {.ok = false,
+         .message = base::StrCat({"Couldn't reach the provider (",
+                                  net::ErrorToShortString(net_error), ")."})});
+  }
+
+  void CheckChat() {
+    if (model_.empty()) {
+      Finish({.ok = false, .message = "Set a model before checking."});
+      return;
+    }
+    ChatRequest probe;
+    probe.max_output_tokens = 1;
+    probe.messages.push_back({ChatMessage::Role::kUser, "ping"});
+    auto spec = BuildChatRequest(info_, base_url_, model_, api_key_, probe);
+    if (!spec) {
+      Finish({.ok = false, .message = "That address or key isn't usable."});
+      return;
+    }
+    if (auto body =
+            base::JSONReader::ReadDict(spec->body, base::JSON_PARSE_RFC)) {
+      body->Set("stream", false);
+      base::JSONWriter::Write(*body, &spec->body);
+    }
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = spec->url;
+    request->method = "POST";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->redirect_mode = network::mojom::RedirectMode::kError;
+    request->load_flags = net::LOAD_DISABLE_CACHE;
+    for (const auto& [name, value] : spec->headers) {
+      request->headers.SetHeader(name, value);
+    }
+    loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                               kTrafficAnnotation);
+    loader_->SetAllowHttpErrorResults(true);
+    loader_->SetTimeoutDuration(kCheckTimeout);
+    loader_->AttachStringForUpload(spec->body, "application/json");
+    loader_->DownloadToString(factory_.get(),
+                              base::BindOnce(
+                                  [](std::shared_ptr<ConnectionCheck> self,
+                                     std::optional<std::string> body) {
+                                    self->OnChatBody(std::move(body));
+                                  },
+                                  self_),
+                              kMaxCheckBodyBytes);
+  }
+
+  void OnChatBody(std::optional<std::string> body) {
+    const int status = ResponseCode(loader_.get());
+    if (status >= 200 && status < 300) {
+      Finish({.ok = true});
+      return;
+    }
+    if (status != 0) {
+      Finish({.ok = false,
+              .message = DescribeHttpError(status, body.value_or(""))});
+      return;
+    }
+    const int net_error = loader_ ? loader_->NetError() : net::ERR_FAILED;
+    Finish(
+        {.ok = false,
+         .message = base::StrCat({"Couldn't reach the provider (",
+                                  net::ErrorToShortString(net_error), ")."})});
+  }
+
+  static int ResponseCode(network::SimpleURLLoader* loader) {
+    const network::mojom::URLResponseHead* info =
+        loader ? loader->ResponseInfo() : nullptr;
+    return info && info->headers ? info->headers->response_code() : 0;
+  }
+
+  void Finish(ConnectionResult result) {
+    loader_.reset();
+    self_.reset();
+    std::move(callback_).Run(std::move(result));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  ProviderInfo info_;
+  std::string base_url_;
+  std::string api_key_;
+  std::string model_;
+  base::OnceCallback<void(ConnectionResult)> callback_;
+  std::shared_ptr<ConnectionCheck> self_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+};
+

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_LINK_FETCHER_H_
+#define CHROME_BROWSER_RAC_AI_LINK_FETCHER_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/timer/timer.h"
+#include "base/types/expected.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "chrome/browser/rac/ai/link_summary.h"
+#include "chrome/browser/rac/ai/page_text.h"
+#include "components/optimization_guide/content/browser/page_content_proto_provider.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+namespace rac::ai {
+
+// Reads a page the user hasn't opened. The page loads in a hidden tab of a
+// one-off off-the-record profile, so it never sees the user's cookies,
+// storage or logins and leaves nothing behind. JavaScript, images, plugins,
+// popups and downloads are off, only http(s) is followed, and the whole read
+// has a time limit. Destroying the fetcher cancels it and tears everything
+// down.
+class LinkFetcher : public content::WebContentsObserver,
+                    public content::WebContentsDelegate,
+                    public ProfileObserver {
+ public:
+  using Result = base::expected<PageText, LinkFailure>;
+  using Callback = base::OnceCallback<void(Result)>;
+
+  // `profile` is the user's profile; its off-the-record twin is not used.
+  // `callback` runs exactly once unless the fetcher is destroyed first, and
+  // never from inside this object's own call stack.
+  LinkFetcher(Profile* profile, const GURL& url, Callback callback);
+  LinkFetcher(const LinkFetcher&) = delete;
+  LinkFetcher& operator=(const LinkFetcher&) = delete;
+  ~LinkFetcher() override;
+
+  // content::WebContentsObserver:
+  void ReadyToCommitNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void DidStopLoading() override;
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override;
+
+  // content::WebContentsDelegate:
+  void CanDownload(const GURL& url,
+                   const std::string& request_method,
+                   base::OnceCallback<void(bool)> callback) override;
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+ private:
+  void Extract();
+  void OnExtracted(optimization_guide::AIPageContentResultOrError result);
+  void Finish(Result result);
+  void Deliver(Result result);
+  void TearDown();
+
+  raw_ptr<Profile> otr_profile_ = nullptr;
+  std::unique_ptr<content::WebContents> web_contents_;
+  Callback callback_;
+  base::OneShotTimer timeout_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  bool committed_ = false;
+  bool finished_ = false;
+  bool extracting_ = false;
+  base::WeakPtrFactory<LinkFetcher> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_LINK_FETCHER_H_

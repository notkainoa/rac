+namespace rac::ai {
+
+// Where a card goes. Everything is in screen coordinates.
+struct LinkCardAnchor {
+  // The page the link is on. The card never leaves it.
+  gfx::Rect page;
+  // The link, or the pointer if the link's own bounds aren't known.
+  gfx::Rect link;
+  int pointer_x = 0;
+};
+
+// The floating card that shows a link's summary. It is a native, non-activating
+// widget: it never takes focus, so typing and scrolling keep going to the
+// page. It only shows what it is told; the controller owns what it means.
+class LinkSummaryCard {
+ public:
+  // Returns null if `parent` can't host a card.
+  static std::unique_ptr<LinkSummaryCard> Create(views::Widget* parent,
+                                                 const LinkCardAnchor& anchor,
+                                                 const std::string& host);
+  LinkSummaryCard(const LinkSummaryCard&) = delete;
+  LinkSummaryCard& operator=(const LinkSummaryCard&) = delete;
+  ~LinkSummaryCard();
+
+  // Shows a quiet status line, like "Reading page…", next to a still or
+  // pulsing orb.
+  void ShowStatus(const std::string& text);
+  // Shows the title and summary. Calls while the summary is still streaming
+  // may come often; height changes are coalesced.
+  void ShowResult(const std::string& title,
+                  const std::string& summary,
+                  bool streaming);
+  // Shows one line of text, with the provider's reason below it in muted text.
+  void ShowError(const std::string& text, const std::string& detail);
+
+  // Fades out and closes, or closes at once.
+  void Dismiss(bool animate);
+
+  bool ContainsScreenPoint(const gfx::Point& point) const;
+  gfx::Rect GetBoundsInScreen() const;
+  bool IsVisible() const;
+
+ private:
+  class Delegate;
+
+  LinkSummaryCard();
+
+  void OnWidgetClosed(views::Widget::ClosedReason reason);
+
+  // The widget must be destroyed before its delegate.
+  std::unique_ptr<Delegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  bool closed_ = false;
+  base::WeakPtrFactory<LinkSummaryCard> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_AI_LINK_SUMMARY_CARD_H_

+// A small dot that pulses while the card waits and sits still otherwise or
+// when the user asked for reduced motion.
+class Orb : public views::View, public gfx::AnimationDelegate {
+  METADATA_HEADER(Orb, views::View)
+
+ public:
+  Orb() : throb_(this) {
+    throb_.SetSlideDuration(base::Milliseconds(700));
+    SetPreferredSize(gfx::Size(kOrbSize, kOrbSize));
+    GetViewAccessibility().SetIsIgnored(true);
+  }
+  ~Orb() override = default;
+
+  void SetPulsing(bool pulsing) {
+    if (pulsing && !gfx::Animation::PrefersReducedMotion()) {
+      if (!throb_.is_animating()) {
+        throb_.StartThrobbing(-1);
+      }
+    } else {
+      throb_.Stop();
+      SchedulePaint();
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const double phase = throb_.is_animating() ? throb_.GetCurrentValue() : 1.0;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(
+        SkColorSetA(kFallbackOrb, static_cast<U8CPU>(110 + 145 * phase)));
+    canvas->DrawCircle(gfx::PointF(width() / 2.0f, height() / 2.0f),
+                       width() / 2.0f, flags);
+  }
+
+  void AnimationProgressed(const gfx::Animation*) override { SchedulePaint(); }
+
+ private:
+  gfx::ThrobAnimation throb_;
+};

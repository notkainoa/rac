+class LinkSummaryCard::Delegate : public views::BubbleDialogDelegate,
+                                  public gfx::AnimationDelegate {
+ public:
+  Delegate(const LinkCardAnchor& anchor, const std::string& host)
+      : views::BubbleDialogDelegate(nullptr,
+                                    views::BubbleBorder::NONE,
+                                    views::BubbleBorder::STANDARD_SHADOW,
+                                    /*autosize=*/true),
+        anchor_(anchor),
+        above_(ShouldPlaceAbove(anchor.page, anchor.link)),
+        fade_(kFade, gfx::LinearAnimation::kDefaultFrameRate, this) {
+    SetAnchorRect(anchor.link);
+    SetCanActivate(false);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    SetShowCloseButton(false);
+    set_margins(gfx::Insets());
+    set_corner_radius(kRadius);
+    set_adjust_if_offscreen(false);
+    set_close_on_deactivate(false);
+    set_focus_traversable_from_anchor_view(false);
+    set_highlight_button_when_shown(false);
+    set_fixed_width(kLinkCardWidth);
+    SetBackgroundColor(ui::kColorBubbleBackground);
+    contents_ = SetContentsView(std::make_unique<Contents>(host));
+  }
+  ~Delegate() override = default;
+
+  Contents* contents() { return contents_; }
+
+  void Show(views::Widget* widget) {
+    widget_ = widget;
+    if (gfx::Animation::PrefersReducedMotion()) {
+      widget->ShowInactive();
+      return;
+    }
+    widget->SetOpacity(0);
+    widget->ShowInactive();
+    fade_in_ = true;
+    fade_.Start();
+  }
+
+  void ShowStatus(const std::string& text) {
+    contents_->SetStatus(text);
+    Fit();
+  }
+
+  void ShowResult(const std::string& title,
+                  const std::string& summary,
+                  bool streaming) {
+    pending_title_ = title;
+    pending_summary_ = summary;
+    if (!streaming) {
+      height_timer_.Stop();
+      ApplyResult();
+      contents_->GetViewAccessibility().SetName(ToUtf16(title));
+      contents_->GetViewAccessibility().SetDescription(ToUtf16(summary));
+      contents_->GetViewAccessibility().AnnounceText(u"Summary ready: " +
+                                                     ToUtf16(title));
+      return;
+    }
+    if (height_timer_.IsRunning()) {
+      return;
+    }
+    if (!last_apply_.is_null() &&
+        base::TimeTicks::Now() - last_apply_ < kHeightCoalesce) {
+      height_timer_.Start(FROM_HERE, kHeightCoalesce, this,
+                          &Delegate::ApplyResult);
+      return;
+    }
+    ApplyResult();
+  }
+
+  void ShowError(const std::string& text, const std::string& detail) {
+    height_timer_.Stop();
+    contents_->SetError(text, detail);
+    contents_->GetViewAccessibility().SetName(ToUtf16(text));
+    Fit();
+  }
+
+  void Dismiss(bool animate) {
+    if (!widget_ || widget_->IsClosed()) {
+      return;
+    }
+    height_timer_.Stop();
+    if (!animate || gfx::Animation::PrefersReducedMotion() ||
+        !widget_->IsVisible()) {
+      widget_->CloseNow();
+      return;
+    }
+    fade_in_ = false;
+    fade_.Stop();
+    fade_.Start();
+  }
+
+  // views::BubbleDialogDelegate:
+  gfx::Rect GetBubbleBounds() override {
+    gfx::Size size = views::BubbleDialogDelegate::GetBubbleBounds().size();
+    size.set_height(std::min(size.height(), kLinkCardMaxHeight));
+    return PlaceLinkCard(anchor_.page, anchor_.link, anchor_.pointer_x, size,
+                         above_);
+  }
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    if (!widget_ || widget_->IsClosed()) {
+      return;
+    }
+    const float value = static_cast<float>(animation->GetCurrentValue());
+    widget_->SetOpacity(fade_in_ ? value : 1.0f - value);
+  }
+  void AnimationEnded(const gfx::Animation*) override {
+    if (!widget_ || widget_->IsClosed()) {
+      return;
+    }
+    if (fade_in_) {
+      widget_->SetOpacity(1.0f);
+    } else {
+      widget_->CloseNow();
+    }
+  }
+
+  views::Widget* widget() { return widget_; }
+  void ForgetWidget() { widget_ = nullptr; }
+
+ private:
+  void ApplyResult() {
+    last_apply_ = base::TimeTicks::Now();
+    contents_->SetResult(pending_title_, pending_summary_);
+    Fit();
+  }
+
+  void Fit() {
+    if (widget_ && !widget_->IsClosed()) {
+      SizeToContents();
+    }
+  }
+
+  LinkCardAnchor anchor_;
+  bool above_;
+  raw_ptr<Contents> contents_ = nullptr;
+  raw_ptr<views::Widget> widget_ = nullptr;
+  gfx::LinearAnimation fade_;
+  bool fade_in_ = true;
+  std::string pending_title_;
+  std::string pending_summary_;
+  base::TimeTicks last_apply_;
+  base::OneShotTimer height_timer_;
+};
+
+// static
+std::unique_ptr<LinkSummaryCard> LinkSummaryCard::Create(
+    views::Widget* parent,
+    const LinkCardAnchor& anchor,
+    const std::string& host) {
+  if (!parent) {
+    return nullptr;
+  }
+  std::unique_ptr<LinkSummaryCard> card(new LinkSummaryCard);
+  card->delegate_ = std::make_unique<Delegate>(anchor, host);
+  card->delegate_->set_parent_window(parent->GetNativeView());
+  card->widget_ = views::BubbleDialogDelegate::CreateBubble(
+      card->delegate_.get(), base::BindOnce(&LinkSummaryCard::OnWidgetClosed,
+                                            card->weak_factory_.GetWeakPtr()));
+  card->delegate_->Show(card->widget_.get());
+  return card;
+}
+
+LinkSummaryCard::LinkSummaryCard() = default;
+
+LinkSummaryCard::~LinkSummaryCard() {
+  if (delegate_) {
+    delegate_->ForgetWidget();
+  }
+  if (widget_ && !widget_->IsClosed()) {
+    widget_->CloseNow();
+  }
+}
+
+void LinkSummaryCard::OnWidgetClosed(views::Widget::ClosedReason reason) {
+  if (delegate_) {
+    delegate_->ForgetWidget();
+  }
+  closed_ = true;
+  // The widget is still on the stack that reported its closing.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<LinkSummaryCard> card) {
+                       if (card) {
+                         card->widget_.reset();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void LinkSummaryCard::ShowStatus(const std::string& text) {
+  if (!closed_) {
+    delegate_->ShowStatus(text);
+  }
+}
+
+void LinkSummaryCard::ShowResult(const std::string& title,
+                                 const std::string& summary,
+                                 bool streaming) {
+  if (!closed_) {
+    delegate_->ShowResult(title, summary, streaming);
+  }
+}
+
+void LinkSummaryCard::ShowError(const std::string& text,
+                                const std::string& detail) {
+  if (!closed_) {
+    delegate_->ShowError(text, detail);
+  }
+}
+
+void LinkSummaryCard::Dismiss(bool animate) {
+  if (!closed_) {
+    delegate_->Dismiss(animate);
+  }
+}
+
+bool LinkSummaryCard::ContainsScreenPoint(const gfx::Point& point) const {
+  return !closed_ && widget_->GetWindowBoundsInScreen().Contains(point);
+}
+
+gfx::Rect LinkSummaryCard::GetBoundsInScreen() const {
+  return closed_ ? gfx::Rect() : widget_->GetWindowBoundsInScreen();
+}
+
+bool LinkSummaryCard::IsVisible() const {
+  return !closed_ && widget_->IsVisible();
+}
+
+}  // namespace rac::ai

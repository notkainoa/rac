+
+#include "chrome/browser/ui/views/rac/ai/link_summary_controller.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/supports_user_data.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/ai/ai_service.h"
+#include "chrome/browser/rac/ai/ai_service_factory.h"
+#include "chrome/browser/rac/ai/chat_session.h"
+#include "chrome/browser/rac/ai/link_fetcher.h"
+#include "chrome/browser/rac/ai/link_summary.h"
+#include "chrome/browser/rac/ai/providers.h"
+#include "chrome/browser/ui/views/rac/ai/link_summary_card.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/display/screen.h"
+#include "ui/events/event.h"
+#include "ui/events/event_observer.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr base::TimeDelta kErrorLifetime = base::Seconds(4);
+constexpr base::TimeDelta kFadeOut = base::Milliseconds(120);
+constexpr size_t kMaxDetailChars = 140;
+
+const int kCacheKey = 0;
+
+// The summaries of one profile. They live as long as it does, in memory only.
+class CacheHolder : public base::SupportsUserData::Data {
+ public:
+  LinkSummaryCache cache;
+};
+
+LinkSummaryCache& CacheFor(Profile* profile) {
+  auto* holder = static_cast<CacheHolder*>(profile->GetUserData(&kCacheKey));
+  if (!holder) {
+    auto created = std::make_unique<CacheHolder>();
+    holder = created.get();
+    profile->SetUserData(&kCacheKey, std::move(created));
+  }
+  return holder->cache;
+}
+
+std::string DisplayHost(const GURL& url) {
+  std::string host(url.host());
+  if (host.starts_with("www.")) {
+    host.erase(0, 4);
+  }
+  return host;
+}
+
+std::string OneLine(const std::string& text) {
+  std::string line = text.substr(0, text.find('\n'));
+  base::TrimWhitespaceASCII(line, base::TRIM_ALL, &line);
+  if (line.size() > kMaxDetailChars) {
+    std::string cut;
+    base::TruncateUTF8ToByteSize(line, kMaxDetailChars, &cut);
+    line = cut + "…";
+  }
+  return line;
+}
+
+bool IsPrefixOfNoContent(const std::string& reply) {
+  const std::string trimmed(base::TrimWhitespaceASCII(reply, base::TRIM_ALL));
+  return !trimmed.empty() &&
+         std::string_view(kNoContentReply).starts_with(trimmed);
+}
+
+class Controller : public content::WebContentsObserver,
+                   public views::WidgetObserver,
+                   public ui::EventObserver {
+ public:
+  Controller(content::WebContents* source,
+             const GURL& link,
+             LinkTrigger trigger)
+      : content::WebContentsObserver(source),
+        link_(link),
+        trigger_(trigger),
+        profile_(Profile::FromBrowserContext(source->GetBrowserContext())) {}
+
+  ~Controller() override {
+    if (parent_) {
+      parent_->RemoveObserver(this);
+    }
+  }
+
+  bool Start(const gfx::Point& pointer) {
+    content::WebContents* source = web_contents();
+    parent_ =
+        views::Widget::GetTopLevelWidgetForNativeView(source->GetNativeView());
+    if (!parent_) {
+      return false;
+    }
+    LinkCardAnchor anchor;
+    anchor.page = source->GetContainerBounds();
+    anchor.link = gfx::Rect(pointer.x(), pointer.y() - 10, 1, 20);
+    anchor.pointer_x = pointer.x();
+    card_ = LinkSummaryCard::Create(parent_, anchor, DisplayHost(link_));
+    if (!card_) {
+      return false;
+    }
+    parent_->AddObserver(this);
+    monitor_ = views::EventMonitor::CreateApplicationMonitor(
+        this, parent_->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMousePressed,
+         ui::EventType::kMousewheel, ui::EventType::kScroll,
+         ui::EventType::kKeyPressed});
+    pointer_on_card_ = false;
+    on_link_ = true;
+
+    if (auto cached = CacheFor(profile_).Get(link_)) {
+      title_ = cached->title;
+      card_->ShowResult(title_, cached->summary, /*streaming=*/false);
+      return true;
+    }
+
+    Profile* original = profile_->GetOriginalProfile();
+    service_ = AiServiceFactory::GetForProfile(original);
+    if (!service_ ||
+        !FindProvider(original->GetPrefs()->GetString(kProvider))) {
+      ShowFailure(LinkFailure::kNoProvider,
+                  "Settings > Privacy and security > Assistant");
+      return true;
+    }
+    card_->ShowStatus("Reading page…");
+    fetcher_ = std::make_unique<LinkFetcher>(
+        original, link_,
+        base::BindOnce(&Controller::OnFetched, weak_factory_.GetWeakPtr()));
+    return true;
+  }
+
+  const GURL& link() const { return link_; }
+  LinkTrigger trigger() const { return trigger_; }
+  content::WebContents* source() { return web_contents(); }
+
+  void OnLinkTarget(const GURL& target) {
+    if (trigger_ != LinkTrigger::kHover) {
+      return;
+    }
+    on_link_ =
+        !target.is_empty() && LinkCacheKey(target) == LinkCacheKey(link_);
+    if (on_link_) {
+      grace_.Stop();
+    } else if (!pointer_on_card_ && !CursorOnCard()) {
+      StartGrace();
+    } else {
+      pointer_on_card_ = true;
+    }
+  }
+
+  void Dismiss(bool animate) {
+    if (dismissed_) {
+      return;
+    }
+    dismissed_ = true;
+    grace_.Stop();
+    error_timer_.Stop();
+    session_.reset();
+    fetcher_.reset();
+    if (card_) {
+      card_->Dismiss(animate);
+    }
+  }
+
+  bool dismissed() const { return dismissed_; }
+  bool animates() const { return card_ && card_->IsVisible(); }
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override { Close(false); }
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility == content::Visibility::HIDDEN) {
+      Close(false);
+    }
+  }
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+      Close(false);
+    }
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active && widget == parent_) {
+      Close(false);
+    }
+  }
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override {
+    Close(false);
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    parent_->RemoveObserver(this);
+    parent_ = nullptr;
+    Close(false);
+  }
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    switch (event.type()) {
+      case ui::EventType::kMouseMoved:
+        OnPointerMoved();
+        break;
+      case ui::EventType::kKeyPressed:
+        if (event.AsKeyEvent()->key_code() == ui::VKEY_ESCAPE) {
+          Close(true);
+        }
+        break;
+      case ui::EventType::kMousePressed:
+      case ui::EventType::kMousewheel:
+      case ui::EventType::kScroll:
+        Close(true);
+        break;
+      default:
+        break;
+    }
+  }
+
+  // Dismisses and has the owner delete this once the card has faded.
+  void Close(bool animate);
+
+ private:
+  bool CursorOnCard() const {
+    return card_ && card_->ContainsScreenPoint(
+                        display::Screen::Get()->GetCursorScreenPoint());
+  }
+
+  void OnPointerMoved() {
+    const bool on_card = CursorOnCard();
+    if (on_card) {
+      grace_.Stop();
+    } else if (pointer_on_card_ && !on_link_) {
+      StartGrace();
+    }
+    pointer_on_card_ = on_card;
+  }
+
+  void StartGrace() {
+    if (trigger_ == LinkTrigger::kHover && !grace_.IsRunning()) {
+      grace_.Start(
+          FROM_HERE, kLinkCardGrace,
+          base::BindOnce(&Controller::Close, base::Unretained(this), true));
+    }
+  }
+
+  void ShowFailure(LinkFailure failure, const std::string& detail) {
+    card_->ShowError(LinkFailureMessage(failure), detail);
+    // Errors go away on their own unless the pointer is resting on them.
+    error_timer_.Start(FROM_HERE, kErrorLifetime,
+                       base::BindOnce(
+                           [](Controller* self) {
+                             if (self->CursorOnCard()) {
+                               return;
+                             }
+                             self->Close(true);
+                           },
+                           base::Unretained(this)));
+  }
+
+  void OnFetched(LinkFetcher::Result result) {
+    if (dismissed_) {
+      return;
+    }
+    if (!result.has_value()) {
+      ShowFailure(result.error(), std::string());
+      return;
+    }
+    card_->ShowStatus("Summarizing…");
+    title_ = result->title.empty() ? DisplayHost(link_) : result->title;
+    session_ = std::make_unique<ChatSession>(
+        service_, BuildLinkSummaryRequest(std::move(*result)),
+        base::BindRepeating(&Controller::OnUpdate, weak_factory_.GetWeakPtr()));
+    session_->Start();
+  }
+
+  void OnUpdate(StreamUpdate update) {
+    if (dismissed_) {
+      return;
+    }
+    if (update.error) {
+      ShowFailure(LinkFailure::kProvider, OneLine(*update.error));
+      return;
+    }
+    reply_ += update.text_delta;
+    if (!update.done) {
+      const std::string summary = CleanSummary(reply_);
+      if (!summary.empty() && !IsPrefixOfNoContent(reply_)) {
+        card_->ShowResult(title_, summary, /*streaming=*/true);
+      }
+      return;
+    }
+    const std::string summary = CleanSummary(reply_);
+    if (summary.empty() || IsNoContentReply(reply_)) {
+      ShowFailure(LinkFailure::kNoText, std::string());
+      return;
+    }
+    CacheFor(profile_).Put(link_, {title_, summary});
+    card_->ShowResult(title_, summary, /*streaming=*/false);
+  }
+
+  const GURL link_;
+  const LinkTrigger trigger_;
+  raw_ptr<Profile> profile_;
+  raw_ptr<AiService> service_ = nullptr;
+  raw_ptr<views::Widget> parent_ = nullptr;
+  std::unique_ptr<LinkSummaryCard> card_;
+  std::unique_ptr<views::EventMonitor> monitor_;
+  std::unique_ptr<LinkFetcher> fetcher_;
+  std::unique_ptr<ChatSession> session_;
+  base::OneShotTimer grace_;
+  base::OneShotTimer error_timer_;
+  std::string title_;
+  std::string reply_;
+  bool pointer_on_card_ = false;
+  bool on_link_ = true;
+  bool dismissed_ = false;
+  base::WeakPtrFactory<Controller> weak_factory_{this};
+};
+
+std::unique_ptr<Controller>& Current() {
+  static base::NoDestructor<std::unique_ptr<Controller>> current;
+  return *current;
+}
+
+void ReleaseCurrent(Controller* controller, bool animate) {
+  auto& current = Current();
+  if (current.get() != controller) {
+    return;
+  }
+  const bool fade = animate && controller->animates();
+  controller->Dismiss(animate);
+  // The caller may be inside one of the controller's own callbacks.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce([](std::unique_ptr<Controller> doomed) {},
+                     std::move(current)),
+      fade ? kFadeOut : base::TimeDelta());
+}
+
+void Controller::Close(bool animate) {
+  ReleaseCurrent(this, animate);
+}
+
+}  // namespace
+
+bool ShouldOfferLinkSummary(content::BrowserContext* context,
+                            const GURL& link,
+                            const GURL& page) {
+  Profile* profile = Profile::FromBrowserContext(context);
+  return profile && IsAiEnabled(profile->GetOriginalProfile()->GetPrefs()) &&
+         IsSummarizableLink(link, page);
+}
+
+void SummarizeLink(content::WebContents* source,
+                   const GURL& link,
+                   const gfx::Point& pointer,
+                   LinkTrigger trigger) {
+  if (!source || !ShouldOfferLinkSummary(source->GetBrowserContext(), link,
+                                         source->GetLastCommittedURL())) {
+    return;
+  }
+  if (Controller* current = Current().get();
+      current && !current->dismissed() && current->source() == source &&
+      current->link() == link && current->trigger() == trigger) {
+    return;
+  }
+  DismissLinkSummary();
+  auto controller = std::make_unique<Controller>(source, link, trigger);
+  Controller* raw = controller.get();
+  Current() = std::move(controller);
+  if (!raw->Start(pointer)) {
+    ReleaseCurrent(raw, false);
+  }
+}
+
+void DismissLinkSummary() {
+  if (Controller* current = Current().get()) {
+    ReleaseCurrent(current, false);
+  }
+}
+
+void NotifyLinkTarget(content::WebContents* source, const GURL& target) {
+  Controller* current = Current().get();
+  if (current && !current->dismissed() && current->source() == source) {
+    current->OnLinkTarget(target);
+  }
+}
+
+}  // namespace rac::ai

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_LINK_SUMMARY_H_
+#define CHROME_BROWSER_RAC_AI_LINK_SUMMARY_H_
+
+#include <list>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/time/time.h"
+#include "chrome/browser/rac/ai/chat_protocol.h"
+#include "chrome/browser/rac/ai/page_text.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "url/gurl.h"
+
+namespace optimization_guide::proto {
+class AnnotatedPageContent;
+}
+
+namespace rac::ai {
+
+// How long Option has to be held with the pointer resting on a link.
+inline constexpr base::TimeDelta kLinkHoverDelay = base::Milliseconds(500);
+// How far the pointer may drift and still count as resting.
+inline constexpr int kLinkHoverSlop = 4;
+// How long the card stays after the pointer leaves the link and the card.
+inline constexpr base::TimeDelta kLinkCardGrace = base::Milliseconds(300);
+// The whole fetch, from navigation start to page text.
+inline constexpr base::TimeDelta kLinkFetchTimeout = base::Seconds(10);
+inline constexpr size_t kLinkPageTokens = 3000;
+inline constexpr int64_t kMaxLinkContentLength = 8 * 1024 * 1024;
+inline constexpr size_t kMaxSummaryBullets = 3;
+inline constexpr size_t kMaxSummaryBulletChars = 260;
+inline constexpr size_t kLinkSummaryCacheSize = 24;
+
+inline constexpr int kLinkCardWidth = 320;
+inline constexpr int kLinkCardMaxHeight = 220;
+inline constexpr int kLinkCardMargin = 12;
+inline constexpr int kLinkCardGap = 8;
+
+// Only http(s) pages that aren't another spot in `page` and don't look like a
+// file download. `page` may be empty.
+bool IsSummarizableLink(const GURL& link, const GURL& page);
+
+// Same document, ignoring the fragment.
+GURL LinkCacheKey(const GURL& link);
+
+bool IsOnlyOptionHeld(bool option, bool command, bool control, bool shift);
+bool IsPointerResting(int dx, int dy);
+
+// Whether a card of at most `kLinkCardMaxHeight` fits below the link inside
+// `page`. Decided once per card so it doesn't hop sides while it grows.
+bool ShouldPlaceAbove(const gfx::Rect& page, const gfx::Rect& link);
+
+// Where the card goes: with a gap below (or above) the link, left edge 24
+// points left of the pointer, clamped inside `page`. All rects are in the
+// same coordinate space.
+gfx::Rect PlaceLinkCard(const gfx::Rect& page,
+                        const gfx::Rect& link,
+                        int pointer_x,
+                        const gfx::Size& card,
+                        bool above);
+
+enum class LinkFailure {
+  kCantLoad,
+  kNoText,
+  kNeedsLogin,
+  kTimeout,
+  kProvider,
+  kNoProvider,
+};
+
+// The line the card shows. Provider failures add the provider's own reason
+// separately.
+std::string LinkFailureMessage(LinkFailure failure);
+
+// A page that asks for a password and says little else. Reading it privately
+// can't work because the real page is behind the sign-in.
+bool LooksLikeLoginWall(
+    const optimization_guide::proto::AnnotatedPageContent& page,
+    const PageText& text);
+
+// The request that asks the active provider for a short summary. The page is
+// attached the way chat attaches pages: in a nonce-delimited block.
+ChatRequest BuildLinkSummaryRequest(PageText page);
+
+// Marker the model is told to reply with when the page has nothing to read.
+inline constexpr char kNoContentReply[] = "NO_CONTENT";
+
+// Turns the model's reply, which may still be streaming, into at most three
+// plain bullets. Empty if there is nothing usable yet.
+std::string CleanSummary(std::string_view reply);
+bool IsNoContentReply(std::string_view reply);
+
+struct CachedLinkSummary {
+  std::string title;
+  std::string summary;
+};
+
+// A small in-memory least-recently-used cache of finished summaries. Never
+// written to disk.
+class LinkSummaryCache {
+ public:
+  explicit LinkSummaryCache(size_t capacity = kLinkSummaryCacheSize);
+  ~LinkSummaryCache();
+
+  std::optional<CachedLinkSummary> Get(const GURL& link);
+  void Put(const GURL& link, CachedLinkSummary summary);
+  void Clear();
+  size_t size() const { return entries_.size(); }
+
+ private:
+  using Order = std::list<std::string>;
+  struct Entry {
+    CachedLinkSummary summary;
+    Order::iterator position;
+  };
+
+  size_t capacity_;
+  Order order_;
+  std::map<std::string, Entry> entries_;
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_LINK_SUMMARY_H_

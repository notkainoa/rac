+    orb_ = status_row_->AddChildView(std::make_unique<Orb>());
+    status_label_ = status_row_->AddChildView(MakeLabel(
+        0, gfx::Font::Weight::NORMAL, ui::kColorLabelForegroundSecondary));
+    status_label_->SetMultiLine(false);
+    status_label_->SetVisible(true);
+    status_row_->SetVisible(false);

+#include "ui/views/event_monitor.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+namespace {
+
+bool IsModifierKey(ui::KeyboardCode code) {
+  switch (code) {
+    case ui::VKEY_MENU:
+    case ui::VKEY_LMENU:
+    case ui::VKEY_RMENU:
+    case ui::VKEY_SHIFT:
+    case ui::VKEY_LSHIFT:
+    case ui::VKEY_RSHIFT:
+    case ui::VKEY_CONTROL:
+    case ui::VKEY_LCONTROL:
+    case ui::VKEY_RCONTROL:
+    case ui::VKEY_COMMAND:
+    case ui::VKEY_RWIN:
+    case ui::VKEY_CAPITAL:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// Watches one link the pointer is resting on.
+class Watcher : public content::WebContentsObserver, public ui::EventObserver {
+ public:
+  Watcher(content::WebContents* source, const GURL& link)
+      : content::WebContentsObserver(source), link_(link) {
+    monitor_ = views::EventMonitor::CreateApplicationMonitor(
+        this, gfx::NativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMousePressed,
+         ui::EventType::kMousewheel, ui::EventType::kScroll,
+         ui::EventType::kKeyPressed, ui::EventType::kKeyReleased});
+    if (IsOnlyOptionHeldNow()) {
+      Arm();
+    }
+  }
+
+  const GURL& link() const { return link_; }
+  content::WebContents* source() { return web_contents(); }
+
+  void OnEvent(const ui::Event& event) override {
+    if (fired_) {
+      return;
+    }
+    if (event.IsKeyEvent()) {
+      const ui::KeyEvent* key = event.AsKeyEvent();
+      if (!IsModifierKey(key->key_code())) {
+        if (event.type() == ui::EventType::kKeyPressed) {
+          Disarm();
+        }
+        return;
+      }
+      const int flags = key->flags();
+      if (IsOnlyOptionHeld(flags & ui::EF_ALT_DOWN, flags & ui::EF_COMMAND_DOWN,
+                           flags & ui::EF_CONTROL_DOWN,
+                           flags & ui::EF_SHIFT_DOWN)) {
+        Arm();
+      } else {
+        Disarm();
+      }
+      return;
+    }
+    if (event.type() == ui::EventType::kMouseMoved) {
+      if (timer_.IsRunning()) {
+        const gfx::Point now = Cursor();
+        if (!IsPointerResting(now.x() - origin_.x(), now.y() - origin_.y())) {
+          Arm();
+        }
+      }
+      return;
+    }
+    Disarm();
+  }
+
+  void WebContentsDestroyed() override { Disarm(); }
+
+ private:
+  static gfx::Point Cursor() {
+    return display::Screen::Get()->GetCursorScreenPoint();
+  }
+
+  void Arm() {
+    origin_ = Cursor();
+    timer_.Start(FROM_HERE, kLinkHoverDelay,
+                 base::BindOnce(&Watcher::Fire, base::Unretained(this)));
+  }
+
+  void Disarm() { timer_.Stop(); }
+
+  void Fire() {
+    const gfx::Point now = Cursor();
+    if (!web_contents() || !IsOnlyOptionHeldNow() ||
+        !IsPointerResting(now.x() - origin_.x(), now.y() - origin_.y())) {
+      return;
+    }
+    fired_ = true;
+    SummarizeLink(web_contents(), link_, now, LinkTrigger::kHover);
+  }
+
+  const GURL link_;
+  std::unique_ptr<views::EventMonitor> monitor_;
+  base::OneShotTimer timer_;
+  gfx::Point origin_;
+  bool fired_ = false;
+};
+
+std::unique_ptr<Watcher>& CurrentWatcher() {
+  static base::NoDestructor<std::unique_ptr<Watcher>> watcher;
+  return *watcher;
+}
+
+}  // namespace
+
+void OnLinkTargetChanged(content::WebContents* source, const GURL& target) {
+  auto& watcher = CurrentWatcher();
+  if (target.is_empty()) {
+    watcher.reset();
+    NotifyLinkTarget(source, target);
+    return;
+  }
+  NotifyLinkTarget(source, target);
+  Profile* profile = Profile::FromBrowserContext(source->GetBrowserContext());
+  if (!profile || !IsAiEnabled(profile->GetOriginalProfile()->GetPrefs()) ||
+      !IsSummarizableLink(target, source->GetLastCommittedURL())) {
+    watcher.reset();
+    return;
+  }
+  if (watcher && watcher->source() == source && watcher->link() == target) {
+    return;
+  }
+  watcher = std::make_unique<Watcher>(source, target);
+}
+
+}  // namespace rac::ai

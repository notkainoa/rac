+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/link_fetcher.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_destroyer.h"
+#include "chrome/common/pref_names.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/optimization_guide/proto/features/common_quality_data.pb.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "third_party/blink/public/mojom/content_extraction/ai_page_content.mojom.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace rac::ai {
+namespace {
+
+bool IsReadableMimeType(const std::string& mime_type) {
+  return mime_type.empty() || mime_type == "text/html" ||
+         mime_type == "application/xhtml+xml" || mime_type == "text/plain";
+}
+
+}  // namespace
+
+LinkFetcher::LinkFetcher(Profile* profile, const GURL& url, Callback callback)
+    : callback_(std::move(callback)) {
+  otr_profile_ = profile->GetOriginalProfile()->GetOffTheRecordProfile(
+      Profile::OTRProfileID::CreateUnique("RacLinkSummary"),
+      /*create_if_needed=*/true);
+  profile_observation_.Observe(otr_profile_);
+
+  // The preferences of an off-the-record profile are its own, so these don't
+  // reach the user's profile. Page preferences take them over any per-site
+  // setting the user has.
+  PrefService* prefs = otr_profile_->GetPrefs();
+  prefs->SetBoolean(prefs::kWebKitJavascriptEnabled, false);
+  prefs->SetBoolean(prefs::kWebKitLoadsImagesAutomatically, false);
+  prefs->SetBoolean(prefs::kWebKitPluginsEnabled, false);
+  HostContentSettingsMapFactory::GetForProfile(otr_profile_)
+      ->SetDefaultContentSetting(ContentSettingsType::COOKIES,
+                                 CONTENT_SETTING_BLOCK);
+
+  content::WebContents::CreateParams params(otr_profile_);
+  web_contents_ = content::WebContents::Create(params);
+  web_contents_->SetDelegate(this);
+  web_contents_->SetAudioMuted(true);
+  web_contents_->Resize(gfx::Rect(0, 0, 1024, 768));
+  web_contents_->WasShown();
+  Observe(web_contents_.get());
+
+  timeout_.Start(
+      FROM_HERE, kLinkFetchTimeout,
+      base::BindOnce(&LinkFetcher::Finish, base::Unretained(this),
+                     Result(base::unexpected(LinkFailure::kTimeout))));
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PAGE_TRANSITION_LINK;
+  web_contents_->GetController().LoadURLWithParams(load);
+}
+
+LinkFetcher::~LinkFetcher() {
+  TearDown();
+}
+
+void LinkFetcher::ReadyToCommitNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (finished_ || !navigation_handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  if (!navigation_handle->GetURL().SchemeIsHTTPOrHTTPS()) {
+    Finish(base::unexpected(LinkFailure::kCantLoad));
+    return;
+  }
+  const net::HttpResponseHeaders* headers =
+      navigation_handle->GetResponseHeaders();
+  if (!headers) {
+    return;
+  }
+  std::string mime_type;
+  headers->GetMimeType(&mime_type);
+  if (!IsReadableMimeType(mime_type) ||
+      (headers->GetContentLength() &&
+       headers->GetContentLength()->InBytes() > kMaxLinkContentLength)) {
+    Finish(base::unexpected(LinkFailure::kNoText));
+  }
+}
+
+void LinkFetcher::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (finished_ || !navigation_handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  if (navigation_handle->IsDownload() || !navigation_handle->HasCommitted() ||
+      navigation_handle->IsErrorPage()) {
+    const bool timed_out =
+        navigation_handle->GetNetErrorCode() == net::ERR_TIMED_OUT;
+    Finish(base::unexpected(timed_out ? LinkFailure::kTimeout
+                                      : LinkFailure::kCantLoad));
+    return;
+  }
+  const net::HttpResponseHeaders* headers =
+      navigation_handle->GetResponseHeaders();
+  if (headers && headers->response_code() >= 400) {
+    Finish(base::unexpected(LinkFailure::kCantLoad));
+    return;
+  }
+  committed_ = true;
+}
+
+void LinkFetcher::DidStopLoading() {
+  if (committed_ && !finished_ && !extracting_) {
+    Extract();
+  }
+}
+
+void LinkFetcher::PrimaryMainFrameRenderProcessGone(
+    base::TerminationStatus status) {
+  Finish(base::unexpected(LinkFailure::kCantLoad));
+}
+
+void LinkFetcher::CanDownload(const GURL& url,
+                              const std::string& request_method,
+                              base::OnceCallback<void(bool)> callback) {
+  std::move(callback).Run(false);
+  Finish(base::unexpected(LinkFailure::kCantLoad));
+}
+
+void LinkFetcher::OnProfileWillBeDestroyed(Profile* profile) {
+  profile_observation_.Reset();
+  otr_profile_ = nullptr;
+  Finish(base::unexpected(LinkFailure::kCantLoad));
+  TearDown();
+}
+
+void LinkFetcher::Extract() {
+  extracting_ = true;
+  // Actionable mode is the one that reports geometry, which the hidden-text
+  // filter needs.
+  optimization_guide::GetAIPageContent(
+      web_contents_.get(),
+      optimization_guide::ActionableAIPageContentOptions(
+          /*on_critical_path=*/true),
+      base::BindOnce(&LinkFetcher::OnExtracted, weak_factory_.GetWeakPtr()));
+}
+
+void LinkFetcher::OnExtracted(
+    optimization_guide::AIPageContentResultOrError result) {
+  if (finished_) {
+    return;
+  }
+  if (!result.has_value()) {
+    Finish(base::unexpected(LinkFailure::kCantLoad));
+    return;
+  }
+  PageText text = SerializePageContent(result->proto, kLinkPageTokens);
+  if (LooksLikeLoginWall(result->proto, text)) {
+    Finish(base::unexpected(LinkFailure::kNeedsLogin));
+  } else if (text.text.empty()) {
+    Finish(base::unexpected(LinkFailure::kNoText));
+  } else {
+    Finish(std::move(text));
+  }
+}
+
+void LinkFetcher::Finish(Result result) {
+  if (finished_) {
+    return;
+  }
+  finished_ = true;
+  timeout_.Stop();
+  // The web contents may be the caller of this method, so it's destroyed
+  // from a task of its own.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&LinkFetcher::Deliver,
+                                weak_factory_.GetWeakPtr(), std::move(result)));
+}
+
+void LinkFetcher::Deliver(Result result) {
+  TearDown();
+  if (callback_) {
+    std::move(callback_).Run(std::move(result));
+  }
+}
+
+void LinkFetcher::TearDown() {
+  timeout_.Stop();
+  Observe(nullptr);
+  if (web_contents_) {
+    web_contents_->SetDelegate(nullptr);
+    web_contents_.reset();
+  }
+  if (otr_profile_) {
+    profile_observation_.Reset();
+    ProfileDestroyer::DestroyOTRProfileWhenAppropriate(
+        std::exchange(otr_profile_, nullptr).get());
+  }
+}
+
+}  // namespace rac::ai

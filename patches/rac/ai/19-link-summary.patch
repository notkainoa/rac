+    GetViewAccessibility().SetRole(ax::mojom::Role::kTooltip);
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+                         views::BoxLayout::Orientation::kVertical))
+        ->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kStretch);
+    SetBorder(views::CreatePaddedBorder(
+        views::CreateRoundedRectBorder(1, kRadius, ui::kColorMenuBorder),
+        gfx::Insets(kPadding - 1)));
+
+    auto* host_row = AddChildView(std::make_unique<views::View>());
+    host_row
+        ->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+            /*between_child_spacing=*/6))
+        ->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* icon = host_row->AddChildView(
+        std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+            vector_icons::kGlobeIcon, ui::kColorLabelForegroundSecondary,
+            kIconSize)));
+    icon->GetViewAccessibility().SetIsIgnored(true);
+    auto* host_label = host_row->AddChildView(MakeLabel(
+        -1, gfx::Font::Weight::NORMAL, ui::kColorLabelForegroundSecondary));
+    host_label->SetMultiLine(false);
+    host_label->SetText(ToUtf16(host));
+    host_label->SetVisible(true);
+    host_label->GetViewAccessibility().SetIsIgnored(true);
+
+    status_row_ = AddChildView(std::make_unique<views::View>());
+    status_row_
+        ->SetLayoutManager(std::make_unique<views::BoxLayout>(

+
+namespace rac::ai {
+
+enum class LinkTrigger {
+  kContextMenu,
+  kHover,
+};
+
+// Whether the link menu should offer "Summarize Link". False while the
+// assistant is off. Does no work beyond reading a preference in that case.
+bool ShouldOfferLinkSummary(content::BrowserContext* context,
+                            const GURL& link,
+                            const GURL& page);
+
+// Shows the link's summary in a card near `pointer` (screen coordinates),
+// replacing any card already up. Reads the page privately; see LinkFetcher.
+// Does nothing unless the assistant is on and `link` is an http(s) page.
+void SummarizeLink(content::WebContents* source,
+                   const GURL& link,
+                   const gfx::Point& pointer,
+                   LinkTrigger trigger);
+
+// Takes down the card, and cancels the read and the reply behind it.
+void DismissLinkSummary();
+
+// Tells a hover card whether the pointer is still on its link. `target` is
+// the link under the pointer, or empty.
+void NotifyLinkTarget(content::WebContents* source, const GURL& target);
+
+}  // namespace rac::ai

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/link_summary.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <utility>
+#include <vector>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/optimization_guide/proto/features/common_quality_data.pb.h"
+
+namespace rac::ai {
+namespace {
+
+namespace proto = optimization_guide::proto;
+
+constexpr size_t kMaxLinkLength = 2048;
+constexpr size_t kLoginWallTextBytes = 600;
+
+constexpr auto kNonPageExtensions = std::to_array<std::string_view>({
+    ".7z",  ".apk", ".avi",  ".bz2",  ".deb", ".dmg", ".exe", ".flac", ".gif",
+    ".gz",  ".ico", ".iso",  ".jpeg", ".jpg", ".m4a", ".mkv", ".mov",  ".mp3",
+    ".mp4", ".msi", ".pdf",  ".pkg",  ".png", ".rar", ".rpm", ".svg",  ".tar",
+    ".tgz", ".wav", ".webm", ".webp", ".xz",  ".zip",
+});
+
+constexpr char kSystemPrompt[] =
+    "You summarize one web page so a reader can decide whether to open it. "
+    "Reply with at most 3 short bullet points. Each bullet is one plain "
+    "sentence of under 25 words and starts with \"- \". Use no headings, no "
+    "bold or other markdown, and no introduction. State what the page is and "
+    "its main points. If the page has nothing readable, reply with exactly "
+    "NO_CONTENT.";
+
+bool HasNonPageExtension(const GURL& url) {
+  const std::string path = base::ToLowerASCII(url.path());
+  return std::ranges::any_of(kNonPageExtensions, [&](std::string_view ext) {
+    return path.ends_with(ext);
+  });
+}
+
+bool HasPasswordField(const proto::ContentNode& node, int depth) {
+  if (depth > 128) {
+    return false;
+  }
+  const auto& attributes = node.content_attributes();
+  if (attributes.has_form_control_data() &&
+      attributes.form_control_data().form_control_type() ==
+          proto::FORM_CONTROL_TYPE_INPUT_PASSWORD) {
+    return true;
+  }
+  return std::ranges::any_of(node.children_nodes(), [depth](const auto& child) {
+    return HasPasswordField(child, depth + 1);
+  });
+}
+
+std::string StripMarkdown(std::string_view line) {
+  std::string out(line);
+  for (std::string_view marker : {"**", "__", "`"}) {
+    base::ReplaceSubstringsAfterOffset(&out, 0, marker, "");
+  }
+  return out;
+}
+
+// Returns the text after a list marker, or nullopt if the line has none.
+std::optional<std::string_view> StripBullet(std::string_view line) {
+  if (line.size() >= 2 && (line[0] == '-' || line[0] == '*') &&
+      line[1] == ' ') {
+    return line.substr(2);
+  }
+  if (line.starts_with("• ")) {
+    return line.substr(std::string_view("• ").size());
+  }
+  size_t digits = 0;
+  while (digits < line.size() && base::IsAsciiDigit(line[digits])) {
+    ++digits;
+  }
+  if (digits > 0 && digits < 3 && digits + 1 < line.size() &&
+      (line[digits] == '.' || line[digits] == ')') && line[digits + 1] == ' ') {
+    return line.substr(digits + 2);
+  }
+  return std::nullopt;
+}
+
+std::string Ellipsize(std::string text) {
+  if (text.size() <= kMaxSummaryBulletChars) {
+    return text;
+  }
+  std::string cut;
+  base::TruncateUTF8ToByteSize(text, kMaxSummaryBulletChars, &cut);
+  base::TrimWhitespaceASCII(cut, base::TRIM_TRAILING, &cut);
+  return cut + "…";
+}
+
+}  // namespace
+
+bool IsSummarizableLink(const GURL& link, const GURL& page) {
+  if (!link.is_valid() || !link.SchemeIsHTTPOrHTTPS() || !link.has_host() ||
+      link.spec().size() > kMaxLinkLength || link.has_username() ||
+      link.has_password()) {
+    return false;
+  }
+  if (!page.is_empty() && link.has_ref() &&
+      LinkCacheKey(link) == LinkCacheKey(page)) {
+    return false;
+  }
+  return !HasNonPageExtension(link);
+}
+
+GURL LinkCacheKey(const GURL& link) {
+  if (!link.has_ref()) {
+    return link;
+  }
+  GURL::Replacements replacements;
+  replacements.ClearRef();
+  return link.ReplaceComponents(replacements);
+}
+
+bool IsOnlyOptionHeld(bool option, bool command, bool control, bool shift) {
+  return option && !command && !control && !shift;
+}
+
+bool IsPointerResting(int dx, int dy) {
+  return std::abs(dx) <= kLinkHoverSlop && std::abs(dy) <= kLinkHoverSlop;
+}
+
+bool ShouldPlaceAbove(const gfx::Rect& page, const gfx::Rect& link) {
+  const int below =
+      page.bottom() - kLinkCardMargin - link.bottom() - kLinkCardGap;
+  const int above = link.y() - kLinkCardGap - kLinkCardMargin - page.y();
+  return below < kLinkCardMaxHeight && above > below;
+}
+
+gfx::Rect PlaceLinkCard(const gfx::Rect& page,
+                        const gfx::Rect& link,
+                        int pointer_x,
+                        const gfx::Size& card,
+                        bool above) {
+  const int width = std::min(card.width(), page.width() - 2 * kLinkCardMargin);
+  const int height =
+      std::min(card.height(), page.height() - 2 * kLinkCardMargin);
+  const int min_x = page.x() + kLinkCardMargin;
+  const int max_x = std::max(min_x, page.right() - kLinkCardMargin - width);
+  const int x = std::clamp(pointer_x - 24, min_x, max_x);
+  int y =
+      above ? link.y() - kLinkCardGap - height : link.bottom() + kLinkCardGap;
+  const int min_y = page.y() + kLinkCardMargin;
+  const int max_y = std::max(min_y, page.bottom() - kLinkCardMargin - height);
+  y = std::clamp(y, min_y, max_y);
+  return gfx::Rect(x, y, std::max(width, 0), std::max(height, 0));
+}
+
+std::string LinkFailureMessage(LinkFailure failure) {
+  switch (failure) {
+    case LinkFailure::kCantLoad:
+      return "Couldn't open this page.";
+    case LinkFailure::kNoText:
+      return "This page has no text to summarize.";
+    case LinkFailure::kNeedsLogin:
+      return "This page needs you to sign in, so it can't be read privately.";
+    case LinkFailure::kTimeout:
+      return "This page took too long to load.";
+    case LinkFailure::kProvider:
+      return "The assistant couldn't respond.";
+    case LinkFailure::kNoProvider:
+      return "Set up a direct provider for link summaries.";
+  }
+}
+
+bool LooksLikeLoginWall(const proto::AnnotatedPageContent& page,
+                        const PageText& text) {
+  return text.text.size() < kLoginWallTextBytes &&
+         HasPasswordField(page.root_node(), 0);
+}
+
+ChatRequest BuildLinkSummaryRequest(PageText page) {
+  ChatRequest request;
+  request.system_prompt = kSystemPrompt;
+  request.messages.push_back(
+      {ChatMessage::Role::kUser, "Summarize this page in at most 3 bullets."});
+  request.pages.push_back(std::move(page));
+  return request;
+}
+
+bool IsNoContentReply(std::string_view reply) {
+  return base::TrimWhitespaceASCII(reply, base::TRIM_ALL)
+      .starts_with(kNoContentReply);
+}
+
+std::string CleanSummary(std::string_view reply) {
+  std::vector<std::string> items;
+  bool bulleted = false;
+  for (std::string_view raw : base::SplitStringPiece(
+           reply, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::string_view line = raw;
+    while (!line.empty() && line.front() == '#') {
+      line.remove_prefix(1);
+    }
+    line = base::TrimWhitespaceASCII(line, base::TRIM_LEADING);
+    if (auto stripped = StripBullet(line)) {
+      bulleted = true;
+      line = *stripped;
+    }
+    std::string text = StripMarkdown(line);
+    text = std::string(base::CollapseWhitespaceASCII(text, false));
+    if (text.empty()) {
+      continue;
+    }
+    items.push_back(std::move(text));
+    if (items.size() == kMaxSummaryBullets) {
+      break;
+    }
+  }
+  const bool use_bullets = bulleted || items.size() > 1;
+  std::string out;
+  for (std::string& item : items) {
+    if (!out.empty()) {
+      out += '\n';
+    }
+    out += base::StrCat({use_bullets ? "• " : "", Ellipsize(std::move(item))});
+  }
+  return out;
+}
+
+LinkSummaryCache::LinkSummaryCache(size_t capacity) : capacity_(capacity) {}
+LinkSummaryCache::~LinkSummaryCache() = default;
+
+std::optional<CachedLinkSummary> LinkSummaryCache::Get(const GURL& link) {
+  auto found = entries_.find(LinkCacheKey(link).spec());
+  if (found == entries_.end()) {
+    return std::nullopt;
+  }
+  order_.splice(order_.begin(), order_, found->second.position);
+  return found->second.summary;
+}
+
+void LinkSummaryCache::Put(const GURL& link, CachedLinkSummary summary) {
+  const std::string key = LinkCacheKey(link).spec();
+  auto found = entries_.find(key);
+  if (found != entries_.end()) {
+    found->second.summary = std::move(summary);
+    order_.splice(order_.begin(), order_, found->second.position);
+    return;
+  }
+  order_.push_front(key);
+  entries_.emplace(key, Entry{std::move(summary), order_.begin()});
+  while (entries_.size() > capacity_) {
+    entries_.erase(order_.back());
+    order_.pop_back();
+  }
+}
+
+void LinkSummaryCache::Clear() {
+  entries_.clear();
+  order_.clear();
+}
+
+}  // namespace rac::ai

+bool Approves(std::string_view agent, std::string_view json) {
+  auto tool = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  CHECK(tool);
+  const std::vector<std::string> advertised = {"rac_echo", "snapshot", "click"};
+  return IsApprovedRacMcpTool(agent, *tool, advertised);
+}

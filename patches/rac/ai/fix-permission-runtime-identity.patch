+    "toolName":"mcp__rac__rac_echo_evil","mcpServer":{"name":"rac"}}}})"));
+  EXPECT_FALSE(Approves("claude", R"({"kind":"other","_meta":{"claudeCode":{
+    "toolName":"mcp__other__rac_echo","mcpServer":{"name":"rac"}}}})"));
+  EXPECT_FALSE(Approves("codex", R"({"kind":"execute","rawInput":{
+    "server":"other","tool":"rac_echo"},"_meta":{"is_mcp_tool_call":true}})"));
+  EXPECT_FALSE(Approves("codex", R"({"kind":"execute","rawInput":{
+    "server":"rac","tool":"unknown"},"_meta":{"is_mcp_tool_call":true}})"));
+  EXPECT_FALSE(Approves("codex", R"({"kind":"edit","rawInput":{
+    "server":"rac","tool":"rac_echo"},"_meta":{"is_mcp_tool_call":true}})"));
+  EXPECT_FALSE(Approves("cursor", R"({"kind":"execute","rawInput":{
+    "server":"rac","tool":"rac_echo"},"_meta":{"is_mcp_tool_call":true}})"));

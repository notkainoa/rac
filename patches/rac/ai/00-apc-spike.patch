+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/ai/page_context.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "components/optimization_guide/content/browser/page_content_proto_provider.h"
+#include "components/optimization_guide/proto/features/common_quality_data.pb.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/content_extraction/ai_page_content.mojom.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr size_t kMaximumPageTextBytes = 32 * 1024;
+
+void AppendText(const optimization_guide::proto::ContentNode& node,
+                std::string& output) {
+  if (output.size() >= kMaximumPageTextBytes) {
+    return;
+  }
+  if (node.content_attributes().has_text_data()) {
+    const std::string& text =
+        node.content_attributes().text_data().text_content();
+    output.append(text, 0, std::min(text.size(),
+                                    kMaximumPageTextBytes - output.size()));
+    if (output.size() < kMaximumPageTextBytes) {
+      output.push_back('\n');
+    }
+  }
+  for (const auto& child : node.children_nodes()) {
+    AppendText(child, output);
+  }
+}
+
+void OnPageContent(base::OnceCallback<void(PageTextResult)> callback,
+                   optimization_guide::AIPageContentResultOrError result) {
+  if (!result.has_value()) {
+    std::move(callback).Run(base::unexpected(std::move(result.error())));
+    return;
+  }
+  std::string text;
+  AppendText(result->proto.root_node(), text);
+  std::move(callback).Run(base::ok(std::move(text)));
+}
+
+}  // namespace
+
+void ExtractPageText(content::WebContents* contents,
+                     base::OnceCallback<void(PageTextResult)> callback) {
+  if (!contents) {
+    std::move(callback).Run(base::unexpected("No page to read"));
+    return;
+  }
+  optimization_guide::GetAIPageContent(
+      contents,
+      optimization_guide::DefaultAIPageContentOptions(
+          /*on_critical_path=*/true),
+      base::BindOnce(&OnPageContent, std::move(callback)));
+}
+
+}  // namespace rac::ai

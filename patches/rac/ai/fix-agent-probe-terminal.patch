+std::vector<std::string> LoginShellArgv(std::string_view shell,
+                                        std::string_view script) {
+  const std::string name = base::FilePath(shell).BaseName().value();
+  if (name == "zsh" || name == "bash") {
+    // An interactive shell with job control tries to take the terminal rac was
+    // started from. From its own process group it is then stopped by SIGTTOU
+    // or SIGTTIN and never prints. `+m` turns job control off.
+    return {std::string(shell), "-i", "+m", "-l", "-c", std::string(script)};
+  }
+  return {std::string(shell), "-l", "-c", std::string(script)};
+}

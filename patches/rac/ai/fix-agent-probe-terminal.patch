+// Reads `streams` until every one of them closes, the first one contains
+// `done_marker` (if not empty), or `deadline` passes, without ever blocking
+// past the deadline. Returns false on timeout. A child that
+// stops (for example on SIGTTOU) keeps its pipes open, so a blocking read()
+// here would never return.
+bool CollectOutput(
+    std::vector<std::pair<base::ScopedFD*, std::string*>> streams,
+    base::TimeTicks deadline,
+    std::string_view done_marker = {}) {
+  char buffer[4096];
+  for (auto& [fd, out] : streams) {
+    if (fd->is_valid() && !base::SetNonBlocking(fd->get())) {
+      fd->reset();
+    }
+  }
+  for (;;) {
+    std::vector<pollfd> polls;
+    std::vector<size_t> owners;
+    for (size_t i = 0; i < streams.size(); ++i) {
+      if (streams[i].first->is_valid()) {
+        polls.push_back({streams[i].first->get(), POLLIN, 0});
+        owners.push_back(i);
+      }
+    }
+    if (polls.empty() || (!done_marker.empty() &&
+                          streams[0].second->find(done_marker) !=
+                              std::string::npos)) {
+      return true;
+    }
+    const base::TimeDelta left = deadline - base::TimeTicks::Now();
+    if (!left.is_positive()) {
+      return false;
+    }
+    const int ready =
+        poll(polls.data(), polls.size(),
+             static_cast<int>(std::max<int64_t>(1, left.InMilliseconds())));
+    if (ready < 0 && errno != EINTR) {
+      return false;
+    }
+    for (size_t i = 0; ready > 0 && i < polls.size(); ++i) {
+      if (!polls[i].revents) {
+        continue;
+      }
+      auto& [fd, out] = streams[owners[i]];
+      const ssize_t got = HANDLE_EINTR(read(fd->get(), buffer, sizeof(buffer)));
+      if (got > 0) {
+        if (out->size() < 64 * 1024) {
+          out->append(buffer, static_cast<size_t>(got));
+        }
+      } else if (got == 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
+        fd->reset();
+      }
+    }
+  }
+}

+// Finding agents asks the login shell for its PATH, which can take seconds.
+// The menu doesn't wait that long for them: provider models show at once, and
+// the agents appear the next time the menu opens.
+const AGENT_WAIT_MS = 600;
+
+async function agentsForMenu(): Promise<AgentInfo[]|null> {
+  const listing = listAgents();
+  if (agentInfos.size > 0) {
+    return [...agentInfos.values()];
+  }
+  return Promise.race([
+    listing,
+    new Promise<null>(resolve => setTimeout(() => resolve(null), AGENT_WAIT_MS)),
+  ]);
+}

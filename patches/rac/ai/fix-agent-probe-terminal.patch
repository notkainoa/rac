Index: src/chrome/browser/rac/ai/acp/agent_path_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/ai/acp/agent_path_unittest.cc
@@ -0,0 +1,40 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/ai/acp/agent_path.h"
+
+#include <string>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::ai {
+namespace {
+
+using Argv = std::vector<std::string>;
+
+TEST(LoginShellArgvTest, ZshAndBashRunInteractiveWithoutJobControl) {
+  EXPECT_EQ(LoginShellArgv("/bin/zsh", "echo"),
+            (Argv{"/bin/zsh", "-i", "+m", "-l", "-c", "echo"}));
+  EXPECT_EQ(LoginShellArgv("/opt/homebrew/bin/bash", "echo"),
+            (Argv{"/opt/homebrew/bin/bash", "-i", "+m", "-l", "-c", "echo"}));
+}
+
+TEST(LoginShellArgvTest, OtherShellsRunAsPlainLoginShells) {
+  EXPECT_EQ(LoginShellArgv("/opt/homebrew/bin/fish", "echo"),
+            (Argv{"/opt/homebrew/bin/fish", "-l", "-c", "echo"}));
+  EXPECT_EQ(LoginShellArgv("/bin/sh", "echo"),
+            (Argv{"/bin/sh", "-l", "-c", "echo"}));
+}
+
+TEST(LoginShellArgvTest, NeverAsksForJobControl) {
+  for (const char* shell : {"/bin/zsh", "/bin/bash", "/bin/ksh", "/bin/tcsh"}) {
+    for (const std::string& arg : LoginShellArgv(shell, "x")) {
+      EXPECT_NE(arg, "-ilc") << shell;
+      EXPECT_NE(arg, "-m") << shell;
+    }
+  }
+}
+
+}  // namespace
+}  // namespace rac::ai

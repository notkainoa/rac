+TEST(RacProviderListTest, EveryRowHasItsOwnShortBadge) {
+  // Every agent rac knows, none found, and every direct provider.
+  const base::ListValue value = ProviderListToValue(BuildProviderList(
+      {.agents = NoneFound(), .direct_provider = "openai", .agent = ""}));
+  std::set<std::string> seen;
+  size_t rows = 0;
+  for (const base::Value& group : value) {
+    for (const base::Value& row : *group.GetDict().FindList("rows")) {
+      const std::string* id = row.GetDict().FindString("id");
+      const std::string* badge = row.GetDict().FindString("badge");
+      ASSERT_TRUE(id);
+      ASSERT_TRUE(badge) << *id;
+      EXPECT_FALSE(badge->empty()) << *id;
+      EXPECT_LE(base::UTF8ToUTF16(*badge).size(), 2u) << *id;
+      EXPECT_TRUE(seen.insert(*badge).second)
+          << *id << " repeats the badge " << *badge;
+      ++rows;
+    }
+  }
+  EXPECT_EQ(rows, NoneFound().size() + GetProviders().size());
+}
+
+TEST(RacProviderListTest, TheBadgeIsAnAccessorOnTheRow) {
+  EXPECT_EQ(ProviderBadge("codex", true), "Cx");
+  EXPECT_EQ(ProviderBadge("claude", true), "Cl");
+  EXPECT_EQ(ProviderBadge("cursor", true), "Cu");
+  EXPECT_EQ(ProviderBadge("copilot", true), "Co");
+  // An agent and a direct provider with the same id still differ.
+  EXPECT_NE(ProviderBadge("gemini", true), ProviderBadge("gemini", false));
+  EXPECT_NE(ProviderBadge("custom", true), ProviderBadge("custom", false));
+  EXPECT_EQ(ProviderBadge("made-up", true), "");
+  EXPECT_EQ(ProviderBadge("made-up", false), "");
+}
+
 }  // namespace

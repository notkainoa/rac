+struct Badge {
+  std::string_view id;
+  std::string_view badge;
+};
+
+// The mark on each row: two letters, never a vendor logo. An agent and a
+// direct provider can share an id ("gemini", "custom"), so they have their
+// own tables, and no two marks in the whole list are the same.
+constexpr Badge kAgentBadges[] = {
+    {"codex", "Cx"},  {"claude", "Cl"},     {"cursor", "Cu"},
+    {"gemini", "Ge"}, {"copilot", "Co"},    {"opencode", "Oc"},
+    {"goose", "Go"},  {kCustomAgent, ">_"},
+};
+constexpr Badge kProviderBadges[] = {
+    {"openai", "Oa"},     {"anthropic", "An"}, {"gemini", "Gm"},
+    {"openrouter", "Or"}, {"custom", "{}"},    {"ollama", "Ol"},
+    {"lmstudio", "Lm"},
+};
+
+template <size_t N>
+std::string_view FindBadge(const Badge (&table)[N], std::string_view id) {
+  for (const Badge& entry : table) {
+    if (entry.id == id) {
+      return entry.badge;
+    }
+  }
+  return std::string_view();
+}
+
 }  // namespace
 
+std::string_view ProviderBadge(std::string_view id, bool is_agent) {
+  return is_agent ? FindBadge(kAgentBadges, id)
+                  : FindBadge(kProviderBadges, id);
+}

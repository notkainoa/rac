+    row.Set("name", recipe.name);
+    row.Set("kind", "agent");
+    row.Set("authHelp", recipe.auth_help);
+    row.Set("selected", rows.selected == recipe.id);
+    bool installed = false;
+    if (std::string_view(recipe.id) == "custom") {
+      row.Set("command", rows.custom_command);
+      const auto& argv = rows.custom_argv;
+      installed = !argv.empty() && argv[0][0] == '/' &&
+                  access(argv[0].c_str(), X_OK) == 0;
+      if (!argv.empty()) {
+        row.Set("path", argv[0]);
+      }
+    } else {
+      // The override names the agent's own program. The npx adapters are
+      // always found on PATH.
+      const base::FilePath& override_path = rows.overrides[recipe.id];
+      if (!override_path.empty()) {
+        row.Set("override", override_path.value());
+      }
+      base::FilePath resolved =
+          recipe.uses_npx ? base::FilePath() : override_path;
+      if (resolved.empty() && !search_path.empty()) {

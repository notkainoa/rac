+void AcpService::EndRun(RunId id, std::string error) {
+  if (!run_ || run_->id != id) {
+    return;
+  }
+  // Take the run first, so whatever runs from here (the client finishing its
+  // turn, the page reacting to `done`) finds no run to end again.
+  std::unique_ptr<Run> run = std::move(run_);
+  TeardownSession();
+  if (run->on_update) {
+    StreamUpdate update;
+    update.done = true;
+    if (!error.empty()) {
+      update.error = error;
+    }
+    run->on_update.Run(std::move(update));
+  }
+  if (run->done) {
+    std::move(run->done).Run(std::move(error));
+  }
+  // The MCP server is stopped, so nothing reaches the provider again. Delete
+  // it later anyway: a tool call that ended the run may still be on the
+  // stack.
+  if (run->tools) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(run->tools));
   }
 }
 

+      if (recipe.uses_npx) {
+        base::FilePath cli = override_path;
+        if (cli.empty() && !search_path.empty()) {
+          cli = FindExecutableOnPath(recipe.id, search_path);
+        }
+        const bool cli_runs =
+            !cli.empty() && access(cli.value().c_str(), X_OK) == 0;
+        const bool needs_node = resolved.empty();
+        if (!cli.empty()) {
+          row.Set("path", cli.value());
+        }
+        row.Set("needsNode", cli_runs && needs_node);
+        installed = cli_runs && !needs_node;
+      } else if (!resolved.empty()) {
+        installed = access(resolved.value().c_str(), X_OK) == 0;
+        row.Set("path", resolved.value());
+      }
+    }
+    row.Set("installed", installed);
+    if (!error.empty()) {
+      row.Set("probeError", error);
+    }

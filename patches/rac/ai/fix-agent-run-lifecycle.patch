+      echo '{"id":1,"jsonrpc":"2.0","result":{"protocolVersion":1}}' ;;
+    *'"method":"session/new"'*)
+      echo '{"id":2,"jsonrpc":"2.0","result":{"sessionId":"s1"}}' ;;
+    *'"method":"session/prompt"'*)
+      printf '%s%s%s\n' '{"jsonrpc":"2.0","method":"session/update",' \
+        '"params":{"sessionId":"s1","update":{"content":{"text":"hi",' \
+        '"type":"text"},"sessionUpdate":"agent_message_chunk"}}}'
+      echo '{"id":3,"jsonrpc":"2.0","result":{"stopReason":"end_turn"}}' ;;
+  esac
+done
+)";
+
+// The echo tools, with a way to see that the run let go of them.
+class TrackedTools : public rac::agent::EchoMcpToolProvider {
+ public:
+  explicit TrackedTools(bool* deleted) : deleted_(deleted) {}
+  ~TrackedTools() override { *deleted_ = true; }
+
+ private:
+  raw_ptr<bool> deleted_;
+};
+
+bool CanConnect(const std::string& path) {
+  base::ScopedFD fd(HANDLE_EINTR(socket(AF_UNIX, SOCK_STREAM, 0)));
+  sockaddr_un addr = {};
+  addr.sun_family = AF_UNIX;
+  if (!fd.is_valid() || path.size() >= sizeof(addr.sun_path)) {
+    return false;
+  }
+  std::memcpy(addr.sun_path, path.data(), path.size());
+  return HANDLE_EINTR(connect(fd.get(), reinterpret_cast<sockaddr*>(&addr),
+                              sizeof(addr))) == 0;
+}
+
+struct Result {
+  bool finished = false;
+  std::string error;
+  std::string text;
+};
+
+class AcpServiceTest : public testing::Test {
+ public:
+  AcpServiceTest() {
+    CHECK(temp_.CreateUniqueTempDir());
+    log_ = temp_.GetPath().AppendASCII("log");
+    CHECK(base::CreateDirectory(log_));
+    const base::FilePath agent = temp_.GetPath().AppendASCII("agent.sh");
+    CHECK(base::WriteFile(agent, kFakeAgent));
+    CHECK(base::SetPosixFilePermissions(agent, 0700));
+    RegisterProfilePrefs(prefs_.registry());
+    prefs_.SetBoolean(kEnabled, true);
+    prefs_.SetString(kAgentId, "custom");
+    prefs_.SetString(kAgentCustomCommand, agent.value() + " " + log_.value());
+    service_ = std::make_unique<AcpService>(
+        &prefs_, temp_.GetPath().AppendASCII("profile"));
+    service_->SetSearchPathForTesting("/usr/bin:/bin");
+  }
+
+  ~AcpServiceTest() override {
+    service_.reset();
+    env_.RunUntilIdle();
+  }
+
+  AcpService::RunId Prompt(
+      std::string text,
+      Result* result,
+      std::unique_ptr<rac::agent::McpToolProvider> tools = nullptr,
+      base::OnceClosure quit = base::DoNothing()) {
+    return service_->Prompt(
+        "custom", std::move(text), std::move(tools),
+        base::BindLambdaForTesting([result](StreamUpdate update) {
+          result->text += update.text_delta;
+        }),
+        base::DoNothing(),
+        base::BindOnce(
+            [](Result* result, base::OnceClosure quit, std::string error) {
+              EXPECT_FALSE(result->finished) << "done ran twice";
+              result->finished = true;
+              result->error = std::move(error);
+              std::move(quit).Run();
+            },
+            result, std::move(quit)));
+  }
+
+  std::string ReadLog(std::string_view name) {
+    std::string text;
+    base::ReadFileToString(log_.AppendASCII(name), &text);
+    return text;
+  }
+
+  // Waits for `done` to become true while the agent's threads work.
+  void WaitFor(base::RepeatingCallback<bool()> done) {
+    for (int i = 0; i < 500 && !done.Run(); ++i) {
+      env_.RunUntilIdle();
+      base::PlatformThread::Sleep(base::Milliseconds(10));
+    }
+  }
+
+  base::test::TaskEnvironment env_;
+  base::ScopedTempDir temp_;
+  base::FilePath log_;
+  TestingPrefServiceSimple prefs_;
+  std::unique_ptr<AcpService> service_;
+};
+
+TEST_F(AcpServiceTest, RunsOnePrompt) {
+  Result result;
+  base::RunLoop loop;
+  Prompt("hello agent", &result, nullptr, loop.QuitClosure());
+  loop.Run();
+  EXPECT_EQ(result.error, "");
+  EXPECT_EQ(result.text, "hi");
+  EXPECT_NE(ReadLog("in").find("hello agent"), std::string::npos);
+}
+
+// Stop while the launch is still on its way must keep the prompt, and any
+// page text in it, from ever reaching the agent.
+TEST_F(AcpServiceTest, StopDuringLaunchSendsNothing) {
+  Result result;
+  const AcpService::RunId run = Prompt("stopped prompt", &result);
+  service_->Stop(run);
+  EXPECT_TRUE(result.finished);
+  EXPECT_EQ(result.error, "Cancelled");
+  // Let every launch stage that was already posted run out.
+  for (int i = 0; i < 50; ++i) {
+    env_.RunUntilIdle();
+    base::PlatformThread::Sleep(base::Milliseconds(10));
+  }
+  EXPECT_FALSE(base::PathExists(log_.AppendASCII("pid")));
+  EXPECT_EQ(ReadLog("in").find("stopped prompt"), std::string::npos);
+}
+
+// A newer run replaces one that is still launching. The old prompt is never
+// sent, the old run ends once with its own error, and only the new run's
+// `done` reports the new prompt.
+TEST_F(AcpServiceTest, NewerRunEndsTheLaunchingOne) {
+  Result first;
+  Result second;
+  base::RunLoop loop;
+  Prompt("first prompt", &first);
+  Prompt("second prompt", &second, nullptr, loop.QuitClosure());
+  EXPECT_TRUE(first.finished);
+  EXPECT_EQ(first.error, AcpService::kSupersededError);
+  loop.Run();
+  EXPECT_EQ(second.error, "");
+  EXPECT_EQ(second.text, "hi");
+  EXPECT_EQ(first.text, "");
+  const std::string in = ReadLog("in");
+  EXPECT_EQ(in.find("first prompt"), std::string::npos);
+  EXPECT_NE(in.find("second prompt"), std::string::npos);
+}
+
+// Stopping an older run does nothing to the current one: a page can only
+// stop its own run.
+TEST_F(AcpServiceTest, StopOfAnOlderRunIsIgnored) {
+  Result first;
+  Result second;
+  base::RunLoop loop;
+  const AcpService::RunId old_run = Prompt("first prompt", &first);
+  Prompt("second prompt", &second, nullptr, loop.QuitClosure());
+  service_->Stop(old_run);
+  EXPECT_FALSE(second.finished);
+  loop.Run();
+  EXPECT_EQ(second.error, "");
+}
+
+// When a run ends, its MCP server stops listening, its agent exits, and its
+// tools are deleted. Nothing can reach a provider after its run.
+TEST_F(AcpServiceTest, RunEndTakesTheServerAgentAndToolsWithIt) {
+  bool tools_deleted = false;
+  Result result;
+  base::RunLoop loop;
+  Prompt("use the tools", &result,
+         std::make_unique<TrackedTools>(&tools_deleted), loop.QuitClosure());
+  loop.Run();
+  ASSERT_EQ(result.error, "");
+
+  // The socket the agent was told about, from its session/new request.
+  std::string socket;
+  const std::string in = ReadLog("in");
+  for (std::string_view line : base::SplitStringPiece(
+           in, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::optional<base::Value> value =
+        base::JSONReader::Read(line, base::JSON_PARSE_RFC);
+    const base::DictValue* params = value && value->is_dict()
+                                        ? value->GetDict().FindDict("params")
+                                        : nullptr;
+    const base::ListValue* servers =
+        params ? params->FindList("mcpServers") : nullptr;
+    if (servers && !servers->empty()) {
+      const base::ListValue* args = (*servers)[0].GetDict().FindList("args");
+      ASSERT_TRUE(args);
+      ASSERT_EQ(args->size(), 2u);
+      socket = (*args)[1].GetString();
+    }
+  }
+  ASSERT_FALSE(socket.empty());
+
+  WaitFor(base::BindLambdaForTesting(
+      [&] { return tools_deleted && !CanConnect(socket); }));
+  EXPECT_TRUE(tools_deleted);
+  EXPECT_FALSE(CanConnect(socket));
+
+  int pid = 0;
+  std::string pid_text;
+  base::TrimWhitespaceASCII(ReadLog("pid"), base::TRIM_ALL, &pid_text);
+  ASSERT_TRUE(base::StringToInt(pid_text, &pid));
+  WaitFor(base::BindLambdaForTesting([&] { return kill(pid, 0) != 0; }));
+  EXPECT_NE(kill(pid, 0), 0);
+}

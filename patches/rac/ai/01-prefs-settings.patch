+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/rac_ai_handler.h"
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/ai/ai_service.h"
+#include "chrome/browser/rac/ai/ai_service_factory.h"
+#include "chrome/browser/rac/ai/providers.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_ui.h"
+#include "url/gurl.h"
+
+namespace settings {
+namespace {
+
+constexpr size_t kMaxKeyLength = 4096;
+constexpr size_t kMaxFieldLength = 512;
+
+}  // namespace
+
+RacAiHandler::RacAiHandler(Profile* profile) : profile_(profile) {}
+RacAiHandler::~RacAiHandler() = default;
+
+void RacAiHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "racAiGetState", base::BindRepeating(&RacAiHandler::HandleGetState,
+                                           base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racAiSetProvider", base::BindRepeating(&RacAiHandler::HandleSetProvider,
+                                              base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racAiSaveSettings",
+      base::BindRepeating(&RacAiHandler::HandleSaveSettings,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racAiSetKey", base::BindRepeating(&RacAiHandler::HandleSetKey,
+                                         base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racAiClearKey", base::BindRepeating(&RacAiHandler::HandleClearKey,
+                                           base::Unretained(this)));
+}
+
+base::DictValue RacAiHandler::CreateState() const {
+  base::DictValue state;
+  rac::ai::AiService* service = rac::ai::AiServiceFactory::GetForProfile(profile_);
+  // Without the service (assistant off, or not a regular profile) the page
+  // shows only the switch.
+  state.Set("available", service != nullptr);
+  if (!service) {
+    return state;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  state.Set("provider", prefs->GetString(rac::ai::kProvider));
+  base::ListValue providers;
+  for (const rac::ai::ProviderInfo& info : rac::ai::GetProviders()) {
+    const rac::ai::ProviderSettings settings =
+        rac::ai::GetProviderSettings(prefs, info.id);
+    providers.Append(base::DictValue()
+                         .Set("id", info.id)
+                         .Set("name", info.name)
+                         .Set("baseUrl", settings.base_url)
+                         .Set("model", settings.model)
+                         .Set("defaultBaseUrl", info.default_base_url)
+                         .Set("defaultModel", info.default_model)
+                         .Set("requiresKey", info.requires_key)
+                         .Set("editableBaseUrl", info.editable_base_url)
+                         .Set("hasKey", service->key_store().HasKey(info.id)));
+  }
+  state.Set("providers", std::move(providers));
+  return state;
+}
+
+void RacAiHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  ResolveJavascriptCallback(args[0], CreateState());
+}
+
+void RacAiHandler::HandleSetProvider(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  const std::string& id = args[1].GetString();
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_) ||
+      !rac::ai::FindProvider(id)) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  profile_->GetPrefs()->SetString(rac::ai::kProvider, id);
+  ResolveJavascriptCallback(args[0], CreateState());
+}
+
+void RacAiHandler::HandleSaveSettings(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 4u);
+  const std::string& id = args[1].GetString();
+  const std::string& base_url = args[2].GetString();
+  const std::string& model = args[3].GetString();
+  const rac::ai::ProviderInfo* info = rac::ai::FindProvider(id);
+  if (!rac::ai::AiServiceFactory::GetForProfile(profile_) || !info ||
+      base_url.size() > kMaxFieldLength || model.size() > kMaxFieldLength) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  // An empty value means "use the default".
+  if (!base_url.empty() &&
+      (!info->editable_base_url ||
+       !rac::ai::IsAcceptableBaseUrl(GURL(base_url)))) {
+    RejectJavascriptCallback(args[0], base::Value("invalid_url"));
+    return;
+  }
+  rac::ai::SetProviderSettings(profile_->GetPrefs(), id, {base_url, model});
+  ResolveJavascriptCallback(args[0], CreateState());
+}
+
+void RacAiHandler::HandleSetKey(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 3u);
+  const std::string callback_id = args[0].GetString();
+  const std::string& id = args[1].GetString();
+  const std::string& key = args[2].GetString();
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  if (!service || !rac::ai::FindProvider(id) || key.empty() ||
+      key.size() > kMaxKeyLength) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  service->key_store().SetKey(
+      id, key,
+      base::BindOnce(&RacAiHandler::OnKeySaved, weak_factory_.GetWeakPtr(),
+                     callback_id));
+}
+
+void RacAiHandler::OnKeySaved(const std::string& callback_id, bool success) {
+  if (success) {
+    ResolveJavascriptCallback(base::Value(callback_id), CreateState());
+  } else {
+    RejectJavascriptCallback(base::Value(callback_id), base::Value());
+  }
+}
+
+void RacAiHandler::HandleClearKey(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  rac::ai::AiService* service =
+      rac::ai::AiServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  service->key_store().ClearKey(args[1].GetString());
+  ResolveJavascriptCallback(args[0], CreateState());
+}
+
+}  // namespace settings

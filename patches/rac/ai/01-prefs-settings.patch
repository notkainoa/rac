+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_RAC_AI_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_RAC_AI_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+class Profile;
+
+namespace settings {
+
+// Backs the assistant page in Settings. The API key only travels from the
+// page to the browser. It is never sent back; the page only learns whether
+// one is saved.
+class RacAiHandler : public SettingsPageUIHandler {
+ public:
+  explicit RacAiHandler(Profile* profile);
+  RacAiHandler(const RacAiHandler&) = delete;
+  RacAiHandler& operator=(const RacAiHandler&) = delete;
+  ~RacAiHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override {}
+  void OnJavascriptDisallowed() override {}
+
+ private:
+  base::DictValue CreateState() const;
+  void HandleGetState(const base::ListValue& args);
+  void HandleSetProvider(const base::ListValue& args);
+  void HandleSaveSettings(const base::ListValue& args);
+  void HandleSetKey(const base::ListValue& args);
+  void HandleClearKey(const base::ListValue& args);
+  void OnKeySaved(const std::string& callback_id, bool success);
+
+  raw_ptr<Profile> profile_;
+  base::WeakPtrFactory<RacAiHandler> weak_factory_{this};

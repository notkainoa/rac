+
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+namespace {
+
+constexpr ProviderInfo kProviders[] = {
+    {"openai", "OpenAI", ProviderType::kOpenAiCompatible,
+     "https://api.openai.com/v1", "gpt-4.1-mini", true, false},
+    {"anthropic", "Anthropic", ProviderType::kAnthropic,
+     "https://api.anthropic.com", "claude-sonnet-4-5", true, false},
+    {"gemini", "Google Gemini", ProviderType::kOpenAiCompatible,
+     "https://generativelanguage.googleapis.com/v1beta/openai",
+     "gemini-2.5-flash", true, false},
+    {"openrouter", "OpenRouter", ProviderType::kOpenAiCompatible,
+     "https://openrouter.ai/api/v1", "openai/gpt-4o-mini", true, false},
+    {"ollama", "Ollama (on this computer)", ProviderType::kOpenAiCompatible,
+     "http://localhost:11434/v1", "llama3.2", false, true},
+    {"lmstudio", "LM Studio (on this computer)",
+     ProviderType::kOpenAiCompatible, "http://localhost:1234/v1", "", false,
+     true},
+    {"custom", "Custom (OpenAI-compatible)", ProviderType::kOpenAiCompatible,
+     "", "", true, true},
+};
+
+}  // namespace
+
+base::span<const ProviderInfo> GetProviders() {
+  return kProviders;
+}
+
+const ProviderInfo* FindProvider(std::string_view id) {
+  for (const ProviderInfo& info : kProviders) {
+    if (id == info.id) {
+      return &info;
+    }
+  }
+  return nullptr;
+}
+
+bool IsAcceptableBaseUrl(const GURL& url) {
+  if (!url.is_valid() || !url.has_host() || url.has_username() ||
+      url.has_password() || url.has_query() || url.has_ref()) {
+    return false;
+  }
+  return url.SchemeIs("https") ||
+         (url.SchemeIs("http") && net::IsLocalhost(url));
+}
+
+}  // namespace rac::ai

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/ai_prefs.h"
+
+#include "chrome/browser/rac/ai/providers.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace rac::ai {
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kEnabled, false);
+  registry->RegisterStringPref(kProvider, kDefaultProviderId);
+  registry->RegisterDictionaryPref(kProviderSettings);
+  registry->RegisterDictionaryPref(kEncryptedKeys);
+  registry->RegisterBooleanPref(kNewTabPage, true);
+  registry->RegisterBooleanPref(kAttachCurrentTab, true);
+}
+
+ProviderSettings GetProviderSettings(const PrefService* prefs,
+                                     const std::string& provider_id) {
+  ProviderSettings settings;
+  const ProviderInfo* info = FindProvider(provider_id);
+  if (info) {
+    settings.base_url = info->default_base_url;
+    settings.model = info->default_model;
+  }
+  const base::DictValue* saved =
+      prefs->GetDict(kProviderSettings).FindDict(provider_id);
+  if (saved) {
+    if (const std::string* url = saved->FindString("base_url");
+        url && !url->empty()) {
+      settings.base_url = *url;
+    }
+    if (const std::string* model = saved->FindString("model");
+        model && !model->empty()) {
+      settings.model = *model;
+    }
+  }
+  return settings;
+}
+
+void SetProviderSettings(PrefService* prefs,
+                         const std::string& provider_id,
+                         const ProviderSettings& settings) {
+  ScopedDictPrefUpdate update(prefs, kProviderSettings);
+  update->Set(provider_id, base::DictValue()
+                               .Set("base_url", settings.base_url)
+                               .Set("model", settings.model));
+}
+
+}  // namespace rac::ai

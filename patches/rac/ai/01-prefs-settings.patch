+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_KEY_STORE_H_
+#define CHROME_BROWSER_RAC_AI_KEY_STORE_H_
+
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+
+class PrefService;
+
+namespace os_crypt_async {
+class OSCryptAsync;
+}
+
+namespace rac::ai {
+
+// Provider API keys, encrypted with the operating system's keychain through
+// OSCrypt and kept in the profile's prefs. A key is never logged and never
+// leaves the browser process. If encryption isn't available, saving fails and
+// nothing is stored.
+class KeyStore {
+ public:
+  using SetCallback = base::OnceCallback<void(bool success)>;
+  using GetCallback =
+      base::OnceCallback<void(std::optional<std::string> key)>;
+
+  KeyStore(PrefService* prefs, os_crypt_async::OSCryptAsync* os_crypt);
+  KeyStore(const KeyStore&) = delete;
+  KeyStore& operator=(const KeyStore&) = delete;
+  ~KeyStore();
+
+  bool HasKey(const std::string& provider_id) const;
+  void SetKey(const std::string& provider_id,
+              const std::string& key,
+              SetCallback callback);
+  void ClearKey(const std::string& provider_id);
+  // Runs `callback` with nullopt if there is no key or it can't be decrypted.
+  void GetKey(const std::string& provider_id, GetCallback callback);
+
+ private:
+  raw_ptr<PrefService> prefs_;
+  raw_ptr<os_crypt_async::OSCryptAsync> os_crypt_;
+  base::WeakPtrFactory<KeyStore> weak_factory_{this};
+};
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_KEY_STORE_H_

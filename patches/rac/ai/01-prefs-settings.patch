+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_subpage.js';
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_collapse/cr_collapse.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/md_select.css.js';
+
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './rac_ai_page.html.js';
+
+interface RacAiProvider {
+  id: string;
+  name: string;
+  baseUrl: string;
+  model: string;
+  defaultBaseUrl: string;
+  defaultModel: string;
+  requiresKey: boolean;
+  editableBaseUrl: boolean;
+  hasKey: boolean;
+}
+
+interface RacAiState {
+  available: boolean;
+  provider?: string;
+  providers?: RacAiProvider[];
+}
+
+const SettingsRacAiPageElementBase = I18nMixin(PrefsMixin(PolymerElement));
+
+export class SettingsRacAiPageElement extends SettingsRacAiPageElementBase {
+  static get is() {
+    return 'settings-rac-ai-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      available_: {type: Boolean, value: false},
+      providers_: {type: Array, value: () => []},
+      selectedId_: {type: String, value: ''},
+      selected_: {type: Object, value: null},
+      baseUrlInvalid_: {type: Boolean, value: false},
+      keyFailed_: {type: Boolean, value: false},
+    };
+  }
+
+  static get observers() {
+    return ['enabledChanged_(prefs.rac.ai.enabled.value)'];
+  }
+
+  declare private available_: boolean;
+  declare private providers_: RacAiProvider[];
+  declare private selectedId_: string;
+  declare private selected_: RacAiProvider|null;
+  declare private baseUrlInvalid_: boolean;
+  declare private keyFailed_: boolean;
+
+  override ready() {
+    super.ready();
+    this.refresh_();
+  }
+
+  private enabledChanged_() {
+    this.refresh_();
+  }
+
+  private refresh_() {
+    sendWithPromise<RacAiState>('racAiGetState').then(
+        state => this.applyState_(state));
+  }
+
+  private applyState_(state: RacAiState) {
+    this.available_ = state.available;
+    this.providers_ = state.providers || [];
+    this.selectedId_ = state.provider || '';
+    this.selected_ =
+        this.providers_.find(p => p.id === this.selectedId_) || null;
+  }
+
+  private onProviderChange_(event: Event) {
+    const id = (event.target as HTMLSelectElement).value;
+    this.baseUrlInvalid_ = false;
+    this.keyFailed_ = false;
+    sendWithPromise<RacAiState>('racAiSetProvider', id)
+        .then(state => this.applyState_(state));
+  }
+
+  private onSaveSettings_() {
+    const baseUrl = this.shadowRoot!.querySelector<HTMLInputElement>(
+        '#baseUrl');
+    const model = this.shadowRoot!.querySelector<HTMLInputElement>('#model');
+    if (!this.selected_ || !model) {
+      return;
+    }
+    this.baseUrlInvalid_ = false;
+    sendWithPromise<RacAiState>(
+        'racAiSaveSettings', this.selected_.id,
+        baseUrl && this.selected_.editableBaseUrl ? baseUrl.value.trim() : '',
+        model.value.trim())
+        .then(state => this.applyState_(state))
+        .catch((reason: string) => {
+          this.baseUrlInvalid_ = reason === 'invalid_url';
+        });
+  }
+
+  private onSaveKey_() {
+    const input = this.shadowRoot!.querySelector<HTMLInputElement>('#key');
+    if (!this.selected_ || !input || !input.value) {
+      return;
+    }
+    this.keyFailed_ = false;
+    sendWithPromise<RacAiState>('racAiSetKey', this.selected_.id, input.value)
+        .then(state => {
+          input.value = '';
+          this.applyState_(state);
+        })
+        .catch(() => {
+          this.keyFailed_ = true;
+        });
+  }
+
+  private onRemoveKey_() {
+    if (!this.selected_) {
+      return;
+    }
+    sendWithPromise<RacAiState>('racAiClearKey', this.selected_.id)
+        .then(state => this.applyState_(state));
+  }
+
+  private isSelected_(id: string, selectedId: string): boolean {
+    return id === selectedId;
+  }
+
+  private needsKey_(selected: RacAiProvider|null): boolean {
+    return !!selected && selected.requiresKey;
+  }
+
+  private keyNotNeeded_(selected: RacAiProvider|null): boolean {
+    return !!selected && !selected.requiresKey;
+  }
+
+  private canEditUrl_(selected: RacAiProvider|null): boolean {
+    return !!selected && selected.editableBaseUrl;
+  }
+
+  private hasKey_(selected: RacAiProvider|null): boolean {
+    return !!selected && selected.hasKey;
+  }
+
+  private hasNoKey_(selected: RacAiProvider|null): boolean {
+    return !!selected && selected.requiresKey && !selected.hasKey;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-rac-ai-page': SettingsRacAiPageElement;
+  }
+}
+
+customElements.define(SettingsRacAiPageElement.is, SettingsRacAiPageElement);

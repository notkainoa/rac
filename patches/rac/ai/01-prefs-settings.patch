+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/key_store.h"
+
+#include <utility>
+
+#include "base/base64.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "components/os_crypt/async/browser/os_crypt_async.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace rac::ai {
+namespace {
+
+void StoreEncrypted(base::WeakPtr<KeyStore> store,
+                    PrefService* prefs,
+                    std::string provider_id,
+                    std::string key,
+                    KeyStore::SetCallback callback,
+                    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  std::string ciphertext;
+  if (!store || !encryptor || !encryptor->IsEncryptionAvailable() ||
+      !encryptor->EncryptString(key, &ciphertext)) {
+    std::move(callback).Run(false);
+    return;
+  }
+  ScopedDictPrefUpdate update(prefs, kEncryptedKeys);
+  update->Set(provider_id, base::Base64Encode(ciphertext));
+  std::move(callback).Run(true);
+}
+
+void DecryptStored(KeyStore::GetCallback callback,
+                   std::string ciphertext,
+                   scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  std::string key;
+  if (!encryptor || !encryptor->IsDecryptionAvailable() ||
+      !encryptor->DecryptString(ciphertext, &key) || key.empty()) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  std::move(callback).Run(std::move(key));
+}
+
+}  // namespace
+
+KeyStore::KeyStore(PrefService* prefs, os_crypt_async::OSCryptAsync* os_crypt)
+    : prefs_(prefs), os_crypt_(os_crypt) {}
+
+KeyStore::~KeyStore() = default;
+
+bool KeyStore::HasKey(const std::string& provider_id) const {
+  return prefs_->GetDict(kEncryptedKeys).FindString(provider_id) != nullptr;
+}
+
+void KeyStore::SetKey(const std::string& provider_id,
+                      const std::string& key,
+                      SetCallback callback) {
+  if (key.empty() || !os_crypt_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  os_crypt_->GetInstance(base::BindOnce(&StoreEncrypted,
+                                        weak_factory_.GetWeakPtr(),
+                                        prefs_.get(), provider_id, key,
+                                        std::move(callback)));
+}
+
+void KeyStore::ClearKey(const std::string& provider_id) {
+  ScopedDictPrefUpdate update(prefs_, kEncryptedKeys);
+  update->Remove(provider_id);
+}
+
+void KeyStore::GetKey(const std::string& provider_id, GetCallback callback) {
+  const std::string* encoded =
+      prefs_->GetDict(kEncryptedKeys).FindString(provider_id);
+  std::string ciphertext;
+  if (!os_crypt_ || !encoded || !base::Base64Decode(*encoded, &ciphertext)) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  os_crypt_->GetInstance(
+      base::BindOnce(&DecryptStored, std::move(callback), std::move(ciphertext)));
+}
+
+}  // namespace rac::ai

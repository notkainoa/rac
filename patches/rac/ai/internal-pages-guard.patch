+#include "chrome/browser/rac/ai/internal_page.h"
+
+#include "url/gurl.h"
+
+namespace rac::ai {
+
+namespace {
+
+bool IsWebUrl(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && url.has_host();
+}
+
+}  // namespace
+
+bool IsInternalPageUrl(const GURL& url, const GURL& virtual_url) {
+  return !IsWebUrl(url) || (!virtual_url.is_empty() && !IsWebUrl(virtual_url));
+}
+
+}  // namespace rac::ai

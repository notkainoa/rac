+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace rac::ai {
+
+// True unless `contents` has committed an ordinary web page
+// (IsInternalPageUrl() of its last committed entry's address and shown
+// address). A tab still loading its first page, or a null `contents`, is
+// internal: nothing may read a page that isn't there yet. An error page
+// counts as the address it failed to load. For deciding what the assistant
+// may read; the entry points go by the shown address
+// (IsAssistantBlockedHere()).
+bool IsInternalTab(content::WebContents* contents);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_INTERNAL_TAB_H_

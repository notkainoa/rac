+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_AI_INTERNAL_PAGE_H_
+#define CHROME_BROWSER_RAC_AI_INTERNAL_PAGE_H_
+
+class GURL;
+
+namespace rac::ai {
+
+// The assistant sits only beside ordinary web pages, which are also the only
+// pages it can read. Every other page counts as internal: the browser's own
+// pages (chrome://, rac://, chrome-untrusted://, chrome-search://,
+// devtools://), the new tab page, extension pages, view-source:, files,
+// about:blank, data:, and anything without a valid address. Listing the web
+// rather than the exceptions means a scheme added later stays internal.
+//
+// `url` is the navigation entry's address and `virtual_url` the one the
+// address bar shows (empty if there is none); both must be http or https.
+// A view-source: entry has the source's own address and shows
+// "view-source:" only in `virtual_url`.
+bool IsInternalPageUrl(const GURL& url, const GURL& virtual_url);
+
+}  // namespace rac::ai
+
+#endif  // CHROME_BROWSER_RAC_AI_INTERNAL_PAGE_H_

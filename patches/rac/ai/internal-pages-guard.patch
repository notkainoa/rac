+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/ai/internal_page.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac::ai {
+namespace {
+
+bool Internal(const char* url) {
+  return IsInternalPageUrl(GURL(url), GURL());
+}
+
+TEST(RacAiInternalPageTest, WebPagesAreNotInternal) {
+  EXPECT_FALSE(Internal("https://example.com/"));
+  EXPECT_FALSE(Internal("http://example.com/a?b#c"));
+  EXPECT_FALSE(Internal("http://localhost:8080/"));
+  EXPECT_FALSE(Internal("https://127.0.0.1/"));
+  EXPECT_FALSE(IsInternalPageUrl(GURL("https://example.com/"),
+                                 GURL("https://example.com/")));
+}
+
+TEST(RacAiInternalPageTest, BrowserPagesAreInternal) {
+  EXPECT_TRUE(Internal("chrome://settings/assistant"));
+  EXPECT_TRUE(Internal("rac://settings/"));
+  EXPECT_TRUE(Internal("helium://settings/"));
+  EXPECT_TRUE(Internal("chrome://newtab/"));
+  EXPECT_TRUE(Internal("rac://newtab/"));
+  EXPECT_TRUE(Internal("chrome://new-tab-page/"));
+  EXPECT_TRUE(Internal("chrome-search://local-ntp/local-ntp.html"));
+  EXPECT_TRUE(Internal("chrome://rac-ai/?mode=page"));
+  EXPECT_TRUE(Internal("chrome-untrusted://print/"));
+  EXPECT_TRUE(Internal("devtools://devtools/bundled/devtools_app.html"));
+  EXPECT_TRUE(Internal("chrome-extension://abcdefghijklmnop/options.html"));
+  EXPECT_TRUE(Internal("chrome-error://chromewebdata/"));
+  EXPECT_TRUE(Internal("chrome-native://newtab/"));
+}
+
+TEST(RacAiInternalPageTest, OtherNonWebPagesAreInternal) {
+  EXPECT_TRUE(Internal("file:///Users/me/notes.html"));
+  EXPECT_TRUE(Internal("about:blank"));
+  EXPECT_TRUE(Internal("about:srcdoc"));
+  EXPECT_TRUE(Internal("data:text/html,hello"));
+  EXPECT_TRUE(Internal("blob:https://example.com/0f0f0f0f"));
+  EXPECT_TRUE(Internal("javascript:alert(1)"));
+  EXPECT_TRUE(Internal("filesystem:https://example.com/temporary/a"));
+  EXPECT_TRUE(Internal("ftp://example.com/"));
+  EXPECT_TRUE(Internal("mailto:a@example.com"));
+  EXPECT_TRUE(Internal("view-source:https://example.com/"));
+}
+
+TEST(RacAiInternalPageTest, NoAddressIsInternal) {
+  EXPECT_TRUE(Internal(""));
+  EXPECT_TRUE(Internal("not a url"));
+  EXPECT_TRUE(Internal("https://"));
+  EXPECT_TRUE(IsInternalPageUrl(GURL(), GURL("https://example.com/")));
+}
+
+TEST(RacAiInternalPageTest, TheShownAddressCountsToo) {
+  // A view-source: entry has the page's own address and shows view-source:
+  // only in the address bar.
+  EXPECT_TRUE(IsInternalPageUrl(GURL("https://example.com/"),
+                                GURL("view-source:https://example.com/")));
+  EXPECT_TRUE(IsInternalPageUrl(GURL("https://example.com/"),
+                                GURL("rac://settings/")));
+  EXPECT_TRUE(IsInternalPageUrl(GURL("chrome://settings/"),
+                                GURL("https://example.com/")));
+  EXPECT_TRUE(
+      IsInternalPageUrl(GURL("https://example.com/"), GURL("not a url")));
+  // No shown address leaves the committed one to decide.
+  EXPECT_FALSE(IsInternalPageUrl(GURL("https://example.com/"), GURL()));
+}
+
+}  // namespace
+}  // namespace rac::ai

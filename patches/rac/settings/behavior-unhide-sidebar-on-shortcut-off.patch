+void ShowSidebarIfCollapseShortcutDisabled(BrowserWindowInterface* browser) {
+  Profile* profile = browser->GetProfile();
+  PrefService* prefs = profile->GetPrefs();
+  // ⌘S only hides the sidebar in the Vertical layout. In other layouts the
+  // same zen mode pref is the Appearance page's frameless setting, which
+  // the user chose and can turn off there, so leave it alone.
+  if (prefs->GetBoolean(prefs::kVerticalCollapseShortcut) ||
+      prefs->GetInteger(prefs::kHeliumLayout) !=
+          std::to_underlying(HeliumLayoutType::kVertical) ||
+      !IsSidebarHidden(browser)) {
+    return;
+  }
+  // Same show path as ToggleSidebar, for every window of the profile,
+  // incognito included: leave zen mode, which the windows share, and expand
+  // each window's sidebar in case it was collapsed to icons. Every window
+  // runs this, but after the first one the sidebar is no longer hidden.
+  prefs->SetBoolean(prefs::kHeliumZenMode, false);
+  Profile* original_profile = profile->GetOriginalProfile();
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [original_profile](BrowserWindowInterface* window) {
+        if (window->GetProfile()->GetOriginalProfile() != original_profile) {
+          return true;
+        }
+        auto* controller = tabs::VerticalTabStripStateController::From(window);
+        if (controller && controller->IsCollapsed()) {
+          controller->RequestCollapse(false);
+        }
+        return true;
+      });
+}
+
 }  // namespace rac

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-startup-card' is the On startup card on the General page: one
+ * dropdown, "Continue where you left off" or "Start fresh", and under Start
+ * fresh an "Open a specific page" toggle that shows the startup pages list.
+ * It replaces Chromium's four radio buttons for session.restore_on_startup.
+ */
+import '/shared/settings/controls/cr_policy_pref_indicator.js';
+import '/shared/settings/controls/extension_controlled_indicator.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import '../on_startup_page/startup_urls_page.js';
+import '../settings_page/settings_section.js';
+
+import {PrefServiceObserverMixinLit} from '/shared/settings/prefs2/pref_service_observer_mixin_lit.js';
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import type {CrToggleElement} from 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import {getCss as getMdSelectLit} from 'chrome://resources/cr_elements/md_select_lit.css.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {NtpExtension} from '../on_startup_page/on_startup_browser_proxy.js';
+import {OnStartupBrowserProxyImpl} from '../on_startup_page/on_startup_browser_proxy.js';
+import {PrefValues} from '../on_startup_page/on_startup_page.js';
+import {getCss as getSettingsSharedLit} from '../settings_shared_lit.css.js';
+
+import {getHtml} from './startup_card.html.js';
+
+const SettingsStartupCardElementBase =
+    PrefServiceObserverMixinLit(WebUiListenerMixinLit(CrLitElement));
+
+export class SettingsStartupCardElement extends SettingsStartupCardElementBase {
+  static get is() {
+    return 'settings-startup-card';
+  }
+
+  static override get styles() {
+    return [getCrSharedStyle(), getSettingsSharedLit(), getMdSelectLit()];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      restoreOnStartupPref_: {type: Object},
+      ntpExtension_: {type: Object},
+    };
+  }
+
+  protected accessor restoreOnStartupPref_:
+      chrome.settingsPrivate.PrefObject<PrefValues>|undefined;
+  protected accessor ntpExtension_: NtpExtension|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    this.mirrorPref('session.restore_on_startup', 'restoreOnStartupPref_');
+
+    const updateNtpExtension = (ntpExtension: NtpExtension|null) => {
+      // |ntpExtension| is empty if there is no NTP extension.
+      this.ntpExtension_ = ntpExtension;
+    };
+    OnStartupBrowserProxyImpl.getInstance().getNtpExtension().then(
+        updateNtpExtension);
+    this.addWebUiListener('update-ntp-extension', updateNtpExtension);
+  }
+
+  /** Whether a policy or an extension sets the pref. */
+  protected isPrefEnforced_(): boolean {
+    return this.restoreOnStartupPref_?.enforcement ===
+        chrome.settingsPrivate.Enforcement.ENFORCED;
+  }
+
+  /**
+   * Whether rac restores the last session's tabs on startup. rac's default.
+   * "Continue and open specific pages" (only settable before, or by policy)
+   * restores the session too.
+   */
+  protected isContinueMode_(): boolean {
+    const value = this.restoreOnStartupPref_?.value;
+    return value === undefined || value === PrefValues.CONTINUE ||
+        value === PrefValues.CONTINUE_AND_OPEN_SPECIFIC;
+  }
+
+  /** Whether rac also opens the startup pages list. */
+  protected isOpenSpecific_(): boolean {
+    const value = this.restoreOnStartupPref_?.value;
+    return value === PrefValues.OPEN_SPECIFIC ||
+        value === PrefValues.CONTINUE_AND_OPEN_SPECIFIC;
+  }
+
+  /**
+   * "Open a specific page" sits under Start fresh. It also shows under
+   * Continue when the pref is "continue and open specific pages", so those
+   * pages stay visible and can be turned off.
+   */
+  protected showOpenSpecific_(): boolean {
+    return !this.isContinueMode_() ||
+        this.restoreOnStartupPref_?.value ===
+        PrefValues.CONTINUE_AND_OPEN_SPECIFIC;
+  }
+
+  protected onStartupModeChange_(e: Event) {
+    const select = e.target as HTMLSelectElement;
+    this.setRestoreOnStartup_(
+        select.value === 'continue' ? PrefValues.CONTINUE :
+                                      PrefValues.OPEN_NEW_TAB);
+  }
+
+  protected onOpenSpecificChange_(e: Event) {
+    const checked = (e.target as CrToggleElement).checked;
+    if (this.isContinueMode_()) {
+      this.setRestoreOnStartup_(
+          checked ? PrefValues.CONTINUE_AND_OPEN_SPECIFIC :
+                    PrefValues.CONTINUE);
+      return;
+    }
+    this.setRestoreOnStartup_(
+        checked ? PrefValues.OPEN_SPECIFIC : PrefValues.OPEN_NEW_TAB);
+  }
+
+  private setRestoreOnStartup_(value: PrefValues) {
+    chrome.settingsPrivate.setPref('session.restore_on_startup', value);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-startup-card': SettingsStartupCardElement;
+  }
+}
+
+customElements.define(
+    SettingsStartupCardElement.is, SettingsStartupCardElement);

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsStartupCardElement} from './startup_card.js';
+
+export function getHtml(this: SettingsStartupCardElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-section page-title="$i18n{onStartup}">
+  <div class="cr-row first">
+    <div class="flex cr-padded-text" id="startupModeLabel">
+      $i18n{racStartupWhen}
+    </div>
+    ${this.restoreOnStartupPref_ ? html`
+      <cr-policy-pref-indicator .pref="${this.restoreOnStartupPref_}">
+      </cr-policy-pref-indicator>
+    ` : ''}
+    <select id="startupModeSelect" class="md-select"
+        aria-labelledby="startupModeLabel"
+        .value="${this.isContinueMode_() ? 'continue' : 'fresh'}"
+        ?disabled="${this.isPrefEnforced_()}"
+        @change="${this.onStartupModeChange_}">
+      <option value="continue">$i18n{onStartupContinue}</option>
+      <option value="fresh">$i18n{racStartupStartFresh}</option>
+    </select>
+  </div>
+  ${this.showOpenSpecific_() ? html`
+    ${this.ntpExtension_ && !this.isContinueMode_() ? html`
+      <div class="cr-row continuation">
+        <extension-controlled-indicator
+            .extensionId="${this.ntpExtension_.id}"
+            .extensionName="${this.ntpExtension_.name}"
+            .extensionCanBeDisabled="${this.ntpExtension_.canBeDisabled}">
+        </extension-controlled-indicator>
+      </div>
+    ` : ''}
+    <div class="cr-row continuation">
+      <div class="flex cr-padded-text" id="openSpecificLabel">
+        $i18n{racStartupOpenSpecific}
+      </div>
+      <cr-toggle id="openSpecificToggle" ?checked="${this.isOpenSpecific_()}"
+          aria-labelledby="openSpecificLabel"
+          ?disabled="${this.isPrefEnforced_()}"
+          @change="${this.onOpenSpecificChange_}">
+      </cr-toggle>
+    </div>
+    ${this.isOpenSpecific_() ? html`
+      <settings-startup-urls-page></settings-startup-urls-page>
+    ` : ''}
+  ` : ''}
+</settings-section>
+<!--_html_template_end_-->`;
+  // clang-format on
+}

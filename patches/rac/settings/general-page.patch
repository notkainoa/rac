+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-general-page-index' is the General settings page. It stacks the
+ * search engine, on startup, default browser, about, and reset cards, and
+ * hosts the "Manage search engines" subpage.
+ */
+import 'chrome://resources/cr_elements/cr_view_manager/cr_view_manager.js';
+import '../about_page/about_page.js';
+// <if expr="not is_chromeos">
+import '../default_browser_page/default_browser_page.js';
+// </if>
+import '../on_startup_page/on_startup_page.js';
+import '../search_page/feature_shortcuts_page.js';
+import '../search_page/keyboard_shortcut_page.js';
+import '../search_page/omnibox_everywhere_section.js';
+import '../search_page/search_engines_page.js';
+import '../search_page/search_page.js';
+import '../search_page/site_shortcuts_page.js';
+import './reset_danger_zone.js';
+
+import type {CrViewManagerElement} from 'chrome://resources/cr_elements/cr_view_manager/cr_view_manager.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {AboutPageBrowserProxyImpl} from '../about_page/about_page_browser_proxy.js';
+import {loadTimeData} from '../i18n_setup.js';
+import {routes} from '../route.js';
+import type {Route, SettingsRoutes} from '../router.js';
+import {RouteObserverMixinLit} from '../router.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {SearchableViewContainerMixinLit} from '../settings_page/searchable_view_container_mixin_lit.js';
+
+import {getCss} from './general_page_index.css.js';
+import {getHtml} from './general_page_index.html.js';
+
+
+export interface SettingsGeneralPageIndexElement {
+  $: {
+    viewManager: CrViewManagerElement,
+  };
+}
+
+const SettingsGeneralPageIndexElementBase =
+    SearchableViewContainerMixinLit(RouteObserverMixinLit(CrLitElement));
+
+export class SettingsGeneralPageIndexElement extends
+    SettingsGeneralPageIndexElementBase implements SettingsPlugin {
+  static get is() {
+    return 'settings-general-page-index';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      routes_: {type: Object},
+      searchSettingsUpdateEnabled_: {type: Boolean},
+      omniboxEverywhereSettingsEnabled_: {type: Boolean},
+    };
+  }
+
+  protected accessor routes_: SettingsRoutes = routes;
+  protected accessor searchSettingsUpdateEnabled_: boolean =
+      loadTimeData.getBoolean('searchSettingsUpdate');
+  protected accessor omniboxEverywhereSettingsEnabled_: boolean =
+      loadTimeData.getBoolean('omniboxEverywhereSettingsEnabled');
+
+  protected showPage_(visibility?: boolean): boolean {
+    return visibility !== false;
+  }
+
+  /** The ids of the stacked cards that make up the General page. */
+  private defaultViewIds_(): string[] {
+    return Array
+        .from(this.$.viewManager.querySelectorAll<HTMLElement>(
+            '[slot=view]:not([data-parent-view-id])'))
+        .map(view => view.id);
+  }
+
+  private showDefaultViews_() {
+    this.$.viewManager.switchViews(
+        this.defaultViewIds_(), 'no-animation', 'no-animation');
+  }
+
+  private scrollToView_(viewId: string) {
+    const view = this.$.viewManager.querySelector<HTMLElement>(`#${viewId}`);
+    if (view) {
+      view.scrollIntoView({block: 'start'});
+    }
+  }
+
+  override currentRouteChanged(newRoute: Route, oldRoute?: Route) {
+    super.currentRouteChanged(newRoute, oldRoute);
+
+    // Need to wait for currentRouteChanged observers on child views to run
+    // first, before switching views.
+    queueMicrotask(() => {
+      switch (newRoute) {
+        case routes.GENERAL:
+        case routes.BASIC:
+          this.showDefaultViews_();
+          break;
+        case routes.SEARCH:
+          this.showDefaultViews_();
+          this.scrollToView_('searchEngine');
+          break;
+        case routes.ON_STARTUP:
+          this.showDefaultViews_();
+          this.scrollToView_('onStartup');
+          break;
+        case routes.DEFAULT_BROWSER:
+          this.showDefaultViews_();
+          this.scrollToView_('defaultBrowser');
+          break;
+        case routes.ABOUT:
+          this.showDefaultViews_();
+          this.scrollToView_('about');
+          // Only check for updates when the user opens About, not every
+          // time the General page shows the About card.
+          AboutPageBrowserProxyImpl.getInstance().refreshUpdateStatus();
+          break;
+        case routes.RESET:
+        case routes.RESET_DIALOG:
+        case routes.TRIGGERED_RESET_DIALOG:
+          this.showDefaultViews_();
+          this.scrollToView_('reset');
+          break;
+        case routes.SEARCH_ENGINES:
+          this.$.viewManager.switchView(
+              'searchEngines', 'no-animation', 'no-animation');
+          break;
+        default:
+          // Nothing to do. Other parent elements are responsible for updating
+          // the displayed contents.
+          break;
+      }
+    });
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-general-page-index': SettingsGeneralPageIndexElement;
+  }
+}
+
+customElements.define(
+    SettingsGeneralPageIndexElement.is, SettingsGeneralPageIndexElement);

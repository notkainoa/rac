--- a/chrome/browser/resources/settings/settings_page/settings_section.css
+++ b/chrome/browser/resources/settings/settings_page/settings_section.css
@@ -50,3 +50,13 @@
     border: var(--cr-border-hcm);
   }
 }
+
+/* rac: a section without a title, like About's Copyright card, continues the
+   one above it. Its empty header would leave a title-sized gap. */
+#header:has(> #title[aria-hidden='true']):not(:has(#feedback)) {
+  display: none;
+}
+
+#header:has(> #title[aria-hidden='true']):not(:has(#feedback)) + #card {
+  margin-top: 12px;
+}
--- a/chrome/browser/resources/settings/settings_shared_lit.css
+++ b/chrome/browser/resources/settings/settings_shared_lit.css
@@ -356,3 +356,20 @@ iron-list,
 .flex {
   flex: 1;
 }
+
+/* rac: a search bubble on a row that opens a subpage sits in the row, by its
+   arrow, instead of below the row over the next row's title. */
+cr-link-row > .search-bubble {
+  flex-shrink: 0;
+  margin-inline: 12px 6px;
+  position: relative;
+  top: auto !important;
+}
+
+cr-link-row > .search-bubble .search-bubble-innards::after,
+cr-link-row > .search-bubble .search-bubble-innards.above::after {
+  bottom: auto;
+  inset-inline-end: -5px;
+  inset-inline-start: auto;
+  top: calc(50% - 5px);
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/appearance_locks.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/helium/helium_layout_state_controller.h"
+#include "chrome/common/pref_names.h"
+#include "components/bookmarks/common/bookmark_pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+struct BoolLock {
+  const char* pref_name;
+  bool value;
+};
+
+// The Appearance settings rac removed, and the values they are locked at:
+// the layout is vertical, the zoom indicator is shown, the address bar is
+// not centered, frameless mode keeps the top bar pinned and the sidebar
+// unpinned with a rounded frame, and saved tab groups stay out of the
+// bookmarks bar.
+constexpr BoolLock kBoolLocks[] = {
+    {prefs::kShowZoomIndicator, true},
+    {prefs::kHeliumCenteredLocationBar, false},
+    {prefs::kHeliumZenModeSidebarPinned, false},
+    {prefs::kHeliumZenModeTopChromePinned, true},
+    {prefs::kHeliumRoundedFrame, true},
+    {bookmarks::prefs::kShowTabGroupsInBookmarkBar, false},
+};
+
+}  // namespace
+
+AppearanceLocks::AppearanceLocks(PrefService* pref_service)
+    : pref_service_(pref_service) {
+  Lock();
+  registrar_.Init(pref_service_);
+  Observe(prefs::kHeliumLayout);
+  for (const BoolLock& lock : kBoolLocks) {
+    Observe(lock.pref_name);
+  }
+}
+
+AppearanceLocks::~AppearanceLocks() = default;
+
+void AppearanceLocks::Lock() {
+  if (pref_service_->FindPreference(prefs::kHeliumLayout)) {
+    const int locked = std::to_underlying(HeliumLayoutType::kVertical);
+    if (pref_service_->GetInteger(prefs::kHeliumLayout) != locked) {
+      pref_service_->SetInteger(prefs::kHeliumLayout, locked);
+    }
+  }
+
+  for (const BoolLock& lock : kBoolLocks) {
+    if (pref_service_->FindPreference(lock.pref_name) &&
+        pref_service_->GetBoolean(lock.pref_name) != lock.value) {
+      pref_service_->SetBoolean(lock.pref_name, lock.value);
+    }
+  }
+}
+
+void AppearanceLocks::Observe(const char* pref_name) {
+  if (pref_service_->FindPreference(pref_name)) {
+    registrar_.Add(pref_name, base::BindRepeating(&AppearanceLocks::Lock,
+                                                  base::Unretained(this)));
+  }
+}
+
+}  // namespace rac

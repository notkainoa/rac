+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_APPEARANCE_LOCKS_H_
+#define CHROME_BROWSER_UI_RAC_APPEARANCE_LOCKS_H_
+
+#include "base/memory/raw_ptr.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class PrefService;
+
+namespace rac {
+
+// Holds the Appearance settings rac removed at their one locked state.
+// VerticalTabStripStateController creates one before the window reads them.
+// The locked values are applied at construction, and a pref observer reverts
+// stray writes from paths rac did not remove, including a value synced from
+// another copy of the profile.
+class AppearanceLocks {
+ public:
+  explicit AppearanceLocks(PrefService* pref_service);
+  AppearanceLocks(const AppearanceLocks&) = delete;
+  AppearanceLocks& operator=(const AppearanceLocks&) = delete;
+  ~AppearanceLocks();
+
+ private:
+  // Applies every locked value. Prefs this profile doesn't register (a unit
+  // test profile) are skipped.
+  void Lock();
+
+  // Watches a locked pref and re-locks it when it changes.
+  void Observe(const char* pref_name);
+
+  raw_ptr<PrefService> pref_service_;
+  PrefChangeRegistrar registrar_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_APPEARANCE_LOCKS_H_

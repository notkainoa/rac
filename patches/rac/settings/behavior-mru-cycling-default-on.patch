+// rac: whether an MRU cycle list still matches the strip: it starts at the
+// active tab and holds every tab of the current space exactly once. Entries
+// are unique by construction, so matching the count means matching the set.
+bool IsMRUCycleListCurrent(const TabStripModel& model,
+                           const std::vector<int>& list) {
+  if (list.front() != model.active_index()) {
+    return false;
+  }
+  size_t visible_tabs = 0;
+  for (int i = 0; i < model.count(); ++i) {
+    if (rac::SpaceTabTag::IsVisible(model.GetTabAtIndex(i))) {
+      ++visible_tabs;
+    }
+  }
+  if (visible_tabs != list.size()) {
+    return false;
+  }
+  for (int index : list) {
+    if (!model.ContainsIndex(index) ||
+        !rac::SpaceTabTag::IsVisible(model.GetTabAtIndex(index))) {
+      return false;
+    }
+  }
+  return true;
+}

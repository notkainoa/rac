+
+namespace rac {
+
+// Profile pref: center the address in the address bar while it isn't being
+// edited, instead of aligning it left. Applies to the address bar in the
+// toolbar and in the sidebar.
+inline constexpr char kCenterAddressBarContents[] =
+    "rac.browser.center_address_bar_contents";
+
+void RegisterAppearancePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+}  // namespace rac

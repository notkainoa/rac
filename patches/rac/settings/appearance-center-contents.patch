+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/appearance_prefs.h"
+
+#include "chrome/common/pref_names.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+void RegisterAppearancePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kCenterAddressBarContents, false);
+  registry->RegisterBooleanPref(kCenterAddressBarContentsMigrated, false);
+}
+
+void MigrateAppearancePrefs(PrefService* prefs) {
+  if (prefs->GetBoolean(kCenterAddressBarContentsMigrated)) {
+    return;
+  }
+  prefs->SetBoolean(kCenterAddressBarContentsMigrated, true);
+  const PrefService::Preference* minimal =
+      prefs->FindPreference(prefs::kHeliumMinimalLocationBar);
+  const PrefService::Preference* center =
+      prefs->FindPreference(kCenterAddressBarContents);
+  // A center setting someone already chose stays as it is.
+  if (minimal && minimal->HasUserSetting() && minimal->GetValue()->GetBool() &&
+      center && !center->HasUserSetting()) {
+    prefs->SetBoolean(kCenterAddressBarContents, true);
+  }
+}
+
+}  // namespace rac

+#ifndef CHROME_BROWSER_UI_RAC_APPEARANCE_PREFS_H_
+#define CHROME_BROWSER_UI_RAC_APPEARANCE_PREFS_H_
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace rac {
+
+// Profile pref: center the address in the address bar while it isn't being
+// edited, instead of aligning it left. Applies to the address bar in the
+// toolbar and in the sidebar.
+inline constexpr char kCenterAddressBarContents[] =
+    "rac.browser.center_address_bar_contents";
+
+// Profile pref: MigrateAppearancePrefs has run for this profile.
+inline constexpr char kCenterAddressBarContentsMigrated[] =
+    "rac.browser.center_address_bar_contents_migrated";
+
+void RegisterAppearancePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Runs once per profile. Helium's minimal URL also centered the address, so a
+// profile that had it on before "Center address bar contents" existed gets
+// centering turned on. New profiles keep the default, off.
+void MigrateAppearancePrefs(PrefService* prefs);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_APPEARANCE_PREFS_H_

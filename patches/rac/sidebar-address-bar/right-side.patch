+int RacSidebarHeaderView::GetTrailingWindowButtonsInset(
+    int trailing_edge) const {
+  const views::Widget* widget = GetWidget();
+  if (!widget) {
+    return 0;
+  }
+  NSWindow* ns_window = widget->GetNativeWindow().GetNativeNSWindow();
+  NSButton* close = [ns_window standardWindowButton:NSWindowCloseButton];
+  NSButton* zoom = [ns_window standardWindowButton:NSWindowZoomButton];
+  if (!close || !zoom) {
+    return 0;
+  }
+  // BrowserWindowFrame puts the close button this far from the left edge,
+  // plus the inset. The buttons keep the same distance from the right edge.
+  constexpr CGFloat kEdgeDistance = 10;
+  const CGFloat buttons_width = NSMaxX(zoom.frame) - NSMinX(close.frame);
+  return std::max(
+      0, base::ClampFloor(trailing_edge - buttons_width - 2 * kEdgeDistance));
+}

+int GetPageCardSideInset(const views::View* browser_view,
+                         bool leading,
+                         bool chrome_attached) {
+  // The chrome attached across from the sidebar is the side panel, which
+  // keeps the card's usual margin.
+  const auto* header = HeaderFor(browser_view);
+  const bool sidebar_on_right = header && header->is_sidebar_on_right();
+  return chrome_attached && leading != sidebar_on_right
+             ? GetPageCardInsetBesideSidebar()
+             : rac::kContentCardInset;
+}

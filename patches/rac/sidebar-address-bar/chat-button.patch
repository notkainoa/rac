+// The Sidebar layout's way into the chat: an icon at the end of the address
+// bar, just before the site controls, that opens and closes the chat panel
+// and stays lit while it's open. It does the Top bar's Chat pill's job and
+// follows the same rule: while AI is off, or in Top bar layout, only a small
+// pref watcher exists, with no button in it and nothing watching the panel.
+// Does nothing for windows that never have the chat (not a normal window,
+// incognito).
+void AddSidebarChatButton(LocationBarView* location_bar,
+                          BrowserWindowInterface* browser);
+
+// For the address bar's layout: the Chat button if it shows now, else null.
+views::View* UpdateSidebarChatForLayout(LocationBarView* location_bar);
+
+// The two calls the button makes: the pill's Assistant command, and whether
+// the window's chat panel is open.
+void ToggleChatFromSidebar(BrowserWindowInterface* browser);
+bool IsChatOpen(BrowserWindowInterface* browser);
+

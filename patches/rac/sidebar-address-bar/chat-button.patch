+// Lives in the address bar for the window's life. Holds the icon while it
+// exists and keeps it in step with the AI pref, the layout, the chat panel,
+// and the page beside it.
+class SidebarChatHost : public views::View {
+  METADATA_HEADER(SidebarChatHost, views::View)
+
+ public:
+  explicit SidebarChatHost(BrowserWindowInterface* browser)
+      : browser_(browser) {
+    SetLayoutManager(std::make_unique<views::FillLayout>());
+    SetVisible(false);
+    pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+    pref_change_registrar_.Add(
+        ai::kEnabled,
+        base::BindRepeating(&SidebarChatHost::Update, base::Unretained(this)));
+    pref_change_registrar_.Add(
+        kLayout,
+        base::BindRepeating(&SidebarChatHost::Update, base::Unretained(this)));
+    Update();
+  }
+  SidebarChatHost(const SidebarChatHost&) = delete;
+  SidebarChatHost& operator=(const SidebarChatHost&) = delete;
+  ~SidebarChatHost() override = default;
+
+  bool wants_visible() const { return state_.visible; }
+
+ private:
+  void Update() {
+    const PrefService* prefs = browser_->GetProfile()->GetPrefs();
+    const bool regular_profile = browser_->GetProfile()->IsRegularProfile();
+    const bool ai_enabled = ai::IsAiEnabled(prefs);
+    const bool sidebar_layout = GetLayout(prefs) == Layout::kSidebar;
+    // Watch the panel, and ask the assistant about the window, only while
+    // there's a button to keep in step.
+    const bool wanted = regular_profile && ai_enabled && sidebar_layout;
+    if (wanted && !panel_subscription_) {
+      panel_subscription_ = ai::AddAssistantPanelOpenCallback(
+          browser_, base::BindRepeating(&SidebarChatHost::Update,
+                                        base::Unretained(this)));
+    } else if (!wanted) {
+      panel_subscription_ = {};
+    }
+    const SidebarChatState state =
+        GetSidebarChatState(regular_profile, ai_enabled, sidebar_layout,
+                            wanted && ai::IsAssistantBlockedHere(browser_),
+                            wanted && IsChatOpen(browser_));
+
+    if (state.exists && !button_) {
+      button_ = AddChildView(std::make_unique<ChatIconButton>(browser_));
+    } else if (!state.exists && button_) {
+      ChatIconButton* button = button_;
+      button_ = nullptr;
+      RemoveChildViewT(button);
+    }
+    if (button_) {
+      button_->ShowOpen(state.open);
+    }
+    if (state != state_) {
+      state_ = state;
+      // The address bar shows or hides the icon in its own layout.
+      if (parent()) {
+        parent()->InvalidateLayout();
+      }
+    }
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<ChatIconButton> button_ = nullptr;
+  SidebarChatState state_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::CallbackListSubscription panel_subscription_;
+};
+
+BEGIN_METADATA(SidebarChatHost)
+END_METADATA
+
+SidebarChatHost* FindHost(const LocationBarView* location_bar) {
+  for (views::View* child : location_bar->children()) {
+    if (auto* host = views::AsViewClass<SidebarChatHost>(child)) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+void AddSidebarChatButton(LocationBarView* location_bar,
+                          BrowserWindowInterface* browser) {
+  // The same windows as the Top bar's Chat pill (CreateAssistantButton()).
+  // GetSidebarChatState() never gives other profiles a button, so they get
+  // no host either, and nothing watches their prefs.
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+      !browser->GetProfile()->IsRegularProfile() ||
+      features::IsWebUIToolbarEnabled()) {
+    return;
+  }
+  location_bar->AddChildView(std::make_unique<SidebarChatHost>(browser));
+}
+
+views::View* UpdateSidebarChatForLayout(LocationBarView* location_bar) {
+  SidebarChatHost* host = FindHost(location_bar);
+  if (!host) {
+    return nullptr;
+  }
+  // As with the site controls, typing needs the room.
+  const OmniboxController* controller = location_bar->GetOmniboxController();
+  const bool visible =
+      host->wants_visible() &&
+      !(controller && controller->edit_model()->user_input_in_progress());
+  host->SetVisible(visible);
+  return visible ? host : nullptr;
+}
+
+void ToggleChatFromSidebar(BrowserWindowInterface* browser) {
+  chrome::ExecuteCommand(browser, IDC_RAC_ASSISTANT_TOGGLE);
+}
+
+bool IsChatOpen(BrowserWindowInterface* browser) {
+  return ai::IsAssistantPanelOpen(browser);
+}
+

+using gfx::ARC_TO;
+using gfx::CANVAS_DIMENSIONS;
+using gfx::CLOSE;
+using gfx::CUBIC_TO;
+using gfx::MOVE_TO;
+using gfx::STROKE;
+
+// The Top bar Chat pill's speech bubble as an outline, at the stroke and
+// footprint of the site controls' tune icon beside it, so it is no heavier
+// than its neighbour.
+// clang-format off
+constexpr gfx::PathElement kChatOutlinePath[] = {
+    CANVAS_DIMENSIONS, 20,
+    STROKE, 1.5f,
+    MOVE_TO, 3.5f, 9.75f,
+    ARC_TO, 6.5f, 5.75f, 0, 0, 1, 16.5f, 9.75f,
+    ARC_TO, 6.5f, 5.75f, 0, 0, 1, 10, 15.5f,
+    CUBIC_TO, 7.16f, 15.5f, 4.72f, 15.66f, 3.58f, 15.79f,
+    CUBIC_TO, 4.8f, 14.39f, 3.5f, 12.01f, 3.5f, 9.75f,
+    CLOSE,
+};
+// clang-format on
+constexpr gfx::VectorIconRep kChatOutlineReps[] = {{kChatOutlinePath}};
+constexpr gfx::VectorIcon kChatOutlineIcon = {
+    kChatOutlineReps, std::size(kChatOutlineReps), "rac_chat_outline"};
+
+// The icon itself, drawn the way the site controls button beside it is.
+class ChatIconButton : public views::ImageButton {
+  METADATA_HEADER(ChatIconButton, views::ImageButton)
+
+ public:
+  explicit ChatIconButton(BrowserWindowInterface* browser) {
+    SetCallback(
+        base::BindRepeating(&ToggleChatFromSidebar, base::Unretained(browser)));
+    views::ConfigureVectorImageButton(this);
+    views::InstallCircleHighlightPathGenerator(this);
+    const std::u16string name =
+        l10n_util::GetStringUTF16(IDS_RAC_ASSISTANT_TOOLTIP);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kToggleButton);
+    GetViewAccessibility().SetCheckedState(ax::mojom::CheckedState::kFalse);
+    SetBorder(views::CreateEmptyBorder(
+        GetLayoutInsets(LOCATION_BAR_PAGE_ACTION_ICON_PADDING)));
+  }
+  ChatIconButton(const ChatIconButton&) = delete;
+  ChatIconButton& operator=(const ChatIconButton&) = delete;
+  ~ChatIconButton() override = default;
+
+  // Lit the way a toolbar button is while its side panel is open.
+  void ShowOpen(bool open) {
+    if (open == open_highlight_.has_value()) {
+      return;
+    }
+    if (open) {
+      open_highlight_ = AddAnchorHighlight();
+    } else {
+      open_highlight_.reset();
+    }
+    GetViewAccessibility().SetCheckedState(
+        open ? ax::mojom::CheckedState::kTrue
+             : ax::mojom::CheckedState::kFalse);
+  }
+
+  // views::ImageButton:
+  void OnThemeChanged() override {
+    views::ImageButton::OnThemeChanged();
+    const SkColor color = GetColorProvider()->GetColor(kColorOmniboxActionIcon);
+    views::SetImageFromVectorIconWithColor(
+        this, kChatOutlineIcon,
+        GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize),
+        views::IconColors(color, SkColorSetA(color, 0x66)));
+  }
+
+ private:
+  std::optional<views::Button::ScopedAnchorHighlight> open_highlight_;
+};
+
+BEGIN_METADATA(ChatIconButton)
+END_METADATA

+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_CHAT_STATE_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_CHAT_STATE_H_
+
+namespace rac {
+
+// What the Sidebar layout's Chat button does for one window.
+struct SidebarChatState {
+  // The button is created. False means no button view exists and nothing
+  // watches the chat panel.
+  bool exists = false;
+  bool visible = false;
+  // The button shows that the chat panel is open.
+  bool open = false;
+
+  friend bool operator==(const SidebarChatState&,
+                         const SidebarChatState&) = default;
+};
+
+// The Chat button in the address bar exists only for a regular profile
+// (never Incognito or Guest, as for every AI surface), while AI is on and
+// the layout is Sidebar; the Top bar layout has its own Chat pill. It hides
+// beside an internal page, where there's nothing for the chat to read, and
+// stays shown while the panel is open so it can close it.
+SidebarChatState GetSidebarChatState(bool regular_profile,
+                                     bool ai_enabled,
+                                     bool sidebar_layout,
+                                     bool blocked_here,
+                                     bool panel_open);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_CHAT_STATE_H_

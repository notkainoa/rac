+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_address_bar/sidebar_chat_state.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+constexpr SidebarChatState kNone = {.exists = false,
+                                    .visible = false,
+                                    .open = false};
+
+TEST(SidebarChatStateTest, NoButtonOutsideARegularProfile) {
+  // Incognito and Guest get no AI, even with AI on in the Sidebar layout.
+  for (bool blocked : {false, true}) {
+    for (bool open : {false, true}) {
+      EXPECT_EQ(GetSidebarChatState(/*regular_profile=*/false,
+                                    /*ai_enabled=*/true,
+                                    /*sidebar_layout=*/true, blocked, open),
+                kNone);
+    }
+  }
+}
+
+TEST(SidebarChatStateTest, NoButtonWhileAiIsOff) {
+  // Nothing exists with AI off, whatever else is true.
+  for (bool sidebar_layout : {false, true}) {
+    for (bool blocked : {false, true}) {
+      for (bool open : {false, true}) {
+        EXPECT_EQ(
+            GetSidebarChatState(/*regular_profile=*/true, /*ai_enabled=*/false,
+                                sidebar_layout, blocked, open),
+            kNone);
+      }
+    }
+  }
+}
+
+TEST(SidebarChatStateTest, NoButtonInTopBarLayout) {
+  // The Top bar layout has its own Chat pill.
+  for (bool blocked : {false, true}) {
+    for (bool open : {false, true}) {
+      EXPECT_EQ(
+          GetSidebarChatState(/*regular_profile=*/true, /*ai_enabled=*/true,
+                              /*sidebar_layout=*/false, blocked, open),
+          kNone);
+    }
+  }
+}
+
+TEST(SidebarChatStateTest, ShownBesideAWebPage) {
+  EXPECT_EQ(GetSidebarChatState(/*regular_profile=*/true, true, true,
+                                /*blocked_here=*/false,
+                                /*panel_open=*/false),
+            (SidebarChatState{.exists = true, .visible = true, .open = false}));
+}
+
+TEST(SidebarChatStateTest, StaysShownAndLitWhileThePanelIsOpen) {
+  EXPECT_EQ(GetSidebarChatState(/*regular_profile=*/true, true, true,
+                                /*blocked_here=*/false,
+                                /*panel_open=*/true),
+            (SidebarChatState{.exists = true, .visible = true, .open = true}));
+}
+
+TEST(SidebarChatStateTest, HiddenBesideAnInternalPage) {
+  // It still exists, so it comes back on the next web page without being
+  // built again.
+  for (bool open : {false, true}) {
+    EXPECT_EQ(
+        GetSidebarChatState(/*regular_profile=*/true, true, true,
+                            /*blocked_here=*/true, open),
+        (SidebarChatState{.exists = true, .visible = false, .open = false}));
+  }
+}
+
+}  // namespace
+}  // namespace rac

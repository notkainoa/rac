+SidebarChatState GetSidebarChatState(bool regular_profile,
+                                     bool ai_enabled,
+                                     bool sidebar_layout,
+                                     bool blocked_here,
+                                     bool panel_open) {
+  SidebarChatState state;
+  state.exists = regular_profile && ai_enabled && sidebar_layout;
+  state.visible = state.exists && !blocked_here;
+  state.open = state.visible && panel_open;
+  return state;
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_OMNIBOX_BLUR_HANDLER_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_OMNIBOX_BLUR_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/events/event_handler.h"
+
+class BrowserView;
+class VerticalTabStripRegionView;
+
+namespace rac {
+
+// Takes focus out of the address bar when the sidebar is clicked, as
+// clicking the page does: focus goes to the active tab's contents, which
+// closes the suggestions and brings the page's URL back. Installed as a
+// pre-target handler on the sidebar, so it sees every press in it, and it
+// never consumes one.
+class SidebarOmniboxBlur : public ui::EventHandler {
+ public:
+  SidebarOmniboxBlur(VerticalTabStripRegionView* region_view,
+                     BrowserView* browser_view);
+  SidebarOmniboxBlur(const SidebarOmniboxBlur&) = delete;
+  SidebarOmniboxBlur& operator=(const SidebarOmniboxBlur&) = delete;
+  ~SidebarOmniboxBlur() override;
+
+  // ui::EventHandler:
+  void OnMouseEvent(ui::MouseEvent* event) override;
+
+ private:
+  const raw_ptr<VerticalTabStripRegionView> region_view_;
+  const raw_ptr<BrowserView> browser_view_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_OMNIBOX_BLUR_HANDLER_H_

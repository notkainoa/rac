@@ -0,0 +1,56 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_address_bar/sidebar_omnibox_blur_handler.h"
+
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/focus/browser_focus_controller.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/omnibox/omnibox_view_views.h"
+#include "chrome/browser/ui/views/rac/sidebar_address_bar/sidebar_omnibox_blur.h"
+#include "ui/events/event.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/view.h"
+
+namespace rac {
+
+SidebarOmniboxBlur::SidebarOmniboxBlur(VerticalTabStripRegionView* region_view,
+                                       BrowserView* browser_view)
+    : region_view_(region_view), browser_view_(browser_view) {
+  CHECK(region_view_);
+  CHECK(browser_view_);
+  region_view_->AddPreTargetHandler(this);
+}
+
+SidebarOmniboxBlur::~SidebarOmniboxBlur() {
+  region_view_->RemovePreTargetHandler(this);
+}
+
+void SidebarOmniboxBlur::OnMouseEvent(ui::MouseEvent* event) {
+  if (event->type() != ui::EventType::kMousePressed) {
+    return;
+  }
+  // The common case, a press with the omnibox unfocused, ends here.
+  const views::FocusManager* focus_manager = region_view_->GetFocusManager();
+  const views::View* focused =
+      focus_manager ? focus_manager->GetFocusedView() : nullptr;
+  LocationBarView* location_bar =
+      focused ? browser_view_->GetLocationBarView() : nullptr;
+  if (!location_bar) {
+    return;
+  }
+
+  const views::View* target = static_cast<const views::View*>(event->target());
+  if (ShouldLeaveOmniboxForSidebarPress(
+          /*is_mouse_press=*/true,
+          /*omnibox_focused=*/focused == location_bar->omnibox_view(),
+          /*press_in_address_bar=*/location_bar->Contains(target))) {
+    BrowserFocusController::From(browser_view_->browser())
+        ->FocusWebContentsPane();
+  }
+}
+
+}  // namespace rac

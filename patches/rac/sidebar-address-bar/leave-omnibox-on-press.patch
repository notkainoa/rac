+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_address_bar/sidebar_omnibox_blur.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+TEST(SidebarOmniboxBlurTest, PressOutsideTheAddressBarLeavesIt) {
+  EXPECT_TRUE(ShouldLeaveOmniboxForSidebarPress(
+      /*is_mouse_press=*/true, /*omnibox_focused=*/true,
+      /*press_in_address_bar=*/false));
+}
+
+TEST(SidebarOmniboxBlurTest, PressInTheAddressBarStaysThere) {
+  EXPECT_FALSE(ShouldLeaveOmniboxForSidebarPress(
+      /*is_mouse_press=*/true, /*omnibox_focused=*/true,
+      /*press_in_address_bar=*/true));
+}
+
+TEST(SidebarOmniboxBlurTest, NothingToLeaveWhenTheOmniboxIsNotFocused) {
+  for (bool in_address_bar : {false, true}) {
+    EXPECT_FALSE(ShouldLeaveOmniboxForSidebarPress(
+        /*is_mouse_press=*/true, /*omnibox_focused=*/false, in_address_bar));
+  }
+}
+
+TEST(SidebarOmniboxBlurTest, OnlyPressesCount) {
+  // Moves, releases and scrolls over the sidebar never move focus.
+  for (bool in_address_bar : {false, true}) {
+    for (bool focused : {false, true}) {
+      EXPECT_FALSE(ShouldLeaveOmniboxForSidebarPress(
+          /*is_mouse_press=*/false, focused, in_address_bar));
+    }
+  }
+}
+
+}  // namespace
+}  // namespace rac

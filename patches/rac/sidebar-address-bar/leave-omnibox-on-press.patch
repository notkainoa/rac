+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_OMNIBOX_BLUR_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_OMNIBOX_BLUR_H_
+
+namespace rac {
+
+// Whether a mouse press in the sidebar takes focus out of the address bar.
+// A press on the page does, so a press on the sidebar does too. A press on
+// the address bar itself, where the user is placing the caret, never does.
+// The press itself is never consumed: the row or button under it still acts.
+bool ShouldLeaveOmniboxForSidebarPress(bool is_mouse_press,
+                                       bool omnibox_focused,
+                                       bool press_in_address_bar);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_ADDRESS_BAR_SIDEBAR_OMNIBOX_BLUR_H_

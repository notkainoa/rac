+
+    auto* section = AddChildView(std::make_unique<Section>(
+        IDS_RAC_SITE_CONTROLS_EXTENSIONS,
+        IDS_RAC_SITE_CONTROLS_MANAGE_EXTENSIONS,
+        base::BindRepeating(&SiteControlsView::OpenExtensionsPage,
+                            base::Unretained(this))));
+
+    std::vector<ToolbarActionViewModel*> actions;
+    for (const auto& id : model->action_ids()) {
+      if (ToolbarActionViewModel* action =
+              container->GetToolbarViewModel()->GetActionForId(id)) {
+        actions.push_back(action);
+      }
+    }
+    std::ranges::sort(actions,
+                      [](ToolbarActionViewModel* a, ToolbarActionViewModel* b) {
+                        return base::i18n::ToLower(a->GetActionName()) <
+                               base::i18n::ToLower(b->GetActionName());
+                      });
+
+    auto* grid = section->AddChildView(std::make_unique<views::View>());
+    grid->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical,
+        gfx::Insets::VH(0, GetHorizontalPadding()), kTileSpacing));
+    views::View* row = nullptr;
+    auto add_tile = [&](std::unique_ptr<IconTile> tile) {
+      if (!row || row->children().size() == kExtensionsPerRow) {
+        row = grid->AddChildView(std::make_unique<views::View>());
+        row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),

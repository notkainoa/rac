+
+void RacSiteControlsBubbleView::SetPermissionInfo(
+    const PermissionInfoList& permission_info_list,
+    ChosenObjectInfoList chosen_object_info_list) {
+  if (!permission_rows_) {
+    return;
+  }
+
+  std::vector<PageInfo::PermissionInfo> permissions;
+  for (ContentSettingsType type :
+       {ContentSettingsType::SOUND,
+        ContentSettingsType::AUTO_PICTURE_IN_PICTURE}) {
+    auto it = std::ranges::find_if(
+        permission_info_list, [type](const PageInfo::PermissionInfo& info) {
+          return info.type == type && !info.requesting_origin;
+        });
+    permissions.push_back(
+        it != permission_info_list.end() ? *it : GetPermissionInfo(type));
+  }
+  for (const PageInfo::PermissionInfo& info : permission_info_list) {
+    if (info.type != ContentSettingsType::SOUND &&
+        info.type != ContentSettingsType::AUTO_PICTURE_IN_PICTURE) {
+      permissions.push_back(info);
+    }
+  }
+
+  std::vector<ContentSettingsType> types;
+  for (const PageInfo::PermissionInfo& info : permissions) {
+    types.push_back(info.type);
+  }
+  if (types == toggle_row_types_) {
+    for (size_t i = 0; i < permissions.size(); ++i) {
+      toggle_rows_[i]->UpdatePermission(permissions[i]);
+    }
+    return;
+  }
+
+  // The site asked for something new while the bubble was open.
+  toggle_rows_.clear();
+  permission_rows_->RemoveAllChildViews();
+  for (const PageInfo::PermissionInfo& info : permissions) {
+    auto* toggle_row = permission_rows_->AddChildView(
+        std::make_unique<PermissionToggleRowView>(
+            ui_delegate_.get(), this, info, /*should_show_spacer_view=*/false));
+    toggle_row->AddObserver(this);
+    toggle_rows_.push_back(toggle_row);
+  }
+  toggle_row_types_ = std::move(types);
+  if (GetWidget()) {
+    SizeToContents();
+  }
+}
+
+PageInfo::PermissionInfo RacSiteControlsBubbleView::GetPermissionInfo(
+    ContentSettingsType type) const {
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(browser_->GetProfile());
+  PageInfo::PermissionInfo info;
+  info.type = type;
+  content_settings::SettingInfo setting_info;
+  PermissionSetting setting =
+      map->GetPermissionSetting(url_, url_, type, &setting_info);
+  info.source = setting_info.source;
+  // A setting that only comes from the default isn't specific to this site.
+  if (setting_info.primary_pattern == ContentSettingsPattern::Wildcard() &&
+      setting_info.secondary_pattern == ContentSettingsPattern::Wildcard()) {
+    info.default_setting = setting;
+  } else {
+    info.setting = setting;
+    info.default_setting = map->GetDefaultPermissionSetting(type);
+  }
+  return info;
+}
+
+void RacSiteControlsBubbleView::SetIdentityInfo(
+    const IdentityInfo& identity_info) {
+  if (!security_button_) {
+    return;
+  }
+  const bool secure = GetSecurityDescription(identity_info)->summary_style ==
+                      SecuritySummaryColor::GREEN;
+  const gfx::VectorIcon& icon =
+      secure ? vector_icons::kLockIcon
+             : vector_icons::kNotSecureWarningChromeRefreshOldIcon;
+  security_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(icon, ui::kColorIcon, kSmallIconSize));
+  security_button_->SetText(
+      l10n_util::GetStringUTF16(secure ? IDS_RAC_SITE_CONTROLS_SECURE
+                                       : IDS_RAC_SITE_CONTROLS_NOT_SECURE));
+  security_button_->SetVisible(true);
+  if (GetWidget()) {
+    SizeToContents();
+  }
+}

+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SITE_CONTROLS_SITE_CONTROLS_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SITE_CONTROLS_SITE_CONTROLS_BUTTON_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/button/image_button.h"
+
+class BrowserWindowInterface;
+class LocationBarView;
+
+namespace rac {
+class SiteControlsBubble;
+}  // namespace rac
+
+// The button at the end of the address bar that opens site controls, in the
+// sidebar and in the top bar alike. It takes the bookmark star's place, and
+// the site icon's while that only opens page info, which site controls
+// cover. Bookmarking stays on Cmd+D, the menus, and a tile in the bubble.
+class RacSiteControlsButton : public views::ImageButton {
+  METADATA_HEADER(RacSiteControlsButton, views::ImageButton)
+
+ public:
+  explicit RacSiteControlsButton(LocationBarView* location_bar);
+  RacSiteControlsButton(const RacSiteControlsButton&) = delete;
+  RacSiteControlsButton& operator=(const RacSiteControlsButton&) = delete;
+  ~RacSiteControlsButton() override;
+
+  // Hides the bookmark star, and returns whether this button should show.
+  bool UpdateForLayout();
+
+  bool IsBubbleShowing() const;
+
+  // views::ImageButton:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnThemeChanged() override;
+  void ViewHierarchyChanged(
+      const views::ViewHierarchyChangedDetails& details) override;
+
+ private:
+  void OnPressed();
+  void OnBubbleClosed();
+  void DestroyBubble();
+  void HideBookmarkStar();
+
+  const raw_ptr<LocationBarView> location_bar_;
+  // Only exists while the bubble is open or closing.
+  std::unique_ptr<rac::SiteControlsBubble> bubble_;
+  // A press that started while the bubble was open closes it; the release
+  // mustn't open it again.
+  bool suppress_next_press_ = false;
+  base::WeakPtrFactory<RacSiteControlsButton> weak_factory_{this};
+};
+
+namespace rac {
+
+// Hooks for LocationBarView. All do nothing for windows without the button,
+// such as popups and apps.
+void AddSiteControlsButton(LocationBarView* location_bar,
+                           BrowserWindowInterface* browser);
+// True when the site icon at the start of the address bar has nothing to say
+// beyond what site controls show: no label such as "Not secure", and no
+// danger warning.
+bool ShouldHideLocationIcon(LocationBarView* location_bar);
+// Returns the button when it should be laid out, otherwise null.
+views::View* UpdateSiteControlsForLayout(LocationBarView* location_bar);
+
+// While the address bar is in the sidebar the toolbar is hidden, so popups
+// that belong to its extension buttons anchor here instead. Null otherwise.
+views::View* GetSiteControlsAnchor(BrowserWindowInterface* browser);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SITE_CONTROLS_SITE_CONTROLS_BUTTON_H_

+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SITE_CONTROLS_SITE_CONTROLS_BUBBLE_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SITE_CONTROLS_SITE_CONTROLS_BUBBLE_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+
+class BrowserWindowInterface;
+class GURL;
+
+namespace views {
+class BubbleDialogDelegate;
+class Button;
+class View;
+class Widget;
+}  // namespace views
+
+namespace rac {
+
+// Site controls: quick actions, extensions, and settings for the current
+// site, opened from the button at the end of the address bar.
+//
+//   [Share] [Bookmark] [Developer tools] [Copy URL]
+//   Extensions                                Manage
+//   (one tile per extension, then + for the Chrome Web Store)
+//   Settings                                    More
+//   (sound, picture-in-picture, and whatever the site has asked for)
+//   ----------------------------------------------
+//   [Secure]                                     ...
+//
+// "Manage" and "More" appear while the pointer is over their section, or
+// while they have focus. The "..." menu has Print, Clear cache, Clear
+// cookies, and All site settings.
+//
+// Nothing here exists until the button is pressed, and all of it goes away
+// when the bubble closes.
+class SiteControlsBubble {
+ public:
+  // Shows the bubble under `anchor`. Returns null when the window has no
+  // page to control. `on_closed` runs, synchronously, when the bubble
+  // starts closing; the owner should destroy this object soon after.
+  static std::unique_ptr<SiteControlsBubble> Show(
+      views::Button* anchor,
+      BrowserWindowInterface* browser,
+      base::OnceClosure on_closed);
+
+  SiteControlsBubble(const SiteControlsBubble&) = delete;
+  SiteControlsBubble& operator=(const SiteControlsBubble&) = delete;
+  ~SiteControlsBubble();
+
+  void Close();
+  // True once the bubble has started closing, such as when it lost focus.
+  bool IsClosing() const;
+
+ private:
+  SiteControlsBubble();
+
+  void OnWidgetClosed();
+
+  // Outlives `widget_`, which is declared after it.
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  base::OnceClosure on_closed_;
+  bool closing_ = false;
+  base::WeakPtrFactory<SiteControlsBubble> weak_factory_{this};
+};
+
+// The system share menu, shown under `anchor`. Only available on macOS.
+bool CanShowSharePicker();
+void ShowSharePicker(views::View* anchor, const GURL& url);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SITE_CONTROLS_SITE_CONTROLS_BUBBLE_H_

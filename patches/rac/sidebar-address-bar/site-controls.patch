+void RacSiteControlsBubbleView::AddExtensions() {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  ExtensionsToolbarDesktop* container =
+      browser_view && browser_view->toolbar()
+          ? browser_view->toolbar()->extensions_container()
+          : nullptr;
+  ToolbarActionsModel* model = ToolbarActionsModel::Get(browser_->GetProfile());
+  if (!container || !model) {
+    return;
+  }
+
+  auto* section = AddChildView(std::make_unique<Section>(
+      IDS_RAC_SITE_CONTROLS_EXTENSIONS, IDS_RAC_SITE_CONTROLS_MANAGE_EXTENSIONS,
+      base::BindRepeating(&RacSiteControlsBubbleView::OpenExtensionsPage,
+                          base::Unretained(this))));
+
+  std::vector<ToolbarActionViewModel*> actions;
+  for (const auto& id : model->action_ids()) {
+    if (ToolbarActionViewModel* action =
+            container->GetToolbarViewModel()->GetActionForId(id)) {
+      actions.push_back(action);
+    }
+  }
+  std::ranges::sort(actions,
+                    [](ToolbarActionViewModel* a, ToolbarActionViewModel* b) {
+                      return base::i18n::ToLower(a->GetActionName()) <
+                             base::i18n::ToLower(b->GetActionName());
+                    });
+
+  if (actions.empty()) {
+    auto* label = section->AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(IDS_RAC_SITE_CONTROLS_NO_EXTENSIONS),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::VH(0, GetHorizontalPadding())));
+    return;
+  }
+
+  auto* grid = section->AddChildView(std::make_unique<views::View>());
+  grid->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::VH(0, GetHorizontalPadding()), kTileSpacing));
+  views::View* row = nullptr;
+  content::WebContents* contents = web_contents();
+  for (size_t i = 0; i < actions.size(); ++i) {
+    if (i % kExtensionsPerRow == 0) {
+      row = grid->AddChildView(std::make_unique<views::View>());
+      row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+          kTileSpacing));
+    }
+    ToolbarActionViewModel* action = actions[i];
+    auto* tile = row->AddChildView(CreateIconTile(
+        base::BindRepeating(&RacSiteControlsBubbleView::RunExtensionAction,
+                            base::Unretained(this), action->GetId()),
+        action->GetIcon(contents,
+                        gfx::Size(kExtensionIconSize, kExtensionIconSize)),
+        action->GetActionName()));
+    tile->SetTooltipText(action->GetTooltip(contents));
+    tile->SetPreferredSize(gfx::Size(kTileHeight, kTileHeight));
+  }
+}

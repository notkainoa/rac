+
+  // PageInfoUI:
+  void SetPermissionInfo(
+      const PermissionInfoList& permission_info_list,
+      ChosenObjectInfoList chosen_object_info_list) override {
+    if (!permission_rows_) {
+      return;
+    }
+
+    // Sound and auto picture-in-picture come first and are listed even when
+    // the site hasn't used them; PageInfo only reports them after use.
+    std::vector<PageInfo::PermissionInfo> permissions;
+    for (ContentSettingsType type :
+         {ContentSettingsType::SOUND,
+          ContentSettingsType::AUTO_PICTURE_IN_PICTURE}) {
+      auto it = std::ranges::find_if(
+          permission_info_list, [type](const PageInfo::PermissionInfo& info) {
+            return info.type == type && !info.requesting_origin;
+          });
+      permissions.push_back(it != permission_info_list.end()
+                                ? *it
+                                : GetDefaultPermissionInfo(type));
+    }
+    for (const PageInfo::PermissionInfo& info : permission_info_list) {
+      if (info.type != ContentSettingsType::SOUND &&
+          info.type != ContentSettingsType::AUTO_PICTURE_IN_PICTURE) {
+        permissions.push_back(info);
+      }
+    }
+
+    std::vector<ContentSettingsType> types;
+    for (const PageInfo::PermissionInfo& info : permissions) {
+      types.push_back(info.type);
+    }
+    if (types == toggle_row_types_) {
+      for (size_t i = 0; i < permissions.size(); ++i) {
+        toggle_rows_[i]->UpdatePermission(permissions[i]);
+      }
+      return;
+    }
+
+    // The first fill, or the site asked for something new while the bubble
+    // was open.
+    toggle_rows_.clear();
+    permission_rows_->RemoveAllChildViews();
+    for (const PageInfo::PermissionInfo& info : permissions) {
+      auto* row = permission_rows_->AddChildView(
+          std::make_unique<PermissionToggleRowView>(
+              ui_delegate_.get(), this, info,
+              /*should_show_spacer_view=*/false));
+      row->AddObserver(this);
+      toggle_rows_.push_back(row);
+    }
+    toggle_row_types_ = std::move(types);
+    PreferredSizeChanged();
+  }
+
+  void SetIdentityInfo(const IdentityInfo& identity_info) override {
+    if (!security_button_) {

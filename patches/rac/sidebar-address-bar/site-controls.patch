+// Reloads the page once its site data is gone, then deletes itself.
+class ReloadWhenCleared : public content::BrowsingDataRemover::Observer {
+ public:
+  ReloadWhenCleared(content::BrowsingDataRemover* remover,
+                    content::WebContents* web_contents)
+      : web_contents_(web_contents->GetWeakPtr()) {
+    observation_.Observe(remover);
+  }
+
+  // content::BrowsingDataRemover::Observer:
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    if (web_contents_) {
+      web_contents_->GetController().Reload(
+          content::ReloadType::BYPASSING_CACHE,
+          /*check_for_repost=*/true);
+    }
+    delete this;
+  }
+
+ private:
+  base::WeakPtr<content::WebContents> web_contents_;
+  base::ScopedObservation<content::BrowsingDataRemover,
+                          content::BrowsingDataRemover::Observer>
+      observation_{this};
+};
+
+GURL GetPageUrl(content::WebContents* web_contents) {
+  // The virtual URL is the one the address bar shows, as in page info.
+  content::NavigationEntry* entry =
+      web_contents->GetController().GetLastCommittedEntry();
+  return entry ? entry->GetVirtualURL() : web_contents->GetLastCommittedURL();
+}

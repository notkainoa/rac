+  void AddExtensions() {
+    ExtensionsToolbarDesktop* container = GetExtensionsContainer(browser_);
+    ToolbarActionsModel* model =
+        ToolbarActionsModel::Get(browser_->GetProfile());
+    if (!container || !model) {

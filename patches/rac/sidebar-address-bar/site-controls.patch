+// A rounded tile with an icon, for actions and extensions.
+class IconTile : public views::ImageButton {
+  METADATA_HEADER(IconTile, views::ImageButton)
+
+ public:
+  IconTile(PressedCallback callback,
+           const ui::ImageModel& image,
+           const std::u16string& name)
+      : views::ImageButton(std::move(callback)) {
+    SetImageModel(views::Button::STATE_NORMAL, image);
+    SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+    SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    SetAnimationDuration(base::Milliseconds(120));
+    InstallTileFocusRing(this);
+  }
+
+  // views::ImageButton:
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    PaintTileBackground(canvas, *this, hover_animation().GetCurrentValue());
+  }
+  void StateChanged(ButtonState old_state) override {
+    views::ImageButton::StateChanged(old_state);
+    SchedulePaint();
+  }
+};

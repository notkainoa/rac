+// A link that fades in while the pointer is over its section, or while it
+// has focus, so it stays reachable from the keyboard.
+class RevealLink : public views::Link {
+  METADATA_HEADER(RevealLink, views::Link)
+
+ public:
+  RevealLink(const std::u16string& text, base::RepeatingClosure callback)
+      : views::Link(text,
+                    views::style::CONTEXT_LABEL,
+                    views::style::STYLE_BODY_4) {
+    SetCallback(std::move(callback));
+    SetForceUnderline(false);
+    // The fade needs a transparent layer, and subpixel text can't be drawn
+    // onto one.
+    SetSubpixelRenderingEnabled(false);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetOpacity(0.0f);
+  }
+
+  void SetHovered(bool hovered) {
+    hovered_ = hovered;
+    UpdateOpacity();
+  }
+
+  // views::Link:
+  void OnThemeChanged() override {
+    views::Link::OnThemeChanged();
+    // Quiet like the heading beside it, rather than link blue. Links only
+    // take a resolved color.
+    SetEnabledColor(GetColorProvider()->GetColor(kColorRacTextSecondary));
+  }
+  void OnFocus() override {
+    views::Link::OnFocus();
+    UpdateOpacity();
+  }
+  void OnBlur() override {
+    views::Link::OnBlur();
+    UpdateOpacity();
+  }
+
+ private:
+  void UpdateOpacity() {
+    const float opacity = hovered_ || HasFocus() ? 1.0f : 0.0f;
+    if (layer()->GetTargetOpacity() == opacity) {
+      return;
+    }
+    // With reduced motion the link appears at once.
+    ui::ScopedLayerAnimationSettings settings(layer()->GetAnimator());
+    settings.SetTransitionDuration(gfx::Animation::ShouldRenderRichAnimation()
+                                       ? kRevealDuration
+                                       : base::TimeDelta());
+    layer()->SetOpacity(opacity);
+  }
+
+  bool hovered_ = false;
+};
+
+BEGIN_METADATA(RevealLink)
+END_METADATA

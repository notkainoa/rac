+// Matches the other rac popups, such as the space editor.
+constexpr int kBubbleRadius = 12;
+constexpr int kTileRadius = 8;
+constexpr int kTileHeight = 40;
+constexpr int kTileSpacing = 8;
+constexpr int kSectionSpacing = 14;
+constexpr size_t kExtensionsPerRow = 6;
+constexpr int kActionIconSize = 18;
+constexpr int kExtensionIconSize = 20;
+constexpr int kSmallIconSize = 16;
+constexpr int kSectionHeaderBottomMargin = 6;
+constexpr base::TimeDelta kRevealDuration = base::Milliseconds(150);
+
+// The permission rows come from page info and use its padding, so
+// everything else lines up with them.
+int GetHorizontalPadding() {
+  return ChromeLayoutProvider::Get()
+      ->GetInsetsMetric(INSETS_PAGE_INFO_HOVER_BUTTON)
+      .left();
+}
+
+// A faint fill of the text color reads as a control on any background, as
+// in the space editor. It deepens as the pointer arrives.
+void PaintTileBackground(gfx::Canvas* canvas,
+                         const views::Button& button,
+                         double hover) {
+  const ui::ColorProvider* colors = button.GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const bool pressed = button.GetState() == views::Button::STATE_PRESSED;
+  const bool disabled = button.GetState() == views::Button::STATE_DISABLED;
+  SkAlpha alpha =
+      static_cast<SkAlpha>(gfx::Tween::IntValueBetween(hover, 0x0F, 0x1C));
+  if (pressed) {
+    alpha = 0x26;
+  } else if (disabled) {
+    alpha = 0x08;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(colors->GetColor(kColorRacTextPrimary), alpha));
+  canvas->DrawRoundRect(gfx::RectF(button.GetLocalBounds()), kTileRadius,
+                        flags);
+}
+
+// Buttons have a focus ring already; this gives it the tile's shape.
+void InstallTileFocusRing(views::Button* button) {
+  views::InstallRoundRectHighlightPathGenerator(button, gfx::Insets(),
+                                                kTileRadius);
+}

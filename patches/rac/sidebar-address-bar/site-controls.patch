+
+#import <AppKit/AppKit.h>
+
+#include "chrome/browser/ui/views/rac/site_controls/site_controls_bubble_view.h"
+#include "net/base/apple/url_conversions.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+namespace rac {
+
+bool CanShowSharePicker() {
+  return true;
+}
+
+void ShowSharePicker(views::View* anchor, const GURL& url) {
+  if (!anchor || !anchor->GetWidget() || !url.is_valid()) {
+    return;
+  }
+  NSWindow* window = anchor->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  NSView* content_view = window.contentView;
+  if (!content_view) {
+    return;
+  }
+  NSURL* ns_url = net::NSURLWithGURL(url);
+  if (!ns_url) {
+    return;
+  }
+
+  const NSRect screen_rect =
+      gfx::ScreenRectToNSRect(anchor->GetBoundsInScreen());
+  const NSRect window_rect = [window convertRectFromScreen:screen_rect];
+  const NSRect view_rect = [content_view convertRect:window_rect fromView:nil];
+
+  NSSharingServicePicker* picker =
+      [[NSSharingServicePicker alloc] initWithItems:@[ ns_url ]];
+  [picker showRelativeToRect:view_rect
+                      ofView:content_view
+               preferredEdge:content_view.isFlipped ? NSMaxYEdge : NSMinYEdge];
+}
+
+}  // namespace rac

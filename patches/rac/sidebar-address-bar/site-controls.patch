+std::unique_ptr<IconTile> CreateActionTile(
+    views::Button::PressedCallback callback,
+    const gfx::VectorIcon& icon,
+    int name_id) {
+  auto tile = std::make_unique<IconTile>(
+      std::move(callback),
+      ui::ImageModel::FromVectorIcon(icon, kColorRacTextPrimary,
+                                     kActionIconSize),
+      l10n_util::GetStringUTF16(name_id));
+  tile->SetImageModel(views::Button::STATE_DISABLED,
+                      ui::ImageModel::FromVectorIcon(
+                          icon, kColorRacTextTertiary, kActionIconSize));
+  tile->SetPreferredSize(gfx::Size(0, kTileHeight));
+  return tile;
+}

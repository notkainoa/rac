+SiteControlsBubble::SiteControlsBubble() = default;
+
+SiteControlsBubble::~SiteControlsBubble() {
+  // The widget goes first; it still refers to the delegate.
+  widget_.reset();
+  delegate_.reset();
+}
+
+// static
+std::unique_ptr<SiteControlsBubble> SiteControlsBubble::Show(
+    views::Button* anchor,
+    BrowserWindowInterface* browser,
+    base::OnceClosure on_closed) {
+  content::WebContents* web_contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return nullptr;
+  }
+
+  // In the sidebar the bubble opens toward the page; in the top bar it
+  // opens below the button, inside the window.
+  const views::BubbleBorder::Arrow arrow =
+      IsInSidebar(anchor) ? GetSidebarBubbleArrow(anchor, /*open_below=*/true)
+                          : views::BubbleBorder::TOP_RIGHT;
+
+  auto bubble = base::WrapUnique(new SiteControlsBubble());
+  bubble->on_closed_ = std::move(on_closed);
+  auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+      anchor, arrow, views::BubbleBorder::STANDARD_SHADOW,
+      /*autosize=*/true);
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->SetShowCloseButton(false);
+  delegate->SetShowTitle(false);
+  delegate->set_margins(gfx::Insets());
+  delegate->set_corner_radius(kBubbleRadius);
+  delegate->SetBackgroundColor(kColorProfileMenuBackground);
+  delegate->set_fixed_width(ChromeLayoutProvider::Get()->GetDistanceMetric(
+      views::DISTANCE_BUBBLE_PREFERRED_WIDTH));
+  delegate->SetAccessibleTitle(
+      l10n_util::GetStringUTF16(IDS_RAC_SITE_CONTROLS));
+  auto* contents = delegate->SetContentsView(
+      std::make_unique<SiteControlsView>(anchor, browser, web_contents));
+  bubble->delegate_ = std::move(delegate);
+  bubble->widget_ = views::BubbleDialogDelegate::CreateBubble(
+      bubble->delegate_.get(), base::BindOnce(
+                                   [](base::WeakPtr<SiteControlsBubble> bubble,
+                                      views::Widget::ClosedReason) {
+                                     if (bubble) {
+                                       bubble->OnWidgetClosed();
+                                     }
+                                   },
+                                   bubble->weak_factory_.GetWeakPtr()));
+  contents->Initialize();
+  bubble->widget_->Show();
+  return bubble;
+}
+
+void SiteControlsBubble::Close() {
+  if (widget_ && !widget_->IsClosed()) {
+    widget_->Close();
+  }
+}
+
+bool SiteControlsBubble::IsClosing() const {
+  return closing_ || !widget_ || widget_->IsClosed();
+}
+
+void SiteControlsBubble::OnWidgetClosed() {
+  closing_ = true;
+  if (on_closed_) {
+    std::move(on_closed_).Run();
+  }
+}

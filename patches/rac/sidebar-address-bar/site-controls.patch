+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItemWithStringId(kAllSiteSettings,
+                                     IDS_RAC_SITE_CONTROLS_ALL_SITE_SETTINGS);
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+    menu_runner_->RunMenuAt(GetWidget(), /*button_controller=*/nullptr,
+                            more_button_->GetAnchorBoundsInScreen(),
+                            views::MenuAnchorPosition::kTopRight,
+                            ui::mojom::MenuSourceType::kNone);
+  }
+
+  void ClearSiteData(uint64_t data_types) {
+    content::WebContents* contents = web_contents();
+    if (!contents || !IsWebsite()) {
+      return;
+    }
+    std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+        url_, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+    // IP addresses and hosts like localhost have no registrable domain.
+    if (domain.empty()) {
+      domain = url_.host();
+    }
+    auto filter = content::BrowsingDataFilterBuilder::Create(
+        content::BrowsingDataFilterBuilder::Mode::kDelete);
+    filter->AddRegisterableDomain(domain);
+
+    content::BrowsingDataRemover* remover =
+        contents->GetBrowserContext()->GetBrowsingDataRemover();
+    // Deletes itself once the page has reloaded.
+    auto* observer = new ReloadWhenCleared(remover, contents);
+    remover->RemoveWithFilterAndReply(
+        base::Time(), base::Time::Max(), data_types,
+        content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB,
+        std::move(filter), observer);
+    CloseWidget();
+  }
+
+  // Opens page info in place of this bubble, at the given subpage.
+  void ShowPageInfo(std::optional<ContentSettingsType> permission_page,
+                    bool security_page) {
+    content::WebContents* contents = web_contents();
+    views::View* anchor = anchor_;
+    if (!contents || !anchor->GetWidget()) {
+      return;
+    }
+    CloseWidget();
+
+    PageInfoBubbleSpecification::Builder builder(
+        views::BubbleAnchor(anchor), anchor->GetWidget()->GetNativeWindow(),
+        contents, GetPageUrl(contents));
+    builder.AddInitializedCallback(base::DoNothing())
+        .AddPageInfoClosingCallback(base::DoNothing());
+    if (permission_page) {
+      builder.ShowPermissionPage(*permission_page);
+    }
+    views::BubbleDialogDelegateView* bubble =
+        PageInfoBubbleView::CreatePageInfoBubble(builder.Build());
+    if (IsInSidebar(anchor)) {
+      bubble->SetArrow(GetSidebarBubbleArrow(anchor, /*open_below=*/true));
+    }
+    if (security_page) {
+      if (auto* page_info = views::AsViewClass<PageInfoBubbleView>(bubble)) {
+        page_info->OpenSecurityPage();
+      }
+    }
+    bubble->GetWidget()->Show();
+  }
+
+  const raw_ptr<views::Button> anchor_;
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const GURL url_;
+
+  std::unique_ptr<ChromePageInfoUiDelegate> ui_delegate_;
+  std::unique_ptr<PageInfo> presenter_;
+
+  raw_ptr<views::View> permission_rows_ = nullptr;
+  std::vector<raw_ptr<PermissionToggleRowView>> toggle_rows_;
+  std::vector<ContentSettingsType> toggle_row_types_;
+  raw_ptr<views::LabelButton> security_button_ = nullptr;
+  raw_ptr<views::Button> more_button_ = nullptr;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};

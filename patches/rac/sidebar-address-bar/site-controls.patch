+bool RacSiteControlsBubbleView::IsCommandIdEnabled(int command_id) const {
+  switch (command_id) {
+    case kClearCache:
+    case kClearCookies:
+      return IsWebsite();
+    default:
+      return true;
+  }
+}
+
+void RacSiteControlsBubbleView::ExecuteCommand(int command_id,
+                                               int event_flags) {
+  switch (command_id) {
+    case kClearCache:
+      ClearSiteData(content::BrowsingDataRemover::DATA_TYPE_CACHE);
+      break;
+    case kClearCookies:
+      ClearSiteData(content::BrowsingDataRemover::DATA_TYPE_COOKIES);
+      break;
+    case kAllSiteSettings: {
+      BrowserWindowInterface* browser = browser_;
+      GetWidget()->Close();
+      chrome::ShowSettingsSubPage(browser, chrome::kContentSettingsSubPage);
+      break;
+    }
+  }
+}
+
+void RacSiteControlsBubbleView::ClearSiteData(uint64_t data_types) {
+  content::WebContents* contents = web_contents();
+  if (!contents || !IsWebsite()) {
+    return;
+  }
+  std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+      url_, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  // IP addresses and hosts like localhost have no registrable domain.
+  if (domain.empty()) {
+    domain = url_.host();
+  }
+  auto filter = content::BrowsingDataFilterBuilder::Create(
+      content::BrowsingDataFilterBuilder::Mode::kDelete);
+  filter->AddRegisterableDomain(domain);
+
+  content::BrowsingDataRemover* remover =
+      contents->GetBrowserContext()->GetBrowsingDataRemover();
+  // Deletes itself once the page has reloaded.
+  auto* observer = new ReloadWhenCleared(remover, contents);
+  remover->RemoveWithFilterAndReply(
+      base::Time(), base::Time::Max(), data_types,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB,
+      std::move(filter), observer);
+  GetWidget()->Close();
+}
+
+void RacSiteControlsBubbleView::OpenSecurityPage() {
+  ShowPageInfo(std::nullopt, /*security_page=*/true);
+}
+
+void RacSiteControlsBubbleView::OpenPermissionPage(ContentSettingsType type) {
+  ShowPageInfo(type, /*security_page=*/false);
+}
+
+void RacSiteControlsBubbleView::ShowPageInfo(
+    std::optional<ContentSettingsType> permission_page,
+    bool security_page) {
+  content::WebContents* contents = web_contents();
+  views::View* anchor = anchor_button_;
+  if (!contents || !anchor->GetWidget()) {
+    return;
+  }
+  GetWidget()->Close();
+
+  PageInfoBubbleSpecification::Builder builder(
+      views::BubbleAnchor(anchor), anchor->GetWidget()->GetNativeWindow(),
+      contents, GetPageUrl(contents));
+  builder.AddInitializedCallback(base::DoNothing())
+      .AddPageInfoClosingCallback(base::DoNothing());
+  if (permission_page) {
+    builder.ShowPermissionPage(*permission_page);
+  }
+  views::BubbleDialogDelegateView* bubble =
+      PageInfoBubbleView::CreatePageInfoBubble(builder.Build());
+  bubble->SetArrow(rac::GetSidebarBubbleArrow(anchor, /*open_below=*/true));
+  if (security_page) {
+    if (auto* page_info = views::AsViewClass<PageInfoBubbleView>(bubble)) {
+      page_info->OpenSecurityPage();
+    }
+  }
+  bubble->GetWidget()->Show();
+}
+
+void RacSiteControlsBubbleView::CloseBubble() {
+  GetWidget()->Close();
+}
+
+void RacSiteControlsBubbleView::PrimaryPageChanged(content::Page& page) {
+  GetWidget()->Close();
+}
+
+void RacSiteControlsBubbleView::OnVisibilityChanged(
+    content::Visibility visibility) {
+  if (visibility == content::Visibility::HIDDEN) {
+    GetWidget()->Close();
+  }
+}
+
+void RacSiteControlsBubbleView::WebContentsDestroyed() {
+  GetWidget()->Close();
+}

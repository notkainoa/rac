+  add(base::BindRepeating(&RacSiteControlsBubbleView::RunCommand,
+                          base::Unretained(this), IDC_PRINT),
+      vector_icons::kPrintIcon, IDS_RAC_SITE_CONTROLS_PRINT,
+      chrome::IsCommandEnabled(browser_, IDC_PRINT));
+  add(base::BindRepeating(&RacSiteControlsBubbleView::RunCommand,
+                          base::Unretained(this), IDC_DEV_TOOLS_TOGGLE),
+      vector_icons::kCodeIcon, IDS_RAC_SITE_CONTROLS_DEVELOPER_TOOLS,
+      chrome::IsCommandEnabled(browser_, IDC_DEV_TOOLS_TOGGLE));
+  add(base::BindRepeating(&RacSiteControlsBubbleView::RunCommand,
+                          base::Unretained(this), IDC_COPY_URL),
+      vector_icons::kContentCopyIcon, IDS_RAC_SITE_CONTROLS_COPY_URL,
+      chrome::IsCommandEnabled(browser_, IDC_COPY_URL));

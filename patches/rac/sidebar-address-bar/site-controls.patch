+  void ShowMoreMenu() {
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    menu_model_->AddItemWithStringId(kPrint, IDS_RAC_SITE_CONTROLS_PRINT);
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItemWithStringId(kClearCache,
+                                     IDS_RAC_SITE_CONTROLS_CLEAR_CACHE);
+    menu_model_->AddItemWithStringId(kClearCookies,

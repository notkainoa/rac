+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/button/image_button.h"
+
+class BrowserWindowInterface;
+class LocationBarView;
+
+namespace views {
+class Widget;
+}  // namespace views
+
+// The button at the end of the address bar that opens site controls. It only
+// shows while the address bar is in the sidebar, where it replaces the
+// bookmark star and the site icon.
+class RacSiteControlsButton : public views::ImageButton {
+  METADATA_HEADER(RacSiteControlsButton, views::ImageButton)
+
+ public:
+  explicit RacSiteControlsButton(LocationBarView* location_bar);
+  RacSiteControlsButton(const RacSiteControlsButton&) = delete;
+  RacSiteControlsButton& operator=(const RacSiteControlsButton&) = delete;
+  ~RacSiteControlsButton() override;
+
+  // Shows or hides what this button replaces, and returns whether the button
+  // itself should show.
+  bool UpdateForLayout();
+
+  bool IsBubbleShowing() const;
+
+  // views::ImageButton:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnThemeChanged() override;
+  void ViewHierarchyChanged(
+      const views::ViewHierarchyChangedDetails& details) override;
+
+ private:
+  void OnPressed();
+  void UpdateBookmarkStar(bool hide);
+
+  const raw_ptr<LocationBarView> location_bar_;
+  base::WeakPtr<views::Widget> bubble_widget_;
+  // A press that started while the bubble was open closes it; the release
+  // mustn't open it again.
+  bool suppress_next_press_ = false;
+  bool hid_bookmark_star_ = false;
+};
+
+namespace rac {
+
+// Hooks for LocationBarView.
+void AddSiteControlsButton(LocationBarView* location_bar);
+bool ShouldHideLocationIcon(const LocationBarView* location_bar);
+// Returns the button when it should be laid out, otherwise null.
+views::View* UpdateSiteControlsForLayout(LocationBarView* location_bar);
+
+// While the address bar is in the sidebar the toolbar is hidden, so bubbles
+// that belong to its extension buttons anchor here instead. Null otherwise.
+views::View* GetSiteControlsAnchor(BrowserWindowInterface* browser);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SITE_CONTROLS_SITE_CONTROLS_BUTTON_H_

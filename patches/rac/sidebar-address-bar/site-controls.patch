+
+    content::WebContents* contents = web_contents();
+    for (ToolbarActionViewModel* action : actions) {
+      auto* tile = add_tile(std::make_unique<IconTile>(
+          base::BindRepeating(&SiteControlsView::RunExtensionAction,
+                              base::Unretained(this), action->GetId()),
+          action->GetIcon(contents,
+                          gfx::Size(kExtensionIconSize, kExtensionIconSize)),
+          action->GetActionName()));
+      tile->SetTooltipText(action->GetTooltip(contents));
+    }
+    add_tile(std::make_unique<IconTile>(
+        base::BindRepeating(&SiteControlsView::OpenWebStore,
+                            base::Unretained(this)),
+        ui::ImageModel::FromVectorIcon(kAddIcon, kColorRacTextSecondary,

+// A titled section of the bubble whose link shows on hover.
+class Section : public views::View {
+  METADATA_HEADER(Section, views::View)
+
+ public:
+  Section(int title_id,
+          std::optional<int> link_id,
+          base::RepeatingClosure link_callback) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical));
+    SetNotifyEnterExitOnChild(true);
+
+    auto* header = AddChildView(std::make_unique<views::View>());
+    header->SetLayoutManager(std::make_unique<views::FlexLayout>())
+        ->SetOrientation(views::LayoutOrientation::kHorizontal)
+        .SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    header->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(0, GetHorizontalPadding(), kSectionHeaderBottomMargin,
+                          GetHorizontalPadding()));
+
+    auto* title = header->AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(title_id), views::style::CONTEXT_LABEL,
+        views::style::STYLE_BODY_4_MEDIUM));
+    title->SetEnabledColor(ui::kColorSysOnSurfaceSubtle);
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToMinimum,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+
+    if (link_id) {
+      link_ = header->AddChildView(std::make_unique<RevealLink>(
+          l10n_util::GetStringUTF16(*link_id), std::move(link_callback)));
+    }
+  }
+
+  // views::View:
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    if (link_) {
+      link_->SetHovered(true);
+    }
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    if (link_) {
+      link_->SetHovered(false);
+    }
+  }
+
+ private:
+  raw_ptr<RevealLink> link_ = nullptr;
+};

+    ExtensionsToolbarDesktop* container = GetExtensionsContainer(browser_);
+    ToolbarActionViewModel* action =
+        container ? container->GetToolbarViewModel()->GetActionForId(action_id)
+                  : nullptr;
+    // In the sidebar the popup anchors to the same button as this bubble,
+    // so close first.

+#include "chrome/browser/ui/actions/chrome_action_id.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/omnibox/omnibox_controller.h"
+#include "chrome/browser/ui/omnibox/omnibox_edit_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/page_action/page_action_container_view.h"
+#include "chrome/browser/ui/views/page_action/page_action_view.h"
+#include "chrome/browser/ui/views/rac/sidebar_address_bar/sidebar_header_view.h"
+#include "chrome/browser/ui/views/rac/site_controls/site_controls_bubble_view.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/events/event.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+RacSiteControlsButton* FindButton(const LocationBarView* location_bar) {
+  for (views::View* child : location_bar->children()) {
+    if (auto* button = views::AsViewClass<RacSiteControlsButton>(child)) {
+      return button;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+RacSiteControlsButton::RacSiteControlsButton(LocationBarView* location_bar)
+    : location_bar_(location_bar) {
+  SetCallback(base::BindRepeating(&RacSiteControlsButton::OnPressed,
+                                  base::Unretained(this)));
+  views::ConfigureVectorImageButton(this);
+  const std::u16string name = l10n_util::GetStringUTF16(IDS_RAC_SITE_CONTROLS);
+  SetTooltipText(name);
+  GetViewAccessibility().SetName(name);
+  SetBorder(views::CreateEmptyBorder(
+      GetLayoutInsets(LOCATION_BAR_ICON_INTERIOR_PADDING)));
+  SetVisible(false);
+}
+
+RacSiteControlsButton::~RacSiteControlsButton() = default;
+
+void RacSiteControlsButton::OnThemeChanged() {
+  views::ImageButton::OnThemeChanged();
+  views::SetImageFromVectorIconWithColor(
+      this, vector_icons::kTuneIcon,
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize),
+      views::IconColors(kColorOmniboxResultsIcon, ui::kColorIconDisabled));
+}
+
+bool RacSiteControlsButton::UpdateForLayout() {
+  const bool in_sidebar = rac::IsInSidebarHeader(location_bar_);
+  UpdateBookmarkStar(in_sidebar);
+  if (!in_sidebar) {
+    return false;
+  }
+  // Typing needs the room, and the controls are about the page, not the
+  // text being typed.
+  const OmniboxController* controller = location_bar_->GetOmniboxController();
+  return !(controller && controller->edit_model()->user_input_in_progress());
+}
+
+void RacSiteControlsButton::UpdateBookmarkStar(bool hide) {
+  page_actions::PageActionContainerView* container =
+      location_bar_->page_action_container();
+  page_actions::PageActionView* star =
+      container ? container->GetPageActionView(kActionBookmarkThisTab)
+                : nullptr;
+  if (!star) {
+    return;
+  }
+  // The star's model shows it again on every update, so it's hidden on every
+  // layout.
+  if (hide && star->GetVisible()) {
+    star->SetVisible(false);
+    hid_bookmark_star_ = true;
+  } else if (!hide && hid_bookmark_star_) {
+    hid_bookmark_star_ = false;
+    star->SetVisible(star->GetDeclaredVisible());
+  }
+}
+
+bool RacSiteControlsButton::IsBubbleShowing() const {
+  // Clicking this button deactivates the bubble, which closes it before the
+  // press arrives. The widget lives on until the close finishes.
+  return !!bubble_widget_;
+}
+
+bool RacSiteControlsButton::OnMousePressed(const ui::MouseEvent& event) {
+  suppress_next_press_ = IsBubbleShowing();
+  return views::ImageButton::OnMousePressed(event);
+}
+
+void RacSiteControlsButton::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  views::ImageButton::ViewHierarchyChanged(details);
+  // The address bar moved between the toolbar and the sidebar.
+  if (details.is_add && details.child != this &&
+      details.child->Contains(this)) {
+    location_bar_->InvalidateLayout();
+  }
+}
+
+void RacSiteControlsButton::OnPressed() {
+  if (suppress_next_press_) {
+    suppress_next_press_ = false;
+    return;
+  }
+  if (IsBubbleShowing()) {
+    if (!bubble_widget_->IsClosed()) {
+      bubble_widget_->Close();
+    }
+    return;
+  }
+  BrowserWindowInterface* browser = location_bar_->browser();
+  if (!browser) {
+    return;
+  }
+  views::Widget* widget = RacSiteControlsBubbleView::Show(this, browser);
+  bubble_widget_ = widget ? widget->GetWeakPtr() : nullptr;
+}
+
+BEGIN_METADATA(RacSiteControlsButton)
+END_METADATA
+
+namespace rac {
+
+void AddSiteControlsButton(LocationBarView* location_bar) {
+  location_bar->AddChildView(
+      std::make_unique<RacSiteControlsButton>(location_bar));
+}
+
+bool ShouldHideLocationIcon(const LocationBarView* location_bar) {
+  return FindButton(location_bar) && IsInSidebarHeader(location_bar);
+}
+
+views::View* UpdateSiteControlsForLayout(LocationBarView* location_bar) {
+  RacSiteControlsButton* button = FindButton(location_bar);
+  if (!button) {
+    return nullptr;
+  }
+  const bool visible = button->UpdateForLayout();
+  button->SetVisible(visible);
+  return visible ? button : nullptr;
+}
+
+views::View* GetSiteControlsAnchor(BrowserWindowInterface* browser) {
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  LocationBarView* location_bar =
+      browser_view ? browser_view->GetLocationBarView() : nullptr;
+  RacSiteControlsButton* button =
+      location_bar ? FindButton(location_bar) : nullptr;
+  return button && button->IsDrawn() ? button : nullptr;
+}
+
+}  // namespace rac

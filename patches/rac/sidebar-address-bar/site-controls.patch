+// "Manage" and "More" appear while the pointer is over their section.
+class RacSiteControlsBubbleView : public views::BubbleDialogDelegateView,
+                                  public content::WebContentsObserver,
+                                  public PageInfoUI,
+                                  public PageInfoNavigationHandler,
+                                  public PermissionToggleRowViewObserver,
+                                  public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(RacSiteControlsBubbleView, views::BubbleDialogDelegateView)
+

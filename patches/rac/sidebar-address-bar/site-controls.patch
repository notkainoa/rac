+}  // namespace
+
+// static
+views::Widget* RacSiteControlsBubbleView::Show(
+    views::Button* anchor,
+    BrowserWindowInterface* browser) {
+  content::WebContents* web_contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return nullptr;
+  }
+  auto bubble = base::WrapUnique(
+      new RacSiteControlsBubbleView(anchor, browser, web_contents));
+  views::Widget* widget =
+      views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+  widget->Show();
+  return widget;
+}
+
+RacSiteControlsBubbleView::RacSiteControlsBubbleView(
+    views::Button* anchor,
+    BrowserWindowInterface* browser,
+    content::WebContents* web_contents)
+    : views::BubbleDialogDelegateView(
+          views::BubbleDialogDelegateView::CreatePassKey(),
+          anchor,
+          rac::GetSidebarBubbleArrow(anchor, /*open_below=*/true)),
+      content::WebContentsObserver(web_contents),
+      anchor_button_(anchor),
+      browser_(browser),
+      url_(GetPageUrl(web_contents)) {
+  SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  SetShowCloseButton(false);
+  SetShowTitle(false);
+  SetTitle(IDS_RAC_SITE_CONTROLS);
+
+  ChromeLayoutProvider* provider = ChromeLayoutProvider::Get();
+  set_fixed_width(
+      provider->GetDistanceMetric(views::DISTANCE_BUBBLE_PREFERRED_WIDTH));
+  const int vertical_margin =
+      provider->GetInsetsMetric(views::INSETS_DIALOG).top();
+  set_margins(gfx::Insets::VH(vertical_margin, 0));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      provider->GetDistanceMetric(views::DISTANCE_UNRELATED_CONTROL_VERTICAL)));
+
+  if (IsWebsite()) {
+    ui_delegate_ =
+        std::make_unique<ChromePageInfoUiDelegate>(web_contents, url_);
+    presenter_ = std::make_unique<PageInfo>(
+        std::make_unique<ChromePageInfoDelegate>(web_contents), web_contents,
+        url_);
+  }
+
+  AddActions();
+  AddExtensions();
+  AddSettings();
+  AddFooter();
+
+  // Fills in the settings and the connection button.
+  if (presenter_) {
+    presenter_->InitializeUiState(this, base::DoNothing());
+  }
+}

+// Hooks for code outside the sidebar. All are safe to call with any
+// BrowserView and do nothing when the address bar isn't in the sidebar.
+bool IsAddressBarInSidebar(const views::View* browser_view);
+bool IsSidebarHeaderShown(const views::View* browser_view);
+void UpdateSidebarAddressBar(BrowserView* browser_view);
+void RestoreToolbarControls(BrowserView* browser_view);
+void RevealSidebarForAddressBar(BrowserView* browser_view);
+bool ShouldKeepSidebarRevealed(const BrowserView* browser_view);
+int GetMinimumSidebarWidth(const BrowserView* browser_view);
+
+// True for views in the sidebar's header, such as the address bar.
+bool IsInSidebarHeader(const views::View* view);
+
+// True for views in the sidebar's header or footer. Menus opened from them
+// open toward the page.
+bool IsInSidebar(const views::View* view);
+
+// The arrow for a bubble anchored to `anchor` in the sidebar, so the bubble
+// opens toward the page, below the anchor or above it.
+views::BubbleBorder::Arrow GetSidebarBubbleArrow(const views::View* anchor,
+                                                 bool open_below);
+
+// In frameless mode the window buttons fade with the chrome they sit in:
+// the sidebar when it holds the address bar, otherwise the toolbar.
+float GetWindowButtonsRevealRatio(const BrowserView* browser_view);
+// Sets `in_header` when `point_in_region` is over the sidebar's header or
+// footer, and returns whether that spot drags the window.
+bool IsPositionInSidebarHeaderCaption(BrowserView* browser_view,
+                                      views::View* region,
+                                      const gfx::Point& point_in_region,
+                                      bool* in_header);
+
+// See RacSidebarHeaderView::OnBrowserLayout().
+void UpdateSidebarHeaderForLayout(const views::View* browser_view,
+                                  const gfx::Rect& sidebar_bounds,
+                                  const gfx::Rect& window_buttons,
+                                  bool floating);
+
+// See RacSidebarHeaderView::GetTitlebarHeight().
+std::optional<int> GetSidebarHeaderTitlebarHeight(
+    const BrowserView* browser_view);
+
+// Lets the address bar in the sidebar grow to fit the rows of its suggestion
+// popup. `popup` is null once the popup closes.
+void OnSidebarAddressBarPopupChanged(views::View* location_bar,
+                                     const views::View* popup);
+
+}  // namespace rac

+}
+
+bool IsInSidebarHeader(const views::View* view) {
+  for (; view; view = view->parent()) {
+    if (views::IsViewClass<RacSidebarHeaderView>(view)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsInSidebar(const views::View* view) {
+  for (; view; view = view->parent()) {
+    if (views::IsViewClass<RacSidebarHeaderView>(view) ||
+        views::IsViewClass<RacSidebarFooterView>(view)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+views::BubbleBorder::Arrow GetSidebarBubbleArrow(const views::View* anchor,
+                                                 bool open_below) {
+  // The sidebar is on whichever side of the window the anchor is on.
+  bool sidebar_on_left = true;
+  if (const views::Widget* widget = anchor->GetWidget()) {
+    const gfx::Rect bounds =
+        anchor->ConvertRectToWidget(anchor->GetLocalBounds());
+    sidebar_on_left =
+        bounds.CenterPoint().x() < widget->GetRootView()->width() / 2;
+  }
+  if (open_below) {
+    return sidebar_on_left ? views::BubbleBorder::TOP_LEFT
+                           : views::BubbleBorder::TOP_RIGHT;
+  }
+  return sidebar_on_left ? views::BubbleBorder::BOTTOM_LEFT
+                         : views::BubbleBorder::BOTTOM_RIGHT;
+}
+
+float GetWindowButtonsRevealRatio(const BrowserView* browser_view) {
+  return IsAddressBarInSidebar(browser_view)
+             ? browser_view->GetSideChromeRevealRatio()
+             : browser_view->GetTopChromeRevealRatio();
+}
+
+bool IsPositionInSidebarHeaderCaption(BrowserView* browser_view,
+                                      views::View* region,
+                                      const gfx::Point& point_in_region,
+                                      bool* in_header) {
+  auto* header = HeaderFor(browser_view);
+  *in_header = false;
+  if (!header || header->parent() != region) {
+    return false;
+  }
+  auto hit = [&](views::View* view, gfx::Point* point) {
+    *point = point_in_region;
+    views::View::ConvertPointToTarget(region, view, point);
+    return view->GetVisible() && view->HitTestPoint(*point);
+  };
+  gfx::Point point;
+  if (hit(header, &point)) {
+    *in_header = true;
+    return header->IsPositionInWindowCaption(point);
+  }
+  for (views::View* child : region->children()) {
+    auto* footer = views::AsViewClass<RacSidebarFooterView>(child);
+    if (footer && hit(footer, &point)) {
+      *in_header = true;
+      return footer->IsPositionInWindowCaption(point);
+    }
+  }
+  return false;
+}
+
+void UpdateSidebarHeaderForLayout(const views::View* browser_view,
+                                  const gfx::Rect& sidebar_bounds,
+                                  const gfx::Rect& window_buttons,
+                                  bool floating) {
+  if (auto* header = HeaderFor(browser_view)) {
+    header->OnBrowserLayout(sidebar_bounds, window_buttons, floating);
+  }
+}
+
+std::optional<int> GetSidebarHeaderTitlebarHeight(
+    const BrowserView* browser_view) {
+  const auto* header = HeaderFor(browser_view);
+  return header ? header->GetTitlebarHeight() : std::nullopt;
+}
+
+void OnSidebarAddressBarPopupChanged(views::View* location_bar,
+                                     const views::View* popup) {
+  int width = 0;
+  if (popup) {
+    for (const views::View* row : popup->children()) {
+      if (row->GetVisible()) {
+        width = std::max(width, row->GetPreferredSize().width());
+      }
+    }
+  }
+  for (views::View* view = location_bar; view; view = view->parent()) {
+    if (auto* header = views::AsViewClass<RacSidebarHeaderView>(view)) {
+      header->SetSuggestionsWidth(width);
+      return;
+    }
+  }
+}

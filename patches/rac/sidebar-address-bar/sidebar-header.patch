+  // are in the browser view's coordinates; `window_buttons` is empty when the
+  // buttons aren't in the client area, such as in fullscreen. `floating` is
+  // true when the sidebar floats over the page in frameless mode.
+  void OnBrowserLayout(const gfx::Rect& sidebar_bounds,
+                       const gfx::Rect& window_buttons,
+                       bool floating);
+

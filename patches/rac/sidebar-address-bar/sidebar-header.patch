+void RacSidebarHeaderView::RelayoutWindowButtons() {
+  views::Widget* widget = GetWidget();
+  if (!widget) {
+    return;
+  }
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  // The theme frame reads the titlebar height, and centers the window buttons
+  // in it, when it lays out.
+  NSView* theme_frame = window.contentView.superview;
+  theme_frame.needsLayout = YES;
+}

+#include "chrome/browser/ui/views/toolbar/app_menu_control.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/class_property.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/text_utils.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/layout/flex_layout.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/view_targeter.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(RacSidebarHeaderView*)
+
+namespace {
+
+DEFINE_UI_CLASS_PROPERTY_KEY(RacSidebarHeaderView*,
+                             kRacSidebarHeaderKey,
+                             nullptr)
+
+// Space between the controls row and the address bar, and below the address
+// bar before the tab list.
+constexpr int kRowGap = 4;
+constexpr int kBottomPadding = 6;
+
+// The titlebar height Helium gets from the toolbar when the toolbar holds
+// these controls; see BrowserNativeWidgetMac::GetWindowFrameTitlebarHeight().
+// Keeping it leaves the window buttons where they are without this feature.
+int GetToolbarTitlebarHeight() {
+  return std::max(GetLayoutConstant(LayoutConstant::kLocationBarHeight),
+                  GetLayoutConstant(LayoutConstant::kToolbarButtonHeight)) +
+         GetLayoutInsets(LayoutInset::TOOLBAR_INTERIOR_MARGIN).height();
+}
+
+// Room after the address bar's text when it grows to fit it.
+constexpr int kTextEndPadding = 8;
+
+// Controls shown before the flexible gap, in order.
+constexpr ui::ElementIdentifier kLeadingControls[] = {
+    kToolbarBackButtonElementId,
+    kToolbarForwardButtonElementId,
+    kReloadButtonElementId,
+    kToolbarHomeButtonElementId,
+};
+
+// Controls shown after the flexible gap, in order.
+constexpr ui::ElementIdentifier kTrailingControls[] = {
+    kPinnedToolbarActionsContainerElementId,
+};
+
+// Controls at the two ends of the footer.
+constexpr ui::ElementIdentifier kFooterLeadingControls[] = {
+    kToolbarAvatarButtonElementId,
+};
+constexpr ui::ElementIdentifier kFooterTrailingControls[] = {
+    kToolbarAppMenuButtonElementId,
+};
+
+// Space between the tab list's bottom buttons and the footer.
+constexpr int kFooterTopGap = 4;
+
+views::View* FindToolbarChild(views::View* parent, ui::ElementIdentifier id) {
+  for (views::View* child : parent->children()) {
+    if (child->GetProperty(views::kElementIdentifierKey) == id) {
+      return child;
+    }
+  }
+  return nullptr;
+}
+
+views::FlexSpecification FlexFor(views::View* view) {
+  // Nothing here has an overflow menu, so every control keeps its size.
+  return views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                                  views::MaximumFlexSizeRule::kPreferred)
+      .WithOrder(1);
+}
+
+bool HitsVisibleChild(views::View* parent, const gfx::Point& point) {
+  for (views::View* child : parent->children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    gfx::Point point_in_child = point;
+    views::View::ConvertPointToTarget(parent, child, &point_in_child);
+    if (child->HitTestPoint(point_in_child)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+RacSidebarHeaderView* HeaderFor(const views::View* browser_view) {
+  return browser_view ? browser_view->GetProperty(kRacSidebarHeaderKey)
+                      : nullptr;
+}
+
+}  // namespace
+
+RacSidebarFooterView::RacSidebarFooterView(int horizontal_padding) {
+  SetProperty(views::kMarginsKey,
+              gfx::Insets::TLBR(kFooterTopGap, horizontal_padding, 0,
+                                horizontal_padding));
+  // Given the sidebar's spare height, this view's FlexLayout reports all of it
+  // as its preferred height, which floats the buttons up from the bottom.
+  // Always take the unbounded preferred size instead.
+  SetProperty(views::kFlexBehaviorKey,
+              views::FlexSpecification(base::BindRepeating(
+                  [](const views::View* view, const views::SizeBounds&) {
+                    return view->GetPreferredSize();
+                  })));
+  SetLayoutManager(std::make_unique<views::FlexLayout>());
+  spacer_ = AddChildView(std::make_unique<views::View>());
+  SetCollapsed(false);
+  SetVisible(false);
+}
+
+RacSidebarFooterView::~RacSidebarFooterView() = default;
+
+void RacSidebarFooterView::AddLeadingControl(views::View* view) {
+  AddChildViewAt(view, GetIndexOf(spacer_).value());
+  view->SetProperty(views::kFlexBehaviorKey, FlexFor(view));
+}
+
+void RacSidebarFooterView::AddTrailingControl(views::View* view) {
+  AddChildView(view);
+  view->SetProperty(views::kFlexBehaviorKey, FlexFor(view));
+}
+
+void RacSidebarFooterView::SetCollapsed(bool collapsed) {
+  auto* layout = static_cast<views::FlexLayout*>(GetLayoutManager());
+  layout->SetOrientation(collapsed ? views::LayoutOrientation::kVertical
+                                   : views::LayoutOrientation::kHorizontal);
+  layout->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  spacer_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               collapsed ? views::MaximumFlexSizeRule::kPreferred
+                                         : views::MaximumFlexSizeRule::kUnbounded)
+          .WithOrder(2));
+  InvalidateLayout();
+}
+
+bool RacSidebarFooterView::IsPositionInWindowCaption(const gfx::Point& point) {
+  // Empty space drags the window, like the toolbar did.
+  return !HitsVisibleChild(this, point);
+}
+
+BEGIN_METADATA(RacSidebarFooterView)
+END_METADATA
+
+RacSidebarHeaderView::RacSidebarHeaderView(
+    BrowserView* browser_view,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_view_(browser_view), state_controller_(state_controller) {
+  browser_view_->SetProperty(kRacSidebarHeaderKey, this);
+
+  controls_row_ = AddChildView(std::make_unique<views::View>());
+  controls_row_->SetLayoutManager(std::make_unique<views::FlexLayout>())
+      ->SetOrientation(views::LayoutOrientation::kHorizontal)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+
+  exclusion_spacer_ =
+      controls_row_->AddChildView(std::make_unique<views::View>());
+  exclusion_spacer_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                               views::MaximumFlexSizeRule::kPreferred));
+
+  flex_spacer_ = controls_row_->AddChildView(std::make_unique<views::View>());
+  flex_spacer_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded)
+          .WithOrder(3));
+
+  pref_change_registrar_.Init(
+      browser_view_->browser()->GetProfile()->GetPrefs());
+  pref_change_registrar_.Add(
+      rac::kAddressBarInSidebar,
+      base::BindRepeating(&RacSidebarHeaderView::UpdatePlacement,
+                          base::Unretained(this)));
+
+  // These subscriptions are made before the toolbar's own, so the controls
+  // are back in the toolbar before it relayouts for a new mode.
+  mode_will_change_subscription_ =
+      state_controller_->RegisterOnModeWillChange(base::BindRepeating(
+          &RacSidebarHeaderView::OnModeWillChange, base::Unretained(this)));
+  mode_changed_subscription_ =
+      state_controller_->RegisterOnModeChanged(base::BindRepeating(
+          &RacSidebarHeaderView::OnModeChanged, base::Unretained(this)));
+  collapse_subscription_ =
+      state_controller_->RegisterOnCollapseChanged(base::BindRepeating(
+          &RacSidebarHeaderView::OnCollapseStateChanged,
+          base::Unretained(this)));
+
+  SetVisible(false);
+}
+
+RacSidebarHeaderView::~RacSidebarHeaderView() {
+  if (parent()) {
+    parent()->SetEventTargeter(nullptr);
+  }
+  RestoreControls();
+  browser_view_->ClearProperty(kRacSidebarHeaderKey);
+}
+
+// static
+RacSidebarHeaderView* RacSidebarHeaderView::From(
+    const BrowserView* browser_view) {
+  return HeaderFor(browser_view);
+}
+
+bool RacSidebarHeaderView::ShouldHostControls() const {
+  const ToolbarView* toolbar = browser_view_->toolbar();
+  return toolbar && toolbar->location_bar_view() &&
+         state_controller_->ShouldDisplayVerticalTabs() &&
+         rac::WantsAddressBarInSidebar(browser_view_->browser());
+}
+
+RacSidebarFooterView* RacSidebarHeaderView::GetFooter() const {
+  if (!parent()) {
+    return nullptr;
+  }
+  for (views::View* child : parent()->children()) {
+    if (auto* footer = views::AsViewClass<RacSidebarFooterView>(child)) {
+      return footer;
+    }
+  }
+  return nullptr;
+}
+
+void RacSidebarHeaderView::UpdatePlacement() {
+  const bool should_host = ShouldHostControls();
+  if (should_host != is_hosting_controls()) {
+    if (should_host) {
+      BorrowControls();
+    } else {
+      RestoreControls();
+    }
+  }
+  UpdateVisibility();
+}
+
+void RacSidebarHeaderView::BorrowControls() {
+  ToolbarView* toolbar = browser_view_->toolbar();
+  LocationBarView* location_bar = toolbar->location_bar_view();
+  if (location_bar->parent() != toolbar) {
+    return;
+  }
+
+  // Record every index before moving anything, so restoring in ascending
+  // order rebuilds the toolbar exactly.
+  RacSidebarFooterView* footer = GetFooter();
+  std::vector<views::View*> leading;
+  std::vector<views::View*> trailing;
+  std::vector<views::View*> footer_leading;
+  std::vector<views::View*> footer_trailing;
+  auto record = [&](views::View* view, std::vector<views::View*>* list) {
+    BorrowedView borrowed;
+    borrowed.view = view;
+    borrowed.toolbar_index = toolbar->GetIndexOf(view).value();
+    if (const auto* flex = view->GetProperty(views::kFlexBehaviorKey)) {
+      borrowed.flex = *flex;
+    }
+    borrowed_.push_back(std::move(borrowed));
+    if (list) {
+      list->push_back(view);
+    }
+  };
+  for (ui::ElementIdentifier id : kLeadingControls) {
+    if (views::View* view = FindToolbarChild(toolbar, id)) {
+      record(view, &leading);
+    }
+  }
+  for (ui::ElementIdentifier id : kTrailingControls) {
+    if (views::View* view = FindToolbarChild(toolbar, id)) {
+      record(view, &trailing);
+    }
+  }
+  // Without a footer, its controls stay at the end of the top row.
+  for (ui::ElementIdentifier id : kFooterLeadingControls) {
+    if (views::View* view = FindToolbarChild(toolbar, id)) {
+      record(view, footer ? &footer_leading : &trailing);
+    }
+  }
+  for (ui::ElementIdentifier id : kFooterTrailingControls) {
+    if (views::View* view = FindToolbarChild(toolbar, id)) {
+      record(view, footer ? &footer_trailing : &trailing);
+    }
+  }
+  record(location_bar, nullptr);
+
+  for (views::View* view : leading) {
+    controls_row_->AddChildViewAt(
+        view, controls_row_->GetIndexOf(flex_spacer_).value());
+    view->SetProperty(views::kFlexBehaviorKey, FlexFor(view));
+  }
+  for (views::View* view : trailing) {
+    controls_row_->AddChildView(view);
+    view->SetProperty(views::kFlexBehaviorKey, FlexFor(view));
+  }
+  for (views::View* view : footer_leading) {
+    footer->AddLeadingControl(view);
+  }
+  for (views::View* view : footer_trailing) {
+    footer->AddTrailingControl(view);
+  }
+  location_bar_ = AddChildView(location_bar);
+
+  toolbar->InvalidateLayout();
+  browser_view_->InvalidateLayout();
+  UpdateTitlebarHeight();
+}
+
+void RacSidebarHeaderView::RestoreControls() {
+  if (borrowed_.empty()) {
+    return;
+  }
+  SetPoppedOut(false);
+
+  // During window teardown the toolbar may already be gone; the borrowed
+  // views are then destroyed with this view.
+  ToolbarView* toolbar = browser_view_->toolbar();
+  if (toolbar) {
+    std::sort(borrowed_.begin(), borrowed_.end(),
+              [](const BorrowedView& a, const BorrowedView& b) {
+                return a.toolbar_index < b.toolbar_index;
+              });
+    for (const BorrowedView& borrowed : borrowed_) {
+      views::View* view = borrowed.view;
+      toolbar->AddChildViewAt(
+          view, std::min(borrowed.toolbar_index, toolbar->children().size()));
+      if (borrowed.flex) {
+        view->SetProperty(views::kFlexBehaviorKey, *borrowed.flex);
+      } else {
+        view->ClearProperty(views::kFlexBehaviorKey);
+      }
+    }
+  }
+  borrowed_.clear();
+  location_bar_ = nullptr;
+  suggestions_width_ = 0;
+
+  UpdateTitlebarHeight();
+  UpdateVisibility();
+  if (toolbar) {
+    toolbar->UpdateToolbarLayout();
+  }
+  browser_view_->InvalidateLayout();
+}
+
+void RacSidebarHeaderView::UpdateVisibility() {
+  const bool expanded = state_controller_->GetCollapseState() ==
+                        tabs::VerticalTabStripCollapseState::kExpanded;
+  if (RacSidebarFooterView* footer = GetFooter()) {
+    footer->SetCollapsed(!expanded);
+    footer->SetVisible(is_hosting_controls());
+  }
+  const bool visible = is_hosting_controls() && expanded;
+  if (visible == GetVisible()) {
+    return;
+  }
+  SetVisible(visible);
+  browser_view_->InvalidateLayout();
+}
+
+void RacSidebarHeaderView::RevealForAddressBar() {
+  if (!is_hosting_controls()) {
+    return;
+  }
+  UpdateVisibility();
+  // The address bar can only take focus once it's laid out and drawn.
+  browser_view_->DeprecatedLayoutImmediately();
+}
+
+void RacSidebarHeaderView::SetPoppedOut(bool popped_out) {
+  if (!location_bar_) {
+    popped_out = false;
+  }
+  if (popped_out_ == popped_out) {
+    return;
+  }
+  popped_out_ = popped_out;
+  if (location_bar_) {
+    // A layer lets the address bar draw past the sidebar's edge, above the
+    // page.
+    if (popped_out_ && !location_bar_->layer()) {
+      location_bar_->SetPaintToLayer();
+      location_bar_->layer()->SetFillsBoundsOpaquely(false);
+      owns_location_bar_layer_ = true;
+    } else if (!popped_out_ && owns_location_bar_layer_) {
+      location_bar_->DestroyLayer();
+      owns_location_bar_layer_ = false;
+    }
+  }
+  UpdateSidebarClip();
+  InvalidateLayout();
+}
+
+int RacSidebarHeaderView::GetLocationBarWidth() const {
+  if (!popped_out_) {
+    return width();
+  }
+  constexpr int kMaxWidth = 640;
+  constexpr int kPageMargin = 16;
+  gfx::Point origin;
+  views::View::ConvertPointToTarget(this, browser_view_, &origin);
+  const int available = browser_view_->width() - origin.x() - kPageMargin;
+  const int wanted = std::max(GetTextWidth(), suggestions_width_);
+  return std::max(width(), std::min({wanted, kMaxWidth, available}));
+}
+
+int RacSidebarHeaderView::GetTextWidth() const {
+  const OmniboxViewViews* omnibox = location_bar_->omnibox_view();
+  if (!omnibox) {
+    return 0;
+  }
+  // The icons and padding around the text keep their size as the address
+  // bar grows, so only the text needs measuring.
+  const int text_width =
+      gfx::GetStringWidth(omnibox->GetText(), omnibox->GetFontList());
+  const int surroundings =
+      location_bar_->width() - omnibox->GetContentsBounds().width();
+  return text_width + surroundings + kTextEndPadding;
+}
+
+void RacSidebarHeaderView::SetSuggestionsWidth(int width) {
+  if (suggestions_width_ == width) {
+    return;
+  }
+  suggestions_width_ = width;
+  if (popped_out_) {
+    InvalidateLayout();
+  }
+}
+
+void RacSidebarHeaderView::UpdateSidebarClip() {
+  if (parent()) {
+    parent()->SetClipLayerToVisibleBounds(floating_ && !popped_out_);
+  }
+}
+
+bool RacSidebarHeaderView::DoesIntersectRect(const views::View* target,
+                                             const gfx::Rect& rect) const {
+  if (target->GetLocalBounds().Intersects(rect)) {
+    return true;
+  }
+  if (!popped_out_ || !location_bar_ || !location_bar_->GetVisible()) {
+    return false;
+  }
+  const gfx::Rect location_bar_bounds = views::View::ConvertRectToTarget(
+      location_bar_, target, location_bar_->GetLocalBounds());
+  return location_bar_bounds.Intersects(rect);
+}
+
+void RacSidebarHeaderView::AddedToWidget() {
+  views::View::AddedToWidget();
+  SetEventTargeter(std::make_unique<views::ViewTargeter>(this));
+  if (parent()) {
+    parent()->SetEventTargeter(std::make_unique<views::ViewTargeter>(this));
+  }
+  if (GetFocusManager()) {
+    focus_manager_ = GetFocusManager();
+    focus_manager_->AddFocusChangeListener(this);
+  }
+}
+
+void RacSidebarHeaderView::OnDidChangeFocus(views::View* focused_before,
+                                            views::View* focused_now) {
+  SetPoppedOut(location_bar_ && location_bar_->Contains(focused_now));
+}
+
+void RacSidebarHeaderView::RemovedFromWidget() {
+  if (focus_manager_) {
+    focus_manager_->RemoveFocusChangeListener(this);
+    focus_manager_ = nullptr;
+  }
+  views::View::RemovedFromWidget();
+}
+
+void RacSidebarHeaderView::OnBrowserLayout(const gfx::Rect& sidebar_bounds,
+                                           const gfx::Rect& window_buttons,
+                                           bool floating) {
+  if (floating_ != floating) {
+    floating_ = floating;
+    UpdateSidebarClip();
+  }
+
+  gfx::Size exclusion;
+  if (!window_buttons.IsEmpty() &&
+      window_buttons.right() > sidebar_bounds.x() &&
+      window_buttons.bottom() > sidebar_bounds.y()) {
+    exclusion = gfx::Size(window_buttons.right() - sidebar_bounds.x(),
+                          window_buttons.bottom() - sidebar_bounds.y());
+  }
+  // y() is where the sidebar's own layout last put the header, which doesn't
+  // depend on the header's height.
+  const int top = sidebar_bounds.y() + y();
+  if (window_buttons_exclusion_ != exclusion || top_in_browser_view_ != top) {
+    window_buttons_exclusion_ = exclusion;
+    top_in_browser_view_ = top;
+    UpdateExclusionSpacer();
+  }
+  // Called on every frame of the frameless sidebar's reveal animation.
+  UpdateTitlebarHeight();
+}
+
+std::optional<int> RacSidebarHeaderView::GetTitlebarHeight() const {
+  return titlebar_height_;
+}
+
+void RacSidebarHeaderView::UpdateTitlebarHeight() {
+  std::optional<int> height;
+  if (is_hosting_controls()) {
+    // A floating sidebar starts below the window's top edge, so its first row
+    // is lower than the toolbar was. Move the window buttons down onto it
+    // only while it's on screen; they fade with it, so the move isn't seen.
+    const bool floating_sidebar_shown =
+        floating_ && browser_view_->GetSideChromeRevealRatio() > 0.0f;
+    height = floating_sidebar_shown
+                 ? 2 * top_in_browser_view_ + GetRowHeight()
+                 : GetToolbarTitlebarHeight();
+  }
+  if (titlebar_height_ == height) {
+    return;
+  }
+  titlebar_height_ = height;
+  RelayoutWindowButtons();
+}
+
+void RacSidebarHeaderView::UpdateExclusionSpacer() {
+  const gfx::Insets* margins = GetProperty(views::kMarginsKey);
+  const int leading = margins ? margins->left() : 0;
+  const int width =
+      window_buttons_exclusion_.IsEmpty()
+          ? 0
+          : std::max(0, window_buttons_exclusion_.width() - leading);
+  exclusion_spacer_->SetPreferredSize(gfx::Size(width, 0));
+  // Called from the browser's layout, so only invalidate downward.
+  controls_row_->InvalidateLayout();
+  InvalidateLayout();
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
+
+int RacSidebarHeaderView::GetRowHeight() const {
+  // AppKit centers the window buttons in the titlebar, so a row centered in
+  // the titlebar's height lines up with them; see UpdateTitlebarHeight().
+  return std::max(GetLayoutConstant(LayoutConstant::kToolbarButtonHeight),
+                  GetToolbarTitlebarHeight() - 2 * top_in_browser_view_);
+}
+
+bool RacSidebarHeaderView::ShouldKeepSidebarRevealed() const {
+  if (!is_hosting_controls() || !GetWidget()) {
+    return false;
+  }
+
+  const RacSidebarFooterView* footer = GetFooter();
+  auto contains = [&](const views::View* view) {
+    return Contains(view) || (footer && footer->Contains(view));
+  };
+
+  const views::FocusManager* focus_manager = GetFocusManager();
+  if (focus_manager && contains(focus_manager->GetFocusedView())) {
+    return true;
+  }
+
+  // Menus aren't bubbles, so the app menu needs its own check.
+  if (auto* provider = ToolbarButtonProvider::From(browser_view_->browser())) {
+    const AppMenuControl* app_menu = provider->GetAppMenuControl();
+    if (app_menu && app_menu->IsMenuShowing()) {
+      return true;
+    }
+  }
+
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(GetWidget()->GetNativeView())) {
+    if (!widget->IsVisible() || widget->IsClosed() ||
+        !widget->widget_delegate()) {
+      continue;
+    }
+    views::BubbleDialogDelegate* bubble =
+        widget->widget_delegate()->AsBubbleDialogDelegate();
+    if (bubble && bubble->GetAnchorView() &&
+        contains(bubble->GetAnchorView())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+int RacSidebarHeaderView::GetMinimumSidebarWidth() const {
+  if (!GetVisible()) {
+    return 0;
+  }
+  const gfx::Insets* margins = GetProperty(views::kMarginsKey);
+  return GetMinimumSize().width() + (margins ? margins->width() : 0);
+}
+
+bool RacSidebarHeaderView::IsPositionInWindowCaption(const gfx::Point& point) {
+  // Empty space in the header drags the window, like the toolbar did.
+  for (const BorrowedView& borrowed : borrowed_) {
+    views::View* view = borrowed.view;
+    if (!view->GetVisible() || !Contains(view)) {
+      continue;
+    }
+    gfx::Point point_in_view = point;
+    views::View::ConvertPointToTarget(this, view, &point_in_view);
+    if (view->HitTestPoint(point_in_view)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+gfx::Size RacSidebarHeaderView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return GetMinimumSize();
+}
+
+gfx::Size RacSidebarHeaderView::GetMinimumSize() const {
+  if (!location_bar_) {
+    return gfx::Size();
+  }
+  const int width = std::max(controls_row_->GetMinimumSize().width(),
+                             location_bar_->GetMinimumSize().width());
+  const int height = GetRowHeight() + kRowGap +
+                     location_bar_->GetPreferredSize().height() +
+                     kBottomPadding;
+  return gfx::Size(width, height);
+}
+
+void RacSidebarHeaderView::Layout(PassKey) {
+  const int row_height = GetRowHeight();
+  // Keep the controls at their minimum while the sidebar animates narrower
+  // than that; the sidebar clips them.
+  const int row_width =
+      std::max(width(), controls_row_->GetMinimumSize().width());
+  controls_row_->SetBounds(0, 0, row_width, row_height);
+  if (location_bar_) {
+    location_bar_->SetBounds(0, row_height + kRowGap, GetLocationBarWidth(),
+                             location_bar_->GetPreferredSize().height());
+  }
+}
+
+void RacSidebarHeaderView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  UpdateVisibility();
+}
+
+void RacSidebarHeaderView::OnModeWillChange(
+    tabs::VerticalTabStripStateController* controller) {
+  RestoreControls();
+}
+
+void RacSidebarHeaderView::OnModeChanged(
+    tabs::VerticalTabStripStateController* controller) {
+  UpdatePlacement();
+}
+
+#if !BUILDFLAG(IS_MAC)
+void RacSidebarHeaderView::RelayoutWindowButtons() {}
+#endif

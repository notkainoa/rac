+}
+
+void RevealSidebarForAddressBar(BrowserView* browser_view) {
+  if (auto* header = HeaderFor(browser_view)) {
+    header->RevealForAddressBar();
+  }
+}
+
+bool ShouldKeepSidebarRevealed(const BrowserView* browser_view) {
+  const auto* header = HeaderFor(browser_view);

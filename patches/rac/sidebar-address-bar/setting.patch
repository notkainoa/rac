+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/sidebar_address_bar_prefs.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium/helium_layout_state_controller.h"
+#include "chrome/browser/ui/ui_features.h"
+#include "chrome/common/pref_names.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+void RegisterSidebarAddressBarPrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kAddressBarInSidebar, true);
+}
+
+bool WantsAddressBarInSidebar(BrowserWindowInterface* browser) {
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+      features::IsWebUIToolbarEnabled()) {
+    return false;
+  }
+
+  const auto* layout = HeliumLayoutStateController::From(browser);
+  if (!layout || !layout->IsVerticalLayout()) {
+    return false;
+  }
+
+  // The window buttons sit on the leading edge. With the sidebar on the
+  // trailing edge they need the toolbar row to stay, so the toolbar keeps its
+  // controls too.
+  const PrefService* prefs = browser->GetProfile()->GetPrefs();
+  return prefs->GetBoolean(kAddressBarInSidebar) &&
+         !prefs->GetBoolean(prefs::kHeliumVerticalRightAligned);
+}
+
+}  // namespace rac

+#ifndef CHROME_BROWSER_UI_RAC_SIDEBAR_ADDRESS_BAR_PREFS_H_
+#define CHROME_BROWSER_UI_RAC_SIDEBAR_ADDRESS_BAR_PREFS_H_
+
+class BrowserWindowInterface;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace rac {
+
+// Profile pref: show the address bar and the toolbar's controls at the top of
+// the sidebar, with no toolbar above the page.
+inline constexpr char kAddressBarInSidebar[] =
+    "rac.browser.address_bar_in_sidebar";
+
+void RegisterSidebarAddressBarPrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// True when `browser` should show its toolbar controls in the sidebar: the
+// pref is on and the window is a normal window using the vertical layout with
+// the sidebar on the same side as the window buttons. Whether the controls are
+// actually in the sidebar right now also depends on the sidebar's state.
+bool WantsAddressBarInSidebar(BrowserWindowInterface* browser);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SIDEBAR_ADDRESS_BAR_PREFS_H_

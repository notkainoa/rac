+#include "ui/gfx/animation/linear_animation.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/vector2d.h"
+
+namespace views {
+class View;
+}  // namespace views
+
+namespace rac {
+
+// Draws dragged sidebar tabs pulled toward the slot they would drop into, so
+// favorites move from cell to cell and rows settle near their place in the
+// list. The pointer alone still decides where the tabs drop; this only
+// changes where they're drawn.
+//
+// Positions are drag offsets in the container: the translation a dragged view
+// is drawn with, or its origin once the drag ends.
+class DragSnap : public gfx::AnimationDelegate {
+ public:
+  enum class Strength {
+    kNone,
+    // Rows follow the pointer most of the way and hop the rest when their
+    // slot changes.
+    kGentle,
+    // Favorites stay close to their cell and glide to the next one.
+    kGrid,
+  };
+
+  DragSnap(views::View& host, Strength strength, base::RepeatingClosure redraw);
+  DragSnap(const DragSnap&) = delete;
+  DragSnap& operator=(const DragSnap&) = delete;
+  ~DragSnap() override;
+
+  // Records where `view` would land if dropped now. `slot` is the drag offset
+  // of that place and the view's size there.
+  void SetSlot(const views::View& view, const gfx::Rect& slot);
+
+  // Returns where to draw `view` when the pointer alone would put it at
+  // `pointer`, and remembers it so a slot change glides from there. Only the
+  // axes the drag moves on are pulled.
+  gfx::Vector2d Draw(const views::View& view,
+                     const gfx::Vector2d& pointer,
+                     bool horizontal,
+                     bool vertical);
+
+  // Like `Draw`, without changing any state.
+  gfx::Vector2d Peek(const views::View& view,
+                     const gfx::Vector2d& pointer,
+                     bool horizontal,
+                     bool vertical) const;
+
+  // Whether any dragged view has a slot yet.
+  bool has_slots() const { return !views_.empty(); }
+
+  // Forgets `view`, which is going away.
+  void Forget(const views::View& view);
+
+  // Forgets every slot, for when the drag ends or leaves the container.
+  void Reset();
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  struct ViewState {
+    gfx::Rect slot;
+    // The slot origin when the view was last drawn, if it has been.
+    std::optional<gfx::Point> drawn_slot;
+    gfx::Vector2d drawn;
+    // How far from its pulled position the view was when it started gliding,
+    // and when that was.
+    gfx::Vector2d glide_from;
+    base::TimeTicks glide_start;
+  };
+
+  gfx::Vector2d Pull(const ViewState& state,
+                     const gfx::Vector2d& pointer,
+                     bool horizontal,
+                     bool vertical) const;
+  gfx::Vector2d GlideOffset(const ViewState& state, base::TimeTicks now) const;
+  void StartGlide(ViewState& state,
+                  gfx::Vector2d from,
+                  bool horizontal,
+                  bool vertical,
+                  base::TimeTicks now);
+
+  const raw_ref<views::View> host_;
+  const Strength strength_;
+  base::RepeatingClosure redraw_;
+  base::flat_map<raw_ptr<const views::View>, ViewState> views_;
+  // Runs while any view glides; each view times its own glide.
+  gfx::LinearAnimation glide_animation_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_DRAG_SNAP_H_

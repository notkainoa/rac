+#include "chrome/browser/ui/views/rac/sidebar/drag_snap.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "base/notreached.h"
+#include "base/numerics/safe_conversions.h"
+#include "ui/gfx/animation/animation.h"
+#include "ui/gfx/geometry/cubic_bezier.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/view.h"
+
+namespace rac {
+
+namespace {
+
+// How long a dragged tab takes to reach its new slot.
+constexpr base::TimeDelta kGlideDuration = base::Milliseconds(150);
+
+// A gently pulled row covers this share of the pointer's distance from its
+// slot, so it hops the rest of a row when the slot changes.
+constexpr double kGentleFollow = 0.75;
+
+// How hard a favorite resists leaving its cell: the rubber band of a
+// scroll view's overscroll, which gives at most half a cell.
+constexpr double kGridResistance = 0.55;
+
+// A tab dragged out of one container into another starts from where the old
+// one drew it, if that was this recent.
+constexpr base::TimeDelta kHandOffWindow = base::Milliseconds(100);
+
+// Where the last single dragged tab was drawn, in screen coordinates. Moving
+// a tab between the favorites and the tab list moves it to another container,
+// which starts its own `DragSnap`.
+struct LastDrawn {
+  gfx::Point origin_in_screen;
+  base::TimeTicks time;
+};
+
+LastDrawn& GetLastDrawn() {
+  static LastDrawn last_drawn;
+  return last_drawn;
+}
+
+int RubberBand(int distance, int limit) {
+  if (limit <= 0) {
+    return 0;
+  }
+  const double pulled =
+      (1.0 - 1.0 / (std::abs(distance) * kGridResistance / limit + 1.0)) *
+      limit;
+  return base::ClampRound(std::copysign(pulled, distance));
+}
+
+int PullAxis(DragSnap::Strength strength, int slot, int pointer, int cell) {
+  switch (strength) {
+    case DragSnap::Strength::kNone:
+      return pointer;
+    case DragSnap::Strength::kGentle:
+      return slot + base::ClampRound((pointer - slot) * kGentleFollow);
+    case DragSnap::Strength::kGrid:
+      return slot + RubberBand(pointer - slot, cell / 2);
+  }
+  NOTREACHED();
+}
+
+}  // namespace
+
+DragSnap::DragSnap(views::View& host,
+                   Strength strength,
+                   base::RepeatingClosure redraw)
+    : host_(host),
+      strength_(strength),
+      redraw_(std::move(redraw)),
+      glide_animation_(kGlideDuration,
+                       gfx::LinearAnimation::kDefaultFrameRate,
+                       this) {}
+
+DragSnap::~DragSnap() = default;
+
+void DragSnap::SetSlot(const views::View& view, const gfx::Rect& slot) {
+  if (strength_ == Strength::kNone) {
+    return;
+  }
+  views_[&view].slot = slot;
+}
+
+gfx::Vector2d DragSnap::Draw(const views::View& view,
+                             const gfx::Vector2d& pointer,
+                             bool horizontal,
+                             bool vertical) {
+  auto it = views_.find(&view);
+  if (it == views_.end()) {
+    return pointer;
+  }
+  ViewState& state = it->second;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const gfx::Vector2d target = Pull(state, pointer, horizontal, vertical);
+  const bool single = views_.size() == 1;
+  LastDrawn& last_drawn = GetLastDrawn();
+
+  if (state.drawn_slot) {
+    if (*state.drawn_slot != state.slot.origin()) {
+      StartGlide(state, state.drawn - target, horizontal, vertical, now);
+    }
+  } else if (single && !last_drawn.time.is_null() &&
+             now - last_drawn.time < kHandOffWindow) {
+    const gfx::Vector2d from = views::View::ConvertPointFromScreen(
+                                   &*host_, last_drawn.origin_in_screen)
+                                   .OffsetFromOrigin() -
+                               target;
+    // Anything farther came from somewhere unrelated, like another window.
+    const int max_distance =
+        2 * std::max(state.slot.width(), state.slot.height());
+    if (std::abs(from.x()) <= max_distance &&
+        std::abs(from.y()) <= max_distance) {
+      StartGlide(state, from, horizontal, vertical, now);
+    }
+  }
+
+  state.drawn = target + GlideOffset(state, now);
+  state.drawn_slot = state.slot.origin();
+  if (single) {
+    gfx::Point origin = gfx::PointAtOffsetFromOrigin(state.drawn);
+    views::View::ConvertPointToScreen(&*host_, &origin);
+    last_drawn = {.origin_in_screen = origin, .time = now};
+  }
+  return state.drawn;
+}
+
+gfx::Vector2d DragSnap::Peek(const views::View& view,
+                             const gfx::Vector2d& pointer,
+                             bool horizontal,
+                             bool vertical) const {
+  auto it = views_.find(&view);
+  if (it == views_.end()) {
+    return pointer;
+  }
+  const ViewState& state = it->second;
+  if (state.drawn_slot && *state.drawn_slot != state.slot.origin()) {
+    // The slot moved after the last draw; the view is still where it was.
+    return state.drawn;
+  }
+  return Pull(state, pointer, horizontal, vertical) +
+         GlideOffset(state, base::TimeTicks::Now());
+}
+
+void DragSnap::Forget(const views::View& view) {
+  views_.erase(&view);
+}
+
+void DragSnap::Reset() {
+  views_.clear();
+  glide_animation_.Stop();
+}
+
+void DragSnap::AnimationProgressed(const gfx::Animation* animation) {
+  redraw_.Run();
+}
+
+void DragSnap::AnimationEnded(const gfx::Animation* animation) {
+  redraw_.Run();
+}
+
+gfx::Vector2d DragSnap::Pull(const ViewState& state,
+                             const gfx::Vector2d& pointer,
+                             bool horizontal,
+                             bool vertical) const {
+  return gfx::Vector2d(horizontal ? PullAxis(strength_, state.slot.x(),
+                                             pointer.x(), state.slot.width())
+                                  : pointer.x(),
+                       vertical ? PullAxis(strength_, state.slot.y(),
+                                           pointer.y(), state.slot.height())
+                                : pointer.y());
+}
+
+gfx::Vector2d DragSnap::GlideOffset(const ViewState& state,
+                                    base::TimeTicks now) const {
+  if (state.glide_start.is_null()) {
+    return gfx::Vector2d();
+  }
+  const double progress = (now - state.glide_start) / kGlideDuration;
+  if (progress >= 1.0) {
+    return gfx::Vector2d();
+  }
+  // A strong ease-out: the tab leaves at once and settles softly.
+  const gfx::CubicBezier ease_out(0.23, 1, 0.32, 1);
+  const double remaining = 1.0 - ease_out.Solve(std::max(progress, 0.0));
+  return gfx::Vector2d(base::ClampRound(state.glide_from.x() * remaining),
+                       base::ClampRound(state.glide_from.y() * remaining));
+}
+
+void DragSnap::StartGlide(ViewState& state,
+                          gfx::Vector2d from,
+                          bool horizontal,
+                          bool vertical,
+                          base::TimeTicks now) {
+  if (!horizontal) {
+    from.set_x(0);
+  }
+  if (!vertical) {
+    from.set_y(0);
+  }
+  if (from.IsZero() ||
+      gfx::Animation::RichAnimationDuration(kGlideDuration).is_zero()) {
+    state.glide_start = base::TimeTicks();
+    return;
+  }
+  state.glide_from = from;
+  state.glide_start = now;
+  glide_animation_.Stop();
+  glide_animation_.Start();
+}
+
+}  // namespace rac

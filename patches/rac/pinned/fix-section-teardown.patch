+template <typename T>
+T* PinnedSection::AddRow(std::unique_ptr<T> row) {
+  T* view = container_->AddChildView(std::move(row));
+  row_observations_.AddObservation(view);
+  return view;
+}
+
+void PinnedSection::ForgetRow(views::View* row) {
+  // The row is mid-destruction but not yet freed, so letting go now never
+  // leaves a pointer behind it. Only pointers are dropped here: during the
+  // container's teardown nothing else is safe to touch.
+  row_observations_.RemoveObservation(row);
+  if (divider_.get() == row) {
+    divider_ = nullptr;
+  }
+  if (new_tab_row_.get() == row) {
+    new_tab_row_ = nullptr;
+  }
+  if (space_header_.get() == row) {
+    space_header_ = nullptr;
+  }
+  std::erase_if(folder_headers_,
+                [row](const auto& entry) { return entry.second.get() == row; });
+  std::erase_if(kept_rows_,
+                [row](const auto& entry) { return entry.second.get() == row; });
+}

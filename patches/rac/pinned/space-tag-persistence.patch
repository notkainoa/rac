+void AssignSidebarTabToSpace(tabs::TabInterface* tab, const SpaceId& space) {
+  SpaceTabTag::Set(tab->GetContents(), space);
+  if (BrowserWindowInterface* browser = tab->GetBrowserWindowInterface()) {
+    if (SessionService* session =
+            SessionServiceFactory::GetForProfileIfExisting(
+                browser->GetProfile())) {
+      session->AddTabExtraData(
+          browser->GetSessionID(),
+          sessions::SessionTabHelper::IdForTab(tab->GetContents()),
+          kTabSpaceExtraDataKey, space.AsLowercaseString());
+    }
+  }
+}
+
 }  // namespace rac

+#ifndef CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_ACTIONS_H_
+#define CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_ACTIONS_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+// What the sidebar's menus do to favorites, pinned tabs, and folders. Each
+// takes the window the user acted in: a tab that stops being an item stays
+// open there, and other windows follow the items.
+namespace rac {
+
+class SidebarWindowSync;
+
+enum class SidebarTabKind {
+  kOpen,
+  kFavorite,
+  kPinned,
+};
+
+SidebarTabKind GetSidebarTabKind(SidebarWindowSync* window,
+                                 tabs::TabInterface* tab);
+
+// Open tabs become pinned tabs, after the window's other pinned tabs.
+void PinTabs(SidebarWindowSync* window,
+             const std::vector<tabs::TabInterface*>& tabs);
+// Open tabs and pinned tabs become favorites, after the other favorites.
+void AddTabsToFavorites(SidebarWindowSync* window,
+                        const std::vector<tabs::TabInterface*>& tabs);
+// Favorites become pinned tabs, after the window's other pinned tabs.
+void MoveTabsToPinnedTabs(SidebarWindowSync* window,
+                          const std::vector<tabs::TabInterface*>& tabs);
+// Favorites and pinned tabs become open tabs.
+void UnpinTabs(SidebarWindowSync* window,
+               const std::vector<tabs::TabInterface*>& tabs);
+
+// True if `tab` is a favorite or pinned tab showing a page other than the
+// one it was pinned on.
+bool HasLeftPinnedPage(SidebarWindowSync* window, tabs::TabInterface* tab);
+void GoBackToPinnedPage(SidebarWindowSync* window, tabs::TabInterface* tab);
+void ReplacePinnedPage(SidebarWindowSync* window, tabs::TabInterface* tab);
+void ShowRenameTabDialog(SidebarWindowSync* window, tabs::TabInterface* tab);
+
+// Moves a pinned tab into `folder_id`, or out of its folder when `folder_id`
+// is empty.
+void MoveTabToFolder(SidebarWindowSync* window,
+                     tabs::TabInterface* tab,
+                     std::string_view folder_id);
+// Asks for a name, then adds a folder holding `tab`, where `tab` was.
+void ShowNewFolderDialogForTab(SidebarWindowSync* window,
+                               tabs::TabInterface* tab);
+// Asks for a name, then adds an empty folder after `folder_id`.
+void ShowNewFolderDialogAfter(SidebarWindowSync* window,
+                              std::string_view folder_id);

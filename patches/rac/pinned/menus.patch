+namespace rac {
+
+namespace {
+
+// Clear of the ranges Chromium's tab menu and its submenus use (see
+// tab_menu_model.h and existing_base_sub_menu_model.h).
+enum Command {
+  kFirstCommand = 2601,
+  kPinTab = kFirstCommand,
+  kUnpinTab,
+  kAddToFavorites,
+  kRemoveFromFavorites,
+  kMoveToPinnedTabs,
+  kGoBackToPinnedPage,
+  kReplacePinnedPage,
+  kRenameTab,
+  kMoveToFolder,
+  kNewFolderForTab,
+  kRemoveFromFolder,
+  kFirstFolder = 2650,
+  kLastCommand = 2699,
+  kLastFolder = kLastCommand,
+};
+
+enum FolderCommand {
+  kRenameFolder,
+  kNewFolder,
+  kUnpinFolder,
+  kDeleteFolder,
+};
+
+}  // namespace
+
+// static
+std::unique_ptr<SidebarTabMenu> SidebarTabMenu::MaybeCreate(
+    ui::SimpleMenuModel* menu,
+    TabStripModel* model,
+    int index,
+    const std::vector<int>& indices) {
+  BrowserWindowInterface* browser =
+      model->delegate()->GetBrowserWindowInterface();
+  SidebarWindowSync* window =
+      browser ? SidebarWindows::ForBrowser(browser) : nullptr;
+  if (!window ||
+      !menu->GetIndexOfCommandId(TabStripModel::CommandTogglePinned)) {
+    return nullptr;
+  }
+  tabs::TabInterface* tab = model->GetTabAtIndex(index);
+  const SidebarTabKind kind = GetSidebarTabKind(window, tab);
+  std::vector<tabs::TabHandle> tabs = {tab->GetHandle()};
+  for (int i : indices) {
+    tabs::TabInterface* selected = model->GetTabAtIndex(i);
+    if (selected != tab && GetSidebarTabKind(window, selected) == kind) {
+      tabs.push_back(selected->GetHandle());
+    }
+  }
+  auto sidebar_menu =
+      base::WrapUnique(new SidebarTabMenu(browser, kind, std::move(tabs)));
+  sidebar_menu->Build(menu);
+  return sidebar_menu;
+}
+
+SidebarTabMenu::SidebarTabMenu(BrowserWindowInterface* browser,
+                               SidebarTabKind kind,
+                               std::vector<tabs::TabHandle> tabs)
+    : browser_(browser), kind_(kind), tabs_(std::move(tabs)) {}
+
+SidebarTabMenu::~SidebarTabMenu() = default;
+
+// static
+bool SidebarTabMenu::IsSidebarCommand(int command_id) {
+  return command_id >= kFirstCommand && command_id <= kLastCommand;
+}
+
+bool SidebarTabMenu::IsCommandIdEnabled(int command_id) const {
+  if (command_id == kGoBackToPinnedPage || command_id == kReplacePinnedPage) {
+    return has_left_pinned_page_;
+  }
+  return true;
+}
+
+void SidebarTabMenu::ExecuteCommand(int command_id, int event_flags) {
+  SidebarWindowSync* window = GetWindow();
+  const std::vector<tabs::TabInterface*> tabs = GetTabs();
+  if (!window || tabs.empty()) {
+    return;
+  }
+  tabs::TabInterface* tab = tabs_.front().Get();
+  if (command_id >= kFirstFolder && command_id <= kLastFolder) {
+    const size_t folder = static_cast<size_t>(command_id - kFirstFolder);
+    if (tab && folder < folder_ids_.size()) {
+      MoveTabToFolder(window, tab, folder_ids_[folder]);
+    }
+    return;
+  }
+  switch (command_id) {
+    case kPinTab:
+      PinTabs(window, tabs);
+      return;
+    case kUnpinTab:
+    case kRemoveFromFavorites:
+      UnpinTabs(window, tabs);
+      return;
+    case kAddToFavorites:
+      AddTabsToFavorites(window, tabs);
+      return;
+    case kMoveToPinnedTabs:
+      MoveTabsToPinnedTabs(window, tabs);
+      return;
+  }
+  // The rest act on the right-clicked tab alone.
+  if (!tab) {
+    return;
+  }
+  switch (command_id) {
+    case kGoBackToPinnedPage:
+      GoBackToPinnedPage(window, tab);
+      return;
+    case kReplacePinnedPage:
+      ReplacePinnedPage(window, tab);
+      return;
+    case kRenameTab:
+      ShowRenameTabDialog(window, tab);
+      return;
+    case kNewFolderForTab:
+      ShowNewFolderDialogForTab(window, tab);
+      return;
+    case kRemoveFromFolder:
+      MoveTabToFolder(window, tab, std::string());
+      return;
+  }
+}
+
+void SidebarTabMenu::Build(ui::SimpleMenuModel* menu) {
+  const size_t pin_index =
+      *menu->GetIndexOfCommandId(TabStripModel::CommandTogglePinned);
+  menu->RemoveItemAt(pin_index);
+
+  if (kind_ == SidebarTabKind::kOpen) {
+    menu->InsertItemWithStringIdAt(pin_index, kPinTab, IDS_RAC_SIDEBAR_PIN_TAB);
+    menu->InsertItemWithStringIdAt(pin_index + 1, kAddToFavorites,
+                                   IDS_RAC_SIDEBAR_ADD_TO_FAVORITES);
+    return;
+  }
+
+  for (int command : {TabStripModel::CommandAddToExistingGroup,
+                      TabStripModel::CommandAddToNewGroup,
+                      TabStripModel::CommandRemoveFromGroup}) {
+    if (std::optional<size_t> index = menu->GetIndexOfCommandId(command)) {
+      menu->RemoveItemAt(*index);
+    }
+  }
+
+  SidebarWindowSync* window = GetWindow();
+  tabs::TabInterface* tab = tabs_.front().Get();
+  has_left_pinned_page_ = HasLeftPinnedPage(window, tab);
+  const bool single = tabs_.size() == 1;
+  size_t index = 0;
+  auto add = [&](int command_id, int string_id) {
+    menu->InsertItemWithStringIdAt(index++, command_id, string_id);
+  };
+  if (single) {
+    add(kGoBackToPinnedPage, IDS_RAC_SIDEBAR_GO_BACK_TO_PINNED_PAGE);
+    add(kReplacePinnedPage, IDS_RAC_SIDEBAR_REPLACE_PINNED_PAGE);
+    menu->InsertSeparatorAt(index++, ui::NORMAL_SEPARATOR);
+  }
+  if (kind_ == SidebarTabKind::kPinned) {
+    if (single) {
+      add(kRenameTab, IDS_RAC_SIDEBAR_RENAME_TAB);
+      BuildFolderMenu(window);
+      menu->InsertSubMenuWithStringIdAt(index++, kMoveToFolder,
+                                        IDS_RAC_SIDEBAR_MOVE_TO_FOLDER,
+                                        folder_menu_.get());
+    }
+    add(kAddToFavorites, IDS_RAC_SIDEBAR_ADD_TO_FAVORITES);
+    add(kUnpinTab, IDS_RAC_SIDEBAR_UNPIN_TAB);
+  } else {
+    add(kMoveToPinnedTabs, IDS_RAC_SIDEBAR_MOVE_TO_PINNED_TABS);
+    add(kRemoveFromFavorites, IDS_RAC_SIDEBAR_REMOVE_FROM_FAVORITES);
+  }
+  menu->InsertSeparatorAt(index, ui::NORMAL_SEPARATOR);
+}
+
+void SidebarTabMenu::BuildFolderMenu(SidebarWindowSync* window) {
+  folder_menu_ = std::make_unique<ui::SimpleMenuModel>(this);
+  folder_menu_->AddItemWithStringId(kNewFolderForTab,
+                                    IDS_RAC_SIDEBAR_NEW_FOLDER);
+
+  const std::string item_id =
+      GetSidebarItemId(tabs_.front().Get()->GetContents());
+  const SidebarList& list =
+      SidebarItems::Get(browser_->GetProfile())
+          ->GetList(SidebarItems::PinnedListKey(window->space()));
+  const SidebarFolder* current = list.FindFolderOfItem(item_id);
+  for (const SidebarList::Entry& entry : list.entries) {
+    const auto* folder = std::get_if<SidebarFolder>(&entry);
+    if (!folder || folder == current ||
+        kFirstFolder + static_cast<int>(folder_ids_.size()) > kLastFolder) {
+      continue;
+    }
+    if (folder_ids_.empty()) {
+      folder_menu_->AddSeparator(ui::NORMAL_SEPARATOR);
+    }
+    folder_menu_->AddItem(kFirstFolder + static_cast<int>(folder_ids_.size()),
+                          folder->title);
+    folder_ids_.push_back(folder->id);
+  }
+  if (current) {
+    folder_menu_->AddSeparator(ui::NORMAL_SEPARATOR);
+    folder_menu_->AddItemWithStringId(kRemoveFromFolder,
+                                      IDS_RAC_SIDEBAR_REMOVE_FROM_FOLDER);
+  }
+}
+
+SidebarWindowSync* SidebarTabMenu::GetWindow() const {
+  return SidebarWindows::ForBrowser(browser_);
+}
+
+std::vector<tabs::TabInterface*> SidebarTabMenu::GetTabs() const {
+  std::vector<tabs::TabInterface*> tabs;
+  for (const tabs::TabHandle& handle : tabs_) {
+    if (tabs::TabInterface* tab = handle.Get()) {
+      tabs.push_back(tab);
+    }
+  }
+  return tabs;
+}
+
+SidebarFolderMenu::SidebarFolderMenu(BrowserWindowInterface* browser,
+                                     std::string folder_id)
+    : ui::SimpleMenuModel(this),
+      browser_(browser),
+      folder_id_(std::move(folder_id)) {
+  AddItemWithStringId(kRenameFolder, IDS_RAC_SIDEBAR_RENAME_FOLDER);
+  AddItemWithStringId(kNewFolder, IDS_RAC_SIDEBAR_NEW_FOLDER);
+  AddSeparator(ui::NORMAL_SEPARATOR);
+  AddItemWithStringId(kUnpinFolder, IDS_RAC_SIDEBAR_UNPIN_FOLDER);
+  AddItemWithStringId(kDeleteFolder, IDS_RAC_SIDEBAR_DELETE_FOLDER);
+}
+
+SidebarFolderMenu::~SidebarFolderMenu() = default;
+
+void SidebarFolderMenu::ExecuteCommand(int command_id, int event_flags) {
+  SidebarWindowSync* window = SidebarWindows::ForBrowser(browser_);
+  if (!window) {
+    return;
+  }
+  switch (command_id) {
+    case kRenameFolder:
+      ShowRenameFolderDialog(window, folder_id_);
+      return;
+    case kNewFolder:
+      ShowNewFolderDialogAfter(window, folder_id_);
+      return;
+    case kUnpinFolder:
+      UnpinFolder(window, folder_id_);
+      return;
+    case kDeleteFolder:
+      DeleteFolder(window, folder_id_);
+      return;
+  }
+}
+
+}  // namespace rac

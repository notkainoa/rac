+#ifndef CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_MENUS_H_
+#define CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_MENUS_H_
+
+#include <memory>

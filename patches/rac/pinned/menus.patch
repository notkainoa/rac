+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace rac {
+
+// The favorite and pinned tab items of a tab's context menu. Chromium's pin
+// item becomes Pin Tab and Add to Favorites for an open tab. A favorite or
+// pinned tab gets its own items at the top instead, and loses the tab group
+// items, since the sidebar keeps those tabs out of groups.
+class SidebarTabMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  // Changes `menu`, the menu for the tab at `index` acting on the tabs at
+  // `indices`. Returns null, leaving `menu` alone, for windows without
+  // favorites and pinned tabs.
+  static std::unique_ptr<SidebarTabMenu> MaybeCreate(
+      ui::SimpleMenuModel* menu,
+      TabStripModel* model,
+      int index,
+      const std::vector<int>& indices);
+
+  ~SidebarTabMenu() override;
+
+  // True for the command ids of the items this class added. Chromium's tab
+  // menu sends those here instead of to the tab strip.
+  static bool IsSidebarCommand(int command_id);
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  SidebarTabMenu(BrowserWindowInterface* browser,
+                 SidebarTabKind kind,
+                 std::vector<tabs::TabHandle> tabs);
+
+  void Build(ui::SimpleMenuModel* menu);
+  void BuildFolderMenu(SidebarWindowSync* window);
+  SidebarWindowSync* GetWindow() const;
+  // The tabs still open, the right-clicked one first.
+  std::vector<tabs::TabInterface*> GetTabs() const;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const SidebarTabKind kind_;
+  // The right-clicked tab, and the selected tabs of the same kind.
+  const std::vector<tabs::TabHandle> tabs_;
+  bool has_left_pinned_page_ = false;
+  std::unique_ptr<ui::SimpleMenuModel> folder_menu_;
+  // The folders in `folder_menu_`, by command id.
+  std::vector<std::string> folder_ids_;
+};
+
+// The context menu of a pinned tab folder in the sidebar.
+class SidebarFolderMenu : public ui::SimpleMenuModel,
+                          public ui::SimpleMenuModel::Delegate {
+ public:
+  SidebarFolderMenu(BrowserWindowInterface* browser, std::string folder_id);
+  SidebarFolderMenu(const SidebarFolderMenu&) = delete;
+  SidebarFolderMenu& operator=(const SidebarFolderMenu&) = delete;
+  ~SidebarFolderMenu() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const std::string folder_id_;
+};
+
+}  // namespace rac

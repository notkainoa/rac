+#include "chrome/browser/ui/rac/sidebar/sidebar_actions.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/spaces/space_tab_tag.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/dialogs/browser_dialogs.h"
+#include "chrome/browser/ui/rac/sidebar/sidebar_items.h"
+#include "chrome/browser/ui/rac/sidebar/sidebar_tab_tag.h"
+#include "chrome/browser/ui/rac/sidebar/sidebar_window_sync.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/invalidate_type.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/page_transition_types.h"
+
+namespace rac {
+
+namespace {
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kNameFieldId);
+
+constexpr size_t kEnd = SIZE_MAX;
+
+SidebarItems* GetItems(SidebarWindowSync* window) {
+  return SidebarItems::Get(window->browser()->GetProfile());
+}
+
+GURL GetPageUrl(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  const GURL& committed = contents->GetLastCommittedURL();
+  return committed.is_empty() ? contents->GetVisibleURL() : committed;
+}
+
+// The tab strip, hover card, and tab search show an item's name in place of
+// the page title. They read it again when the title changes.
+void RefreshTitle(tabs::TabInterface* tab) {
+  tab->GetContents()->NotifyNavigationStateChanged(
+      content::INVALIDATE_TYPE_TITLE);
+}
+
+void RefreshTitleInEveryWindow(Profile* profile, const std::string& item_id) {
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        SidebarWindowSync* window = SidebarWindows::ForBrowser(browser);
+        if (tabs::TabInterface* tab =
+                window ? window->GetTabForItem(item_id) : nullptr) {
+          RefreshTitle(tab);
+        }
+        return true;
+      });
+}
+
+// Turns `tab` into an open tab that stays in `window`.
+void ReleaseTab(SidebarWindowSync* window, tabs::TabInterface* tab) {
+  const SidebarItem* item = window->GetItemForTab(tab);
+  const bool had_name = item && !item->name.empty();
+  window->Release(tab);
+  if (tab->IsPinned()) {
+    TabStripModel* model = window->browser()->GetTabStripModel();
+    model->SetTabPinned(model->GetIndexOfTab(tab), false);
+  }
+  if (window->space().is_valid() && !SpaceTabTag::Get(tab->GetContents())) {
+    SpaceTabTag::Set(tab->GetContents(), window->space());
+  }
+  if (had_name) {
+    RefreshTitle(tab);
+  }
+}
+
+// Returns the top-level index of the entry holding `item_id`: the item
+// itself, or its folder.
+std::optional<size_t> GetEntryIndex(const SidebarList& list,
+                                    std::string_view item_id) {
+  const SidebarFolder* folder = list.FindFolderOfItem(item_id);
+  for (size_t i = 0; i < list.entries.size(); ++i) {
+    const SidebarList::Entry& entry = list.entries[i];
+    if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+      if (item->id == item_id) {
+        return i;
+      }
+    } else if (folder && &std::get<SidebarFolder>(entry) == folder) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<size_t> GetFolderIndex(const SidebarList& list,
+                                     std::string_view folder_id) {
+  for (size_t i = 0; i < list.entries.size(); ++i) {
+    const auto* folder = std::get_if<SidebarFolder>(&list.entries[i]);
+    if (folder && folder->id == folder_id) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+// Shows a dialog with one name field. `on_accept` gets the trimmed name, and
+// isn't called if the browser's profile is gone by then.
+void ShowNameDialog(
+    BrowserWindowInterface* browser,
+    int title_id,
+    const std::u16string& name,
+    base::OnceCallback<void(SidebarItems*, std::u16string)> on_accept) {
+  ui::DialogModel::Builder builder;
+  ui::DialogModel* model = builder.model();
+  auto accept = base::BindOnce(
+      [](base::WeakPtr<Profile> profile, ui::DialogModel* model,
+         base::OnceCallback<void(SidebarItems*, std::u16string)> on_accept) {
+        SidebarItems* items =
+            profile ? SidebarItems::Get(profile.get()) : nullptr;
+        if (!items) {
+          return;
+        }
+        std::u16string text;
+        base::TrimWhitespace(
+            model->GetTextfieldByUniqueId(kNameFieldId)->text(), base::TRIM_ALL,
+            &text);
+        std::move(on_accept).Run(items, std::move(text));
+      },
+      browser->GetProfile()->GetWeakPtr(), model, std::move(on_accept));
+  chrome::ShowBrowserModal(
+      browser,
+      builder.SetInternalName("RacSidebarNamePrompt")
+          .SetTitle(l10n_util::GetStringUTF16(title_id))
+          .AddOkButton(std::move(accept))
+          .AddCancelButton(base::DoNothing())
+          .AddTextfield(
+              kNameFieldId, {}, name,
+              ui::DialogModelTextfield::Params().SetAccessibleName(
+                  l10n_util::GetStringUTF16(IDS_RAC_SIDEBAR_NAME_FIELD)))
+          .SetInitiallyFocusedField(kNameFieldId)
+          .Build());
+}
+
+std::u16string NameOrDefault(std::u16string name) {
+  return name.empty()
+             ? l10n_util::GetStringUTF16(IDS_RAC_SIDEBAR_NEW_FOLDER_TITLE)
+             : name;
+}
+
+}  // namespace
+
+SidebarTabKind GetSidebarTabKind(SidebarWindowSync* window,
+                                 tabs::TabInterface* tab) {
+  const std::string id = GetSidebarItemId(tab->GetContents());
+  std::string list_key;
+  if (id.empty() || !GetItems(window)->FindItem(id, &list_key)) {
+    return SidebarTabKind::kOpen;
+  }
+  if (list_key == SidebarItems::kFavorites) {
+    return SidebarTabKind::kFavorite;
+  }
+  return list_key == SidebarItems::PinnedListKey(window->space())
+             ? SidebarTabKind::kPinned
+             : SidebarTabKind::kOpen;
+}
+
+void PinTabs(SidebarWindowSync* window,
+             const std::vector<tabs::TabInterface*>& tabs) {
+  if (!window->space().is_valid()) {
+    return;
+  }
+  SidebarItems* items = GetItems(window);
+  const std::string key = SidebarItems::PinnedListKey(window->space());
+  for (tabs::TabInterface* tab : tabs) {
+    const GURL url = GetPageUrl(tab);
+    if (GetSidebarTabKind(window, tab) != SidebarTabKind::kOpen ||
+        !url.is_valid()) {
+      continue;
+    }
+    const std::string id =
+        items->AddItem(key, SidebarPosition{std::string(), kEnd}, url,
+                       tab->GetContents()->GetTitle());
+    SetSidebarItemId(tab->GetContents(), id);
+  }
+}
+
+void AddTabsToFavorites(SidebarWindowSync* window,
+                        const std::vector<tabs::TabInterface*>& tabs) {
+  SidebarItems* items = GetItems(window);
+  for (tabs::TabInterface* tab : tabs) {
+    switch (GetSidebarTabKind(window, tab)) {
+      case SidebarTabKind::kOpen: {
+        const GURL url = GetPageUrl(tab);
+        if (url.is_valid()) {
+          SetSidebarItemId(tab->GetContents(),
+                           items->AddItem(SidebarItems::kFavorites,
+                                          SidebarPosition{std::string(), kEnd},
+                                          url, tab->GetContents()->GetTitle()));
+        }
+        break;
+      }
+      case SidebarTabKind::kPinned:
+        items->MoveItem(GetSidebarItemId(tab->GetContents()),
+                        SidebarItems::kFavorites,
+                        SidebarPosition{std::string(), kEnd});
+        break;
+      case SidebarTabKind::kFavorite:
+        break;
+    }
+  }
+}
+
+void MoveTabsToPinnedTabs(SidebarWindowSync* window,
+                          const std::vector<tabs::TabInterface*>& tabs) {
+  if (!window->space().is_valid()) {
+    return;
+  }
+  SidebarItems* items = GetItems(window);
+  const std::string key = SidebarItems::PinnedListKey(window->space());
+  for (tabs::TabInterface* tab : tabs) {
+    if (GetSidebarTabKind(window, tab) == SidebarTabKind::kFavorite) {
+      items->MoveItem(GetSidebarItemId(tab->GetContents()), key,
+                      SidebarPosition{std::string(), kEnd});
+    }
+  }
+}
+
+void UnpinTabs(SidebarWindowSync* window,
+               const std::vector<tabs::TabInterface*>& tabs) {
+  for (tabs::TabInterface* tab : tabs) {
+    if (GetSidebarTabKind(window, tab) != SidebarTabKind::kOpen) {
+      ReleaseTab(window, tab);
+    }
+  }
+}
+
+bool HasLeftPinnedPage(SidebarWindowSync* window, tabs::TabInterface* tab) {
+  const SidebarItem* item = window->GetItemForTab(tab);
+  return item && GetPageUrl(tab) != item->url;
+}
+
+void GoBackToPinnedPage(SidebarWindowSync* window, tabs::TabInterface* tab) {
+  const SidebarItem* item = window->GetItemForTab(tab);
+  if (!item) {
+    return;
+  }
+  content::NavigationController::LoadURLParams params(item->url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+  tab->GetContents()->GetController().LoadURLWithParams(params);
+}
+
+void ReplacePinnedPage(SidebarWindowSync* window, tabs::TabInterface* tab) {
+  if (const SidebarItem* item = window->GetItemForTab(tab)) {
+    GetItems(window)->SetItemPage(item->id, GetPageUrl(tab),
+                                  tab->GetContents()->GetTitle());
+  }
+}
+
+void ShowRenameTabDialog(SidebarWindowSync* window, tabs::TabInterface* tab) {
+  const SidebarItem* item = window->GetItemForTab(tab);
+  if (!item) {
+    return;
+  }
+  const std::u16string page_title = tab->GetContents()->GetTitle();
+  ShowNameDialog(
+      window->browser(), IDS_RAC_SIDEBAR_RENAME_TAB_TITLE,
+      item->name.empty() ? page_title : item->name,
+      base::BindOnce(
+          [](Profile* profile, std::string id, std::u16string page_title,
+             SidebarItems* items, std::u16string name) {
+            const SidebarItem* item = items->FindItem(id);
+            if (!item || (item->name.empty() && name == page_title)) {
+              return;
+            }
+            // An empty name goes back to showing the page title.
+            items->SetItemName(id, name);
+            RefreshTitleInEveryWindow(profile, id);
+          },
+          window->browser()->GetProfile(), item->id, page_title));
+}
+
+void MoveTabToFolder(SidebarWindowSync* window,
+                     tabs::TabInterface* tab,
+                     std::string_view folder_id) {
+  if (GetSidebarTabKind(window, tab) != SidebarTabKind::kPinned) {
+    return;
+  }
+  SidebarItems* items = GetItems(window);
+  const std::string key = SidebarItems::PinnedListKey(window->space());
+  const std::string id = GetSidebarItemId(tab->GetContents());
+  if (!folder_id.empty()) {
+    items->MoveItem(id, key, SidebarPosition{std::string(folder_id), kEnd});
+    return;
+  }
+  // Out of its folder, the tab goes right below it.
+  const std::optional<size_t> index = GetEntryIndex(items->GetList(key), id);
+  if (index) {
+    items->MoveItem(id, key, SidebarPosition{std::string(), *index + 1});
+  }
+}
+
+void ShowNewFolderDialogForTab(SidebarWindowSync* window,
+                               tabs::TabInterface* tab) {
+  if (GetSidebarTabKind(window, tab) != SidebarTabKind::kPinned) {
+    return;
+  }
+  ShowNameDialog(window->browser(), IDS_RAC_SIDEBAR_NEW_FOLDER_TITLE,
+                 l10n_util::GetStringUTF16(IDS_RAC_SIDEBAR_NEW_FOLDER_TITLE),
+                 base::BindOnce(
+                     [](std::string key, std::string id, SidebarItems* items,
+                        std::u16string name) {
+                       const std::optional<size_t> index =
+                           GetEntryIndex(items->GetList(key), id);
+                       if (!index) {
+                         return;
+                       }
+                       const std::string folder_id = items->AddFolder(
+                           key, *index, NameOrDefault(std::move(name)));
+                       items->MoveItem(id, key, SidebarPosition{folder_id, 0});
+                     },
+                     SidebarItems::PinnedListKey(window->space()),
+                     GetSidebarItemId(tab->GetContents())));
+}
+
+void ShowNewFolderDialogAfter(SidebarWindowSync* window,
+                              std::string_view folder_id) {
+  ShowNameDialog(window->browser(), IDS_RAC_SIDEBAR_NEW_FOLDER_TITLE,
+                 l10n_util::GetStringUTF16(IDS_RAC_SIDEBAR_NEW_FOLDER_TITLE),
+                 base::BindOnce(
+                     [](std::string key, std::string folder_id,
+                        SidebarItems* items, std::u16string name) {
+                       const std::optional<size_t> index =
+                           GetFolderIndex(items->GetList(key), folder_id);
+                       items->AddFolder(key, index ? *index + 1 : kEnd,
+                                        NameOrDefault(std::move(name)));
+                     },
+                     SidebarItems::PinnedListKey(window->space()),
+                     std::string(folder_id)));
+}
+
+void ShowRenameFolderDialog(SidebarWindowSync* window,
+                            std::string_view folder_id) {
+  const SidebarFolder* folder =
+      GetItems(window)
+          ->GetList(SidebarItems::PinnedListKey(window->space()))
+          .FindFolder(folder_id);
+  if (!folder) {
+    return;
+  }
+  ShowNameDialog(
+      window->browser(), IDS_RAC_SIDEBAR_RENAME_FOLDER_TITLE, folder->title,
+      base::BindOnce(
+          [](std::string folder_id, SidebarItems* items, std::u16string name) {
+            if (!name.empty()) {
+              items->SetFolderTitle(folder_id, name);
+            }
+          },
+          std::string(folder_id)));
+}
+
+void UnpinFolder(SidebarWindowSync* window, std::string_view folder_id) {
+  SidebarItems* items = GetItems(window);
+  const SidebarFolder* folder =
+      items->GetList(SidebarItems::PinnedListKey(window->space()))
+          .FindFolder(folder_id);
+  if (!folder) {
+    return;
+  }
+  if (folder->items.empty()) {
+    items->RemoveFolder(folder_id);
+    return;
+  }
+  std::vector<std::string> ids;
+  for (const SidebarItem& item : folder->items) {
+    ids.push_back(item.id);
+  }
+  // Removing the last item removes the folder.
+  for (const std::string& id : ids) {
+    if (tabs::TabInterface* tab = window->GetTabForItem(id)) {
+      ReleaseTab(window, tab);
+    } else {
+      items->RemoveItem(id);
+    }
+  }
+}
+
+void DeleteFolder(SidebarWindowSync* window, std::string_view folder_id) {
+  SidebarItems* items = GetItems(window);
+  const SidebarFolder* folder =
+      items->GetList(SidebarItems::PinnedListKey(window->space()))
+          .FindFolder(folder_id);
+  if (!folder) {
+    return;
+  }
+  std::vector<tabs::TabHandle> to_close;
+  for (const SidebarItem& item : folder->items) {
+    if (tabs::TabInterface* tab = window->GetTabForItem(item.id)) {
+      SetSidebarItemId(tab->GetContents(), std::string());
+      to_close.push_back(tab->GetHandle());
+    }
+  }
+  items->RemoveFolder(folder_id);
+  TabStripModel* model = window->browser()->GetTabStripModel();
+  for (const tabs::TabHandle& handle : to_close) {
+    tabs::TabInterface* tab = handle.Get();
+    // Never close the window's last tab, which would close the window.
+    if (tab && model->count() > 1) {
+      model->CloseWebContentsAt(model->GetIndexOfTab(tab),
+                                TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+}
+
+}  // namespace rac

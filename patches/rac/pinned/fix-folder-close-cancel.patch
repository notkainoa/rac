+bool SidebarWindowSync::BeginFolderDeletion(
+    std::string folder_id,
+    std::vector<std::string> item_ids) {
+  if (pending_folder_deletions_.contains(folder_id)) {
+    return false;
+  }
+  auto pending = std::make_unique<PendingFolderDeletion>();
+  pending->ids = std::move(item_ids);
+  for (const std::string& id : pending->ids) {
+    if (tabs::TabInterface* tab = GetTabForItem(id)) {
+      pending->observers.push_back(
+          std::make_unique<PendingFolderDeletion::CloseObserver>(
+              tab->GetContents(), pending.get(), this));
+    }
+  }
+  pending_folder_deletions_.emplace(std::move(folder_id), std::move(pending));
+  return true;
+}
+
+void SidebarWindowSync::FinishFolderDeletion(std::string_view folder_id,
+                                              bool blocked) {
+  auto it = pending_folder_deletions_.find(folder_id);
+  if (it == pending_folder_deletions_.end()) {
+    return;
+  }
+  it->second->requesting = false;
+  it->second->cancelled |= blocked;
+  ScheduleFolderDeletionCheck();
+}
+
+void SidebarWindowSync::ScheduleFolderDeletionCheck() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SidebarWindowSync::CheckFolderDeletions,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SidebarWindowSync::CheckFolderDeletions() {
+  for (auto it = pending_folder_deletions_.begin();
+       it != pending_folder_deletions_.end();) {
+    PendingFolderDeletion& pending = *it->second;
+    if (pending.requesting) {
+      ++it;
+      continue;
+    }
+    const bool all_closed = std::ranges::none_of(
+        pending.ids, [this](const std::string& id) {
+          return GetTabForItem(id) != nullptr;
+        });
+    if (!pending.cancelled && !all_closed) {
+      ++it;
+      continue;
+    }
+    const std::string folder_id = it->first;
+    const bool committed = !pending.cancelled && all_closed;
+    it = pending_folder_deletions_.erase(it);
+    if (committed) {
+      items_->RemoveFolder(folder_id);
+    } else {
+      ScheduleReconcile();
+    }
+  }
+}

+++ src/chrome/browser/ui/rac/sidebar/sidebar_items.cc	2026-10-12 04:42:45.783364010 -0700
@@ -0,0 +1,594 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/sidebar/sidebar_items.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/spaces/spaces_service.h"
+#include "chrome/browser/rac/spaces/spaces_service_factory.h"
+#include "chrome/browser/ui/rac/sidebar/sidebar_items_factory.h"
+#include "chrome/browser/ui/rac/sidebar/sidebar_window_sync.h"
+#include "chrome/browser/ui/startup/startup_tab.h"
+#include "chrome/browser/ui/tabs/pinned_tab_codec.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+// A dictionary of lists, each {"entries": [entry...]}. An entry is an item
+// {"id", "url", "title"} or a folder {"id", "title", "collapsed", "items"}.
+constexpr char kListsPref[] = "rac.sidebar.lists";
+// Set once Helium's pinned tabs have been turned into favorites.
+constexpr char kMigratedPref[] = "rac.sidebar.migrated_pinned_tabs";
+
+constexpr char kEntries[] = "entries";
+constexpr char kId[] = "id";
+constexpr char kUrl[] = "url";
+constexpr char kTitle[] = "title";
+constexpr char kCollapsed[] = "collapsed";
+constexpr char kItems[] = "items";
+
+std::string NewId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+base::DictValue ItemToValue(const SidebarItem& item) {
+  base::DictValue value;
+  value.Set(kId, item.id);
+  value.Set(kUrl, item.url.spec());
+  value.Set(kTitle, item.title);
+  return value;
+}
+
+std::optional<SidebarItem> ItemFromValue(const base::DictValue& value) {
+  const std::string* id = value.FindString(kId);
+  const std::string* url = value.FindString(kUrl);
+  if (!id || id->empty() || !url) {
+    return std::nullopt;
+  }
+  SidebarItem item;
+  item.id = *id;
+  item.url = GURL(*url);
+  if (!item.url.is_valid()) {
+    return std::nullopt;
+  }
+  if (const std::string* title = value.FindString(kTitle)) {
+    item.title = base::UTF8ToUTF16(*title);
+  }
+  return item;
+}
+
+base::DictValue ListToValue(const SidebarList& list) {
+  base::ListValue entries;
+  for (const SidebarList::Entry& entry : list.entries) {
+    if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+      entries.Append(ItemToValue(*item));
+      continue;
+    }
+    const auto& folder = std::get<SidebarFolder>(entry);
+    base::ListValue items;
+    for (const SidebarItem& item : folder.items) {
+      items.Append(ItemToValue(item));
+    }
+    base::DictValue value;
+    value.Set(kId, folder.id);
+    value.Set(kTitle, folder.title);
+    value.Set(kCollapsed, folder.collapsed);
+    value.Set(kItems, std::move(items));
+    entries.Append(std::move(value));
+  }
+  base::DictValue value;
+  value.Set(kEntries, std::move(entries));
+  return value;
+}
+
+// Skips anything malformed, and any id seen before, so a damaged pref can't
+// make two tabs claim the same item.
+SidebarList ListFromValue(const base::DictValue& value,
+                          std::set<std::string>& seen_ids) {
+  SidebarList list;
+  const base::ListValue* entries = value.FindList(kEntries);
+  if (!entries) {
+    return list;
+  }
+  for (const base::Value& entry : *entries) {
+    if (!entry.is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = entry.GetDict();
+    const base::ListValue* items = dict.FindList(kItems);
+    if (!items) {
+      std::optional<SidebarItem> item = ItemFromValue(dict);
+      if (item && seen_ids.insert(item->id).second) {
+        list.entries.emplace_back(std::move(*item));
+      }
+      continue;
+    }
+    const std::string* id = dict.FindString(kId);
+    if (!id || id->empty() || !seen_ids.insert(*id).second) {
+      continue;
+    }
+    SidebarFolder folder;
+    folder.id = *id;
+    if (const std::string* title = dict.FindString(kTitle)) {
+      folder.title = base::UTF8ToUTF16(*title);
+    }
+    folder.collapsed = dict.FindBool(kCollapsed).value_or(false);
+    for (const base::Value& item_value : *items) {
+      if (!item_value.is_dict()) {
+        continue;
+      }
+      std::optional<SidebarItem> item = ItemFromValue(item_value.GetDict());
+      if (item && seen_ids.insert(item->id).second) {
+        folder.items.push_back(std::move(*item));
+      }
+    }
+    list.entries.emplace_back(std::move(folder));
+  }
+  return list;
+}
+
+const std::string& EntryId(const SidebarList::Entry& entry) {
+  return std::visit(
+      [](const auto& value) -> const std::string& { return value.id; }, entry);
+}
+
+}  // namespace
+
+SidebarItem::SidebarItem() = default;
+SidebarItem::SidebarItem(const SidebarItem&) = default;
+SidebarItem& SidebarItem::operator=(const SidebarItem&) = default;
+SidebarItem::~SidebarItem() = default;
+
+SidebarFolder::SidebarFolder() = default;
+SidebarFolder::SidebarFolder(const SidebarFolder&) = default;
+SidebarFolder& SidebarFolder::operator=(const SidebarFolder&) = default;
+SidebarFolder::~SidebarFolder() = default;
+
+SidebarList::SidebarList() = default;
+SidebarList::SidebarList(const SidebarList&) = default;
+SidebarList& SidebarList::operator=(const SidebarList&) = default;
+SidebarList::~SidebarList() = default;
+
+std::vector<const SidebarItem*> SidebarList::AllItems() const {
+  std::vector<const SidebarItem*> items;
+  for (const Entry& entry : entries) {
+    if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+      items.push_back(item);
+      continue;
+    }
+    for (const SidebarItem& item : std::get<SidebarFolder>(entry).items) {
+      items.push_back(&item);
+    }
+  }
+  return items;
+}
+
+const SidebarFolder* SidebarList::FindFolder(std::string_view id) const {
+  for (const Entry& entry : entries) {
+    const auto* folder = std::get_if<SidebarFolder>(&entry);
+    if (folder && folder->id == id) {
+      return folder;
+    }
+  }
+  return nullptr;
+}
+
+const SidebarFolder* SidebarList::FindFolderOfItem(
+    std::string_view item_id) const {
+  for (const Entry& entry : entries) {
+    const auto* folder = std::get_if<SidebarFolder>(&entry);
+    if (folder &&
+        std::ranges::any_of(folder->items, [&](const SidebarItem& item) {
+          return item.id == item_id;
+        })) {
+      return folder;
+    }
+  }
+  return nullptr;
+}
+
+// static
+std::string SidebarItems::PinnedListKey(const SpaceId& space) {
+  return "pinned." + space.AsLowercaseString();
+}
+
+SidebarItems::SidebarItems(Profile* profile) : profile_(profile) {
+  Load();
+  MigrateHeliumPinnedTabs();
+  windows_ = std::make_unique<SidebarWindows>(profile_, this);
+}
+
+SidebarItems::~SidebarItems() = default;
+
+// static
+SidebarItems* SidebarItems::Get(Profile* profile) {
+  return SidebarItemsFactory::GetForProfile(profile);
+}
+
+// static
+void SidebarItems::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterDictionaryPref(kListsPref);
+  registry->RegisterBooleanPref(kMigratedPref, false);
+}
+
+const SidebarList& SidebarItems::GetList(std::string_view key) const {
+  static const base::NoDestructor<SidebarList> empty;
+  auto it = lists_.find(key);
+  return it == lists_.end() ? *empty : it->second;
+}
+
+const SidebarItem* SidebarItems::FindItem(std::string_view id,
+                                          std::string* list_key) const {
+  for (const auto& [key, list] : lists_) {
+    for (const SidebarItem* item : list.AllItems()) {
+      if (item->id == id) {
+        if (list_key) {
+          *list_key = key;
+        }
+        return item;
+      }
+    }
+  }
+  return nullptr;
+}
+
+std::string SidebarItems::AddItem(std::string_view list_key,
+                                  const SidebarPosition& position,
+                                  const GURL& url,
+                                  const std::u16string& title) {
+  SidebarItem item;
+  item.id = NewId();
+  item.url = url;
+  item.title = title;
+  std::string id = item.id;
+  if (!InsertItem(list_key, position, std::move(item))) {
+    return std::string();
+  }
+  SaveAndNotify();
+  return id;
+}
+
+void SidebarItems::RemoveItem(std::string_view id) {
+  if (TakeItem(id)) {
+    SaveAndNotify();
+  }
+}
+
+void SidebarItems::MoveItem(std::string_view id,
+                            std::string_view list_key,
+                            const SidebarPosition& position) {
+  std::optional<ItemLocation> from = LocateItem(id);
+  if (!from) {
+    return;
+  }
+  if (!position.folder_id.empty()) {
+    std::string folder_list;
+    if (!FindMutableFolder(position.folder_id, &folder_list) ||
+        folder_list != list_key) {
+      return;
+    }
+  }
+  const std::string from_folder =
+      from->folder ? from->folder->id : std::string();
+  const bool same_list = from->list_key == list_key;
+  if (same_list && from_folder == position.folder_id &&
+      (from->index == position.index || from->index + 1 == position.index ||
+       (from->folder && from->folder->items.size() == 1))) {
+    return;
+  }
+
+  SidebarPosition target = position;
+  if (same_list && from_folder == target.folder_id &&
+      from->index < target.index) {
+    // Taking the item out shifts later positions left.
+    --target.index;
+  }
+  if (same_list && from->folder && from->folder->items.size() == 1 &&
+      target.folder_id.empty()) {
+    // The emptied folder is removed, which also shifts later positions left.
+    const auto& entries = from->list->entries;
+    for (size_t i = 0; i < entries.size() && i < target.index; ++i) {
+      if (EntryId(entries[i]) == from_folder) {
+        --target.index;
+        break;
+      }
+    }
+  }
+  std::optional<SidebarItem> item = TakeItem(id);
+  // `target` names a folder that still exists: it was checked above, and an
+  // emptied source folder can't be the target since that move is a no-op.
+  InsertItem(list_key, target, std::move(*item));
+  SaveAndNotify();
+}
+
+void SidebarItems::SetOrder(std::string_view list_key,
+                            const std::vector<std::string>& ids) {
+  SidebarList* list = nullptr;
+  if (auto it = lists_.find(list_key); it != lists_.end()) {
+    list = &it->second;
+  }
+  if (!list) {
+    return;
+  }
+  // Fill the slots held by listed entries with those entries in `ids` order;
+  // unlisted entries keep their slots.
+  std::vector<size_t> slots;
+  std::vector<SidebarList::Entry> ordered;
+  for (const std::string& id : ids) {
+    for (size_t i = 0; i < list->entries.size(); ++i) {
+      if (EntryId(list->entries[i]) == id &&
+          std::ranges::find(slots, i) == slots.end()) {
+        slots.push_back(i);
+        ordered.push_back(list->entries[i]);
+        break;
+      }
+    }
+  }
+  std::ranges::sort(slots);
+  bool changed = false;
+  for (size_t i = 0; i < slots.size(); ++i) {
+    if (EntryId(list->entries[slots[i]]) != EntryId(ordered[i])) {
+      changed = true;
+    }
+    list->entries[slots[i]] = std::move(ordered[i]);
+  }
+  if (changed) {
+    SaveAndNotify();
+  }
+}
+
+void SidebarItems::SetItemPage(std::string_view id,
+                               const GURL& url,
+                               const std::u16string& title) {
+  std::optional<ItemLocation> location = LocateItem(id);
+  if (!location || !url.is_valid()) {
+    return;
+  }
+  SidebarItem& item =
+      location->folder
+          ? location->folder->items[location->index]
+          : std::get<SidebarItem>(location->list->entries[location->index]);
+  if (item.url == url && item.title == title) {
+    return;
+  }
+  item.url = url;
+  item.title = title;
+  SaveAndNotify();
+}
+
+void SidebarItems::SetItemTitle(std::string_view id,
+                                const std::u16string& title) {
+  std::optional<ItemLocation> location = LocateItem(id);
+  if (!location) {
+    return;
+  }
+  SidebarItem& item =
+      location->folder
+          ? location->folder->items[location->index]
+          : std::get<SidebarItem>(location->list->entries[location->index]);
+  if (item.title == title) {
+    return;
+  }
+  item.title = title;
+  SaveAndNotify();
+}
+
+std::string SidebarItems::AddFolder(std::string_view list_key,
+                                    size_t index,
+                                    const std::u16string& title) {
+  SidebarFolder folder;
+  folder.id = NewId();
+  folder.title = title;
+  std::string id = folder.id;
+  SidebarList& list = lists_[std::string(list_key)];
+  index = std::min(index, list.entries.size());
+  list.entries.insert(list.entries.begin() + index, std::move(folder));
+  SaveAndNotify();
+  return id;
+}
+
+void SidebarItems::RemoveFolder(std::string_view folder_id) {
+  for (auto& [key, list] : lists_) {
+    auto it = std::ranges::find_if(
+        list.entries, [&](const SidebarList::Entry& entry) {
+          return std::holds_alternative<SidebarFolder>(entry) &&
+                 EntryId(entry) == folder_id;
+        });
+    if (it != list.entries.end()) {
+      list.entries.erase(it);
+      SaveAndNotify();
+      return;
+    }
+  }
+}
+
+void SidebarItems::SetFolderTitle(std::string_view folder_id,
+                                  const std::u16string& title) {
+  SidebarFolder* folder = FindMutableFolder(folder_id);
+  if (folder && folder->title != title) {
+    folder->title = title;
+    SaveAndNotify();
+  }
+}
+
+void SidebarItems::SetFolderCollapsed(std::string_view folder_id,
+                                      bool collapsed) {
+  SidebarFolder* folder = FindMutableFolder(folder_id);
+  if (folder && folder->collapsed != collapsed) {
+    folder->collapsed = collapsed;
+    SaveAndNotify();
+  }
+}
+
+void SidebarItems::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SidebarItems::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SidebarItems::Shutdown() {
+  windows_.reset();
+}
+
+std::optional<SidebarItems::ItemLocation> SidebarItems::LocateItem(
+    std::string_view id) {
+  for (auto& [key, list] : lists_) {
+    for (size_t i = 0; i < list.entries.size(); ++i) {
+      SidebarList::Entry& entry = list.entries[i];
+      if (auto* item = std::get_if<SidebarItem>(&entry)) {
+        if (item->id == id) {
+          return ItemLocation{&list, key, nullptr, i};
+        }
+        continue;
+      }
+      auto& folder = std::get<SidebarFolder>(entry);
+      for (size_t j = 0; j < folder.items.size(); ++j) {
+        if (folder.items[j].id == id) {
+          return ItemLocation{&list, key, &folder, j};
+        }
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+SidebarFolder* SidebarItems::FindMutableFolder(std::string_view id,
+                                               std::string* list_key) {
+  for (auto& [key, list] : lists_) {
+    for (SidebarList::Entry& entry : list.entries) {
+      auto* folder = std::get_if<SidebarFolder>(&entry);
+      if (folder && folder->id == id) {
+        if (list_key) {
+          *list_key = key;
+        }
+        return folder;
+      }
+    }
+  }
+  return nullptr;
+}
+
+std::optional<SidebarItem> SidebarItems::TakeItem(std::string_view id) {
+  std::optional<ItemLocation> location = LocateItem(id);
+  if (!location) {
+    return std::nullopt;
+  }
+  if (!location->folder) {
+    auto it = location->list->entries.begin() + location->index;
+    SidebarItem item = std::get<SidebarItem>(std::move(*it));
+    location->list->entries.erase(it);
+    return item;
+  }
+  std::vector<SidebarItem>& items = location->folder->items;
+  SidebarItem item = std::move(items[location->index]);
+  items.erase(items.begin() + location->index);
+  if (items.empty()) {
+    const std::string folder_id = location->folder->id;
+    location->folder = nullptr;
+    std::erase_if(location->list->entries,
+                  [&](const SidebarList::Entry& entry) {
+                    return std::holds_alternative<SidebarFolder>(entry) &&
+                           EntryId(entry) == folder_id;
+                  });
+  }
+  return item;
+}
+
+bool SidebarItems::InsertItem(std::string_view list_key,
+                              const SidebarPosition& position,
+                              SidebarItem item) {
+  if (!position.folder_id.empty()) {
+    std::string folder_list;
+    SidebarFolder* folder = FindMutableFolder(position.folder_id, &folder_list);
+    if (!folder || folder_list != list_key) {
+      return false;
+    }
+    const size_t index = std::min(position.index, folder->items.size());
+    folder->items.insert(folder->items.begin() + index, std::move(item));
+    return true;
+  }
+  SidebarList& list = lists_[std::string(list_key)];
+  const size_t index = std::min(position.index, list.entries.size());
+  list.entries.insert(list.entries.begin() + index, std::move(item));
+  return true;
+}
+
+void SidebarItems::MigrateHeliumPinnedTabs() {
+  PrefService* prefs = profile_->GetPrefs();
+  if (prefs->GetBoolean(kMigratedPref)) {
+    return;
+  }
+  prefs->SetBoolean(kMigratedPref, true);
+
+  // Chromium saves the pinned tabs of every window in one list, so the same
+  // site pinned in two windows appears twice.
+  std::set<GURL> seen;
+  for (const SidebarItem* item : GetList(kFavorites).AllItems()) {
+    seen.insert(item->url);
+  }
+  bool changed = false;
+  for (const StartupTab& tab : PinnedTabCodec::ReadPinnedTabs(profile_)) {
+    if (!tab.url.is_valid() || !seen.insert(tab.url).second) {
+      continue;
+    }
+    SidebarItem item;
+    item.id = NewId();
+    item.url = tab.url;
+    InsertItem(kFavorites, SidebarPosition{std::string(), SIZE_MAX},
+               std::move(item));
+    changed = true;
+  }
+  if (changed) {
+    SaveAndNotify();
+  }
+}
+
+void SidebarItems::Load() {
+  std::set<std::string> seen_ids;
+  for (const auto [key, value] : profile_->GetPrefs()->GetDict(kListsPref)) {
+    if (value.is_dict()) {
+      lists_[key] = ListFromValue(value.GetDict(), seen_ids);
+    }
+  }
+  // Earlier pinned-tab builds used one placeholder space. Adopt its list in
+  // the profile's first real space without changing item or folder IDs.
+  if (SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile_)) {
+    const std::string first_key = PinnedListKey(spaces->spaces().front().id);
+    if (lists_.contains("pinned.default") && !lists_.contains(first_key)) {
+      auto node = lists_.extract("pinned.default");
+      node.key() = first_key;
+      lists_.insert(std::move(node));
+      SaveAndNotify();
+    }
+  }
+}
+
+void SidebarItems::SaveAndNotify() {
+  base::DictValue lists;
+  for (const auto& [key, list] : lists_) {
+    if (!list.entries.empty()) {
+      lists.Set(key, ListToValue(list));
+    }
+  }
+  profile_->GetPrefs()->SetDict(kListsPref, std::move(lists));
+  for (Observer& observer : observers_) {
+    observer.OnSidebarItemsChanged();
+  }
+}
+
+}  // namespace rac

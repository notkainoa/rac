+#ifndef CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_WINDOW_SYNC_H_
+#define CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_WINDOW_SYNC_H_
+

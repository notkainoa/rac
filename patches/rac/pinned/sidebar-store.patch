+
+namespace rac {
+
+namespace {
+
+class SidebarTabTag : public content::WebContentsUserData<SidebarTabTag> {
+ public:
+  SidebarTabTag(content::WebContents* contents, std::string item_id)
+      : content::WebContentsUserData<SidebarTabTag>(*contents),
+        item_id_(std::move(item_id)) {}
+  ~SidebarTabTag() override = default;
+
+  const std::string& item_id() const { return item_id_; }
+
+ private:
+  friend WebContentsUserData;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  const std::string item_id_;
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SidebarTabTag);
+
+void SetTag(content::WebContents* contents, std::string_view item_id) {
+  contents->RemoveUserData(SidebarTabTag::UserDataKey());
+  if (!item_id.empty()) {
+    SidebarTabTag::CreateForWebContents(contents, std::string(item_id));
+  }
+}
+
+}  // namespace
+
+std::string GetSidebarItemId(content::WebContents* contents) {
+  SidebarTabTag* tag = SidebarTabTag::FromWebContents(contents);
+  return tag ? tag->item_id() : std::string();
+}
+
+void SetSidebarItemId(content::WebContents* contents,
+                      std::string_view item_id) {
+  if (GetSidebarItemId(contents) == item_id) {
+    return;
+  }
+  SetTag(contents, item_id);
+
+  SessionService* session_service = SessionServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  if (!session_service) {
+    return;
+  }
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (window_id.is_valid() && tab_id.is_valid()) {
+    // An empty value unlinks the tab when the session is restored.
+    session_service->AddTabExtraData(window_id, tab_id, kSidebarItemSessionKey,
+                                     std::string(item_id));
+  }
+}
+
+void RestoreSidebarItemId(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kSidebarItemSessionKey);
+  if (it != extra_data.end()) {
+    SetTag(contents, it->second);
+  }
+}
+
+}  // namespace rac

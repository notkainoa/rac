+namespace {
+
+// A tab the user may be looking at or have loaded. Closing one would lose
+// their place, so when a tab stops being an item it stays open.
+bool IsInUse(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  return tab->IsActivated() || (!contents->WasDiscarded() &&
+                                !contents->GetController().NeedsReload());
+}
+
+GURL GetPageUrl(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  const GURL& committed = contents->GetLastCommittedURL();
+  return committed.is_empty() ? contents->GetVisibleURL() : committed;
+}
+
+}  // namespace
+
+SidebarWindowSync::SidebarWindowSync(BrowserWindowInterface* browser,
+                                     SidebarItems* items)
+    : browser_(browser),
+      items_(items),
+      space_(GetSpaceForWindow(browser)) {
+  if (auto* manager = SpacesWindowManager::From(browser)) {
+    spaces_observation_.Observe(manager);
+  }
+  browser_->GetTabStripModel()->AddObserver(this);
+  items_observation_.Observe(items_);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&SidebarWindowSync::Start, weak_factory_.GetWeakPtr()));
+}
+
+SidebarWindowSync::~SidebarWindowSync() = default;
+
+base::CallbackListSubscription SidebarWindowSync::RegisterSpaceChanged(
+    base::RepeatingClosure callback) {
+  return space_callbacks_.Add(std::move(callback));
+}
+
+tabs::TabInterface* SidebarWindowSync::GetTabForItem(std::string_view item_id) {
+  for (tabs::TabInterface* tab : *browser_->GetTabStripModel()) {
+    if (GetSidebarItemId(tab->GetContents()) == item_id) {
+      return tab;
+    }
+  }
+  return nullptr;
+}
+
+const SidebarItem* SidebarWindowSync::GetItemForTab(tabs::TabInterface* tab) {
+  const std::string id = GetSidebarItemId(tab->GetContents());
+  return id.empty() ? nullptr : items_->FindItem(id);
+}
+
+bool SidebarWindowSync::IsFavorite(tabs::TabInterface* tab) {
+  const std::string id = GetSidebarItemId(tab->GetContents());
+  std::string list_key;
+  return !id.empty() && items_->FindItem(id, &list_key) &&
+         list_key == SidebarItems::kFavorites;
+}
+
+int SidebarWindowSync::GetPinnedTabCount() {
+  TabStripModel* model = browser_->GetTabStripModel();
+  const std::string pinned_key = SidebarItems::PinnedListKey(space_);
+  int count = 0;
+  for (int i = model->IndexOfFirstNonPinnedTab(); i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (!SpaceTabTag::IsVisible(tab)) {
+      continue;
+    }
+    const std::string id = GetSidebarItemId(tab->GetContents());
+    std::string list_key;
+    if (id.empty() || !items_->FindItem(id, &list_key) ||
+        list_key != pinned_key) {
+      break;
+    }
+    ++count;
+  }
+  return count;
+}
+
+void SidebarWindowSync::Release(tabs::TabInterface* tab) {
+  const std::string id = GetSidebarItemId(tab->GetContents());
+  if (id.empty()) {
+    return;
+  }
+  SetSidebarItemId(tab->GetContents(), std::string());
+  items_->RemoveItem(id);
+}
+
+void SidebarWindowSync::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kReplaced) {
+    // The old path for discarding a tab swaps in a new WebContents.
+    const TabStripModelChange::Replace* replace = change.GetReplace();
+    SetSidebarItemId(replace->new_contents,
+                     GetSidebarItemId(replace->old_contents));
+    return;
+  }
+  if (IsChangingTabs() || !started_) {
+    return;
+  }
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+    case TabStripModelChange::kRemoved:
+      ScheduleReconcile();
+      return;
+    case TabStripModelChange::kMoved:
+      if (change.GetMove()->tab->IsPinned()) {
+        PullFavoritesOrder();
+      }
+      ScheduleReconcile();
+      return;
+    case TabStripModelChange::kSelectionOnly:
+    case TabStripModelChange::kReplaced:
+      return;
+  }
+}
+
+void SidebarWindowSync::OnTabChangedAt(tabs::TabInterface* tab,
+                                       TabChangeType change_type) {
+  if (change_type != TabChangeType::kAll || IsChangingTabs()) {
+    return;
+  }
+  // Items made from a bare URL, such as Helium's pinned tabs, learn their
+  // title the first time their page loads.
+  const SidebarItem* item = GetItemForTab(tab);
+  content::WebContents* contents = tab->GetContents();
+  if (item && item->title.empty() &&
+      contents->GetLastCommittedURL() == item->url &&
+      !contents->GetTitle().empty() && !contents->IsLoading()) {
+    items_->SetItemTitle(item->id, contents->GetTitle());
+  }
+}
+
+void SidebarWindowSync::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                int index) {
+  if (IsChangingTabs() || !started_) {
+    return;
+  }
+  const std::string id = GetSidebarItemId(tab->GetContents());
+  std::string list_key;
+  if (!id.empty() && items_->FindItem(id, &list_key)) {
+    if (list_key == SidebarItems::kFavorites && !tab->IsPinned()) {
+      // Unpinned with Helium's menu or an extension.
+      Release(tab);
+    } else if (list_key != SidebarItems::kFavorites && tab->IsPinned()) {
+      items_->MoveItem(
+          id, SidebarItems::kFavorites,
+          SidebarPosition{std::string(), static_cast<size_t>(index)});
+    }
+  }
+  // A newly pinned open tab becomes a favorite in Reconcile().
+  ScheduleReconcile();
+}
+
+void SidebarWindowSync::TabGroupedStateChanged(
+    TabStripModel* tab_strip_model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  if (!IsChangingTabs() && started_ && new_group &&
+      !GetSidebarItemId(tab->GetContents()).empty()) {
+    ScheduleReconcile();
+  }
+}
+
+void SidebarWindowSync::CloseAllTabsStopped(TabStripModel* tab_strip_model,
+                                            CloseAllStoppedReason reason) {
+  if (reason == CloseAllStoppedReason::kCloseAllCanceled) {
+    ScheduleReconcile();
+  }
+}
+
+void SidebarWindowSync::OnSidebarItemsChanged() {
+  ScheduleReconcile();
+}
+
+void SidebarWindowSync::Start() {
+  started_ = true;
+  Reconcile();
+}
+
+void SidebarWindowSync::OnSpaceChanged() {
+  space_ = GetSpaceForWindow(browser_);
+  ScheduleReconcile();
+  space_callbacks_.Notify();
+}
+
+void SidebarWindowSync::OnActiveSpaceChanged(
+    BrowserWindowInterface* browser,
+    const std::optional<SpaceId>& previous,
+    const std::optional<SpaceId>& current) {
+  if (browser == browser_) {
+    OnSpaceChanged();
+  }
+}
+
+void SidebarWindowSync::ScheduleReconcile() {
+  if (!started_ || reconcile_pending_) {
+    return;
+  }
+  reconcile_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SidebarWindowSync::Reconcile,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SidebarWindowSync::Reconcile() {
+  reconcile_pending_ = false;
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (!started_ || model->closing_all() || browser_->IsDeleteScheduled()) {
+    return;
+  }
+  base::AutoReset<int> changing(&changing_tabs_, changing_tabs_ + 1);
+  const std::string pinned_key =
+      space_.is_valid() ? SidebarItems::PinnedListKey(space_) : std::string();
+
+  // Link each item to at most one tab. Tags whose item was removed, belongs
+  // to another space, or is already shown by another tab are dropped.
+  std::map<std::string, tabs::TabInterface*, std::less<>> tab_for_item;
+  std::vector<tabs::TabHandle> to_close;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    const std::string id = GetSidebarItemId(tab->GetContents());
+    if (id.empty()) {
+      continue;
+    }
+    std::string list_key;
+    const SidebarItem* item = items_->FindItem(id, &list_key);
+    const bool shown_here =
+        item &&
+        (list_key == SidebarItems::kFavorites || list_key == pinned_key);
+    // Inactive spaces' tabs remain in this same TabStripModel, but are hidden
+    // by SpacesWindowManager. Do not strip their tags or close their copies.
+    if (item && !shown_here && list_key.starts_with("pinned.")) {
+      continue;
+    }
+    if (shown_here) {
+      auto [it, inserted] = tab_for_item.emplace(id, tab);
+      if (inserted) {
+        continue;
+      }
+      // Two copies, such as after a tab is dragged in from another window.
+      if (IsInUse(tab) && !IsInUse(it->second)) {
+        std::swap(it->second, tab);
+      }
+    }
+    SetSidebarItemId(tab->GetContents(), std::string());
+    if (!IsInUse(tab)) {
+      to_close.push_back(tab->GetHandle());
+    }
+  }
+  for (const tabs::TabHandle& handle : to_close) {
+    tabs::TabInterface* tab = handle.Get();
+    // Never close the window's last tab, which would close the window.
+    if (tab && model->count() > 1) {
+      model->CloseWebContentsAt(model->GetIndexOfTab(tab),
+                                TabCloseTypes::CLOSE_NONE);
+    }
+  }
+
+  // Helium pins tabs from its menu, its sidebar, session restore, and
+  // extensions. Every pinned tab is a favorite, so take over the untagged
+  // ones: match a favorite this window hasn't opened yet, or add a new one.
+  for (int i = 0; i < model->IndexOfFirstNonPinnedTab(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (!GetSidebarItemId(tab->GetContents()).empty()) {
+      continue;
+    }
+    const GURL url = GetPageUrl(tab);
+    std::string id;
+    for (const SidebarItem* item :
+         items_->GetList(SidebarItems::kFavorites).AllItems()) {
+      if (item->url == url && !tab_for_item.contains(item->id)) {
+        id = item->id;
+        break;
+      }
+    }
+    if (id.empty() && url.is_valid()) {
+      id = items_->AddItem(
+          SidebarItems::kFavorites,
+          SidebarPosition{std::string(), static_cast<size_t>(i)}, url,
+          tab->GetContents()->GetTitle());
+    }
+    if (!id.empty()) {
+      SetSidebarItemId(tab->GetContents(), id);
+      tab_for_item[id] = tab;
+    }
+  }
+
+  // Open the items this window doesn't show yet, unloaded.
+  const std::vector<const SidebarItem*> favorites =
+      items_->GetList(SidebarItems::kFavorites).AllItems();
+  const std::vector<const SidebarItem*> pinned =
+      items_->GetList(pinned_key).AllItems();
+  auto add_tab = [&](const SidebarItem& item, int index, bool pin) {
+    sessions::SerializedNavigationEntry navigation;
+    navigation.set_index(0);
+    navigation.set_virtual_url(item.url);
+    navigation.set_title(item.title);
+    std::map<std::string, std::string> extra_data{
+        {kSidebarItemSessionKey, item.id}};
+    if (!pin && space_.is_valid()) {
+      extra_data.emplace(kTabSpaceExtraDataKey, space_.AsLowercaseString());
+    }
+    content::WebContents* contents = chrome::AddRestoredTab(
+        browser_, base::span_from_ref(navigation), index,
+        /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+        /*group=*/std::nullopt, /*select=*/false, pin,
+        /*last_active_time_ticks=*/base::TimeTicks(),
+        /*last_active_time=*/base::Time(), /*storage_namespace=*/nullptr,
+        sessions::SerializedUserAgentOverride(),
+        extra_data, /*from_session_restore=*/false,
+        /*is_active_browser=*/std::nullopt,
+        chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+    if (contents) {
+      if (!pin && space_.is_valid()) {
+        SpaceTabTag::Set(contents, space_);
+      }
+      tab_for_item[item.id] = tabs::TabInterface::GetFromContents(contents);
+    }
+  };
+  for (size_t i = 0; i < favorites.size(); ++i) {
+    if (!tab_for_item.contains(favorites[i]->id)) {
+      add_tab(*favorites[i],
+              std::min(static_cast<int>(i), model->IndexOfFirstNonPinnedTab()),
+              /*pin=*/true);
+    }
+  }
+  for (size_t i = 0; i < pinned.size(); ++i) {
+    if (!tab_for_item.contains(pinned[i]->id)) {
+      add_tab(*pinned[i],
+              std::min(model->IndexOfFirstNonPinnedTab() + static_cast<int>(i),
+                       model->count()),
+              /*pin=*/false);
+    }
+  }
+
+  // Put every item's tab in its place. Favorites first, as pinned tabs.
+  for (size_t i = 0; i < favorites.size(); ++i) {
+    auto it = tab_for_item.find(favorites[i]->id);
+    if (it == tab_for_item.end()) {
+      continue;
+    }
+    tabs::TabInterface* tab = it->second;
+    int index = model->GetIndexOfTab(tab);
+    if (!tab->IsPinned()) {
+      index = model->SetTabPinned(index, true);
+    }
+    if (index != static_cast<int>(i)) {
+      model->MoveWebContentsAt(index, i, /*select_after_move=*/false);
+    }
+  }
+  // Then pinned tabs, as the first open tabs. They're never in a tab group;
+  // the sidebar draws their folders. Moving each into place in order pushes
+  // any open tab that landed among them, such as a link opened next to its
+  // opener, down to the open tabs.
+  int target = model->IndexOfFirstNonPinnedTab();
+  for (const SidebarItem* item : pinned) {
+    auto it = tab_for_item.find(item->id);
+    if (it == tab_for_item.end()) {
+      continue;
+    }
+    tabs::TabInterface* tab = it->second;
+    int index = model->GetIndexOfTab(tab);
+    if (space_.is_valid() &&
+        SpaceTabTag::Get(tab->GetContents()) != space_) {
+      SpaceTabTag::Set(tab->GetContents(), space_);
+    }
+    if (tab->IsPinned()) {
+      index = model->SetTabPinned(index, false);
+    }
+    if (tab->GetGroup()) {
+      model->RemoveFromGroup({index});
+      index = model->GetIndexOfTab(tab);
+    }
+    if (index != target) {
+      model->MoveWebContentsAt(index, target, /*select_after_move=*/false);
+    }
+    ++target;
+  }
+}
+
+void SidebarWindowSync::PullFavoritesOrder() {
+  std::vector<std::string> ids;
+  TabStripModel* model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->IndexOfFirstNonPinnedTab(); ++i) {
+    std::string id = GetSidebarItemId(model->GetTabAtIndex(i)->GetContents());
+    if (!id.empty()) {
+      ids.push_back(std::move(id));
+    }
+  }
+  items_->SetOrder(SidebarItems::kFavorites, ids);
+}
+
+SidebarWindows::SidebarWindows(Profile* profile, SidebarItems* items)
+    : profile_(profile), items_(items) {
+  ProfileBrowserCollection* collection =
+      ProfileBrowserCollection::GetForProfile(profile_);
+  collection_observation_.Observe(collection);
+  collection->ForEach([this](BrowserWindowInterface* browser) {
+    OnBrowserCreated(browser);
+    return true;
+  });
+}
+
+SidebarWindows::~SidebarWindows() = default;
+
+// static
+SidebarWindowSync* SidebarWindows::ForBrowser(BrowserWindowInterface* browser) {
+  SidebarItems* items = SidebarItems::Get(browser->GetProfile());
+  SidebarWindows* windows = items ? items->windows() : nullptr;
+  return windows ? windows->Find(browser) : nullptr;
+}
+
+void SidebarWindows::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      windows_.contains(browser)) {
+    return;
+  }
+  windows_[browser] = std::make_unique<SidebarWindowSync>(browser, items_);
+}
+
+void SidebarWindows::OnBrowserClosed(BrowserWindowInterface* browser) {
+  windows_.erase(browser);
+}
+
+SidebarWindowSync* SidebarWindows::Find(BrowserWindowInterface* browser) {
+  auto it = windows_.find(browser);
+  return it == windows_.end() ? nullptr : it->second.get();
+}
+
+}  // namespace rac

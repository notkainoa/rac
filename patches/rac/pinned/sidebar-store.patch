+
+class BrowserCollection;
+class BrowserWindowInterface;
+class Profile;
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace rac {
+
+struct SidebarItem;
+
+// Keeps one window's tabs matching the sidebar items. The window's tab strip
+// holds, in order:
+//
+//   1. Favorites, as Chromium's pinned tabs.
+//   2. The window's space's pinned tabs, as the first unpinned tabs. Folders
+//      are drawn by the sidebar; the tabs inside them are ordinary tabs.
+//   3. Open tabs.
+//
+// A tab is linked to its item by a tag (see sidebar_tab_tag.h). Tabs for
+// items the window hasn't opened yet are created unloaded.
+class SidebarWindowSync : public TabStripModelObserver,
+                          public SidebarItems::Observer,
+                          public SpacesWindowManager::Observer {
+ public:
+  SidebarWindowSync(BrowserWindowInterface* browser, SidebarItems* items);
+  SidebarWindowSync(const SidebarWindowSync&) = delete;
+  SidebarWindowSync& operator=(const SidebarWindowSync&) = delete;
+  ~SidebarWindowSync() override;
+
+  BrowserWindowInterface* browser() { return browser_; }
+  const SpaceId& space() const { return space_; }
+  base::CallbackListSubscription RegisterSpaceChanged(
+      base::RepeatingClosure callback);
+
+  // Returns the window's tab for `item_id`, or null.
+  tabs::TabInterface* GetTabForItem(std::string_view item_id);
+  // Returns the item shown by `tab`, or null for an open tab.
+  const SidebarItem* GetItemForTab(tabs::TabInterface* tab);
+  // True if `tab` is a favorite, false if it's a pinned tab or an open tab.
+  bool IsFavorite(tabs::TabInterface* tab);
+  // Returns the number of pinned tabs at the top of the open tabs, which is
+  // where the sidebar draws the line between pinned and open tabs.
+  int GetPinnedTabCount();
+
+  // Turns `tab` into an open tab before its item is removed, so it stays
+  // open in this window. Other windows close their copy if it isn't loaded.
+  void Release(tabs::TabInterface* tab);
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void TabGroupedStateChanged(TabStripModel* tab_strip_model,
+                              std::optional<tab_groups::TabGroupId> old_group,
+                              std::optional<tab_groups::TabGroupId> new_group,
+                              tabs::TabInterface* tab,
+                              int index) override;
+  void CloseAllTabsStopped(TabStripModel* tab_strip_model,
+                           CloseAllStoppedReason reason) override;
+
+  // SidebarItems::Observer:
+  void OnSidebarItemsChanged() override;
+  void OnActiveSpaceChanged(BrowserWindowInterface* browser,
+                            const std::optional<SpaceId>& previous,
+                            const std::optional<SpaceId>& current) override;
+
+ private:
+  void Start();
+  void OnSpaceChanged();
+  void ScheduleReconcile();
+  // Makes the tab strip match the items. Does nothing if it already does.
+  void Reconcile();
+  // Copies the order the user dragged favorites into back to the items.
+  void PullFavoritesOrder();
+  bool IsChangingTabs() const { return changing_tabs_ > 0; }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<SidebarItems> items_;
+  SpaceId space_;
+  // Session restore and startup add a new window's tabs right after creating
+  // it, so the first reconcile waits for them and adopts restored tabs.
+  bool started_ = false;
+  bool reconcile_pending_ = false;
+  // Counts nested changes this class is making to the tab strip, so it can
+  // ignore the notifications they send.
+  int changing_tabs_ = 0;
+  base::RepeatingClosureList space_callbacks_;
+  base::ScopedObservation<SpacesWindowManager, SpacesWindowManager::Observer>
+      spaces_observation_{this};
+  base::ScopedObservation<SidebarItems, SidebarItems::Observer>
+      items_observation_{this};
+  base::WeakPtrFactory<SidebarWindowSync> weak_factory_{this};
+};
+
+// Creates a SidebarWindowSync for each normal window of the profile.
+class SidebarWindows : public BrowserCollectionObserver {
+ public:
+  SidebarWindows(Profile* profile, SidebarItems* items);
+  SidebarWindows(const SidebarWindows&) = delete;
+  SidebarWindows& operator=(const SidebarWindows&) = delete;
+  ~SidebarWindows() override;
+
+  // Returns null for windows without favorites and pinned tabs.
+  static SidebarWindowSync* ForBrowser(BrowserWindowInterface* browser);
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+ private:
+  SidebarWindowSync* Find(BrowserWindowInterface* browser);
+
+  const raw_ptr<Profile> profile_;
+  const raw_ptr<SidebarItems> items_;
+  std::map<BrowserWindowInterface*, std::unique_ptr<SidebarWindowSync>>
+      windows_;
+  base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
+      collection_observation_{this};
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_WINDOW_SYNC_H_

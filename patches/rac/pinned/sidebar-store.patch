+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_ITEMS_H_
+#define CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_ITEMS_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <variant>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/ui/rac/sidebar/pinned_tabs_space.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace rac {
+
+class SidebarWindows;
+
+// A favorite or a pinned tab. Every window shows each item as a real tab;
+// the item remembers the page it was pinned on, and the tab can browse away
+// and reset back to it.
+struct SidebarItem {
+  SidebarItem();
+  SidebarItem(const SidebarItem&);
+  SidebarItem& operator=(const SidebarItem&);
+  ~SidebarItem();
+
+  std::string id;
+  GURL url;
+  std::u16string title;
+};
+
+// A folder of pinned tabs. Folders are one level deep.
+struct SidebarFolder {
+  SidebarFolder();
+  SidebarFolder(const SidebarFolder&);
+  SidebarFolder& operator=(const SidebarFolder&);
+  ~SidebarFolder();
+
+  std::string id;
+  std::u16string title;
+  bool collapsed = false;
+  std::vector<SidebarItem> items;
+};
+
+// Favorites hold only items. Pinned tabs hold items and folders.
+struct SidebarList {
+  using Entry = std::variant<SidebarItem, SidebarFolder>;
+
+  SidebarList();
+  SidebarList(const SidebarList&);
+  SidebarList& operator=(const SidebarList&);
+  ~SidebarList();
+
+  // Every item in sidebar order, including those inside folders. Windows
+  // keep their tabs in this order.
+  std::vector<const SidebarItem*> AllItems() const;
+  const SidebarFolder* FindFolder(std::string_view id) const;
+  // Returns the folder holding `item_id`, or null if it's loose or missing.
+  const SidebarFolder* FindFolderOfItem(std::string_view item_id) const;
+
+  std::vector<Entry> entries;
+};
+
+// Where an item goes: `index` within `folder_id`, or among the top-level
+// entries when `folder_id` is empty. Indexes past the end are clamped.
+struct SidebarPosition {
+  std::string folder_id;
+  size_t index = 0;
+};
+
+// The profile's favorites, and each space's pinned tabs and folders. This is
+// the source of truth: every window of the profile creates, removes, and
+// reorders tabs to match it. Saved in prefs, so the items come back even
+// when the browser doesn't restore the last session.
+class SidebarItems : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Called after any change to any list.
+    virtual void OnSidebarItemsChanged() = 0;
+  };
+
+  static constexpr char kFavorites[] = "favorites";
+  static std::string PinnedListKey(const SpaceId& space);
+
+  explicit SidebarItems(Profile* profile);
+  SidebarItems(const SidebarItems&) = delete;
+  SidebarItems& operator=(const SidebarItems&) = delete;
+  ~SidebarItems() override;
+
+  // Returns null for profiles without favorites and pinned tabs, such as
+  // incognito and guest.
+  static SidebarItems* Get(Profile* profile);
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  // Returns an empty list if `key` has no items.
+  const SidebarList& GetList(std::string_view key) const;
+  // Returns the item, and the key of the list it's in if `list_key` isn't
+  // null.
+  const SidebarItem* FindItem(std::string_view id,
+                              std::string* list_key = nullptr) const;
+
+  // Returns the new item's id.
+  std::string AddItem(std::string_view list_key,
+                      const SidebarPosition& position,
+                      const GURL& url,
+                      const std::u16string& title);
+  // Removes the item. A folder left empty is removed too.
+  void RemoveItem(std::string_view id);
+  void MoveItem(std::string_view id,
+                std::string_view list_key,
+                const SidebarPosition& position);
+  // Reorders the top-level entries of `list_key` to follow `ids`, which may
+  // name items and folders. Entries missing from `ids` keep their place.
+  void SetOrder(std::string_view list_key, const std::vector<std::string>& ids);
+  // Changes the remembered page.
+  void SetItemPage(std::string_view id,
+                   const GURL& url,
+                   const std::u16string& title);
+  void SetItemTitle(std::string_view id, const std::u16string& title);
+
+  // Returns the new folder's id. A new folder stays until it has held an
+  // item and been emptied.
+  std::string AddFolder(std::string_view list_key,
+                        size_t index,
+                        const std::u16string& title);
+  // Removes the folder and the items in it.
+  void RemoveFolder(std::string_view folder_id);
+  void SetFolderTitle(std::string_view folder_id, const std::u16string& title);
+  void SetFolderCollapsed(std::string_view folder_id, bool collapsed);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  SidebarWindows* windows() { return windows_.get(); }
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  struct ItemLocation {
+    raw_ptr<SidebarList> list = nullptr;
+    std::string list_key;
+    // Null for a top-level item.
+    raw_ptr<SidebarFolder> folder = nullptr;
+    size_t index = 0;
+  };
+
+  std::optional<ItemLocation> LocateItem(std::string_view id);
+  SidebarFolder* FindMutableFolder(std::string_view id,
+                                   std::string* list_key = nullptr);
+  // Takes the item out of its list, removing a folder left empty.
+  std::optional<SidebarItem> TakeItem(std::string_view id);
+  // Returns false if `position` names a folder that isn't in `list_key`.
+  bool InsertItem(std::string_view list_key,
+                  const SidebarPosition& position,
+                  SidebarItem item);
+  void MigrateHeliumPinnedTabs();
+  void Load();
+  void SaveAndNotify();
+
+  const raw_ptr<Profile> profile_;
+  std::map<std::string, SidebarList, std::less<>> lists_;
+  base::ObserverList<Observer> observers_;
+  std::unique_ptr<SidebarWindows> windows_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SIDEBAR_SIDEBAR_ITEMS_H_

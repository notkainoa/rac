+bool IsLoaded(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  return !contents->WasDiscarded() && !contents->GetController().NeedsReload();
+}
+
+// Leaves the active tab before it closes or resets, so resetting doesn't
+// load it again and closing doesn't load the pinned tab next to it. Goes to
+// the loaded tab used most recently, or to a new tab if none is loaded.
+void LeaveActiveTab(TabStripModel* model,
+                    const std::vector<tabs::TabInterface*>& closing) {
+  tabs::TabInterface* next = nullptr;
+  for (tabs::TabInterface* tab : *model) {
+    if (std::ranges::find(closing, tab) != closing.end() ||
+        !SpaceTabTag::IsVisible(tab) || !IsLoaded(tab)) {
+      continue;
+    }
+    if (!next || tab->GetContents()->GetLastActiveTimeTicks() >
+                     next->GetContents()->GetLastActiveTimeTicks()) {
+      next = tab;
+    }
+  }
+  if (next) {
+    model->ActivateTabAt(model->GetIndexOfTab(next));
+  } else {
+    model->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+  }
+}
+
 SidebarWindowSync* GetWindow(TabStripModel* model) {
   BrowserWindowInterface* browser =
       model->delegate()->GetBrowserWindowInterface();
@@ -85,4 +122,73 @@
   return item ? item->name : std::u16string();
 }
 
+std::vector<tabs::TabInterface*> ResetSidebarTabsInsteadOfClosing(
+    TabStripModel* model,
+    std::vector<tabs::TabInterface*> tabs,
+    uint32_t close_types) {
+  SidebarWindowSync* window = GetWindow(model);
+  if (!window || !(close_types & TabCloseTypes::CLOSE_USER_GESTURE) ||
+      model->closing_all()) {
+    return tabs;
+  }
+  std::vector<tabs::TabInterface*> to_close;
+  std::vector<tabs::TabHandle> to_reset;
+  bool closes_active_sidebar_tab = false;
+  for (tabs::TabInterface* tab : tabs) {
+    if (GetSidebarTabKind(window, tab) == SidebarTabKind::kOpen) {
+      to_close.push_back(tab);
+      continue;
+    }
+    closes_active_sidebar_tab |= tab->IsActivated();
+    // Pages that ask before they're left, and split tabs, close the usual
+    // way. The window then opens their item again.
+    if (tab->IsSplit() ||
+        tab->GetContents()->NeedToFireBeforeUnloadOrUnloadEvents()) {
+      to_close.push_back(tab);
+    } else {
+      to_reset.push_back(tab->GetHandle());
+    }
+  }
+  if (closes_active_sidebar_tab) {
+    LeaveActiveTab(model, tabs);
+  }
+  for (const tabs::TabHandle& handle : to_reset) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    // So reopening a closed tab brings back the page the user left.
+    if ((close_types & TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB) &&
+        IsLoaded(tab)) {
+      model->delegate()->CreateHistoricalTab(tab->GetContents());
+    }
+    window->ResetTab(tab);
+  }
+  return to_close;
+}
+
+bool ClosingResetsFavorites(BrowserWindowInterface* browser) {
+  return SidebarWindows::ForBrowser(browser) != nullptr;
+}
+
+void AdjustSidebarTabNavigation(NavigateParams* params) {
+  content::WebContents* source = params->source_contents;
+  if (params->disposition != WindowOpenDisposition::CURRENT_TAB || !source ||
+      params->contents_to_insert ||
+      !(ui::PageTransitionGetQualifier(params->transition) &
+        ui::PAGE_TRANSITION_FROM_ADDRESS_BAR) ||
+      params->url.SchemeIs(url::kJavaScriptScheme) ||
+      params->url == source->GetLastCommittedURL()) {
+    return;
+  }
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(source);
+  BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  SidebarWindowSync* window =
+      browser ? SidebarWindows::ForBrowser(browser) : nullptr;
+  if (window && GetSidebarTabKind(window, tab) != SidebarTabKind::kOpen) {
+    params->disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+}
+
 }  // namespace rac

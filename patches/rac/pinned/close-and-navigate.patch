+namespace rac {
+
+namespace {
+
+constexpr int kIconSize = 14;
+constexpr int kButtonSize = 20;
+constexpr int kCornerRadius = 4;
+
+SidebarWindowSync* GetWindow(const tabs::TabInterface* tab) {
+  const BrowserWindowInterface* browser = tab->GetBrowserWindowInterface();
+  return browser ? SidebarWindows::ForBrowser(
+                       const_cast<BrowserWindowInterface*>(browser))
+                 : nullptr;
+}
+
+class PinnedPageButton : public views::ImageButton {
+  METADATA_HEADER(PinnedPageButton, views::ImageButton)
+
+ public:
+  explicit PinnedPageButton(tabs::TabHandle tab)
+      : views::ImageButton(base::BindRepeating(&PinnedPageButton::OnPressed,
+                                               base::Unretained(this))),
+        tab_(tab) {
+    const std::u16string label =
+        l10n_util::GetStringUTF16(IDS_RAC_SIDEBAR_GO_BACK_TO_PINNED_PAGE);
+    SetTooltipText(label);
+    GetViewAccessibility().SetName(label);
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    SetImageModel(STATE_NORMAL,
+                  ui::ImageModel::FromVectorIcon(
+                      features::IsRoundedIconsEnabled()
+                          ? vector_icons::kArrowBackIcon
+                          : vector_icons::kBackArrowChromeRefreshOldIcon,
+                      kColorTabForegroundInactiveFrameActive, kIconSize));
+    SetImageHorizontalAlignment(ALIGN_CENTER);
+    SetImageVerticalAlignment(ALIGN_MIDDLE);
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+    views::InkDrop::Get(this)->SetBaseColor(
+        kColorTabForegroundInactiveFrameActive);
+    views::InkDrop::Get(this)->SetHighlightOpacity(0.16f);
+    SetHasInkDropActionOnClick(true);
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kCornerRadius);
+  }
+
+  // views::ImageButton:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kButtonSize, kButtonSize);
+  }
+
+ private:
+  void OnPressed() {
+    tabs::TabInterface* tab = tab_.Get();
+    if (SidebarWindowSync* window = tab ? GetWindow(tab) : nullptr) {
+      GoBackToPinnedPage(window, tab);
+    }
+  }
+
+  const tabs::TabHandle tab_;
+};
+
+BEGIN_METADATA(PinnedPageButton)
+END_METADATA
+
+}  // namespace
+
+std::unique_ptr<views::View> CreatePinnedPageButton(tabs::TabInterface* tab) {
+  return std::make_unique<PinnedPageButton>(tab->GetHandle());
+}
+
+bool ShouldShowPinnedPageButton(const tabs::TabInterface* tab) {
+  SidebarWindowSync* window = tab ? GetWindow(tab) : nullptr;
+  auto* mutable_tab = const_cast<tabs::TabInterface*>(tab);
+  return window &&
+         GetSidebarTabKind(window, mutable_tab) == SidebarTabKind::kPinned &&
+         HasLeftPinnedPage(window, mutable_tab);
+}
+
+}  // namespace rac

+void SidebarWindowSync::ResetTab(tabs::TabInterface* tab) {
+  const SidebarItem* item = GetItemForTab(tab);
+  if (!item || tab->IsActivated()) {
+    return;
+  }
+  Profile* profile = browser_->GetProfile();
+  const sessions::SerializedNavigationEntry navigation =
+      GetItemNavigation(*item);
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries =
+      sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+          base::span_from_ref(navigation), profile);
+  content::WebContents::CreateParams params(profile);
+  params.initially_hidden = true;
+  params.desired_renderer_state =
+      content::WebContents::CreateParams::kNoRendererProcess;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(params);
+  contents->GetController().Restore(0, content::RestoreType::kRestored,
+                                    &entries);
+  content::WebContents* new_contents = contents.get();
+  const GURL url = item->url;
+
+  // Swapping the contents, as discarding a tab does, keeps the tab's row and
+  // place. OnTabStripModelChanged() moves the tag to the new contents once
+  // the session knows it, so a restored session keeps it.
+  TabStripModel* model = browser_->GetTabStripModel();
+  model->DiscardWebContents(tab->GetContents(), std::move(contents)).reset();
+  if (auto* favicon_driver =
+          favicon::ContentFaviconDriver::FromWebContents(new_contents)) {
+    favicon_driver->FetchFavicon(url, /*is_same_document=*/false);
+  }
+  model->UpdateWebContentsState(new_contents, TabChangeType::kAll);
+}

+TEST_F(SpacesStoreTest, PinnedTabRetainsSidebarIdentityAcrossClose) {
+  StoredTab tab;
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_virtual_url(GURL("https://example.test/pinned"));
+  tab.navigations.push_back(std::move(navigation));
+  tab.sidebar_item_id = "saved-sidebar-item";
+
+  std::optional<StoredTab> restored = StoredTab::FromDict(tab.ToDict());
+  ASSERT_TRUE(restored);
+  EXPECT_EQ(restored->sidebar_item_id, tab.sidebar_item_id);
+  ASSERT_EQ(restored->navigations.size(), 1u);
+  EXPECT_EQ(restored->navigations.front().virtual_url(),
+            GURL("https://example.test/pinned"));
+}

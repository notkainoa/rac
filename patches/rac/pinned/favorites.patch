@@ -0,0 +1,37 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_SIDEBAR_STYLE_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_SIDEBAR_STYLE_H_
+
+class SkPath;
+
+namespace gfx {
+class Canvas;
+}  // namespace gfx
+
+namespace views {
+class View;
+}  // namespace views
+
+// How the sidebar draws favorites and pinned tabs.
+namespace rac::sidebar_style {
+
+// Favorites are Arc-style tiles: taller than a tab row, at most four to a
+// row, filled instead of outlined. The compact sidebar shows one column of
+// tab-height tiles.
+inline constexpr int kFavoriteTileHeight = 44;
+inline constexpr int kFavoriteTileWidth = 44;
+inline constexpr int kMaxFavoritesPerRow = 4;
+
+// Fills a favorite tile at rest. Chromium's hover and active fills paint on
+// top, so the active tile stays the brightest.
+void PaintFavoriteTileRest(gfx::Canvas* canvas,
+                           const views::View& tile,
+                           const SkPath& path,
+                           bool frame_active);
+
+}  // namespace rac::sidebar_style
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_SIDEBAR_STYLE_H_

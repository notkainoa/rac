+// Matches a tab's favicon and title placement so folder rows line up with
+// the tabs around them.
+constexpr int kIconSize = 16;
+constexpr int kTitleGap = 7;
+// Below this width only the folder icon fits, as in the compact sidebar.
+constexpr int kMinWidthForTitle = 72;
+constexpr int kFolderIndent = 12;
+constexpr int kDividerHeight = 9;
+constexpr int kDividerInset = 8;
+
+}  // namespace

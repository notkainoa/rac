+// Where the sidebar's rows go around the open tabs container's children for
+// one layout pass. The container lays out its tab views as usual, and asks
+// this for the rows to put before each one and how to place it.
+class PinnedSectionLayout {
+ public:
+  struct Child {
+    Child();
+    Child(Child&&);
+    Child& operator=(Child&&);
+    ~Child();
+
+    // Folder headers and the divider to put above the child.
+    std::vector<raw_ptr<views::View>> rows_before;
+    int indent = 0;
+    // True for a tab inside a collapsed folder.
+    bool hidden = false;
+  };
+
+  PinnedSectionLayout();
+  PinnedSectionLayout(PinnedSectionLayout&&);
+  PinnedSectionLayout& operator=(PinnedSectionLayout&&);
+  ~PinnedSectionLayout();
+
+  // Returns null for children outside the pinned section that have no rows
+  // above them.
+  const Child* Find(const views::View* child) const;
+
+  // Places `rows` from `y` down, the same way the container places tabs.
+  // Updates `y` and `width` past the rows.
+  void LayoutRows(const std::vector<raw_ptr<views::View>>& rows,
+                  int x,
+                  views::SizeBound available_width,
+                  int horizontal_padding,
+                  int vertical_padding,
+                  int& y,
+                  int& width,
+                  views::ProposedLayout& layouts) const;
+
+  // Places the rows that follow the last child, and hides unused rows.
+  void LayoutTrailingRows(int x,
+                          views::SizeBound available_width,
+                          int horizontal_padding,
+                          int vertical_padding,
+                          int& y,
+                          int& width,
+                          views::ProposedLayout& layouts) const;
+
+ private:
+  friend class PinnedSection;
+
+  base::flat_map<const views::View*, Child> children_;
+  std::vector<raw_ptr<views::View>> trailing_rows_;
+  std::vector<raw_ptr<views::View>> unused_rows_;
+};
+
+// Draws a window's pinned tabs as a section at the top of the open tabs:
+// folder headers above the tabs in each folder, and a divider between the
+// pinned tabs and the open tabs. The tabs themselves stay Chromium's tab
+// views, so they load, drag, and close like any tab.
+class PinnedSection : public views::ViewObserver,
+                      public SidebarItems::Observer,
+                      public TabStripModelObserver {
+ public:
+  // Gives a vertical open tabs container its pinned section.
+  static void Attach(views::View* container);
+  // Returns null for containers without one.
+  static const PinnedSection* Get(const views::View* container);
+
+  explicit PinnedSection(views::View* container);
+  PinnedSection(const PinnedSection&) = delete;
+  PinnedSection& operator=(const PinnedSection&) = delete;
+  ~PinnedSection() override;
+
+  // `children` are the container's tab, group, and split views in order.
+  PinnedSectionLayout ComputeLayout(
+      const std::vector<views::View*>& children,
+      tabs::VerticalTabStripCollapseState collapse_state) const;
+
+  // views::ViewObserver:
+  void OnViewAddedToWidget(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // SidebarItems::Observer:
+  void OnSidebarItemsChanged() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  void Start(BrowserWindowInterface* browser);
+  const SidebarList& GetList() const;
+  // Adds, updates, and removes folder headers to match the folders.
+  void UpdateRows();
+  void ToggleFolder(const std::string& folder_id);
+
+  raw_ptr<views::View> container_;
+  raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  raw_ptr<SidebarItems> items_ = nullptr;
+  raw_ptr<views::View> divider_ = nullptr;
+  std::map<std::string, raw_ptr<FolderHeaderView>> folder_headers_;
+  base::CallbackListSubscription space_subscription_;
+  base::ScopedObservation<views::View, views::ViewObserver>
+      container_observation_{this};
+  base::ScopedObservation<SidebarItems, SidebarItems::Observer>
+      items_observation_{this};
+};
+
+}  // namespace rac

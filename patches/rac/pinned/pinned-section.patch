+const PinnedSectionLayout::Child* PinnedSectionLayout::Find(
+    const views::View* child) const {
+  auto it = children_.find(child);
+  return it == children_.end() ? nullptr : &it->second;
+}
+
+void PinnedSectionLayout::LayoutRows(
+    const std::vector<raw_ptr<views::View>>& rows,
+    int x,
+    views::SizeBound available_width,
+    int horizontal_padding,
+    int vertical_padding,
+    int& y,
+    int& width,
+    views::ProposedLayout& layouts) const {
+  for (views::View* row : rows) {
+    const views::SizeBound row_width =
+        available_width.is_bounded()
+            ? available_width - (x + horizontal_padding)
+            : available_width;
+    gfx::Rect bounds(row->GetPreferredSize(views::SizeBounds(row_width, {})));
+    bounds.set_origin(gfx::Point(x, y));
+    if (row_width.is_bounded()) {
+      bounds.set_width(row_width.value());
+    }
+    layouts.child_layouts.emplace_back(row, true, bounds);
+    y += bounds.height() + vertical_padding;
+    width = std::max(width, bounds.right());
+  }
+}
+
+void PinnedSectionLayout::LayoutTrailingRows(
+    int x,
+    views::SizeBound available_width,
+    int horizontal_padding,
+    int vertical_padding,
+    int& y,
+    int& width,
+    views::ProposedLayout& layouts) const {
+  LayoutRows(trailing_rows_, x, available_width, horizontal_padding,
+             vertical_padding, y, width, layouts);
+  for (views::View* row : unused_rows_) {
+    layouts.child_layouts.emplace_back(row, false, gfx::Rect(x, y, 0, 0));
+  }
+}

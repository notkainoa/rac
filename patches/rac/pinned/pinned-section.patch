+
+PinnedSectionLayout PinnedSection::ComputeLayout(
+    const std::vector<views::View*>& children,
+    tabs::VerticalTabStripCollapseState collapse_state) const {
+  PinnedSectionLayout layout;
+  if (!browser_) {
+    return layout;
+  }
+  SidebarWindowSync* sync = SidebarWindows::ForBrowser(browser_);
+  const SidebarList& list = GetList();
+
+  std::vector<raw_ptr<views::View>> pending_rows;
+  base::flat_map<const tabs::TabInterface*, views::View*> tab_views;
+  if (sync && !list.entries.empty()) {
+    for (views::View* child : children) {
+      if (const auto* tab_view = views::AsViewClass<TabView>(child)) {
+        tab_views.emplace(tab_view->GetTabInterface(), child);
+      }
+    }
+    const tabs::TabInterface* active_tab =
+        browser_->GetTabStripModel()->GetActiveTab();
+    const bool expanded =
+        collapse_state == tabs::VerticalTabStripCollapseState::kExpanded;
+
+    auto place_item = [&](const SidebarItem& item,
+                          const SidebarFolder* folder) {
+      const tabs::TabInterface* tab = sync->GetTabForItem(item.id);
+      auto it = tab ? tab_views.find(tab) : tab_views.end();
+      if (it == tab_views.end()) {
+        return;
+      }
+      PinnedSectionLayout::Child& child = layout.children_[it->second];
+      child.rows_before = std::move(pending_rows);
+      pending_rows.clear();
+      child.indent = folder && expanded ? kFolderIndent : 0;
+      child.hidden = folder && folder->collapsed && tab != active_tab;
+    };
+
+    for (const SidebarList::Entry& entry : list.entries) {
+      if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+        place_item(*item, nullptr);
+        continue;
+      }
+      const auto& folder = std::get<SidebarFolder>(entry);
+      auto header = folder_headers_.find(folder.id);
+      if (header != folder_headers_.end()) {
+        pending_rows.push_back(header->second.get());
+      }
+      for (const SidebarItem& item : folder.items) {
+        place_item(item, &folder);
+      }
+    }
+    pending_rows.push_back(divider_.get());
+  }
+
+  // Rows left over from the section go above the first open tab.
+  if (!pending_rows.empty()) {
+    for (views::View* child : children) {
+      if (const auto* tab_view = views::AsViewClass<TabView>(child);
+          tab_view && !SpaceTabTag::IsVisible(tab_view->GetTabInterface())) {
+        continue;
+      }
+      if (!layout.children_.contains(child)) {
+        layout.children_[child].rows_before = std::move(pending_rows);
+        pending_rows.clear();
+        break;
+      }
+    }
+    layout.trailing_rows_ = std::move(pending_rows);
+  }
+
+  auto contains = [](const std::vector<raw_ptr<views::View>>& rows,
+                     const views::View* row) {
+    return std::ranges::any_of(
+        rows, [row](const views::View* other) { return other == row; });
+  };
+  auto is_used = [&](const views::View* row) {
+    for (const auto& [child, info] : layout.children_) {
+      if (contains(info.rows_before, row)) {
+        return true;
+      }
+    }
+    return contains(layout.trailing_rows_, row);
+  };
+  if (divider_ && !is_used(divider_)) {
+    layout.unused_rows_.push_back(divider_.get());
+  }
+  for (const auto& [id, header] : folder_headers_) {
+    if (!is_used(header)) {
+      layout.unused_rows_.push_back(header.get());
+    }
+  }
+  return layout;
+}
+
+void PinnedSection::OnViewAddedToWidget(views::View* observed_view) {
+  if (browser_) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForNativeWindow(
+      observed_view->GetWidget()->GetTopLevelWidget()->GetNativeWindow());
+  if (browser_view && browser_view->browser()) {
+    Start(browser_view->browser());
+  }
+}
+
+void PinnedSection::OnViewIsDeleting(views::View* observed_view) {
+  // The container deletes its children, the rows among them, before it
+  // deletes this.
+  divider_ = nullptr;
+  folder_headers_.clear();
+  items_observation_.Reset();
+  container_observation_.Reset();
+  space_subscription_ = {};
+  if (browser_) {
+    browser_->GetTabStripModel()->RemoveObserver(this);
+  }
+  browser_ = nullptr;
+  items_ = nullptr;
+  container_ = nullptr;
+}
+
+void PinnedSection::OnSidebarItemsChanged() {
+  UpdateRows();
+}
+
+void PinnedSection::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // The active tab stays visible in a collapsed folder.
+  if (selection.active_tab_changed() && container_) {
+    container_->InvalidateLayout();
+  }
+}
+
+void PinnedSection::Start(BrowserWindowInterface* browser) {
+  items_ = SidebarItems::Get(browser->GetProfile());
+  if (!items_ || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    items_ = nullptr;
+    return;
+  }
+  browser_ = browser;
+  items_observation_.Observe(items_);
+  browser_->GetTabStripModel()->AddObserver(this);
+  if (SidebarWindowSync* sync = SidebarWindows::ForBrowser(browser_)) {
+    space_subscription_ = sync->RegisterSpaceChanged(
+        base::BindRepeating(&PinnedSection::UpdateRows, base::Unretained(this)));
+  }
+  divider_ = container_->AddChildView(std::make_unique<SectionDividerView>());
+  UpdateRows();
+}
+
+const SidebarList& PinnedSection::GetList() const {
+  return items_->GetList(
+      SidebarItems::PinnedListKey(GetSpaceForWindow(browser_)));
+}
+
+void PinnedSection::UpdateRows() {
+  if (!container_ || !items_) {
+    return;
+  }
+  std::map<std::string, raw_ptr<FolderHeaderView>> old_headers;
+  std::swap(old_headers, folder_headers_);
+  for (const SidebarList::Entry& entry : GetList().entries) {
+    const auto* folder = std::get_if<SidebarFolder>(&entry);
+    if (!folder) {
+      continue;
+    }
+    FolderHeaderView* header = nullptr;
+    if (auto it = old_headers.find(folder->id); it != old_headers.end()) {
+      header = it->second;
+      old_headers.erase(it);
+    } else {
+      header = container_->AddChildView(std::make_unique<FolderHeaderView>(
+          base::BindRepeating(&PinnedSection::ToggleFolder,
+                              base::Unretained(this), folder->id)));
+    }
+    header->SetFolder(*folder);
+    folder_headers_.emplace(folder->id, header);
+  }
+  for (auto& [id, header] : old_headers) {
+    FolderHeaderView* view = header;
+    header = nullptr;
+    container_->RemoveChildViewT(view);
+  }
+  container_->InvalidateLayout();
+}
+
+void PinnedSection::ToggleFolder(const std::string& folder_id) {
+  if (!items_) {
+    return;
+  }
+  const SidebarFolder* folder = GetList().FindFolder(folder_id);
+  if (folder) {
+    items_->SetFolderCollapsed(folder_id, !folder->collapsed);
+  }
+}
+
+}  // namespace rac

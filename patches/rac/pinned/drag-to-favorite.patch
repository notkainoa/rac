+std::optional<int> PinnedSection::GetFirstPinEdge(
+    TabDragHandler& handler) const {
+  if (!browser_ || !items_) {
+    return std::nullopt;
+  }
+  std::set<std::string> pinned_ids;
+  for (const SidebarList::Entry& entry : GetList().entries) {
+    if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+      pinned_ids.insert(item->id);
+      continue;
+    }
+    for (const SidebarItem& item : std::get<SidebarFolder>(entry).items) {
+      pinned_ids.insert(item.id);
+    }

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_FAVORITES_DROP_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_FAVORITES_DROP_H_
+
+#include <optional>
+
+namespace rac {
+
+// What a tab drag in the sidebar would drop into.
+enum class SidebarDropTarget {
+  kNone,
+  kFavorites,
+  kPinnedTabs,
+  kOpenTabs,
+};
+
+// Where a tab drag is, in screen y, with what the sidebar shows around it.
+struct FavoritesDropGeometry {
+  int pointer_y = 0;
+  // The top of the tab strip. The open tabs start here when the favorites
+  // grid is empty.
+  int strip_top = 0;
+  // The top of the open tabs now. It moves while the favorites grid opens
+  // or closes.
+  int open_tabs_top = 0;
+  // Whether the window has favorites besides the dragged tabs.
+  bool other_favorites = false;
+  // Whether the dragged tabs are in the favorites grid now.
+  bool dragged_in_favorites = false;
+  // Whether the open tabs are scrolled all the way up.
+  bool open_tabs_at_top = true;
+  // How far below the top of the open tabs a drag starts pinning, or nullopt
+  // without a pinned section.
+  std::optional<int> first_pin_edge;
+  // The height of one row of favorites.
+  int favorite_row_height = 0;
+  // How much of the pin zone the band always leaves above `first_pin_edge`.
+  int min_pin_zone = 0;
+};
+
+// The band at the top of the open tabs that targets the favorites while the
+// window has none, so a drag can find them without reaching into the header.
+// It sits above the pin zone and never takes more of it than leaves
+// `min_pin_zone`. It's zero when there are favorites to drop among, and
+// while the open tabs are scrolled down, where the top edge scrolls them.
+int GetFavoritesBandHeight(const FavoritesDropGeometry& geometry);
+
+// Returns whether the drag targets the favorites instead of the pinned or
+// open tabs. Above the open tabs always does. Without other favorites, the
+// band does too, and a drag in the grid stays there until it's below the
+// grid's row, so the grid opening or closing never moves the drag in or out.
+bool IsFavoritesDrop(const FavoritesDropGeometry& geometry);
+
+// Returns whether moving from `from` to `to` reaches a drop target that
+// deserves a tap: a drag that starts somewhere and then reaches favorites or
+// pinned tabs. Starting, staying, and leaving for the open tabs don't.
+bool ShouldPlayDropTargetHaptic(SidebarDropTarget from, SidebarDropTarget to);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_FAVORITES_DROP_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar/favorites_drop.h"
+
+#include <algorithm>
+
+namespace rac {
+
+int GetFavoritesBandHeight(const FavoritesDropGeometry& geometry) {
+  if (geometry.other_favorites || !geometry.open_tabs_at_top ||
+      !geometry.first_pin_edge) {
+    return 0;
+  }
+  return std::clamp(*geometry.first_pin_edge - geometry.min_pin_zone, 0,
+                    geometry.favorite_row_height / 2);
+}
+
+bool IsFavoritesDrop(const FavoritesDropGeometry& geometry) {
+  if (geometry.other_favorites) {
+    return geometry.pointer_y < geometry.open_tabs_top;
+  }
+  if (geometry.dragged_in_favorites) {
+    return geometry.pointer_y <
+           std::max(geometry.open_tabs_top,
+                    geometry.strip_top + geometry.favorite_row_height);
+  }
+  // The grid may still be closing behind a drag that just left it, so the
+  // band hangs from where the open tabs will be, not where they are.
+  return geometry.pointer_y <
+         geometry.strip_top + GetFavoritesBandHeight(geometry);
+}
+
+bool ShouldPlayDropTargetHaptic(SidebarDropTarget from, SidebarDropTarget to) {
+  return from != SidebarDropTarget::kNone && from != to &&
+         (to == SidebarDropTarget::kFavorites ||
+          to == SidebarDropTarget::kPinnedTabs);
+}
+
+}  // namespace rac

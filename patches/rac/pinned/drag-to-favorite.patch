+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar/favorites_drop.h"
+
+#include <array>
+
+#include "base/containers/span.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+constexpr int kStripTop = 100;
+constexpr int kRowHeight = 44;
+constexpr int kMinPinZone = 16;
+// The space name row above the closed divider, which waits where it opens.
+constexpr int kClosedDividerY = 36;
+// The space name row above the first pinned tab, then half that tab.
+constexpr int kFirstPinnedTabMiddle = 32 + 16;
+// Where the open tabs settle below one row of favorites.
+constexpr int kOpenTabsBelowRow = kStripTop + kRowHeight + 8;
+
+FavoritesDropGeometry NoFavorites(int pin_edge) {
+  FavoritesDropGeometry geometry;
+  geometry.strip_top = kStripTop;
+  geometry.open_tabs_top = kStripTop;
+  geometry.first_pin_edge = pin_edge;
+  geometry.favorite_row_height = kRowHeight;
+  geometry.min_pin_zone = kMinPinZone;
+  return geometry;
+}
+
+FavoritesDropGeometry At(FavoritesDropGeometry geometry, int pointer_y) {
+  geometry.pointer_y = pointer_y;
+  return geometry;
+}
+
+// Lowest pointer y that still targets the favorites.
+int FavoritesEdge(const FavoritesDropGeometry& geometry) {
+  int y = kStripTop - 100;
+  while (IsFavoritesDrop(At(geometry, y))) {
+    ++y;
+  }
+  return y;
+}
+
+TEST(FavoritesDropTest, BandWithoutFavoritesOrPinnedTabs) {
+  const FavoritesDropGeometry geometry = NoFavorites(kClosedDividerY);
+  const int band = GetFavoritesBandHeight(geometry);
+  EXPECT_EQ(kClosedDividerY - kMinPinZone, band);
+  EXPECT_TRUE(IsFavoritesDrop(At(geometry, kStripTop - 10)));
+  EXPECT_TRUE(IsFavoritesDrop(At(geometry, kStripTop + band - 1)));
+  EXPECT_FALSE(IsFavoritesDrop(At(geometry, kStripTop + band)));
+  // The pin zone, above the closed divider, stays below the band.
+  EXPECT_LE(kStripTop + band + kMinPinZone, kStripTop + kClosedDividerY);
+}
+
+TEST(FavoritesDropTest, BandWithoutFavoritesWithPinnedTabs) {
+  const FavoritesDropGeometry geometry = NoFavorites(kFirstPinnedTabMiddle);
+  EXPECT_EQ(kRowHeight / 2, GetFavoritesBandHeight(geometry));
+  // Dropping above the first pinned tab stays possible below the band.
+  EXPECT_LT(GetFavoritesBandHeight(geometry) + kMinPinZone,
+            kFirstPinnedTabMiddle + 1);
+}
+
+TEST(FavoritesDropTest, BandLeavesTheShortPinZoneAlone) {
+  // No space name row: the first pinned tab's middle is near the top.
+  EXPECT_EQ(0, GetFavoritesBandHeight(NoFavorites(kMinPinZone)));
+  EXPECT_EQ(4, GetFavoritesBandHeight(NoFavorites(kMinPinZone + 4)));
+  // Without the band, only the header above the open tabs is favorites.
+  EXPECT_EQ(kStripTop, FavoritesEdge(NoFavorites(kMinPinZone)));
+}
+
+// A launch without the spaces UI has no space name row. The closed divider
+// then waits at the very top, above "+ New Tab", and so does a first pinned
+// tab: the pin zone starts at the top of the open tabs.
+TEST(FavoritesDropTest, NoBandWithoutTheSpaceNameRow) {
+  constexpr int kClosedDividerAtTop = 0;
+  constexpr int kFirstPinnedTabMiddleAtTop = 16;
+  for (int pin_edge : {kClosedDividerAtTop, kFirstPinnedTabMiddleAtTop}) {
+    const FavoritesDropGeometry geometry = NoFavorites(pin_edge);
+    // No band, so the band never takes the pin zone...
+    EXPECT_EQ(0, GetFavoritesBandHeight(geometry));
+    EXPECT_FALSE(IsFavoritesDrop(At(geometry, kStripTop)));
+    // ...and the header above the open tabs still reaches the favorites.
+    EXPECT_TRUE(IsFavoritesDrop(At(geometry, kStripTop - 1)));
+  }
+}
+
+TEST(FavoritesDropTest, FavoritesAddNoBand) {
+  FavoritesDropGeometry geometry = NoFavorites(kClosedDividerY);
+  geometry.other_favorites = true;
+  geometry.open_tabs_top = kOpenTabsBelowRow;
+  EXPECT_EQ(0, GetFavoritesBandHeight(geometry));
+  EXPECT_EQ(kOpenTabsBelowRow, FavoritesEdge(geometry));
+}
+
+TEST(FavoritesDropTest, NoBandWithoutAPinnedSection) {
+  FavoritesDropGeometry geometry = NoFavorites(kClosedDividerY);
+  geometry.first_pin_edge.reset();
+  EXPECT_EQ(0, GetFavoritesBandHeight(geometry));
+  EXPECT_EQ(kStripTop, FavoritesEdge(geometry));
+}
+
+TEST(FavoritesDropTest, ScrolledOpenTabsLeaveTheTopEdgeToAutoscroll) {
+  FavoritesDropGeometry geometry = NoFavorites(kClosedDividerY);
+  geometry.open_tabs_at_top = false;
+  EXPECT_EQ(0, GetFavoritesBandHeight(geometry));
+  EXPECT_FALSE(IsFavoritesDrop(At(geometry, kStripTop)));
+  EXPECT_TRUE(IsFavoritesDrop(At(geometry, kStripTop - 1)));
+}
+
+TEST(FavoritesDropTest, GridOpeningKeepsTheDragInFavorites) {
+  FavoritesDropGeometry geometry = NoFavorites(kClosedDividerY);
+  geometry.dragged_in_favorites = true;
+  // Just pinned from the band: the grid hasn't opened yet.
+  for (int open_tabs_top = kStripTop; open_tabs_top <= kOpenTabsBelowRow;
+       open_tabs_top += 4) {
+    geometry.open_tabs_top = open_tabs_top;
+    EXPECT_TRUE(IsFavoritesDrop(At(geometry, kStripTop + 10)));
+    EXPECT_TRUE(IsFavoritesDrop(At(geometry, kStripTop + kRowHeight - 1)));
+  }
+}
+
+TEST(FavoritesDropTest, TheWayBackDoesNotBounce) {
+  // The only favorite, dragged down out of its row.
+  FavoritesDropGeometry geometry = NoFavorites(kClosedDividerY);
+  geometry.dragged_in_favorites = true;
+  geometry.open_tabs_top = kOpenTabsBelowRow;
+  const int below_grid = kOpenTabsBelowRow;
+  EXPECT_TRUE(IsFavoritesDrop(At(geometry, below_grid - 1)));
+  EXPECT_FALSE(IsFavoritesDrop(At(geometry, below_grid)));
+
+  // It unpins, and the grid closes over the next frames. The band doesn't
+  // catch it on any of them.
+  geometry.dragged_in_favorites = false;
+  for (int open_tabs_top = kOpenTabsBelowRow; open_tabs_top >= kStripTop;
+       open_tabs_top -= 4) {
+    geometry.open_tabs_top = open_tabs_top;
+    EXPECT_FALSE(IsFavoritesDrop(At(geometry, below_grid)));
+  }
+}
+
+TEST(FavoritesDropTest, HapticsOnlyOnReachingATarget) {
+  using enum SidebarDropTarget;
+  // Where a drag starts isn't reached.
+  EXPECT_FALSE(ShouldPlayDropTargetHaptic(kNone, kFavorites));
+  EXPECT_FALSE(ShouldPlayDropTargetHaptic(kNone, kPinnedTabs));
+  EXPECT_FALSE(ShouldPlayDropTargetHaptic(kNone, kOpenTabs));
+  // Hovering doesn't repeat it.
+  EXPECT_FALSE(ShouldPlayDropTargetHaptic(kFavorites, kFavorites));
+  EXPECT_FALSE(ShouldPlayDropTargetHaptic(kPinnedTabs, kPinnedTabs));
+  // Up from the open tabs: pin, then favorite.
+  EXPECT_TRUE(ShouldPlayDropTargetHaptic(kOpenTabs, kPinnedTabs));
+  EXPECT_TRUE(ShouldPlayDropTargetHaptic(kPinnedTabs, kFavorites));
+  EXPECT_TRUE(ShouldPlayDropTargetHaptic(kOpenTabs, kFavorites));
+  // The way back reaches the pinned tabs, but the open tabs aren't a target.
+  EXPECT_TRUE(ShouldPlayDropTargetHaptic(kFavorites, kPinnedTabs));
+  EXPECT_FALSE(ShouldPlayDropTargetHaptic(kPinnedTabs, kOpenTabs));
+  EXPECT_FALSE(ShouldPlayDropTargetHaptic(kFavorites, kOpenTabs));
+}
+
+TEST(FavoritesDropTest, AllOfADragBecomesFavoritesOrNone) {
+  const FavoriteDragTab open;
+  const FavoriteDragTab split{.split = true};
+  const FavoriteDragTab not_in_strip{.in_strip = false};
+  const FavoriteDragTab no_view{.has_view = false};
+
+  // One tab, or several selected ones (grouped tabs among them: pinning takes
+  // them out of their group, as the favorites grid always has).
+  EXPECT_TRUE(CanDragBecomeFavorites(false, std::array{open}));
+  EXPECT_TRUE(CanDragBecomeFavorites(false, std::array{open, open, open}));
+
+  // A whole group's drag never does, however many tabs it holds.
+  EXPECT_FALSE(CanDragBecomeFavorites(true, std::array{open}));
+  EXPECT_FALSE(CanDragBecomeFavorites(true, std::array{open, open}));
+
+  // One tab that can't pin keeps every tab out, rather than leaving some
+  // behind.
+  EXPECT_FALSE(CanDragBecomeFavorites(false, std::array{open, split}));
+  EXPECT_FALSE(CanDragBecomeFavorites(false, std::array{not_in_strip, open}));
+  EXPECT_FALSE(CanDragBecomeFavorites(false, std::array{open, open, no_view}));
+  EXPECT_FALSE(CanDragBecomeFavorites(false, base::span<FavoriteDragTab>()));
+}
+
+HeaderDropGeometry Sidebar(bool window_makes_favorites, int x, int y) {
+  // A 200 wide sidebar from y 0 to 800, with the tab strip from y 74.
+  return {.window_makes_favorites = window_makes_favorites,
+          .pointer_x = x,
+          .pointer_y = y,
+          .region_left = 0,
+          .region_top = 0,
+          .region_right = 200,
+          .region_bottom = 800,
+          .strip_top = 74};
+}
+
+TEST(FavoritesDropTest, HeaderTakesFavoritesOnlyWhereTheyCanBeMade) {
+  // A normal window, a drag that can pin: the header above the strip.
+  EXPECT_TRUE(IsHeaderFavoritesDrop(Sidebar(true, 96, 30)));
+  EXPECT_TRUE(IsHeaderFavoritesDrop(Sidebar(true, 0, 0)));
+  EXPECT_TRUE(IsHeaderFavoritesDrop(Sidebar(true, 199, 73)));
+  // The strip itself, and anywhere outside the sidebar, stay Chromium's.
+  EXPECT_FALSE(IsHeaderFavoritesDrop(Sidebar(true, 96, 74)));
+  EXPECT_FALSE(IsHeaderFavoritesDrop(Sidebar(true, 96, -1)));
+  EXPECT_FALSE(IsHeaderFavoritesDrop(Sidebar(true, 200, 30)));
+  EXPECT_FALSE(IsHeaderFavoritesDrop(Sidebar(true, -1, 30)));
+
+  // Incognito, app and popup windows, and a group's drag: never, so
+  // Chromium's bounds check runs unchanged and the header tears the tab off.
+  for (int y : {0, 30, 73, 74, 400}) {
+    EXPECT_FALSE(IsHeaderFavoritesDrop(Sidebar(false, 96, y)));
+  }
+}
+

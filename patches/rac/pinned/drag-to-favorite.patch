+std::optional<int> PinnedSection::GetFirstPinEdge(
+    TabDragHandler& handler) const {
+  if (!browser_ || !items_) {
+    return std::nullopt;
+  }
+  std::set<std::string> pinned_ids;
+  for (const SidebarList::Entry& entry : GetList().entries) {
+    if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+      pinned_ids.insert(item->id);
+      continue;
+    }
+    for (const SidebarItem& item : std::get<SidebarFolder>(entry).items) {
+      pinned_ids.insert(item.id);
+    }
+  }
+  // The highest slot HandleTabDrag() would pin before: a pinned tab's or a
+  // folder header's middle, or the divider's, which waits closed and zero
+  // high above the open tabs while there are no pinned tabs.
+  std::optional<int> edge;
+  for (views::View* child : container_->children()) {
+    if (handler.IsViewDragging(*child)) {
+      continue;
+    }
+    const gfx::Rect bounds = child->bounds();
+    std::optional<int> child_edge;
+    if (child == divider_) {
+      child_edge = bounds.height() ? bounds.CenterPoint().y() : bounds.y();
+    } else if (!child->GetVisible()) {
+      continue;
+    } else if (views::IsViewClass<FolderHeaderView>(child)) {
+      child_edge = bounds.CenterPoint().y();
+    } else if (const auto* tab_view = views::AsViewClass<TabView>(child)) {
+      const tabs::TabInterface* tab = tab_view->GetTabInterface();
+      if (tab && pinned_ids.contains(GetSidebarItemId(tab->GetContents()))) {
+        child_edge = bounds.CenterPoint().y();
+      }
+    }
+    if (child_edge && (!edge || *child_edge < *edge)) {
+      edge = child_edge;
+    }
+  }
+  return edge;
+}

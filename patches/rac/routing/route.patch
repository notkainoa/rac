+// Site controls' row. Its toggle reads and writes the rule as it's pressed;
+// the bubble lives only while it's open, so nothing here observes.
+class SiteRoutingRow : public views::View {
+  METADATA_HEADER(SiteRoutingRow, views::View)
+
+ public:
+  SiteRoutingRow(Profile* profile,
+                 SitePattern pattern,
+                 base::Uuid window_space,
+                 const SpacesService& spaces)
+      : profile_key_(ProfileKey(profile)),
+        pattern_(std::move(pattern)),
+        window_space_(window_space),
+        spaces_(&spaces) {
+    SetUseDefaultFillLayout(true);
+    row_ = AddChildView(std::make_unique<RichControlsContainerView>());
+    row_->SetIcon(PageInfoViewFactory::GetImageModel(kOpenInNewIcon));
+    const std::u16string title = l10n_util::GetStringFUTF16(
+        IDS_RAC_LINK_ROUTING_ROW_TITLE, base::UTF8ToUTF16(pattern_.value()),
+        SpaceName(spaces, window_space_));
+    row_->SetTitle(title);
+
+    auto toggle = std::make_unique<views::ToggleButton>(base::BindRepeating(
+        &SiteRoutingRow::OnToggled, base::Unretained(this)));
+    toggle->SetPreferredSize(gfx::Size(toggle->GetPreferredSize().width(),
+                                       row_->GetFirstLineHeight()));
+    toggle->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(0,
+                          ChromeLayoutProvider::Get()->GetDistanceMetric(
+                              views::DISTANCE_RELATED_LABEL_HORIZONTAL),
+                          0, 0));
+    toggle->GetViewAccessibility().SetName(title);
+    toggle_ = row_->AddControl(std::move(toggle));
+    SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(base::BindRepeating(
+            &RichControlsContainerView::FlexRule, base::Unretained(row_))));
+    Update(/*animate=*/false);
+  }
+
+ private:
+  // The space the site's links open in now, if a rule points at one that
+  // still exists.
+  std::optional<base::Uuid> RuleSpace() const {
+    std::optional<LinkRules> rules = ReadRules();
+    const LinkRule* rule =
+        rules ? FindRuleForPattern(*rules, pattern_, profile_key_) : nullptr;
+    if (!rule) {
+      return std::nullopt;
+    }
+    const base::Uuid space = base::Uuid::ParseCaseInsensitive(rule->space);
+    if (!space.is_valid() || !spaces_->FindSpace(space)) {
+      return std::nullopt;
+    }
+    return space;
+  }
+
+  void Update(bool animate) {
+    const std::optional<base::Uuid> space = RuleSpace();
+    const bool on = space == window_space_;
+    if (animate) {
+      toggle_->AnimateIsOn(on);
+    } else {
+      toggle_->SetIsOn(on);
+    }
+    if (elsewhere_label_) {
+      delete std::exchange(elsewhere_label_, nullptr);
+    }
+    if (space && !on) {
+      elsewhere_label_ = row_->AddSecondaryLabel(l10n_util::GetStringFUTF16(
+          IDS_RAC_LINK_ROUTING_ROW_ELSEWHERE, SpaceName(*spaces_, *space)));
+    }
+    PreferredSizeChanged();
+  }
+
+  void OnToggled() {
+    std::optional<LinkRules> rules = ReadRules();
+    if (!rules) {
+      return;
+    }
+    if (toggle_->GetIsOn()) {
+      SetRule(*rules, pattern_, profile_key_, window_space_.AsLowercaseString(),
+              base::Uuid::GenerateRandomV4().AsLowercaseString());
+    } else {
+      RemoveRule(*rules, pattern_, profile_key_);
+    }
+    WriteRules(*rules);
+    Update(/*animate=*/true);
+  }
+
+  const std::string profile_key_;
+  const SitePattern pattern_;
+  const base::Uuid window_space_;
+  // The profile's, which outlives the bubble.
+  const raw_ptr<const SpacesService> spaces_;
+  raw_ptr<RichControlsContainerView> row_ = nullptr;
+  raw_ptr<views::ToggleButton> toggle_ = nullptr;
+  raw_ptr<views::Label> elsewhere_label_ = nullptr;
+};

+// The routed tab, for the toast's "Open here instead".
+struct RoutedLink {
+  base::WeakPtr<BrowserWindowInterface> window;
+  tabs::TabHandle tab;
+  // The space the window showed before the link switched it, if it did.
+  std::optional<base::Uuid> previous_space;
+};
+
+RoutedLink& LastRoutedLink() {
+  static base::NoDestructor<RoutedLink> link;
+  return *link;
+}
+
+std::string ProfileKey(const Profile* profile) {
+  return profile->GetBaseName().AsUTF8Unsafe();
+}
+
+bool IsRegularProfile(const Profile* profile) {
+  return profile && !profile->IsOffTheRecord() && !profile->IsGuestSession();
+}
+
+std::optional<LinkRules> ReadRules() {
+  return ParseLinkRules(
+      g_browser_process->local_state()->GetDict(kLinkRoutingPref));
+}
+
+void WriteRules(const LinkRules& rules) {
+  g_browser_process->local_state()->SetDict(kLinkRoutingPref,
+                                            SerializeLinkRules(rules));
+}
+
+std::u16string SpaceName(const SpacesService& spaces, const base::Uuid& id) {
+  const Space* space = spaces.FindSpace(id);
+  if (!space) {
+    return std::u16string();
+  }
+  if (!space->name.empty()) {
+    return base::UTF8ToUTF16(space->name);
+  }
+  return l10n_util::GetStringFUTF16(
+      IDS_RAC_SPACE_FALLBACK_NAME,
+      base::NumberToString16(spaces.GetIndex(id).value_or(0) + 1));
+}
+
+// Whether windows can switch spaces now. RunWhenStoreReady runs its callback
+// at once when the store has loaded.
+bool IsStoreReady(SpacesWindowManager* manager) {
+  bool ready = false;
+  manager->RunWhenStoreReady(base::BindOnce([](bool* ready) { *ready = true; },
+                                            base::Unretained(&ready)));
+  return ready;
+}
+
+// The window a little window's tab would join (PickExpandTarget): the most
+// recently active normal window of `profile` on the current desktop. Null
+// when there is none.
+BrowserWindowInterface* PickTargetWindow(Profile* profile) {
+  std::vector<BrowserWindowInterface*> windows;
+  std::vector<little_window::WindowFacts> facts;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* window) {
+        little_window::WindowFacts fact{
+            .profile = window->GetProfile(),
+            .normal = window->GetType() == BrowserWindowInterface::TYPE_NORMAL,
+            .closing = window->IsDeleteScheduled()};
+        if (BrowserWindow* native = BrowserWindow::FromBrowser(window)) {
+          fact.on_current_desktop = native->IsOnCurrentWorkspace();
+        }
+        windows.push_back(window);
+        facts.push_back(std::move(fact));
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  const little_window::ExpandTarget target =
+      little_window::PickExpandTarget(profile, facts);
+  return target.window ? windows[*target.window] : nullptr;
+}
+
+bool IsUntouchedNewTab(content::WebContents* contents) {
+  const GURL& url = contents->GetVisibleURL();
+  return contents->GetController().GetEntryCount() <= 1 &&
+         (contents->GetController().IsInitialBlankNavigation() ||
+          url == GURL(chrome::kChromeUINewTabURL) ||
+          url == GURL(chrome::kChromeUINewTabPageURL));
+}
+
+// Switches `window` to `space`. Returns the New Tab page the switch added
+// when the space had no tabs, so it can close once the link's tab is in.
+tabs::TabHandle ShowSpaceInWindow(SpacesWindowManager* manager,
+                                  BrowserWindowInterface* window,
+                                  const base::Uuid& space) {
+  TabStripModel* model = window->GetTabStripModel();
+  std::vector<tabs::TabInterface*> before;
+  for (tabs::TabInterface* tab : *model) {
+    before.push_back(tab);
+  }
+  manager->ShowSpace(window, space);
+  tabs::TabInterface* active = model->GetActiveTab();
+  if (active && !base::Contains(before, active) &&
+      IsUntouchedNewTab(active->GetContents())) {
+    return active->GetHandle();
+  }
+  return tabs::TabHandle();
+}
+
+void CloseIfUntouched(BrowserWindowInterface* window, tabs::TabHandle handle) {
+  tabs::TabInterface* tab = handle.Get();
+  TabStripModel* model = window->GetTabStripModel();
+  if (!tab || model->count() <= 1 || !IsUntouchedNewTab(tab->GetContents())) {
+    return;
+  }
+  const int index = model->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+  }
+}
+
+// The toast's "Open here instead": the routed tab moves, as it is, into the
+// little window it would have opened in, and the window goes back to the
+// space it showed.
+void OpenRoutedLinkHere(BrowserWindowInterface* browser) {
+  RoutedLink link = std::exchange(LastRoutedLink(), RoutedLink());
+  tabs::TabInterface* tab = link.tab.Get();
+  if (!browser || link.window.get() != browser || !tab) {
+    return;
+  }
+  if (link.previous_space) {
+    if (SpacesWindowManager* manager = SpacesWindowManager::From(browser)) {
+      manager->ShowSpace(browser, *link.previous_space);
+    }
+  }
+  const int index = browser->GetTabStripModel()->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    little_window::MoveTabToLittleWindow(browser, index);
+  }
+}
+
+void ShowRoutedToast(BrowserWindowInterface* window, std::u16string space) {
+  ToastController* toasts = ToastController::From(window);
+  if (!toasts) {
+    return;
+  }
+  SetOpenHereHandler(&OpenRoutedLinkHere);
+  ToastParams params(ToastId::kRacLinkRouted);
+  params.body_string_replacement_params.push_back(std::move(space));
+  toasts->MaybeShowToast(std::move(params));
+}
+
+// "Open in <space>": the little window's page moves, without reloading, into
+// the window showing the space, or into the window Open as Tab would use,
+// which switches to the space first.
+void OpenLittleWindowInSpace(BrowserWindowInterface* little,
+                             const base::Uuid& space) {
+  TabStripModel* tabs = little->GetTabStripModel();
+  Profile* profile = little->GetProfile();
+  SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile);
+  SpacesWindowManager* manager =
+      SpacesWindowManagerFactory::GetForProfile(profile);
+  if (tabs->empty() || !spaces || !manager || !spaces->FindSpace(space)) {
+    little_window::OpenAsTab(little);
+    return;
+  }
+  BrowserWindowInterface* into = manager->GetWindowHoldingSpace(space);
+  tabs::TabHandle added_tab;
+  if (!into) {
+    into = PickTargetWindow(profile);
+    // Made before the page leaves: closing the last window first would
+    // start shutting the browser down.
+    if (!into) {
+      into = CreateBrowserWindow(
+          BrowserWindowCreateParams(*profile, /*from_user_gesture=*/true));
+    }
+    if (!into) {
+      return;
+    }
+    added_tab = ShowSpaceInWindow(manager, into, space);
+  }
+  // As in little_window::OpenAsTab: the WebContents moves as it is, into the
+  // space the window shows, and emptying the little window closes it.
+  std::unique_ptr<content::WebContents> contents =
+      tabs->DetachWebContentsAtForInsertion(tabs->active_index());
+  content::WebContents* moved = contents.get();
+  into->GetTabStripModel()->AppendWebContents(std::move(contents),
+                                              /*foreground=*/true);
+  // The little window is left out of session restore; record the page's
+  // history now, or the tab would be lost at the next restart.
+  if (SessionService* session =
+          SessionServiceFactory::GetForProfileIfExisting(profile)) {
+    session->TabRestored(moved, /*pinned=*/false);
+  }
+  CloseIfUntouched(into, added_tab);
+  if (BrowserWindow* native = BrowserWindow::FromBrowser(into)) {
+    native->Show();
+  }
+}
+
+// The space's mark: its emoji, or a dot in its color with a hairline ring so
+// a pale color still reads on the toolbar.
+class SpaceMarkSource : public gfx::CanvasImageSource {
+ public:
+  SpaceMarkSource(std::u16string emoji, SkColor fill, SkColor ring)
+      : gfx::CanvasImageSource(
+            gfx::Size(tokens::kSpacing16, tokens::kSpacing16)),
+        emoji_(std::move(emoji)),
+        fill_(fill),
+        ring_(ring) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    if (!emoji_.empty()) {
+      canvas->DrawStringRectWithFlags(emoji_, gfx::FontList(), SK_ColorBLACK,
+                                      gfx::Rect(size()),
+                                      gfx::Canvas::TEXT_ALIGN_CENTER);
+      return;
+    }
+    const gfx::PointF center = gfx::RectF(gfx::Rect(size())).CenterPoint();
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(fill_);
+    canvas->DrawCircle(center, tokens::kSpacing4, flags);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.0f);
+    flags.setColor(ring_);
+    canvas->DrawCircle(center, tokens::kSpacing4, flags);
+  }
+
+ private:
+  const std::u16string emoji_;
+  const SkColor fill_;
+  const SkColor ring_;
+};
+
+SkColor ParseColor(const std::string& hex, SkColor fallback) {
+  uint32_t value = 0;
+  if (hex.size() != 7 || hex[0] != '#' ||
+      !base::HexStringToUInt(std::string_view(hex).substr(1), &value)) {
+    return fallback;
+  }
+  return SkColorSetRGB((value >> 16) & 0xFF, (value >> 8) & 0xFF, value & 0xFF);
+}

+// Air Traffic Control: a link from another app whose site has a rule opens in
+// the rule's space instead of the little window. The rules and the decision
+// are in chrome/browser/rac/link_routing/link_rules.h.
+//
+// Only links that would have opened a little window reach this (one web link;
+// see little_window::OpenLinksFromOtherApp), only in a regular profile, and
+// only into a space of the profile the link arrived in. With no rules saved,
+// RouteLinkFromOtherApp() reads one dictionary already in memory and returns.
+//
+// Hooks:
+//  - little_window.cc: OpenLinksFromOtherApp asks RouteLinkFromOtherApp
+//    first, and OfferRouteInLittleWindow after its little window opened.
+//  - clear_toast.cc: registers the routed toast with the window's toasts.
+//  - site_controls_bubble.cc: CreateSiteControlsRow, the way in and out.
+namespace rac::link_routing {
+
+struct LinkRouteResult {
+  // The link opened in its space; the little window doesn't open.
+  bool routed = false;
+  // A rule matched, but the link couldn't go to its space now: the spaces
+  // aren't ready yet, or no window can show the space. The little window
+  // then offers "Open in <space>".
+  std::optional<base::Uuid> offer_space;
+};
+
+// For the one web link from another app that would open a little window in
+// `profile`. `came_with_launch` is true when the link started rac; then
+// windows can't switch spaces yet, so it is offered instead of routed.
+LinkRouteResult RouteLinkFromOtherApp(const StartupTab& tab,
+                                      Profile* profile,
+                                      bool came_with_launch);
+
+// Adds "Open in <space>" to the little window `browser`'s toolbar, before
+// Open as Tab, when `result` offers a space.
+void OfferRouteInLittleWindow(BrowserWindowInterface* browser,
+                              const LinkRouteResult& result);
+
+// Site controls' row: "Open <site> links from other apps in <space>", with a
+// toggle that adds or removes the site's rule for the window's space. Null
+// on internal pages, in incognito and guest windows, and in windows without
+// spaces.
+std::unique_ptr<views::View> CreateSiteControlsRow(
+    BrowserWindowInterface* browser,
+    const GURL& url);

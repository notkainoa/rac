+LinkRouteResult RouteLinkFromOtherApp(const StartupTab& tab,
+                                      Profile* profile,
+                                      bool came_with_launch) {
+  LinkRouteResult result;
+  // The common case returns here: no rules, or a profile that never routes.
+  if (!IsRegularProfile(profile) ||
+      !HasAnyRules(
+          g_browser_process->local_state()->GetDict(kLinkRoutingPref))) {
+    return result;
+  }
+  RouteFacts facts;
+  facts.sign_in_url = IsSignInUrl(tab.url);
+  std::optional<LinkRules> rules = ReadRules();
+  const LinkRule* rule = rules && !facts.sign_in_url
+                             ? FindRule(*rules, tab.url, ProfileKey(profile))
+                             : nullptr;
+  facts.rule_matched = !!rule;
+
+  SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile);
+  const base::Uuid space =
+      rule ? base::Uuid::ParseCaseInsensitive(rule->space) : base::Uuid();
+  facts.space_exists = spaces && space.is_valid() && spaces->FindSpace(space);
+
+  SpacesWindowManager* manager =
+      facts.space_exists ? SpacesWindowManagerFactory::GetForProfile(profile)
+                         : nullptr;
+  facts.spaces_not_ready =
+      came_with_launch || !manager || !IsStoreReady(manager);
+  BrowserWindowInterface* holder = nullptr;
+  BrowserWindowInterface* target = nullptr;
+  if (manager && !facts.spaces_not_ready) {
+    holder = manager->GetWindowHoldingSpace(space);
+    target = holder ? nullptr : PickTargetWindow(profile);
+  }
+  facts.holder_window = !!holder;
+  facts.target_window = !!target;
+
+  switch (DecideRoute(facts)) {
+    case RouteDecision::kLittleWindow:
+      return result;
+    case RouteDecision::kDeleteRuleThenLittleWindow:
+      RemoveRuleWithId(*rules, rule->id);
+      WriteRules(*rules);
+      return result;
+    case RouteDecision::kLittleWindowWithButton:
+      result.offer_space = space;
+      return result;
+    case RouteDecision::kHolderWindow:
+    case RouteDecision::kShowSpaceInTargetWindow:
+      break;
+  }
+
+  BrowserWindowInterface* window = holder ? holder : target;
+  RoutedLink link;
+  link.window = window->GetWeakPtr();
+  tabs::TabHandle added_tab;
+  if (!holder) {
+    link.previous_space = manager->GetActiveSpaceId(window);
+    added_tab = ShowSpaceInWindow(manager, window, space);
+  }
+  // As the little window loads it: a top-level load from outside the
+  // browser.
+  NavigateParams navigate(window, tab.url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  if (tab.is_untrusted_launch) {
+    navigate.initiator_origin = url::Origin();
+  }
+  navigate.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  navigate.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&navigate);
+  CloseIfUntouched(window, added_tab);
+  if (navigate.navigated_or_inserted_contents) {
+    if (tabs::TabInterface* routed = tabs::TabInterface::MaybeGetFromContents(
+            navigate.navigated_or_inserted_contents)) {
+      link.tab = routed->GetHandle();
+    }
+  }
+  LastRoutedLink() = std::move(link);
+  ShowRoutedToast(window, SpaceName(*spaces, space));
+  result.routed = true;
+  return result;
+}
+
+void OfferRouteInLittleWindow(BrowserWindowInterface* browser,
+                              const LinkRouteResult& result) {
+  if (!browser || !result.offer_space) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  ToolbarView* toolbar = browser_view ? browser_view->toolbar() : nullptr;
+  SpacesService* spaces =
+      SpacesServiceFactory::GetForProfile(browser->GetProfile());
+  const Space* space =
+      spaces ? spaces->FindSpace(*result.offer_space) : nullptr;
+  if (!toolbar || !space || toolbar->children().empty()) {
+    return;
+  }
+  auto button = std::make_unique<OpenInSpaceButton>(
+      base::BindRepeating(
+          [](base::WeakPtr<BrowserWindowInterface> window, base::Uuid space) {
+            if (window) {
+              OpenLittleWindowInSpace(window.get(), space);
+            }
+          },
+          browser->GetWeakPtr(), *result.offer_space),
+      l10n_util::GetStringFUTF16(IDS_RAC_LINK_ROUTING_OPEN_IN_SPACE,
+                                 SpaceName(*spaces, *result.offer_space)),
+      SpaceMark(*space), toolbar->location_bar_view(),
+      browser_view->toolbar_button_provider()->GetToolbarButtonSize());
+  // Open as Tab, the little window's last button, stays at the trailing
+  // edge.
+  toolbar->AddChildViewAt(std::move(button), toolbar->children().size() - 1);
+}
+
+std::unique_ptr<views::View> CreateSiteControlsRow(
+    BrowserWindowInterface* browser,
+    const GURL& url) {
+  Profile* profile = browser ? browser->GetProfile() : nullptr;
+  if (!IsRegularProfile(profile)) {
+    return nullptr;
+  }
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile);
+  const std::optional<SpaceId> window_space =
+      manager ? manager->GetActiveSpaceId(browser) : std::nullopt;
+  std::optional<SitePattern> pattern = SitePattern::ForSiteOf(url);
+  if (!spaces || !window_space || !pattern || !ReadRules()) {
+    return nullptr;
+  }
+  return std::make_unique<SiteRoutingRow>(profile, std::move(*pattern),
+                                          *window_space, *spaces);
+}

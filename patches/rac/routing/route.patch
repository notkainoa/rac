+          [](const std::u16string& emoji, const std::string& color,
+             const ui::ColorProvider* provider) {
+            const SkColor ring = provider->GetColor(kColorRacTextSecondary);
+            return gfx::CanvasImageSource::MakeImageSkia<SpaceMarkSource>(
+                emoji, ParseColor(color, ring), ring);
+          },
+          base::UTF8ToUTF16(space.icon), space.theme.color1),
+      gfx::Size(tokens::kSpacing16, tokens::kSpacing16));
+}

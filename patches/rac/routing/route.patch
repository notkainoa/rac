+BrowserWindowInterface* MoveTabToLittleWindow(BrowserWindowInterface* from,
+                                              int index) {
+  // Made before the tab leaves, so emptying `from` never closes the last
+  // window.
+  BrowserWindowInterface* browser = CreateLittleWindow(from->GetProfile());
+  if (!browser) {
+    return nullptr;
+  }
+  std::unique_ptr<content::WebContents> contents =
+      from->GetTabStripModel()->DetachWebContentsAtForInsertion(index);
+  // A little window shows no space; Open as Tab puts the tab in the space
+  // its window shows.
+  contents->RemoveUserData(SpaceTabTag::UserDataKey());
+  browser->GetTabStripModel()->AppendWebContents(std::move(contents),
+                                                 /*foreground=*/true);
+  if (BrowserWindow* native = BrowserWindow::FromBrowser(browser)) {
+    native->Show();
+  }
+  return browser;
+}

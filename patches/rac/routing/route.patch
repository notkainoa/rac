+// The little window's "Open in <space>". Built like Open as Tab, with the
+// space's mark and name. When the toolbar is too narrow for the name and the
+// page's origin, it drops to the mark alone, so the origin keeps reading.
+class OpenInSpaceButton : public ToolbarButton {
+  METADATA_HEADER(OpenInSpaceButton, ToolbarButton)
+
+ public:
+  OpenInSpaceButton(PressedCallback callback,
+                    std::u16string label,
+                    ui::ImageModel mark,
+                    LocationBarView* location_bar,
+                    gfx::Size compact_size)
+      : ToolbarButton(std::move(callback)),
+        label_(std::move(label)),
+        location_bar_(location_bar),
+        compact_size_(compact_size) {
+    SetImageModel(views::Button::STATE_NORMAL, std::move(mark));
+    SetTooltipText(label_);
+    GetViewAccessibility().SetName(label_);
+    SetText(label_);
+    SetProperty(views::kMarginsKey,
+                gfx::Insets::TLBR(0, tokens::kSpacing4, 0, tokens::kSpacing4));
+    SetProperty(views::kFlexBehaviorKey,
+                views::FlexSpecification(base::BindRepeating(
+                    &OpenInSpaceButton::FlexRule, base::Unretained(this))));
+  }
+
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override {
+    ToolbarButton::OnBoundsChanged(previous_bounds);
+    const bool compact = width() < FullSize().width();
+    if (compact != compact_) {
+      compact_ = compact;
+      SetText(compact ? std::u16string() : label_);
+    }
+  }
+
+ private:
+  gfx::Size FullSize() const {
+    return gfx::Size(compact_size_.width() + GetImageLabelSpacing() +
+                         gfx::GetStringWidth(label_, label()->font_list()) +
+                         tokens::kSpacing8,
+                     compact_size_.height());
+  }
+
+  // The width the page's origin needs in the address field.
+  int OriginWidth() const {
+    if (!location_bar_) {
+      return 0;
+    }
+    const GURL url = location_bar_->GetLocationBarModel()->GetURL();
+    const std::u16string origin = base::UTF8ToUTF16(url.host());
+    return location_bar_->GetMinimumSize().width() +
+           gfx::GetStringWidth(origin, views::TypographyProvider::Get().GetFont(
+                                           CONTEXT_OMNIBOX_PRIMARY,
+                                           views::style::STYLE_PRIMARY));
+  }
+
+  gfx::Size FlexRule(const views::View* view,
+                     const views::SizeBounds& bounds) const {
+    const gfx::Size full = FullSize();
+    if (!bounds.width().is_bounded()) {
+      return full;
+    }
+    return bounds.width().value() >= full.width() + OriginWidth()
+               ? full
+               : compact_size_;
+  }
+
+  const std::u16string label_;
+  const raw_ptr<LocationBarView> location_bar_;
+  const gfx::Size compact_size_;
+  bool compact_ = false;
+};

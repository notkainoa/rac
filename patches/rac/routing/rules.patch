+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_LINK_ROUTING_LINK_RULES_H_
+#define CHROME_BROWSER_RAC_LINK_ROUTING_LINK_RULES_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "chrome/browser/rac/site_pattern/site_pattern.h"
+
+class GURL;
+class PrefRegistrySimple;
+
+// Air Traffic Control: a link from another app whose site has a rule opens in
+// the rule's space instead of the little window. This is the browser-free
+// half: the rules, how they're stored, and the decision of where a link goes,
+// on plain values so it's tested without a browser. The browser side is
+// chrome/browser/ui/views/rac/link_routing/.
+//
+// The rules live in Local State, not in a profile, so a later step can route
+// a link that arrives in one profile to another profile's space. For now a
+// rule only matches links that arrive in its own profile.
+namespace rac::link_routing {
+
+// Local State:
+//   {"version": 1,
+//    "rules": [{"id": <uuid>, "pattern": <SitePattern::ToValue()>,
+//               "profile": <profile folder name>, "space": <space uuid>}]}
+// Keys this version doesn't know are kept, at both levels.
+inline constexpr char kLinkRoutingPref[] = "rac.link_routing";
+inline constexpr int kLinkRulesVersion = 1;
+
+struct LinkRule {
+  LinkRule(std::string id,
+           SitePattern pattern,
+           std::string profile,
+           std::string space);
+  LinkRule(LinkRule&&);
+  LinkRule& operator=(LinkRule&&);
+  ~LinkRule();
+
+  std::string id;
+  SitePattern pattern;
+  // The profile's folder name, such as "Default" or "Profile 1".
+  std::string profile;
+  // The space's ID, as base::Uuid::AsLowercaseString() writes it.
+  std::string space;
+  base::DictValue unknown_fields;
+};
+
+struct LinkRules {
+  LinkRules();
+  LinkRules(LinkRules&&);
+  LinkRules& operator=(LinkRules&&);
+  ~LinkRules();
+
+  // In order; the first rule that matches a link wins.
+  std::vector<LinkRule> rules;
+  base::DictValue unknown_fields;
+};
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+
+// Whether `pref` holds any rule entry at all, without parsing one. Every
+// link from another app asks this first, so with no rules routing costs one
+// lookup in a dictionary already in memory.
+bool HasAnyRules(const base::DictValue& pref);
+
+// Reads the pref. A missing version counts as 1. Entries that aren't a
+// dictionary, or lack an id, a valid pattern, a profile or a space, are
+// skipped. Returns nullopt when a newer rac wrote it (a version above
+// kLinkRulesVersion): then nothing routes and nothing is written back.
+std::optional<LinkRules> ParseLinkRules(const base::DictValue& pref);
+base::DictValue SerializeLinkRules(const LinkRules& rules);
+
+// Sign-in and OAuth pages never route: they belong next to the app that
+// opened them. True when the host starts with `accounts.`, `login.`, `auth.`
+// or `sso.`, or the path contains `oauth`, `authorize`, `callback` or `saml`
+// in any case.
+bool IsSignInUrl(const GURL& url);
+
+// The first rule of `profile` that matches `url`, or null.
+const LinkRule* FindRule(const LinkRules& rules,
+                         const GURL& url,
+                         std::string_view profile);
+
+// The rule of `profile` for exactly `pattern`, or null. There is at most one.
+const LinkRule* FindRuleForPattern(const LinkRules& rules,
+                                   const SitePattern& pattern,
+                                   std::string_view profile);
+
+// Points `profile`'s rule for `pattern` at `space`. An existing rule keeps
+// its id and its place in the list; otherwise a rule with `new_id` is
+// appended.
+void SetRule(LinkRules& rules,
+             const SitePattern& pattern,
+             std::string_view profile,
+             std::string_view space,
+             std::string new_id);
+
+// Removes `profile`'s rule for `pattern`. Returns whether there was one.
+bool RemoveRule(LinkRules& rules,
+                const SitePattern& pattern,
+                std::string_view profile);
+
+// Removes the rule with `id`. Returns whether there was one.
+bool RemoveRuleWithId(LinkRules& rules, std::string_view id);
+
+// What the browser side knows when a link arrives, in decision order.
+struct RouteFacts {
+  // The link arrived in an incognito or guest profile.
+  bool off_the_record = false;
+  // Local State holds no rules (HasAnyRules() is false).
+  bool no_rules = false;
+  bool sign_in_url = false;
+  // A rule of this profile matches the link.
+  bool rule_matched = false;
+  // The rule's space still exists.
+  bool space_exists = false;
+  // The link came with rac's launch, or the spaces store is still loading:
+  // windows can't switch spaces yet.
+  bool spaces_not_ready = false;
+  // A window shows the rule's space.
+  bool holder_window = false;
+  // A normal window of the profile on the current desktop could show it.
+  bool target_window = false;
+};
+
+enum class RouteDecision {
+  // The little window opens, with no "Open in <space>" button.
+  kLittleWindow,
+  // The rule's space is gone: the rule is deleted, and the little window
+  // opens without a button.
+  kDeleteRuleThenLittleWindow,
+  // The little window opens with an "Open in <space>" button.
+  kLittleWindowWithButton,
+  // The link opens as a new tab in the window that shows the space.
+  kHolderWindow,
+  // That window switches to the space, then the link opens there.
+  kShowSpaceInTargetWindow,
+};
+
+RouteDecision DecideRoute(const RouteFacts& facts);
+
+}  // namespace rac::link_routing
+
+#endif  // CHROME_BROWSER_RAC_LINK_ROUTING_LINK_RULES_H_

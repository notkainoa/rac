+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/link_routing/link_rules.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/string_util.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "url/gurl.h"
+
+namespace rac::link_routing {
+
+namespace {
+
+constexpr char kVersionKey[] = "version";
+constexpr char kRulesKey[] = "rules";
+constexpr char kIdKey[] = "id";
+constexpr char kPatternKey[] = "pattern";
+constexpr char kProfileKey[] = "profile";
+constexpr char kSpaceKey[] = "space";
+
+constexpr std::string_view kSignInHostPrefixes[] = {"accounts.", "login.",
+                                                    "auth.", "sso."};
+constexpr std::string_view kSignInPathWords[] = {"oauth", "authorize",
+                                                 "callback", "saml"};
+
+std::optional<LinkRule> ParseRule(const base::Value& value) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict) {
+    return std::nullopt;
+  }
+  const std::string* id = dict->FindString(kIdKey);
+  const base::DictValue* pattern_dict = dict->FindDict(kPatternKey);
+  const std::string* profile = dict->FindString(kProfileKey);
+  const std::string* space = dict->FindString(kSpaceKey);
+  if (!id || id->empty() || !pattern_dict || !profile || profile->empty() ||
+      !space || space->empty()) {
+    return std::nullopt;
+  }
+  std::optional<SitePattern> pattern = SitePattern::FromValue(*pattern_dict);
+  if (!pattern) {
+    return std::nullopt;
+  }
+  LinkRule rule(*id, std::move(*pattern), *profile, *space);
+  rule.unknown_fields = dict->Clone();
+  for (const char* key : {kIdKey, kPatternKey, kProfileKey, kSpaceKey}) {
+    rule.unknown_fields.Remove(key);
+  }
+  return rule;
+}
+
+std::vector<LinkRule>::iterator FindPatternIterator(LinkRules& rules,
+                                                    const SitePattern& pattern,
+                                                    std::string_view profile) {
+  return std::ranges::find_if(rules.rules, [&](const LinkRule& rule) {
+    return rule.pattern == pattern && rule.profile == profile;
+  });
+}
+
+}  // namespace
+
+LinkRule::LinkRule(std::string id,
+                   SitePattern pattern,
+                   std::string profile,
+                   std::string space)
+    : id(std::move(id)),
+      pattern(std::move(pattern)),
+      profile(std::move(profile)),
+      space(std::move(space)) {}
+LinkRule::LinkRule(LinkRule&&) = default;
+LinkRule& LinkRule::operator=(LinkRule&&) = default;
+LinkRule::~LinkRule() = default;
+
+LinkRules::LinkRules() = default;
+LinkRules::LinkRules(LinkRules&&) = default;
+LinkRules& LinkRules::operator=(LinkRules&&) = default;
+LinkRules::~LinkRules() = default;
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kLinkRoutingPref);
+}
+
+bool HasAnyRules(const base::DictValue& pref) {
+  const base::ListValue* rules = pref.FindList(kRulesKey);
+  return rules && !rules->empty();
+}
+
+std::optional<LinkRules> ParseLinkRules(const base::DictValue& pref) {
+  const base::Value* version = pref.Find(kVersionKey);
+  if (version &&
+      (!version->is_int() || version->GetInt() > kLinkRulesVersion)) {
+    return std::nullopt;
+  }
+  LinkRules parsed;
+  parsed.unknown_fields = pref.Clone();
+  parsed.unknown_fields.Remove(kVersionKey);
+  parsed.unknown_fields.Remove(kRulesKey);
+  if (const base::ListValue* rules = pref.FindList(kRulesKey)) {
+    for (const base::Value& value : *rules) {
+      if (std::optional<LinkRule> rule = ParseRule(value)) {
+        parsed.rules.push_back(std::move(*rule));
+      }
+    }
+  }
+  return parsed;
+}
+
+base::DictValue SerializeLinkRules(const LinkRules& rules) {
+  base::DictValue pref = rules.unknown_fields.Clone();
+  pref.Set(kVersionKey, kLinkRulesVersion);
+  base::ListValue list;
+  for (const LinkRule& rule : rules.rules) {
+    base::DictValue dict = rule.unknown_fields.Clone();
+    dict.Set(kIdKey, rule.id);
+    dict.Set(kPatternKey, rule.pattern.ToValue());
+    dict.Set(kProfileKey, rule.profile);
+    dict.Set(kSpaceKey, rule.space);
+    list.Append(std::move(dict));
+  }
+  pref.Set(kRulesKey, std::move(list));
+  return pref;
+}
+
+bool IsSignInUrl(const GURL& url) {
+  // GURL lower-cases the host of http(s) URLs.
+  const std::string_view host = url.host();
+  for (std::string_view prefix : kSignInHostPrefixes) {
+    if (host.starts_with(prefix)) {
+      return true;
+    }
+  }
+  const std::string path = base::ToLowerASCII(url.path());
+  for (std::string_view word : kSignInPathWords) {
+    if (path.find(word) != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+const LinkRule* FindRule(const LinkRules& rules,
+                         const GURL& url,
+                         std::string_view profile) {
+  for (const LinkRule& rule : rules.rules) {
+    if (rule.profile == profile && rule.pattern.Matches(url)) {
+      return &rule;
+    }
+  }
+  return nullptr;
+}
+
+const LinkRule* FindRuleForPattern(const LinkRules& rules,
+                                   const SitePattern& pattern,
+                                   std::string_view profile) {
+  for (const LinkRule& rule : rules.rules) {
+    if (rule.pattern == pattern && rule.profile == profile) {
+      return &rule;
+    }
+  }
+  return nullptr;
+}
+
+void SetRule(LinkRules& rules,
+             const SitePattern& pattern,
+             std::string_view profile,
+             std::string_view space,
+             std::string new_id) {
+  auto it = FindPatternIterator(rules, pattern, profile);
+  if (it != rules.rules.end()) {
+    it->space = std::string(space);
+    return;
+  }
+  rules.rules.emplace_back(std::move(new_id), pattern, std::string(profile),
+                           std::string(space));
+}
+
+bool RemoveRule(LinkRules& rules,
+                const SitePattern& pattern,
+                std::string_view profile) {
+  auto it = FindPatternIterator(rules, pattern, profile);
+  if (it == rules.rules.end()) {
+    return false;
+  }
+  rules.rules.erase(it);
+  return true;
+}
+
+bool RemoveRuleWithId(LinkRules& rules, std::string_view id) {
+  return std::erase_if(rules.rules, [id](const LinkRule& rule) {
+           return rule.id == id;
+         }) > 0;
+}
+
+RouteDecision DecideRoute(const RouteFacts& facts) {
+  if (facts.off_the_record || facts.no_rules || facts.sign_in_url ||
+      !facts.rule_matched) {
+    return RouteDecision::kLittleWindow;
+  }
+  if (!facts.space_exists) {
+    return RouteDecision::kDeleteRuleThenLittleWindow;
+  }
+  if (facts.spaces_not_ready) {
+    return RouteDecision::kLittleWindowWithButton;
+  }
+  if (facts.holder_window) {
+    return RouteDecision::kHolderWindow;
+  }
+  if (facts.target_window) {
+    return RouteDecision::kShowSpaceInTargetWindow;
+  }
+  return RouteDecision::kLittleWindowWithButton;
+}
+
+}  // namespace rac::link_routing

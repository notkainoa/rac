+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/link_routing/link_rules.h"
+
+#include <optional>
+#include <string>
+
+#include "base/i18n/icu_util.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac::link_routing {
+namespace {
+
+constexpr char kSpaceA[] = "0b0a3b67-8d9e-4f1c-9a43-1f4c8d0e2a11";
+constexpr char kSpaceB[] = "5d1e7c20-3f4b-4a6e-8b2d-9c0f1e2d3a44";
+
+// SitePattern needs ICU's data for IDN hosts. base::TestSuite loads it in
+// the real binary; this also covers a plain gtest main.
+void InitializeIcu() {
+  base::i18n::AllowMultipleInitializeCallsForTesting();
+  ASSERT_TRUE(base::i18n::InitializeICU());
+}
+
+SitePattern Domain(std::string_view host) {
+  return *SitePattern::Create(SitePattern::Type::kDomainIs, host);
+}
+
+base::DictValue Json(std::string_view json) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  EXPECT_TRUE(value && value->is_dict()) << json;
+  return value ? std::move(value->GetDict()) : base::DictValue();
+}
+
+class LinkRulesTest : public testing::Test {
+ protected:
+  void SetUp() override { InitializeIcu(); }
+};
+
+TEST_F(LinkRulesTest, RoundTripsRulesInOrder) {
+  LinkRules rules;
+  SetRule(rules, Domain("github.com"), "Default", kSpaceA, "r1");
+  SetRule(rules, *SitePattern::Create(SitePattern::Type::kUrlContains, "Docs"),
+          "Profile 1", kSpaceB, "r2");
+
+  std::optional<LinkRules> read = ParseLinkRules(SerializeLinkRules(rules));
+  ASSERT_TRUE(read);
+  ASSERT_EQ(2u, read->rules.size());
+  EXPECT_EQ("r1", read->rules[0].id);
+  EXPECT_EQ(Domain("github.com"), read->rules[0].pattern);
+  EXPECT_EQ("Default", read->rules[0].profile);
+  EXPECT_EQ(kSpaceA, read->rules[0].space);
+  EXPECT_EQ("r2", read->rules[1].id);
+  EXPECT_EQ(SitePattern::Type::kUrlContains, read->rules[1].pattern.type());
+  EXPECT_EQ("docs", read->rules[1].pattern.value());
+  EXPECT_EQ("Profile 1", read->rules[1].profile);
+  EXPECT_EQ(kSpaceB, read->rules[1].space);
+
+  const base::DictValue written = SerializeLinkRules(*read);
+  EXPECT_EQ(kLinkRulesVersion, written.FindInt("version"));
+}
+
+TEST_F(LinkRulesTest, SkipsMalformedEntries) {
+  std::optional<LinkRules> read = ParseLinkRules(Json(R"({
+    "version": 1,
+    "rules": [
+      "not a rule",
+      {"pattern": {"type": "domain", "value": "a.example"},
+       "profile": "Default", "space": "s"},
+      {"id": "", "pattern": {"type": "domain", "value": "a.example"},
+       "profile": "Default", "space": "s"},
+      {"id": "r", "pattern": {"type": "domain", "value": "com"},
+       "profile": "Default", "space": "s"},
+      {"id": "r", "pattern": {"type": "regex", "value": "a"},
+       "profile": "Default", "space": "s"},
+      {"id": "r", "pattern": "a.example", "profile": "Default", "space": "s"},
+      {"id": "r", "pattern": {"type": "domain", "value": "a.example"},
+       "space": "s"},
+      {"id": "r", "pattern": {"type": "domain", "value": "a.example"},
+       "profile": "Default"},
+      {"id": "r", "pattern": {"type": "domain", "value": "a.example"},
+       "profile": "Default", "space": 7},
+      {"id": "good", "pattern": {"type": "domain", "value": "b.example"},
+       "profile": "Default", "space": "s"}
+    ]})"));
+  ASSERT_TRUE(read);
+  ASSERT_EQ(1u, read->rules.size());
+  EXPECT_EQ("good", read->rules[0].id);
+}
+
+TEST_F(LinkRulesTest, KeepsUnknownFields) {
+  std::optional<LinkRules> read = ParseLinkRules(Json(R"({
+    "version": 1,
+    "later": {"x": 1},
+    "rules": [{"id": "r", "pattern": {"type": "domain", "value": "a.example"},
+               "profile": "Default", "space": "s", "cross_profile": true}]})"));
+  ASSERT_TRUE(read);
+  const base::DictValue written = SerializeLinkRules(*read);
+  EXPECT_EQ(1, written.FindIntByDottedPath("later.x"));
+  const base::ListValue* rules = written.FindList("rules");
+  ASSERT_TRUE(rules);
+  ASSERT_EQ(1u, rules->size());
+  EXPECT_EQ(true, (*rules)[0].GetDict().FindBool("cross_profile"));
+  EXPECT_EQ("r", *(*rules)[0].GetDict().FindString("id"));
+}
+
+TEST_F(LinkRulesTest, ReadsVersionsItKnows) {
+  // No version: a rule written before the field.
+  EXPECT_TRUE(ParseLinkRules(Json(R"({"rules": []})")));
+  EXPECT_TRUE(ParseLinkRules(base::DictValue()));
+  EXPECT_TRUE(ParseLinkRules(Json(R"({"version": 1})")));
+  // A newer rac's rules aren't read, so they're never written back over.
+  EXPECT_FALSE(ParseLinkRules(Json(R"({"version": 2, "rules": []})")));
+  EXPECT_FALSE(ParseLinkRules(Json(R"({"version": "1"})")));
+}
+
+TEST_F(LinkRulesTest, EmptyListExitsImmediately) {
+  EXPECT_FALSE(HasAnyRules(base::DictValue()));
+  EXPECT_FALSE(HasAnyRules(Json(R"({"version": 1, "rules": []})")));
+  EXPECT_FALSE(HasAnyRules(Json(R"({"version": 1, "rules": "x"})")));
+  EXPECT_TRUE(HasAnyRules(Json(R"({"version": 1, "rules": [{}]})")));
+
+  EXPECT_EQ(nullptr,
+            FindRule(LinkRules(), GURL("https://github.com/"), "Default"));
+  RouteFacts facts;
+  facts.no_rules = true;
+  facts.rule_matched = true;
+  facts.space_exists = true;
+  facts.holder_window = true;
+  EXPECT_EQ(RouteDecision::kLittleWindow, DecideRoute(facts));
+}
+
+TEST_F(LinkRulesTest, SignInPagesNeverRoute) {
+  for (const char* url : {
+           "https://accounts.google.com/signin",
+           "https://login.microsoftonline.com/common",
+           "https://auth.example.com/",
+           "https://sso.corp.example/start",
+           "https://example.com/oauth2/start",
+           "https://example.com/OAuth/start",
+           "https://github.com/login/oauth/authorize?client_id=x",
+           "https://example.com/connect/Authorize",
+           "https://example.com/auth/callback",
+           "https://example.com/saml/acs",
+           "https://ACCOUNTS.example.com/",
+       }) {
+    EXPECT_TRUE(IsSignInUrl(GURL(url))) << url;
+  }
+  for (const char* url : {
+           "https://myaccounts.example/",
+           "https://example.com/accounts/",
+           "https://github.com/notkainoa/rac",
+           "https://www.example.com/login-help",
+           "https://authentic.example/",
+           "https://example.com/?next=oauth",
+           "https://example.com/#callback",
+       }) {
+    EXPECT_FALSE(IsSignInUrl(GURL(url))) << url;
+  }
+}
+
+TEST_F(LinkRulesTest, FirstMatchWins) {
+  LinkRules rules;
+  SetRule(rules, Domain("github.com"), "Default", kSpaceA, "first");
+  SetRule(rules, Domain("gist.github.com"), "Default", kSpaceB, "second");
+
+  const LinkRule* rule =
+      FindRule(rules, GURL("https://gist.github.com/x"), "Default");
+  ASSERT_TRUE(rule);
+  EXPECT_EQ("first", rule->id);
+  EXPECT_EQ(nullptr, FindRule(rules, GURL("https://example.com/"), "Default"));
+  EXPECT_EQ(nullptr, FindRule(rules, GURL("mailto:a@github.com"), "Default"));
+}
+
+TEST_F(LinkRulesTest, OneRulePerPattern) {
+  LinkRules rules;
+  SetRule(rules, Domain("github.com"), "Default", kSpaceA, "r1");
+  SetRule(rules, Domain("slack.com"), "Default", kSpaceA, "r2");
+  // The same pattern again points the existing rule at the new space and
+  // keeps its id and place.
+  SetRule(rules, Domain("GitHub.com"), "Default", kSpaceB, "r3");
+
+  ASSERT_EQ(2u, rules.rules.size());
+  EXPECT_EQ("r1", rules.rules[0].id);
+  EXPECT_EQ(kSpaceB, rules.rules[0].space);
+  EXPECT_EQ("r2", rules.rules[1].id);
+  // New patterns are appended.
+  SetRule(rules, Domain("linear.app"), "Default", kSpaceB, "r4");
+  ASSERT_EQ(3u, rules.rules.size());
+  EXPECT_EQ("r4", rules.rules[2].id);
+
+  EXPECT_TRUE(RemoveRule(rules, Domain("github.com"), "Default"));
+  EXPECT_FALSE(RemoveRule(rules, Domain("github.com"), "Default"));
+  ASSERT_EQ(2u, rules.rules.size());
+  EXPECT_EQ("r2", rules.rules[0].id);
+
+  EXPECT_TRUE(RemoveRuleWithId(rules, "r4"));
+  EXPECT_FALSE(RemoveRuleWithId(rules, "r4"));
+  ASSERT_EQ(1u, rules.rules.size());
+}
+
+TEST_F(LinkRulesTest, OnlySameProfileRulesMatch) {
+  LinkRules rules;
+  SetRule(rules, Domain("github.com"), "Profile 1", kSpaceA, "theirs");
+  EXPECT_EQ(nullptr, FindRule(rules, GURL("https://github.com/"), "Default"));
+  EXPECT_EQ(nullptr,
+            FindRuleForPattern(rules, Domain("github.com"), "Default"));
+
+  // Each profile keeps its own rule for the same site.
+  SetRule(rules, Domain("github.com"), "Default", kSpaceB, "mine");
+  ASSERT_EQ(2u, rules.rules.size());
+  const LinkRule* rule =
+      FindRule(rules, GURL("https://github.com/"), "Default");
+  ASSERT_TRUE(rule);
+  EXPECT_EQ("mine", rule->id);
+  EXPECT_FALSE(RemoveRule(rules, Domain("slack.com"), "Default"));
+  EXPECT_TRUE(RemoveRule(rules, Domain("github.com"), "Default"));
+  ASSERT_EQ(1u, rules.rules.size());
+  EXPECT_EQ("theirs", rules.rules[0].id);
+}
+
+TEST_F(LinkRulesTest, DecidesWhereALinkGoes) {
+  RouteFacts matched;
+  matched.rule_matched = true;
+  matched.space_exists = true;
+
+  RouteFacts facts = matched;
+  facts.holder_window = true;
+  facts.target_window = true;
+  EXPECT_EQ(RouteDecision::kHolderWindow, DecideRoute(facts));
+
+  facts = matched;
+  facts.target_window = true;
+  EXPECT_EQ(RouteDecision::kShowSpaceInTargetWindow, DecideRoute(facts));
+
+  // No window can show the space.
+  EXPECT_EQ(RouteDecision::kLittleWindowWithButton, DecideRoute(matched));
+
+  facts = matched;
+  facts.holder_window = true;
+  facts.spaces_not_ready = true;
+  EXPECT_EQ(RouteDecision::kLittleWindowWithButton, DecideRoute(facts));
+
+  facts = matched;
+  facts.holder_window = true;
+  facts.space_exists = false;
+  EXPECT_EQ(RouteDecision::kDeleteRuleThenLittleWindow, DecideRoute(facts));
+
+  facts = matched;
+  facts.holder_window = true;
+  facts.off_the_record = true;
+  EXPECT_EQ(RouteDecision::kLittleWindow, DecideRoute(facts));
+
+  facts = matched;
+  facts.holder_window = true;
+  facts.sign_in_url = true;
+  EXPECT_EQ(RouteDecision::kLittleWindow, DecideRoute(facts));
+
+  facts = matched;
+  facts.holder_window = true;
+  facts.rule_matched = false;
+  EXPECT_EQ(RouteDecision::kLittleWindow, DecideRoute(facts));
+}

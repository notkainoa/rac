@@ -0,0 +1,55 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/updates/rac_updates.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "build/build_config.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+// Every release on GitHub carries one feed per architecture. "latest" points
+// at the newest release that isn't a draft or prerelease, so an update only
+// reaches people once the maintainer publishes its release.
+constexpr char kFeedBaseUrl[] =
+    "https://github.com/notkainoa/rac/releases/latest/download/";
+
+#if defined(ARCH_CPU_ARM64)
+constexpr char kFeedFile[] = "appcast-arm64.xml";
+#elif defined(ARCH_CPU_X86_64)
+constexpr char kFeedFile[] = "appcast-x86_64.xml";
+#else
+#error "rac updates support arm64 and x86_64 only"
+#endif
+
+// Helium's "Update server URL" in chrome://flags. It replaces kFeedBaseUrl
+// for testing, so it needs a trailing slash.
+constexpr char kFeedBaseUrlSwitch[] = "custom-update-server-url";
+
+}  // namespace
+
+void RegisterUpdatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kBrowserUpdatesEnabled, true);
+}
+
+bool ShouldCheckForUpdates(const PrefService& local_state) {
+  return local_state.GetBoolean(kBrowserUpdatesEnabled);
+}
+
+GURL GetUpdateFeedURL() {
+  std::string base_url = kFeedBaseUrl;
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kFeedBaseUrlSwitch)) {
+    base_url = command_line->GetSwitchValueASCII(kFeedBaseUrlSwitch);
+  }
+  return GURL(base_url).Resolve(kFeedFile);
+}
+
+}  // namespace rac

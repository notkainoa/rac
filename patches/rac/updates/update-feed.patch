+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_UPDATES_RAC_UPDATES_H_
+#define CHROME_BROWSER_RAC_UPDATES_RAC_UPDATES_H_
+
+#include "url/gurl.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace rac {
+
+// Local state: whether rac checks for and installs its own updates. This is
+// separate from Helium services, which rac's updates don't use.
+inline constexpr char kBrowserUpdatesEnabled[] = "rac.browser_updates";
+
+void RegisterUpdatePrefs(PrefRegistrySimple* registry);
+
+bool ShouldCheckForUpdates(const PrefService& local_state);
+
+// The Sparkle feed for this build's CPU architecture.
+GURL GetUpdateFeedURL();
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_UPDATES_RAC_UPDATES_H_

   }
-  return GURL(base_url).Resolve(kFeedFile);
+
+  const GURL base_url(command_line->GetSwitchValueASCII(kFeedBaseUrlSwitch));
+  if (!base_url.is_valid() || !base_url.SchemeIsHTTPOrHTTPS()) {
+    // Don't log the URL: an override can contain credentials. Don't fall back
+    // to GitHub either: an explicit override must not contact another server.
+    LOG(ERROR) << "Invalid custom update server URL; update feed unavailable.";
+    return GURL();
+  }
+
+  std::string path(base_url.path());
+  if (!path.ends_with('/')) {
+    path += '/';
+  }
+  GURL::Replacements replacements;
+  replacements.SetPathStr(path);
+  // Resolve the feed within the parsed directory, dropping the base URL's
+  // query and fragment just as resolving a feed filename normally does.
+  return base_url.ReplaceComponents(replacements).Resolve(kFeedFile);
 }
 
 }  // namespace rac

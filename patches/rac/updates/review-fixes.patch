 constexpr char kFeedBaseUrlSwitch[] = "custom-update-server-url";
 
 }  // namespace
@@ -44,12 +45,28 @@
 }
 
 GURL GetUpdateFeedURL() {
-  std::string base_url = kFeedBaseUrl;
   const auto* command_line = base::CommandLine::ForCurrentProcess();
-  if (command_line->HasSwitch(kFeedBaseUrlSwitch)) {
-    base_url = command_line->GetSwitchValueASCII(kFeedBaseUrlSwitch);
+  if (!command_line->HasSwitch(kFeedBaseUrlSwitch)) {

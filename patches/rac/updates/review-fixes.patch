+++ b/chrome/browser/rac/updates/rac_updates_unittest.cc
@@ -0,0 +1,117 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/updates/rac_updates.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/test/scoped_command_line.h"
+#include "build/build_config.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+constexpr char kUpdateServerSwitch[] = "custom-update-server-url";
+
+#if defined(ARCH_CPU_ARM64)
+constexpr char kExpectedFeedFile[] = "appcast-arm64.xml";
+#elif defined(ARCH_CPU_X86_64)
+constexpr char kExpectedFeedFile[] = "appcast-x86_64.xml";
+#else
+#error "rac updates support arm64 and x86_64 only"
+#endif
+
+TEST(RacUpdatesTest, DefaultFeed) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->RemoveSwitch(kUpdateServerSwitch);
+
+  EXPECT_EQ(
+      GURL(std::string(
+               "https://github.com/notkainoa/rac/releases/latest/download/") +
+           kExpectedFeedFile),
+      GetUpdateFeedURL());
+}
+
+TEST(RacUpdatesTest, RootDirectoryWithOrWithoutSlash) {
+  base::test::ScopedCommandLine command_line;
+  for (const char* base_url :
+       {"http://localhost:8000", "http://localhost:8000/"}) {
+    SCOPED_TRACE(base_url);
+    command_line.GetProcessCommandLine()->AppendSwitchASCII(kUpdateServerSwitch,
+                                                            base_url);
+
+    EXPECT_EQ(GURL(std::string("http://localhost:8000/") + kExpectedFeedFile),
+              GetUpdateFeedURL());
+  }
+}
+
+TEST(RacUpdatesTest, NestedDirectoryWithOrWithoutSlash) {
+  base::test::ScopedCommandLine command_line;
+  for (const char* base_url :
+       {"https://updates.example.test/releases/updates",
+        "https://updates.example.test/releases/updates/"}) {
+    SCOPED_TRACE(base_url);
+    command_line.GetProcessCommandLine()->AppendSwitchASCII(kUpdateServerSwitch,
+                                                            base_url);
+
+    EXPECT_EQ(
+        GURL(std::string("https://updates.example.test/releases/updates/") +
+             kExpectedFeedFile),
+        GetUpdateFeedURL());
+  }
+}
+
+TEST(RacUpdatesTest, QueryAndFragmentDoNotChangeDirectory) {
+  base::test::ScopedCommandLine command_line;
+  for (const char* base_url :
+       {"https://updates.example.test/updates?channel=stable#latest",
+        "https://updates.example.test/updates/?channel=stable#latest",
+        "https://updates.example.test/updates?channel=stable",
+        "https://updates.example.test/updates#latest"}) {
+    SCOPED_TRACE(base_url);
+    command_line.GetProcessCommandLine()->AppendSwitchASCII(kUpdateServerSwitch,
+                                                            base_url);
+
+    EXPECT_EQ(GURL(std::string("https://updates.example.test/updates/") +
+                   kExpectedFeedFile),
+              GetUpdateFeedURL());
+  }
+}
+
+TEST(RacUpdatesTest, PreservesCredentialsAndEscapedDirectory) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchASCII(
+      kUpdateServerSwitch,
+      "https://user:password@updates.example.test/releases%2Fstable");
+
+  EXPECT_EQ(
+      GURL(
+          std::string(
+              "https://user:password@updates.example.test/releases%2Fstable/") +
+          kExpectedFeedFile),
+      GetUpdateFeedURL());
+}
+
+TEST(RacUpdatesTest, InvalidOverrideDoesNotFallBackToGitHub) {
+  base::test::ScopedCommandLine command_line;
+  for (const char* base_url :
+       {"", "updates", "/updates", "//updates.example.test/updates",
+        "not a URL", "http://", "https://[::1", "https://example.test:bad",
+        "file:///updates/", "ftp://updates.example.test/",
+        "data:text/plain,updates", "javascript:updates",
+        "mailto:updates@example.test"}) {
+    SCOPED_TRACE(base_url);
+    command_line.GetProcessCommandLine()->AppendSwitchASCII(kUpdateServerSwitch,
+                                                            base_url);
+
+    const GURL feed = GetUpdateFeedURL();
+    EXPECT_FALSE(feed.is_valid());
+    EXPECT_TRUE(feed.is_empty());
+  }
+}
+
+}  // namespace
+}  // namespace rac

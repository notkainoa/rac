+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_STORAGE_CRASH_RESTORE_H_
+#define CHROME_BROWSER_RAC_STORAGE_CRASH_RESTORE_H_
+
+#include "base/functional/callback_forward.h"
+
+class Profile;
+
+// Restores the last session after a crash without the "Restore pages?"
+// bubble, when the startup setting continues where the user left off. The
+// rule and the crash-loop guard are in crash_restore_policy.h.
+//
+// rac doesn't restore anything itself. When this says yes, startup takes the
+// path a clean launch takes (SessionRestore::RestoreSession() at process
+// startup, SessionService::RestoreIfNecessary() later), which is also what
+// Chromium does after a crash with --hide-crash-restore-bubble. The crashed
+// session stays safe the way it does when the user presses Restore:
+// ExitTypeService keeps the session service from writing until the restore
+// has finished, so the crashed session file is what gets read, and nothing
+// replaces it first.
+namespace rac {
+
+// Called once per launch of `profile` from
+// StartupBrowserCreatorImpl::DetermineURLsAndLaunch(), before anything is
+// restored. `is_post_crash_launch` is HasPendingUncleanExit(), and
+// `restores_last_session` is SessionStartupPref::ShouldRestoreLastSession() for
+// this launch. Returns true if this launch should restore the last session as
+// if the last run had exited cleanly. Also keeps kCrashRestoreGuardPref up to
+// date. Only regular profiles qualify.
+bool ShouldRestoreSessionAfterCrash(Profile* profile,
+                                    bool is_post_crash_launch,
+                                    bool restores_last_session);
+
+// Whether this launch of `profile` restores silently after a crash and that
+// restore hasn't finished yet. The restore then brings back app windows too,
+// the way the bubble's Restore button does.
+bool IsSilentCrashRestorePending(Profile* profile);
+
+// Called from AddInfoBarsIfNecessary() where Chromium shows the crash bubble.
+// `show_bubble` shows it on the window the infobars were added to. Runs it now
+// unless the silent restore is running or brought tabs back. While the restore
+// runs, keeps it and runs it in a later task only if the restore ends with no
+// tabs restored, so an unreadable or empty session file still gets the bubble.
+void ShowCrashBubbleUnlessRestored(Profile* profile,
+                                   base::OnceClosure show_bubble);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_CRASH_RESTORE_H_

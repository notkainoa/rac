+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/crash_restore_policy.h"
+
+#include "components/prefs/pref_registry_simple.h"
+
+namespace rac {
+
+CrashRestoreAction DecideCrashRestore(bool is_post_crash_launch,
+                                      bool restores_last_session,
+                                      base::Time guard,
+                                      base::Time now) {
+  if (!is_post_crash_launch) {
+    return CrashRestoreAction::kNone;
+  }
+  // With a new tab page or specific pages, the bubble is the only way back to
+  // the crashed tabs, so it stays.
+  if (!restores_last_session) {
+    return CrashRestoreAction::kShowBubble;
+  }
+  // The crash came from a launch that was still recovering: let the user
+  // decide, so a crashing session doesn't restore itself in a loop.
+  if (IsCrashRestoreGuardActive(guard, now)) {
+    return CrashRestoreAction::kShowBubble;
+  }
+  return CrashRestoreAction::kRestoreSilently;
+}
+
+bool IsCrashRestoreGuardActive(base::Time guard, base::Time now) {
+  return !guard.is_null() &&
+         (now - guard).magnitude() < kCrashRestoreGuardExpiry;
+}
+
+bool ShouldClearCrashRestoreGuard(bool last_exit_crashed, base::Time guard) {
+  return !guard.is_null() && !last_exit_crashed;
+}
+
+CrashBubbleAction DecideCrashBubble(bool restoring_silently,
+                                    bool restore_running,
+                                    std::optional<int> tabs_restored) {
+  if (!restoring_silently) {
+    return CrashBubbleAction::kShowNow;
+  }
+  if (tabs_restored.has_value()) {
+    return ShouldShowCrashBubbleAfterRestore(*tabs_restored)
+               ? CrashBubbleAction::kShowNow
+               : CrashBubbleAction::kHide;
+  }
+  return restore_running ? CrashBubbleAction::kWaitForRestore
+                         : CrashBubbleAction::kShowNow;
+}
+
+bool ShouldShowCrashBubbleAfterRestore(int tabs_restored) {
+  // An unreadable or empty session file restores nothing. The crashed file is
+  // still this run's last session, so the bubble's Restore can try again.
+  return tabs_restored <= 0;
+}
+
+void RegisterCrashRestorePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterTimePref(kCrashRestoreGuardPref, base::Time());
+}
+
+}  // namespace rac

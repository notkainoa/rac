===================================================================
--- /dev/null
+++ src/chrome/browser/rac/storage/crash_restore_policy_unittest.cc
@@ -0,0 +1,192 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/crash_restore_policy.h"
+
+#include <optional>
+#include <string_view>
+
+#include "base/time/time.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+base::Time Now() {
+  base::Time now;
+  EXPECT_TRUE(base::Time::FromUTCString("2026-11-10 12:00:00", &now));
+  return now;
+}
+
+TEST(CrashRestorePolicyTest, NoCrashDoesNothing) {
+  const base::Time now = Now();
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/false,
+                               /*restores_last_session=*/true, base::Time(),
+                               now),
+            CrashRestoreAction::kNone);
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/false,
+                               /*restores_last_session=*/false,
+                               now - base::Minutes(1), now),
+            CrashRestoreAction::kNone);
+}
+
+TEST(CrashRestorePolicyTest, CrashWithContinueRestoresSilently) {
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/true,
+                               /*restores_last_session=*/true, base::Time(),
+                               Now()),
+            CrashRestoreAction::kRestoreSilently);
+}
+
+TEST(CrashRestorePolicyTest, CrashWithoutContinueKeepsTheBubble) {
+  // New tab page or specific pages: the bubble is the only way back.
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/true,
+                               /*restores_last_session=*/false, base::Time(),
+                               Now()),
+            CrashRestoreAction::kShowBubble);
+}
+
+TEST(CrashRestorePolicyTest, CrashWhileRecoveringShowsTheBubble) {
+  const base::Time now = Now();
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/true,
+                               /*restores_last_session=*/true,
+                               now - base::Seconds(10), now),
+            CrashRestoreAction::kShowBubble);
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/true,
+                               /*restores_last_session=*/true,
+                               now - base::Hours(23), now),
+            CrashRestoreAction::kShowBubble);
+}
+
+TEST(CrashRestorePolicyTest, ExpiredGuardIsIgnored) {
+  const base::Time now = Now();
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/true,
+                               /*restores_last_session=*/true,
+                               now - kCrashRestoreGuardExpiry, now),
+            CrashRestoreAction::kRestoreSilently);
+  EXPECT_EQ(DecideCrashRestore(/*is_post_crash_launch=*/true,
+                               /*restores_last_session=*/true,
+                               now - base::Days(30), now),
+            CrashRestoreAction::kRestoreSilently);
+}
+
+TEST(CrashRestorePolicyTest, GuardFromTheFuture) {
+  const base::Time now = Now();
+  // The clock went back a little: still treated as recovering.
+  EXPECT_TRUE(IsCrashRestoreGuardActive(now + base::Hours(1), now));
+  // Far off: ignored.
+  EXPECT_FALSE(IsCrashRestoreGuardActive(now + base::Days(2), now));
+}
+
+TEST(CrashRestorePolicyTest, UnsetGuardIsNeverActive) {
+  EXPECT_FALSE(IsCrashRestoreGuardActive(base::Time(), Now()));
+}
+
+TEST(CrashRestorePolicyTest, CleanExitClearsTheGuard) {
+  const base::Time guard = Now() - base::Minutes(1);
+  EXPECT_TRUE(ShouldClearCrashRestoreGuard(/*last_exit_crashed=*/false, guard));
+  EXPECT_FALSE(ShouldClearCrashRestoreGuard(/*last_exit_crashed=*/true, guard));
+  EXPECT_FALSE(
+      ShouldClearCrashRestoreGuard(/*last_exit_crashed=*/false, base::Time()));
+}
+
+// Every launch here follows a crash and continues where the user left off.
+CrashRestoreAction DecideAfterCrash(base::Time guard, base::Time now) {
+  return DecideCrashRestore(/*is_post_crash_launch=*/true,
+                            /*restores_last_session=*/true, guard, now);
+}
+
+// Walks the launches of a session that crashes rac every time it's restored,
+// the way crash_restore.cc drives the policy.
+TEST(CrashRestorePolicyTest, CrashLoopFallsBackToTheBubble) {
+  base::Time now = Now();
+  base::Time guard;
+
+  // Launch 1 after a crash: restores silently and sets the guard.
+  ASSERT_EQ(DecideAfterCrash(guard, now),
+            CrashRestoreAction::kRestoreSilently);
+  guard = now;
+
+  // It crashes 20 seconds later. Launch 2 shows the bubble.
+  now += base::Seconds(20);
+  EXPECT_FALSE(ShouldClearCrashRestoreGuard(/*last_exit_crashed=*/true, guard));
+  EXPECT_EQ(DecideAfterCrash(guard, now),
+            CrashRestoreAction::kShowBubble);
+
+  // The user restores from the bubble and it crashes again at once: launch 3
+  // still shows the bubble, because the guard is only cleared by a launch
+  // that ran for kCrashRestoreStablePeriod.
+  now += base::Seconds(20);
+  EXPECT_EQ(DecideAfterCrash(guard, now),
+            CrashRestoreAction::kShowBubble);
+
+  // Launch 3 runs for kCrashRestoreStablePeriod, which clears the guard. A
+  // later crash restores silently again.
+  now += kCrashRestoreStablePeriod;
+  guard = base::Time();
+  now += base::Hours(2);
+  EXPECT_EQ(DecideAfterCrash(guard, now),
+            CrashRestoreAction::kRestoreSilently);
+}
+
+TEST(CrashRestorePolicyTest, BubbleShowsWithoutSilentRestore) {
+  EXPECT_EQ(DecideCrashBubble(/*restoring_silently=*/false,
+                              /*restore_running=*/false, std::nullopt),
+            CrashBubbleAction::kShowNow);
+  // Someone else's restore doesn't hide Chromium's bubble.
+  EXPECT_EQ(DecideCrashBubble(/*restoring_silently=*/false,
+                              /*restore_running=*/true, std::nullopt),
+            CrashBubbleAction::kShowNow);
+}
+
+TEST(CrashRestorePolicyTest, BubbleWaitsForTheSilentRestore) {
+  EXPECT_EQ(DecideCrashBubble(/*restoring_silently=*/true,
+                              /*restore_running=*/true, std::nullopt),
+            CrashBubbleAction::kWaitForRestore);
+}
+
+TEST(CrashRestorePolicyTest, BubbleHiddenOnceTabsCameBack) {
+  EXPECT_EQ(DecideCrashBubble(/*restoring_silently=*/true,
+                              /*restore_running=*/false, 12),
+            CrashBubbleAction::kHide);
+  // The window for the restored tabs can open while the restorer still runs.
+  EXPECT_EQ(DecideCrashBubble(/*restoring_silently=*/true,
+                              /*restore_running=*/true, 1),
+            CrashBubbleAction::kHide);
+}
+
+TEST(CrashRestorePolicyTest, BubbleShowsWhenTheRestoreFoundNothing) {
+  // An unreadable or empty session file: the bubble is the way back.
+  EXPECT_EQ(DecideCrashBubble(/*restoring_silently=*/true,
+                              /*restore_running=*/false, 0),
+            CrashBubbleAction::kShowNow);
+  EXPECT_TRUE(ShouldShowCrashBubbleAfterRestore(0));
+  EXPECT_FALSE(ShouldShowCrashBubbleAfterRestore(1));
+}
+
+TEST(CrashRestorePolicyTest, BubbleShowsWhenTheRestoreNeverStarted) {
+  EXPECT_EQ(DecideCrashBubble(/*restoring_silently=*/true,
+                              /*restore_running=*/false, std::nullopt),
+            CrashBubbleAction::kShowNow);
+}
+
+TEST(CrashRestorePolicyTest, PrefIsRegisteredUnset) {
+  TestingPrefServiceSimple prefs;
+  RegisterCrashRestorePrefs(prefs.registry());
+  EXPECT_TRUE(prefs.GetTime(kCrashRestoreGuardPref).is_null());
+
+  const base::Time now = Now();
+  prefs.SetTime(kCrashRestoreGuardPref, now);
+  EXPECT_EQ(prefs.GetTime(kCrashRestoreGuardPref), now);
+  prefs.ClearPref(kCrashRestoreGuardPref);
+  EXPECT_TRUE(prefs.GetTime(kCrashRestoreGuardPref).is_null());
+}
+
+TEST(CrashRestorePolicyTest, PrefNameIsRacOwned) {
+  EXPECT_TRUE(std::string_view(kCrashRestoreGuardPref).starts_with(
+      "rac.session."));
+}
+
+}  // namespace
+}  // namespace rac

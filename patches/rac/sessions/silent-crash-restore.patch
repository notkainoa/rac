+++ src/chrome/browser/rac/storage/crash_restore_policy.h
@@ -0,0 +1,99 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_STORAGE_CRASH_RESTORE_POLICY_H_
+#define CHROME_BROWSER_RAC_STORAGE_CRASH_RESTORE_POLICY_H_
+
+#include <optional>
+
+#include "base/time/time.h"
+
+class PrefRegistrySimple;
+
+// When a launch after a crash restores the last session without asking.
+// Pure logic over plain values, so it's tested without a browser. The browser
+// side is in crash_restore.h.
+//
+// The rule: a launch that follows a crash restores silently when the startup
+// setting continues where the user left off, unless the crash came from a
+// launch that was still recovering from an earlier crash. A launch is
+// recovering from when rac restored silently until it has run for
+// kCrashRestoreStablePeriod, or until a later launch finds a clean exit.
+// Then the next crash shows Chromium's "Restore pages?" bubble instead, so a
+// session that crashes rac can't crash it again and again on its own.
+namespace rac {
+
+// Profile pref: when this profile last restored silently after a crash. Unset
+// once that launch has run for kCrashRestoreStablePeriod, or when a later
+// launch follows a clean exit.
+inline constexpr char kCrashRestoreGuardPref[] =
+    "rac.session.crash_restore_time";
+
+// How long a silently restored launch must run before its crash counts as a
+// new one. Only the selected tabs load during a restore, so a session that
+// crashes rac does it well within this.
+inline constexpr base::TimeDelta kCrashRestoreStablePeriod = base::Minutes(5);
+
+// A guard this far from now in either direction is ignored, so a guard left
+// behind by a clock change or an unusual exit can't stop silent restores for
+// good. A crash loop relaunches far sooner.
+inline constexpr base::TimeDelta kCrashRestoreGuardExpiry = base::Days(1);
+
+enum class CrashRestoreAction {
+  // The last run didn't crash, or its crash was already handled.
+  kNone,
+  // Restore the last session the way a clean launch does, with no bubble.
+  kRestoreSilently,
+  // Chromium's behavior: open a new window and show the "Restore pages?"
+  // bubble, whose Restore button brings the session back.
+  kShowBubble,
+};
+
+// `is_post_crash_launch` is HasPendingUncleanExit(). `restores_last_session` is
+// true for "Continue where you left off", alone or with specific pages.
+// `guard` is kCrashRestoreGuardPref, null when unset.
+CrashRestoreAction DecideCrashRestore(bool is_post_crash_launch,
+                                      bool restores_last_session,
+                                      base::Time guard,
+                                      base::Time now);
+
+// Whether `guard` is set and within kCrashRestoreGuardExpiry of `now`.
+bool IsCrashRestoreGuardActive(base::Time guard, base::Time now);
+
+// Whether a launch should clear `guard` right away: it's set and the last run
+// didn't crash, so the restored launch reached a clean exit.
+bool ShouldClearCrashRestoreGuard(bool last_exit_crashed, base::Time guard);
+
+enum class CrashBubbleAction {
+  // Show the "Restore pages?" bubble now: no silent restore is in play, or it
+  // brought nothing back.
+  kShowNow,
+  // The silent restore is still running. Show the bubble only if it ends with
+  // no tabs restored.
+  kWaitForRestore,
+  // The silent restore brought tabs back, so the bubble would only duplicate
+  // them.
+  kHide,
+};
+
+// What to do with the crash bubble that Chromium is about to show.
+// `restoring_silently` is whether this launch chose kRestoreSilently.
+// `restore_running` is SessionRestore::IsRestoring(). `tabs_restored` is the
+// count the silent restore reported when it finished, or nullopt before then.
+// A restore that isn't running and hasn't finished never started (no session
+// service, for one), so the bubble shows.
+CrashBubbleAction DecideCrashBubble(bool restoring_silently,
+                                    bool restore_running,
+                                    std::optional<int> tabs_restored);
+
+// Whether a bubble that waited for the silent restore should show once it
+// finished with `tabs_restored`.
+bool ShouldShowCrashBubbleAfterRestore(int tabs_restored);
+
+// Registers kCrashRestoreGuardPref. Called with the profile's registry.
+void RegisterCrashRestorePrefs(PrefRegistrySimple* registry);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_CRASH_RESTORE_POLICY_H_

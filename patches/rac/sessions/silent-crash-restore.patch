--- /dev/null
+++ src/chrome/browser/rac/storage/crash_restore.cc
@@ -0,0 +1,166 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/crash_restore.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/callback_list.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/storage/crash_restore_policy.h"
+#include "chrome/browser/sessions/exit_type_service.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+const void* const kCrashRestoreStateKey = &kCrashRestoreStateKey;
+
+// Put on the profile when a launch decides to restore silently after a crash,
+// and kept until the profile goes away. Records how the first restore of the
+// profile after that ended, and holds the crash bubble until then.
+class CrashRestoreState : public base::SupportsUserData::Data {
+ public:
+  CrashRestoreState()
+      : restored_subscription_(
+            SessionRestore::RegisterOnSessionRestoredCallback(
+                base::BindRepeating(&CrashRestoreState::OnSessionRestored,
+                                    base::Unretained(this)))) {}
+  CrashRestoreState(const CrashRestoreState&) = delete;
+  CrashRestoreState& operator=(const CrashRestoreState&) = delete;
+  ~CrashRestoreState() override = default;
+
+  static CrashRestoreState* FromProfile(const Profile* profile) {
+    return static_cast<CrashRestoreState*>(
+        profile->GetUserData(kCrashRestoreStateKey));
+  }
+
+  // Tabs the silent restore brought back, or nullopt until it finishes.
+  std::optional<int> tabs_restored() const { return tabs_restored_; }
+
+  void WaitToShowBubble(base::OnceClosure show_bubble) {
+    pending_bubble_ = std::move(show_bubble);
+  }
+
+ private:
+  void OnSessionRestored(Profile* profile, int tabs_restored) {
+    if (FromProfile(profile) != this || tabs_restored_.has_value()) {
+      return;
+    }
+    tabs_restored_ = tabs_restored;
+    base::OnceClosure show_bubble = std::move(pending_bubble_);
+    if (show_bubble && ShouldShowCrashBubbleAfterRestore(tabs_restored)) {
+      // Not from inside the restorer's notification. The closure checks that
+      // its window is still open.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, std::move(show_bubble));
+    }
+  }
+
+  std::optional<int> tabs_restored_;
+  base::OnceClosure pending_bubble_;
+  base::CallbackListSubscription restored_subscription_;
+};
+
+void ClearGuard(base::WeakPtr<Profile> profile) {
+  if (profile) {
+    profile->GetPrefs()->ClearPref(kCrashRestoreGuardPref);
+  }
+}
+
+// The launch counts as recovered once it has been up this long. Delayed tasks
+// don't count time asleep, so a Mac that sleeps right after the restore still
+// needs the full period awake.
+void ClearGuardOnceStable(Profile* profile) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&ClearGuard, profile->GetWeakPtr()),
+      kCrashRestoreStablePeriod);
+}
+
+}  // namespace
+
+bool ShouldRestoreSessionAfterCrash(Profile* profile,
+                                    bool is_post_crash_launch,
+                                    bool restores_last_session) {
+  if (!profile->IsRegularProfile()) {
+    return false;
+  }
+  // This run already chose to restore. Don't read its own guard as a loop.
+  if (CrashRestoreState::FromProfile(profile)) {
+    return is_post_crash_launch;
+  }
+
+  PrefService* prefs = profile->GetPrefs();
+  base::Time guard = prefs->GetTime(kCrashRestoreGuardPref);
+  const bool last_exit_crashed =
+      ExitTypeService::GetLastSessionExitType(profile) == ExitType::kCrashed;
+  if (ShouldClearCrashRestoreGuard(last_exit_crashed, guard)) {
+    prefs->ClearPref(kCrashRestoreGuardPref);
+    guard = base::Time();
+  }
+
+  const base::Time now = base::Time::Now();
+  switch (DecideCrashRestore(is_post_crash_launch, restores_last_session,
+                             guard, now)) {
+    case CrashRestoreAction::kNone:
+      return false;
+    case CrashRestoreAction::kShowBubble:
+      // Chromium's crash path. If the crash happened while recovering, this
+      // launch now has to stay up before silent restores come back.
+      if (!guard.is_null()) {
+        ClearGuardOnceStable(profile);
+      }
+      return false;
+    case CrashRestoreAction::kRestoreSilently:
+      break;
+  }
+
+  // Set before anything is restored, and its write is scheduled right away so
+  // a crash during the restore usually finds it on the next launch.
+  // CommitPendingWrite() doesn't wait for the disk: a crash within milliseconds
+  // can lose the guard. That costs one extra silent restore, never the session,
+  // which stays unwritten until the restore has finished.
+  prefs->SetTime(kCrashRestoreGuardPref, now);
+  prefs->CommitPendingWrite();
+  ClearGuardOnceStable(profile);
+  profile->SetUserData(kCrashRestoreStateKey,
+                       std::make_unique<CrashRestoreState>());
+  return true;
+}
+
+bool IsSilentCrashRestorePending(Profile* profile) {
+  const CrashRestoreState* state = CrashRestoreState::FromProfile(profile);
+  return state && !state->tabs_restored().has_value();
+}
+
+void ShowCrashBubbleUnlessRestored(Profile* profile,
+                                   base::OnceClosure show_bubble) {
+  CrashRestoreState* state = CrashRestoreState::FromProfile(profile);
+  switch (DecideCrashBubble(
+      /*restoring_silently=*/state != nullptr,
+      SessionRestore::IsRestoring(profile),
+      state ? state->tabs_restored() : std::nullopt)) {
+    case CrashBubbleAction::kShowNow:
+      std::move(show_bubble).Run();
+      return;
+    case CrashBubbleAction::kWaitForRestore:
+      state->WaitToShowBubble(std::move(show_bubble));
+      return;
+    case CrashBubbleAction::kHide:
+      return;
+  }
+}
+
+}  // namespace rac

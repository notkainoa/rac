+// ---- rac proof (#127), never merged: drives a real tab drag. ----
+// The harness's synthetic mouse drags don't start a tab drag, so these verbs
+// call the sidebar's drag handler the way a tab view does on mouse events.
+
+TabDragHandlerImpl* ProofDragHandler(views::Widget* widget) {
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(widget->GetNativeWindow());
+  if (!browser_view || !browser_view->tab_strip_view()) {
+    return nullptr;
+  }
+  return static_cast<TabDragHandlerImpl*>(
+      browser_view->tab_strip_view()->GetDragContext());
+}
+
+int& ProofDragGeneration() {
+  static int generation = 0;
+  return generation;
+}
+
+void ProofDragTo(views::Widget* widget, gfx::PointF point) {
+  TabDragHandlerImpl* handler = ProofDragHandler(widget);
+  if (!handler) {
+    return;
+  }
+  const gfx::Point location = gfx::ToRoundedPoint(point);
+  ui::MouseEvent drag(ui::EventType::kMouseDragged, location, location,
+                      ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON, 0);
+  handler->ContinueDrag(*widget->GetRootView(), drag);
+}
+
+void ProofDragAlong(base::WeakPtr<views::Widget> widget,
+                    gfx::PointF from,
+                    gfx::PointF to,
+                    int step,
+                    int steps,
+                    int generation) {
+  if (!widget || generation != ProofDragGeneration()) {
+    return;
+  }
+  const float t = static_cast<float>(step) / steps;
+  ProofDragTo(widget.get(), gfx::PointF(from.x() + (to.x() - from.x()) * t,
+                                        from.y() + (to.y() - from.y()) * t));
+  if (step < steps) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ProofDragAlong, widget, from, to, step + 1, steps,
+                       generation),
+        kPointerStep);
+  }
+}
+
+
+// Hides the space switcher and the space name row, as a launch without the
+// spaces UI would.
+void ProofHideSpaces(views::View* view) {
+  if (view->GetClassName() == "SpaceSwitcherView") {
+    view->SetVisible(false);
+  }
+  if (view->GetClassName() == "UnpinnedTabContainerView") {
+    view->InvalidateLayout();
+  }
+  for (views::View* child : view->children()) {
+    ProofHideSpaces(child);
+  }
+}
+
+bool HandleProofDragRequest(views::Widget* widget,
+                            const std::vector<std::string>& words) {
+  const std::string& verb = words[0];
+  if (verb == "proof-hide-spaces" && words.size() == 1) {
+    base::CommandLine::ForCurrentProcess()->AppendSwitch(
+        "rac-proof-no-spaces");
+    ProofHideSpaces(widget->GetRootView());
+    return true;
+  }
+  TabDragHandlerImpl* handler = ProofDragHandler(widget);
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(widget->GetNativeWindow());
+  int index = 0;
+  if (verb == "tabdrag-start" && words.size() == 2 &&
+      base::StringToInt(words[1], &index) && handler && browser_view) {
+    TabStripModel* model = browser_view->browser()->GetTabStripModel();
+    if (!model->ContainsIndex(index)) {
+      LOG(ERROR) << "rac proof: no tab " << index;
+      return true;
+    }
+    TabSlotView* slot =
+        handler->GetTabForContents(model->GetWebContentsAt(index));
+    views::View* view = slot ? handler->ViewFromTabSlot(slot) : nullptr;
+    auto* tab_view = views::AsViewClass<TabView>(view);
+    if (!tab_view || !tab_view->collection_node()) {
+      LOG(ERROR) << "rac proof: no view for tab " << index;
+      return true;
+    }
+    const gfx::Point in_view(view->width() / 2, view->height() / 2);
+    const gfx::Point in_root = views::View::ConvertPointToTarget(
+        view, widget->GetRootView(), in_view);
+    ui::MouseEvent press(ui::EventType::kMousePressed, in_view, in_root,
+                         ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                         ui::EF_LEFT_MOUSE_BUTTON);
+    // As TabView does on a press: select the tab, then start with the
+    // selection from before.
+    const ui::ListSelectionModel original =
+        model->selection_model().GetListSelectionModel();
+    model->ActivateTabAt(index);
+    handler->InitializeDrag(
+        const_cast<TabCollectionNode&>(*tab_view->collection_node()),
+        original, press);
+    LOG(WARNING) << "rac proof: drag of tab " << index << " from "
+                 << in_root.ToString();
+    return true;
+  }
+  double x = 0;
+  double y = 0;
+  if (verb == "tabdrag-to" && words.size() == 3 &&
+      base::StringToDouble(words[1], &x) &&
+      base::StringToDouble(words[2], &y)) {
+    ++ProofDragGeneration();
+    ProofDragTo(widget, gfx::PointF(x, y));
+    return true;
+  }
+  double x1 = 0;
+  double y1 = 0;
+  int ms = 0;
+  if (verb == "tabdrag-path" && words.size() == 6 &&
+      base::StringToDouble(words[1], &x) &&
+      base::StringToDouble(words[2], &y) &&
+      base::StringToDouble(words[3], &x1) &&
+      base::StringToDouble(words[4], &y1) && base::StringToInt(words[5], &ms) &&
+      ms >= 0) {
+    ProofDragAlong(
+        widget->GetWeakPtr(), gfx::PointF(x, y), gfx::PointF(x1, y1), 0,
+        std::max(1, static_cast<int>(base::Milliseconds(ms) / kPointerStep)),
+        ++ProofDragGeneration());
+    return true;
+  }
+  if ((verb == "tabdrag-drop" || verb == "tabdrag-cancel") &&
+      words.size() == 1 && handler) {
+    ++ProofDragGeneration();
+    handler->EndDrag(verb == "tabdrag-drop" ? EndDragReason::kComplete
+                                            : EndDragReason::kCancel);
+    LOG(WARNING) << "rac proof: " << verb;
+    return true;
+  }
+  return false;
+}
+// ---- end rac proof ----
+

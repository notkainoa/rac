+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/media/sidebar_media_factory.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/rac/media/sidebar_media.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/media_session_service.h"
+#include "services/media_session/public/cpp/media_session_service.h"
+
+namespace rac {
+
+namespace {
+
+// The tab's media session activates its tab and window through the tab's
+// delegate, as the toolbar's media dialog does.
+void RaiseSession(const base::UnguessableToken& request_id) {
+  content::WebContents* web_contents =
+      content::MediaSession::GetWebContentsFromRequestId(request_id);
+  content::MediaSession* media_session =
+      web_contents ? content::MediaSession::GetIfExists(web_contents) : nullptr;
+  if (media_session) {
+    media_session->Raise();
+  }
+}
+
+}  // namespace
+
+// static
+SidebarMedia* SidebarMediaFactory::GetForProfile(Profile* profile) {
+  return static_cast<SidebarMedia*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+SidebarMediaFactory* SidebarMediaFactory::GetInstance() {
+  static base::NoDestructor<SidebarMediaFactory> instance;
+  return instance.get();
+}
+
+SidebarMediaFactory::SidebarMediaFactory()
+    : ProfileKeyedServiceFactory(
+          "RacSidebarMedia",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOwnInstance)
+              .WithGuest(ProfileSelection::kOwnInstance)
+              .WithSystem(ProfileSelection::kNone)
+              .Build()) {}
+
+SidebarMediaFactory::~SidebarMediaFactory() = default;
+
+std::unique_ptr<KeyedService>
+SidebarMediaFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  SidebarMedia::Bindings bindings;
+  bindings.source_id = content::MediaSession::GetSourceId(context);
+  bindings.bind_audio_focus = base::BindOnce(
+      [](mojo::PendingReceiver<media_session::mojom::AudioFocusManager>
+             receiver) {
+        content::GetMediaSessionService().BindAudioFocusManager(
+            std::move(receiver));
+      });
+  bindings.bind_controller_manager = base::BindOnce(
+      [](mojo::PendingReceiver<media_session::mojom::MediaControllerManager>
+             receiver) {
+        content::GetMediaSessionService().BindMediaControllerManager(
+            std::move(receiver));
+      });
+  bindings.raise = base::BindRepeating(&RaiseSession);
+  return std::make_unique<SidebarMedia>(std::move(bindings));
+}
+
+// Unit tests have no media session service to bind.
+bool SidebarMediaFactory::ServiceIsNULLWhileTesting() const {
+  return true;
+}
+
+}  // namespace rac

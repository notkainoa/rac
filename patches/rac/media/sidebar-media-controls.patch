@@ -0,0 +1,113 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_MEDIA_SIDEBAR_MEDIA_MODEL_H_
+#define CHROME_BROWSER_UI_RAC_MEDIA_SIDEBAR_MEDIA_MODEL_H_
+
+#include <optional>
+#include <string>
+
+#include "base/time/time.h"
+#include "services/media_session/public/cpp/media_position.h"
+
+// The rules behind the sidebar's media card, kept apart from mojo and views
+// so they can be tested on their own.
+namespace rac::sidebar_media {
+
+// The progress line moves at most this often, and only while it's drawn.
+inline constexpr base::TimeDelta kProgressInterval = base::Seconds(1);
+
+// What the sidebar knows about one of the profile's media sessions.
+struct SessionSnapshot {
+  SessionSnapshot();
+  SessionSnapshot(const SessionSnapshot&);
+  SessionSnapshot& operator=(const SessionSnapshot&);
+  ~SessionSnapshot();
+
+  bool controllable = false;
+  // The page asked to keep its metadata private: show only the site.
+  bool hide_metadata = false;
+  bool playing = false;
+  // The user dismissed it. It shows again when it next plays.
+  bool dismissed = false;
+  bool can_play_pause = false;
+  bool can_previous = false;
+  bool can_next = false;
+  std::u16string title;
+  std::u16string artist;
+  std::u16string source_title;
+  std::optional<media_session::MediaPosition> position;
+  // When it was first seen or last started playing. Newer wins.
+  base::TimeTicks last_active;
+};
+
+// What a window's card draws for the session it shows.
+struct CardState {
+  CardState();
+  CardState(const CardState&);
+  CardState& operator=(const CardState&);
+  ~CardState();
+
+  std::u16string title;
+  // The artist, or the site when there's no artist.
+  std::u16string subtitle;
+  bool playing = false;
+  bool show_play_pause = false;
+  bool show_previous = false;
+  bool show_next = false;
+  // Only a paused session can be dismissed; pause first.
+  bool show_dismiss = false;
+  bool has_progress = false;
+
+  friend bool operator==(const CardState&, const CardState&) = default;
+};
+
+// Whether the session gets a card at all.
+bool ShouldShow(const SessionSnapshot& session);
+
+// Whether `a` should take the card over `b`. Both must pass ShouldShow().
+// Playing beats paused; then the most recently active wins.
+bool ShowsBefore(const SessionSnapshot& a, const SessionSnapshot& b);
+
+CardState MakeCardState(const SessionSnapshot& session);
+
+// Whether the position can draw a progress line: a known, finite length.
+// Live streams report an infinite one.
+bool HasProgress(const std::optional<media_session::MediaPosition>& position);
+
+// How far through the media it is at `now`, from 0 to 1. A paused session
+// stays where it was last reported.
+double ProgressAt(const media_session::MediaPosition& position,
+                  bool playing,
+                  base::TimeTicks now);
+
+// The progress line ticks only while someone can see it move: the card is
+// drawn in a window on screen, and the media is playing forward with a known
+// length and hasn't reached its end.
+bool ShouldRunProgressTimer(
+    bool drawn,
+    bool playing,
+    const std::optional<media_session::MediaPosition>& position,
+    base::TimeTicks now);
+
+// How often a line `line_width` DIPs long needs to move: about a DIP per
+// tick, and never more than once a second.
+base::TimeDelta ProgressInterval(const media_session::MediaPosition& position,
+                                 int line_width);
+
+// Whether the windows must redraw their cards for a change to the shown
+// session. A new position alone doesn't count while the media plays and its
+// line is still moving: each card's progress timer reads the position then.
+// Without this, a site that reports its position on every timeupdate would
+// repaint every window several times a second.
+bool NeedsRedraw(
+    const CardState& before,
+    const CardState& after,
+    const std::optional<media_session::MediaPosition>& before_position,
+    const std::optional<media_session::MediaPosition>& after_position,
+    base::TimeTicks now);
+
+}  // namespace rac::sidebar_media
+
+#endif  // CHROME_BROWSER_UI_RAC_MEDIA_SIDEBAR_MEDIA_MODEL_H_
Index: src/chrome/browser/ui/rac/media/sidebar_media_model_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/rac/media/sidebar_media_model_unittest.cc
@@ -0,0 +1,217 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/media/sidebar_media_model.h"
+
+#include <optional>
+
+#include "base/time/time.h"
+#include "services/media_session/public/cpp/media_position.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::sidebar_media {
+
+namespace {
+
+SessionSnapshot Playable() {
+  SessionSnapshot session;
+  session.controllable = true;
+  session.title = u"Song";
+  session.artist = u"Artist";
+  session.source_title = u"example.com";
+  session.can_play_pause = true;
+  return session;
+}
+
+media_session::MediaPosition Position(double rate,
+                                      base::TimeDelta duration,
+                                      base::TimeDelta at) {
+  return media_session::MediaPosition(rate, duration, at,
+                                      /*end_of_media=*/false);
+}
+
+}  // namespace
+
+TEST(SidebarMediaModelTest, ShowsControllableSessionsWithATitle) {
+  EXPECT_TRUE(ShouldShow(Playable()));
+
+  SessionSnapshot uncontrollable = Playable();
+  uncontrollable.controllable = false;
+  EXPECT_FALSE(ShouldShow(uncontrollable));
+
+  SessionSnapshot untitled = Playable();
+  untitled.title.clear();
+  EXPECT_FALSE(ShouldShow(untitled));
+
+  SessionSnapshot dismissed = Playable();
+  dismissed.dismissed = true;
+  EXPECT_FALSE(ShouldShow(dismissed));
+}
+
+TEST(SidebarMediaModelTest, HiddenMetadataShowsOnlyTheSite) {
+  SessionSnapshot session = Playable();
+  session.hide_metadata = true;
+  EXPECT_TRUE(ShouldShow(session));
+
+  const CardState card = MakeCardState(session);
+  EXPECT_EQ(card.title, u"example.com");
+  EXPECT_TRUE(card.subtitle.empty());
+
+  session.source_title.clear();
+  EXPECT_FALSE(ShouldShow(session));
+}
+
+TEST(SidebarMediaModelTest, SubtitleFallsBackToTheSite) {
+  SessionSnapshot session = Playable();
+  EXPECT_EQ(MakeCardState(session).subtitle, u"Artist");
+
+  session.artist.clear();
+  EXPECT_EQ(MakeCardState(session).subtitle, u"example.com");
+}
+
+TEST(SidebarMediaModelTest, ButtonsFollowTheSessionsActions) {
+  SessionSnapshot session = Playable();
+  session.playing = true;
+  CardState card = MakeCardState(session);
+  EXPECT_TRUE(card.playing);
+  EXPECT_TRUE(card.show_play_pause);
+  EXPECT_FALSE(card.show_previous);
+  EXPECT_FALSE(card.show_next);
+  EXPECT_FALSE(card.show_dismiss);
+
+  session.playing = false;
+  session.can_previous = true;
+  session.can_next = true;
+  card = MakeCardState(session);
+  EXPECT_FALSE(card.playing);
+  EXPECT_TRUE(card.show_previous);
+  EXPECT_TRUE(card.show_next);
+  EXPECT_TRUE(card.show_dismiss);
+}
+
+TEST(SidebarMediaModelTest, PlayingBeatsPausedThenNewestWins) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  SessionSnapshot old_playing = Playable();
+  old_playing.playing = true;
+  old_playing.last_active = now - base::Minutes(5);
+  SessionSnapshot new_paused = Playable();
+  new_paused.last_active = now;
+  EXPECT_TRUE(ShowsBefore(old_playing, new_paused));
+  EXPECT_FALSE(ShowsBefore(new_paused, old_playing));
+
+  SessionSnapshot new_playing = old_playing;
+  new_playing.last_active = now;
+  EXPECT_TRUE(ShowsBefore(new_playing, old_playing));
+  EXPECT_FALSE(ShowsBefore(old_playing, new_playing));
+  EXPECT_FALSE(ShowsBefore(new_playing, new_playing));
+}
+
+TEST(SidebarMediaModelTest, ProgressNeedsAFiniteLength) {
+  EXPECT_FALSE(HasProgress(std::nullopt));
+  EXPECT_FALSE(HasProgress(Position(1, base::TimeDelta(), base::TimeDelta())));
+  EXPECT_FALSE(
+      HasProgress(Position(1, base::TimeDelta::Max(), base::Seconds(10))));
+  EXPECT_TRUE(HasProgress(Position(1, base::Minutes(3), base::Seconds(10))));
+
+  SessionSnapshot live = Playable();
+  live.position = Position(1, base::TimeDelta::Max(), base::Seconds(10));
+  EXPECT_FALSE(MakeCardState(live).has_progress);
+}
+
+TEST(SidebarMediaModelTest, ProgressMovesOnlyWhilePlaying) {
+  const media_session::MediaPosition position =
+      Position(1, base::Seconds(100), base::Seconds(25));
+  const base::TimeTicks later =
+      position.last_updated_time() + base::Seconds(25);
+
+  EXPECT_DOUBLE_EQ(ProgressAt(position, /*playing=*/true, later), 0.5);
+  EXPECT_DOUBLE_EQ(ProgressAt(position, /*playing=*/false, later), 0.25);
+  EXPECT_DOUBLE_EQ(
+      ProgressAt(position, /*playing=*/true, later + base::Hours(1)), 1.0);
+  EXPECT_DOUBLE_EQ(
+      ProgressAt(Position(1, base::TimeDelta::Max(), base::Seconds(1)),
+                 /*playing=*/true, later),
+      0.0);
+}
+
+TEST(SidebarMediaModelTest, TimerRunsOnlyWhileDrawnAndPlaying) {
+  const std::optional<media_session::MediaPosition> position =
+      Position(1, base::Minutes(3), base::Seconds(10));
+  const base::TimeTicks now = position->last_updated_time();
+
+  EXPECT_TRUE(
+      ShouldRunProgressTimer(/*drawn=*/true, /*playing=*/true, position, now));
+  // A hidden sidebar, a minimized window, or one on another Space.
+  EXPECT_FALSE(
+      ShouldRunProgressTimer(/*drawn=*/false, /*playing=*/true, position, now));
+  EXPECT_FALSE(
+      ShouldRunProgressTimer(/*drawn=*/true, /*playing=*/false, position, now));
+  EXPECT_FALSE(ShouldRunProgressTimer(/*drawn=*/true, /*playing=*/true,
+                                      std::nullopt, now));
+  EXPECT_FALSE(ShouldRunProgressTimer(
+      /*drawn=*/true, /*playing=*/true,
+      Position(1, base::TimeDelta::Max(), base::Seconds(10)), now));
+  // Playing but stalled: nothing to move.
+  EXPECT_FALSE(ShouldRunProgressTimer(
+      /*drawn=*/true, /*playing=*/true,
+      Position(0, base::Minutes(3), base::Seconds(10)), now));
+  // The line reached its end.
+  EXPECT_FALSE(ShouldRunProgressTimer(/*drawn=*/true, /*playing=*/true,
+                                      position, now + base::Minutes(3)));
+}
+
+TEST(SidebarMediaModelTest, IntervalMovesAboutADipPerTick) {
+  // Ten minutes over 100 DIPs is six seconds a DIP.
+  EXPECT_EQ(
+      ProgressInterval(Position(1, base::Minutes(10), base::TimeDelta()), 100),
+      base::Seconds(6));
+  // Twice the speed, twice as often.
+  EXPECT_EQ(
+      ProgressInterval(Position(2, base::Minutes(10), base::TimeDelta()), 100),
+      base::Seconds(3));
+  // Short media never ticks faster than once a second.
+  EXPECT_EQ(
+      ProgressInterval(Position(1, base::Seconds(20), base::TimeDelta()), 100),
+      kProgressInterval);
+  EXPECT_EQ(
+      ProgressInterval(Position(1, base::Minutes(10), base::TimeDelta()), 0),
+      kProgressInterval);
+}
+
+TEST(SidebarMediaModelTest, PositionAloneDoesNotRedrawWhilePlaying) {
+  SessionSnapshot session = Playable();
+  session.playing = true;
+  const CardState playing = MakeCardState(session);
+  const media_session::MediaPosition at_10s =
+      Position(1, base::Minutes(3), base::Seconds(10));
+  const media_session::MediaPosition at_11s =
+      Position(1, base::Minutes(3), base::Seconds(11));
+  const base::TimeTicks now = at_11s.last_updated_time();
+
+  EXPECT_FALSE(NeedsRedraw(playing, playing, at_10s, at_11s, now));
+  EXPECT_FALSE(NeedsRedraw(playing, playing, at_10s, at_10s, now));
+
+  // Anything the card shows besides the line does.
+  CardState renamed = playing;
+  renamed.title = u"Another Song";
+  EXPECT_TRUE(NeedsRedraw(playing, renamed, at_10s, at_10s, now));
+
+  // A paused line only moves when told.
+  session.playing = false;
+  const CardState paused = MakeCardState(session);
+  EXPECT_TRUE(NeedsRedraw(paused, paused, at_10s, at_11s, now));
+
+  // Gaining or losing a position, or stalling, changes the timer.
+  EXPECT_TRUE(NeedsRedraw(playing, playing, std::nullopt, at_11s, now));
+  EXPECT_TRUE(NeedsRedraw(playing, playing, at_10s,
+                          Position(0, base::Minutes(3), base::Seconds(11)),
+                          now));
+
+  // A line that reached its end stopped its timer; a loop restarts it.
+  EXPECT_TRUE(NeedsRedraw(playing, playing, at_10s,
+                          Position(1, base::Minutes(3), base::TimeDelta()),
+                          now + base::Minutes(3)));
+}
+
+}  // namespace rac::sidebar_media

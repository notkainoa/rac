@@ -0,0 +1,123 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/media/sidebar_media_model.h"
+
+#include <algorithm>
+
+namespace rac::sidebar_media {
+
+namespace {
+
+const std::u16string& GetTitle(const SessionSnapshot& session) {
+  return session.hide_metadata ? session.source_title : session.title;
+}
+
+}  // namespace
+
+SessionSnapshot::SessionSnapshot() = default;
+SessionSnapshot::SessionSnapshot(const SessionSnapshot&) = default;
+SessionSnapshot& SessionSnapshot::operator=(const SessionSnapshot&) = default;
+SessionSnapshot::~SessionSnapshot() = default;
+
+CardState::CardState() = default;
+CardState::CardState(const CardState&) = default;
+CardState& CardState::operator=(const CardState&) = default;
+CardState::~CardState() = default;
+
+bool ShouldShow(const SessionSnapshot& session) {
+  return session.controllable && !session.dismissed &&
+         !GetTitle(session).empty();
+}
+
+bool ShowsBefore(const SessionSnapshot& a, const SessionSnapshot& b) {
+  if (a.playing != b.playing) {
+    return a.playing;
+  }
+  return a.last_active > b.last_active;
+}
+
+CardState MakeCardState(const SessionSnapshot& session) {
+  CardState state;
+  state.title = GetTitle(session);
+  if (!session.hide_metadata) {
+    state.subtitle =
+        session.artist.empty() ? session.source_title : session.artist;
+  }
+  state.playing = session.playing;
+  state.show_play_pause = session.can_play_pause;
+  state.show_previous = session.can_previous;
+  state.show_next = session.can_next;
+  state.show_dismiss = !session.playing;
+  state.has_progress = HasProgress(session.position);
+  return state;
+}
+
+bool HasProgress(const std::optional<media_session::MediaPosition>& position) {
+  if (!position) {
+    return false;
+  }
+  const base::TimeDelta duration = position->duration();
+  return duration.is_positive() && !duration.is_max();
+}
+
+double ProgressAt(const media_session::MediaPosition& position,
+                  bool playing,
+                  base::TimeTicks now) {
+  const base::TimeDelta duration = position.duration();
+  if (!duration.is_positive() || duration.is_max()) {
+    return 0;
+  }
+  const base::TimeDelta at =
+      position.GetPositionAtTime(playing ? now : position.last_updated_time());
+  return std::clamp(at / duration, 0.0, 1.0);
+}
+
+bool ShouldRunProgressTimer(
+    bool drawn,
+    bool playing,
+    const std::optional<media_session::MediaPosition>& position,
+    base::TimeTicks now) {
+  return drawn && playing && HasProgress(position) &&
+         position->playback_rate() > 0 &&
+         ProgressAt(*position, playing, now) < 1.0;
+}
+
+base::TimeDelta ProgressInterval(const media_session::MediaPosition& position,
+                                 int line_width) {
+  const double rate = position.playback_rate();
+  if (line_width <= 0 || rate <= 0 || !HasProgress(position)) {
+    return kProgressInterval;
+  }
+  return std::max(kProgressInterval, position.duration() / (rate * line_width));
+}
+
+bool NeedsRedraw(
+    const CardState& before,
+    const CardState& after,
+    const std::optional<media_session::MediaPosition>& before_position,
+    const std::optional<media_session::MediaPosition>& after_position,
+    base::TimeTicks now) {
+  if (before != after) {
+    return true;
+  }
+  if (before_position == after_position) {
+    return false;
+  }
+  // A paused line doesn't tick, so it only moves when told.
+  if (!after.playing || !before_position || !after_position) {
+    return true;
+  }
+  // The timer only runs while the position moves forward, so starting or
+  // stalling needs a redraw too.
+  if ((before_position->playback_rate() > 0) !=
+      (after_position->playback_rate() > 0)) {
+    return true;
+  }
+  // A line that reached its end stopped its timer: a loop or a seek back
+  // has to restart it.
+  return ProgressAt(*before_position, /*playing=*/true, now) >= 1.0;
+}
+
+}  // namespace rac::sidebar_media

+namespace rac {
+
+namespace {
+
+// One full card plus a peek of the next when several sessions are active.
+constexpr int kMaxListHeight = 280;
+
+}  // namespace
+
+RacMediaControlsView::RacMediaControlsView(BrowserWindowInterface* browser)
+    : profile_(browser->GetProfile()),
+      service_(MediaNotificationServiceFactory::GetForProfile(profile_)),
+      controls_(RacMediaControlsFactory::GetForProfile(profile_)),
+      media_color_theme_(GetMediaColorTheme()) {
+  SetVisible(false);
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+
+  list_view_ = AddChildView(
+      std::make_unique<global_media_controls::MediaItemUIListView>());
+  list_view_->ClipHeightTo(0, kMaxListHeight);
+
+  // The role must be set before the name: naming a node whose role is
+  // still kUnknown trips AXNodeData::SetName's ordering check.
+  GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_GLOBAL_MEDIA_CONTROLS_DIALOG_NAME));
+}
+
+RacMediaControlsView::~RacMediaControlsView() {
+  if (registered_ && controls_) {
+    registered_ = false;
+    controls_->RemoveDisplay(this);
+  }
+  // The item views must die while |items_| is still alive: each one reports
+  // OnMediaItemUIDestroyed on its way out.
+  ClearMediaItems();
+}
+
+global_media_controls::MediaItemUI* RacMediaControlsView::ShowMediaItem(
+    const std::string& id,
+    base::WeakPtr<media_message_center::MediaNotificationItem> item) {
+  if (items_.contains(id)) {
+    HideMediaItem(id);
+  }
+  if (!item) {
+    return nullptr;
+  }
+
+  auto view = std::make_unique<global_media_controls::MediaItemUIUpdatedView>(
+      id, item, media_color_theme_,
+      BuildDeviceSelector(
+          id, item, service_, service_, profile_->GetOriginalProfile(),
+          global_media_controls::GlobalMediaControlsEntryPoint::kToolbarIcon,
+          media_color_theme_, /*show_devices=*/false),
+      BuildFooter(id, item, profile_->GetOriginalProfile(),
+                  media_color_theme_));
+  view->AddObserver(this);
+  auto* view_ptr = view.get();
+  items_[id] = view_ptr;
+  list_view_->ShowUpdatedItem(id, std::move(view));
+
+  UpdateVisibility();
+  return view_ptr;
+}
+
+void RacMediaControlsView::HideMediaItem(const std::string& id) {
+  const auto it = items_.find(id);
+  if (it == items_.end()) {
+    return;
+  }
+  it->second->RemoveObserver(this);
+  items_.erase(it);
+  list_view_->HideUpdatedItem(id);
+  UpdateVisibility();
+}
+
+void RacMediaControlsView::RefreshMediaItem(
+    const std::string& id,
+    base::WeakPtr<media_message_center::MediaNotificationItem> item) {
+  const auto it = items_.find(id);
+  if (it == items_.end() || !item) {
+    return;
+  }
+  Profile* const original = profile_->GetOriginalProfile();
+  it->second->UpdateFooterView(
+      BuildFooter(id, item, original, media_color_theme_));
+  it->second->UpdateDeviceSelectorView(BuildDeviceSelector(
+      id, item, service_, service_, original,
+      global_media_controls::GlobalMediaControlsEntryPoint::kToolbarIcon,
+      media_color_theme_, /*show_devices=*/false));
+}
+
+void RacMediaControlsView::ClearMediaItems() {
+  for (const auto& [id, view] : items_) {
+    view->RemoveObserver(this);
+    list_view_->HideUpdatedItem(id);
+  }
+  items_.clear();
+  UpdateVisibility();
+}
+
+void RacMediaControlsView::OnMediaItemUISizeChanged() {
+  PreferredSizeChanged();
+}
+
+void RacMediaControlsView::OnMediaItemUIDestroyed(const std::string& id) {
+  // The view is already gone; drop only the bookkeeping entry.
+  items_.erase(id);
+}
+
+void RacMediaControlsView::AddedToWidget() {
+  views::View::AddedToWidget();
+  widget_observation_.Observe(GetWidget());
+  if (controls_ && !registered_) {
+    registered_ = true;
+    controls_->AddDisplay(this);
+  }
+  if (GetWidget()->IsActive() && controls_) {
+    controls_->SetActiveDisplay(this);
+  }
+}
+
+void RacMediaControlsView::RemovedFromWidget() {
+  widget_observation_.Reset();
+  if (registered_ && controls_) {
+    registered_ = false;
+    controls_->RemoveDisplay(this);
+  }
+  views::View::RemovedFromWidget();
+}
+
+void RacMediaControlsView::OnWidgetActivationChanged(views::Widget* widget,
+                                                     bool active) {
+  if (active && controls_) {
+    controls_->SetActiveDisplay(this);
+  }
+}
+
+void RacMediaControlsView::UpdateVisibility() {
+  const bool show = !items_.empty();
+  if (show == GetVisible()) {
+    return;
+  }
+  SetVisible(show);
+  PreferredSizeChanged();
+}
+
+BEGIN_METADATA(RacMediaControlsView)
+END_METADATA
+
+}  // namespace rac

@@ -0,0 +1,140 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_MEDIA_RAC_MEDIA_CONTROLS_H_
+#define CHROME_BROWSER_UI_RAC_MEDIA_RAC_MEDIA_CONTROLS_H_
+
+#include <map>
+#include <string>
+
+#include "base/containers/flat_set.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/global_media_controls/public/media_dialog_delegate.h"
+#include "components/global_media_controls/public/media_item_manager.h"
+#include "components/global_media_controls/public/media_item_manager_observer.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+class Profile;
+
+namespace media_message_center {
+class MediaNotificationItem;
+}
+
+namespace rac {
+
+// The profile's end of the sidebar media controls. Chromium's
+// MediaItemManager has room for exactly one MediaDialogDelegate -- the media
+// toolbar's bubble takes it while open -- and every media item binds exactly
+// one view, so this service holds the delegate slot and hands items to the
+// display in whichever window's sidebar was activated most recently. It
+// registers only while the manager reports active items, so a browser with
+// nothing playing costs the same as stock Chromium.
+class RacMediaControls
+    : public KeyedService,
+      public global_media_controls::MediaDialogDelegate,
+      public global_media_controls::MediaItemManagerObserver {
+ public:
+  // One window's view of the shared media items, implemented by
+  // RacMediaControlsView.
+  class Display {
+   public:
+    virtual global_media_controls::MediaItemUI* ShowMediaItem(
+        const std::string& id,
+        base::WeakPtr<media_message_center::MediaNotificationItem> item) = 0;
+    virtual void HideMediaItem(const std::string& id) = 0;
+    virtual void RefreshMediaItem(
+        const std::string& id,
+        base::WeakPtr<media_message_center::MediaNotificationItem> item) = 0;
+    virtual void ClearMediaItems() = 0;
+
+   protected:
+    virtual ~Display() = default;
+  };
+
+  explicit RacMediaControls(Profile* profile);
+  RacMediaControls(const RacMediaControls&) = delete;
+  RacMediaControls& operator=(const RacMediaControls&) = delete;
+  ~RacMediaControls() override;
+
+  void AddDisplay(Display* display);
+  void RemoveDisplay(Display* display);
+  // Makes |display| the one holding the item views. Called by the display
+  // when its window activates.
+  void SetActiveDisplay(Display* display);
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // global_media_controls::MediaDialogDelegate:
+  global_media_controls::MediaItemUI* ShowMediaItem(
+      const std::string& id,
+      base::WeakPtr<media_message_center::MediaNotificationItem> item)
+      override;
+  void HideMediaItem(const std::string& id) override;
+  void RefreshMediaItem(
+      const std::string& id,
+      base::WeakPtr<media_message_center::MediaNotificationItem> item)
+      override;
+  void HideMediaDialog() override;
+  void Focus() override;
+
+  // global_media_controls::MediaItemManagerObserver:
+  void OnItemListChanged() override;
+  void OnMediaDialogOpened() override;
+  void OnMediaDialogClosed() override;
+
+ private:
+  global_media_controls::MediaItemManager* manager();
+
+  // Queues the delegate re-check. Called from inside the manager's own
+  // callbacks, so the check itself always runs in a posted task.
+  void MaybeUpdateRegistration();
+  void UpdateRegistration();
+  void RegisterDelegate();
+  void UnregisterDelegate();
+
+  // Rebuilds the active display's item views from |items_|. The old views
+  // are destroyed first because each media item binds a single view.
+  void RepopulateActiveDisplay();
+  void ClearActiveDisplay();
+
+  const raw_ptr<Profile> profile_;
+
+  // Resolved on first use so the keyed service never builds
+  // MediaNotificationService during shutdown.
+  raw_ptr<global_media_controls::MediaItemManager> manager_ = nullptr;
+
+  base::flat_set<raw_ptr<Display>> displays_;
+  raw_ptr<Display> active_display_ = nullptr;
+
+  // The items the manager last showed, keyed by id. Kept across delegate
+  // changes so a display switch or a returned delegate can rebuild views.
+  std::map<std::string,
+           base::WeakPtr<media_message_center::MediaNotificationItem>>
+      items_;
+
+  bool delegate_registered_ = false;
+  // Set while this object is inside a SetDialogDelegate call, so observer
+  // notifications raised by that call aren't mistaken for another dialog
+  // taking the delegate.
+  bool in_set_delegate_ = false;
+  bool update_pending_ = false;
+  // Set when the manager asks the delegate to close; cleared on the next
+  // item list change. Keeps the sidebar from flickering items back on
+  // during a handoff such as a cast taking over the item.
+  bool hidden_until_items_change_ = false;
+  bool shutting_down_ = false;
+
+  base::ScopedObservation<global_media_controls::MediaItemManager,
+                          global_media_controls::MediaItemManagerObserver>
+      manager_observation_{this};
+
+  base::WeakPtrFactory<RacMediaControls> weak_factory_{this};
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_MEDIA_RAC_MEDIA_CONTROLS_H_

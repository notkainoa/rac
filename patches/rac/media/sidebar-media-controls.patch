+
+void SidebarMediaCard::OnWidgetVisibilityChanged(views::Widget* widget,
+                                                 bool visible) {
+  UpdateProgressTimer();
+}
+
+void SidebarMediaCard::OnWidgetVisibilityOnScreenChanged(views::Widget* widget,
+                                                         bool visible) {
+  // Moved to or from another macOS Space, or covered or uncovered.
+  UpdateProgressTimer();
+}
+
+void SidebarMediaCard::OnWidgetShowStateChanged(views::Widget* widget) {
+  // Minimized or restored.

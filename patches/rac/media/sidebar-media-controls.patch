+++ src/chrome/browser/ui/rac/media/sidebar_media_unittest.cc
@@ -0,0 +1,253 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/media/sidebar_media.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/test/bind.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/media_session/media_session_service_impl.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/cpp/media_position.h"
+#include "services/media_session/public/cpp/test/mock_media_session.h"
+#include "services/media_session/public/mojom/audio_focus.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+
+namespace {
+
+using media_session::mojom::AudioFocusType;
+using media_session::mojom::MediaSession;
+
+class CountingObserver : public SidebarMedia::Observer {
+ public:
+  void OnSidebarMediaChanged() override { ++changes; }
+  void OnSidebarMediaShutdown() override { ++shutdowns; }
+
+  int changes = 0;
+  int shutdowns = 0;
+};
+
+media_session::MediaMetadata Metadata(const std::u16string& title) {
+  media_session::MediaMetadata metadata;
+  metadata.title = title;
+  metadata.artist = u"Artist";
+  metadata.source_title = u"example.com";
+  return metadata;
+}
+
+// SidebarMedia against the real in-process media session service, with a
+// mock page session whose requests carry the profile's source id.
+class SidebarMediaTest : public testing::Test {
+ protected:
+  SidebarMediaTest() {
+    service_ = std::make_unique<media_session::MediaSessionServiceImpl>();
+    SidebarMedia::Bindings bindings;
+    bindings.source_id = source_id_;
+    bindings.bind_audio_focus = base::BindOnce(
+        &media_session::MediaSessionServiceImpl::BindAudioFocusManager,
+        base::Unretained(service_.get()));
+    bindings.bind_controller_manager = base::BindOnce(
+        &media_session::MediaSessionServiceImpl::BindMediaControllerManager,
+        base::Unretained(service_.get()));
+    bindings.raise = base::BindLambdaForTesting(
+        [this](const base::UnguessableToken& id) { raised_ = id; });
+    media_ = std::make_unique<SidebarMedia>(std::move(bindings));
+    media_->AddObserver(&observer_);
+
+    // The page's own connection, tagged as this profile's.
+    service_->BindAudioFocusManager(page_focus_.BindNewPipeAndPassReceiver());
+    page_focus_->SetSource(source_id_, "profile");
+    session_.SetIsControllable(true);
+    Flush();
+  }
+
+  ~SidebarMediaTest() override {
+    if (!shut_down_) {
+      media_->RemoveObserver(&observer_);
+      media_->Shutdown();
+    }
+  }
+
+  void Flush() { task_environment_.RunUntilIdle(); }
+
+  void StartPlaying(const std::u16string& title = u"Song") {
+    session_.RequestAudioFocusFromService(page_focus_, AudioFocusType::kGain);
+    Flush();
+    session_.SimulateMetadataChanged(Metadata(title));
+    Flush();
+  }
+
+  std::u16string ShownTitle() const {
+    std::optional<SidebarMedia::Card> card = media_->GetCard();
+    return card ? card->state.title : std::u16string();
+  }
+
+  // Delivers an audio focus event as the manager would, to stand in for
+  // races the real manager can't be made to produce on demand.
+  media_session::mojom::AudioFocusObserver& FocusObserver() { return *media_; }
+
+  media_session::mojom::AudioFocusRequestStatePtr State(
+      const base::UnguessableToken& request_id) {
+    auto state = media_session::mojom::AudioFocusRequestState::New();
+    state->session_info = media_session::mojom::MediaSessionInfo::New();
+    state->session_info->is_controllable = true;
+    state->request_id = request_id;
+    state->source_id = source_id_;
+    return state;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  const base::UnguessableToken source_id_ = base::UnguessableToken::Create();
+  std::unique_ptr<media_session::MediaSessionServiceImpl> service_;
+  mojo::Remote<media_session::mojom::AudioFocusManager> page_focus_;
+  media_session::test::MockMediaSession session_;
+  CountingObserver observer_;
+  std::unique_ptr<SidebarMedia> media_;
+  std::optional<base::UnguessableToken> raised_;
+  bool shut_down_ = false;
+};
+
+}  // namespace
+
+TEST_F(SidebarMediaTest, ShowsAPlayingSession) {
+  EXPECT_FALSE(media_->GetCard());
+
+  StartPlaying();
+
+  std::optional<SidebarMedia::Card> card = media_->GetCard();
+  ASSERT_TRUE(card);
+  EXPECT_EQ(card->state.title, u"Song");
+  EXPECT_EQ(card->state.subtitle, u"Artist");
+  EXPECT_TRUE(card->state.playing);
+  EXPECT_GT(observer_.changes, 0);
+
+  media_->Raise();
+  EXPECT_EQ(raised_, session_.request_id());
+}
+
+TEST_F(SidebarMediaTest, OtherProfilesSessionsDontShow) {
+  mojo::Remote<media_session::mojom::AudioFocusManager> other_focus;
+  service_->BindAudioFocusManager(other_focus.BindNewPipeAndPassReceiver());
+  other_focus->SetSource(base::UnguessableToken::Create(), "other");
+  media_session::test::MockMediaSession other;
+  other.SetIsControllable(true);
+  other.RequestAudioFocusFromService(other_focus, AudioFocusType::kGain);
+  Flush();
+  other.SimulateMetadataChanged(Metadata(u"Elsewhere"));
+  Flush();
+
+  EXPECT_FALSE(media_->GetCard());
+}
+
+TEST_F(SidebarMediaTest, FocusLossKeepsTheCardBriefly) {
+  StartPlaying();
+  session_.AbandonAudioFocusFromClient();
+  Flush();
+  EXPECT_EQ(ShownTitle(), u"Song");
+
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(ShownTitle(), u"Song");
+
+  task_environment_.FastForwardBy(base::Seconds(2));
+  EXPECT_FALSE(media_->GetCard());
+  EXPECT_EQ(media_->SessionCountForTesting(), 0u);
+}
+
+TEST_F(SidebarMediaTest, RegainingFocusBindsANewController) {
+  StartPlaying();
+  const base::UnguessableToken id = session_.request_id();
+
+  FocusObserver().OnFocusLost(State(id));
+  Flush();
+  FocusObserver().OnFocusGained(State(id));
+  Flush();
+
+  // The removal was called off, and the new controller hears the page.
+  task_environment_.FastForwardBy(base::Seconds(5));
+  session_.SimulateMetadataChanged(Metadata(u"Next Song"));
+  Flush();
+  EXPECT_EQ(ShownTitle(), u"Next Song");
+}
+
+TEST_F(SidebarMediaTest, ARequestThatAlreadyEndedIsDropped) {
+  // Startup can list a request that ended before its controller was made.
+  // The controller closes, and the session goes after the grace period
+  // instead of staying until a tab closes.
+  FocusObserver().OnFocusGained(State(base::UnguessableToken::Create()));
+  Flush();
+  EXPECT_EQ(media_->SessionCountForTesting(), 1u);
+
+  task_environment_.FastForwardBy(base::Seconds(3));
+  EXPECT_EQ(media_->SessionCountForTesting(), 0u);
+}
+
+TEST_F(SidebarMediaTest, ReleasedRequestIsRemovedAtOnce) {
+  StartPlaying();
+  page_focus_->RequestIdReleased(session_.request_id());
+  Flush();
+
+  EXPECT_FALSE(media_->GetCard());
+  EXPECT_EQ(media_->SessionCountForTesting(), 0u);
+}
+
+TEST_F(SidebarMediaTest, DismissStopsUntilItPlaysAgain) {
+  StartPlaying();
+  session_.Suspend(MediaSession::SuspendType::kUI);
+  Flush();
+  ASSERT_TRUE(media_->GetCard());
+  EXPECT_TRUE(media_->GetCard()->state.show_dismiss);
+
+  media_->Dismiss();
+  Flush();
+  EXPECT_FALSE(media_->GetCard());
+  EXPECT_EQ(session_.GetState(),
+            media_session::mojom::MediaSessionInfo::SessionState::kInactive);
+
+  session_.Resume(MediaSession::SuspendType::kUI);
+  Flush();
+  EXPECT_EQ(ShownTitle(), u"Song");
+}
+
+TEST_F(SidebarMediaTest, PositionAloneDoesNotNotifyWhilePlaying) {
+  StartPlaying();
+  session_.SimulatePositionChanged(media_session::MediaPosition(
+      1, base::Minutes(3), base::Seconds(10), /*end_of_media=*/false));
+  Flush();
+  const int changes = observer_.changes;
+
+  session_.SimulatePositionChanged(media_session::MediaPosition(
+      1, base::Minutes(3), base::Seconds(40), /*end_of_media=*/false));
+  Flush();
+  EXPECT_EQ(observer_.changes, changes);
+  // The progress line still reads the new position.
+  ASSERT_TRUE(media_->GetShownPosition());
+  EXPECT_GE(media_->GetShownPosition()->GetPosition(), base::Seconds(40));
+
+  // Something the card shows does notify.
+  session_.SimulateMetadataChanged(Metadata(u"Next Song"));
+  Flush();
+  EXPECT_GT(observer_.changes, changes);
+}
+
+TEST_F(SidebarMediaTest, ShutdownTellsTheWindows) {
+  StartPlaying();
+  media_->Shutdown();
+  shut_down_ = true;
+
+  EXPECT_EQ(observer_.shutdowns, 1);
+  EXPECT_FALSE(media_->GetCard());
+  media_->RemoveObserver(&observer_);
+}
+
+}  // namespace rac

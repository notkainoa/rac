+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_MEDIA_SIDEBAR_MEDIA_H_
+#define CHROME_BROWSER_UI_RAC_MEDIA_SIDEBAR_MEDIA_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/ui/rac/media/sidebar_media_model.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/media_session/public/cpp/media_position.h"
+#include "services/media_session/public/mojom/audio_focus.mojom.h"
+#include "services/media_session/public/mojom/media_controller.mojom.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace rac {
+
+// The media playing in one profile, for the sidebar's media card. Each window
+// draws its own card from this shared model, so every window of the profile
+// shows the same controls. Incognito has its own instance.
+//
+// It watches the profile's audio focus directly, the way Chromium's
+// MediaSessionItemProducer does, but owns its own media controllers. It never
+// touches the toolbar's media dialog or its items.
+//
+// The first sidebar creates it. With no media it holds one audio focus
+// observer and nothing else; per-session controllers, artwork, and timers
+// exist only while a session does.
+class SidebarMedia : public KeyedService,
+                     public media_session::mojom::AudioFocusObserver {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // The shown session, what its card shows, or its artwork changed. A new
+    // position alone while it plays doesn't count: read GetShownPosition()
+    // when the progress line moves.
+    virtual void OnSidebarMediaChanged() = 0;
+    // The profile is shutting down. Drop the pointer to the service.
+    virtual void OnSidebarMediaShutdown() = 0;
+  };
+
+  // What a window's card draws.
+  struct Card {
+    Card();
+    Card(const Card&);
+    Card& operator=(const Card&);
+    ~Card();
+
+    sidebar_media::CardState state;
+    std::optional<media_session::MediaPosition> position;
+    // Null when the page has none.
+    gfx::ImageSkia artwork;
+    gfx::ImageSkia favicon;
+  };
+
+  // How the service reaches the media session service and the tabs. The
+  // factory fills these in from content; tests use an in-process service.
+  struct Bindings {
+    Bindings();
+    Bindings(Bindings&&);
+    Bindings& operator=(Bindings&&);
+    ~Bindings();
+
+    // The profile's audio focus source: incognito and other profiles have
+    // their own.
+    base::UnguessableToken source_id;
+    base::OnceCallback<void(
+        mojo::PendingReceiver<media_session::mojom::AudioFocusManager>)>
+        bind_audio_focus;
+    // Called once, with the first session.
+    base::OnceCallback<void(
+        mojo::PendingReceiver<media_session::mojom::MediaControllerManager>)>
+        bind_controller_manager;
+    // Switches to the tab of the session with this request id.
+    base::RepeatingCallback<void(const base::UnguessableToken&)> raise;
+  };
+
+  explicit SidebarMedia(Bindings bindings);
+  SidebarMedia(const SidebarMedia&) = delete;
+  SidebarMedia& operator=(const SidebarMedia&) = delete;
+  ~SidebarMedia() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // The card to show, or nothing when no session should show.
+  std::optional<Card> GetCard() const;
+  // The shown session's latest position, for its progress line.
+  std::optional<media_session::MediaPosition> GetShownPosition() const;
+
+  // Act on the shown session.
+  void TogglePlayPause();
+  void PreviousTrack();
+  void NextTrack();
+  // Switches to the session's tab and window.
+  void Raise();
+  // Stops the shown session, as the toolbar's dismiss does, and hides it
+  // until it plays again.
+  void Dismiss();
+
+  size_t SessionCountForTesting() const { return sessions_.size(); }
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  class Session;
+
+  // media_session::mojom::AudioFocusObserver:
+  void OnFocusGained(
+      media_session::mojom::AudioFocusRequestStatePtr state) override;
+  void OnFocusLost(
+      media_session::mojom::AudioFocusRequestStatePtr state) override;
+  void OnRequestIdReleased(const base::UnguessableToken& request_id) override;
+
+  void OnReceivedFocusRequests(
+      std::vector<media_session::mojom::AudioFocusRequestStatePtr> requests);
+  mojo::Remote<media_session::mojom::MediaController> CreateController(
+      const base::UnguessableToken& request_id);
+  void RemoveSession(const base::UnguessableToken& request_id);
+
+  // Called by sessions when anything about them changes.
+  void OnSessionChanged();
+  // Picks the session to show and tells the windows.
+  void Update();
+  Session* GetShownSession() const;
+
+  base::OnceCallback<void(
+      mojo::PendingReceiver<media_session::mojom::MediaControllerManager>)>
+      bind_controller_manager_;
+  base::RepeatingCallback<void(const base::UnguessableToken&)> raise_;
+  mojo::Remote<media_session::mojom::AudioFocusManager> audio_focus_;
+  mojo::Receiver<media_session::mojom::AudioFocusObserver>
+      audio_focus_observer_{this};
+  // Bound with the first session.
+  mojo::Remote<media_session::mojom::MediaControllerManager>
+      controller_manager_;
+  std::map<base::UnguessableToken, std::unique_ptr<Session>> sessions_;
+  std::optional<base::UnguessableToken> shown_;
+  // What the windows were last told, so changes that don't show are
+  // dropped. Null `shown_card_` means no card.
+  std::optional<Card> shown_card_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<SidebarMedia> weak_factory_{this};
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_MEDIA_SIDEBAR_MEDIA_H_

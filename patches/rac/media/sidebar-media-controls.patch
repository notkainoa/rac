+
+void SidebarMediaCard::Update() {
+  std::optional<SidebarMedia::Card> card =
+      media_ ? media_->GetCard() : std::nullopt;
+  if (!card) {
+    position_.reset();
+    state_ = sidebar_media::CardState();
+    playing_ = false;
+    has_progress_ = false;
+    artwork_ = gfx::ImageSkia();
+    favicon_ = gfx::ImageSkia();
+    SetVisible(false);
+    UpdateProgressTimer();
+    return;
+  }
+
+  const sidebar_media::CardState& state = card->state;
+  if (GetVisible() && state_ == state && SameImage(artwork_, card->artwork) &&
+      SameImage(favicon_, card->favicon)) {
+    // Only the position moved, as after a seek: just the line redraws.
+    position_ = card->position;
+    SchedulePaintInRect(GetMirroredRect(progress_bounds_));
+    UpdateProgressTimer();
+    return;
+  }
+  state_ = state;
+  title_->SetText(state.title);
+  subtitle_->SetText(state.subtitle);
+  subtitle_->SetVisible(!state.subtitle.empty());
+  dismiss_->SetVisible(state.show_dismiss);
+  previous_->SetVisible(state.show_previous);
+  next_->SetVisible(state.show_next);
+  play_pause_->SetVisible(state.show_play_pause);
+  if (play_pause_shows_pause_ != state.playing) {
+    play_pause_shows_pause_ = state.playing;
+    // Every control is a ControlButton.
+    static_cast<ControlButton*>(play_pause_.get())
+        ->SetIcon(
+            state.playing ? vector_icons::kPauseFilledIcon
+                          : vector_icons::kPlayArrowFilledFlippableIcon,
+            kPlayIconSize,
+            state.playing
+                ? IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_PAUSE
+                : IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_PLAY);
+  }
+
+  const std::u16string name =
+      state.subtitle.empty()
+          ? state.title
+          : l10n_util::GetStringFUTF16(IDS_CONCAT_TWO_STRINGS_WITH_COMMA,
+                                       state.title, state.subtitle);
+  SetTooltipText(name);
+  // The role was set in the constructor; the name is never empty here.
+  GetViewAccessibility().SetName(name);
+
+  playing_ = state.playing;
+  has_progress_ = state.has_progress;
+  position_ = card->position;
+  artwork_ = card->artwork;
+  favicon_ = card->favicon;
+
+  // Text and visibility changes lay the card out again on their own. The
+  // artwork and the progress line need a paint.
+  SetVisible(true);
+  SchedulePaint();
+  UpdateProgressTimer();
+}
+
+bool SidebarMediaCard::IsCardDrawn() const {
+  const views::Widget* widget = GetWidget();
+  // IsVisibleOnScreen() is false for a window on another macOS Space, a
+  // minimized one, and one that other windows cover completely.
+  return widget && widget->IsVisibleOnScreen() && !widget->IsMinimized() &&
+         IsDrawn() && !GetVisibleBounds().IsEmpty();
+}
+
+void SidebarMediaCard::UpdateProgressTimer() {
+  if (!sidebar_media::ShouldRunProgressTimer(IsCardDrawn(), playing_, position_,
+                                             base::TimeTicks::Now())) {
+    progress_timer_.Stop();
+    return;
+  }
+  const base::TimeDelta interval =
+      sidebar_media::ProgressInterval(*position_, progress_bounds_.width());
+  if (progress_timer_.IsRunning() &&
+      progress_timer_.GetCurrentDelay() == interval) {
+    return;
+  }
+  if (!progress_timer_.IsRunning()) {
+    // Catch up at once: the line didn't move while it was out of sight.
+    SchedulePaintInRect(GetMirroredRect(progress_bounds_));
+  }
+  progress_timer_.Start(FROM_HERE, interval,
+                        base::BindRepeating(&SidebarMediaCard::OnProgressTick,
+                                            base::Unretained(this)));
+}
+
+void SidebarMediaCard::OnProgressTick() {
+  // The service doesn't send new positions while the media plays; read the
+  // latest one here.
+  if (media_) {
+    position_ = media_->GetShownPosition();
+  }
+  // Only the line repaints.
+  SchedulePaintInRect(GetMirroredRect(progress_bounds_));
+  // Stops once the line is full, or if something hid the card without
+  // telling it, such as a clipping parent.
+  UpdateProgressTimer();
+}
+
+gfx::Rect SidebarMediaCard::GetFillBounds() const {
+  gfx::Rect fill = GetLocalBounds();
+  fill.Inset(gfx::Insets::VH(kOuterInset, 0));
+  return fill;
+}
+
+void SidebarMediaCard::PaintArtwork(gfx::Canvas* canvas,
+                                    const ui::ColorProvider& colors) {
+  if (artwork_bounds_.IsEmpty()) {
+    return;
+  }
+  // Layout() works in left-to-right terms, as child bounds do; painting
+  // mirrors them for right-to-left languages itself.
+  const gfx::Rect bounds = GetMirroredRect(artwork_bounds_);
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->ClipPath(
+      SkPath::RRect(gfx::RectToSkRect(bounds), kArtworkRadius, kArtworkRadius),
+      /*do_anti_alias=*/true);
+  if (!artwork_.isNull()) {
+    // Fill the square, cropping the longer side.
+    const int side = std::min(artwork_.width(), artwork_.height());
+    canvas->DrawImageInt(artwork_, (artwork_.width() - side) / 2,
+                         (artwork_.height() - side) / 2, side, side, bounds.x(),
+                         bounds.y(), bounds.width(), bounds.height(),
+                         /*filter=*/true);
+    return;
+  }
+  // No artwork: the site's icon on a tile, or a speaker without one.
+  cc::PaintFlags flags;
+  flags.setColor(colors.GetColor(kColorRacTabBackgroundUnselected));
+  canvas->DrawRect(bounds, flags);
+  const gfx::ImageSkia icon =
+      favicon_.isNull() ? gfx::CreateVectorIcon(
+                              vector_icons::kVolumeUpIcon, kFallbackIconSize,
+                              colors.GetColor(kColorRacTextSecondary))
+                        : favicon_;
+  const gfx::Rect icon_bounds(
+      bounds.x() + (kArtworkSize - kFallbackIconSize) / 2,
+      bounds.y() + (kArtworkSize - kFallbackIconSize) / 2, kFallbackIconSize,
+      kFallbackIconSize);
+  canvas->DrawImageInt(icon, 0, 0, icon.width(), icon.height(), icon_bounds.x(),
+                       icon_bounds.y(), icon_bounds.width(),
+                       icon_bounds.height(), /*filter=*/true);
+}
+
+void SidebarMediaCard::PaintProgress(gfx::Canvas* canvas,
+                                     const ui::ColorProvider& colors) {
+  if (!has_progress_ || !position_ || progress_bounds_.IsEmpty()) {
+    return;
+  }
+  const double fraction =
+      sidebar_media::ProgressAt(*position_, playing_, base::TimeTicks::Now());
+  const float radius = kProgressHeight / 2.0f;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  const SkColor track = colors.GetColor(kColorRacTextTertiary);
+  flags.setColor(SkColorSetA(track, SkColorGetA(track) / 2));
+  const gfx::RectF line(GetMirroredRect(progress_bounds_));
+  canvas->DrawRoundRect(line, radius, flags);
+  gfx::RectF done = line;
+  done.set_width(line.width() * fraction);
+  if (done.width() <= 0) {
+    return;
+  }
+  // Right-to-left languages fill the line from the right.
+  if (base::i18n::IsRTL()) {
+    done.set_x(line.right() - done.width());
+  }
+  flags.setColor(colors.GetColor(kColorRacTextSecondary));
+  canvas->DrawRoundRect(done, radius, flags);
+}
+
+BEGIN_METADATA(SidebarMediaCard)
+END_METADATA
+
+}  // namespace rac

+              card->media_->Raise();
+            }
+          },
+          base::Unretained(this))) {
+  // The role goes first: naming a view that has no role fails a DCHECK.
+  GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+  GetViewAccessibility().SetDescription(
+      l10n_util::GetStringUTF16(IDS_GLOBAL_MEDIA_CONTROLS_BACK_TO_TAB));
+  SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  views::InstallRoundRectHighlightPathGenerator(
+      this, gfx::Insets::VH(kOuterInset, 0), tokens::kRadiusControl);
+
+  title_ = AddChildView(std::make_unique<views::Label>());
+  title_->SetFontList(GetFont(tokens::kFontSizeRow, gfx::Font::Weight::MEDIUM));
+  ConfigureLabel(title_, kColorRacTextPrimary);
+  subtitle_ = AddChildView(std::make_unique<views::Label>());
+  subtitle_->SetFontList(
+      GetFont(tokens::kFontSizeSecondary, gfx::Font::Weight::NORMAL));
+  ConfigureLabel(subtitle_, kColorRacTextSecondary);
+
+  // Focus moves through the controls in the order they're added.
+  auto dismiss =
+      std::make_unique<ControlButton>(base::BindRepeating(
+                                          [](SidebarMediaCard* card) {
+                                            if (card->media_) {
+                                              card->media_->Dismiss();
+                                            }
+                                          },
+                                          base::Unretained(this)),
+                                      kDismissSize);
+  dismiss->SetIcon(vector_icons::kCloseSmallIcon, kDismissIconSize,
+                   IDS_GLOBAL_MEDIA_CONTROLS_DISMISS_ICON_TOOLTIP_TEXT);
+  dismiss_ = AddChildView(std::move(dismiss));
+
+  auto previous =
+      std::make_unique<ControlButton>(base::BindRepeating(
+                                          [](SidebarMediaCard* card) {
+                                            if (card->media_) {
+                                              card->media_->PreviousTrack();
+                                            }
+                                          },
+                                          base::Unretained(this)),
+                                      kControlSize);
+  previous->SetIcon(
+      vector_icons::kSkipPreviousIcon, kControlIconSize,
+      IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_PREVIOUS_TRACK);
+  previous_ = AddChildView(std::move(previous));
+
+  play_pause_ = AddChildView(
+      std::make_unique<ControlButton>(base::BindRepeating(
+                                          [](SidebarMediaCard* card) {
+                                            if (card->media_) {
+                                              card->media_->TogglePlayPause();
+                                            }
+                                          },
+                                          base::Unretained(this)),
+                                      kControlSize));
+
+  auto next = std::make_unique<ControlButton>(base::BindRepeating(
+                                                  [](SidebarMediaCard* card) {
+                                                    if (card->media_) {
+                                                      card->media_->NextTrack();
+                                                    }
+                                                  },
+                                                  base::Unretained(this)),
+                                              kControlSize);
+  next->SetIcon(vector_icons::kSkipNextIcon, kControlIconSize,
+                IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_NEXT_TRACK);
+  next_ = AddChildView(std::move(next));
+
+  media_ = SidebarMediaFactory::GetForProfile(profile);

Index: src/chrome/browser/ui/rac/media/rac_media_controls.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/ui/rac/media/rac_media_controls.cc	2026-11-07 23:46:13.680255223 -0800
@@ -0,0 +1,198 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/media/rac_media_controls.h"
+
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/global_media_controls/media_notification_service.h"
+#include "chrome/browser/ui/global_media_controls/media_notification_service_factory.h"
+#include "components/global_media_controls/public/media_item_manager.h"
+
+namespace rac {
+
+RacMediaControls::RacMediaControls(Profile* profile) : profile_(profile) {}
+
+RacMediaControls::~RacMediaControls() = default;
+
+void RacMediaControls::AddDisplay(Display* display) {
+  if (displays_.empty() && !manager_observation_.IsObserving()) {
+    manager_observation_.Observe(manager());
+  }
+  displays_.insert(display);
+  if (!active_display_) {
+    active_display_ = display;
+    RepopulateActiveDisplay();
+  }
+  MaybeUpdateRegistration();
+}
+
+void RacMediaControls::RemoveDisplay(Display* display) {
+  const bool was_active = active_display_ == display;
+  displays_.erase(display);
+  if (was_active) {
+    active_display_ = displays_.empty() ? nullptr : *displays_.begin();
+    if (active_display_) {
+      RepopulateActiveDisplay();
+    }
+  }
+  if (displays_.empty()) {
+    manager_observation_.Reset();
+  }
+  MaybeUpdateRegistration();
+}
+
+void RacMediaControls::SetActiveDisplay(Display* display) {
+  if (active_display_ == display || !displays_.contains(display)) {
+    return;
+  }
+  // The old display's views hold the item bindings, so they must go before
+  // the new display's are built.
+  ClearActiveDisplay();
+  active_display_ = display;
+  RepopulateActiveDisplay();
+}
+
+void RacMediaControls::Shutdown() {
+  shutting_down_ = true;
+  ClearActiveDisplay();
+  displays_.clear();
+  active_display_ = nullptr;
+  items_.clear();
+  manager_observation_.Reset();
+  if (delegate_registered_) {
+    // Direct unregister: no more updates after this.
+    in_set_delegate_ = true;
+    manager_->SetDialogDelegate(nullptr);
+    in_set_delegate_ = false;
+    delegate_registered_ = false;
+  }
+  manager_ = nullptr;
+}
+
+global_media_controls::MediaItemUI* RacMediaControls::ShowMediaItem(
+    const std::string& id,
+    base::WeakPtr<media_message_center::MediaNotificationItem> item) {
+  items_[id] = item;
+  if (!active_display_) {
+    return nullptr;
+  }
+  return active_display_->ShowMediaItem(id, item);
+}
+
+void RacMediaControls::HideMediaItem(const std::string& id) {
+  items_.erase(id);
+  if (active_display_) {
+    active_display_->HideMediaItem(id);
+  }
+  if (items_.empty()) {
+    MaybeUpdateRegistration();
+  }
+}
+
+void RacMediaControls::RefreshMediaItem(
+    const std::string& id,
+    base::WeakPtr<media_message_center::MediaNotificationItem> item) {
+  items_[id] = item;
+  if (active_display_) {
+    active_display_->RefreshMediaItem(id, item);
+  }
+}
+
+void RacMediaControls::HideMediaDialog() {
+  // Another surface (the toolbar dialog, a cast handoff) wants the items'
+  // one display. Drop ours until the item list next changes.
+  hidden_until_items_change_ = true;
+  items_.clear();
+  ClearActiveDisplay();
+  MaybeUpdateRegistration();
+}
+
+void RacMediaControls::Focus() {}
+
+void RacMediaControls::OnItemListChanged() {
+  hidden_until_items_change_ = false;
+  MaybeUpdateRegistration();
+}
+
+void RacMediaControls::OnMediaDialogOpened() {
+  // The media toolbar's bubble or a presentation dialog took the delegate
+  // slot. The display keeps its last views; a refresh on close restores
+  // them.
+  if (!in_set_delegate_) {
+    delegate_registered_ = false;
+  }
+}
+
+void RacMediaControls::OnMediaDialogClosed() {
+  MaybeUpdateRegistration();
+}
+
+global_media_controls::MediaItemManager* RacMediaControls::manager() {
+  if (!manager_ && !shutting_down_) {
+    manager_ = MediaNotificationServiceFactory::GetForProfile(profile_)
+                   ->media_item_manager();
+  }
+  return manager_;
+}
+
+void RacMediaControls::MaybeUpdateRegistration() {
+  if (update_pending_ || shutting_down_) {
+    return;
+  }
+  update_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RacMediaControls::UpdateRegistration,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void RacMediaControls::UpdateRegistration() {
+  update_pending_ = false;
+  if (shutting_down_) {
+    return;
+  }
+  const bool want = active_display_ && manager() &&
+                    manager_->HasActiveItems() && !hidden_until_items_change_;
+  if (want && !delegate_registered_ && !manager_->HasOpenDialog()) {
+    RegisterDelegate();
+  } else if (!want && delegate_registered_) {
+    UnregisterDelegate();
+  }
+}
+
+void RacMediaControls::RegisterDelegate() {
+  // Drop stale item views before the manager re-sends ShowMediaItem.
+  items_.clear();
+  ClearActiveDisplay();
+  in_set_delegate_ = true;
+  manager_->SetDialogDelegate(this);
+  in_set_delegate_ = false;
+  delegate_registered_ = true;
+}
+
+void RacMediaControls::UnregisterDelegate() {
+  in_set_delegate_ = true;
+  manager_->SetDialogDelegate(nullptr);
+  in_set_delegate_ = false;
+  delegate_registered_ = false;
+}
+
+void RacMediaControls::RepopulateActiveDisplay() {
+  if (!active_display_ || !delegate_registered_) {
+    return;
+  }
+  for (const auto& [id, item] : items_) {
+    if (item) {
+      active_display_->ShowMediaItem(id, item);
+    }
+  }
+}
+
+void RacMediaControls::ClearActiveDisplay() {
+  if (active_display_) {
+    active_display_->ClearMediaItems();
+  }
+}
+
+}  // namespace rac

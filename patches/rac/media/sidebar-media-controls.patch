+#ifndef CHROME_BROWSER_UI_RAC_MEDIA_RAC_MEDIA_CONTROLS_FACTORY_H_
+#define CHROME_BROWSER_UI_RAC_MEDIA_RAC_MEDIA_CONTROLS_FACTORY_H_
+
+#include <memory>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile_keyed_service_factory.h"
+
+class Profile;
+
+namespace rac {
+
+class RacMediaControls;
+
+// Lazy per-profile service: incognito windows get their own, matching
+// MediaNotificationService's own-instance selection, so an incognito
+// sidebar shows only incognito media.
+class RacMediaControlsFactory : public ProfileKeyedServiceFactory {
+ public:
+  static RacMediaControls* GetForProfile(Profile* profile);
+  static RacMediaControlsFactory* GetInstance();
+
+ private:
+  friend base::NoDestructor<RacMediaControlsFactory>;
+
+  RacMediaControlsFactory();
+  ~RacMediaControlsFactory() override;
+
+  // ProfileKeyedServiceFactory:
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+  bool ServiceIsCreatedWithBrowserContext() const override;
+  bool ServiceIsNULLWhileTesting() const override;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_MEDIA_RAC_MEDIA_CONTROLS_FACTORY_H_

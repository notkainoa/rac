+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//testing/test.gni")
+
+assert(!is_android)
+
+# The rules behind the sidebar's media card. Apart from mojo and views so
+# they can be tested without a browser.
+source_set("model") {
+  sources = [
+    "sidebar_media_model.cc",
+    "sidebar_media_model.h",
+  ]
+  public_deps = [
+    "//base",
+    "//services/media_session/public/cpp:base_cpp",
+  ]
+}
+
+# The profile's media sessions, as the sidebar's media card sees them. It
+# reaches content only through SidebarMedia::Bindings, so tests can run it
+# against an in-process media session service.
+source_set("service") {
+  sources = [
+    "sidebar_media.cc",
+    "sidebar_media.h",
+  ]
+  public_deps = [
+    ":model",
+    "//base",
+    "//components/keyed_service/core",
+    "//mojo/public/cpp/bindings",
+    "//services/media_session/public/mojom",
+    "//ui/gfx",
+  ]
+  deps = [
+    "//services/media_session/public/cpp",
+    "//skia",
+  ]
+}
+
+# One SidebarMedia per profile, bound to content's media session service.
+source_set("media") {
+  sources = [
+    "sidebar_media_factory.cc",
+    "sidebar_media_factory.h",
+  ]
+  public_deps = [
+    ":service",
+    "//chrome/browser/profiles:profile",
+  ]
+  deps = [
+    "//content/public/browser",
+    "//services/media_session/public/cpp",
+  ]
+}
+
+# Build with `autoninja -C out/Default
+# chrome/browser/ui/rac/media:rac_media_unittests`. It's separate from
+# Chromium's unit_tests, which takes hours to build.
+test("rac_media_unittests") {
+  sources = [
+    "sidebar_media_model_unittest.cc",
+    "sidebar_media_unittest.cc",
+  ]
+  deps = [
+    ":model",
+    ":service",
+    "//base",
+    "//base/test:test_support",
+    "//mojo/core/test:run_all_unittests",
+    "//mojo/public/cpp/bindings",
+    "//services/media_session:lib",
+    "//services/media_session/public/cpp",
+    "//services/media_session/public/cpp:base_cpp",
+    "//services/media_session/public/cpp/test:test_support",
+    "//services/media_session/public/mojom",
+    "//testing/gtest",
+  ]
+}
Index: src/chrome/browser/ui/rac/media/sidebar_media.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/rac/media/sidebar_media.cc
@@ -0,0 +1,468 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/media/sidebar_media.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/favicon_size.h"
+
+namespace rac {
+
+namespace {
+
+using media_session::mojom::MediaSessionAction;
+using media_session::mojom::MediaSessionImageType;
+
+// The card's thumbnail is 32 DIPs; this covers 2x screens.
+constexpr int kArtworkMinSizePx = 32;
+constexpr int kArtworkDesiredSizePx = 64;
+constexpr int kFaviconDesiredSizePx = 32;
+
+bool HasAction(const std::vector<MediaSessionAction>& actions,
+               MediaSessionAction action) {
+  return std::ranges::find(actions, action) != actions.end();
+}
+
+bool SameImage(const gfx::ImageSkia& a, const gfx::ImageSkia& b) {
+  return a.isNull() ? b.isNull() : a.BackedBySameObjectAs(b);
+}
+
+// Whether the windows' cards must redraw. See sidebar_media::NeedsRedraw.
+bool NeedsNotify(const std::optional<SidebarMedia::Card>& before,
+                 const std::optional<SidebarMedia::Card>& after) {
+  if (!before || !after) {
+    return before.has_value() != after.has_value();
+  }
+  return !SameImage(before->artwork, after->artwork) ||
+         !SameImage(before->favicon, after->favicon) ||
+         sidebar_media::NeedsRedraw(before->state, after->state,
+                                    before->position, after->position,
+                                    base::TimeTicks::Now());
+}
+
+// How long a session that lost audio focus keeps its card, in case it gets
+// focus back, as some sites do between tracks.
+constexpr base::TimeDelta kFocusLossGrace = base::Seconds(2);
+
+}  // namespace
+
+// One of the profile's media sessions, seen through a media controller bound
+// to it alone.
+class SidebarMedia::Session
+    : public media_session::mojom::MediaControllerObserver,
+      public media_session::mojom::MediaControllerImageObserver {
+ public:
+  // `remove` drops this session from `owner`.
+  Session(SidebarMedia* owner,
+          base::RepeatingClosure remove,
+          mojo::Remote<media_session::mojom::MediaController> controller,
+          const media_session::mojom::MediaSessionInfoPtr& info)
+      : owner_(owner), remove_(std::move(remove)) {
+    snapshot_.last_active = base::TimeTicks::Now();
+    ApplyInfo(info);
+    SetController(std::move(controller));
+  }
+  Session(const Session&) = delete;
+  Session& operator=(const Session&) = delete;
+  ~Session() override = default;
+
+  const sidebar_media::SessionSnapshot& snapshot() const { return snapshot_; }
+  const gfx::ImageSkia& artwork() const { return artwork_; }
+  const gfx::ImageSkia& favicon() const { return favicon_; }
+
+  media_session::mojom::MediaController* controller() {
+    return controller_.is_bound() ? controller_.get() : nullptr;
+  }
+
+  // Images are fetched only once the session has been shown.
+  void WantImages() {
+    if (wants_images_) {
+      return;
+    }
+    wants_images_ = true;
+    if (controller_.is_bound()) {
+      ObserveImages();
+    }
+  }
+
+  void Dismiss() { snapshot_.dismissed = true; }
+
+  // Losing focus closes the controller with the focus request. The card
+  // stays for a moment in case focus comes back.
+  void OnFocusLost() {
+    has_focus_ = false;
+    removal_timer_.Start(FROM_HERE, kFocusLossGrace, remove_);
+  }
+
+  // Gaining focus again needs a new controller. A session that kept focus
+  // hears OnFocusGained on every resume; that changes nothing here.
+  bool has_focus() const { return has_focus_; }
+  void OnFocusRegained(
+      mojo::Remote<media_session::mojom::MediaController> controller) {
+    has_focus_ = true;
+    removal_timer_.Stop();
+    SetController(std::move(controller));
+  }
+
+  // media_session::mojom::MediaControllerObserver:
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr info) override {
+    // Null when the controller lost its session. Keep the last state until
+    // the session is removed.
+    if (!info) {
+      return;
+    }
+    ApplyInfo(info);
+    owner_->OnSessionChanged();
+  }
+
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>& metadata) override {
+    snapshot_.title = metadata ? metadata->title : std::u16string();
+    snapshot_.artist = metadata ? metadata->artist : std::u16string();
+    snapshot_.source_title =
+        metadata ? metadata->source_title : std::u16string();
+    owner_->OnSessionChanged();
+  }
+
+  void MediaSessionActionsChanged(
+      const std::vector<MediaSessionAction>& actions) override {
+    snapshot_.can_play_pause = HasAction(actions, MediaSessionAction::kPlay) ||
+                               HasAction(actions, MediaSessionAction::kPause);
+    snapshot_.can_previous =
+        HasAction(actions, MediaSessionAction::kPreviousTrack);
+    snapshot_.can_next = HasAction(actions, MediaSessionAction::kNextTrack);
+    owner_->OnSessionChanged();
+  }
+
+  void MediaSessionChanged(
+      const std::optional<base::UnguessableToken>& request_id) override {}
+
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>& position) override {
+    snapshot_.position = position;
+    owner_->OnSessionChanged();
+  }
+
+  // media_session::mojom::MediaControllerImageObserver:
+  void MediaControllerImageChanged(MediaSessionImageType type,
+                                   const SkBitmap& bitmap) override {
+    gfx::ImageSkia image = bitmap.drawsNothing()
+                               ? gfx::ImageSkia()
+                               : gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+    if (type == MediaSessionImageType::kArtwork) {
+      artwork_ = std::move(image);
+    } else if (type == MediaSessionImageType::kSourceIcon) {
+      favicon_ = std::move(image);
+    } else {
+      return;
+    }
+    owner_->OnSessionChanged();
+  }
+
+  void MediaControllerChapterImageChanged(int32_t index,
+                                          const SkBitmap& bitmap) override {}
+
+ private:
+  void ApplyInfo(const media_session::mojom::MediaSessionInfoPtr& info) {
+    if (!info) {
+      return;
+    }
+    const bool playing = info->playback_state ==
+                         media_session::mojom::MediaPlaybackState::kPlaying;
+    if (playing && !snapshot_.playing) {
+      snapshot_.last_active = base::TimeTicks::Now();
+      snapshot_.dismissed = false;
+    }
+    snapshot_.playing = playing;
+    snapshot_.controllable = info->is_controllable;
+    snapshot_.hide_metadata = info->hide_metadata;
+  }
+
+  void SetController(
+      mojo::Remote<media_session::mojom::MediaController> controller) {
+    observer_receiver_.reset();
+    artwork_receiver_.reset();
+    favicon_receiver_.reset();
+    controller_ = std::move(controller);
+    if (!controller_.is_bound()) {
+      return;
+    }
+    // A controller closes with its focus request. If the focus events raced
+    // ahead of it (a request listed at startup that had already ended, or a
+    // loss that arrived first), treat the closing as the loss, so the next
+    // gain binds a new controller and a session that never comes back goes.
+    // Unretained: this owns the remote.
+    controller_.set_disconnect_handler(base::BindOnce(
+        &Session::OnControllerDisconnected, base::Unretained(this)));
+    // Adding the observer sends the current state at once.
+    controller_->AddObserver(observer_receiver_.BindNewPipeAndPassRemote());
+    if (wants_images_) {
+      ObserveImages();
+    }
+  }
+
+  void OnControllerDisconnected() {
+    if (has_focus_) {
+      OnFocusLost();
+    }
+  }
+
+  void ObserveImages() {
+    controller_->ObserveImages(MediaSessionImageType::kArtwork,
+                               kArtworkMinSizePx, kArtworkDesiredSizePx,
+                               artwork_receiver_.BindNewPipeAndPassRemote());
+    controller_->ObserveImages(MediaSessionImageType::kSourceIcon,
+                               gfx::kFaviconSize, kFaviconDesiredSizePx,
+                               favicon_receiver_.BindNewPipeAndPassRemote());
+  }
+
+  const raw_ptr<SidebarMedia> owner_;
+  const base::RepeatingClosure remove_;
+  sidebar_media::SessionSnapshot snapshot_;
+  gfx::ImageSkia artwork_;
+  gfx::ImageSkia favicon_;
+  bool wants_images_ = false;
+  bool has_focus_ = true;
+  base::OneShotTimer removal_timer_;
+  mojo::Remote<media_session::mojom::MediaController> controller_;
+  mojo::Receiver<media_session::mojom::MediaControllerObserver>
+      observer_receiver_{this};
+  mojo::Receiver<media_session::mojom::MediaControllerImageObserver>
+      artwork_receiver_{this};
+  mojo::Receiver<media_session::mojom::MediaControllerImageObserver>
+      favicon_receiver_{this};
+};
+
+SidebarMedia::Card::Card() = default;
+SidebarMedia::Card::Card(const Card&) = default;
+SidebarMedia::Card& SidebarMedia::Card::operator=(const Card&) = default;
+SidebarMedia::Card::~Card() = default;
+
+SidebarMedia::Bindings::Bindings() = default;
+SidebarMedia::Bindings::Bindings(Bindings&&) = default;
+SidebarMedia::Bindings& SidebarMedia::Bindings::operator=(Bindings&&) = default;
+SidebarMedia::Bindings::~Bindings() = default;
+
+SidebarMedia::SidebarMedia(Bindings bindings)
+    : bind_controller_manager_(std::move(bindings.bind_controller_manager)),
+      raise_(std::move(bindings.raise)) {
+  std::move(bindings.bind_audio_focus)
+      .Run(audio_focus_.BindNewPipeAndPassReceiver());
+  // Only this profile's sessions: incognito and other profiles have their
+  // own source ids.
+  audio_focus_->AddSourceObserver(
+      bindings.source_id, audio_focus_observer_.BindNewPipeAndPassRemote());
+  audio_focus_->GetSourceFocusRequests(
+      bindings.source_id, base::BindOnce(&SidebarMedia::OnReceivedFocusRequests,
+                                         weak_factory_.GetWeakPtr()));
+}
+
+SidebarMedia::~SidebarMedia() = default;
+
+void SidebarMedia::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SidebarMedia::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+std::optional<SidebarMedia::Card> SidebarMedia::GetCard() const {
+  Session* session = GetShownSession();
+  if (!session) {
+    return std::nullopt;
+  }
+  Card card;
+  card.state = sidebar_media::MakeCardState(session->snapshot());
+  card.position = session->snapshot().position;
+  if (!session->snapshot().hide_metadata) {
+    card.artwork = session->artwork();
+  }
+  card.favicon = session->favicon();
+  return card;
+}
+
+void SidebarMedia::TogglePlayPause() {
+  Session* session = GetShownSession();
+  media_session::mojom::MediaController* controller =
+      session ? session->controller() : nullptr;
+  if (!controller) {
+    return;
+  }
+  if (session->snapshot().playing) {
+    controller->Suspend();
+  } else {
+    controller->Resume();
+  }
+}
+
+void SidebarMedia::PreviousTrack() {
+  Session* session = GetShownSession();
+  if (auto* controller = session ? session->controller() : nullptr) {
+    controller->PreviousTrack();
+  }
+}
+
+void SidebarMedia::NextTrack() {
+  Session* session = GetShownSession();
+  if (auto* controller = session ? session->controller() : nullptr) {
+    controller->NextTrack();
+  }
+}
+
+void SidebarMedia::Raise() {
+  if (shown_ && raise_) {
+    raise_.Run(*shown_);
+  }
+}
+
+void SidebarMedia::Dismiss() {
+  Session* session = GetShownSession();
+  if (!session) {
+    return;
+  }
+  session->Dismiss();
+  if (auto* controller = session->controller()) {
+    controller->Stop();
+  }
+  Update();
+}
+
+void SidebarMedia::Shutdown() {
+  weak_factory_.InvalidateWeakPtrs();
+  audio_focus_observer_.reset();
+  audio_focus_.reset();
+  sessions_.clear();
+  shown_.reset();
+  shown_card_.reset();
+  controller_manager_.reset();
+  observers_.Notify(&Observer::OnSidebarMediaShutdown);
+}
+
+void SidebarMedia::OnFocusGained(
+    media_session::mojom::AudioFocusRequestStatePtr state) {
+  if (!state || !state->request_id) {
+    return;
+  }
+  const base::UnguessableToken request_id = *state->request_id;
+  auto it = sessions_.find(request_id);
+  if (it != sessions_.end()) {
+    if (!it->second->has_focus()) {
+      it->second->OnFocusRegained(CreateController(request_id));
+    }
+    return;
+  }
+  // Unretained: this owns the session, and the session owns the timer and
+  // the remote that run it.
+  sessions_.emplace(request_id,
+                    std::make_unique<Session>(
+                        this,
+                        base::BindRepeating(&SidebarMedia::RemoveSession,
+                                            base::Unretained(this), request_id),
+                        CreateController(request_id), state->session_info));
+  Update();
+}
+
+void SidebarMedia::OnFocusLost(
+    media_session::mojom::AudioFocusRequestStatePtr state) {
+  if (!state || !state->request_id) {
+    return;
+  }
+  auto it = sessions_.find(*state->request_id);
+  if (it == sessions_.end()) {
+    return;
+  }
+  it->second->OnFocusLost();
+}
+
+void SidebarMedia::OnRequestIdReleased(
+    const base::UnguessableToken& request_id) {
+  // The tab closed.
+  RemoveSession(request_id);
+}
+
+void SidebarMedia::OnReceivedFocusRequests(
+    std::vector<media_session::mojom::AudioFocusRequestStatePtr> requests) {
+  for (auto& request : requests) {
+    OnFocusGained(std::move(request));
+  }
+}
+
+mojo::Remote<media_session::mojom::MediaController>
+SidebarMedia::CreateController(const base::UnguessableToken& request_id) {
+  if (!controller_manager_.is_bound() && bind_controller_manager_) {
+    std::move(bind_controller_manager_)
+        .Run(controller_manager_.BindNewPipeAndPassReceiver());
+  }
+  mojo::Remote<media_session::mojom::MediaController> controller;
+  controller_manager_->CreateMediaControllerForSession(
+      controller.BindNewPipeAndPassReceiver(), request_id);
+  return controller;
+}
+
+void SidebarMedia::RemoveSession(const base::UnguessableToken& request_id) {
+  if (sessions_.erase(request_id) == 0) {
+    return;
+  }
+  Update();
+}
+
+void SidebarMedia::OnSessionChanged() {
+  Update();
+}
+
+void SidebarMedia::Update() {
+  Session* best = nullptr;
+  std::optional<base::UnguessableToken> best_id;
+  for (const auto& [request_id, session] : sessions_) {
+    if (!sidebar_media::ShouldShow(session->snapshot())) {
+      continue;
+    }
+    if (!best ||
+        sidebar_media::ShowsBefore(session->snapshot(), best->snapshot())) {
+      best = session.get();
+      best_id = request_id;
+    }
+  }
+  shown_ = best_id;
+  if (best) {
+    best->WantImages();
+  }
+  std::optional<Card> card = GetCard();
+  const bool notify = NeedsNotify(shown_card_, card);
+  // Keep the newest position either way: it's what the next change is
+  // measured against.
+  shown_card_ = std::move(card);
+  if (notify) {
+    observers_.Notify(&Observer::OnSidebarMediaChanged);
+  }
+}
+
+std::optional<media_session::MediaPosition> SidebarMedia::GetShownPosition()
+    const {
+  Session* session = GetShownSession();
+  return session ? session->snapshot().position : std::nullopt;
+}
+
+SidebarMedia::Session* SidebarMedia::GetShownSession() const {
+  if (!shown_) {
+    return nullptr;
+  }
+  auto it = sessions_.find(*shown_);
+  return it == sessions_.end() ? nullptr : it->second.get();
+}
+
+}  // namespace rac

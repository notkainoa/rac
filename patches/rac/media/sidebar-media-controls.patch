+class Canvas;
+}  // namespace gfx
+
+namespace ui {
+class ColorProvider;
+}  // namespace ui
+
+namespace views {
+class ImageButton;
+class Label;
+}  // namespace views
+
+namespace rac {
+
+// The media card at the bottom of the sidebar: artwork, the title, the
+// artist or site, and play or pause, with previous and next when the page
+// offers them. Clicking it goes to the playing tab. Each window has its own
+// card, drawn from the profile's SidebarMedia.
+//
+// It's hidden while the profile has no media, and does no work then. Its
+// progress line moves once a second, and only while the card is drawn in a
+// visible, unminimized window.
+class SidebarMediaCard : public views::Button,
+                         public SidebarMedia::Observer,
+                         public views::WidgetObserver {
+  METADATA_HEADER(SidebarMediaCard, views::Button)
+
+ public:
+  explicit SidebarMediaCard(Profile* profile);
+  SidebarMediaCard(const SidebarMediaCard&) = delete;
+  SidebarMediaCard& operator=(const SidebarMediaCard&) = delete;
+  ~SidebarMediaCard() override;
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override;
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // SidebarMedia::Observer:
+  void OnSidebarMediaChanged() override;
+  void OnSidebarMediaShutdown() override;
+
+  // views::WidgetObserver:
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override;
+  void OnWidgetVisibilityOnScreenChanged(views::Widget* widget,
+                                         bool visible) override;
+  void OnWidgetShowStateChanged(views::Widget* widget) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  // Pulls the shown session from the service.
+  void Update();
+
+  // Whether anyone can see the card right now.
+  bool IsCardDrawn() const;
+  void UpdateProgressTimer();
+  void OnProgressTick();
+
+  gfx::Rect GetFillBounds() const;
+  void PaintArtwork(gfx::Canvas* canvas, const ui::ColorProvider& colors);
+  void PaintProgress(gfx::Canvas* canvas, const ui::ColorProvider& colors);
+
+  raw_ptr<SidebarMedia> media_ = nullptr;
+
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> subtitle_ = nullptr;
+  raw_ptr<views::ImageButton> dismiss_ = nullptr;
+  raw_ptr<views::ImageButton> previous_ = nullptr;
+  raw_ptr<views::ImageButton> play_pause_ = nullptr;
+  raw_ptr<views::ImageButton> next_ = nullptr;
+
+  // What the card shows now, to tell a new position from a new state.
+  sidebar_media::CardState state_;
+  gfx::ImageSkia artwork_;
+  gfx::ImageSkia favicon_;
+  std::optional<media_session::MediaPosition> position_;
+  bool playing_ = false;
+  bool has_progress_ = false;
+  // Which icon the play button has; unset until the first session.
+  std::optional<bool> play_pause_shows_pause_;
+
+  // Set by Layout().
+  gfx::Rect artwork_bounds_;
+  gfx::Rect progress_bounds_;
+
+  base::RepeatingTimer progress_timer_;
+
+  base::ScopedObservation<SidebarMedia, SidebarMedia::Observer>
+      media_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_MEDIA_SIDEBAR_MEDIA_CARD_H_

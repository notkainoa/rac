+}
+
+SidebarMediaCard::~SidebarMediaCard() = default;
+
+gfx::Size SidebarMediaCard::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int width = available_size.width().value_or(kMinCardWidth);
+  if (width < kMinCardWidth) {
+    return gfx::Size();
+  }
+  return gfx::Size(width, kCardHeight);
+}
+
+void SidebarMediaCard::Layout(PassKey) {
+  gfx::Rect content = GetFillBounds();
+  content.Inset(kPadding);
+
+  // Artwork, then the title and subtitle, then dismiss at the far edge.
+  artwork_bounds_ =
+      gfx::Rect(content.x(), content.y(), kArtworkSize, kArtworkSize);
+  int text_right = content.right();
+  if (dismiss_->GetVisible()) {
+    dismiss_->SetBounds(content.right() - kDismissSize,
+                        content.y() + (kArtworkSize - kDismissSize) / 2,
+                        kDismissSize, kDismissSize);
+    text_right = dismiss_->x() - tokens::kSpacing4;
+  }
+  const int text_x = artwork_bounds_.right() + kTextGap;
+  const int text_width = std::max(0, text_right - text_x);
+  const int title_height = title_->GetLineHeight();
+  const int subtitle_height =
+      subtitle_->GetVisible() ? subtitle_->GetLineHeight() : 0;
+  int text_y =
+      content.y() + (kArtworkSize - title_height - subtitle_height) / 2;
+  title_->SetBounds(text_x, text_y, text_width, title_height);
+  text_y += title_height;
+  subtitle_->SetBounds(text_x, text_y, text_width, subtitle_height);
+
+  // The controls, centered on the row below.
+  const int controls_y = artwork_bounds_.bottom() + kRowGap;
+  int controls_width = 0;
+  int controls_count = 0;
+  for (views::View* control :
+       {previous_.get(), play_pause_.get(), next_.get()}) {
+    if (control->GetVisible()) {
+      controls_width += kControlSize;
+      ++controls_count;
+    }
+  }
+  if (controls_count > 1) {
+    controls_width += (controls_count - 1) * kControlGap;
+  }
+  int control_x = content.x() + (content.width() - controls_width) / 2;
+  for (views::View* control :
+       {previous_.get(), play_pause_.get(), next_.get()}) {
+    if (control->GetVisible()) {
+      control->SetBounds(control_x, controls_y, kControlSize, kControlSize);
+      control_x += kControlSize + kControlGap;
+    }
+  }
+
+  progress_bounds_ =
+      gfx::Rect(content.x(), controls_y + kControlSize + kProgressGap,
+                content.width(), kProgressHeight);
+  // The tick interval depends on the line's length.
+  UpdateProgressTimer();
+}
+
+void SidebarMediaCard::PaintButtonContents(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  // Translucent sidebar colors, so the card sits on any space's tint.
+  const bool hovered =
+      GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(colors->GetColor(hovered ? kColorRacTabBackgroundHovered
+                                          : kColorRacTabBackgroundUnselected));
+  canvas->DrawRoundRect(GetFillBounds(), tokens::kRadiusControl, flags);
+  PaintArtwork(canvas, *colors);
+  PaintProgress(canvas, *colors);
+}
+
+void SidebarMediaCard::VisibilityChanged(views::View* starting_from,
+                                         bool is_visible) {
+  views::Button::VisibilityChanged(starting_from, is_visible);
+  // The card, or the hidden sidebar around it, showed or hid.
+  UpdateProgressTimer();
+}
+
+void SidebarMediaCard::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::Button::OnBoundsChanged(previous_bounds);

+// The card fills the sidebar's width. Below this, as in the sidebar
+// collapsed to icons, it takes no space.
+constexpr int kMinCardWidth = 120;
+// Space above and below the card's fill, inside its bounds, so it needs no
+// margins and takes no room when it's gone.
+constexpr int kOuterInset = tokens::kSpacing2;
+constexpr int kPadding = tokens::kSpacing8;
+constexpr int kArtworkSize = 32;
+constexpr int kArtworkRadius = tokens::kRadius6;
+constexpr int kFallbackIconSize = 16;
+constexpr int kTextGap = tokens::kSpacing8;
+constexpr int kRowGap = tokens::kSpacing6;
+constexpr int kControlSize = 24;
+constexpr int kControlIconSize = 16;
+constexpr int kPlayIconSize = 18;
+constexpr int kControlGap = tokens::kSpacing8;
+constexpr int kDismissSize = 20;
+constexpr int kDismissIconSize = 16;
+constexpr int kProgressGap = tokens::kSpacing6;
+constexpr int kProgressHeight = 2;
+// The height stays the same with or without a progress line, so the
+// sidebar doesn't jump when a live stream ends.
+constexpr int kCardHeight = 2 * kOuterInset + 2 * kPadding + kArtworkSize +
+                            kRowGap + kControlSize + kProgressGap +
+                            kProgressHeight;
+
+gfx::FontList GetFont(int size, gfx::Font::Weight weight) {
+  const gfx::FontList base;
+  return base.DeriveWithSizeDelta(size - base.GetFontSize())
+      .DeriveWithWeight(weight);
+}
+
+void ConfigureLabel(views::Label* label, ui::ColorId color) {
+  label->SetHorizontalAlignment(gfx::ALIGN_TO_HEAD);
+  label->SetElideBehavior(gfx::FADE_TAIL);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetBackgroundColor(SK_ColorTRANSPARENT);
+  label->SetSkipSubpixelRenderingOpacityCheck(true);
+  label->SetCanProcessEventsWithinSubtree(false);
+  label->SetEnabledColor(color);
+  // The card's own name already reads the title and subtitle.
+  label->GetViewAccessibility().SetIsIgnored(true);
+}
+
+bool SameImage(const gfx::ImageSkia& a, const gfx::ImageSkia& b) {
+  return a.isNull() ? b.isNull() : a.BackedBySameObjectAs(b);
+}
+
+// A round control on the card. Its hover fill is instant, like the
+// sidebar's rows, so nothing animates.
+class ControlButton : public views::ImageButton {
+  METADATA_HEADER(ControlButton, views::ImageButton)
+
+ public:
+  ControlButton(PressedCallback callback, int size)
+      : views::ImageButton(std::move(callback)), size_(size) {
+    SetImageHorizontalAlignment(ALIGN_CENTER);
+    SetImageVerticalAlignment(ALIGN_MIDDLE);
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    views::InstallCircleHighlightPathGenerator(this);
+  }
+
+  void SetIcon(const gfx::VectorIcon& icon, int icon_size, int name_id) {
+    SetImageModel(STATE_NORMAL, ui::ImageModel::FromVectorIcon(
+                                    icon, kColorRacTextPrimary, icon_size));
+    const std::u16string name = l10n_util::GetStringUTF16(name_id);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+  }
+
+  // views::ImageButton:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(size_, size_);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    if (GetState() == STATE_HOVERED || GetState() == STATE_PRESSED) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(
+          GetColorProvider()->GetColor(kColorRacTabBackgroundHovered));
+      canvas->DrawCircle(gfx::PointF(GetLocalBounds().CenterPoint()),
+                         size_ / 2.0f, flags);
+    }
+    views::ImageButton::PaintButtonContents(canvas);
+  }
+
+ private:
+  const int size_;
+};

+// A session-restored window gets its space back only once this load is done.
+// The browser holds BEST_EFFORT tasks until startup is complete, and then they
+// wait behind the post-startup backlog, so the load must not be one of them.
+TEST(SpacesStoreStartupTest, AsyncLoadRunsBeforeStartupCompletes) {
+  base::test::TaskEnvironment task_environment;
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::ScopedBestEffortExecutionFence startup_fence;
+  SpacesStore store(dir.GetPath());
+  base::test::TestFuture<void> ready;
+  store.LoadAsync(ready.GetCallback());
+  EXPECT_TRUE(ready.Wait());
+}

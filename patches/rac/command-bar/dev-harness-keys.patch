+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_DEV_NATIVE_KEYS_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_DEV_NATIVE_KEYS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/rac/dev/buildflags.h"
+
+static_assert(BUILDFLAG(RAC_DEV_SWITCHES),
+              "The screenshot harness's keys are for dev builds only.");
+
+namespace rac::dev {
+
+// One key of a US keyboard, for the screenshot harness's nspress and nstype
+// verbs, which post it as a native key event.
+struct NativeKey {
+  // A macOS virtual key code (kVK_* in Carbon's Events.h).
+  unsigned short key_code = 0;
+  // What the key types, with Shift applied.
+  std::u16string characters;
+  bool shift = false;
+};
+
+// The key named `name`: a-z, 0-9, return, escape, tab, space, backspace, up,
+// down, left, right, home, end, pageup, or pagedown. nullopt for any other.
+std::optional<NativeKey> NativeKeyNamed(std::string_view name);
+
+// The keys that type `text` (UTF-8) on a US keyboard: letters, digits, space,
+// and the punctuation printed on the keys. nullopt if a character has no key
+// there, such as "é" or an emoji; `unsupported` then holds the first one.
+std::optional<std::vector<NativeKey>> NativeKeysForText(
+    std::string_view text,
+    std::string* unsupported);
+
+}  // namespace rac::dev
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_DEV_NATIVE_KEYS_H_

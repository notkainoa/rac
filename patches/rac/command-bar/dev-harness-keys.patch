===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/rac/dev/native_keys.mm
@@ -0,0 +1,132 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/dev/native_keys.h"
+
+#import <AppKit/AppKit.h>
+
+#include <iterator>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_util.h"
+
+namespace rac::dev {
+
+namespace {
+
+// kVK_ANSI_A.. in Carbon's Events.h, in a-z order.
+constexpr unsigned short kLetters[] = {0,  11, 8,  2,  14, 3,  5,  4,  34,
+                                       38, 40, 37, 46, 45, 31, 35, 12, 15,
+                                       1,  17, 32, 9,  13, 7,  16, 6};
+// kVK_ANSI_0..9.
+constexpr unsigned short kDigits[] = {29, 18, 19, 20, 21, 23, 22, 26, 28, 25};
+
+// The punctuation keys, each with what it types without and with Shift.
+struct PunctuationKey {
+  unsigned short key_code;
+  char plain;
+  char shifted;
+};
+constexpr PunctuationKey kPunctuation[] = {
+    {50, '`', '~'}, {27, '-', '_'},  {24, '=', '+'}, {33, '[', '{'},
+    {30, ']', '}'}, {42, '\\', '|'}, {41, ';', ':'}, {39, '\'', '"'},
+    {43, ',', '<'}, {47, '.', '>'},  {44, '/', '?'},
+};
+// What the digit keys type with Shift, from 0 to 9.
+constexpr char kShiftedDigits[] = ")!@#$%^&*(";
+
+NativeKey Key(unsigned short key_code, char16_t c, bool shift = false) {
+  return NativeKey{key_code, std::u16string(1, c), shift};
+}
+
+std::optional<NativeKey> KeyForCharacter(char c) {
+  if (base::IsAsciiLower(c)) {
+    return Key(kLetters[c - 'a'], c);
+  }
+  if (base::IsAsciiUpper(c)) {
+    return Key(kLetters[c - 'A'], c, /*shift=*/true);
+  }
+  if (base::IsAsciiDigit(c)) {
+    return Key(kDigits[c - '0'], c);
+  }
+  if (c == ' ') {
+    return Key(49, c);
+  }
+  for (size_t i = 0; i < std::size(kShiftedDigits) - 1; ++i) {
+    if (c == kShiftedDigits[i]) {
+      return Key(kDigits[i], c, /*shift=*/true);
+    }
+  }
+  for (const PunctuationKey& key : kPunctuation) {
+    if (c == key.plain) {
+      return Key(key.key_code, c);
+    }
+    if (c == key.shifted) {
+      return Key(key.key_code, c, /*shift=*/true);
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+std::optional<NativeKey> NativeKeyNamed(std::string_view name) {
+  if (name.size() == 1 &&
+      (base::IsAsciiLower(name[0]) || base::IsAsciiDigit(name[0]))) {
+    return KeyForCharacter(name[0]);
+  }
+  struct Named {
+    std::string_view name;
+    unsigned short key_code;
+    char16_t characters;
+  };
+  static constexpr Named kNamed[] = {
+      {"return", 36, u'\r'},
+      {"escape", 53, 0x1b},
+      {"tab", 48, u'\t'},
+      {"space", 49, u' '},
+      {"backspace", 51, 0x7f},
+      {"up", 126, NSUpArrowFunctionKey},
+      {"down", 125, NSDownArrowFunctionKey},
+      {"left", 123, NSLeftArrowFunctionKey},
+      {"right", 124, NSRightArrowFunctionKey},
+      {"home", 115, NSHomeFunctionKey},
+      {"end", 119, NSEndFunctionKey},
+      {"pageup", 116, NSPageUpFunctionKey},
+      {"pagedown", 121, NSPageDownFunctionKey},
+  };
+  for (const Named& key : kNamed) {
+    if (name == key.name) {
+      return Key(key.key_code, key.characters);
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::vector<NativeKey>> NativeKeysForText(
+    std::string_view text,
+    std::string* unsupported) {
+  std::vector<NativeKey> keys;
+  for (size_t i = 0; i < text.size(); ++i) {
+    std::optional<NativeKey> key = KeyForCharacter(text[i]);
+    if (!key) {
+      // Report the whole character, not one byte of it.
+      size_t end = i + 1;
+      while (end < text.size() &&
+             (static_cast<unsigned char>(text[end]) & 0xC0) == 0x80) {
+        ++end;
+      }
+      *unsupported = std::string(text.substr(i, end - i));
+      return std::nullopt;
+    }
+    keys.push_back(std::move(*key));
+  }
+  return keys;
+}
+
+}  // namespace rac::dev

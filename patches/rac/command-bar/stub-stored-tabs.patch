+// LOCAL STUB of Data's API (stream `bar`,
+// rac/command-bar/stub-stored-tabs.patch); dropped when Data's lands.
+std::vector<StoredTabSummary> SpacesWindowManager::GetStoredTabs(
+    const base::Uuid& space) const {
+  std::vector<StoredTabSummary> tabs;
+  if (HasLiveTabs(space)) {
+    return tabs;
+  }
+  const StoredSpace* stored = store_.Find(space);
+  if (!stored) {
+    return tabs;
+  }
+  for (const StoredTab& tab : stored->tabs) {
+    // A hand-edited or damaged store can hold a tab with no entries or a
+    // selection past them; skip it rather than read out of bounds.
+    if (tab.selected_navigation < 0 ||
+        static_cast<size_t>(tab.selected_navigation) >=
+            tab.navigations.size()) {
+      continue;
+    }
+    const sessions::SerializedNavigationEntry& entry =
+        tab.navigations[tab.selected_navigation];
+    tabs.push_back({.url = entry.virtual_url(),
+                    .title = entry.title(),
+                    .favicon_url = entry.favicon_url(),
+                    .pinned = !tab.sidebar_item_id.empty(),
+                    .last_active = tab.last_active});
+  }
+  return tabs;
+}
+
+bool SpacesWindowManager::HasLiveTabs(const base::Uuid& space) const {
+  return !GetSpaceTabs(space).empty();
+}

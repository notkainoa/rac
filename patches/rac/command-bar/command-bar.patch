+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_GROW_ANIMATION_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_GROW_ANIMATION_H_
+
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "ui/compositor/compositor.h"
+#include "ui/compositor/compositor_animation_observer.h"
+#include "ui/compositor/compositor_observer.h"
+#include "ui/gfx/geometry/cubic_bezier.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace rac::command_bar {
+
+// Plan 02, S18: the card grows from the address field to its full size in
+// kCommandBarGrow on (0.16, 1, 0.3, 1). Content is uncovered, never scaled:
+// each frame sets the card's bounds, and the card keeps its content pinned
+// at the final position, so only a solid-color layer resizes and nothing
+// re-rasters. Stepped on the compositor's frame clock, so it is vsync
+// aligned and stops (with no timer left behind) when done.
+//
+// Replaced by the `design` stream's UI-thread runner when it lands; the
+// interface stays.
+class CommandBarGrowAnimation : public ui::CompositorAnimationObserver {
+ public:
+  // Called each frame with the card's bounds, and once more at `to`.
+  using StepCallback = base::RepeatingCallback<void(const gfx::Rect&)>;
+
+  CommandBarGrowAnimation(ui::Compositor* compositor,
+                          const gfx::Rect& from,
+                          const gfx::Rect& to,
+                          StepCallback step);
+  CommandBarGrowAnimation(const CommandBarGrowAnimation&) = delete;
+  CommandBarGrowAnimation& operator=(const CommandBarGrowAnimation&) = delete;
+  ~CommandBarGrowAnimation() override;
+
+  void Start();
+  // Jumps to the end. Used when the card closes or must re-lay out.
+  void Finish();
+  bool is_running() const { return running_; }
+  // Runs once when the grow ends, by its last frame or Finish(); not if the
+  // animation is destroyed first.
+  void set_on_finished(base::OnceClosure on_finished) {
+    on_finished_ = std::move(on_finished);
+  }
+
+  // ui::CompositorAnimationObserver:
+  void OnAnimationStep(base::TimeTicks timestamp) override;
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override;
+
+ private:
+  void Stop();
+
+  raw_ptr<ui::Compositor> compositor_;
+  const gfx::Rect from_;
+  const gfx::Rect to_;
+  const StepCallback step_;
+  const gfx::CubicBezier curve_;
+  base::TimeTicks start_;
+  base::TimeTicks last_step_;
+  int steps_ = 0;
+  bool running_ = false;
+  base::OnceClosure on_finished_;
+};
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_GROW_ANIMATION_H_

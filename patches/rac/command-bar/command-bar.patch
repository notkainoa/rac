+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_engine.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/feature_list.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_scheme_classifier.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/ssl/typed_navigation_upgrade_throttle.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_engine_convert.h"
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_provider_client.h"
+#include "components/omnibox/browser/autocomplete_classifier.h"
+#include "components/omnibox/browser/autocomplete_controller_config.h"
+#include "components/omnibox/browser/autocomplete_enums.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "components/omnibox/common/omnibox_features.h"
+#include "components/search_engines/template_url.h"
+#include "net/http/http_request_headers.h"
+#include "services/network/public/cpp/resource_request_body.h"
+#include "third_party/metrics_proto/omnibox_event.pb.h"
+#include "third_party/metrics_proto/omnibox_focus_type.pb.h"
+#include "third_party/metrics_proto/omnibox_input_type.pb.h"
+#include "ui/base/page_transition_types.h"
+
+namespace rac::command_bar {
+
+namespace {
+
+// Late suggestions still count after a pause, so the stop timer is long.
+constexpr base::TimeDelta kStopTimer =
+    base::Seconds(10);  // motion-lint: not motion (provider time limit)
+
+// Everything Open() needs, copied out of the result before navigating:
+// navigating can close the bar, which clears the result.
+struct Destination {
+  GURL url;
+  ui::PageTransition transition = ui::PAGE_TRANSITION_TYPED;
+  std::string extra_headers;
+  scoped_refptr<network::ResourceRequestBody> post_data;
+};
+
+Destination FromMatch(const AutocompleteMatch& match) {
+  Destination destination;
+  destination.url = match.destination_url;
+  destination.transition = match.transition;
+  net::HttpRequestHeaders headers;
+  for (const auto& [name, value] : match.extra_headers) {
+    headers.SetHeader(name, value);
+  }
+  // A search engine that takes POST (TemplateURLRef::PostContent is
+  // {content type, body}), sent as CoreTabHelper::PostContentToURL does
+  // (core_tab_helper.cc:553-575 in 156). Chrome's own omnibox drops it on
+  // desktop (chrome_omnibox_client.cc:968-1000).
+  if (match.post_content && !match.post_content->second.empty()) {
+    headers.SetHeader(net::HttpRequestHeaders::kContentType,
+                      match.post_content->first);
+    destination.post_data = network::ResourceRequestBody::CreateFromCopyOfBytes(
+        base::as_byte_span(match.post_content->second));
+  }
+  destination.extra_headers = headers.ToString();
+  return destination;
+}
+
+}  // namespace
+
+CommandBarEngine::CommandBarEngine(Profile* profile,
+                                   base::RepeatingClosure on_changed)
+    : profile_(profile), on_changed_(std::move(on_changed)) {
+  AutocompleteControllerConfig config;
+  config.provider_types = AutocompleteClassifier::DefaultOmniboxProviders() &
+                          AllowedProviderTypes(profile->IsOffTheRecord());
+  config.stop_timer_duration = kStopTimer;
+  auto client = std::make_unique<CommandBarProviderClient>(profile);
+  client_ = client.get();
+  controller_ =
+      std::make_unique<AutocompleteController>(std::move(client), config);
+  observation_.Observe(controller_.get());
+}
+
+CommandBarEngine::~CommandBarEngine() = default;
+
+void CommandBarEngine::StartLocal(const std::u16string& text) {
+  client_->set_remote_suggestions_allowed(false);
+  remote_pass_ = false;
+  Start(text);
+}
+
+void CommandBarEngine::StartWithSuggestions(const std::u16string& text) {
+  client_->set_remote_suggestions_allowed(true);
+  remote_pass_ = true;
+  // With the same text as the local pass, Start() sets minimal_changes;
+  // SearchProvider still starts its request because the local pass left
+  // it with no results and done_ (search_provider.cc:785-793 in 156).
+  Start(text);
+}
+
+void CommandBarEngine::Clear() {
+  client_->set_remote_suggestions_allowed(false);
+  remote_pass_ = false;
+  input_.reset();
+  controller_->Stop(AutocompleteStopReason::kClobbered);
+}
+
+bool CommandBarEngine::input_is_url() const {
+  return input_ && input_->type() == metrics::OmniboxInputType::URL;
+}
+
+void CommandBarEngine::Start(const std::u16string& text) {
+  if (!input_ || input_->text() != text) {
+    input_start_ = base::TimeTicks::Now();
+  }
+  // As the address bar builds its input (omnibox_edit_model.cc:717-722 in
+  // 156): the same HTTPS-default choice for typed hosts, so "example.com"
+  // opens what it would open from the address bar. OTHER keeps the address
+  // bar's providers; INTERACTION_DEFAULT keeps zero-prefix fetches off even
+  // for odd inputs.
+  input_ = std::make_unique<AutocompleteInput>(
+      text, metrics::OmniboxEventProto::OTHER,
+      ChromeAutocompleteSchemeClassifier(profile_),
+      base::FeatureList::IsEnabled(omnibox::kDefaultTypedNavigationsToHttps),
+      TypedNavigationUpgradeThrottle::GetHttpsPortForTesting(),
+      /*use_fake_https_for_https_upgrade_testing=*/false);
+  input_->set_focus_type(metrics::OmniboxFocusType::INTERACTION_DEFAULT);
+  input_->set_prevent_inline_autocomplete(true);
+  // Every pass runs the asynchronous providers: on a local pass their
+  // work is the history DB, and the remote providers are gated by the
+  // client's remote_suggestions_allowed instead.
+  input_->set_omit_asynchronous_matches(false);
+  controller_->Start(*input_);
+}
+
+std::vector<EngineCandidate> CommandBarEngine::Candidates() const {
+  if (!input_) {
+    return {};
+  }
+  const AutocompleteResult& result = controller_->result();
+  std::vector<EngineCandidate> candidates =
+      ConvertResult(result, *input_, profile_->IsOffTheRecord(),
+                    TemplateURLServiceFactory::GetForProfile(profile_));
+  // A suggestion row belongs to the query that asked for it, but the
+  // previous query's survive a Start(): the controller carries matches over
+  // while a provider is still running (from_previous), and SearchProvider
+  // re-adds its retained results even in a local pass, so a keystroke can
+  // leave the last query's suggestions under the new text. A local pass
+  // (remote_pass_ false) owns no suggestions at all, and a suggest pass
+  // owns none carried over; either way late or stale suggestion rows go.
+  std::erase_if(candidates, [&](const EngineCandidate& candidate) {
+    return candidate.kind == RowKind::kSuggestion &&
+           (!remote_pass_ ||
+            (candidate.result_index < result.size() &&
+             result.match_at(candidate.result_index).from_previous));
+  });
+  return candidates;
+}
+
+bool CommandBarEngine::Open(size_t result_index,
+                            BrowserWindowInterface* browser,
+                            WindowOpenDisposition disposition) {
+  if (!input_) {
+    return false;
+  }
+  Destination destination;
+  if (result_index == kSyntheticTypedUrl) {
+    destination.url = input_->canonicalized_url();
+  } else if (result_index < controller_->result().size()) {
+    destination = FromMatch(controller_->result().match_at(result_index));
+  } else {
+    return false;
+  }
+  if (!destination.url.is_valid()) {
+    return false;
+  }
+  // As chrome::OpenCurrentURL does for the address bar
+  // (browser_commands.cc:1283-1303 in 156).
+  if (chrome::ShouldInterceptChromeURLNavigationInIncognito(browser,
+                                                            destination.url)) {
+    chrome::ProcessInterceptedChromeURLNavigationInIncognito(browser,
+                                                             destination.url);
+    return true;
+  }
+  NavigateParams params(
+      browser, destination.url,
+      ui::PageTransitionFromInt(destination.transition |
+                                ui::PAGE_TRANSITION_FROM_ADDRESS_BAR));
+  params.disposition = disposition;
+  params.tabstrip_add_types =
+      AddTabTypes::ADD_FORCE_INDEX | AddTabTypes::ADD_INHERIT_OPENER;
+  params.input_start = input_start_;
+  params.is_using_https_as_default_scheme =
+      input_->added_default_scheme_to_typed_url();
+  params.url_typed_with_http_scheme = input_->typed_url_had_http_scheme();
+  params.extra_headers = std::move(destination.extra_headers);
+  params.post_data = std::move(destination.post_data);
+  // Stop before navigating: navigating may close the bar, which clears
+  // input_ and the result. Nothing below reads them.
+  controller_->Stop(AutocompleteStopReason::kInteraction);
+  Navigate(&params);
+  return true;
+}
+
+void CommandBarEngine::OnResultChanged(AutocompleteController* controller,
+                                       bool default_match_changed) {
+  on_changed_.Run();
+}
+
+}  // namespace rac::command_bar

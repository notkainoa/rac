+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/view_shadow.h"
+
+namespace rac::command_bar {
+
+namespace {
+
+constexpr int kShadowMarginPx = tokens::kSpacing24;
+
+std::u16string SectionTitle(Section section) {
+  switch (section) {
+    case Section::kTabs:
+      return l10n_util::GetStringUTF16(IDS_RAC_COMMAND_BAR_SECTION_TABS);
+    case Section::kPinnedAndFavorites:
+      return l10n_util::GetStringUTF16(
+          IDS_RAC_COMMAND_BAR_SECTION_PINNED_AND_FAVORITES);
+    case Section::kHistory:
+      return l10n_util::GetStringUTF16(IDS_RAC_COMMAND_BAR_SECTION_HISTORY);
+    case Section::kActions:
+      return l10n_util::GetStringUTF16(IDS_RAC_COMMAND_BAR_SECTION_ACTIONS);
+    case Section::kTop:
+    case Section::kSearch:
+      return std::u16string();
+  }
+}
+
+// What the row shows. The ranker passes data; wording is the view's.
+Row Displayed(Row row) {
+  switch (row.kind) {
+    case RowKind::kSearch:
+      if (row.keyword && !row.detail.empty()) {
+        // A bang or keyword leads as its own engine's search, worded as the
+        // address bar's keyword ("Search Wikipedia"), with the query.
+        row.title = l10n_util::GetStringFUTF16(
+            IDS_RAC_COMMAND_BAR_SEARCH_ENGINE_FOR, row.detail, row.title);
+        row.detail.clear();
+      } else {
+        row.title = l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_SEARCH_FOR,
+                                               row.title);
+      }
+      break;
+    case RowKind::kAsk:
+      if (row.ref == kAskActionId) {
+        row.title = l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_ASK_ABOUT,
+                                               row.detail);
+        row.detail.clear();
+      }
+      break;
+    default:
+      break;
+  }
+  return row;
+}
+
+bool HasModifier(const ui::KeyEvent& event) {
+  return event.flags() & (ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN |
+                          ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN);
+}
+
+// NativeTheme::UserHasContrastPreference() is gone in 156; the preference
+// is an enum (native_theme.h:129, 523).
+bool IsHighContrast() {
+  return ui::NativeTheme::GetInstanceForNativeUi()->preferred_contrast() ==
+         ui::NativeTheme::PreferredContrast::kMore;
+}
+
+}  // namespace
+
+// The card: a solid-color, rounded layer that clips its content. Resizing a
+// solid-color layer needs no raster, which is what keeps the grow cheap.
+class CommandBarView::CardView : public views::View {
+  METADATA_HEADER(CardView, views::View)
+
+ public:
+  CardView() {
+    SetPaintToLayer(ui::LAYER_SOLID_COLOR);
+    layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(style::kCardRadius));
+    // A solid-color layer is opaque or not by its color's alpha; 156
+    // CHECKs against setting it.
+    layer()->SetMasksToBounds(true);
+  }
+
+  // Where the content rests, in this card's parent's coordinates.
+  void SetContentRect(const gfx::Rect& rect) {
+    content_rect_ = rect;
+    InvalidateLayout();
+  }
+
+  void Layout(PassKey) override {
+    // Pinned in place: as the card's origin moves during the grow, the
+    // content's offset inside the card moves the opposite way.
+    if (!children().empty()) {
+      gfx::Rect rect = content_rect_;
+      rect.Offset(-x(), -y());
+      children().front()->SetBoundsRect(rect);
+    }
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    layer()->AsSolidColor()->SetColor(SkColor4f::FromColor(
+        GetColorProvider()->GetColor(style::BackgroundColor())));
+  }
+
+ private:
+  gfx::Rect content_rect_;
+};
+
+BEGIN_METADATA(CommandBarView, CardView)
+END_METADATA
+
+// The field, separator, and list, painted once at the card's final size.
+// Its hairline border sits on the card's final edge.
+class CommandBarView::ContentView : public views::View {
+  METADATA_HEADER(ContentView, views::View)
+
+ public:
+  ContentView() {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1);
+    flags.setColor(
+        GetColorProvider()->GetColor(style::BorderColor(IsHighContrast())));
+    gfx::RectF rect(GetLocalBounds());
+    rect.Inset(0.5f);
+    canvas->DrawRoundRect(rect, style::kCardRadius - 0.5f, flags);
+  }
+};
+
+BEGIN_METADATA(CommandBarView, ContentView)
+END_METADATA
+
+CommandBarView::CommandBarView(Delegate* delegate) : delegate_(delegate) {
+  card_ = AddChildView(std::make_unique<CardView>());
+  shadow_ = std::make_unique<views::ViewShadow>(card_, style::kShadowElevation);
+  shadow_->SetRoundedCornerRadius(style::kCardRadius);
+
+  content_ = card_->AddChildView(std::make_unique<ContentView>());
+  auto* layout = content_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets(style::kCardPadding)));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+
+  // The field row.
+  auto* field_row = content_->AddChildView(std::make_unique<views::View>());
+  field_row
+      ->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal,
+          gfx::Insets::VH(0, style::kRowHorizontalPadding), style::kRowGap))
+      ->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  field_row->SetPreferredSize(gfx::Size(0, style::kFieldHeight));
+  auto* glass = field_row->AddChildView(
+      std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+          vector_icons::kSearchIcon, style::TertiaryTextColor(),
+          style::kFieldIconSize)));
+  glass->GetViewAccessibility().SetIsIgnored(true);
+
+  field_ = field_row->AddChildView(std::make_unique<views::Textfield>());
+  field_->set_controller(this);
+  field_->SetBorder(nullptr);
+  field_->SetBackground(nullptr);
+  field_->SetFontList(style::Font(style::kFieldFontSize));
+  // The caret takes the text color, as in the address bar.
+  field_->SetTextColorId(style::PrimaryTextColor());
+  field_->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_RAC_COMMAND_BAR_PLACEHOLDER));
+  field_->SetPlaceholderTextColorId(style::TertiaryTextColor());
+  field_->SetProperty(views::kBoxLayoutFlexKey,
+                      views::BoxLayoutFlexSpecification());
+  // A combobox: the field owns the list, and VoiceOver follows the selected
+  // row through the active descendant.
+  field_->GetViewAccessibility().SetRole(
+      ax::mojom::Role::kTextFieldWithComboBox);
+  field_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_RAC_COMMAND_BAR_ACCESSIBLE_NAME));
+
+  separator_ = content_->AddChildView(std::make_unique<views::View>());
+  separator_->SetPreferredSize(gfx::Size(0, 1));
+  separator_->SetProperty(views::kMarginsKey,
+                          gfx::Insets::VH(0, style::kSeparatorInset));
+  separator_->SetBackground(
+      views::CreateSolidBackground(style::SeparatorColor()));
+
+  list_ = content_->AddChildView(std::make_unique<views::View>());
+  list_
+      ->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical))
+      ->set_cross_axis_alignment(
+          views::BoxLayout::CrossAxisAlignment::kStretch);
+  list_->SetProperty(views::kMarginsKey,
+                     gfx::Insets::TLBR(style::kListTopGap, 0, 0, 0));
+  list_->GetViewAccessibility().SetRole(ax::mojom::Role::kListBox);
+  list_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_RAC_COMMAND_BAR_RESULTS));
+  field_->GetViewAccessibility().SetControlIds(
+      {list_->GetViewAccessibility().GetUniqueId()});
+}
+
+CommandBarView::~CommandBarView() = default;
+
+// static
+gfx::Outsets CommandBarView::ShadowMargin() {
+  return gfx::Outsets(kShadowMarginPx);
+}
+
+void CommandBarView::SetQuery(const std::u16string& text, bool select_all) {
+  field_->SetText(text);
+  if (select_all) {
+    field_->SelectAll(/*reversed=*/false);
+  }
+}
+
+std::u16string CommandBarView::GetQuery() const {
+  return std::u16string(field_->GetText());
+}
+
+void CommandBarView::SetRows(std::vector<Row> rows) {
+  // While the query is unchanged (late suggestions arriving), a row the
+  // user moved to keeps the selection. A new query starts at the top, so
+  // Enter does what the ranker put first.
+  const std::u16string query(field_->GetText());
+  std::optional<Row> keep;
+  if (user_moved_ && query == rows_query_ && selected_ < rows_.size()) {
+    keep = rows_[selected_];
+  }
+  rows_query_ = query;
+
+  rows_ = std::move(rows);
+  row_views_.clear();
+  list_->RemoveAllChildViews();
+
+  std::optional<Section> section;
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    const Row& row = rows_[i];
+    if (row.section != section) {
+      const std::u16string title = SectionTitle(row.section);
+      if (!title.empty()) {
+        list_->AddChildView(std::make_unique<CommandBarHeaderView>(title));
+      } else if (row.section == Section::kSearch && i > 0) {
+        // The search rows sit apart from local results, as in the sketch.
+        auto* rule = list_->AddChildView(std::make_unique<views::View>());
+        rule->SetPreferredSize(gfx::Size(0, 1));
+        rule->SetProperty(
+            views::kMarginsKey,
+            gfx::Insets::VH(tokens::kSpacing4, style::kSeparatorInset));
+        rule->SetBackground(
+            views::CreateSolidBackground(style::SeparatorColor()));
+      }
+      section = row.section;
+    }
+    auto* view = list_->AddChildView(std::make_unique<CommandBarRowView>(
+        Displayed(row), AccessibleNameFor(row),
+        base::BindRepeating(&CommandBarView::OnRowPressed,
+                            base::Unretained(this)),
+        base::BindRepeating(&CommandBarView::OnRowHovered,
+                            base::Unretained(this))));
+    view->GetViewAccessibility().SetPosInSet(static_cast<int>(i) + 1);
+    view->GetViewAccessibility().SetSetSize(static_cast<int>(rows_.size()));
+    view->SetIcon(delegate_->GetIcon(row, i));
+    row_views_.push_back(view);
+  }
+
+  separator_->SetVisible(!rows_.empty());
+  if (rows_.empty()) {
+    field_->GetViewAccessibility().SetIsCollapsed();
+  } else {
+    field_->GetViewAccessibility().SetIsExpanded();
+  }
+  selected_ = 0;
+  user_moved_ = false;
+  if (keep) {
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      if (IsSameRow(rows_[i], *keep)) {
+        selected_ = i;
+        user_moved_ = true;
+        break;
+      }
+    }
+  }
+  if (!row_views_.empty()) {
+    row_views_[selected_]->SetSelected(true);
+    field_->GetViewAccessibility().SetActiveDescendant(*row_views_[selected_]);
+  } else {
+    field_->GetViewAccessibility().ClearActiveDescendant();
+  }
+  content_->InvalidateLayout();
+}
+
+void CommandBarView::SetRowIcon(size_t index, const ui::ImageModel& icon) {
+  if (index < row_views_.size()) {
+    row_views_[index]->SetIcon(icon);
+  }
+}
+
+gfx::Size CommandBarView::GetCardSize(int width) const {
+  return gfx::Size(width, content_->GetHeightForWidth(width));
+}
+
+void CommandBarView::SetCardBounds(const gfx::Rect& card,
+                                   const gfx::Rect& content) {
+  card_->SetContentRect(content);
+  card_->SetBoundsRect(card);
+  // Layout of the content's children happens only when its size changes,
+  // so the grow's frames move a layer and nothing else.
+}
+
+void CommandBarView::FocusField() {
+  field_->RequestFocus();
+}
+
+void CommandBarView::Layout(PassKey) {
+  // The controller places the card; nothing to do at this level.
+}
+
+void CommandBarView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  content_->SchedulePaint();
+}
+
+void CommandBarView::ContentsChanged(views::Textfield* sender,
+                                     const std::u16string& new_contents) {
+  delegate_->OnQueryChanged(new_contents);
+}
+
+bool CommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                    const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  const bool control = event.IsControlDown();
+  switch (event.key_code()) {
+    case ui::VKEY_DOWN:
+      Select(selected_ + 1);
+      return true;
+    case ui::VKEY_UP:
+      Select(selected_ == 0 ? 0 : selected_ - 1);
+      return true;
+    // Emacs keys, which macOS text fields honor everywhere.
+    case ui::VKEY_N:
+      if (!control) {
+        return false;
+      }
+      Select(selected_ + 1);
+      return true;
+    case ui::VKEY_P:
+      if (!control) {
+        return false;
+      }
+      Select(selected_ == 0 ? 0 : selected_ - 1);
+      return true;
+    // The list never scrolls (it holds at most kMaxRows and the search
+    // rows), so a page is the whole list: Page Up and Home go to the first
+    // row, Page Down and End to the last. With a modifier they stay the
+    // field's.
+    case ui::VKEY_PRIOR:
+    case ui::VKEY_HOME:
+      if (HasModifier(event)) {
+        return false;
+      }
+      Select(0);
+      return true;
+    case ui::VKEY_NEXT:
+    case ui::VKEY_END:
+      if (HasModifier(event)) {
+        return false;
+      }
+      if (!row_views_.empty()) {
+        Select(row_views_.size() - 1);
+      }
+      return true;
+    case ui::VKEY_RETURN:
+      if (!rows_.empty()) {
+        delegate_->OnRowChosen(selected_, event.flags());
+      }
+      return true;
+    case ui::VKEY_ESCAPE:
+      delegate_->OnCancel();
+      return true;
+    default:
+      return event.IsCommandDown() &&
+             delegate_->OnAccelerator(ui::Accelerator(event));
+  }
+}
+
+void CommandBarView::Select(size_t index) {
+  if (row_views_.empty()) {
+    return;
+  }
+  index = std::min(index, row_views_.size() - 1);  // No wrap.
+  if (index == selected_) {
+    return;
+  }
+  row_views_[selected_]->SetSelected(false);
+  selected_ = index;
+  user_moved_ = true;
+  CommandBarRowView* row = row_views_[selected_];
+  row->SetSelected(true);
+  row->ScrollViewToVisible();
+  field_->GetViewAccessibility().SetActiveDescendant(*row);
+  row->NotifyAccessibilityEventDeprecated(ax::mojom::Event::kSelection, true);
+}
+
+void CommandBarView::OnRowHovered(CommandBarRowView* row, int) {
+  for (size_t i = 0; i < row_views_.size(); ++i) {
+    if (row_views_[i] == row) {
+      Select(i);
+      return;
+    }
+  }
+}
+
+void CommandBarView::OnRowPressed(CommandBarRowView* row, int event_flags) {
+  for (size_t i = 0; i < row_views_.size(); ++i) {
+    if (row_views_[i] == row) {
+      delegate_->OnRowChosen(i, event_flags);
+      return;
+    }
+  }
+}
+
+std::u16string CommandBarView::AccessibleNameFor(const Row& row) const {
+  const Row shown = Displayed(row);
+  switch (row.kind) {
+    case RowKind::kOpenTab:
+      return row.trailing.empty()
+                 ? l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_A11Y_TAB,
+                                              shown.title)
+                 : l10n_util::GetStringFUTF16(
+                       IDS_RAC_COMMAND_BAR_A11Y_TAB_IN_SPACE, shown.title,
+                       row.trailing);
+    case RowKind::kPinnedTab:
+      return l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_A11Y_PINNED_TAB,
+                                        shown.title);
+    case RowKind::kFavorite:
+      return l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_A11Y_FAVORITE,
+                                        shown.title);
+    case RowKind::kHistory:
+      return l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_A11Y_HISTORY,
+                                        shown.title, row.detail);
+    case RowKind::kAction:
+      return row.trailing.empty()
+                 ? l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_A11Y_ACTION,
+                                              shown.title)
+                 : l10n_util::GetStringFUTF16(
+                       IDS_RAC_COMMAND_BAR_A11Y_ACTION_WITH_SHORTCUT,
+                       shown.title, row.trailing);
+    case RowKind::kSuggestion:
+      return l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_A11Y_SUGGESTION,
+                                        shown.title);
+    case RowKind::kAsk:
+      return shown.detail.empty() ? shown.title
+                                  : shown.title + u" " + shown.detail;
+    case RowKind::kCurrentPage:
+      return l10n_util::GetStringFUTF16(IDS_RAC_COMMAND_BAR_A11Y_CURRENT_PAGE,
+                                        shown.title, row.detail);
+    case RowKind::kTypedUrl:
+    case RowKind::kSearch:
+      return shown.title;
+  }
+}
+
+BEGIN_METADATA(CommandBarView)
+END_METADATA
+
+}  // namespace rac::command_bar

+++ src/chrome/browser/ui/views/rac/command_bar/command_bar_engine_convert_unittest.cc
@@ -0,0 +1,522 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_engine_convert.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/test/task_environment.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_match_type.h"
+#include "components/omnibox/browser/autocomplete_provider.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "components/omnibox/browser/fake_autocomplete_provider.h"
+#include "components/omnibox/browser/test_scheme_classifier.h"
+#include "components/search_engines/search_engines_test_environment.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/metrics_proto/omnibox_event.pb.h"
+#include "third_party/metrics_proto/omnibox_input_type.pb.h"
+#include "url/gurl.h"
+
+namespace rac::command_bar {
+
+namespace {
+
+using Provider = AutocompleteProvider::Type;
+using MatchType = omnibox::AutocompleteMatchType;
+
+bool Has(int types, Provider provider) {
+  return (types & static_cast<int>(provider)) != 0;
+}
+
+// The providers the bar keeps when it is not off the record, and the five
+// that read the regular profile's history, bookmarks, or shortcuts.
+constexpr Provider kHistoryFive =
+    Provider::kHistoryQuick | Provider::kHistoryUrl | Provider::kHistoryFuzzy |
+    Provider::kBookmark | Provider::kShortcuts;
+constexpr Provider kLocalThree =
+    Provider::kBuiltin | Provider::kKeyword | Provider::kSearch;
+
+// Each test gets one fake provider per type it needs, and a result it fills
+// with `Add`. A match's provider decides how the converter treats it, so the
+// providers outlive the matches.
+class CommandBarEngineConvertTest : public testing::Test {
+ protected:
+  CommandBarEngineConvertTest()
+      : builtin_(Make(Provider::kBuiltin)),
+        search_(Make(Provider::kSearch)),
+        keyword_(Make(Provider::kKeyword)),
+        history_url_(Make(Provider::kHistoryUrl)),
+        history_quick_(Make(Provider::kHistoryQuick)),
+        bookmark_(Make(Provider::kBookmark)),
+        shortcuts_(Make(Provider::kShortcuts)) {}
+
+  static scoped_refptr<FakeAutocompleteProvider> Make(Provider type) {
+    return base::MakeRefCounted<FakeAutocompleteProvider>(type);
+  }
+
+  // A match with the fields the converter reads. `provider` may be null.
+  static AutocompleteMatch MakeMatch(AutocompleteProvider* provider,
+                                     MatchType type,
+                                     const std::u16string& contents = u"",
+                                     const std::string& url = "",
+                                     const std::u16string& description = u"") {
+    AutocompleteMatch match(provider, /*relevance=*/1000,
+                            /*deletable=*/false, type);
+    match.contents = contents;
+    match.description = description;
+    match.destination_url = GURL(url);
+    return match;
+  }
+
+  // Appends `matches` to the result, in order. AppendMatches does not sort or
+  // dedupe; its DCHECKs only need sanitized text and a valid or empty URL
+  // (autocomplete_result.cc:312-338 in 156), which MakeMatch gives.
+  void Add(const ACMatches& matches) { result_.AppendMatches(matches); }
+
+  // The converter's output for the result built so far.
+  std::vector<EngineCandidate> Convert(
+      const AutocompleteInput& input,
+      bool off_the_record,
+      const TemplateURLService* template_urls = nullptr) {
+    return ConvertResult(result_, input, off_the_record, template_urls);
+  }
+
+  static AutocompleteInput InputFor(const std::u16string& text) {
+    return AutocompleteInput(text, metrics::OmniboxEventProto::OTHER,
+                             TestSchemeClassifier());
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  search_engines::SearchEnginesTestEnvironment search_engines_test_environment_;
+
+  scoped_refptr<FakeAutocompleteProvider> builtin_;
+  scoped_refptr<FakeAutocompleteProvider> search_;
+  scoped_refptr<FakeAutocompleteProvider> keyword_;
+  scoped_refptr<FakeAutocompleteProvider> history_url_;
+  scoped_refptr<FakeAutocompleteProvider> history_quick_;
+  scoped_refptr<FakeAutocompleteProvider> bookmark_;
+  scoped_refptr<FakeAutocompleteProvider> shortcuts_;
+  AutocompleteResult result_;
+};
+
+// --- KindOf ---------------------------------------------------------------
+
+TEST_F(CommandBarEngineConvertTest, KindOfTypedUrl) {
+  EXPECT_EQ(KindOf(MakeMatch(history_url_.get(), MatchType::kUrlWhatYouTyped)),
+            RowKind::kTypedUrl);
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfSearchWhatYouTypedAndOtherEngine) {
+  EXPECT_EQ(KindOf(MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped)),
+            RowKind::kSearch);
+  // A bang's row.
+  EXPECT_EQ(KindOf(MakeMatch(keyword_.get(), MatchType::kSearchOtherEngine)),
+            RowKind::kSearch);
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfPastSearchIsHistory) {
+  EXPECT_EQ(KindOf(MakeMatch(search_.get(), MatchType::kSearchHistory)),
+            RowKind::kHistory);
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfSearchSuggestionsAreSuggestions) {
+  for (MatchType type :
+       {MatchType::kSearchSuggest, MatchType::kSearchSuggestEntity,
+        MatchType::kSearchSuggestTail, MatchType::kSearchSuggestPersonalized}) {
+    EXPECT_EQ(KindOf(MakeMatch(search_.get(), type)), RowKind::kSuggestion)
+        << omnibox::AutocompleteMatchTypeToString(type);
+  }
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfNavsuggestFromSearchProvider) {
+  EXPECT_EQ(KindOf(MakeMatch(search_.get(), MatchType::kNavsuggest)),
+            RowKind::kSuggestion);
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfBuiltinPagesAreHistoryRows) {
+  // chrome://settings comes from the built-in provider as a navsuggest; it is
+  // a page, not a search suggestion.
+  EXPECT_EQ(KindOf(MakeMatch(builtin_.get(), MatchType::kNavsuggest)),
+            RowKind::kHistory);
+  // Whatever the match type, a built-in provider's row is a page row.
+  EXPECT_EQ(KindOf(MakeMatch(builtin_.get(), MatchType::kUrlWhatYouTyped)),
+            RowKind::kHistory);
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfHistoryMatchTypes) {
+  for (MatchType type : {MatchType::kHistoryUrl, MatchType::kHistoryTitle,
+                         MatchType::kBookmarkTitle}) {
+    EXPECT_EQ(KindOf(MakeMatch(history_url_.get(), type)), RowKind::kHistory)
+        << omnibox::AutocompleteMatchTypeToString(type);
+  }
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfDropsRowsTheBarDrawsItself) {
+  for (MatchType type :
+       {MatchType::kOpenTab, MatchType::kCalculator, MatchType::kPedal,
+        MatchType::kStarterPack, MatchType::kTabGroup,
+        MatchType::kCrossDeviceTab, MatchType::kNullResultMessage,
+        MatchType::kFeaturedEnterpriseSearch,
+        MatchType::kHistoryEmbeddingsAnswer}) {
+    EXPECT_FALSE(KindOf(MakeMatch(search_.get(), type)).has_value())
+        << omnibox::AutocompleteMatchTypeToString(type);
+  }
+}
+
+TEST_F(CommandBarEngineConvertTest, KindOfWithoutProviderGoesByType) {
+  EXPECT_EQ(KindOf(MakeMatch(nullptr, MatchType::kHistoryUrl)),
+            RowKind::kHistory);
+  EXPECT_EQ(KindOf(MakeMatch(nullptr, MatchType::kNavsuggest)),
+            RowKind::kSuggestion);
+  EXPECT_EQ(KindOf(MakeMatch(nullptr, MatchType::kSearchWhatYouTyped)),
+            RowKind::kSearch);
+  EXPECT_FALSE(KindOf(MakeMatch(nullptr, MatchType::kOpenTab)).has_value());
+}
+
+// --- AllowedProviderTypes -------------------------------------------------
+
+TEST(CommandBarAllowedProviderTypesTest, RegularProfileKeepsHistory) {
+  const int types = AllowedProviderTypes(/*off_the_record=*/false);
+  for (Provider provider :
+       {Provider::kBuiltin, Provider::kKeyword, Provider::kSearch,
+        Provider::kHistoryQuick, Provider::kHistoryUrl, Provider::kHistoryFuzzy,
+        Provider::kBookmark, Provider::kShortcuts}) {
+    EXPECT_TRUE(Has(types, provider)) << static_cast<int>(provider);
+  }
+}
+
+TEST(CommandBarAllowedProviderTypesTest, OffTheRecordDropsTheHistoryFive) {
+  const int types = AllowedProviderTypes(/*off_the_record=*/true);
+  for (Provider provider :
+       {Provider::kHistoryQuick, Provider::kHistoryUrl, Provider::kHistoryFuzzy,
+        Provider::kBookmark, Provider::kShortcuts}) {
+    EXPECT_FALSE(Has(types, provider)) << static_cast<int>(provider);
+  }
+  for (Provider provider :
+       {Provider::kBuiltin, Provider::kKeyword, Provider::kSearch}) {
+    EXPECT_TRUE(Has(types, provider)) << static_cast<int>(provider);
+  }
+}
+
+// An allow-list: a provider Chromium adds later stays off until rac picks it.
+TEST(CommandBarAllowedProviderTypesTest, NamedProvidersAreOffEverywhere) {
+  for (bool off_the_record : {false, true}) {
+    const int types = AllowedProviderTypes(off_the_record);
+    for (Provider provider :
+         {Provider::kOpenTab, Provider::kZeroSuggest, Provider::kDocument,
+          Provider::kMostVisitedSites, Provider::kClipboard,
+          Provider::kCalculator, Provider::kHistoryEmbeddings,
+          Provider::kHistoryClusterProvider, Provider::kOnDeviceHead,
+          Provider::kFeaturedSearch, Provider::kUnscopedExtension,
+          Provider::kEnterpriseSearchAggregator, Provider::kVerbatimMatch}) {
+      EXPECT_FALSE(Has(types, provider))
+          << static_cast<int>(provider) << " otr=" << off_the_record;
+    }
+  }
+}
+
+// Exactly the allow-list and nothing else, so a new enum value that slips in
+// fails here instead of passing silently.
+TEST(CommandBarAllowedProviderTypesTest, ExactSets) {
+  EXPECT_EQ(AllowedProviderTypes(/*off_the_record=*/false),
+            static_cast<int>(kLocalThree | kHistoryFive));
+  EXPECT_EQ(AllowedProviderTypes(/*off_the_record=*/true),
+            static_cast<int>(kLocalThree));
+}
+
+// --- ConvertResult, regular profile ---------------------------------------
+
+TEST_F(CommandBarEngineConvertTest, RegularProfileKeepsHistoryRows) {
+  Add({MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"Example",
+                 "https://example.com/", u"example.com"),
+       MakeMatch(bookmark_.get(), MatchType::kBookmarkTitle, u"Docs",
+                 "https://docs.example/", u"docs.example")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"exam"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 2u);
+  EXPECT_EQ(out[0].kind, RowKind::kHistory);
+  EXPECT_EQ(out[0].url, GURL("https://example.com/"));
+  EXPECT_EQ(out[1].kind, RowKind::kHistory);
+  EXPECT_EQ(out[1].url, GURL("https://docs.example/"));
+}
+
+TEST_F(CommandBarEngineConvertTest, ResultIndexIsTheMatchIndexNotTheRow) {
+  // The open-tab match in the middle is dropped; the row after it keeps its
+  // place in the result, since Open() reads the result by that index.
+  Add({MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"A",
+                 "https://a.example/"),
+       MakeMatch(nullptr, MatchType::kOpenTab, u"B", "https://b.example/"),
+       MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"C",
+                 "https://c.example/")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"x"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 2u);
+  EXPECT_EQ(out[0].result_index, 0u);
+  EXPECT_EQ(out[1].result_index, 2u);
+}
+
+TEST_F(CommandBarEngineConvertTest, DefaultOnlyForIndexZeroThatMayBeDefault) {
+  AutocompleteMatch first =
+      MakeMatch(history_url_.get(), MatchType::kUrlWhatYouTyped, u"a.example",
+                "https://a.example/");
+  first.allowed_to_be_default_match = true;
+  AutocompleteMatch second =
+      MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"b.example",
+                "https://b.example/");
+  second.allowed_to_be_default_match = true;  // Not first, so not default.
+  Add({first, second});
+  std::vector<EngineCandidate> out =
+      Convert(InputFor(u"a"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 2u);
+  EXPECT_TRUE(out[0].is_default);
+  EXPECT_FALSE(out[1].is_default);
+}
+
+TEST_F(CommandBarEngineConvertTest, IndexZeroThatMayNotBeDefaultIsNot) {
+  Add({MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"a.example",
+                 "https://a.example/")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"a"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_FALSE(out[0].is_default);
+}
+
+TEST_F(CommandBarEngineConvertTest, BangIsMarkedForOtherEngineSearches) {
+  Add({MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"hilo",
+                 "https://search.example/?q=hilo"),
+       MakeMatch(keyword_.get(), MatchType::kSearchOtherEngine, u"hilo",
+                 "https://other.example/?q=hilo")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"hilo"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 2u);
+  EXPECT_FALSE(out[0].is_bang);
+  EXPECT_TRUE(out[1].is_bang);
+  EXPECT_EQ(out[1].kind, RowKind::kSearch);
+}
+
+TEST_F(CommandBarEngineConvertTest, BangWithNothingToSearchIsDropped) {
+  // "!w" alone: the keyword provider's placeholder row ("<Type search
+  // term>") has no destination. The bar has no keyword mode to offer it in.
+  Add({MakeMatch(keyword_.get(), MatchType::kSearchOtherEngine,
+                 u"Type search term"),
+       MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"!w",
+                 "https://search.example/?q=%21w")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"!w"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_FALSE(out[0].is_bang);
+  EXPECT_EQ(out[0].result_index, 1u);
+}
+
+TEST_F(CommandBarEngineConvertTest, TitleAndDetailFromContentsAndDescription) {
+  Add({MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"Example Domain",
+                 "https://example.com/", u"example.com")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"exam"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].title, u"Example Domain");
+  EXPECT_EQ(out[0].detail, u"example.com");
+}
+
+TEST_F(CommandBarEngineConvertTest, SwappedContentsAndDescriptionAreUnswapped) {
+  AutocompleteMatch match =
+      MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"example.com",
+                "https://example.com/", u"Example Domain");
+  match.swap_contents_and_description = true;
+  Add({match});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"exam"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].title, u"Example Domain");
+  EXPECT_EQ(out[0].detail, u"example.com");
+}
+
+TEST_F(CommandBarEngineConvertTest, RegularProfileNeverMakesASyntheticRow) {
+  // URL input, no typed-URL match: a regular profile has the history
+  // provider that makes one, so the converter adds nothing of its own.
+  Add({MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"example.com",
+                 "https://search.example/?q=example.com")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"example.com"), /*off_the_record=*/false);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].kind, RowKind::kSearch);
+  EXPECT_NE(out[0].result_index, kSyntheticTypedUrl);
+}
+
+// --- ConvertResult, off the record ----------------------------------------
+
+TEST_F(CommandBarEngineConvertTest, OffTheRecordDropsHistoryBackedProviders) {
+  Add({MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"H1",
+                 "https://h1.example/"),
+       MakeMatch(history_quick_.get(), MatchType::kHistoryUrl, u"H2",
+                 "https://h2.example/"),
+       MakeMatch(bookmark_.get(), MatchType::kBookmarkTitle, u"B",
+                 "https://b.example/"),
+       MakeMatch(shortcuts_.get(), MatchType::kHistoryUrl, u"S",
+                 "https://s.example/"),
+       MakeMatch(builtin_.get(), MatchType::kNavsuggest, u"chrome://settings",
+                 "chrome://settings/"),
+       MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"foo bar",
+                 "https://search.example/?q=foo+bar"),
+       MakeMatch(search_.get(), MatchType::kSearchSuggest, u"foo bar baz",
+                 "https://search.example/?q=foo+bar+baz")});
+  // QUERY input, so no synthetic typed URL muddies the list.
+  const AutocompleteInput input = InputFor(u"foo bar");
+  ASSERT_EQ(input.type(), metrics::OmniboxInputType::QUERY);
+  const std::vector<EngineCandidate> out =
+      Convert(input, /*off_the_record=*/true);
+  ASSERT_EQ(out.size(), 3u);
+  EXPECT_EQ(out[0].kind, RowKind::kHistory);  // The built-in page stays.
+  EXPECT_EQ(out[0].url, GURL("chrome://settings/"));
+  EXPECT_EQ(out[0].result_index, 4u);
+  EXPECT_EQ(out[1].kind, RowKind::kSearch);
+  EXPECT_EQ(out[2].kind, RowKind::kSuggestion);
+}
+
+TEST_F(CommandBarEngineConvertTest, OffTheRecordAddsATypedUrlForUrlInput) {
+  Add({MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"example.com",
+                 "https://search.example/?q=example.com")});
+  const AutocompleteInput input = InputFor(u"example.com");
+  ASSERT_EQ(input.type(), metrics::OmniboxInputType::URL);
+  ASSERT_TRUE(input.canonicalized_url().is_valid());
+  const std::vector<EngineCandidate> out =
+      Convert(input, /*off_the_record=*/true);
+  ASSERT_EQ(out.size(), 2u);
+  // First, ahead of the search row.
+  EXPECT_EQ(out[0].kind, RowKind::kTypedUrl);
+  EXPECT_EQ(out[0].result_index, kSyntheticTypedUrl);
+  EXPECT_EQ(out[0].url, input.canonicalized_url());
+  EXPECT_EQ(out[0].title, u"example.com");
+  EXPECT_TRUE(out[0].is_default);
+  EXPECT_FALSE(out[0].is_bang);
+  EXPECT_EQ(out[1].kind, RowKind::kSearch);
+}
+
+TEST_F(CommandBarEngineConvertTest, OffTheRecordTypedUrlForSingleLabelHost) {
+  const AutocompleteInput input = InputFor(u"intranet/");
+  ASSERT_EQ(input.type(), metrics::OmniboxInputType::URL);
+  const std::vector<EngineCandidate> out =
+      Convert(input, /*off_the_record=*/true);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].result_index, kSyntheticTypedUrl);
+  EXPECT_EQ(out[0].url, input.canonicalized_url());
+  EXPECT_TRUE(out[0].url.is_valid());
+}
+
+TEST_F(CommandBarEngineConvertTest, OffTheRecordReplacesHistoryTypedUrl) {
+  // In a regular profile the history provider makes "what you typed" for a
+  // URL. Off the record that provider's row is dropped, so the synthetic
+  // one stands in and there is exactly one typed-URL row.
+  AutocompleteMatch typed =
+      MakeMatch(history_url_.get(), MatchType::kUrlWhatYouTyped, u"example.com",
+                "https://example.com/");
+  typed.allowed_to_be_default_match = true;
+  Add({typed});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"example.com"), /*off_the_record=*/true);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].kind, RowKind::kTypedUrl);
+  EXPECT_EQ(out[0].result_index, kSyntheticTypedUrl);
+}
+
+TEST_F(CommandBarEngineConvertTest, OffTheRecordNoSyntheticRowForQueryInput) {
+  Add({MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"hilo weather",
+                 "https://search.example/?q=hilo+weather")});
+  const AutocompleteInput input = InputFor(u"hilo weather");
+  ASSERT_EQ(input.type(), metrics::OmniboxInputType::QUERY);
+  const std::vector<EngineCandidate> out =
+      Convert(input, /*off_the_record=*/true);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].kind, RowKind::kSearch);
+}
+
+TEST_F(CommandBarEngineConvertTest, OffTheRecordNoSyntheticRowWhenOneExists) {
+  // A typed-URL match from a provider that is not history-backed (none here)
+  // is kept, and then no second one is built.
+  AutocompleteMatch typed = MakeMatch(nullptr, MatchType::kUrlWhatYouTyped,
+                                      u"example.com", "https://example.com/");
+  typed.allowed_to_be_default_match = true;
+  Add({typed});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"example.com"), /*off_the_record=*/true);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].kind, RowKind::kTypedUrl);
+  EXPECT_EQ(out[0].result_index, 0u);
+}
+
+TEST_F(CommandBarEngineConvertTest, OffTheRecordEmptyResultStillTypedUrl) {
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"example.com"), /*off_the_record=*/true);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].result_index, kSyntheticTypedUrl);
+}
+
+// --- Search detail --------------------------------------------------------
+
+TEST_F(CommandBarEngineConvertTest, NullTemplateUrlsKeepsChromiumsDescription) {
+  Add({MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"hilo",
+                 "https://search.example/?q=hilo", u"Search DuckDuckGo")});
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"hilo"), /*off_the_record=*/false,
+              /*template_urls=*/nullptr);
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0].detail, u"Search DuckDuckGo");
+}
+
+// With a TemplateURLService (the test environment makes a bare one; Add
+// works before it loads, as in autocomplete_match_unittest.cc:1202-1221).
+// What stays for a browser test: the real "Ask <engine>" wording for
+// Helium's AI-category bangs, which needs the real engine list.
+TEST_F(CommandBarEngineConvertTest, SearchDetailIsTheEnginesShortName) {
+  TemplateURLService* service =
+      search_engines_test_environment_.template_url_service();
+  TemplateURLData data;
+  data.SetShortName(u"DuckDuckGo");
+  data.SetKeyword(u"ddg");
+  data.SetURL("https://duckduckgo.com/?q={searchTerms}");
+  service->Add(std::make_unique<TemplateURL>(data));
+
+  AutocompleteMatch bang =
+      MakeMatch(keyword_.get(), MatchType::kSearchOtherEngine, u"hilo",
+                "https://duckduckgo.com/?q=hilo", u"Search DuckDuckGo");
+  bang.keyword = u"ddg";
+  // An engine the service does not know keeps Chromium's text.
+  AutocompleteMatch unknown =
+      MakeMatch(keyword_.get(), MatchType::kSearchOtherEngine, u"hilo",
+                "https://unknown.example/?q=hilo", u"Search Unknown");
+  unknown.keyword = u"nope";
+  // No description: nothing to replace, so none is invented.
+  AutocompleteMatch bare =
+      MakeMatch(search_.get(), MatchType::kSearchWhatYouTyped, u"hilo",
+                "https://duckduckgo.com/?q=hilo");
+  bare.keyword = u"ddg";
+  // A page row never gets an engine name, keyword or not.
+  AutocompleteMatch page =
+      MakeMatch(history_url_.get(), MatchType::kHistoryUrl, u"Hilo",
+                "https://hilo.example/", u"hilo.example");
+  page.keyword = u"ddg";
+  Add({bang, unknown, bare, page});
+
+  const std::vector<EngineCandidate> out =
+      Convert(InputFor(u"hilo"), /*off_the_record=*/false, service);
+  ASSERT_EQ(out.size(), 4u);
+  EXPECT_EQ(out[0].detail, u"DuckDuckGo");
+  EXPECT_EQ(out[1].detail, u"Search Unknown");
+  EXPECT_EQ(out[2].detail, u"");
+  EXPECT_EQ(out[3].detail, u"hilo.example");
+}
+
+}  // namespace
+
+}  // namespace rac::command_bar

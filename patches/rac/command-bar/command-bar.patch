+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_ranker.h"
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_switches.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac::command_bar {
+
+using ::testing::ElementsAre;
+using ::testing::IsEmpty;
+
+namespace {
+
+// A fixed clock, so no test depends on the time it runs.
+base::Time BaseTime() {
+  return base::Time::UnixEpoch() + base::Days(1);
+}
+
+base::Time MinutesAgo(int minutes) {
+  return BaseTime() - base::Minutes(minutes);
+}
+
+std::string Numbered(std::string_view prefix, size_t i) {
+  return std::string(prefix) + std::to_string(i);
+}
+
+Query MakeQuery(std::u16string_view text,
+                bool incognito = false,
+                bool input_is_url = false) {
+  Query query;
+  query.text = std::u16string(text);
+  query.incognito = incognito;
+  query.input_is_url = input_is_url;
+  return query;
+}
+
+// A tab in this window. Tabs outside the current space belong to "Play".
+TabCandidate MakeTab(std::string_view ref,
+                     std::u16string_view title,
+                     std::string_view url,
+                     bool in_current_space = true,
+                     int last_active_minutes_ago = 0) {
+  TabCandidate tab;
+  tab.ref = std::string(ref);
+  tab.title = std::u16string(title);
+  tab.url = GURL(url);
+  tab.space_id = in_current_space ? "work" : "play";
+  tab.space_name = in_current_space ? u"Work" : u"Play";
+  tab.in_current_space = in_current_space;
+  tab.in_this_window = true;
+  tab.last_active = MinutesAgo(last_active_minutes_ago);
+  return tab;
+}
+
+SavedCandidate MakeSaved(std::string_view ref,
+                         std::u16string_view title,
+                         std::string_view url,
+                         bool is_favorite,
+                         bool in_current_space = true,
+                         int sidebar_index = 0) {
+  SavedCandidate saved;
+  saved.ref = std::string(ref);
+  saved.is_favorite = is_favorite;
+  saved.title = std::u16string(title);
+  saved.url = GURL(url);
+  saved.space_name = in_current_space || is_favorite ? u"Work" : u"Play";
+  saved.in_current_space = in_current_space || is_favorite;
+  saved.sidebar_index = sidebar_index;
+  return saved;
+}
+
+ActionCandidate MakeAction(std::string_view id,
+                           std::u16string_view label,
+                           std::u16string_view keywords = {},
+                           bool suggested = false,
+                           bool takes_query = false) {
+  ActionCandidate action;
+  action.id = std::string(id);
+  action.label = std::u16string(label);
+  action.keywords = std::u16string(keywords);
+  action.suggested = suggested;
+  action.takes_query = takes_query;
+  return action;
+}
+
+EngineCandidate MakeEngine(RowKind kind,
+                           std::u16string_view title,
+                           std::string_view url,
+                           size_t index) {
+  EngineCandidate engine;
+  engine.kind = kind;
+  engine.title = std::u16string(title);
+  engine.url = GURL(url);
+  engine.detail = base::UTF8ToUTF16(engine.url.host());
+  engine.result_index = index;
+  return engine;
+}
+
+EngineCandidate MakeHistory(std::u16string_view title,
+                            std::string_view url,
+                            size_t index) {
+  return MakeEngine(RowKind::kHistory, title, url, index);
+}
+
+// Chromium's default match when the input is a URL.
+EngineCandidate MakeTypedUrl(std::u16string_view title,
+                             std::string_view url,
+                             size_t index = 0) {
+  EngineCandidate engine = MakeEngine(RowKind::kTypedUrl, title, url, index);
+  engine.is_default = true;
+  return engine;
+}
+
+// A Helium bang, as the engine adapter converts it: a kSearchOtherEngine
+// match is a search row marked as a bang.
+EngineCandidate MakeBang(std::u16string_view title,
+                         std::string_view url,
+                         bool is_default,
+                         size_t index = 0) {
+  EngineCandidate engine = MakeEngine(RowKind::kSearch, title, url, index);
+  engine.is_bang = true;
+  engine.is_default = is_default;
+  return engine;
+}
+
+EngineCandidate MakeSearch(std::u16string_view title, size_t index = 0) {
+  return MakeEngine(RowKind::kSearch, title, "https://search.example/", index);
+}
+
+EngineCandidate MakeSuggestion(std::u16string_view title, size_t index) {
+  return MakeEngine(RowKind::kSuggestion, title, "https://search.example/",
+                    index);
+}
+
+// Bulk builders for the cap tests. Every title starts with "Alpha", so the
+// query u"alpha" matches each one at the title-prefix tier. Row 0 is the most
+// recent tab and the first in the sidebar and the table.
+Query AlphaQuery() {
+  return MakeQuery(u"alpha");
+}
+
+void AddTabs(Inputs& inputs, size_t count) {
+  for (size_t i = 0; i < count; ++i) {
+    inputs.tabs.push_back(MakeTab(
+        Numbered("tab", i), base::UTF8ToUTF16(Numbered("Alpha tab ", i)),
+        "https://" + Numbered("tab", i) + ".example/",
+        /*in_current_space=*/true, static_cast<int>(i)));
+  }
+}
+
+void AddPinned(Inputs& inputs, size_t count) {
+  for (size_t i = 0; i < count; ++i) {
+    inputs.saved.push_back(MakeSaved(
+        Numbered("pinned", i), base::UTF8ToUTF16(Numbered("Alpha pinned ", i)),
+        "https://" + Numbered("pinned", i) + ".example/",
+        /*is_favorite=*/false, /*in_current_space=*/true, static_cast<int>(i)));
+  }
+}
+
+void AddHistory(Inputs& inputs, size_t count) {
+  for (size_t i = 0; i < count; ++i) {
+    inputs.engine.push_back(
+        MakeHistory(base::UTF8ToUTF16(Numbered("Alpha history ", i)),
+                    "https://" + Numbered("history", i) + ".example/", i));
+  }
+}
+
+void AddActions(Inputs& inputs, size_t count) {
+  for (size_t i = 0; i < count; ++i) {
+    ActionCandidate action = MakeAction(
+        Numbered("action", i), base::UTF8ToUTF16(Numbered("Alpha action ", i)));
+    action.table_index = static_cast<int>(i);
+    inputs.actions.push_back(action);
+  }
+}
+
+void AddSuggestions(Inputs& inputs, size_t count) {
+  for (size_t i = 0; i < count; ++i) {
+    inputs.engine.push_back(MakeSuggestion(
+        base::UTF8ToUTF16(Numbered("alpha suggestion ", i)), 100 + i));
+  }
+}
+
+std::vector<RowKind> Kinds(const RankedRows& ranked) {
+  std::vector<RowKind> kinds;
+  for (const Row& row : ranked.rows) {
+    kinds.push_back(row.kind);
+  }
+  return kinds;
+}
+
+std::vector<Section> Sections(const RankedRows& ranked) {
+  std::vector<Section> sections;
+  for (const Row& row : ranked.rows) {
+    sections.push_back(row.section);
+  }
+  return sections;
+}
+
+std::vector<std::string> Refs(const RankedRows& ranked) {
+  std::vector<std::string> refs;
+  for (const Row& row : ranked.rows) {
+    refs.push_back(row.ref);
+  }
+  return refs;
+}
+
+size_t CountKind(const RankedRows& ranked, RowKind kind) {
+  return static_cast<size_t>(
+      std::count_if(ranked.rows.begin(), ranked.rows.end(),
+                    [kind](const Row& row) { return row.kind == kind; }));
+}
+
+// Local rows are the ones D29's gate counts.
+size_t CountLocalRows(const RankedRows& ranked) {
+  return CountKind(ranked, RowKind::kOpenTab) +
+         CountKind(ranked, RowKind::kPinnedTab) +
+         CountKind(ranked, RowKind::kFavorite) +
+         CountKind(ranked, RowKind::kHistory) +
+         CountKind(ranked, RowKind::kAction);
+}
+
+RankedRows MakeLocal(RowKind first, size_t local_count) {
+  RankedRows local;
+  Row row;
+  row.kind = first;
+  local.rows.push_back(row);
+  local.local_count = local_count;
+  return local;
+}
+
+}  // namespace
+
+// Match.
+
+TEST(CommandBarRankerTest, MatchTitlePrefixBeatsWordPrefixBeatsSubstring) {
+  const GURL no_url;
+  EXPECT_EQ(Match(u"hacker", u"Hacker News", no_url), MatchTier::kTitlePrefix);
+  EXPECT_EQ(Match(u"hacker ne", u"Hacker News", no_url),
+            MatchTier::kTitlePrefix);
+  EXPECT_EQ(Match(u"news", u"Hacker News", no_url), MatchTier::kWordPrefix);
+  EXPECT_EQ(Match(u"acker", u"Hacker News", no_url), MatchTier::kSubstring);
+  EXPECT_EQ(Match(u"zebra", u"Hacker News", no_url), MatchTier::kNone);
+  EXPECT_GT(MatchTier::kTitlePrefix, MatchTier::kWordPrefix);
+  EXPECT_GT(MatchTier::kWordPrefix, MatchTier::kSubstring);
+  EXPECT_GT(MatchTier::kSubstring, MatchTier::kNone);
+}
+
+TEST(CommandBarRankerTest, MatchFoldsCase) {
+  const GURL no_url;
+  EXPECT_EQ(Match(u"HACKER", u"Hacker News", no_url), MatchTier::kTitlePrefix);
+  EXPECT_EQ(Match(u"hacker", u"HACKER NEWS", no_url), MatchTier::kTitlePrefix);
+  EXPECT_EQ(Match(u"NEWS", u"Hacker News", no_url), MatchTier::kWordPrefix);
+}
+
+TEST(CommandBarRankerTest, MatchRequiresEveryTerm) {
+  static_assert(kMinSubstringTerm <= 3,
+                "The substring term below needs to be long enough.");
+  const GURL no_url;
+  // Both terms start a word; the order of the terms does not matter.
+  EXPECT_EQ(Match(u"news hacker", u"Hacker News", no_url),
+            MatchTier::kWordPrefix);
+  // One missing term rejects the whole query.
+  EXPECT_EQ(Match(u"news zebra", u"Hacker News", no_url), MatchTier::kNone);
+  // The weakest term sets the tier.
+  EXPECT_EQ(Match(u"news ack", u"Hacker News", no_url), MatchTier::kSubstring);
+}
+
+TEST(CommandBarRankerTest, MatchShortAsciiTermNeedsWordStart) {
+  static_assert(kMinSubstringTerm > 2,
+                "The two-letter terms below must count as short.");
+  const GURL no_url;
+  // "ac" is inside "Hacker", not at the start of a word.
+  EXPECT_EQ(Match(u"ac", u"Hacker News", no_url), MatchTier::kNone);
+  // The same letters at the start of a word match.
+  EXPECT_EQ(Match(u"ne", u"Hacker News", no_url), MatchTier::kWordPrefix);
+  // The rule covers the URL too: "xa" is inside "example".
+  EXPECT_EQ(Match(u"xa", u"Docs", GURL("https://example.com/")),
+            MatchTier::kNone);
+}
+
+TEST(CommandBarRankerTest, MatchNonAsciiTermMatchesAsSubstring) {
+  static_assert(kMinSubstringTerm > 2,
+                "The two-character term below must count as short.");
+  // "Tokyo Tower" in Japanese. There are no spaces, so "Tokyo" (two
+  // characters) is inside the title and starts no word.
+  const std::u16string title = u"今日の東京タワー";
+  EXPECT_EQ(Match(u"東京", title, GURL()), MatchTier::kSubstring);
+  EXPECT_EQ(Match(u"大阪", title, GURL()), MatchTier::kNone);
+}
+
+TEST(CommandBarRankerTest, MatchKeywordsCountForWordStarts) {
+  const GURL no_url;
+  EXPECT_EQ(
+      Match(u"private", u"New incognito window", no_url, u"incognito private"),
+      MatchTier::kWordPrefix);
+  // Without the keywords there is nothing to match.
+  EXPECT_EQ(Match(u"private", u"New incognito window", no_url),
+            MatchTier::kNone);
+  // Keywords are for word starts only, never substrings.
+  EXPECT_EQ(
+      Match(u"rivate", u"New incognito window", no_url, u"incognito private"),
+      MatchTier::kNone);
+}
+
+TEST(CommandBarRankerTest, MatchHostWordStarts) {
+  const GURL url("https://news.ycombinator.com/item?id=1");
+  EXPECT_EQ(Match(u"ycomb", u"Front page", url), MatchTier::kWordPrefix);
+  EXPECT_EQ(Match(u"news", u"Front page", url), MatchTier::kWordPrefix);
+  // The query string is not part of the matched text.
+  EXPECT_EQ(Match(u"id=1", u"Front page", url), MatchTier::kNone);
+}
+
+TEST(CommandBarRankerTest, MatchHostIgnoresWww) {
+  const GURL url("https://www.example.com/");
+  EXPECT_EQ(Match(u"www", u"Docs", url), MatchTier::kNone);
+  EXPECT_EQ(Match(u"example", u"Docs", url), MatchTier::kWordPrefix);
+}
+
+TEST(CommandBarRankerTest, MatchUrlPathSubstring) {
+  static_assert(kMinSubstringTerm <= 3,
+                "The substring term below needs to be long enough.");
+  const GURL url("https://example.com/articles/zebra-crossing");
+  EXPECT_EQ(Match(u"bra", u"Docs", url), MatchTier::kSubstring);
+  // Words in the path start after "/" and "-".
+  EXPECT_EQ(Match(u"zebra", u"Docs", url), MatchTier::kWordPrefix);
+  EXPECT_EQ(Match(u"crossing", u"Docs", url), MatchTier::kWordPrefix);
+}
+
+TEST(CommandBarRankerTest, MatchBlankQueryIsNone) {
+  EXPECT_EQ(Match(u"", u"Hacker News", GURL()), MatchTier::kNone);
+  EXPECT_EQ(Match(u"   ", u"Hacker News", GURL()), MatchTier::kNone);
+}
+
+// DedupeKey.
+
+TEST(CommandBarRankerTest, DedupeKeyTreatsHttpAndHttpsAlike) {
+  EXPECT_EQ(DedupeKey(GURL("http://example.com/a")),
+            DedupeKey(GURL("https://example.com/a")));
+}
+
+TEST(CommandBarRankerTest, DedupeKeyIgnoresWww) {
+  EXPECT_EQ(DedupeKey(GURL("https://www.example.com/a")),
+            DedupeKey(GURL("https://example.com/a")));
+}
+
+TEST(CommandBarRankerTest, DedupeKeyIgnoresFragment) {
+  EXPECT_EQ(DedupeKey(GURL("https://example.com/a#section")),
+            DedupeKey(GURL("https://example.com/a")));
+}
+
+TEST(CommandBarRankerTest, DedupeKeyIgnoresLoneSlashPath) {
+  EXPECT_EQ(DedupeKey(GURL("https://example.com/")),
+            DedupeKey(GURL("https://example.com")));
+  EXPECT_EQ(DedupeKey(GURL("https://example.com/#top")),
+            DedupeKey(GURL("https://example.com")));
+}
+
+TEST(CommandBarRankerTest, DedupeKeyKeepsQuery) {
+  EXPECT_NE(DedupeKey(GURL("https://example.com/a?x=1")),
+            DedupeKey(GURL("https://example.com/a")));

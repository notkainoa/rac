+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_SWITCHES_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_SWITCHES_H_
+
+#include <cstddef>
+
+#include "base/time/time.h"
+
+// Every open decision about the command bar is one constant here, so an
+// answer from the maintainer is a one-line change. Tunable numbers sit with
+// them. Nothing in this file is read at startup.
+namespace rac::command_bar {
+
+// D13 is a pref, not a constant: rac::kNewTabOpensCommandBar
+// (chrome/browser/ui/rac/command_bar_prefs.h), default on.
+
+// D28. Cmd+L opens the command bar with the URL selected. A click on the
+// address bar is untouched and edits in place, so no switch is needed for it.
+inline constexpr bool kFocusLocationOpensBar = true;
+
+// D29. When the search engine is asked for suggestions. "Run out" means at
+// most kLocalRowsRunOut local rows. The pause is an estimate; M2 tunes it.
+enum class SuggestPolicy {
+  kLikeAddressBar,            // Every keystroke, as in the address bar.
+  kAfterLocalRunOutAndPause,  // Recommended.
+  kNever,
+};
+inline constexpr SuggestPolicy kSuggestPolicy =
+    SuggestPolicy::kAfterLocalRunOutAndPause;
+inline constexpr size_t kLocalRowsRunOut = 2;
+inline constexpr base::TimeDelta kSuggestPause =
+    base::Milliseconds(300);  // motion-lint: not motion (D29 typing pause)
+
+// D30. The action table's query-taking rows (Ask) show in the bar. The table
+// already drops Ask with AI off; this switch only removes it with AI on.
+inline constexpr bool kShowQueryRows = true;
+
+// D31 lives in the action table's default shortcuts (plan 07), not here.
+
+// Row caps. The search, Ask, and typed-URL rows are not counted.
+inline constexpr size_t kMaxRows = 9;
+inline constexpr size_t kMaxTabs = 5;
+inline constexpr size_t kMaxSaved = 3;
+inline constexpr size_t kMaxHistory = 4;
+inline constexpr size_t kMaxActions = 3;
+inline constexpr size_t kMaxSuggestions = 3;
+
+// Empty state: recent tabs in this space, then suggested actions.
+inline constexpr size_t kEmptyRecentTabs = 5;
+inline constexpr size_t kEmptyActions = 3;
+
+// A term shorter than this matches only at the start of a word.
+inline constexpr size_t kMinSubstringTerm = 3;
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_SWITCHES_H_
Index: src/chrome/browser/ui/views/rac/command_bar/command_bar_types.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/rac/command_bar/command_bar_types.h
@@ -0,0 +1,157 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_TYPES_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_TYPES_H_
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+// Plain data shared by the command bar's ranker, its sources, and its views.
+// Nothing here depends on Views, the omnibox, or any browser service, so the
+// ranker builds in a tiny test binary.
+namespace rac::command_bar {
+
+// What a row does when chosen. The order is not the rank order; the ranker
+// owns that.
+enum class RowKind {
+  kCurrentPage,  // Cmd+L's page, while the field holds its URL untouched.
+                 // Enter closes the bar; Cmd+Enter opens it in a new tab.
+  kTypedUrl,     // The URL or bang the user typed. Opens it.
+  kOpenTab,      // An open tab in any space, loaded or not. Switches to it.
+  kPinnedTab,    // A pinned tab, with or without a live tab. Switches or opens.
+  kFavorite,     // A favorite. Switches to its tab in this window.
+  kHistory,      // History, bookmarks, and shortcuts from the autocomplete.
+  kAction,       // A row from the action table.
+  kSearch,       // Search for what was typed. Local until Enter.
+  kAsk,          // The action table's query-taking rows, such as Ask (AI on).
+  kSuggestion,   // A search engine suggestion. Only after D29's gate.
+};
+
+// The labelled groups the panel draws. kTop and kSearch have no header.
+// Pinned tabs and favorites share one section (maintainer, day 0).
+enum class Section {
+  kTop,
+  kTabs,
+  kPinnedAndFavorites,
+  kHistory,
+  kActions,
+  kSearch,
+};
+
+// How a candidate's text matched the query. Higher is better.
+enum class MatchTier {
+  kNone = 0,
+  kSubstring = 1,    // Each term is inside the title or URL (3+ characters).
+  kWordPrefix = 2,   // Each term starts a word of the title, host, or keywords.
+  kTitlePrefix = 3,  // The title starts with the whole query.
+};
+
+// An open tab. Sources fill one per tab in the profile (in incognito, in
+// every incognito window), including hidden spaces and unloaded tabs.
+struct TabCandidate {
+  std::string ref;  // Opaque; the controller maps it back to a tab.
+  std::u16string title;
+  GURL url;
+  std::string space_id;       // Opaque; empty in incognito.
+  std::u16string space_name;  // Empty in incognito.
+  bool in_current_space = false;
+  bool in_this_window = false;
+  bool is_active_tab = false;  // The tab the window is showing now.
+  // A tab of a space that has no live tab, read from the store. Dropped when
+  // a live tab of the same space shows the same page.
+  bool stored = false;
+  base::Time last_active;
+};
+
+// A pinned tab or a favorite, from the sidebar's items.
+struct SavedCandidate {
+  std::string ref;
+  bool is_favorite = false;  // Otherwise a pinned tab.
+  std::u16string title;      // The rename if any, else the remembered title.
+  GURL url;                  // The live tab's URL if any, else the pinned one.
+  GURL pinned_url;           // The "pinned on" page; empty for favorites.
+  std::u16string space_name;
+  bool in_current_space = false;  // Always true for favorites.
+  bool is_active_tab = false;     // Its live tab is the one on screen.
+  int sidebar_index = 0;          // Order in the sidebar.
+};
+
+// A row from the action table, already filtered by `ForSurface`.
+struct ActionCandidate {
+  std::string id;
+  std::u16string label;
+  std::u16string keywords;   // Space-separated aliases; may be empty.
+  std::u16string shortcut;   // Display text such as u"⇧⌘N"; may be empty.
+  bool suggested = false;    // Shown in the empty state.
+  bool takes_query = false;  // Shown for any non-empty query (Ask).
+  int table_index = 0;       // Order in the table.
+};
+
+// One autocomplete match, already converted by the engine adapter.
+struct EngineCandidate {
+  RowKind kind = RowKind::kHistory;  // kTypedUrl, kHistory, kSearch, or
+                                     // kSuggestion.
+  std::u16string title;
+  std::u16string detail;  // Host or description.
+  GURL url;
+  bool is_default = false;  // Chromium's default match.
+  bool is_bang = false;     // A keyword (Helium bang) match.
+  size_t result_index = 0;  // Index into the AutocompleteResult.
+};
+
+struct Query {
+  std::u16string text;  // As typed; the ranker trims it.
+  bool incognito = false;
+  bool input_is_url = false;  // AutocompleteInput classified it as a URL.
+  // Cmd+L's page while the field still holds its URL untouched; the text is
+  // then empty. Invalid otherwise.
+  GURL current_page;
+  std::u16string current_page_title;
+};
+
+struct Inputs {
+  std::vector<TabCandidate> tabs;
+  std::vector<SavedCandidate> saved;
+  std::vector<ActionCandidate> actions;
+  std::vector<EngineCandidate> engine;
+};
+
+// One row the panel draws.
+struct Row {
+  RowKind kind = RowKind::kHistory;
+  Section section = Section::kTop;
+  std::u16string title;
+  std::u16string detail;    // Second text, dimmed.
+  std::u16string trailing;  // Space name pill or shortcut.
+  GURL url;                 // For the favicon and for opening.
+  std::string ref;          // Tab, item, or action id; empty otherwise.
+  size_t result_index = 0;  // For kTypedUrl, kHistory, kSearch, kSuggestion.
+  // A kSearch row of a bang or site keyword ("!w cats"): `detail` names its
+  // engine, and the view words it "Search <engine> for …".
+  bool keyword = false;
+};
+
+// Whether `a` and `b` are the same row, for keeping the selection on it
+// while results arrive for an unchanged query. Engine rows have no ref, and
+// their result index moves, so they compare by URL and title.
+inline bool IsSameRow(const Row& a, const Row& b) {
+  return a.kind == b.kind && a.ref == b.ref && a.url == b.url &&
+         (!a.ref.empty() || a.title == b.title);
+}
+
+struct RankedRows {
+  std::vector<Row> rows;
+  // Local rows, counted for D29's gate: tabs, pinned tabs, favorites,
+  // history, and actions. Not the typed URL, search, or Ask rows.
+  size_t local_count = 0;
+};
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_TYPES_H_

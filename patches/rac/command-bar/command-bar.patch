+}  // namespace views
+
+namespace rac::command_bar {
+
+class CommandBarRowView;
+
+// The command bar's whole window content: a card holding the field and the
+// result list, drawn over the page in a child widget.
+//
+//   CommandBarView (transparent; leaves room for the shadow)
+//   └─ card_ (solid-color layer, rounded, masks to bounds, ViewShadow)
+//      └─ content_ (its own layer, fixed at the card's final size)
+//         ├─ field row: search icon + Textfield
+//         ├─ separator
+//         └─ list_: section headers and CommandBarRowViews
+//
+// The grow (S18) only moves the card's edges; content_ stays where it will
+// end, so the card uncovers it like a clip and nothing scales or re-rasters.
+class CommandBarView : public views::View, public views::TextfieldController {
+  METADATA_HEADER(CommandBarView, views::View)
+
+ public:
+  class Delegate {
+   public:
+    virtual void OnQueryChanged(const std::u16string& text) = 0;
+    // `event_flags` carries Cmd for "open in a new tab" from Cmd+L.
+    virtual void OnRowChosen(size_t index, int event_flags) = 0;
+    virtual void OnCancel() = 0;
+    // A key with Command held that the field didn't use. True if the bar
+    // ran it (one of its own shortcuts).
+    virtual bool OnAccelerator(const ui::Accelerator& accelerator) = 0;
+    // The row's icon now; favicons that load later arrive via SetRowIcon.
+    virtual ui::ImageModel GetIcon(const Row& row, size_t index) = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  explicit CommandBarView(Delegate* delegate);
+  CommandBarView(const CommandBarView&) = delete;
+  CommandBarView& operator=(const CommandBarView&) = delete;
+  ~CommandBarView() override;
+
+  // Room around the card for its shadow. The widget is the card plus this.
+  static gfx::Outsets ShadowMargin();
+
+  // Sets the field text, selecting all of it for Cmd+L's URL.
+  void SetQuery(const std::u16string& text, bool select_all);
+  std::u16string GetQuery() const;
+
+  // Replaces the list. The first row is selected, so Enter does what the
+  // ranker put on top, unless the query is unchanged and the user had moved
+  // to a row that is still listed: that row stays selected (late results
+  // never move the selection).
+  void SetRows(std::vector<Row> rows);
+  void SetRowIcon(size_t index, const ui::ImageModel& icon);
+
+  // The card's size at `width`, for the current rows.
+  gfx::Size GetCardSize(int width) const;
+
+  // Where the card is drawn and where its content rests, both in this
+  // view's coordinates. Equal except during the grow.
+  void SetCardBounds(const gfx::Rect& card, const gfx::Rect& content);
+
+  void FocusField();
+
+  // For tests.
+  const std::vector<Row>& rows_for_testing() const { return rows_; }
+  size_t selected_for_testing() const { return selected_; }
+  void SelectForTesting(size_t index) { Select(index); }
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnThemeChanged() override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+ private:
+  class CardView;
+  class ContentView;
+
+  void Select(size_t index);
+  void OnRowPressed(CommandBarRowView* row, int event_flags);
+  void OnRowHovered(CommandBarRowView* row, int event_flags);
+  std::u16string AccessibleNameFor(const Row& row) const;
+
+  const raw_ptr<Delegate> delegate_;
+  std::vector<Row> rows_;
+  std::vector<raw_ptr<CommandBarRowView>> row_views_;
+  size_t selected_ = 0;
+  // The user chose `selected_` with the keys, rather than it being the top.
+  bool user_moved_ = false;
+  std::u16string rows_query_;  // The field's text when rows_ was set.
+
+  raw_ptr<CardView> card_ = nullptr;
+  raw_ptr<ContentView> content_ = nullptr;
+  raw_ptr<views::Textfield> field_ = nullptr;
+  raw_ptr<views::View> separator_ = nullptr;
+  raw_ptr<views::View> list_ = nullptr;
+  std::unique_ptr<views::ViewShadow> shadow_;
+};
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_VIEW_H_

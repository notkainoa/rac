+}  // namespace
+
+CommandBarRowView::CommandBarRowView(const Row& row,
+                                     const std::u16string& accessible_name,
+                                     PressedCallback pressed,
+                                     PressedCallback hovered)
+    : kind_(row.kind),
+      pressed_(std::move(pressed)),
+      hovered_(std::move(hovered)) {
+  icon_ = AddChildView(std::make_unique<views::ImageView>());
+  icon_->SetImageSize({style::kRowIconSize, style::kRowIconSize});
+  icon_->SetCanProcessEventsWithinSubtree(false);
+
+  title_ = AddChildView(
+      MakeLabel(row.title, style::kRowFontSize, style::PrimaryTextColor()));
+  detail_ = AddChildView(MakeLabel(row.detail, style::kDetailFontSize,
+                                   style::SecondaryTextColor()));
+  detail_->SetVisible(!row.detail.empty());
+
+  trailing_is_pill_ = TrailingIsPill(row.kind) && !row.trailing.empty();
+  trailing_ = AddChildView(MakeLabel(
+      row.trailing,
+      trailing_is_pill_ ? style::kPillFontSize : style::kDetailFontSize,
+      style::SecondaryTextColor()));
+  trailing_->SetElideBehavior(gfx::NO_ELIDE);
+  trailing_->SetVisible(!row.trailing.empty());
+
+  hint_ = AddChildView(
+      MakeLabel(l10n_util::GetStringUTF16(IDS_RAC_COMMAND_BAR_SWITCH_TO_TAB),
+                style::kPillFontSize, style::SecondaryTextColor()));
+  hint_->SetElideBehavior(gfx::NO_ELIDE);
+  hint_->SetVisible(false);
+
+  for (views::Label* pill : {trailing_.get(), hint_.get()}) {
+    if (pill == trailing_ && !trailing_is_pill_) {
+      continue;
+    }
+    pill->SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::VH(1, tokens::kSpacing6)));
+  }
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kListBoxOption);
+  GetViewAccessibility().SetName(accessible_name);
+  GetViewAccessibility().SetIsSelected(false);
+}
+
+CommandBarRowView::~CommandBarRowView() = default;
+
+void CommandBarRowView::SetSelected(bool selected) {
+  if (selected_ == selected) {
+    return;
+  }
+  selected_ = selected;
+  GetViewAccessibility().SetIsSelected(selected);
+  UpdateTrailingVisibility();
+  SchedulePaint();  // Instant: keyboard selection never animates (S17).
+}
+
+void CommandBarRowView::SetIcon(const ui::ImageModel& icon) {
+  icon_->SetImage(icon);
+}
+
+void CommandBarRowView::UpdateTrailingVisibility() {
+  // An open tab in this space has no trailing text, so its selected state
+  // says what Enter does. Other rows keep their space name or shortcut.
+  const bool show_hint =
+      selected_ && kind_ == RowKind::kOpenTab && !trailing_->GetVisible();
+  if (hint_->GetVisible() != show_hint) {
+    hint_->SetVisible(show_hint);
+    InvalidateLayout();
+  }
+}
+
+gfx::Size CommandBarRowView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, style::kRowHeight);
+}
+
+void CommandBarRowView::Layout(PassKey) {
+  gfx::Rect bounds = GetContentsBounds();
+  bounds.Inset(gfx::Insets::VH(0, style::kRowHorizontalPadding));
+
+  const int icon_y = bounds.y() + (bounds.height() - style::kRowIconSize) / 2;
+  icon_->SetBounds(bounds.x(), icon_y, style::kRowIconSize,
+                   style::kRowIconSize);
+  int x = bounds.x() + style::kRowIconSize + style::kRowGap;
+  int right = bounds.right();
+
+  for (views::Label* end : {hint_.get(), trailing_.get()}) {
+    if (!end->GetVisible()) {
+      continue;
+    }
+    const gfx::Size size = end->GetPreferredSize();
+    right -= size.width();
+    end->SetBounds(right, bounds.y() + (bounds.height() - size.height()) / 2,
+                   size.width(), size.height());
+    right -= style::kRowGap;
+  }
+
+  // The title takes what it needs; the detail gets the rest, then the title
+  // elides only if the detail is already gone.
+  const int title_width =
+      std::min(title_->GetPreferredSize().width(), std::max(0, right - x));
+  title_->SetBounds(x, bounds.y(), title_width, bounds.height());
+  x += title_width + style::kRowGap;
+  if (detail_->GetVisible()) {
+    detail_->SetBounds(x, bounds.y(), std::max(0, right - x), bounds.height());
+  }
+}
+
+void CommandBarRowView::OnPaintBackground(gfx::Canvas* canvas) {
+  // The fill of a highlighted item in rac's menus, so the bar and the menus
+  // read as one family in light, dark, and every space theme. One row has
+  // it: the selected one, which the pointer moves too.
+  if (selected_) {
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(GetColorProvider()->GetColor(style::RowHighlightColor()));
+    canvas->DrawRoundRect(GetLocalBounds(), style::kRowRadius, fill);
+  }
+
+  if (trailing_is_pill_ || hint_->GetVisible()) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1);
+    flags.setColor(GetColorProvider()->GetColor(style::SeparatorColor()));
+    for (views::Label* pill : {trailing_.get(), hint_.get()}) {
+      if (!pill->GetVisible() || (pill == trailing_ && !trailing_is_pill_)) {
+        continue;
+      }
+      gfx::RectF rect(pill->bounds());
+      rect.Inset(0.5f);
+      canvas->DrawRoundRect(rect, rect.height() / 2, flags);
+    }
+  }
+}
+
+void CommandBarRowView::OnMouseMoved(const ui::MouseEvent& event) {
+  // Only a moving pointer selects: a list that changes under a still one
+  // (or a card that opens under it) selects nothing.
+  hovered_.Run(this, ui::EF_NONE);
+}
+
+bool CommandBarRowView::OnMousePressed(const ui::MouseEvent& event) {
+  return event.IsOnlyLeftMouseButton();
+}
+
+void CommandBarRowView::OnMouseReleased(const ui::MouseEvent& event) {
+  if (event.IsOnlyLeftMouseButton() && HitTestPoint(event.location())) {
+    pressed_.Run(this, event.flags());
+  }
+}
+
+void CommandBarRowView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  SchedulePaint();
+}
+
+BEGIN_METADATA(CommandBarRowView)
+END_METADATA
+
+CommandBarHeaderView::CommandBarHeaderView(const std::u16string& text) {
+  label_ = AddChildView(std::make_unique<views::Label>(text));
+  label_->SetFontList(
+      style::Font(style::kHeaderFontSize, gfx::Font::Weight::MEDIUM));
+  // Secondary, not tertiary: tertiary is under 3:1 on the light card.
+  label_->SetEnabledColor(style::SecondaryTextColor());
+  label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label_->SetAutoColorReadabilityEnabled(false);
+  label_->SetSubpixelRenderingEnabled(false);
+  // Not part of the results list for VoiceOver. An ignored view's children
+  // still show, so the label is ignored as well.
+  GetViewAccessibility().SetIsIgnored(true);
+  label_->GetViewAccessibility().SetIsIgnored(true);
+}
+
+CommandBarHeaderView::~CommandBarHeaderView() = default;
+
+gfx::Size CommandBarHeaderView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, style::kHeaderHeight);
+}
+
+void CommandBarHeaderView::Layout(PassKey) {
+  gfx::Rect bounds = GetContentsBounds();
+  bounds.Inset(gfx::Insets::TLBR(tokens::kSpacing6,
+                                 style::kRowHorizontalPadding, 0,
+                                 style::kRowHorizontalPadding));
+  label_->SetBoundsRect(bounds);
+}
+
+BEGIN_METADATA(CommandBarHeaderView)
+END_METADATA
+
+}  // namespace rac::command_bar

+namespace rac::command_bar {
+
+// A result row. The selected row takes the highlight of rac's menus, and
+// only one row ever shows it. Selection is instant (plan 02, S17) and
+// follows the keyboard and a moving pointer; a list that changes under a
+// still pointer selects nothing (S8's intent, without a second hover fill).
+class CommandBarRowView : public views::View {
+  METADATA_HEADER(CommandBarRowView, views::View)
+
+ public:
+  // The row, and for a click the event's flags (Cmd opens a new tab).
+  using PressedCallback =
+      base::RepeatingCallback<void(CommandBarRowView*, int event_flags)>;
+
+  CommandBarRowView(const Row& row,
+                    const std::u16string& accessible_name,
+                    PressedCallback pressed,
+                    PressedCallback hovered);
+  CommandBarRowView(const CommandBarRowView&) = delete;
+  CommandBarRowView& operator=(const CommandBarRowView&) = delete;
+  ~CommandBarRowView() override;
+
+  void SetSelected(bool selected);
+  bool selected() const { return selected_; }
+
+  // Icons may arrive after the row is shown (favicons load from disk).
+  void SetIcon(const ui::ImageModel& icon);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+  void OnMouseMoved(const ui::MouseEvent& event) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  void OnThemeChanged() override;
+
+ private:
+  void UpdateTrailingVisibility();
+
+  const RowKind kind_;
+  const PressedCallback pressed_;
+  const PressedCallback hovered_;
+  bool selected_ = false;
+  bool trailing_is_pill_ = false;
+
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> detail_ = nullptr;
+  raw_ptr<views::Label> trailing_ = nullptr;
+  // "Switch to tab", shown on the selected open-tab row only.
+  raw_ptr<views::Label> hint_ = nullptr;
+};
+
+// A section's caption ("Tabs", "History", ...). Not focusable; VoiceOver
+// hears the section through each row's description instead.
+class CommandBarHeaderView : public views::View {
+  METADATA_HEADER(CommandBarHeaderView, views::View)
+
+ public:
+  explicit CommandBarHeaderView(const std::u16string& text);
+  CommandBarHeaderView(const CommandBarHeaderView&) = delete;
+  CommandBarHeaderView& operator=(const CommandBarHeaderView&) = delete;
+  ~CommandBarHeaderView() override;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+
+ private:
+  raw_ptr<views::Label> label_ = nullptr;
+};

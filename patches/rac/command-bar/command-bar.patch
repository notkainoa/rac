+                "Tabs plus history must leave exactly one row of room.");
+  static_assert(kMaxSuggestions > 1, "One row of room must be the limit.");
+
+  Inputs inputs;
+  AddTabs(inputs, kMaxTabs);
+  AddHistory(inputs, kHistoryRows);
+  inputs.engine.push_back(MakeSearch(u"alpha", 50));
+  AddSuggestions(inputs, kMaxSuggestions);

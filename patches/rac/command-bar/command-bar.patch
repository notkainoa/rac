+  const RankedRows ranked = Rank(AlphaQuery(), inputs);
+  EXPECT_EQ(ranked.local_count, kMaxRows - 1);
+  EXPECT_EQ(CountKind(ranked, RowKind::kSuggestion), 1u);
+  EXPECT_EQ(ranked.rows.back().kind, RowKind::kSuggestion);
+}

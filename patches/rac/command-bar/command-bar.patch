+std::unique_ptr<views::Label> MakeLabel(const std::u16string& text,
+                                        int size,
+                                        ui::ColorId color) {
+  auto label = std::make_unique<views::Label>(text);
+  label->SetFontList(style::Font(size));
+  label->SetEnabledColor(color);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetElideBehavior(gfx::ELIDE_TAIL);
+  label->SetAutoColorReadabilityEnabled(false);
+  // The card's content layer is transparent (its corners), so no subpixel
+  // text, which macOS doesn't use anyway.
+  label->SetSubpixelRenderingEnabled(false);
+  label->SetCanProcessEventsWithinSubtree(false);
+  return label;
+}
+
+// The trailing text is a pill when it names another space, plain text when
+// it is a shortcut.
+bool TrailingIsPill(RowKind kind) {
+  return kind == RowKind::kOpenTab || kind == RowKind::kPinnedTab;
+}

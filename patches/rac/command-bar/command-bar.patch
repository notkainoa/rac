+                    kMaxHistory <= kMaxRows && kMaxActions <= kMaxRows,
+                "Each section alone must fit under kMaxRows.");
+  constexpr size_t kExtra = 2;
+  {
+    Inputs inputs;
+    AddTabs(inputs, kMaxTabs + kExtra);
+    const RankedRows ranked = Rank(AlphaQuery(), inputs);
+    EXPECT_EQ(CountKind(ranked, RowKind::kOpenTab), kMaxTabs);
+    // The most recent tabs survive the cut.
+    EXPECT_EQ(ranked.rows.front().ref, "tab0");
+  }
+  {
+    Inputs inputs;
+    AddPinned(inputs, kMaxSaved + kExtra);
+    const RankedRows ranked = Rank(AlphaQuery(), inputs);
+    EXPECT_EQ(CountKind(ranked, RowKind::kPinnedTab), kMaxSaved);
+    EXPECT_EQ(ranked.rows.front().ref, "pinned0");
+  }
+  {
+    Inputs inputs;
+    AddHistory(inputs, kMaxHistory + kExtra);
+    const RankedRows ranked = Rank(AlphaQuery(), inputs);
+    EXPECT_EQ(CountKind(ranked, RowKind::kHistory), kMaxHistory);
+    EXPECT_EQ(ranked.rows.front().result_index, 0u);
+  }
+  {
+    Inputs inputs;
+    AddActions(inputs, kMaxActions + kExtra);
+    const RankedRows ranked = Rank(AlphaQuery(), inputs);
+    EXPECT_EQ(CountKind(ranked, RowKind::kAction), kMaxActions);
+    EXPECT_EQ(ranked.rows.front().ref, "action0");
+  }
+}
+
+TEST(CommandBarRankerTest, RankTrimsToMaxRowsHistoryFirstActionsLast) {
+  constexpr size_t kTotal = kMaxTabs + kMaxSaved + kMaxHistory + kMaxActions;
+  static_assert(kTotal > kMaxRows, "The sections must overflow kMaxRows.");
+  constexpr size_t kExcess = kTotal - kMaxRows;
+  static_assert(kExcess >= kMaxHistory - 1,
+                "History alone cannot absorb the excess.");
+  constexpr size_t kTabCut = kExcess - (kMaxHistory - 1);
+  static_assert(kTabCut + 1 <= kMaxTabs,
+                "History and tabs together must absorb the excess.");
+  static_assert(kMaxHistory >= 1 && kMaxSaved >= 1 && kMaxActions >= 1,
+                "Every section must be able to keep a row.");
+
+  Inputs inputs;
+  // Feed more than each cap so the caps apply before the trim.
+  AddTabs(inputs, kMaxTabs + 2);
+  AddPinned(inputs, kMaxSaved + 2);
+  AddHistory(inputs, kMaxHistory + 2);
+  AddActions(inputs, kMaxActions + 2);
+  inputs.engine.push_back(MakeSearch(u"alpha", 50));
+  AddSuggestions(inputs, kMaxSuggestions);
+
+  const RankedRows ranked = Rank(AlphaQuery(), inputs);
+  EXPECT_EQ(ranked.local_count, kMaxRows);
+  EXPECT_EQ(CountLocalRows(ranked), kMaxRows);
+  // History gave way to a single row; tabs lost the rest of the excess.
+  EXPECT_EQ(CountKind(ranked, RowKind::kHistory), 1u);
+  EXPECT_EQ(CountKind(ranked, RowKind::kOpenTab), kMaxTabs - kTabCut);
+  // Pinned tabs and actions kept everything the caps allow.
+  EXPECT_EQ(CountKind(ranked, RowKind::kPinnedTab), kMaxSaved);
+  EXPECT_EQ(CountKind(ranked, RowKind::kAction), kMaxActions);
+  // The search row is not local and the full list leaves no room for
+  // suggestions.
+  EXPECT_EQ(ranked.rows.back().kind, RowKind::kSearch);
+  EXPECT_EQ(CountKind(ranked, RowKind::kSuggestion), 0u);
+}
+
+TEST(CommandBarRankerTest, RankKeepsOneRowOfEachNonEmptySectionWhenTrimming) {

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_actions.h"
+
+#include <string>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/actions/rac_actions.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_shortcuts/browser_shortcut_service.h"
+#include "chrome/browser/ui/browser_shortcuts/browser_shortcut_service_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/rac/rac_action_handlers.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace rac::command_bar {
+
+namespace {
+
+using action_table::Action;
+using action_table::ActionContext;
+using action_table::Dispatch;
+using action_table::Surface;
+
+// A row's live shortcut. Helium's shortcut service holds the user's
+// rebinds; BrowserView::GetAccelerator only knows Mac's static defaults
+// (browser_view.cc:1641-1650 in Chromium 156), so it is the fallback.
+std::u16string ShortcutText(BrowserWindowInterface* browser, int command_id) {
+  browser_shortcuts::BrowserShortcutService* service =
+      browser_shortcuts::BrowserShortcutServiceFactory::GetForProfile(
+          browser->GetProfile());
+  if (service && service->HasCommand(command_id)) {
+    // Empty when the user removed the command's last shortcut.
+    for (const auto& [accelerator, id] : service->GetAcceleratorMap()) {
+      if (id == command_id) {
+        return accelerator.GetShortcutText();
+      }
+    }
+    return std::u16string();
+  }
+  BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser);
+  ui::Accelerator accelerator;
+  if (!view || !view->GetAccelerator(command_id, &accelerator)) {
+    return std::u16string();
+  }
+  return accelerator.GetShortcutText();
+}
+
+// Whether the bar can run `action` from `browser` at all.
+bool CanRun(BrowserWindowInterface* browser, const Action& action) {
+  switch (action.dispatch) {
+    case Dispatch::kCommand:
+      // Listed only while Chromium's command is enabled, as its menu item
+      // would be.
+      return action.command_id &&
+             chrome::IsCommandEnabled(browser, action.command_id);
+    case Dispatch::kBrowser:
+      // Core's handler test guarantees a handler for every kBrowser row.
+      return true;
+    case Dispatch::kAgentController:
+      // The agent runs these; the bar never offers one.
+      return false;
+  }
+}
+
+}  // namespace
+
+std::vector<ActionCandidate> CollectActions(BrowserWindowInterface* browser) {
+  std::vector<ActionCandidate> candidates;
+  const ActionContext context = action_table::ContextForWindow(browser);
+  int index = 0;
+  for (const Action* action :
+       action_table::ForSurface(Surface::kCommandBar, context)) {
+    if (!action->label_id || !CanRun(browser, *action)) {
+      continue;
+    }
+    ActionCandidate candidate;
+    candidate.id = std::string(action->id);
+    candidate.label = l10n_util::GetStringUTF16(action->label_id);
+    if (action->keywords_id) {
+      candidate.keywords = l10n_util::GetStringUTF16(action->keywords_id);
+    }
+    if (action->command_id) {
+      candidate.shortcut = ShortcutText(browser, action->command_id);
+    }
+    candidate.suggested = action->surfaces.Has(Surface::kCommandBarSuggested);
+    candidate.takes_query = !action->query_arg.empty();
+    candidate.table_index = index++;
+    candidates.push_back(std::move(candidate));
+  }
+  return candidates;
+}
+
+const gfx::VectorIcon* ActionIcon(std::string_view id) {
+  const Action* action = action_table::Find(id);
+  return action ? action->icon : nullptr;
+}
+
+bool RunAction(BrowserWindowInterface* browser,
+               std::string_view id,
+               const std::u16string& query) {
+  // The row is looked up again through ForSurface, so a row that stopped
+  // being available while the bar was open (AI turned off, the last tab
+  // closed) doesn't run.
+  const ActionContext context = action_table::ContextForWindow(browser);
+  for (const Action* action :
+       action_table::ForSurface(Surface::kCommandBar, context)) {
+    if (action->id != id || !CanRun(browser, *action)) {
+      continue;
+    }
+    switch (action->dispatch) {
+      case Dispatch::kCommand:
+        return chrome::ExecuteCommand(browser, action->command_id);
+      case Dispatch::kBrowser: {
+        base::DictValue args;
+        if (!action->query_arg.empty()) {
+          args.Set(action->query_arg, base::UTF16ToUTF8(query));
+        }
+        action_table::RunBrowserAction(*action, context, args);
+        return true;
+      }
+      case Dispatch::kAgentController:
+        return false;
+    }
+  }
+  return false;
+}
+
+}  // namespace rac::command_bar

+  AddHistory(inputs, kMaxHistory);
+  AddActions(inputs, kMaxActions);
+
+  const RankedRows ranked = Rank(AlphaQuery(), inputs);
+  EXPECT_GE(CountKind(ranked, RowKind::kOpenTab), 1u);
+  EXPECT_GE(CountKind(ranked, RowKind::kPinnedTab), 1u);
+  EXPECT_GE(CountKind(ranked, RowKind::kHistory), 1u);
+  EXPECT_GE(CountKind(ranked, RowKind::kAction), 1u);
+}

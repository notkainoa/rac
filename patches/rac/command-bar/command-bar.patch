+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ACTIONS_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ACTIONS_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_types.h"
+
+class BrowserWindowInterface;
+
+namespace gfx {
+struct VectorIcon;
+}
+
+// The command bar's only door to the action table. The bar never checks the
+// AI switch: Core's ContextForWindow() fills the context, and `ForSurface`
+// has already dropped `ai_only` rows and rows whose availability fails with
+// AI off (ruling 16), so with AI off no Ask row, no AI label, and no AI code
+// path exists here.
+namespace rac::command_bar {
+
+// Core's Ask row (AI on only). The bar words it "Ask about “…”" and gives it
+// the assistant's mark.
+inline constexpr char kAskActionId[] = "ask";
+
+// The table's command bar rows for `browser`, read on each open. Rows the
+// agent runs (Dispatch::kAgentController) are never listed, and a kCommand
+// row is listed only while Chromium's command is enabled.
+std::vector<ActionCandidate> CollectActions(BrowserWindowInterface* browser);
+
+// The row's icon, or null for the generic one.
+const gfx::VectorIcon* ActionIcon(std::string_view id);
+
+// Runs row `id`: a kCommand row through chrome::ExecuteCommand with its
+// command id, a kBrowser row through Core's handler lookup. One function
+// call, no service. `query` reaches rows that take one (Ask) as their query
+// argument. Returns false if the row is gone or didn't run.
+bool RunAction(BrowserWindowInterface* browser,
+               std::string_view id,
+               const std::u16string& query);
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ACTIONS_H_

@@ -0,0 +1,153 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_engine_convert.h"
+
+#include <utility>
+
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_match_type.h"
+#include "components/omnibox/browser/autocomplete_provider.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "third_party/metrics_proto/omnibox_input_type.pb.h"
+
+namespace rac::command_bar {
+
+namespace {
+
+using Provider = AutocompleteProvider::Type;
+
+// Written against Chromium 156, where provider and match types are enum
+// classes (on 154 they were TYPE_* and URL_WHAT_YOU_TYPED-style constants).
+constexpr Provider kLocalProviders =
+    Provider::kBuiltin | Provider::kKeyword | Provider::kSearch;
+constexpr Provider kHistoryProviders =
+    Provider::kHistoryQuick | Provider::kHistoryUrl | Provider::kHistoryFuzzy |
+    Provider::kBookmark | Provider::kShortcuts;
+
+// Providers whose rows come from the regular profile's history, bookmarks,
+// or shortcuts. Includes ones the bar never creates, for safety.
+bool IsHistoryBacked(const AutocompleteMatch& match) {
+  if (!match.provider) {
+    return false;
+  }
+  const Provider type = match.provider->type();
+  return (type & (kHistoryProviders | Provider::kHistoryClusterProvider |
+                  Provider::kHistoryEmbeddings)) != Provider::kNone;
+}
+
+}  // namespace
+
+int AllowedProviderTypes(bool off_the_record) {
+  // SearchProvider sends nothing until the engine allows remote suggestions
+  // (D29, CommandBarProviderClient::SearchSuggestEnabled). Never created: open
+  // tabs (rac lists its own), zero-suggest, Drive, most visited, clipboard,
+  // query tiles, tab groups, other devices, recently closed, calculator,
+  // starter-pack and enterprise scopes, extensions, on-device models, and
+  // history embeddings and clusters.
+  Provider allowed = kLocalProviders;
+  if (!off_the_record) {
+    allowed |= kHistoryProviders;
+  }
+  return static_cast<int>(allowed);
+}
+
+std::optional<RowKind> KindOf(const AutocompleteMatch& match) {
+  if (match.provider && match.provider->type() == Provider::kBuiltin) {
+    return RowKind::kHistory;
+  }
+  using Type = omnibox::AutocompleteMatchType;
+  switch (match.type) {
+    case Type::kUrlWhatYouTyped:
+      return RowKind::kTypedUrl;
+    case Type::kSearchWhatYouTyped:
+    case Type::kSearchOtherEngine:
+      return RowKind::kSearch;
+    case Type::kSearchHistory:
+      return RowKind::kHistory;
+    // Rows the bar draws itself, scopes it does not offer, and messages.
+    case Type::kOpenTab:
+    case Type::kTabGroup:
+    case Type::kCrossDeviceTab:
+    case Type::kStarterPack:
+    case Type::kFeaturedEnterpriseSearch:
+    case Type::kCalculator:
+    case Type::kPedal:
+    case Type::kNullResultMessage:
+    case Type::kHistoryEmbeddingsAnswer:
+      return std::nullopt;
+    case Type::kNavsuggest:
+    case Type::kNavsuggestPersonalized:
+    case Type::kTileNavsuggest:
+      return RowKind::kSuggestion;
+    default:
+      break;
+  }
+  return AutocompleteMatch::IsSearchType(match.type)
+             ? std::optional<RowKind>(RowKind::kSuggestion)
+             : std::optional<RowKind>(RowKind::kHistory);
+}
+
+std::vector<EngineCandidate> ConvertResult(
+    const AutocompleteResult& result,
+    const AutocompleteInput& input,
+    bool off_the_record,
+    const TemplateURLService* template_urls) {
+  std::vector<EngineCandidate> candidates;
+  bool has_typed_url = false;
+  for (size_t i = 0; i < result.size(); ++i) {
+    const AutocompleteMatch& match = result.match_at(i);
+    std::optional<RowKind> kind = KindOf(match);
+    if (!kind || (off_the_record && IsHistoryBacked(match))) {
+      continue;
+    }
+    // A keyword with nothing to search yet ("!w" alone) is the keyword
+    // provider's placeholder row, with no destination. The bar has no
+    // keyword mode to offer it in.
+    if (AutocompleteMatch::IsSearchType(match.type) &&
+        !match.destination_url.is_valid()) {
+      continue;
+    }
+    const AutocompleteMatch shown =
+        match.GetMatchWithContentsAndDescriptionPossiblySwapped();
+    EngineCandidate candidate;
+    candidate.kind = *kind;
+    candidate.title = shown.contents;
+    candidate.detail = shown.description;
+    // A keyword's row always names its engine, even where Chromium wrote no
+    // description (it writes one per run of matches with the same keyword).
+    const bool other_engine =
+        match.type == omnibox::AutocompleteMatchType::kSearchOtherEngine;
+    if (AutocompleteMatch::IsSearchType(match.type) &&
+        (!candidate.detail.empty() || other_engine) && template_urls) {
+      if (const TemplateURL* engine = match.GetTemplateURL(template_urls)) {
+        candidate.detail = engine->AdjustedShortNameForLocaleDirection();
+      }
+    }
+    candidate.url = match.destination_url;
+    candidate.is_default = i == 0 && match.allowed_to_be_default_match;
+    candidate.is_bang =
+        match.type == omnibox::AutocompleteMatchType::kSearchOtherEngine;
+    candidate.result_index = i;
+    has_typed_url |= *kind == RowKind::kTypedUrl;
+    candidates.push_back(std::move(candidate));
+  }
+  if (off_the_record && !has_typed_url &&
+      input.type() == metrics::OmniboxInputType::URL &&
+      input.canonicalized_url().is_valid()) {
+    EngineCandidate typed;
+    typed.kind = RowKind::kTypedUrl;
+    typed.title = input.text();
+    typed.url = input.canonicalized_url();
+    typed.is_default = true;
+    typed.result_index = kSyntheticTypedUrl;
+    candidates.insert(candidates.begin(), std::move(typed));
+  }
+  return candidates;
+}
+
+}  // namespace rac::command_bar

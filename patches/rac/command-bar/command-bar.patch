+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ENGINE_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ENGINE_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_types.h"
+#include "components/omnibox/browser/autocomplete_controller.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "ui/base/window_open_disposition.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace rac::command_bar {
+
+class CommandBarProviderClient;
+
+// Drives Chromium's AutocompleteController for the command bar, so search,
+// history, the default engine, and Helium's bangs behave as in the address
+// bar. It owns its own controller: the address bar's is untouched, and the
+// autocomplete code gets no hunk.
+//
+// Privacy (D29): every pass runs the local providers, including their
+// asynchronous part (HistoryURLProvider's pass over the on-disk history
+// database), so history rows never wait for the search engine. A local pass
+// switches remote suggestions off in the provider client, so nothing goes
+// over the network; only StartWithSuggestions() switches them on, and the
+// controller calls it only after ShouldAskSearchEngine() and the pause.
+// The providers are an allow-list (AllowedProviderTypes), and the provider
+// client never starts a service worker or prefetches an image
+// (CommandBarProviderClient). Off the record it reads nothing of the
+// regular profile.
+class CommandBarEngine : public AutocompleteController::Observer {
+ public:
+  CommandBarEngine(Profile* profile, base::RepeatingClosure on_changed);
+  CommandBarEngine(const CommandBarEngine&) = delete;
+  CommandBarEngine& operator=(const CommandBarEngine&) = delete;
+  ~CommandBarEngine() override;
+
+  // Runs the local providers with remote suggestions off. The synchronous
+  // providers answer before this returns, so the first rows paint in the
+  // same frame; rows from the on-disk history database arrive later through
+  // `on_changed`.
+  void StartLocal(const std::u16string& text);
+
+  // Runs `text` again with remote suggestions allowed, so SearchProvider
+  // may ask the search engine. Rows arrive later through `on_changed`.
+  void StartWithSuggestions(const std::u16string& text);
+
+  // Stops providers and clears the result. Used for the empty state.
+  void Clear();
+
+  bool input_is_url() const;
+
+  // The current result, converted (see ConvertResult). Empty after Clear().
+  std::vector<EngineCandidate> Candidates() const;
+
+  // Opens the row with `result_index` from the last Candidates(). Returns
+  // false, doing nothing, if that result is gone (the bar closed and cleared
+  // it). Everything it needs is read before navigating, so the bar may
+  // close and clear the engine while Navigate() runs.
+  bool Open(size_t result_index,
+            BrowserWindowInterface* browser,
+            WindowOpenDisposition disposition);
+
+ private:
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override;
+
+  void Start(const std::u16string& text);
+
+  const raw_ptr<Profile> profile_;
+  const base::RepeatingClosure on_changed_;
+  std::unique_ptr<AutocompleteController> controller_;
+  // Non-owning: `controller_` owns the client. Declared after it so the
+  // pointer is destroyed first.
+  raw_ptr<CommandBarProviderClient> client_ = nullptr;
+  base::ScopedObservation<AutocompleteController,
+                          AutocompleteController::Observer>
+      observation_{this};
+  std::unique_ptr<AutocompleteInput> input_;
+  base::TimeTicks input_start_;
+  // True only for a pass started by StartWithSuggestions().
+  bool remote_pass_ = false;
+};
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ENGINE_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_grow_animation.h"
+
+#include <algorithm>
+
+#include "base/logging.h"
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_style.h"
+#include "ui/gfx/animation/tween.h"
+
+namespace rac::command_bar {
+
+CommandBarGrowAnimation::CommandBarGrowAnimation(ui::Compositor* compositor,
+                                                 const gfx::Rect& from,
+                                                 const gfx::Rect& to,
+                                                 StepCallback step)
+    : compositor_(compositor),
+      from_(from),
+      to_(to),
+      step_(std::move(step)),
+      curve_(style::kCommandBarGrowCurve.x1,
+             style::kCommandBarGrowCurve.y1,
+             style::kCommandBarGrowCurve.x2,
+             style::kCommandBarGrowCurve.y2) {}
+
+CommandBarGrowAnimation::~CommandBarGrowAnimation() {
+  Stop();
+}
+
+void CommandBarGrowAnimation::Start() {
+  if (running_ || !compositor_) {
+    step_.Run(to_);
+    return;
+  }
+  running_ = true;
+  // The first frame shows the card exactly over the field; the clock starts
+  // at that frame's timestamp.
+  start_ = base::TimeTicks();
+  steps_ = 0;
+  step_.Run(from_);
+  compositor_->AddAnimationObserver(this);
+}
+
+void CommandBarGrowAnimation::Finish() {
+  if (!running_) {
+    return;
+  }
+  Stop();
+  step_.Run(to_);
+  if (on_finished_) {
+    std::move(on_finished_).Run();
+  }
+}
+
+void CommandBarGrowAnimation::OnAnimationStep(base::TimeTicks timestamp) {
+  // A new window's first frames can arrive late (35-85 ms measured) while
+  // macOS shows it. The grow waits through that instead of skipping its
+  // start, so it always plays from the field.
+  constexpr base::TimeDelta kFrame =
+      base::Hertz(60);  // motion-lint: not motion (spots a late frame)
+  constexpr int kSettleSteps = 3;
+  if (start_.is_null()) {
+    start_ = timestamp;
+  } else if (steps_ < kSettleSteps && timestamp - last_step_ > 2 * kFrame) {
+    start_ += timestamp - last_step_ - kFrame;
+  }
+  last_step_ = timestamp;
+  ++steps_;
+  const double t =
+      std::clamp((timestamp - start_) / style::kCommandBarGrow, 0.0, 1.0);
+  // For measuring the grow: --vmodule=command_bar_grow_animation=1.
+  VLOG(1) << "rac command bar grow: frame at "
+          << (timestamp - start_).InMillisecondsF() << " ms, t " << t;
+  if (t >= 1.0) {
+    Finish();
+    return;
+  }
+  step_.Run(gfx::Tween::RectValueBetween(curve_.Solve(t), from_, to_));
+}
+
+void CommandBarGrowAnimation::OnCompositingShuttingDown(
+    ui::Compositor* compositor) {
+  Stop();
+  compositor_ = nullptr;
+}
+
+void CommandBarGrowAnimation::Stop() {
+  if (running_ && compositor_) {
+    compositor_->RemoveAnimationObserver(this);
+  }
+  running_ = false;
+}
+
+}  // namespace rac::command_bar

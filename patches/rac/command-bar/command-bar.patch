+  AddSuggestions(inputs, kMaxSuggestions + 3);
+
+  const RankedRows ranked = Rank(AlphaQuery(), inputs);
+  EXPECT_EQ(CountKind(ranked, RowKind::kSuggestion), kMaxSuggestions);
+  EXPECT_EQ(ranked.rows.front().kind, RowKind::kSearch);
+  EXPECT_EQ(ranked.rows.back().kind, RowKind::kSuggestion);
+  // The first suggestions in the engine's order are the ones kept.
+  EXPECT_EQ(ranked.rows[1].result_index, 100u);
+}

+#include "ui/base/base_window.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace rac::command_bar {
+
+namespace {
+
+// Refs are opaque to the ranker and the views. Their forms:
+//   tab:<TabHandle raw value>
+//   stored:<space uuid>:<url>      a tab of a space that is only in the store
+//   pinned:<space uuid>:<item id>
+//   favorite:<item id>
+constexpr std::string_view kTabRef = "tab:";
+constexpr std::string_view kStoredRef = "stored:";
+constexpr std::string_view kPinnedRef = "pinned:";
+constexpr std::string_view kFavoriteRef = "favorite:";
+
+std::u16string SpaceName(const SpacesService& service, const SpaceId& id) {
+  const Space* space = service.FindSpace(id);
+  if (!space) {
+    return std::u16string();
+  }
+  if (!space->name.empty()) {
+    return base::UTF8ToUTF16(space->name);
+  }
+  // GetIndex() is optional (spaces_service.h:61); FindSpace() just found it.
+  return l10n_util::GetStringFUTF16(
+      IDS_RAC_SPACE_FALLBACK_NAME,
+      base::NumberToString16(service.GetIndex(id).value_or(0) + 1));
+}
+
+// Splits "<uuid>:<rest>".
+std::optional<std::pair<SpaceId, std::string>> SplitSpace(
+    std::string_view value) {
+  const size_t colon = value.find(':');
+  if (colon == std::string_view::npos) {
+    return std::nullopt;
+  }
+  SpaceId space = SpaceId::ParseLowercase(value.substr(0, colon));
+  if (!space.is_valid()) {
+    return std::nullopt;
+  }
+  return std::make_pair(space, std::string(value.substr(colon + 1)));
+}
+
+void ActivateTab(tabs::TabInterface* tab) {
+  BrowserWindowInterface* holder = tab->GetBrowserWindowInterface();
+  holder->GetTabStripModel()->ActivateTab(tab);
+  holder->GetWindow()->Activate();
+}
+
+// The window that shows `space`, after showing it in `browser` if no window
+// does. ShowSpace() moves or restores the space's tabs synchronously.
+BrowserWindowInterface* ShowSpaceSomewhere(SpacesWindowManager& manager,
+                                           BrowserWindowInterface* browser,
+                                           const SpaceId& space) {
+  if (BrowserWindowInterface* holder = manager.GetWindowHoldingSpace(space)) {
+    return holder;
+  }
+  manager.ShowSpace(browser, space);
+  return browser;
+}
+
+// A pinned tab's live tab appears after the window's sidebar reconciles,
+// which ShowSpace() posts. A task posted after it on the same sequence runs
+// after it, so the tab exists by then.
+void ActivateItem(base::WeakPtr<BrowserWindowInterface> window,
+                  const std::string& item_id) {
+  if (!window) {
+    return;
+  }
+  SidebarWindowSync* sync = SidebarWindows::ForBrowser(window.get());
+  if (tabs::TabInterface* tab = sync ? sync->GetTabForItem(item_id) : nullptr) {
+    ActivateTab(tab);
+  }
+}
+
+}  // namespace
+
+std::vector<TabCandidate> CollectTabs(BrowserWindowInterface* browser) {
+  std::vector<TabCandidate> tabs;
+  tabs::TabInterface* active = browser->GetTabStripModel()->GetActiveTab();
+
+  if (Profile* otr = browser->GetProfile(); otr->IsOffTheRecord()) {
+    // Every window of this incognito profile, and only those: the profile
+    // check guards against a collection that also holds other profiles.
+    ProfileBrowserCollection::GetForProfile(otr)->ForEach(
+        [&](BrowserWindowInterface* window) {
+          if (window->GetProfile() != otr) {
+            return true;
+          }
+          for (tabs::TabInterface* tab : *window->GetTabStripModel()) {
+            TabCandidate candidate;
+            candidate.ref = std::string(kTabRef) +
+                            base::NumberToString(tab->GetHandle().raw_value());
+            candidate.title = TabUIHelper::From(tab)->GetTitle();
+            candidate.url = tab->GetContents()->GetVisibleURL();
+            candidate.in_current_space = true;
+            candidate.in_this_window = window == browser;
+            candidate.is_active_tab = tab == active;
+            candidate.last_active = tab->GetLastActiveTime();
+            tabs.push_back(std::move(candidate));
+          }
+          return true;
+        });
+    return tabs;
+  }
+
+  Profile* profile = browser->GetProfile();
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  if (!service || !manager) {
+    return tabs;  // Not a normal window; the bar is not offered there.
+  }
+  const std::optional<SpaceId> current = manager->GetActiveSpaceId(browser);
+  // Spaces with at least one live tab, loaded or discarded.
+  std::set<SpaceId> live_spaces;
+
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* window) {
+        for (tabs::TabInterface* tab : *window->GetTabStripModel()) {
+          content::WebContents* contents = tab->GetContents();
+          const std::optional<SpaceId> space = SpaceTabTag::Get(contents);
+          // An untagged tab in another window is a placeholder or not yet
+          // placed. In this window it is an open tab the user can see.
+          if (tab->IsPinned() || (!space && window != browser)) {
+            continue;
+          }
+          if (space) {
+            live_spaces.insert(*space);
+          }
+          // Favorites' and pinned tabs' live tabs are CollectSaved()'s.
+          if (!GetSidebarItemId(contents).empty()) {
+            continue;
+          }
+          TabCandidate candidate;
+          candidate.ref = std::string(kTabRef) +
+                          base::NumberToString(tab->GetHandle().raw_value());
+          candidate.title = TabUIHelper::From(tab)->GetTitle();
+          candidate.url = contents->GetVisibleURL();
+          if (space) {
+            candidate.space_id = space->AsLowercaseString();
+            candidate.space_name = SpaceName(*service, *space);
+          }
+          // An untagged tab belongs to the space this window shows.
+          candidate.in_current_space = !space || space == current;
+          candidate.in_this_window = window == browser;
+          candidate.is_active_tab = tab == active;
+          candidate.last_active = tab->GetLastActiveTime();
+          tabs.push_back(std::move(candidate));
+        }
+        return true;
+      });
+
+  // A space with no live tab at all exists only in the store (not yet shown
+  // since startup). Its tabs come from Data's GetStoredTabs().
+  // IsSpaceUnloaded() is not the test: it is also true when every live tab is
+  // discarded, and those tabs were listed above. Stored pinned tabs are
+  // CollectSaved()'s.
+  for (const Space& space : service->spaces()) {
+    if (live_spaces.contains(space.id) || manager->HasLiveTabs(space.id)) {
+      continue;
+    }
+    for (const StoredTabSummary& stored : manager->GetStoredTabs(space.id)) {
+      if (stored.pinned) {
+        continue;
+      }
+      TabCandidate candidate;
+      candidate.ref = std::string(kStoredRef) + space.id.AsLowercaseString() +
+                      ":" + stored.url.spec();
+      candidate.title = stored.title;
+      candidate.url = stored.url;
+      candidate.space_id = space.id.AsLowercaseString();
+      candidate.space_name = SpaceName(*service, space.id);
+      candidate.in_current_space = space.id == current;
+      candidate.stored = true;
+      candidate.last_active = stored.last_active;
+      tabs.push_back(std::move(candidate));
+    }
+  }
+  return tabs;
+}
+
+std::vector<SavedCandidate> CollectSaved(BrowserWindowInterface* browser) {
+  std::vector<SavedCandidate> saved;
+  Profile* profile = browser->GetProfile();
+  // An incognito window must not read the regular profile's sidebar items,
+  // whatever the factories below happen to return for it.
+  if (profile->IsOffTheRecord()) {
+    return {};
+  }
+  SidebarItems* items = SidebarItems::Get(profile);
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  if (!items || !service || !manager) {
+    return saved;  // Guest has neither.
+  }
+  const std::optional<SpaceId> current = manager->GetActiveSpaceId(browser);
+  SidebarWindowSync* sync = SidebarWindows::ForBrowser(browser);
+  tabs::TabInterface* active = browser->GetTabStripModel()->GetActiveTab();
+
+  for (const Space& space : service->spaces()) {
+    int index = 0;
+    for (const SidebarItem* item :
+         items->GetList(SidebarItems::PinnedListKey(space.id)).AllItems()) {
+      SavedCandidate candidate;
+      candidate.ref = std::string(kPinnedRef) + space.id.AsLowercaseString() +
+                      ":" + item->id;
+      candidate.title = item->name.empty() ? item->title : item->name;
+      candidate.pinned_url = item->url;
+      candidate.url = item->url;
+      // In this window's space, the live tab may have moved on.
+      if (sync && space.id == current) {
+        if (tabs::TabInterface* tab = sync->GetTabForItem(item->id)) {
+          candidate.url = tab->GetContents()->GetVisibleURL();
+          candidate.is_active_tab = tab == active;
+        }
+      }
+      candidate.space_name = SpaceName(*service, space.id);
+      candidate.in_current_space = space.id == current;
+      candidate.sidebar_index = index++;
+      saved.push_back(std::move(candidate));
+    }
+  }
+
+  int index = 0;
+  for (const SidebarItem* item :
+       items->GetList(SidebarItems::kFavorites).AllItems()) {
+    SavedCandidate candidate;
+    candidate.ref = std::string(kFavoriteRef) + item->id;
+    candidate.is_favorite = true;
+    candidate.title = item->name.empty() ? item->title : item->name;
+    candidate.url = item->url;
+    if (tabs::TabInterface* tab =
+            sync ? sync->GetTabForItem(item->id) : nullptr) {
+      candidate.url = tab->GetContents()->GetVisibleURL();
+      candidate.is_active_tab = tab == active;
+    }
+    candidate.in_current_space = true;
+    candidate.sidebar_index = index++;
+    saved.push_back(std::move(candidate));
+  }
+  return saved;
+}
+
+ui::ImageModel TabFavicon(const std::string& ref) {
+  std::string_view value(ref);
+  int32_t raw = 0;
+  if (!value.starts_with(kTabRef) ||
+      !base::StringToInt(value.substr(kTabRef.size()), &raw)) {
+    return ui::ImageModel();
+  }
+  tabs::TabInterface* tab = tabs::TabHandle(raw).Get();
+  return tab ? TabUIHelper::From(tab)->GetFavicon() : ui::ImageModel();
+}
+
+bool ActivateRef(BrowserWindowInterface* browser, const std::string& ref) {
+  std::string_view value(ref);
+
+  if (value.starts_with(kTabRef)) {
+    int32_t raw = 0;
+    if (!base::StringToInt(value.substr(kTabRef.size()), &raw)) {
+      return false;
+    }
+    tabs::TabInterface* tab = tabs::TabHandle(raw).Get();
+    if (!tab) {
+      return false;
+    }
+    // A hidden space's tab can sit in any window's strip. Show its space
+    // first, so the switch is explicit, not a posted reconcile.
+    if (SpacesWindowManager* manager = SpacesWindowManager::From(browser)) {
+      if (std::optional<SpaceId> space = SpaceTabTag::Get(tab->GetContents());
+          space && manager->GetActiveSpaceId(browser) != space) {
+        ShowSpaceSomewhere(*manager, browser, *space);
+        tab = tabs::TabHandle(raw).Get();  // Re-resolve after the move.
+        if (!tab) {
+          return false;
+        }
+      }
+    }
+    ActivateTab(tab);
+    return true;
+  }
+
+  if (value.starts_with(kStoredRef)) {
+    SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+    auto parsed = SplitSpace(value.substr(kStoredRef.size()));
+    if (!manager || !parsed) {
+      return false;
+    }
+    BrowserWindowInterface* window =
+        ShowSpaceSomewhere(*manager, browser, parsed->first);
+    const GURL url(parsed->second);
+    for (tabs::TabInterface* tab : *window->GetTabStripModel()) {
+      if (SpaceTabTag::Get(tab->GetContents()) == parsed->first &&
+          tab->GetContents()->GetVisibleURL() == url) {
+        ActivateTab(tab);
+        return true;
+      }
+    }
+    // The space is showing; its last-active tab is a fine landing.
+    window->GetWindow()->Activate();
+    return true;
+  }
+
+  if (value.starts_with(kPinnedRef)) {
+    SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+    auto parsed = SplitSpace(value.substr(kPinnedRef.size()));
+    if (!manager || !parsed) {
+      return false;
+    }
+    BrowserWindowInterface* window =
+        ShowSpaceSomewhere(*manager, browser, parsed->first);
+    if (window == browser && SidebarWindows::ForBrowser(browser) &&
+        SidebarWindows::ForBrowser(browser)->GetTabForItem(parsed->second)) {
+      ActivateItem(browser->GetWeakPtr(), parsed->second);
+    } else {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&ActivateItem, window->GetWeakPtr(), parsed->second));
+    }
+    return true;
+  }
+
+  if (value.starts_with(kFavoriteRef)) {
+    // Every window has its own tab per favorite; never switch windows.
+    SidebarWindowSync* sync = SidebarWindows::ForBrowser(browser);
+    tabs::TabInterface* tab =
+        sync ? sync->GetTabForItem(value.substr(kFavoriteRef.size())) : nullptr;
+    if (!tab) {
+      return false;
+    }
+    ActivateTab(tab);
+    return true;
+  }
+  return false;
+}
+
+}  // namespace rac::command_bar

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_handlers.h"
+
+#include <string>
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/views/rac/ai/assistant_side_panel.h"
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_controller.h"
+
+namespace rac::command_bar {
+
+// IDC_NEW_TAB and IDC_FOCUS_LOCATION are outside IDC_RAC_ACTION_FIRST..LAST,
+// so a fallback never comes back to the table.
+
+void OpenCommandBar(const action_table::ActionContext& context,
+                    const base::DictValue&) {
+  if (!context.browser) {
+    return;
+  }
+  if (!ShowCommandBar(context.browser, Entry::kNewTab)) {
+    chrome::ExecuteCommand(context.browser, IDC_NEW_TAB);
+  }
+}
+
+void OpenCommandBarWithUrl(const action_table::ActionContext& context,
+                           const base::DictValue&) {
+  if (!context.browser) {
+    return;
+  }
+  if (!ShowCommandBar(context.browser, Entry::kFocusLocation)) {
+    chrome::ExecuteCommand(context.browser, IDC_FOCUS_LOCATION);
+  }
+}
+
+void Ask(const action_table::ActionContext& context,
+         const base::DictValue& args) {
+  const std::string* prompt = args.FindString("prompt");
+  if (context.browser && prompt && !prompt->empty()) {
+    rac::ai::AskAssistant(context.browser, *prompt);
+  }
+}
+
+}  // namespace rac::command_bar

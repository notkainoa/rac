+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class FaviconCache;
+
+namespace viz {
+struct FrameTimingDetails;
+}
+
+namespace rac::command_bar {
+
+class CommandBarEngine;
+class CommandBarGrowAnimation;
+
+// How the bar was opened. It decides placement, motion, the starting text,
+// and where Enter opens a page.
+enum class Entry {
+  kNewTab,         // Cmd+T or the sidebar's New tab row: centered, at once,
+                   // and Enter opens a new tab.
+  kFocusLocation,  // Cmd+L: over the address field with its URL selected,
+                   // growing from it; Enter navigates this tab.
+};
+
+// Opens the command bar in `browser`. Returns false, doing nothing, where the
+// bar doesn't open (app and popup windows, or the entry's switch is off), so
+// the caller does what Chromium would have done. The first call in a window
+// builds the bar; nothing exists before it.
+bool ShowCommandBar(BrowserWindowInterface* browser, Entry entry);
+
+// One window's bar. Made on first use and owned by its window, the way rac's
+// other per-window state is (UnownedUserData, as AssistantPanelState): it
+// deletes itself when the window closes. Between uses only the hidden widget
+// and the local-row code remain; the autocomplete engine and the favicon
+// cache are dropped when the bar finishes closing.
+class CommandBarController : public CommandBarView::Delegate,
+                             public views::WidgetObserver {
+ public:
+  DECLARE_USER_DATA(CommandBarController);
+
+  // The window's bar, or null before the first open.
+  static CommandBarController* From(BrowserWindowInterface* browser);
+  static CommandBarController* GetOrCreate(BrowserWindowInterface* browser);
+
+  CommandBarController(const CommandBarController&) = delete;
+  CommandBarController& operator=(const CommandBarController&) = delete;
+
+  void Show(Entry entry);
+  bool IsShowing() const;
+
+  // CommandBarView::Delegate:
+  void OnQueryChanged(const std::u16string& text) override;
+  void OnRowChosen(size_t index, int event_flags) override;
+  void OnCancel() override;
+  bool OnAccelerator(const ui::Accelerator& accelerator) override;
+  ui::ImageModel GetIcon(const Row& row, size_t index) override;
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+  // For browser tests.
+  CommandBarView* view_for_testing() { return view_; }
+  bool HasEngineForTesting() const { return !!engine_; }
+  bool IsSuggestTimerRunningForTesting() const {
+    return suggest_timer_.IsRunning();
+  }
+  void FireSuggestTimerForTesting() { suggest_timer_.FireNow(); }
+
+ private:
+  enum class CloseReason { kChosen, kCancelled, kLostFocus };
+
+  explicit CommandBarController(BrowserWindowInterface* browser);
+  ~CommandBarController() override;
+
+  void EnsureWidget();
+  void EnsureEngine();
+  // Builds the engine once the open (and Cmd+L's grow) is on screen.
+  void BuildEngineAfterOpen();
+  // Sets the field and rows for `entry_`: Cmd+L's URL, selected, or empty.
+  void StartSession();
+  void Refresh();
+  void Close(CloseReason reason);
+  // What a chosen row does. False if its target is gone; the bar then stays
+  // open without that row.
+  bool Act(const Row& row,
+           const std::u16string& query,
+           WindowOpenDisposition disposition);
+  void DropRef(const std::string& ref);
+
+  // The card's resting bounds in screen coordinates, and the address
+  // field's, if the bar should grow from it.
+  gfx::Rect CardBoundsInScreen(int card_height) const;
+  std::optional<gfx::Rect> FieldBoundsInScreen() const;
+  // The address field's text, where the bar's own text lines up.
+  std::optional<gfx::Rect> TextBoundsInScreen() const;
+  void PlaceWidget(bool animate_from_field);
+
+  void OnFirstFramePresented(base::TimeTicks shown_at,
+                             base::TimeDelta show_cost,
+                             bool cold,
+                             const viz::FrameTimingDetails& details);
+  void OnFadeEnded();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  Entry entry_ = Entry::kNewTab;
+
+  // Built on first Show().
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<CommandBarView> view_ = nullptr;
+  std::unique_ptr<views::Widget::PaintAsActiveLock> paint_as_active_;
+  std::unique_ptr<CommandBarGrowAnimation> grow_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      browser_widget_observation_{this};
+
+  // Built after the first frame of an open, or on the first keystroke if
+  // sooner. Dropped when the close fade ends.
+  std::unique_ptr<CommandBarEngine> engine_;
+  std::unique_ptr<FaviconCache> favicons_;  // Never off the record.
+
+  // True from Show() until Close().
+  bool open_ = false;
+  // True from Close() until the fade ends. The widget is still visible but
+  // takes no input and is not "showing".
+  bool closing_ = false;
+
+  // One session, from Show() to Close().
+  Inputs local_;            // Tabs, pinned tabs, favorites, and actions.
+  bool prefilled_ = false;  // The field holds Cmd+L's URL, untouched.
+  GURL current_page_;       // Cmd+L's page, for the top row while prefilled.
+  std::u16string current_page_title_;
+  RankedRows ranked_;
+  uint64_t generation_ = 0;  // Drops favicons for rows no longer shown.
+  base::OneShotTimer suggest_timer_;  // D29's pause.
+  views::ViewTracker focus_before_;
+  base::CallbackListSubscription active_tab_subscription_;
+
+  base::CallbackListSubscription close_subscription_;
+  ui::ScopedUnownedUserData<CommandBarController> scoped_data_;
+
+  base::WeakPtrFactory<CommandBarController> weak_factory_{this};
+};
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_CONTROLLER_H_

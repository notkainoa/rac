+
+history_clusters::HistoryClustersService*
+CommandBarProviderClient::GetHistoryClustersService() {
+  return off_the_record_
+             ? nullptr
+             : ChromeAutocompleteProviderClient::GetHistoryClustersService();
+}
+
+history_embeddings::HistoryEmbeddingsSearch*
+CommandBarProviderClient::GetHistoryEmbeddingsSearch() {
+  return off_the_record_
+             ? nullptr
+             : ChromeAutocompleteProviderClient::GetHistoryEmbeddingsSearch();
+}
+
+scoped_refptr<history::TopSites> CommandBarProviderClient::GetTopSites() {
+  return off_the_record_ ? nullptr
+                         : ChromeAutocompleteProviderClient::GetTopSites();
+}
+
+bookmarks::BookmarkModel* CommandBarProviderClient::GetBookmarkModel() {
+  return off_the_record_ ? nullptr
+                         : ChromeAutocompleteProviderClient::GetBookmarkModel();
+}
+
+history::URLDatabase* CommandBarProviderClient::GetInMemoryDatabase() {
+  // Chrome's version goes through GetHistoryService(), but don't rely on it.
+  return off_the_record_
+             ? nullptr
+             : ChromeAutocompleteProviderClient::GetInMemoryDatabase();
+}
+
+InMemoryURLIndex* CommandBarProviderClient::GetInMemoryURLIndex() {
+  return off_the_record_
+             ? nullptr
+             : ChromeAutocompleteProviderClient::GetInMemoryURLIndex();
+}
+
+GeolocationHeaderService*
+CommandBarProviderClient::GetGeolocationHeaderService() const {
+  // Never: SearchProvider::Start primes it on every keystroke, before any
+  // suggest check, and a suggest row's request has no
+  // location header to send anyway.
+  return nullptr;
+}
+
+scoped_refptr<ShortcutsBackend>
+CommandBarProviderClient::GetShortcutsBackend() {
+  return off_the_record_
+             ? nullptr
+             : ChromeAutocompleteProviderClient::GetShortcutsBackend();
+}
+
+scoped_refptr<ShortcutsBackend>
+CommandBarProviderClient::GetShortcutsBackendIfExists() {
+  return off_the_record_
+             ? nullptr
+             : ChromeAutocompleteProviderClient::GetShortcutsBackendIfExists();
+}
+
+bool CommandBarProviderClient::SearchSuggestEnabled() const {
+  // The engine's local passes switch remote suggestions off, so a local
+  // pass asks the search engine nothing (D29).
+  return remote_suggestions_allowed_ &&
+         ChromeAutocompleteProviderClient::SearchSuggestEnabled();
+}
+
+void CommandBarProviderClient::PrefetchImage(const GURL& url) {
+  // The bar draws no answer or entity images, so it fetches none.
+}
+
+void CommandBarProviderClient::StartServiceWorker(const GURL& destination_url) {
+  // Never: a search engine hears from the bar only after D29's gate, and
+  // then only through SearchProvider's own request.
+}
+
+std::unique_ptr<KeywordExtensionsDelegate>
+CommandBarProviderClient::GetKeywordExtensionsDelegate(
+    KeywordProvider* keyword_provider) {
+  // None: an extension's keyword would get every keystroke, with no gate.
+  return nullptr;
+}
+
+void CommandBarProviderClient::set_remote_suggestions_allowed(bool allowed) {
+  remote_suggestions_allowed_ = allowed;
+}
+
+}  // namespace rac::command_bar

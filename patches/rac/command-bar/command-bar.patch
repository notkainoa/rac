+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_types.h"
+#include "ui/base/models/image_model.h"
+
+class BrowserWindowInterface;
+
+// Collects the command bar's own rows from rac's models and switches to
+// them. Read once per open: the bar closes when the active tab changes, and
+// a profile has at most a few hundred tabs.
+namespace rac::command_bar {
+
+// Every open tab of the profile, in every space and window, loaded or not,
+// plus tabs of spaces that are only in the store. Favorites' and pinned
+// tabs' live tabs are left to CollectSaved(). In incognito, the tabs of every
+// incognito window of the profile, with no space names; the ranker keeps
+// this window's.
+std::vector<TabCandidate> CollectTabs(BrowserWindowInterface* browser);
+
+// Pinned tabs of every space, then favorites. Empty in incognito.
+std::vector<SavedCandidate> CollectSaved(BrowserWindowInterface* browser);
+
+// The live tab's favicon for a "tab" ref, which discarded tabs keep. Empty
+// for other refs; those load by URL from the favicon cache.
+ui::ImageModel TabFavicon(const std::string& ref);
+
+// Switches to the tab or item `ref` names, from `browser`. Changes space or
+// window when it has to. Returns false if it is gone, so the bar can drop
+// the row instead of closing on nothing.
+bool ActivateRef(BrowserWindowInterface* browser, const std::string& ref);
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_SOURCES_H_

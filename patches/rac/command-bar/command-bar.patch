+++ src/chrome/browser/ui/views/rac/command_bar/command_bar_ranker.cc
@@ -0,0 +1,598 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_ranker.h"
+
+#include <algorithm>
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/i18n/case_conversion.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/strings/whitespace_constants.h"
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_switches.h"
+#include "url/gurl.h"
+
+namespace rac::command_bar {
+
+namespace {
+
+// The query, folded once per keystroke.
+struct PreparedQuery {
+  std::u16string folded;  // Whitespace collapsed and trimmed.
+  std::vector<std::u16string> terms;
+};
+
+PreparedQuery Prepare(std::u16string_view text) {
+  PreparedQuery query;
+  query.folded = base::i18n::FoldCase(
+      base::CollapseWhitespace(text, /*trim_sequences_with_line_breaks=*/true));
+  query.terms =
+      base::SplitString(query.folded, base::kWhitespaceUTF16,
+                        base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  return query;
+}
+
+// Whitespace and ASCII punctuation separate words. Other scripts count as
+// word characters, so their terms fall back to substring matching.
+bool IsWordBoundary(char16_t c) {
+  return base::IsUnicodeWhitespace(c) ||
+         (c < 0x80 && !base::IsAsciiAlphaNumeric(c));
+}
+
+bool HasWordPrefix(std::u16string_view text, std::u16string_view term) {
+  for (size_t pos = text.find(term); pos != std::u16string_view::npos;
+       pos = text.find(term, pos + 1)) {
+    if (pos == 0 || IsWordBoundary(text[pos - 1])) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Short Latin terms match anywhere far too often, so they only match at word
+// starts. Terms in other scripts may be one or two characters long.
+bool MaySubstringMatch(std::u16string_view term) {
+  return term.size() >= kMinSubstringTerm || !base::IsStringASCII(term);
+}
+
+// The host without "www." plus the path, folded. Empty for invalid URLs.
+std::u16string FoldedUrlText(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::u16string();
+  }
+  std::string_view host = url.host();
+  if (host.starts_with("www.")) {
+    host.remove_prefix(4);
+  }
+  std::string text(host);
+  if (url.path() != "/") {
+    text.append(url.path());
+  }
+  return base::i18n::FoldCase(base::UTF8ToUTF16(text));
+}
+
+MatchTier MatchPrepared(const PreparedQuery& query,
+                        std::u16string_view title,
+                        const GURL& url,
+                        std::u16string_view keywords) {
+  if (query.terms.empty()) {
+    return MatchTier::kNone;
+  }
+  const std::u16string folded_title =
+      base::i18n::FoldCase(base::CollapseWhitespace(
+          title, /*trim_sequences_with_line_breaks=*/true));
+  if (folded_title.starts_with(query.folded)) {
+    return MatchTier::kTitlePrefix;
+  }
+  const std::u16string folded_url = FoldedUrlText(url);
+  const std::u16string folded_keywords = base::i18n::FoldCase(keywords);
+
+  // Every term must match; the weakest term sets the tier.
+  MatchTier tier = MatchTier::kWordPrefix;
+  for (const std::u16string& term : query.terms) {
+    if (HasWordPrefix(folded_title, term) || HasWordPrefix(folded_url, term) ||
+        HasWordPrefix(folded_keywords, term)) {
+      continue;
+    }
+    if (MaySubstringMatch(term) &&
+        (folded_title.find(term) != std::u16string::npos ||
+         folded_url.find(term) != std::u16string::npos)) {
+      tier = MatchTier::kSubstring;
+      continue;
+    }
+    return MatchTier::kNone;
+  }
+  return tier;
+}
+
+struct Scored {
+  size_t index;
+  MatchTier tier;
+};
+
+// Among tabs showing the same page, the one the user most likely means.
+bool IsBetterTab(const TabCandidate& a, const TabCandidate& b) {
+  if (a.in_current_space != b.in_current_space) {
+    return a.in_current_space;
+  }
+  return a.last_active > b.last_active;
+}
+
+// One section for pinned tabs and favorites (maintainer, day 0): this
+// space's items first (its pinned tabs and the favorites every space shares),
+// then other spaces' pinned tabs.
+int SavedGroup(const SavedCandidate& saved) {
+  return saved.in_current_space ? 0 : 1;
+}
+
+// Sidebar order inside a group: favorites sit above pinned tabs.
+bool IsBeforeInSidebar(const SavedCandidate& a, const SavedCandidate& b) {
+  if (a.is_favorite != b.is_favorite) {
+    return a.is_favorite;
+  }
+  return a.sidebar_index < b.sidebar_index;
+}
+
+// Adds `index` to `scored` with `tier` unless it is already there.
+void AddOnce(std::vector<Scored>& scored, size_t index, MatchTier tier) {
+  for (const Scored& s : scored) {
+    if (s.index == index) {
+      return;
+    }
+  }
+  scored.push_back({index, tier});
+}
+
+// Cuts `list` toward `*total <= kMaxRows`, keeping at least one row.
+template <typename T>
+void TrimToFit(std::vector<T>& list, size_t* total) {
+  if (*total <= kMaxRows || list.size() <= 1) {
+    return;
+  }
+  const size_t cut = std::min(list.size() - 1, *total - kMaxRows);
+  list.resize(list.size() - cut);
+  *total -= cut;
+}
+
+Row TabRow(const TabCandidate& tab) {
+  Row row;
+  row.kind = RowKind::kOpenTab;
+  row.section = Section::kTabs;
+  row.title = tab.title.empty() ? base::UTF8ToUTF16(tab.url.spec()) : tab.title;
+  if (!tab.in_current_space) {
+    row.trailing = tab.space_name;
+  }
+  row.url = tab.url;
+  row.ref = tab.ref;
+  return row;
+}
+
+Row SavedRow(const SavedCandidate& saved) {
+  Row row;
+  row.kind = saved.is_favorite ? RowKind::kFavorite : RowKind::kPinnedTab;
+  row.section = Section::kPinnedAndFavorites;
+  row.title =
+      saved.title.empty() ? base::UTF8ToUTF16(saved.url.spec()) : saved.title;
+  if (!saved.is_favorite && !saved.in_current_space) {
+    row.trailing = saved.space_name;
+  }
+  row.url = saved.url;
+  row.ref = saved.ref;
+  return row;
+}
+
+Row EngineRow(const EngineCandidate& engine, RowKind kind, Section section) {
+  Row row;
+  row.kind = kind;
+  row.section = section;
+  row.title = engine.title;
+  row.detail = engine.detail;
+  row.url = engine.url;
+  row.result_index = engine.result_index;
+  return row;
+}
+
+Row ActionRow(const ActionCandidate& action) {
+  Row row;
+  row.kind = RowKind::kAction;
+  row.section = Section::kActions;
+  row.title = action.label;
+  row.trailing = action.shortcut;
+  row.ref = action.id;
+  return row;
+}
+
+}  // namespace
+
+MatchTier Match(std::u16string_view query,
+                std::u16string_view title,
+                const GURL& url,
+                std::u16string_view keywords) {
+  return MatchPrepared(Prepare(query), title, url, keywords);
+}
+
+std::string DedupeKey(const GURL& url) {
+  if (!url.is_valid()) {
+    return url.possibly_invalid_spec();
+  }
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    GURL::Replacements no_ref;
+    no_ref.ClearRef();
+    return url.ReplaceComponents(no_ref).spec();
+  }
+  std::string_view host = url.host();
+  if (host.starts_with("www.")) {
+    host.remove_prefix(4);
+  }
+  std::string key(host);
+  if (url.has_port()) {
+    key.append(":").append(url.port());
+  }
+  if (url.path() != "/") {
+    key.append(url.path());
+  }
+  if (url.has_query()) {
+    key.append("?").append(url.query());
+  }
+  return key;
+}
+
+RankedRows RankEmpty(const Query& query, const Inputs& inputs) {
+  RankedRows out;
+  // Cmd+L's untouched URL leads, so Enter on it never switches tabs.
+  if (query.current_page.is_valid()) {
+    Row row;
+    row.kind = RowKind::kCurrentPage;
+    row.section = Section::kTop;
+    row.title = query.current_page_title.empty()
+                    ? base::UTF8ToUTF16(query.current_page.spec())
+                    : query.current_page_title;
+    row.detail = base::UTF8ToUTF16(query.current_page.spec());
+    row.url = query.current_page;
+    out.rows.push_back(std::move(row));
+  }
+
+  std::vector<const TabCandidate*> recent;
+  for (const TabCandidate& tab : inputs.tabs) {
+    if (tab.is_active_tab) {
+      continue;
+    }
+    // Incognito has no spaces; its window's tabs stand in for "this space".
+    if (query.incognito ? !tab.in_this_window : !tab.in_current_space) {
+      continue;
+    }
+    recent.push_back(&tab);
+  }
+  std::stable_sort(recent.begin(), recent.end(),
+                   [](const TabCandidate* a, const TabCandidate* b) {
+                     return a->last_active > b->last_active;
+                   });
+  if (recent.size() > kEmptyRecentTabs) {
+    recent.resize(kEmptyRecentTabs);
+  }
+
+  for (const TabCandidate* tab : recent) {
+    out.rows.push_back(TabRow(*tab));
+  }
+  size_t actions = 0;
+  for (const ActionCandidate& action : inputs.actions) {
+    if (actions == kEmptyActions) {
+      break;
+    }
+    if (action.suggested && !action.takes_query) {
+      out.rows.push_back(ActionRow(action));
+      ++actions;
+    }
+  }
+  out.local_count = recent.size() + actions;
+  return out;
+}
+
+RankedRows Rank(const Query& query, const Inputs& inputs) {
+  const PreparedQuery prepared = Prepare(query.text);
+  if (prepared.terms.empty()) {
+    return RankEmpty(query, inputs);
+  }
+
+  // 1. What was typed, when it is a URL or a bang.
+  const EngineCandidate* top = nullptr;
+  for (const EngineCandidate& engine : inputs.engine) {
+    if ((engine.is_default && engine.is_bang) ||
+        (engine.kind == RowKind::kTypedUrl && query.input_is_url)) {
+      top = &engine;
+      break;
+    }
+  }
+  const bool top_is_bang = top && top->is_bang;
+
+  // 2. Open tabs. Index every tab by page so history can defer to it.
+  std::vector<Scored> tabs;
+  std::map<std::string, size_t> tab_by_page;
+  std::set<std::string> seen;  // Pages history must not list again.
+  if (top) {
+    seen.insert(DedupeKey(top->url));
+  }
+  // Pages of live tabs, by space. A stored tab of the same space and page
+  // is the same tab seen twice.
+  std::set<std::pair<std::string, std::string>> live_pages;
+  for (const TabCandidate& tab : inputs.tabs) {
+    if (!tab.stored) {
+      live_pages.emplace(tab.space_id, DedupeKey(tab.url));
+    }
+  }
+  for (size_t i = 0; i < inputs.tabs.size(); ++i) {
+    const TabCandidate& tab = inputs.tabs[i];
+    if (query.incognito && !tab.in_this_window) {
+      continue;
+    }
+    // The user is on this page already; neither it nor its history helps.
+    if (tab.is_active_tab) {
+      seen.insert(DedupeKey(tab.url));
+      continue;
+    }
+    const std::string key = DedupeKey(tab.url);
+    if (tab.stored && live_pages.contains({tab.space_id, key})) {
+      continue;
+    }
+    auto it = tab_by_page.find(key);
+    if (it == tab_by_page.end() || IsBetterTab(tab, inputs.tabs[it->second])) {
+      tab_by_page[key] = i;
+    }
+    const MatchTier tier = MatchPrepared(prepared, tab.title, tab.url, {});
+    if (tier != MatchTier::kNone) {
+      tabs.push_back({i, tier});
+    }
+  }
+
+  // 3. Pinned tabs and favorites. Incognito has neither.
+  std::vector<Scored> saved;
+  std::map<std::string, size_t> saved_by_page;
+  if (!query.incognito) {
+    for (size_t i = 0; i < inputs.saved.size(); ++i) {
+      const SavedCandidate& item = inputs.saved[i];
+      // A pinned tab or favorite on screen is the page the user is on.
+      if (item.is_active_tab) {
+        seen.insert(DedupeKey(item.url));
+        continue;
+      }
+      saved_by_page.emplace(DedupeKey(item.url), i);
+      const MatchTier tier = MatchPrepared(prepared, item.title, item.url, {});
+      if (tier != MatchTier::kNone) {
+        saved.push_back({i, tier});
+      }
+    }
+  }
+
+  // 4. History. A page that is open, pinned, or a favorite shows as that
+  // row instead. Incognito never shows the regular profile's history.
+  std::vector<const EngineCandidate*> history;
+  if (!query.incognito) {
+    for (const EngineCandidate& engine : inputs.engine) {
+      if (engine.kind != RowKind::kHistory) {
+        continue;
+      }
+      const std::string key = DedupeKey(engine.url);
+      if (auto tab = tab_by_page.find(key); tab != tab_by_page.end()) {
+        AddOnce(tabs, tab->second, MatchTier::kSubstring);
+        continue;
+      }
+      if (auto item = saved_by_page.find(key); item != saved_by_page.end()) {
+        AddOnce(saved, item->second, MatchTier::kSubstring);
+        continue;
+      }
+      if (seen.insert(key).second) {
+        history.push_back(&engine);
+      }
+    }
+  }
+
+  std::stable_sort(tabs.begin(), tabs.end(),
+                   [&](const Scored& a, const Scored& b) {
+                     const TabCandidate& ta = inputs.tabs[a.index];
+                     const TabCandidate& tb = inputs.tabs[b.index];
+                     if (ta.in_current_space != tb.in_current_space) {
+                       return ta.in_current_space;
+                     }
+                     if (a.tier != b.tier) {
+                       return a.tier > b.tier;
+                     }
+                     return ta.last_active > tb.last_active;
+                   });
+  std::stable_sort(saved.begin(), saved.end(),
+                   [&](const Scored& a, const Scored& b) {
+                     const SavedCandidate& sa = inputs.saved[a.index];
+                     const SavedCandidate& sb = inputs.saved[b.index];
+                     if (SavedGroup(sa) != SavedGroup(sb)) {
+                       return SavedGroup(sa) < SavedGroup(sb);
+                     }
+                     if (a.tier != b.tier) {
+                       return a.tier > b.tier;
+                     }
+                     return IsBeforeInSidebar(sa, sb);
+                   });
+
+  // 5. Actions match only at word starts, never inside a word. Query-taking
+  // rows (Ask) are not matched; they follow the search row.
+  std::vector<Scored> actions;
+  std::vector<const ActionCandidate*> query_rows;
+  for (size_t i = 0; i < inputs.actions.size(); ++i) {
+    const ActionCandidate& action = inputs.actions[i];
+    if (action.takes_query) {
+      // Under a bang the text is a search for that engine, not a question.
+      if (kShowQueryRows && !top_is_bang) {
+        query_rows.push_back(&action);
+      }
+      continue;
+    }
+    const MatchTier tier =
+        MatchPrepared(prepared, action.label, GURL(), action.keywords);
+    if (tier >= MatchTier::kWordPrefix) {
+      actions.push_back({i, tier});
+    }
+  }
+  std::stable_sort(actions.begin(), actions.end(),
+                   [](const Scored& a, const Scored& b) {
+                     return a.tier > b.tier;  // Then table order.
+                   });
+
+  if (tabs.size() > kMaxTabs) {
+    tabs.resize(kMaxTabs);
+  }
+  if (saved.size() > kMaxSaved) {
+    saved.resize(kMaxSaved);
+  }
+  if (history.size() > kMaxHistory) {
+    history.resize(kMaxHistory);
+  }
+  if (actions.size() > kMaxActions) {
+    actions.resize(kMaxActions);
+  }
+
+  // Fit kMaxRows. History gives way first, actions last, because an action
+  // matched by name is the most deliberate thing a user types.
+  size_t total = tabs.size() + saved.size() + history.size() + actions.size();
+  TrimToFit(history, &total);
+  TrimToFit(tabs, &total);
+  TrimToFit(saved, &total);
+  TrimToFit(actions, &total);
+
+  RankedRows out;
+  out.local_count = total;
+  if (top) {
+    // A bang or keyword leads as its engine's search row (the view words it
+    // "Search <engine> for …"); a typed URL as itself.
+    Row row =
+        EngineRow(*top, top_is_bang ? RowKind::kSearch : RowKind::kTypedUrl,
+                  Section::kTop);
+    row.keyword = top_is_bang;
+    out.rows.push_back(std::move(row));
+  }
+  for (const Scored& s : tabs) {
+    out.rows.push_back(TabRow(inputs.tabs[s.index]));
+  }
+  for (const Scored& s : saved) {
+    out.rows.push_back(SavedRow(inputs.saved[s.index]));
+  }
+  for (const EngineCandidate* engine : history) {
+    out.rows.push_back(
+        EngineRow(*engine, RowKind::kHistory, Section::kHistory));
+  }
+  for (const Scored& s : actions) {
+    out.rows.push_back(ActionRow(inputs.actions[s.index]));
+  }
+
+  // 6. Search for what was typed, Ask, then suggestions. A bang already
+  // searches its own engine, so it gets no second search row. "Search for"
+  // is the default engine's row, never a bang that isn't the default match.
+  if (!top_is_bang) {
+    // A keyword's search that isn't the default match (Chromium then makes
+    // no default-engine search row) still gets one, under its own name.
+    const EngineCandidate* search = nullptr;
+    const EngineCandidate* keyword = nullptr;
+    for (const EngineCandidate& engine : inputs.engine) {
+      if (engine.kind != RowKind::kSearch) {
+        continue;
+      }
+      if (!engine.is_bang) {
+        search = &engine;
+        break;
+      }
+      if (!keyword) {
+        keyword = &engine;
+      }
+    }
+    if (search) {
+      out.rows.push_back(
+          EngineRow(*search, RowKind::kSearch, Section::kSearch));
+    } else if (keyword) {
+      Row row = EngineRow(*keyword, RowKind::kSearch, Section::kSearch);
+      row.keyword = true;
+      out.rows.push_back(std::move(row));
+    }
+  }
+  // What was typed, as an address, when Chromium can navigate to it but
+  // didn't classify the input as a URL ("intranet/" is UNKNOWN): offered
+  // under the search, never above it. Skipped when a listed row already
+  // shows that page.
+  if (!top) {
+    for (const EngineCandidate& engine : inputs.engine) {
+      if (engine.kind != RowKind::kTypedUrl || engine.is_bang) {
+        continue;
+      }
+      const std::string key = DedupeKey(engine.url);
+      if (!seen.contains(key) && !tab_by_page.contains(key) &&
+          !saved_by_page.contains(key)) {
+        out.rows.push_back(
+            EngineRow(engine, RowKind::kTypedUrl, Section::kSearch));
+      }
+      break;
+    }
+  }
+  for (const ActionCandidate* action : query_rows) {
+    Row row;
+    row.kind = RowKind::kAsk;
+    row.section = Section::kSearch;
+    row.title = action->label;
+    row.detail = base::CollapseWhitespace(
+        query.text, /*trim_sequences_with_line_breaks=*/true);
+    row.ref = action->id;
+    out.rows.push_back(std::move(row));
+  }
+  // Suggestions are the default engine's; under a bang they would be for
+  // the bang's text, so a bang gets none.
+  const size_t room =
+      top_is_bang ? 0 : (kMaxRows > total ? kMaxRows - total : 0);
+  size_t suggestions = 0;
+  std::set<std::u16string> seen_suggestions = {prepared.folded};
+  for (const EngineCandidate& engine : inputs.engine) {
+    if (suggestions == std::min(room, kMaxSuggestions)) {
+      break;
+    }
+    if (engine.kind != RowKind::kSuggestion) {
+      continue;
+    }
+    if (!seen_suggestions.insert(base::i18n::FoldCase(engine.title)).second) {
+      continue;
+    }
+    out.rows.push_back(
+        EngineRow(engine, RowKind::kSuggestion, Section::kSearch));
+    ++suggestions;
+  }
+  return out;
+}
+
+bool ShouldAskSearchEngine(const Query& query, const RankedRows& local) {
+  if (Prepare(query.text).terms.empty() || query.incognito) {
+    return false;
+  }
+  switch (kSuggestPolicy) {
+    case SuggestPolicy::kNever:
+      return false;
+    case SuggestPolicy::kLikeAddressBar:
+      return true;
+    case SuggestPolicy::kAfterLocalRunOutAndPause:
+      break;
+  }
+  if (query.input_is_url) {
+    return false;
+  }
+  // A typed URL or bang leads the list; the user has said where to go. A
+  // bang's suggestions would be the default engine's, for the bang's text.
+  if (!local.rows.empty()) {
+    const Row& front = local.rows.front();
+    if (front.kind == RowKind::kTypedUrl ||
+        (front.kind == RowKind::kSearch && front.keyword)) {
+      return false;
+    }
+  }
+  return local.local_count <= kLocalRowsRunOut;
+}
+
+}  // namespace rac::command_bar

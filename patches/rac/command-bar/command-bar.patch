@@ -0,0 +1,60 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ENGINE_CONVERT_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ENGINE_CONVERT_H_
+
+#include <cstddef>
+#include <limits>
+#include <optional>
+#include <vector>
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_types.h"
+
+class AutocompleteInput;
+class AutocompleteResult;
+class TemplateURLService;
+struct AutocompleteMatch;
+
+// Turns Chromium's autocomplete matches into the ranker's EngineCandidates.
+// Depends on the omnibox component only (no profile, no Views), so its tests
+// run in rac_command_bar_engine_unittests.
+namespace rac::command_bar {
+
+// The result index of a typed URL built from the input rather than taken
+// from the result (incognito, where the provider that makes it is off).
+inline constexpr size_t kSyntheticTypedUrl = std::numeric_limits<size_t>::max();
+
+// The providers the bar creates, as AutocompleteProvider::Type bits. An
+// allow-list, so a provider Chromium adds later stays off until rac chooses
+// it. Intersect with AutocompleteClassifier::DefaultOmniboxProviders(), so a
+// provider Chromium turns off stays off too. Off the record, the providers
+// that read the regular profile's history, bookmarks, or shortcuts are left
+// out.
+int AllowedProviderTypes(bool off_the_record);
+
+// Which bar row a match becomes, or nullopt to drop it. Chromium's built-in
+// pages (chrome://settings) are page rows, not suggestions, whatever their
+// match type, because they come from the local built-in provider.
+std::optional<RowKind> KindOf(const AutocompleteMatch& match);
+
+// Converts `result`, the result for `input`.
+// - Off the record, rows from history-backed providers are dropped, and when
+//   no provider made a typed-URL row for URL input, one is built from
+//   `input.canonicalized_url()` with result index kSyntheticTypedUrl.
+// - A search row's detail is the engine's short name. Chromium writes
+//   "Search <engine>", or "Ask <engine>" for Helium's AI-category bangs
+//   (autocomplete_controller.cc:2064-2077 in 156); the bar never shows that
+//   wording, so it shows no AI label with AI off (ruling 16) and never has
+//   to check the AI switch. `template_urls` may be null; search rows then
+//   keep Chromium's description.
+std::vector<EngineCandidate> ConvertResult(
+    const AutocompleteResult& result,
+    const AutocompleteInput& input,
+    bool off_the_record,
+    const TemplateURLService* template_urls);
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_ENGINE_CONVERT_H_

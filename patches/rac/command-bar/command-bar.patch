+ui::ImageModel VectorIcon(const gfx::VectorIcon& icon) {
+  return ui::ImageModel::FromVectorIcon(icon, style::TertiaryTextColor(),
+                                        style::kRowIconSize);
+}
+
+// Lets clicks through the bar's window during the close fade, so a click on
+// the page lands there, and takes them again when the bar shows.
+void SetClickThrough(views::Widget* widget, bool click_through) {
+#if BUILDFLAG(IS_MAC)
+  SetIgnoresMouseEvents(widget, click_through);
+#endif
+}
+
+}  // namespace
+
+bool ShowCommandBar(BrowserWindowInterface* browser, Entry entry) {
+  if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  switch (entry) {
+    case Entry::kNewTab:
+      if (!browser->GetProfile()->GetPrefs()->GetBoolean(
+              kNewTabOpensCommandBar)) {
+        return false;
+      }
+      break;
+    case Entry::kFocusLocation:
+      if (!kFocusLocationOpensBar) {
+        return false;
+      }
+      break;
+  }
+  CommandBarController::GetOrCreate(browser)->Show(entry);
+  return true;
+}
+
+DEFINE_USER_DATA(CommandBarController);
+
+// static
+CommandBarController* CommandBarController::From(
+    BrowserWindowInterface* browser) {
+  return Get(browser->GetUnownedUserDataHost());
+}
+
+// static
+CommandBarController* CommandBarController::GetOrCreate(
+    BrowserWindowInterface* browser) {
+  if (CommandBarController* controller = From(browser)) {
+    return controller;
+  }
+  return new CommandBarController(browser);
+}
+
+CommandBarController::CommandBarController(BrowserWindowInterface* browser)
+    : browser_(browser),
+      scoped_data_(browser->GetUnownedUserDataHost(), *this) {
+  close_subscription_ = browser->RegisterBrowserDidClose(base::BindRepeating(
+      [](CommandBarController* self, BrowserWindowInterface*) { delete self; },
+      base::Unretained(this)));
+}
+
+CommandBarController::~CommandBarController() {
+  // The widget is client-owned; close it with the window.
+  widget_observation_.Reset();
+  browser_widget_observation_.Reset();
+  view_ = nullptr;
+  widget_.reset();
+}
+
+bool CommandBarController::IsShowing() const {
+  return widget_ && open_;
+}
+
+void CommandBarController::Show(Entry entry) {
+  if (IsShowing()) {
+    if (entry == entry_) {
+      // The same key again only selects the text.
+      view_->SetQuery(view_->GetQuery(), /*select_all=*/true);
+      return;
+    }
+    // The other key: the bar takes that key's mode in place, with no motion.
+    entry_ = entry;
+    StartSession();
+    if (grow_) {
+      grow_->Finish();
+    }
+    PlaceWidget(/*animate_from_field=*/false);
+    return;
+  }
+  const base::TimeTicks shown_at = base::TimeTicks::Now();
+  const bool cold = !widget_;
+  entry_ = entry;
+  // Reopened during the close fade: end the fade now, which hides and
+  // resets the bar, then show it fresh.
+  if (closing_) {
+    widget_->GetLayer()->GetAnimator()->StopAnimating();
+  }
+  EnsureWidget();
+  open_ = true;
+  view_->SetCanProcessEventsWithinSubtree(true);
+  SetClickThrough(widget_.get(), false);
+
+  // One session's local rows. Tabs and actions don't change while the bar
+  // is open; it closes when the active tab changes.
+  local_ = Inputs();
+  local_.tabs = CollectTabs(browser_);
+  local_.saved = CollectSaved(browser_);
+  local_.actions = CollectActions(browser_);
+  StartSession();
+
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  focus_before_.SetView(browser_view->GetFocusManager()->GetFocusedView());
+  paint_as_active_ = browser_view->GetWidget()->LockPaintAsActive();
+
+  // Motion (plan 02): Cmd+T appears at once (S17). Cmd+L grows from the
+  // field when it shows (S18). Reduce Motion turns the grow into kReducedFade.
+  const bool reduced = gfx::Animation::PrefersReducedMotion();
+  const bool grow = entry_ == Entry::kFocusLocation && !reduced &&
+                    FieldBoundsInScreen().has_value();
+  const bool fade = entry_ == Entry::kFocusLocation && reduced;
+  PlaceWidget(grow);
+  ui::Layer* layer = widget_->GetLayer();
+  layer->SetOpacity(fade ? 0.0f : 1.0f);
+  widget_->Show();
+  view_->FocusField();
+  if (grow) {
+    grow_->Start();
+  } else if (fade) {
+    views::AnimationBuilder()
+        .Once()
+        .SetDuration(style::kReducedFade)
+        .SetOpacity(layer, 1.0f, style::kReducedFadeTween);
+  }
+
+  active_tab_subscription_ =
+      browser_->RegisterActiveTabDidChange(base::BindRepeating(
+          [](CommandBarController* controller, BrowserWindowInterface*) {
+            controller->Close(CloseReason::kLostFocus);
+          },
+          base::Unretained(this)));
+
+  // The engine is built only once the bar is on screen (and, for Cmd+L,
+  // done growing), so an open pays for nothing it doesn't paint. The same
+  // callback logs M2's gate, open to first presented frame, for the harness.
+  widget_->GetCompositor()->RequestSuccessfulPresentationTimeForNextFrame(
+      base::BindOnce(&CommandBarController::OnFirstFramePresented,
+                     weak_factory_.GetWeakPtr(), shown_at,
+                     base::TimeTicks::Now() - shown_at, cold));
+}
+
+void CommandBarController::StartSession() {
+  suggest_timer_.Stop();
+  if (engine_) {
+    engine_->Clear();
+  }
+  std::u16string text;
+  current_page_ = GURL();
+  current_page_title_.clear();
+  if (entry_ == Entry::kFocusLocation) {
+    // Only a page the address bar shows a URL for: an empty field (the new
+    // tab page, split view's new tab page) opens an empty bar, never an
+    // internal chrome:// URL.
+    LocationBarView* location_bar =
+        BrowserView::GetBrowserViewForBrowser(browser_)->GetLocationBarView();
+    tabs::TabInterface* tab = browser_->GetTabStripModel()->GetActiveTab();
+    if (tab && location_bar && location_bar->omnibox_view() &&
+        !location_bar->omnibox_view()->GetText().empty()) {
+      current_page_ = tab->GetContents()->GetVisibleURL();
+      current_page_title_ = TabUIHelper::From(tab)->GetTitle();
+      // The full URL as the address bar shows it on focus: Unicode hosts
+      // and unescaped paths, not the raw spec.
+      text = location_bar->GetLocationBarModel()->GetFormattedFullURL();
+    }
+  }
+  prefilled_ = !text.empty();
+  // SetText doesn't call ContentsChanged, so this is not an edit.
+  view_->SetQuery(text, /*select_all=*/true);
+  Refresh();
+}
+
+void CommandBarController::OnFirstFramePresented(
+    base::TimeTicks shown_at,
+    base::TimeDelta show_cost,
+    bool cold,
+    const viz::FrameTimingDetails& details) {
+  // M2's gate, for the harness: --vmodule=command_bar_controller=1.
+  // TODO(bar): move behind BUILDFLAG(RAC_DEV_SWITCHES) once Core's buildflag
+  // is on the 156 base.
+  VLOG(1)
+      << "rac command bar: " << (cold ? "cold" : "warm")
+      << " open to first presented frame "
+      << (details.presentation_feedback.timestamp - shown_at).InMillisecondsF()
+      << " ms (Show() itself " << show_cost.InMillisecondsF() << " ms)";
+  BuildEngineAfterOpen();
+}
+
+void CommandBarController::BuildEngineAfterOpen() {
+  if (!IsShowing()) {
+    return;
+  }
+  // Building the engine takes under 1 ms, but the work it starts (provider
+  // setup, the first history reads) once froze Cmd+L's grow partway, so it
+  // waits for the grow's last frame. Typing sooner builds it on demand.
+  if (grow_ && grow_->is_running()) {
+    grow_->set_on_finished(base::BindOnce(
+        [](base::WeakPtr<CommandBarController> controller) {
+          // After the last frame is drawn, not inside it.
+          base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE,
+              base::BindOnce(&CommandBarController::BuildEngineAfterOpen,
+                             controller));
+        },
+        weak_factory_.GetWeakPtr()));
+    return;
+  }
+  EnsureEngine();
+}
+
+void CommandBarController::EnsureWidget() {
+  if (widget_) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  views::Widget* parent = browser_view->GetWidget();
+
+  // A child widget: on macOS, Views in the browser window can't paint over
+  // the page, so the bar has its own child NSWindow, as the omnibox popup
+  // does. It takes key focus for its field; the browser stays main and
+  // keeps painting as active through the lock taken in Show().
+  // TYPE_POPUP, as the omnibox popup: a TYPE_BUBBLE gets a non-client view,
+  // which can't take a contents view. Activatable, so the field gets keys.
+  auto widget = std::make_unique<ThemeCopyingWidget>(parent);
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.name = "RacCommandBar";
+  widget->Init(std::move(params));
+  view_ = widget->SetContentsView(std::make_unique<CommandBarView>(this));
+  widget_ = std::move(widget);
+  widget_observation_.Observe(widget_.get());
+  browser_widget_observation_.Observe(parent);
+
+  grow_.reset();
+}
+
+void CommandBarController::EnsureEngine() {
+  if (engine_) {
+    return;
+  }
+  Profile* profile = browser_->GetProfile();
+  const base::TimeTicks start = base::TimeTicks::Now();
+  // A WeakPtr: the engine is deleted soon after a close, and a late provider
+  // result must not reach a controller that is gone.
+  engine_ = std::make_unique<CommandBarEngine>(
+      profile, base::BindRepeating(&CommandBarController::Refresh,
+                                   weak_factory_.GetWeakPtr()));
+  VLOG(1) << "rac command bar: engine built in "
+          << (base::TimeTicks::Now() - start).InMillisecondsF() << " ms";
+  // Off the record, rows show live tabs' favicons only. Chrome's favicon and
+  // history factories redirect an incognito profile to the regular one
+  // (favicon_service_factory.cc:46-49 in 156), which the bar never reads.
+  if (!profile->IsOffTheRecord()) {
+    favicons_ = std::make_unique<FaviconCache>(
+        FaviconServiceFactory::GetForProfile(
+            profile, ServiceAccessType::EXPLICIT_ACCESS),
+        HistoryServiceFactory::GetForProfile(
+            profile, ServiceAccessType::EXPLICIT_ACCESS));
+  }
+}
+
+void CommandBarController::OnQueryChanged(const std::u16string& text) {
+  prefilled_ = false;
+  suggest_timer_.Stop();
+  const std::u16string trimmed =
+      base::CollapseWhitespace(text, /*trim_sequences_with_line_breaks=*/true);
+  if (trimmed.empty()) {
+    if (engine_) {
+      engine_->Clear();
+    }
+    Refresh();
+    return;
+  }
+  EnsureEngine();
+  // The local pass's synchronous rows paint in this frame; its
+  // rows from the on-disk history database arrive through Refresh without
+  // any request. The search engine is asked only
+  // after the pause, and only if the gate still passes then. Rank again
+  // even if the engine's result didn't change (it doesn't notify then),
+  // since tabs and actions match anew.
+  const uint64_t generation = generation_;
+  if (kSuggestPolicy == SuggestPolicy::kLikeAddressBar) {
+    engine_->StartWithSuggestions(text);
+  } else {
+    engine_->StartLocal(text);
+  }
+  if (generation_ == generation) {
+    Refresh();
+  }
+  if (kSuggestPolicy == SuggestPolicy::kLikeAddressBar ||
+      browser_->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  // The gate is decided at the end of the pause, not at the keystroke:
+  // the local pass's asynchronous rows can still arrive during it, and
+  // they count as local rows. ranked_ is refreshed by every engine
+  // update, so it includes the history rows the pause yielded.
+  suggest_timer_.Start(
+      FROM_HERE, kSuggestPause,
+      base::BindOnce(
+          [](base::WeakPtr<CommandBarController> controller,
+             std::u16string text) {
+            if (!controller || !controller->IsShowing() ||
+                !controller->engine_ || controller->view_->GetQuery() != text) {
+              return;
+            }
+            Query query{
+                .text = text,
+                .incognito =
+                    controller->browser_->GetProfile()->IsOffTheRecord(),
+                .input_is_url = controller->engine_->input_is_url()};
+            if (ShouldAskSearchEngine(query, controller->ranked_)) {
+              controller->engine_->StartWithSuggestions(text);
+            }
+          },
+          weak_factory_.GetWeakPtr(), text));
+}
+
+void CommandBarController::Refresh() {
+  // Nothing redraws while the bar fades out: late engine results are
+  // dropped, not painted into a closing card.
+  if (!view_ || !open_) {
+    return;
+  }
+  Query query;
+  query.text = prefilled_ ? std::u16string() : view_->GetQuery();
+  query.incognito = browser_->GetProfile()->IsOffTheRecord();
+  if (prefilled_) {
+    query.current_page = current_page_;
+    query.current_page_title = current_page_title_;
+  }
+  Inputs inputs = local_;
+  if (engine_ && !query.text.empty()) {
+    query.input_is_url = engine_->input_is_url();
+    inputs.engine = engine_->Candidates();
+  }
+  ranked_ = Rank(query, inputs);
+  ++generation_;
+  // The view keeps the selection on the same row while the query is
+  // unchanged, so late rows never move it.
+  view_->SetRows(ranked_.rows);
+  if (IsShowing()) {
+    // Keyboard content swaps don't animate (plan 02): the card takes its
+    // new height at once. A result change during the grow ends the grow.
+    if (grow_) {
+      grow_->Finish();
+    }
+    PlaceWidget(/*animate_from_field=*/false);
+  }
+}
+
+void CommandBarController::OnRowChosen(size_t index, int event_flags) {
+  if (!IsShowing() || index >= ranked_.rows.size()) {
+    return;
+  }
+  const Row row = ranked_.rows[index];
+  const std::u16string query = view_->GetQuery();
+  const bool command = event_flags & ui::EF_COMMAND_DOWN;
+  // Option+Enter opens a page in a new tab behind this one, and the bar
+  // closes; rows that switch tabs or run actions ignore it.
+  const bool background = event_flags & ui::EF_ALT_DOWN;
+  WindowOpenDisposition disposition = WindowOpenDisposition::CURRENT_TAB;
+  if (background) {
+    disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  } else if (entry_ == Entry::kNewTab || command) {
+    disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+
+  // Cmd+L's untouched URL: Enter changes nothing, as in Arc; Cmd+Enter
+  // opens the page again in a new tab, Option+Enter in a background one.
+  if (row.kind == RowKind::kCurrentPage && !command && !background) {
+    Close(CloseReason::kCancelled);
+    return;
+  }
+
+  // Act first, while the row's target still exists, then close. Closing
+  // first could end the fade at once (no animations, as in tests) and clear
+  // the engine's result before Open() read it. Acting can close the bar
+  // itself: switching windows or tabs takes its focus, and Close() then runs
+  // as kLostFocus, so the Close() below does nothing. An action can also
+  // close the window, which deletes this controller.
+  base::WeakPtr<CommandBarController> weak = weak_factory_.GetWeakPtr();
+  const bool acted = Act(row, query, disposition);
+  if (!weak) {
+    return;
+  }
+  if (!acted) {
+    if (!IsShowing()) {
+      return;
+    }
+    if (row.ref.empty()) {
+      // An engine row whose result is gone; nothing to drop or retry.
+      Close(CloseReason::kCancelled);
+      return;
+    }
+    // The tab, item, or action went away while the bar was open. Drop the
+    // row and stay open, rather than closing on nothing.
+    DropRef(row.ref);
+    Refresh();
+    return;
+  }
+  Close(CloseReason::kChosen);
+}
+
+bool CommandBarController::Act(const Row& row,
+                               const std::u16string& query,
+                               WindowOpenDisposition disposition) {
+  switch (row.kind) {
+    case RowKind::kCurrentPage: {
+      // The tab may have moved on since the bar opened (a redirect, or Cmd+[
+      // while the bar had focus); open the page it shows now.
+      tabs::TabInterface* tab = browser_->GetTabStripModel()->GetActiveTab();
+      NavigateParams params(
+          browser_, tab ? tab->GetContents()->GetVisibleURL() : row.url,
+          ui::PageTransitionFromInt(ui::PAGE_TRANSITION_TYPED |
+                                    ui::PAGE_TRANSITION_FROM_ADDRESS_BAR));
+      params.disposition =
+          disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB
+              ? WindowOpenDisposition::NEW_BACKGROUND_TAB
+              : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      Navigate(&params);
+      return true;
+    }
+    case RowKind::kTypedUrl:
+    case RowKind::kHistory:
+    case RowKind::kSearch:
+    case RowKind::kSuggestion:
+      // Engine rows exist only once the engine does.
+      return engine_ && engine_->Open(row.result_index, browser_, disposition);
+    case RowKind::kOpenTab:
+    case RowKind::kPinnedTab:
+    case RowKind::kFavorite:
+      return ActivateRef(browser_, row.ref);
+    case RowKind::kAction:
+      return RunAction(browser_, row.ref, std::u16string());
+    case RowKind::kAsk:
+      return RunAction(browser_, row.ref, query);
+  }
+}
+
+void CommandBarController::DropRef(const std::string& ref) {
+  if (ref.empty()) {
+    return;
+  }
+  std::erase_if(local_.tabs,
+                [&](const TabCandidate& tab) { return tab.ref == ref; });
+  std::erase_if(local_.saved,
+                [&](const SavedCandidate& item) { return item.ref == ref; });
+  std::erase_if(local_.actions, [&](const ActionCandidate& action) {
+    return action.id == ref;
+  });
+}
+
+bool CommandBarController::OnAccelerator(const ui::Accelerator& accelerator) {
+  // The bar's own two shortcuts while its field has focus: the bar's window
+  // has no browser shortcuts, so they would otherwise do nothing here.
+  // Looked up in the shortcut service, so a rebound key works too.
+  browser_shortcuts::BrowserShortcutService* service =
+      browser_shortcuts::BrowserShortcutServiceFactory::GetForProfile(
+          browser_->GetProfile());
+  if (!service) {
+    return false;
+  }
+  for (const auto& [key, command_id] : service->GetAcceleratorMap()) {
+    if (key == accelerator &&
+        (command_id == IDC_RAC_OPEN_COMMAND_BAR ||
+         command_id == IDC_RAC_OPEN_COMMAND_BAR_WITH_URL)) {
+      chrome::ExecuteCommand(browser_, command_id);
+      return true;
+    }
+  }
+  return false;
+}
+
+void CommandBarController::OnCancel() {
+  Close(CloseReason::kCancelled);
+}
+
+ui::ImageModel CommandBarController::GetIcon(const Row& row, size_t index) {
+  switch (row.kind) {
+    case RowKind::kSearch:
+    case RowKind::kSuggestion:
+      return VectorIcon(vector_icons::kSearchIcon);
+    case RowKind::kAction:
+    case RowKind::kAsk:
+      if (const gfx::VectorIcon* icon = ActionIcon(row.ref)) {
+        return VectorIcon(*icon);
+      }
+      if (row.kind == RowKind::kAsk && row.ref == kAskActionId) {
+        return VectorIcon(kAskIcon);
+      }
+      return ui::ImageModel();  // A quiet blank slot, as in the sketch.
+    case RowKind::kCurrentPage:
+      if (tabs::TabInterface* tab =
+              browser_->GetTabStripModel()->GetActiveTab()) {
+        if (ui::ImageModel icon = TabUIHelper::From(tab)->GetFavicon();
+            !icon.IsEmpty()) {
+          return icon;
+        }
+      }
+      break;
+    case RowKind::kOpenTab:
+      if (ui::ImageModel icon = TabFavicon(row.ref); !icon.IsEmpty()) {
+        return icon;
+      }
+      break;
+    case RowKind::kTypedUrl:
+    case RowKind::kHistory:
+    case RowKind::kPinnedTab:
+    case RowKind::kFavorite:
+      break;
+  }
+  if (!favicons_) {
+    return VectorIcon(vector_icons::kHistoryIcon);
+  }
+  // Favicons load from disk; a late one replaces the placeholder if the
+  // row is still the one on screen.
+  gfx::Image cached = favicons_->GetFaviconForPageUrl(
+      row.url,
+      base::BindOnce(
+          [](base::WeakPtr<CommandBarController> controller,
+             uint64_t generation, size_t index, const gfx::Image& image) {
+            if (controller && controller->generation_ == generation &&
+                controller->view_) {
+              controller->view_->SetRowIcon(index,
+                                            ui::ImageModel::FromImage(image));
+            }
+          },
+          weak_factory_.GetWeakPtr(), generation_, index));
+  return cached.IsEmpty() ? VectorIcon(vector_icons::kHistoryIcon)
+                          : ui::ImageModel::FromImage(cached);
+}
+
+void CommandBarController::Close(CloseReason reason) {
+  if (!IsShowing()) {
+    return;
+  }
+  open_ = false;
+  closing_ = true;
+  suggest_timer_.Stop();
+  active_tab_subscription_ = {};
+  if (grow_) {
+    grow_->Finish();
+  }
+  paint_as_active_.reset();
+  // Stop asking providers now; their late results would only be dropped.
+  if (engine_) {
+    engine_->Clear();
+  }
+
+  // Input never waits for the fade: the card stops taking events, its
+  // window lets clicks through to the page, and key status goes back to the
+  // browser window now, unless something else (a chosen tab's window, a
+  // click elsewhere) already took it.
+  view_->SetCanProcessEventsWithinSubtree(false);
+  SetClickThrough(widget_.get(), true);
+  if (widget_->IsActive()) {
+    BrowserView::GetBrowserViewForBrowser(browser_)->GetWidget()->Activate();
+  }
+
+  // Focus returns to where it was, unless the user chose a row (which
+  // focuses its own target) or clicked somewhere else.
+  if (reason == CloseReason::kCancelled) {
+    if (views::View* view = focus_before_.view()) {
+      view->RequestFocus();
+    } else if (tabs::TabInterface* tab =
+                   browser_->GetTabStripModel()->GetActiveTab()) {
+      tab->GetContents()->Focus();
+    }
+  }
+  focus_before_.SetView(nullptr);
+
+  // Esc leaves nothing behind: no tab, no text, no rows next time. The fade
+  // may end at once (no animations), so it starts last.
+  views::AnimationBuilder()
+      .OnEnded(base::BindOnce(&CommandBarController::OnFadeEnded,
+                              weak_factory_.GetWeakPtr()))
+      .OnAborted(base::BindOnce(&CommandBarController::OnFadeEnded,
+                                weak_factory_.GetWeakPtr()))
+      .Once()
+      .SetDuration(style::kFade)
+      .SetOpacity(widget_->GetLayer(), 0.0f, style::kFadeTween);
+}
+
+void CommandBarController::OnFadeEnded() {
+  // Runs once per fade, when it ends or is cut short (a reopen stops it).
+  closing_ = false;
+  if (!widget_) {
+    return;
+  }
+  widget_->Hide();
+  widget_->GetLayer()->SetOpacity(1.0f);
+  if (view_) {
+    view_->SetQuery(std::u16string(), /*select_all=*/false);
+    view_->SetRows({});
+  }
+  local_ = Inputs();
+  ranked_ = RankedRows();
+  // Idle costs nothing: the engine's providers and the favicon cache keep
+  // history and search-engine observers alive, so they go until the next
+  // open. Deleted later, never under a call into them.
+  if (engine_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(engine_));
+  }
+  if (favicons_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(favicons_));
+  }
+}
+
+std::optional<gfx::Rect> CommandBarController::FieldBoundsInScreen() const {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  LocationBarView* location_bar = browser_view->GetLocationBarView();
+  if (!location_bar || !location_bar->IsDrawn()) {
+    return std::nullopt;  // Hidden sidebar or hidden toolbar: no field.
+  }
+  return location_bar->GetBoundsInScreen();
+}
+
+std::optional<gfx::Rect> CommandBarController::TextBoundsInScreen() const {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  LocationBarView* location_bar = browser_view->GetLocationBarView();
+  if (!location_bar || !location_bar->omnibox_view() ||
+      !location_bar->omnibox_view()->IsDrawn()) {
+    return std::nullopt;
+  }
+  return location_bar->omnibox_view()->GetBoundsInScreen();
+}
+
+gfx::Rect CommandBarController::CardBoundsInScreen(int card_height) const {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  const gfx::Rect window = browser_view->GetBoundsInScreen();
+  const gfx::Rect page =
+      browser_view->contents_container()->GetBoundsInScreen();
+  const int max_width = std::max(1, window.width() - 2 * style::kCardMargin);
+  // Under kCardMinWidth + margins the card takes what the window has.
+  const int min_width = std::min(style::kCardMinWidth, max_width);
+  // Never flush with the window's top edge, where the card's own edge and
+  // corners would read as cut off.
+  const gfx::Rect fit(window.x() + style::kCardMargin,
+                      window.y() + style::kCardWindowGap, max_width,
+                      window.height() - style::kCardWindowGap);
+
+  if (entry_ == Entry::kFocusLocation) {
+    if (std::optional<gfx::Rect> field = FieldBoundsInScreen()) {
+      // Over the field: the bar's text starts where the field's text was,
+      // in the top bar and in the sidebar alike, and the card reaches the
+      // field's right edge, so none of the old field shows beside it. A
+      // narrow sidebar field gets kCardMinWidth.
+      const gfx::Rect text = TextBoundsInScreen().value_or(*field);
+      const int text_inset = style::kCardPadding +
+                             style::kRowHorizontalPadding +
+                             style::kFieldIconSize + style::kRowGap;
+      const int left = text.x() - text_inset;
+      const int width = std::clamp(field->right() + style::kCardPadding - left,
+                                   min_width, max_width);
+      const int top = text.CenterPoint().y() - style::kFieldHeight / 2 -
+                      style::kCardPadding;
+      // A field wholly in the window's right half (the sidebar on the right)
+      // keeps its right edge, so a card wider than the field grows inward
+      // rather than being pushed off the field.
+      const bool right = field->x() > window.CenterPoint().x();
+      gfx::Rect card(
+          right ? field->right() + style::kCardPadding - width : left, top,
+          width, card_height);
+      card.AdjustToFit(fit);
+      return card;
+    }
+  }
+  // Centered on the page, in its upper part.
+  const int width = std::clamp(page.width() - 2 * style::kCardMargin, min_width,
+                               style::kCardMaxWidth);
+  const int top =
+      std::clamp(static_cast<int>(page.height() * style::kCenteredTopFraction),
+                 style::kCenteredTopMin, style::kCenteredTopMax);
+  gfx::Rect card(page.CenterPoint().x() - width / 2, page.y() + top, width,
+                 card_height);
+  card.AdjustToFit(fit);
+  return card;
+}
+
+void CommandBarController::PlaceWidget(bool animate_from_field) {
+  const int width = CardBoundsInScreen(0).width();
+  const gfx::Rect card = CardBoundsInScreen(view_->GetCardSize(width).height());
+  gfx::Rect widget_bounds = card;
+  widget_bounds.Outset(CommandBarView::ShadowMargin());
+  widget_->SetBounds(widget_bounds);
+
+  // Card and content in the view's coordinates.
+  gfx::Rect local = card;
+  local.Offset(-widget_bounds.OffsetFromOrigin());
+  view_->SetCardBounds(local, local);
+
+  grow_.reset();
+  if (animate_from_field) {
+    gfx::Rect from = *FieldBoundsInScreen();
+    from.Offset(-widget_bounds.OffsetFromOrigin());
+    from.Intersect(local);  // The card always contains its start.
+    grow_ = std::make_unique<CommandBarGrowAnimation>(
+        widget_->GetCompositor(), from, local,
+        base::BindRepeating(
+            [](CommandBarView* view, gfx::Rect content, const gfx::Rect& card) {
+              view->SetCardBounds(card, content);
+            },
+            base::Unretained(view_.get()), local));
+  }
+}
+
+void CommandBarController::OnWidgetActivationChanged(views::Widget* widget,
+                                                     bool active) {
+  // A click outside the card, or another window: close, and let that click
+  // do what it was for.
+  if (widget == widget_.get() && !active) {
+    Close(CloseReason::kLostFocus);
+  }
+}
+
+void CommandBarController::OnWidgetBoundsChanged(views::Widget* widget,
+                                                 const gfx::Rect& new_bounds) {
+  if (widget != widget_.get() && IsShowing()) {
+    if (grow_) {
+      grow_->Finish();
+    }
+    PlaceWidget(/*animate_from_field=*/false);
+  }
+}
+
+void CommandBarController::OnWidgetDestroying(views::Widget* widget) {
+  if (widget == widget_.get()) {
+    // The bar's own window is going (its parent closed): drop everything
+    // that points into it or outlives a session. The Widget object is ours;
+    // it is deleted after this notification returns, and a later Show()
+    // builds a new one.
+    widget_observation_.Reset();
+    suggest_timer_.Stop();
+    active_tab_subscription_ = {};
+    paint_as_active_.reset();
+    grow_.reset();
+    view_ = nullptr;
+    open_ = false;
+    closing_ = false;
+    local_ = Inputs();
+    ranked_ = RankedRows();
+    // Engine and favicons go as at the end of a fade: deleted later, never
+    // under a call into them (their destructors run outside Widget's).
+    if (engine_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(engine_));
+    }
+    if (favicons_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(favicons_));
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(widget_));
+    return;
+  }
+  browser_widget_observation_.Reset();
+}
+
+}  // namespace rac::command_bar

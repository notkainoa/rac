Index: src/chrome/browser/rac/actions/rac_actions_command_bar.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/actions/rac_actions_command_bar.cc
@@ -0,0 +1,208 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+// The command bar's rows in the action table. Pure data, like every row;
+// joins All() through rac_actions_groups.h.
+//
+// Two rows open the bar. They are kBrowser rows with new ids from
+// rac_action_ids.h, inside IDC_RAC_ACTION_FIRST..LAST, so Core's dispatch
+// hook sends them to their handlers in chrome/browser/ui/rac/
+// rac_action_handlers.cc. They take over Cmd+T and Cmd+L through
+// `replaces_command_id` (D13, D28) and get their own File menu items right
+// after New Tab and Open Location, which stay and keep doing what they say.
+// Power's shortcut hooks move the keys and the menu's key equivalents.
+//
+// `ask` (D30) sends what the user typed to the assistant. It is ai_only, so
+// with AI off ForSurface() drops it and the bar has no Ask row. Its
+// classification is the one in docs/internals/action-table.md; the AI thread
+// may take the row over.
+//
+// The other rows are launcher entries for commands that already exist. They
+// are Dispatch::kCommand rows: they keep Chromium's (or rac's) ids, so their
+// shortcuts and users' rebinds stay as they are, Core's hook never routes
+// them, and the bar runs them with chrome::ExecuteCommand. They add only a
+// label, keywords, and the bar's surfaces.
+//
+// No row sets `icon`: :core depends on base only, and a VectorIcon pointer
+// would pull in an icon target. The bar draws a quiet blank slot instead.
+
+#include "base/containers/span.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/rac/actions/rac_action_ids.h"
+#include "chrome/browser/rac/actions/rac_actions.h"
+#include "chrome/browser/rac/actions/rac_actions_groups.h"
+#include "chrome/grit/generated_resources.h"
+#include "chrome/grit/rac_strings.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace rac::action_table {
+
+namespace {
+
+constexpr char kNoArgs[] =
+    R"json({"additionalProperties":false,"properties":{},"required":[],"type":"object"})json";
+
+// Opening the bar, a window, or a page is undoable and touches nothing
+// outside the browser. No agent is offered any of these rows.
+constexpr McpHints kLocalUi = {.read_only = false,
+                               .destructive = false,
+                               .idempotent = false,
+                               .open_world = false};
+
+constexpr Action kCommandBarActions[] = {
+    {
+        .id = "open_command_bar",
+        .command_id = IDC_RAC_OPEN_COMMAND_BAR,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_OPEN,
+        .description = "Open the command bar.",
+        .args_json = kNoArgs,
+        .default_shortcut = {.key = ui::VKEY_T,
+                             .modifiers = ui::EF_COMMAND_DOWN,
+                             .replaces_command_id = IDC_NEW_TAB},
+        .surfaces = {Surface::kMenu, Surface::kShortcut},
+        .menu = Menu::kFile,
+        .menu_after = IDC_NEW_TAB,
+        // D13's setting (rac::kNewTabOpensCommandBar). Off gives Cmd+T
+        // back to New Tab and hides this item. A literal: :core depends on
+        // base only.
+        .shortcut_pref = "rac.command_bar.new_tab_opens_bar",
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kBrowser,
+    },
+    {
+        .id = "open_command_bar_with_url",
+        .command_id = IDC_RAC_OPEN_COMMAND_BAR_WITH_URL,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_OPEN_WITH_URL,
+        .description = "Open the command bar with this page's address.",
+        .args_json = kNoArgs,
+        .default_shortcut = {.key = ui::VKEY_L,
+                             .modifiers = ui::EF_COMMAND_DOWN,
+                             .replaces_command_id = IDC_FOCUS_LOCATION},
+        .surfaces = {Surface::kMenu, Surface::kShortcut},
+        .menu = Menu::kFile,
+        .menu_after = IDC_FOCUS_LOCATION,
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kBrowser,
+    },
+    {
+        .id = "new_space",
+        .command_id = IDC_RAC_NEW_SPACE,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_NEW_SPACE,
+        .keywords_id = IDS_RAC_COMMAND_BAR_KEYWORDS_NEW_SPACE,
+        .description = "Create a new space and show it in this window.",
+        .args_json = kNoArgs,
+        .availability = {Need::kSpaces},
+        .surfaces = {Surface::kCommandBar, Surface::kCommandBarSuggested},
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kCommand,
+    },
+    {
+        .id = "new_window",
+        .command_id = IDC_NEW_WINDOW,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_NEW_WINDOW,
+        .description = "Open a new window.",
+        .args_json = kNoArgs,
+        .surfaces = {Surface::kCommandBar},
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kCommand,
+    },
+    {
+        .id = "new_incognito_window",
+        .command_id = IDC_NEW_INCOGNITO_WINDOW,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_NEW_INCOGNITO_WINDOW,
+        .keywords_id = IDS_RAC_COMMAND_BAR_KEYWORDS_NEW_INCOGNITO_WINDOW,
+        .description = "Open a new incognito window.",
+        .args_json = kNoArgs,
+        .surfaces = {Surface::kCommandBar, Surface::kCommandBarSuggested},
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kCommand,
+    },
+    {
+        .id = "show_history",
+        .command_id = IDC_SHOW_HISTORY,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_HISTORY,
+        .description = "Open the history page.",
+        .args_json = kNoArgs,
+        .surfaces = {Surface::kCommandBar, Surface::kCommandBarSuggested},
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kCommand,
+    },
+    {
+        .id = "show_downloads",
+        .command_id = IDC_SHOW_DOWNLOADS,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_DOWNLOADS,
+        .description = "Open the downloads page.",
+        .args_json = kNoArgs,
+        .surfaces = {Surface::kCommandBar},
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kCommand,
+    },
+    {
+        .id = "open_settings",
+        .command_id = IDC_OPTIONS,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_SETTINGS,
+        .keywords_id = IDS_RAC_COMMAND_BAR_KEYWORDS_SETTINGS,
+        .description = "Open settings.",
+        .args_json = kNoArgs,
+        .surfaces = {Surface::kCommandBar},
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kCommand,
+    },
+    {
+        .id = "ask",
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_ASK,
+        .query_arg = "prompt",
+        .description = "Ask the assistant about what the user typed.",
+        .args_json =
+            R"json({"additionalProperties":false,"properties":{"prompt":{"type":"string"}},"required":["prompt"],"type":"object"})json",
+        .availability = {Need::kNotIncognito},
+        .surfaces = {Surface::kCommandBar},
+        .ai_only = true,
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = McpHints{.read_only = false,
+                          .destructive = false,
+                          .idempotent = false,
+                          .open_world = true},
+        .dispatch = Dispatch::kBrowser,
+    },
+    {
+        .id = "edit_space",
+        .command_id = IDC_RAC_EDIT_SPACE,
+        .label_id = IDS_RAC_COMMAND_BAR_ACTION_EDIT_SPACE,
+        .keywords_id = IDS_RAC_COMMAND_BAR_KEYWORDS_EDIT_SPACE,
+        .description = "Edit this space's name, icon, and colors.",
+        .args_json = kNoArgs,
+        .availability = {Need::kSpaces},
+        .surfaces = {Surface::kCommandBar},
+        .risk = RiskClass::kNone,
+        .outside = OutsideClass::kNotOffered,
+        .hints = kLocalUi,
+        .dispatch = Dispatch::kCommand,
+    },
+};
+
+}  // namespace
+
+base::span<const Action> CommandBarActions() {
+  return kCommandBarActions;
+}
+
+}  // namespace rac::action_table

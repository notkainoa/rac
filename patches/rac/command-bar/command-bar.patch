+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_PROVIDER_CLIENT_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_PROVIDER_CLIENT_H_
+
+#include <memory>
+
+#include "chrome/browser/autocomplete/chrome_autocomplete_provider_client.h"
+
+class Profile;
+
+namespace rac::command_bar {
+
+// Chrome's provider client with the parts the command bar must not do.
+//
+// - No network for local typing (D29). The engine's local passes run the
+//   asynchronous local work (HistoryURLProvider's on-disk history pass)
+//   with remote suggestions switched off here: SearchSuggestEnabled() answers
+//   false until a suggestions pass allows it, so the search engine is
+//   asked only while the engine allows it, after D29's gate. The service
+//   worker never starts either: AutocompleteController::Start asks the
+//   client to start the default engine's worker on the first QUERY input
+//   of a session (autocomplete_controller.cc:765-769 in 156), and
+//   Chrome's client checks only suggest-enabled and incognito
+//   (chrome_autocomplete_provider_client.cc:607-633). rac turns
+//   suggestions on by default, so typing local text would wake the
+//   engine's worker. Suggest-response images are never prefetched either:
+//   the bar draws none. Nor does the bar prime geolocation:
+//   SearchProvider::Start calls PrimeLocation() on every keystroke, before
+//   any suggest check (search_provider.cc:249 in 156).
+// - No extension omnibox keywords. With asynchronous matches on, Chrome's
+//   keyword delegate sends the typed text to an extension's omnibox
+//   listener (keyword_extensions_delegate_impl.cc:79 in 156), and the
+//   extension may send it anywhere. The address bar keeps them.
+// - Off the record, no regular-profile data. Chrome's history, bookmark,
+//   shortcut, and URL-index factories redirect an incognito profile to the
+//   regular one (EXPLICIT_ACCESS), and SearchProvider reads the in-memory
+//   history database even when no history provider exists
+//   (search_provider.cc:696). Off the record, every one of them is null.
+class CommandBarProviderClient : public ChromeAutocompleteProviderClient {
+ public:
+  explicit CommandBarProviderClient(Profile* profile);
+  CommandBarProviderClient(const CommandBarProviderClient&) = delete;
+  CommandBarProviderClient& operator=(const CommandBarProviderClient&) = delete;
+  ~CommandBarProviderClient() override;
+
+  // AutocompleteProviderClient:
+  history::HistoryService* GetHistoryService() override;
+  history_clusters::HistoryClustersService* GetHistoryClustersService()
+      override;
+  history_embeddings::HistoryEmbeddingsSearch* GetHistoryEmbeddingsSearch()
+      override;
+  scoped_refptr<history::TopSites> GetTopSites() override;
+  bookmarks::BookmarkModel* GetBookmarkModel() override;
+  history::URLDatabase* GetInMemoryDatabase() override;
+  InMemoryURLIndex* GetInMemoryURLIndex() override;
+  GeolocationHeaderService* GetGeolocationHeaderService() const override;
+  scoped_refptr<ShortcutsBackend> GetShortcutsBackend() override;
+  scoped_refptr<ShortcutsBackend> GetShortcutsBackendIfExists() override;
+  bool SearchSuggestEnabled() const override;
+  std::unique_ptr<KeywordExtensionsDelegate> GetKeywordExtensionsDelegate(
+      KeywordProvider* keyword_provider) override;
+  void PrefetchImage(const GURL& url) override;
+  void StartServiceWorker(const GURL& destination_url) override;
+
+  // Remote suggestions stay off until the engine's suggestions pass turns
+  // them on; a local pass sends nothing (D29).
+  void set_remote_suggestions_allowed(bool allowed);
+
+ private:
+  const bool off_the_record_;
+  bool remote_suggestions_allowed_ = false;
+};
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_PROVIDER_CLIENT_H_

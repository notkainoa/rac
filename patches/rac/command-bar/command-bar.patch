+++ src/chrome/browser/ui/views/rac/command_bar/command_bar_ranker.h
@@ -0,0 +1,59 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_RANKER_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_RANKER_H_
+
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/ui/views/rac/command_bar/command_bar_types.h"
+
+class GURL;
+
+// The command bar's merge and ranking, v1 (plan 01, "The command bar in
+// detail"). Pure functions over plain data: no Views, no omnibox, no
+// services. The autocomplete code gets no hunk because the merge happens
+// here, on rows the engine adapter has already converted.
+//
+// Order, top to bottom:
+//   1. What was typed, when Chromium's default match is a URL or a bang.
+//   2. Open tabs: this space first, then other spaces. An open tab beats the
+//      same URL from history (the history row becomes the tab).
+//   3. Pinned tabs and favorites, one section: this space's pinned tabs and
+//      the favorites first, then other spaces' pinned tabs.
+//   4. History, bookmarks, and shortcuts, in Chromium's order.
+//   5. Actions whose every term starts a word of the label or keywords.
+//   6. Search for what was typed, an address Chromium can open but didn't
+//      classify as a URL, the Ask row (AI on only), then search engine
+//      suggestions, last.
+namespace rac::command_bar {
+
+// How `text` and `url` match `query`. `keywords` count only for word starts.
+// Case is folded; accents are not.
+MatchTier Match(std::u16string_view query,
+                std::u16string_view title,
+                const GURL& url,
+                std::u16string_view keywords = {});
+
+// Ranks a non-empty query. An empty or blank query gives RankEmpty().
+RankedRows Rank(const Query& query, const Inputs& inputs);
+
+// The empty state: Cmd+L's untouched page if any, recent tabs in this space,
+// then suggested actions. It reads no engine rows, so the caller never
+// starts the autocomplete for it.
+RankedRows RankEmpty(const Query& query, const Inputs& inputs);
+
+// D29's gate, minus the pause, which the controller times. False for URLs,
+// bangs, incognito, and whenever local rows have not run out.
+bool ShouldAskSearchEngine(const Query& query, const RankedRows& local);
+
+// The key two URLs share when they are the same page for de-duplication:
+// http and https, a leading "www.", a lone "/" path, and the fragment are
+// ignored.
+std::string DedupeKey(const GURL& url);
+
+}  // namespace rac::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_COMMAND_BAR_COMMAND_BAR_RANKER_H_

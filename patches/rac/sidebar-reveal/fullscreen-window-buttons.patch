@@ -0,0 +1,38 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_WINDOW_BUTTONS_RATIO_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_WINDOW_BUTTONS_RATIO_H_
+
+namespace rac {
+
+// What decides how much of the window buttons (traffic lights) shows in
+// frameless mode, as plain values so the rule can be tested on its own.
+struct WindowButtonsState {
+  // Sidebar layout: the address bar, and the window buttons, are in the
+  // sidebar. Otherwise they sit at the start of the toolbar's row.
+  bool address_bar_in_sidebar = false;
+  // The sidebar header hides the buttons: Top bar layout with the sidebar
+  // hidden, where the top bar spans the window. Edge reveal doesn't bring
+  // them back there.
+  bool hidden_with_sidebar = false;
+  // How far the sidebar is shown: 0 hidden, 1 docked or revealed. While the
+  // sidebar slides it's 1 sliding in and 0 sliding out.
+  float sidebar_reveal = 1.0f;
+  // How far the toolbar is shown. Frameless mode keeps it at 1.
+  float top_chrome_reveal = 1.0f;
+};
+
+// The opacity of the real window buttons: they fade with the chrome they
+// sit in. Hiding them with the sidebar is done by hiding the buttons.
+float WindowButtonsRevealRatio(const WindowButtonsState& state);
+
+// The opacity of the copies of the window buttons Helium shows in
+// fullscreen. They follow the real ones, including going away with the
+// sidebar, since nothing hides them otherwise.
+float FullscreenWindowButtonsRatio(const WindowButtonsState& state);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_WINDOW_BUTTONS_RATIO_H_
--- /dev/null
+++ b/chrome/browser/ui/views/rac/sidebar_reveal/window_buttons_ratio_unittest.cc
@@ -0,0 +1,92 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_reveal/window_buttons_ratio.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+enum class Sidebar { kDocked, kRevealing, kHidden };
+
+// The state RacSidebarHeaderView and BrowserView give for each layout and
+// sidebar state. `reveal` is the sidebar's reveal ratio while it floats in
+// from the edge; the toolbar is pinned in frameless mode.
+WindowButtonsState StateFor(bool sidebar_layout,
+                            Sidebar sidebar,
+                            float reveal) {
+  WindowButtonsState state;
+  state.address_bar_in_sidebar = sidebar_layout;
+  // In the Top bar layout the header hides the buttons whenever the sidebar
+  // is hidden, edge reveal included: the top bar spans the window then.
+  state.hidden_with_sidebar = !sidebar_layout && sidebar != Sidebar::kDocked;
+  switch (sidebar) {
+    case Sidebar::kDocked:
+      state.sidebar_reveal = 1.0f;
+      break;
+    case Sidebar::kRevealing:
+      state.sidebar_reveal = reveal;
+      break;
+    case Sidebar::kHidden:
+      state.sidebar_reveal = 0.0f;
+      break;
+  }
+  state.top_chrome_reveal = 1.0f;
+  return state;
+}
+
+TEST(WindowButtonsRatioTest, TopBarLayoutFollowsTheSidebarInFullscreen) {
+  for (float reveal : {0.0f, 0.25f, 1.0f}) {
+    SCOPED_TRACE(reveal);
+    EXPECT_EQ(1.0f, FullscreenWindowButtonsRatio(
+                        StateFor(false, Sidebar::kDocked, reveal)));
+    EXPECT_EQ(0.0f, FullscreenWindowButtonsRatio(
+                        StateFor(false, Sidebar::kRevealing, reveal)));
+    EXPECT_EQ(0.0f, FullscreenWindowButtonsRatio(
+                        StateFor(false, Sidebar::kHidden, reveal)));
+  }
+}
+
+TEST(WindowButtonsRatioTest, SidebarLayoutFollowsTheSidebarInFullscreen) {
+  for (float reveal : {0.0f, 0.25f, 1.0f}) {
+    SCOPED_TRACE(reveal);
+    EXPECT_EQ(1.0f, FullscreenWindowButtonsRatio(
+                        StateFor(true, Sidebar::kDocked, reveal)));
+    EXPECT_EQ(reveal, FullscreenWindowButtonsRatio(
+                          StateFor(true, Sidebar::kRevealing, reveal)));
+    EXPECT_EQ(0.0f, FullscreenWindowButtonsRatio(
+                        StateFor(true, Sidebar::kHidden, reveal)));
+  }
+}
+
+// Outside fullscreen the header hides the real buttons itself, so their
+// opacity only fades with the chrome they sit in.
+TEST(WindowButtonsRatioTest, WindowedRatioLeavesHidingToTheHeader) {
+  for (float reveal : {0.0f, 0.25f, 1.0f}) {
+    SCOPED_TRACE(reveal);
+    for (Sidebar sidebar :
+         {Sidebar::kDocked, Sidebar::kRevealing, Sidebar::kHidden}) {
+      EXPECT_EQ(1.0f,
+                WindowButtonsRevealRatio(StateFor(false, sidebar, reveal)));
+    }
+    EXPECT_EQ(reveal, WindowButtonsRevealRatio(
+                          StateFor(true, Sidebar::kRevealing, reveal)));
+    EXPECT_EQ(0.0f, WindowButtonsRevealRatio(
+                        StateFor(true, Sidebar::kHidden, reveal)));
+  }
+}
+
+// Helium's own rule, for an unpinned toolbar: the buttons fade with it.
+TEST(WindowButtonsRatioTest, TopChromeRevealDrivesToolbarButtons) {
+  WindowButtonsState state;
+  state.top_chrome_reveal = 0.5f;
+  EXPECT_EQ(0.5f, WindowButtonsRevealRatio(state));
+  EXPECT_EQ(0.5f, FullscreenWindowButtonsRatio(state));
+  state.hidden_with_sidebar = true;
+  EXPECT_EQ(0.0f, FullscreenWindowButtonsRatio(state));
+}
+
+}  // namespace
+}  // namespace rac

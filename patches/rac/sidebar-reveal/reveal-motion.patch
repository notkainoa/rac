+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_REVEAL_MOTION_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_REVEAL_MOTION_H_
+
+class BrowserView;
+
+namespace views {
+class View;
+}
+
+namespace rac {
+
+// The hidden sidebar's reveal, moved on the compositor (plan 02, S1 and S2).
+//
+// Helium's reveal value now changes at once, so the sidebar is laid out a
+// single time, where it rests. This slides its layer there instead: in on
+// tokens::kSpringReveal, out on tokens::kSpringExit, and on tokens::kSpringDock
+// when Cmd+S docks or hides it. A turn mid-slide starts the next spring from
+// the layer's place and speed. Under Reduce Motion the sidebar fades in over
+// tokens::kReducedFade and out over tokens::kFade.
+//
+// Nothing here exists between slides: a slide's state lives on the browser
+// view only while its layer animation runs.
+
+// The reveal Helium's layout should use. `reveal` is Helium's value, 0 or 1;
+// while the sidebar slides out it stays laid out at rest, so this is 1.
+float SidebarLayoutRatio(const BrowserView* browser_view, float reveal);
+
+// The traffic lights' opacity, with the address bar in the sidebar: where a
+// slide is headed, so Helium's direct sets never undo their fade.
+float SidebarWindowButtonsRatio(const BrowserView* browser_view);
+
+// Helium's reveal value became `reveal`. Slides `sidebar` toward it, or puts it
+// there at once when `pinned`.
+void OnSidebarRevealChanged(BrowserView* browser_view,
+                            views::View* sidebar,
+                            float reveal,
+                            bool pinned);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_REVEAL_MOTION_H_

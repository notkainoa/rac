+namespace rac {
+
+namespace {
+
+// One layer moving along x on a spring, and where it's headed.
+struct Track {
+  raw_ptr<ui::LayerAnimationSequence> sequence = nullptr;
+  // The layer's x where the running spring rests.
+  float rest_x = 0;
+
+  // Where the layer is now along x, and how fast it moves.
+  float X(const ui::Layer* layer) const {
+    if (!sequence) {
+      return layer ? layer->transform().To2dTranslation().x() : 0;
+    }
+    return rest_x +
+           static_cast<SpringTransformElement*>(sequence->FirstElement())
+               ->GetOffset();
+  }
+  float Velocity() const {
+    return sequence
+               ? static_cast<SpringTransformElement*>(sequence->FirstElement())
+                     ->GetVelocity()
+               : 0;
+  }
+};
+
+constexpr NSWindowButton kTypes[] = {
+    NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton};
+
+// With the address bar in the sidebar the traffic lights sit on it, so they
+// fade with its slide instead of popping when it starts. `fresh` starts the
+// fade from the far end; otherwise it turns around from where it is.
+void FadeWindowButtons(BrowserView* browser_view, bool show, bool fresh) {
+  NSWindow* window =
+      browser_view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  if (!window || !IsAddressBarInSidebar(browser_view) ||
+      browser_view->IsFullscreen()) {
+    return;
+  }
+  const Timing& timing = show ? tokens::kReducedFade : tokens::kFade;
+  for (NSWindowButton type : kTypes) {
+    NSButton* button = [window standardWindowButton:type];
+    CALayer* shown = button.layer.presentationLayer;
+    button.alphaValue =
+        fresh ? (show ? 0 : 1) : (shown ? shown.opacity : button.alphaValue);
+  }
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = timing.duration.InSecondsF();
+    context.timingFunction = [CAMediaTimingFunction
+        functionWithControlPoints:timing.curve.x1
+                                 :timing.curve.y1
+                                 :timing.curve.x2
+                                 :timing.curve.y2];
+    for (NSWindowButton type : kTypes) {
+      [window standardWindowButton:type].animator.alphaValue = show ? 1 : 0;
+    }
+  }];
+}
+
+}  // namespace
+
+// One slide of the sidebar, in or out. It lives on the browser view only
+// while its layer animation runs.
+class SidebarSlide : public ui::LayerAnimationObserver {
+ public:
+  SidebarSlide(BrowserView* browser_view, views::View* sidebar)
+      : browser_view_(browser_view), sidebar_view_(sidebar) {}
+  SidebarSlide(const SidebarSlide&) = delete;
+  SidebarSlide& operator=(const SidebarSlide&) = delete;
+  ~SidebarSlide() override { StopObserving(); }
+
+  bool showing() const { return showing_; }
+  void set_showing(bool showing) { showing_ = showing; }
+
+  // Heads in or out from the layer's place and speed now. A new slide starts
+  // from rest: in from hidden, or out from where the sidebar sits. `dock` is
+  // Cmd+S, which moves on tokens::kSpringDock both ways.
+  void Start(bool dock);
+
+  // Stops where everything rests, as when the sidebar is pinned.
+  void Snap() {
+    StopObserving();
+    if (ui::Layer* layer = SidebarLayer()) {
+      layer->GetAnimator()->AbortAllAnimations();
+      layer->SetTransform(gfx::Transform());
+      layer->SetOpacity(1.0f);
+    }
+  }
+
+ private:
+  // ui::LayerAnimationObserver:
+  void OnLayerAnimationEnded(ui::LayerAnimationSequence* sequence) override {
+    if (sequence != sidebar_.sequence) {
+      return;
+    }
+    StopObserving();
+    FinishLater();
+  }
+  void OnLayerAnimationAborted(ui::LayerAnimationSequence* sequence) override {
+    // Something else took a layer over. Rest.
+    OnLayerAnimationEnded(sequence);
+  }
+  void OnLayerAnimationScheduled(
+      ui::LayerAnimationSequence* sequence) override {}
+
+  ui::Layer* SidebarLayer() {
+    views::View* sidebar = sidebar_view_.view();
+    return sidebar ? sidebar->layer() : nullptr;
+  }
+
+  // Where the layer's x has the sidebar fully out of the window.
+  float HiddenX() const {
+    const views::View* sidebar = sidebar_view_.view();
+    if (!sidebar || !sidebar->parent()) {
+      return 0;
+    }
+    return browser_view_->IsVerticalTabStripRightAligned()
+               ? sidebar->parent()->width() - sidebar->x()
+               : -sidebar->bounds().right();
+  }
+
+  void StopObserving() {
+    if (sidebar_.sequence) {
+      sidebar_.sequence->RemoveObserver(this);
+      sidebar_.sequence = nullptr;
+    }
+  }
+
+  // Later, so the animator has let go of the sequence first.
+  void FinishLater() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&SidebarSlide::Finish, weak_factory_.GetWeakPtr()));
+  }
+
+  void Run(ui::Layer* layer,
+           Track& track,
+           std::unique_ptr<ui::LayerAnimationElement> element) {
+    auto sequence =
+        std::make_unique<ui::LayerAnimationSequence>(std::move(element));
+    sequence->AddObserver(this);
+    track.sequence = sequence.get();
+    layer->GetAnimator()->StartAnimation(sequence.release());
+  }
+
+  // Slides `layer` from `x` at `velocity` to rest at `rest_x`.
+  void Spring(ui::Layer* layer,
+              Track& track,
+              const rac::Spring& spring,
+              float x,
+              float velocity,
+              float rest_x) {
+    track.rest_x = rest_x;
+    const SpringMotion motion{spring, x - rest_x, velocity};
+    if (motion.RestTime(tokens::kSpringRest).is_zero()) {
+      layer->SetTransform(gfx::Transform::MakeTranslation(rest_x, 0));
+      return;
+    }
+    Run(layer, track,
+        std::make_unique<SpringTransformElement>(
+            motion, gfx::Vector2dF(rest_x, 0),
+            SpringTransformElement::Axis::kX));
+  }
+
+  // At rest. Deletes this. A sidebar that slid out is now laid out hidden.
+  void Finish();
+
+  const raw_ptr<BrowserView> browser_view_;
+  views::ViewTracker sidebar_view_;
+  Track sidebar_;
+  bool showing_ = false;
+  bool started_ = false;
+  bool fading_ = false;
+  base::WeakPtrFactory<SidebarSlide> weak_factory_{this};
+};
+
+namespace {
+
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(SidebarSlide, kSidebarSlideKey)
+// What Helium's reveal and layout last had: the sidebar shown, and docked
+// beside the page rather than hidden or floating. Kept on the view, so
+// nothing is allocated for them.
+DEFINE_UI_CLASS_PROPERTY_KEY(bool, kSidebarShownKey, true)
+DEFINE_UI_CLASS_PROPERTY_KEY(bool, kSidebarDockedKey, true)
+
+}  // namespace
+
+void SidebarSlide::Start(bool dock) {
+  ui::Layer* layer = SidebarLayer();
+  if (!layer) {
+    return;
+  }
+  const bool show = showing_;
+  const bool fade = motion::ReducedMotion();
+  FadeWindowButtons(browser_view_, show, /*fresh=*/!started_);
+  // Where the sidebar's layer is and how fast it moves.
+  float x = 0;
+  float velocity = 0;
+  if (!started_) {
+    x = show ? HiddenX() : 0;
+  } else if (!fading_) {
+    x = sidebar_.X(layer);
+    velocity = sidebar_.Velocity();
+  }
+  StopObserving();
+  layer->GetAnimator()->AbortAllAnimations();
+  started_ = true;
+  fading_ = fade;
+
+  if (fade) {
+    // Fades where it rests. A fresh fade in starts clear.
+    layer->SetTransform(gfx::Transform());
+    if (show && x != 0) {
+      layer->SetOpacity(0.0f);
+    }
+    Run(layer, sidebar_,
+        CurveElement::CreateOpacity(show ? 1.0f : 0.0f,
+                                    show || dock ? tokens::kReducedFade
+                                                 : tokens::kFade));
+    return;
+  }
+
+  layer->SetOpacity(1.0f);
+  const rac::Spring& spring =
+      dock ? tokens::kSpringDock
+           : (show ? tokens::kSpringReveal : tokens::kSpringExit);
+  const float rest_x = show ? 0 : HiddenX();
+  dev::LogAnimationStep(show ? "sidebar.slide.in" : "sidebar.slide.out",
+                        x - rest_x);
+  dev::LogAnimationStep("sidebar.slide.velocity", velocity);
+  dev::LogAnimationStep("sidebar.slide.dock", dock ? 1 : 0);
+  Spring(layer, sidebar_, spring, x, velocity, rest_x);
+  if (!sidebar_.sequence) {
+    FinishLater();
+  }
+}
+
+void SidebarSlide::Finish() {
+  BrowserView* const browser_view = browser_view_;
+  views::View* const sidebar = sidebar_view_.view();
+  const bool hidden = !showing_;
+  browser_view->ClearProperty(kSidebarSlideKey);
+  // `this` is gone. Lay the sidebar out hidden before its layer comes back,
+  // so it never shows at rest for a frame.
+  if (hidden) {
+    browser_view->InvalidateLayout();
+    if (views::Widget* widget = browser_view->GetWidget()) {
+      widget->LayoutRootViewIfNecessary();
+    }
+  }
+  if (sidebar && sidebar->layer()) {
+    sidebar->layer()->SetTransform(gfx::Transform());
+    sidebar->layer()->SetOpacity(1.0f);
+  }
+  dev::LogAnimationStep("sidebar.slide.rest", hidden ? 0 : 1);
+}
+
+float SidebarLayoutRatio(const BrowserView* browser_view, float reveal) {
+  const SidebarSlide* slide = browser_view->GetProperty(kSidebarSlideKey);
+  return slide && !slide->showing() ? 1.0f : reveal;
+}
+
+float SidebarWindowButtonsRatio(const BrowserView* browser_view) {
+  const SidebarSlide* slide = browser_view->GetProperty(kSidebarSlideKey);
+  if (!slide) {
+    return browser_view->GetSideChromeRevealRatio();
+  }
+  return slide->showing() ? 1.0f : 0.0f;
+}
+
+void OnSidebarRevealChanged(BrowserView* browser_view,
+                            views::View* sidebar,
+                            float reveal,
+                            bool pinned) {
+  const bool show = reveal > 0.0f;
+  const bool docked = !browser_view->IsZenModeEnabledForLayout();
+  const bool was_shown = browser_view->GetProperty(kSidebarShownKey);
+  const bool was_docked = browser_view->GetProperty(kSidebarDockedKey);
+  browser_view->SetProperty(kSidebarShownKey, show);
+  browser_view->SetProperty(kSidebarDockedKey, docked);
+  const bool dock = docked != was_docked;
+
+  SidebarSlide* slide = browser_view->GetProperty(kSidebarSlideKey);
+  views::Widget* widget = browser_view->GetWidget();
+  if (pinned || !widget || !widget->IsVisible() || !sidebar ||
+      !sidebar->layer()) {
+    if (slide) {
+      slide->Snap();
+      browser_view->ClearProperty(kSidebarSlideKey);
+    }
+    return;
+  }
+  if (slide ? slide->showing() == show : show == was_shown) {
+    return;
+  }
+
+  if (!slide) {
+    slide = browser_view->SetProperty(
+        kSidebarSlideKey,
+        std::make_unique<SidebarSlide>(browser_view, sidebar));
+  }
+  slide->set_showing(show);
+  // Lay out once, at rest: the sidebar where it ends up or, sliding out,
+  // where it is. On Cmd+S the page takes its new width here, once.
+  widget->LayoutRootViewIfNecessary();
+  if (!sidebar->GetVisible()) {
+    slide->Snap();
+    browser_view->ClearProperty(kSidebarSlideKey);
+    return;
+  }
+  slide->Start(dock);
+}
+
+}  // namespace rac

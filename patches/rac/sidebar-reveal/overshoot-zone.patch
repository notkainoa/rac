+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_OVERSHOOT_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_OVERSHOOT_H_
+
+namespace base {
+class OneShotTimer;
+}
+
+class BrowserView;
+
+namespace views {
+class View;
+}
+
+namespace rac {
+
+// Zen's forgiving edge reveal for the hidden sidebar. Helium hides the
+// revealed sidebar 3 s after the pointer leaves the window. rac keeps it
+// while the pointer rests just outside the window beside it, in the zone
+// sidebar_overshoot_zone.h describes, and lets Helium's 3 s run again once the
+// pointer goes further.
+//
+// A pointer monitor exists only while the revealed sidebar shows. Nothing
+// watches the pointer while the sidebar is hidden, pinned or docked.
+
+// Creates `browser_view`'s pointer monitor for `sidebar` while `revealed` is
+// true, and drops it otherwise.
+void UpdateSidebarOvershoot(BrowserView* browser_view,
+                            views::View* sidebar,
+                            bool revealed);
+
+// For Helium's window-exit grace: true, after stopping `exit_timer`, if the
+// pointer is in the revealed sidebar's overshoot zone, so the sidebar stays.
+bool HoldSidebarInOvershoot(BrowserView* browser_view,
+                            base::OneShotTimer& exit_timer);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_OVERSHOOT_H_

@@ -0,0 +1,137 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_reveal/sidebar_overshoot_zone.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+// A 1000 x 700 window at (300, 200) with a 240 px sidebar floating 6 px in
+// from either edge.
+const gfx::Rect kWindow(300, 200, 1000, 700);
+const gfx::Rect kLeftSidebar(306, 250, 240, 640);
+const gfx::Rect kRightSidebar(1054, 250, 240, 640);
+
+TEST(SidebarOvershootZoneTest, LeftSidebarZoneSpansEdgeToSidebar) {
+  EXPECT_EQ(gfx::Rect(300 - kSidebarOvershootSideways,
+                      200 - kSidebarOvershootVertical,
+                      kSidebarOvershootSideways + 246,
+                      700 + 2 * kSidebarOvershootVertical),
+            SidebarOvershootZone(kWindow, kLeftSidebar, false));
+}
+
+TEST(SidebarOvershootZoneTest, RightSidebarZoneSpansSidebarToEdge) {
+  EXPECT_EQ(gfx::Rect(1054, 200 - kSidebarOvershootVertical,
+                      246 + kSidebarOvershootSideways,
+                      700 + 2 * kSidebarOvershootVertical),
+            SidebarOvershootZone(kWindow, kRightSidebar, true));
+}
+
+TEST(SidebarOvershootZoneTest, EmptySidebarOrWindowHasNoZone) {
+  EXPECT_TRUE(SidebarOvershootZone(kWindow, gfx::Rect(), false).IsEmpty());
+  EXPECT_TRUE(SidebarOvershootZone(gfx::Rect(), kLeftSidebar, false).IsEmpty());
+  EXPECT_FALSE(
+      IsInSidebarOvershoot(kWindow, gfx::Rect(), false, gfx::Point(250, 500)));
+}
+
+TEST(SidebarOvershootZoneTest, InsideTheWindowIsNeverOvershoot) {
+  // Over the sidebar and over the page: Helium's own hover rules apply.
+  EXPECT_FALSE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(400, 500)));
+  EXPECT_FALSE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(900, 500)));
+  EXPECT_FALSE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(300, 200)));
+}
+
+TEST(SidebarOvershootZoneTest, SidewaysUpToTheLimit) {
+  // Just out through the left edge, and the last pixel of the zone.
+  EXPECT_TRUE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(299, 500)));
+  EXPECT_TRUE(IsInSidebarOvershoot(
+      kWindow, kLeftSidebar, false,
+      gfx::Point(300 - kSidebarOvershootSideways, 500)));
+  // One pixel further gives up.
+  EXPECT_FALSE(IsInSidebarOvershoot(
+      kWindow, kLeftSidebar, false,
+      gfx::Point(300 - kSidebarOvershootSideways - 1, 500)));
+}
+
+TEST(SidebarOvershootZoneTest, VerticalUpToTheLimit) {
+  // Above and below the sidebar.
+  EXPECT_TRUE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(400, 199)));
+  EXPECT_TRUE(IsInSidebarOvershoot(
+      kWindow, kLeftSidebar, false,
+      gfx::Point(400, 200 - kSidebarOvershootVertical)));
+  EXPECT_FALSE(IsInSidebarOvershoot(
+      kWindow, kLeftSidebar, false,
+      gfx::Point(400, 200 - kSidebarOvershootVertical - 1)));
+  EXPECT_TRUE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(400, 900)));
+  EXPECT_TRUE(IsInSidebarOvershoot(
+      kWindow, kLeftSidebar, false,
+      gfx::Point(400, 900 + kSidebarOvershootVertical - 1)));
+  EXPECT_FALSE(IsInSidebarOvershoot(
+      kWindow, kLeftSidebar, false,
+      gfx::Point(400, 900 + kSidebarOvershootVertical)));
+}
+
+TEST(SidebarOvershootZoneTest, CornersCountBothWays) {
+  EXPECT_TRUE(IsInSidebarOvershoot(
+      kWindow, kLeftSidebar, false,
+      gfx::Point(300 - kSidebarOvershootSideways,
+                 200 - kSidebarOvershootVertical)));
+}
+
+TEST(SidebarOvershootZoneTest, NotAboveOrBelowThePage) {
+  // Leaving through the top over the page is no overshoot of the sidebar.
+  EXPECT_FALSE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(546, 150)));
+  EXPECT_TRUE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(545, 150)));
+  EXPECT_FALSE(
+      IsInSidebarOvershoot(kWindow, kLeftSidebar, false, gfx::Point(900, 950)));
+}
+
+TEST(SidebarOvershootZoneTest, NotOutTheFarEdge) {
+  // Out the right edge, away from a left sidebar.
+  EXPECT_FALSE(IsInSidebarOvershoot(kWindow, kLeftSidebar, false,
+                                    gfx::Point(1350, 500)));
+}
+
+TEST(SidebarOvershootZoneTest, RightSidebarMirrors) {
+  EXPECT_TRUE(IsInSidebarOvershoot(kWindow, kRightSidebar, true,
+                                   gfx::Point(1300, 500)));
+  EXPECT_TRUE(IsInSidebarOvershoot(
+      kWindow, kRightSidebar, true,
+      gfx::Point(1300 + kSidebarOvershootSideways - 1, 500)));
+  EXPECT_FALSE(IsInSidebarOvershoot(
+      kWindow, kRightSidebar, true,
+      gfx::Point(1300 + kSidebarOvershootSideways, 500)));
+  EXPECT_FALSE(
+      IsInSidebarOvershoot(kWindow, kRightSidebar, true, gfx::Point(250, 500)));
+  EXPECT_TRUE(IsInSidebarOvershoot(kWindow, kRightSidebar, true,
+                                   gfx::Point(1054, 150)));
+  EXPECT_FALSE(IsInSidebarOvershoot(kWindow, kRightSidebar, true,
+                                    gfx::Point(1053, 150)));
+}
+
+TEST(SidebarOvershootZoneTest, SidebarPastTheWindowStaysInside) {
+  // Mid-slide the sidebar can sit partly outside the window. The zone still
+  // ends at the window's edges, not past the page side.
+  const gfx::Rect sliding(100, 250, 240, 640);
+  EXPECT_EQ(gfx::Rect(300 - kSidebarOvershootSideways,
+                      200 - kSidebarOvershootVertical,
+                      kSidebarOvershootSideways + 40,
+                      700 + 2 * kSidebarOvershootVertical),
+            SidebarOvershootZone(kWindow, sliding, false));
+  const gfx::Rect wide(300, 250, 2000, 640);
+  EXPECT_EQ(1300, SidebarOvershootZone(kWindow, wide, false).right());
+}
+
+}  // namespace
+}  // namespace rac

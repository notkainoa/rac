+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_reveal/sidebar_overshoot.h"
+
+#import <AppKit/AppKit.h>
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/rac/sidebar_reveal/sidebar_overshoot_zone.h"
+#include "ui/base/class_property.h"
+#include "ui/display/screen.h"
+#include "ui/events/event.h"
+#include "ui/events/event_observer.h"
+#include "ui/events/event_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/view_tracker.h"
+#include "ui/views/widget/widget.h"
+
+namespace rac {
+class SidebarOvershoot;
+}
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(rac::SidebarOvershoot*)
+
+namespace rac {
+
+// Watches the pointer outside the window while the revealed sidebar shows.
+// When the pointer crosses into or out of the overshoot zone, BrowserView
+// looks at it again, as it does for a move over the window.
+class SidebarOvershoot {
+ public:
+  SidebarOvershoot(BrowserView* browser_view, views::View* sidebar)
+      : browser_view_(browser_view), sidebar_(sidebar) {
+    in_zone_ = IsPointerInZone();
+    base::WeakPtr<SidebarOvershoot> weak = weak_factory_.GetWeakPtr();
+    // Moves over other apps and the desktop.
+    global_monitor_ = [NSEvent
+        addGlobalMonitorForEventsMatchingMask:NSEventMaskMouseMoved
+                                      handler:^(NSEvent* event) {
+                                        if (weak) {
+                                          weak->OnPointerMoved();
+                                        }
+                                      }];
+    // Moves rac gets itself, such as over its other windows.
+    local_monitor_ = [NSEvent
+        addLocalMonitorForEventsMatchingMask:NSEventMaskMouseMoved
+                                     handler:^NSEvent*(NSEvent* event) {
+                                       if (weak) {
+                                         weak->OnPointerMoved();
+                                       }
+                                       return event;
+                                     }];
+  }
+  SidebarOvershoot(const SidebarOvershoot&) = delete;
+  SidebarOvershoot& operator=(const SidebarOvershoot&) = delete;
+
+  ~SidebarOvershoot() {
+    [NSEvent removeMonitor:global_monitor_];
+    [NSEvent removeMonitor:local_monitor_];
+  }
+
+  bool IsPointerInZone() const {
+    const views::Widget* widget = browser_view_->GetWidget();
+    const views::View* sidebar = sidebar_.view();
+    if (!widget || !sidebar || !sidebar->GetVisible()) {
+      return false;
+    }
+    return IsInSidebarOvershoot(
+        widget->GetWindowBoundsInScreen(), sidebar->GetBoundsInScreen(),
+        browser_view_->IsVerticalTabStripRightAligned(),
+        display::Screen::Get()->GetCursorScreenPoint());
+  }
+
+ private:
+  void OnPointerMoved() {
+    const bool in_zone = IsPointerInZone();
+    if (in_zone == in_zone_) {
+      return;
+    }
+    in_zone_ = in_zone;
+    // Later, so a monitor never goes away inside its own handler.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SidebarOvershoot::LookAgain,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  // BrowserView holds the sidebar, or starts its 3 s window-exit grace.
+  void LookAgain() {
+    const ui::MouseEvent move(ui::EventType::kMouseMoved, gfx::Point(),
+                              gfx::Point(), ui::EventTimeForNow(), ui::EF_NONE,
+                              ui::EF_NONE);
+    static_cast<ui::EventObserver*>(browser_view_.get())->OnEvent(move);
+  }
+
+  const raw_ptr<BrowserView> browser_view_;
+  // The sidebar can be replaced when the layout changes.
+  views::ViewTracker sidebar_;
+  bool in_zone_ = false;
+  id __strong global_monitor_ = nil;
+  id __strong local_monitor_ = nil;
+  base::WeakPtrFactory<SidebarOvershoot> weak_factory_{this};
+};
+
+namespace {
+
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(SidebarOvershoot, kSidebarOvershootKey)
+
+}  // namespace
+
+void UpdateSidebarOvershoot(BrowserView* browser_view,
+                            views::View* sidebar,
+                            bool revealed) {
+  if (!revealed || !sidebar) {
+    browser_view->ClearProperty(kSidebarOvershootKey);
+    return;
+  }
+  if (!browser_view->GetProperty(kSidebarOvershootKey)) {
+    browser_view->SetProperty(
+        kSidebarOvershootKey,
+        std::make_unique<SidebarOvershoot>(browser_view, sidebar));
+  }
+}
+
+bool HoldSidebarInOvershoot(BrowserView* browser_view,
+                            base::OneShotTimer& exit_timer) {
+  const SidebarOvershoot* overshoot =
+      browser_view->GetProperty(kSidebarOvershootKey);
+  if (!overshoot || !overshoot->IsPointerInZone()) {
+    return false;
+  }
+  exit_timer.Stop();
+  return true;
+}
+
+}  // namespace rac

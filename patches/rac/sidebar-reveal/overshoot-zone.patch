+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_OVERSHOOT_ZONE_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_OVERSHOOT_ZONE_H_
+
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace rac {
+
+// How far the pointer may overshoot the window beside the revealed sidebar
+// before the sidebar stops waiting for it (Zen's forgiving edge reveal).
+// Sideways is out through the window edge the sidebar sits on; vertical is
+// above and below the window.
+inline constexpr int kSidebarOvershootSideways = 200;
+inline constexpr int kSidebarOvershootVertical = 100;
+
+// The area outside the window where the revealed sidebar keeps showing. It
+// runs from kSidebarOvershootSideways past the window's sidebar edge to the
+// sidebar's inner edge, and from kSidebarOvershootVertical above the window
+// to as far below it. All rects are in one coordinate space, such as screen
+// DIPs. Empty when the sidebar is.
+gfx::Rect SidebarOvershootZone(const gfx::Rect& window,
+                               const gfx::Rect& sidebar,
+                               bool right_aligned);
+
+// Whether `point` is outside `window` and inside its overshoot zone.
+bool IsInSidebarOvershoot(const gfx::Rect& window,
+                          const gfx::Rect& sidebar,
+                          bool right_aligned,
+                          const gfx::Point& point);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_SIDEBAR_OVERSHOOT_ZONE_H_

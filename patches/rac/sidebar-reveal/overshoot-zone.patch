+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_reveal/sidebar_overshoot_zone.h"
+
+#include <algorithm>
+
+namespace rac {
+
+gfx::Rect SidebarOvershootZone(const gfx::Rect& window,
+                               const gfx::Rect& sidebar,
+                               bool right_aligned) {
+  if (window.IsEmpty() || sidebar.IsEmpty()) {
+    return gfx::Rect();
+  }
+  const int top = window.y() - kSidebarOvershootVertical;
+  const int bottom = window.bottom() + kSidebarOvershootVertical;
+  // A sidebar laid out past the window's middle can't widen the zone into
+  // the page: it ends at the sidebar's inner edge or the window's far edge.
+  if (right_aligned) {
+    const int left = std::clamp(sidebar.x(), window.x(), window.right());
+    const int right = window.right() + kSidebarOvershootSideways;
+    return gfx::Rect(left, top, right - left, bottom - top);
+  }
+  const int left = window.x() - kSidebarOvershootSideways;
+  const int right = std::clamp(sidebar.right(), window.x(), window.right());
+  return gfx::Rect(left, top, right - left, bottom - top);
+}
+
+bool IsInSidebarOvershoot(const gfx::Rect& window,
+                          const gfx::Rect& sidebar,
+                          bool right_aligned,
+                          const gfx::Point& point) {
+  return !window.Contains(point) &&
+         SidebarOvershootZone(window, sidebar, right_aligned).Contains(point);
+}
+
+}  // namespace rac

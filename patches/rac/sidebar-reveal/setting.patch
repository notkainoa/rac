@@ -0,0 +1,27 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_SIDEBAR_REVEAL_PREFS_H_
+#define CHROME_BROWSER_UI_RAC_SIDEBAR_REVEAL_PREFS_H_
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace rac {
+
+// Profile pref: when true, Cmd+S collapses the sidebar to a strip of icons
+// (Helium's compact mode) instead of hiding it.
+inline constexpr char kCmdSCollapsesToIcons[] =
+    "rac.browser.cmd_s_collapses_to_icons";
+
+void RegisterSidebarRevealPrefs(user_prefs::PrefRegistrySyncable* registry);
+
+bool CmdSCollapsesToIcons(const PrefService* prefs);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SIDEBAR_REVEAL_PREFS_H_

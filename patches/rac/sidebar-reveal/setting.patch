+++ src/chrome/browser/ui/rac/sidebar_reveal_prefs.cc	2026-10-12 02:56:04.196120328 -0700
@@ -0,0 +1,20 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/sidebar_reveal_prefs.h"
+
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+void RegisterSidebarRevealPrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kCmdSCollapsesToIcons, false);
+}
+
+bool CmdSCollapsesToIcons(const PrefService* prefs) {
+  return prefs->GetBoolean(kCmdSCollapsesToIcons);
+}
+
+}  // namespace rac

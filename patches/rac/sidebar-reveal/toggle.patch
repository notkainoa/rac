+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_VISIBILITY_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_VISIBILITY_H_
+
+class BrowserWindowInterface;
+
+namespace rac {
+
+// True when the sidebar is hidden: Helium's zen mode is on and the sidebar
+// isn't pinned. Edge hover floats it back over the page.
+bool IsSidebarHidden(BrowserWindowInterface* browser);
+
+// What Cmd+S, the View menu item and the sidebar buttons do. By default the
+// sidebar hides or shows. With "Cmd+S collapses to icons" on, it follows
+// Helium: it collapses to icons, or in zen mode pins or unpins.
+void ToggleSidebar(BrowserWindowInterface* browser);
+
+// The string id for the toggle's label: "Hide sidebar" or "Show sidebar", or
+// the collapse labels when Cmd+S collapses to icons.
+int GetToggleSidebarLabelId(BrowserWindowInterface* browser);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_VISIBILITY_H_

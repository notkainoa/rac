+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_visibility.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/rac/sidebar_reveal_prefs.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+bool IsSidebarHidden(BrowserWindowInterface* browser) {
+  const PrefService* prefs = browser->GetProfile()->GetPrefs();
+  return prefs->GetBoolean(prefs::kHeliumZenMode) &&
+         !prefs->GetBoolean(prefs::kHeliumZenModeSidebarPinned);
+}
+
+void ToggleSidebar(BrowserWindowInterface* browser) {
+  auto* controller = tabs::VerticalTabStripStateController::From(browser);
+  if (!controller) {
+    return;
+  }
+
+  PrefService* prefs = browser->GetProfile()->GetPrefs();
+  if (CmdSCollapsesToIcons(prefs)) {
+    BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+    if (browser_view && browser_view->IsZenModeEnabledForLayout()) {
+      browser_view->ToggleZenModeSideChrome();
+    } else {
+      controller->RequestCollapse(!controller->IsCollapsed());
+    }
+    return;
+  }
+
+  // Hiding is zen mode with the sidebar unpinned. Showing leaves zen mode, so
+  // the window goes back to how it looked before. The sidebar is always
+  // expanded when it shows: it may have been collapsed to icons earlier.
+  if (IsSidebarHidden(browser)) {
+    prefs->SetBoolean(prefs::kHeliumZenMode, false);
+    if (controller->IsCollapsed()) {
+      controller->RequestCollapse(false);
+    }
+    return;
+  }
+  prefs->SetBoolean(prefs::kHeliumZenModeSidebarPinned, false);
+  prefs->SetBoolean(prefs::kHeliumZenMode, true);
+}
+
+int GetToggleSidebarLabelId(BrowserWindowInterface* browser) {
+  if (CmdSCollapsesToIcons(browser->GetProfile()->GetPrefs())) {
+    auto* controller = tabs::VerticalTabStripStateController::From(browser);
+    return controller && controller->IsCollapsed() ? IDS_EXPAND_VERTICAL_TABS
+                                                   : IDS_COLLAPSE_VERTICAL_TABS;
+  }
+  return IsSidebarHidden(browser) ? IDS_RAC_SHOW_SIDEBAR
+                                  : IDS_RAC_HIDE_SIDEBAR;
+}
+
+}  // namespace rac

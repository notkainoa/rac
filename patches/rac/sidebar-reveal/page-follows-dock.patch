+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_reveal/page_edge_blend.h"
+
+#include <algorithm>
+
+#include "base/numerics/safe_conversions.h"
+
+namespace rac {
+
+namespace {
+
+// `from` moved `t` of the way to `to`, rounded to the nearest DIP. `t` may
+// pass 0 or 1 when a spring overshoots.
+int BlendEdge(int from, int to, double t) {
+  return base::ClampRound(from + (to - from) * t);
+}
+
+}  // namespace
+
+PageEdgeBlend::PageEdgeBlend() = default;
+PageEdgeBlend::~PageEdgeBlend() = default;
+
+gfx::Rect PageEdgeBlend::Blend(const void* view,
+                               const gfx::Rect& rest,
+                               const gfx::Rect& current,
+                               bool docking,
+                               double value) {
+  if (first_pass_ && !moves_.contains(view) && !current.IsEmpty() &&
+      !rest.IsEmpty()) {
+    const gfx::Rect& docked = docking ? rest : current;
+    const gfx::Rect& hidden = docking ? current : rest;
+    moves_.emplace(view, Move{docked.x() - hidden.x(), docked.y() - hidden.y(),
+                              docked.right() - hidden.right(),
+                              docked.bottom() - hidden.bottom()});
+  }
+  const auto move = moves_.find(view);
+  // A view that only shows on one side, or that came in mid-slide, rests.
+  if (move == moves_.end() || rest.IsEmpty()) {
+    return rest;
+  }
+  // How far the slide still has to go, as a share of the move: negative
+  // while docking, from where the slide ends back toward hidden.
+  const double t = value - (docking ? 1 : 0);
+  const Move& m = move->second;
+  const int x = BlendEdge(rest.x(), rest.x() + m.x, t);
+  const int y = BlendEdge(rest.y(), rest.y() + m.y, t);
+  const int right = BlendEdge(rest.right(), rest.right() + m.right, t);
+  const int bottom = BlendEdge(rest.bottom(), rest.bottom() + m.bottom, t);
+  return gfx::Rect(x, y, std::max(0, right - x), std::max(0, bottom - y));
+}
+
+bool PageFollowsSidebar(bool dock, bool reduced_motion, bool fullscreen) {
+  return dock && !reduced_motion && !fullscreen;
+}
+
+}  // namespace rac

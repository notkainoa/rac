+// While Cmd+S docks or hides the sidebar, where `view` goes instead of
+// `rest`, its bounds where the slide ends. `rest` otherwise. `browser_view`
+// is the BrowserView, as the layout holds it.
+gfx::Rect BlendPageBounds(views::View* browser_view,
+                          const views::View* view,
+                          const gfx::Rect& rest);
+
+// Whether layout passes blend the page now. Fullscreen ends the blend.
+bool IsBlendingPage(views::View* browser_view);
+
+// Ends a layout pass that blended the page, and marks the page as animating
+// its bounds for that frame.
+void EndPageBlendPass(views::View* browser_view);
+
+namespace internal {
+
+template <typename Layout>
+void BlendLayoutChildren(views::View* browser_view,
+                         const views::View* sidebar,
+                         Layout& layout) {
+  for (auto& [view, child] : layout.children) {
+    // The sidebar moves by its layer, from where it rests.
+    if (view.get() == sidebar) {
+      continue;
+    }
+    if (child.visibility.value_or(true)) {
+      child.bounds = BlendPageBounds(browser_view, view.get(), child.bounds);
+    }
+    BlendLayoutChildren(browser_view, sidebar, child);
+  }
+}
+
+}  // namespace internal
+
+// The browser view's layout hook: while Cmd+S docks or hides the sidebar,
+// moves each view of `layout` (BrowserViewLayoutImpl::ProposedLayout) along
+// with the sidebar. `browser_view` is the BrowserView. Does nothing between
+// slides.
+template <typename Layout>
+void BlendLayoutForSidebarDock(views::View* browser_view,
+                               const views::View* sidebar,
+                               Layout& layout) {
+  if (!IsBlendingPage(browser_view)) {
+    return;
+  }
+  internal::BlendLayoutChildren(browser_view, sidebar, layout);
+  EndPageBlendPass(browser_view);
+}
+
 }  // namespace rac
 

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_PAGE_EDGE_BLEND_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_PAGE_EDGE_BLEND_H_
+
+#include "base/containers/flat_map.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace rac {
+
+// Where the browser's views go while Cmd+S docks or hides the sidebar, so
+// the page's edge moves with it (plan 02, S1).
+//
+// The browser's layout knows only where a view rests: beside the docked
+// sidebar, or with the sidebar hidden. Each layout pass during the slide
+// hands every view's rest bounds for the side the slide heads to. The first
+// pass also has where each view was when the slide began, and keeps how far
+// each edge moves between the two sides. Every pass then moves the view back
+// from its rest by that much times how far the slide has to go. So anything
+// else that moves the page in the meantime, such as the chat panel opening on
+// its own clock, still moves it: both add up, frame for frame. A slide that
+// turns around keeps the same distances.
+//
+// `value` is the sidebar's: 0 hidden, 1 docked. Views are only compared by
+// address here, never used.
+class PageEdgeBlend {
+ public:
+  PageEdgeBlend();
+  PageEdgeBlend(const PageEdgeBlend&) = delete;
+  PageEdgeBlend& operator=(const PageEdgeBlend&) = delete;
+  ~PageEdgeBlend();
+
+  // Where `view` goes. `rest` is its bounds in this pass's layout, where the
+  // slide ends: docked when `docking`. `current` is where it is now, which
+  // only a slide's first pass reads.
+  gfx::Rect Blend(const void* view,
+                  const gfx::Rect& rest,
+                  const gfx::Rect& current,
+                  bool docking,
+                  double value);
+
+  // Ends a layout pass. Views first seen after a slide's first pass rest
+  // where the layout puts them.
+  void EndPass() { first_pass_ = false; }
+
+ private:
+  // How far each edge moves from hidden to docked.
+  struct Move {
+    int x = 0;
+    int y = 0;
+    int right = 0;
+    int bottom = 0;
+  };
+
+  base::flat_map<const void*, Move> moves_;
+  bool first_pass_ = true;
+};
+
+// Whether a sidebar slide moves the page with it. Only Cmd+S docking or
+// hiding the sidebar does: edge reveal floats over the page. Under Reduce
+// Motion the page takes its new width at once. In fullscreen the page fills
+// the window (#118, #158) and keeps the layout's bounds, so a window entering
+// fullscreen mid-slide drops the blend.
+bool PageFollowsSidebar(bool dock, bool reduced_motion, bool fullscreen);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_REVEAL_PAGE_EDGE_BLEND_H_

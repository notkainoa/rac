+++ b/chrome/browser/ui/views/rac/sidebar_reveal/page_edge_blend_unittest.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/sidebar_reveal/page_edge_blend.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+// A window 1200 wide: docked, the page card starts after a 240 DIP sidebar;
+// hidden, it spans the window less its margins.
+constexpr gfx::Rect kDockedPage(248, 8, 944, 784);
+constexpr gfx::Rect kHiddenPage(8, 8, 1184, 784);
+
+int kPage;
+int kToolbar;
+
+TEST(PageEdgeBlendTest, DockStartsWhereThePageWas) {
+  PageEdgeBlend blend;
+  // Cmd+S docks: the layout already says docked; the page is still where
+  // the hidden sidebar left it.
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, kHiddenPage, true, 0),
+            kHiddenPage);
+  blend.EndPass();
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, kHiddenPage, true, 0.25).x(), 68);
+  // Halfway, only the leading edge has moved, by half of 240.
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, kHiddenPage, true, 0.5),
+            gfx::Rect(128, 8, 1064, 784));
+  // A spring passing its target carries the edge a little past rest.
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, kHiddenPage, true, 1.01).x(),
+            250);
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, gfx::Rect(), true, 1),
+            kDockedPage);
+}
+
+TEST(PageEdgeBlendTest, HideStartsWhereThePageWas) {
+  PageEdgeBlend blend;
+  EXPECT_EQ(blend.Blend(&kPage, kHiddenPage, kDockedPage, false, 1),
+            kDockedPage);
+  blend.EndPass();
+  EXPECT_EQ(blend.Blend(&kPage, kHiddenPage, kDockedPage, false, 0.5).x(),
+            128);
+  EXPECT_EQ(blend.Blend(&kPage, kHiddenPage, kDockedPage, false, 0),
+            kHiddenPage);
+}
+
+TEST(PageEdgeBlendTest, TurningAroundKeepsBothSides) {
+  PageEdgeBlend blend;
+  // Hiding, then Cmd+S again 40% of the way: the layout flips to docked, and
+  // `current` is wherever the blend had the page, which must not be read.
+  blend.Blend(&kPage, kHiddenPage, kDockedPage, false, 1);
+  blend.EndPass();
+  const gfx::Rect mid = blend.Blend(&kPage, kHiddenPage, kDockedPage, false,
+                                    0.6);
+  EXPECT_EQ(mid.x(), 152);
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, gfx::Rect(1, 2, 3, 4), true, 0.6),
+            mid);
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, mid, true, 1), kDockedPage);
+}
+
+TEST(PageEdgeBlendTest, ViewsOnOneSideOnlyRest) {
+  PageEdgeBlend blend;
+  // The top bar's view was hidden (empty) before the dock.
+  const gfx::Rect bar(248, 8, 944, 40);
+  EXPECT_EQ(blend.Blend(&kToolbar, bar, gfx::Rect(), true, 0), bar);
+  blend.EndPass();
+  // A view first laid out after the first pass has nothing to blend from.
+  const gfx::Rect late(10, 10, 20, 20);
+  EXPECT_EQ(blend.Blend(&kPage, late, gfx::Rect(), true, 0.5), late);
+}
+
+// The chat panel opens on its own clock during a Cmd+S dock: each pass's
+// rest has the page's trailing edge where the panel has it now. The
+// sidebar's share moves the leading edge; the panel's moves the trailing one.
+TEST(PageEdgeBlendTest, ChatPanelMovingAtTheSameTimeAddsUp) {
+  PageEdgeBlend blend;
+  blend.Blend(&kPage, kDockedPage, kHiddenPage, true, 0);
+  blend.EndPass();
+  // The panel has taken 100 DIPs off the page's trailing edge so far.
+  gfx::Rect rest = kDockedPage;
+  rest.set_width(rest.width() - 100);
+  const gfx::Rect mid = blend.Blend(&kPage, rest, kHiddenPage, true, 0.5);
+  EXPECT_EQ(mid.x(), 128);
+  EXPECT_EQ(mid.right(), rest.right());
+  // Docked, the page is exactly where the layout has it.
+  EXPECT_EQ(blend.Blend(&kPage, rest, kHiddenPage, true, 1), rest);
+}
+
+TEST(PageEdgeBlendTest, OnlyCmdSOutsideFullscreenMovesThePage) {
+  EXPECT_TRUE(PageFollowsSidebar(/*dock=*/true, /*reduced_motion=*/false,
+                                 /*fullscreen=*/false));
+  // Edge reveal floats over the page.
+  EXPECT_FALSE(PageFollowsSidebar(false, false, false));
+  // Reduce Motion: the page takes its new width at once.
+  EXPECT_FALSE(PageFollowsSidebar(true, true, false));
+  // Fullscreen fills the window with the page; it never blends there.
+  EXPECT_FALSE(PageFollowsSidebar(true, false, true));
+}
+
+// A slide ends exactly on the layout's bounds, so the window at rest, in
+// fullscreen or not, is laid out as before.
+TEST(PageEdgeBlendTest, RestIsExactlyTheLayout) {
+  PageEdgeBlend blend;
+  const gfx::Rect fullscreen(0, 0, 1512, 982);
+  blend.Blend(&kPage, fullscreen, kDockedPage, false, 1);
+  blend.EndPass();
+  EXPECT_EQ(blend.Blend(&kPage, fullscreen, kDockedPage, false, 0),
+            fullscreen);
+  EXPECT_EQ(blend.Blend(&kPage, kDockedPage, fullscreen, true, 1),
+            kDockedPage);
+}
+
+}  // namespace
+}  // namespace rac

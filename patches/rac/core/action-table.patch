+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/ui/rac/rac_action_handlers.h"
+
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::actions {
+namespace {
+
+int g_calls = 0;
+const base::DictValue* g_last_args = nullptr;
+const ActionContext* g_last_context = nullptr;
+
+void FakeHandler(const ActionContext& context, const base::DictValue& args) {
+  ++g_calls;
+  g_last_context = &context;
+  g_last_args = &args;
+}
+
+// The contract the table relies on: every Dispatch::kBrowser row names a
+// handler in rac_action_handlers.cc. There may be no kBrowser rows yet, but
+// the check iterates the whole table so a new row fails loudly without one.
+TEST(RacActionHandlersTest, EveryBrowserRowHasAHandler) {
+  for (const Action& action : All()) {
+    if (action.dispatch == Dispatch::kBrowser) {
+      EXPECT_TRUE(FindBrowserActionHandler(action.id))
+          << "kBrowser row without a handler: " << action.id;
+    }
+  }
+}
+
+TEST(RacActionHandlersTest, RunBrowserActionRunsTheRowHandler) {
+  g_calls = 0;
+  g_last_args = nullptr;
+  g_last_context = nullptr;
+
+  const Action row = {.id = "test_row", .dispatch = Dispatch::kBrowser};
+  ActionContext context;
+  context.has_tab = true;
+  base::DictValue args;
+  args.Set("one", 1);
+
+  SetBrowserActionHandlerForTesting("test_row", &FakeHandler);
+  EXPECT_TRUE(FindBrowserActionHandler("test_row"));
+  RunBrowserAction(row, context, args);
+  EXPECT_EQ(g_calls, 1);
+  ASSERT_TRUE(g_last_args);
+  EXPECT_EQ(g_last_args->FindInt("one"), std::optional(1));
+  EXPECT_EQ(g_last_context->has_tab, true);
+
+  SetBrowserActionHandlerForTesting("test_row", nullptr);
+  EXPECT_EQ(FindBrowserActionHandler("test_row"), nullptr);
+}
+
+}  // namespace
+}  // namespace rac::actions

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/ui/rac/rac_action_handlers.h"
+
+#include <array>
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "base/uuid.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/actions/rac_action_ids.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace rac::actions {
+namespace {
+
+// Row id -> browser-side handler, for Dispatch::kBrowser rows. Every kBrowser
+// row in the table needs an entry here; the coverage test in
+// rac_action_handlers_unittest.cc fails on one without it. Entries look like
+//
+//     {"open_command_bar", &OpenCommandBar},
+//
+// with the function defined above in this anonymous namespace. A handler that
+// does nothing without a browser checks `context.browser` first.
+constexpr std::array<std::pair<std::string_view, BrowserActionHandler>, 0>
+    kBrowserHandlers{};
+
+// Overrides that tests install with SetBrowserActionHandlerForTesting. Map,
+// not part of kBrowserHandlers, so a test can register a row id that isn't in
+// the table at all.
+std::map<std::string, BrowserActionHandler, std::less<>>& TestHandlers() {
+  static base::NoDestructor<
+      std::map<std::string, BrowserActionHandler, std::less<>>>
+      handlers;
+  return *handlers;
+}
+
+}  // namespace
+
+BrowserActionHandler FindBrowserActionHandler(std::string_view id) {
+  if (auto it = TestHandlers().find(id); it != TestHandlers().end()) {
+    return it->second;
+  }
+  for (const auto& [row_id, handler] : kBrowserHandlers) {
+    if (row_id == id) {
+      return handler;
+    }
+  }
+  return nullptr;
+}
+
+void RunBrowserAction(const Action& action,
+                      const ActionContext& context,
+                      const base::DictValue& args) {
+  CHECK_EQ(action.dispatch, Dispatch::kBrowser) << action.id;
+  BrowserActionHandler handler = FindBrowserActionHandler(action.id);
+  CHECK(handler) << "kBrowser action has no handler: " << action.id;
+  handler(context, args);
+}
+
+ActionContext ContextForWindow(BrowserWindowInterface* browser) {
+  ActionContext context;
+  context.browser = browser;
+  if (!browser) {
+    return context;
+  }
+
+  Profile* profile = browser->GetProfile();
+  context.incognito = profile->IsIncognitoProfile();
+  context.ai_enabled = rac::ai::IsAiEnabled(profile->GetPrefs());
+
+  TabStripModel* tabs = browser->GetTabStripModel();
+  context.has_tab = tabs && tabs->active_index() != TabStripModel::kNoTab;
+  if (context.has_tab) {
+    if (content::WebContents* contents = tabs->GetActiveWebContents()) {
+      context.has_web_page =
+          contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+    }
+  }
+
+  // The manager exists for normal windows of the profile, where spaces do.
+  if (SpacesWindowManager* manager = SpacesWindowManager::From(browser)) {
+    context.has_spaces = true;
+    if (std::optional<SpaceId> space = manager->GetActiveSpaceId(browser)) {
+      context.active_space_id = space->AsLowercaseString();
+    }
+  }
+  return context;
+}
+
+const Action* BrowserActionForCommand(int id) {
+  if (id < IDC_RAC_ACTION_FIRST || id > IDC_RAC_ACTION_LAST) {
+    return nullptr;
+  }
+  const Action* action = FindByCommand(id);
+  return action && action->dispatch == Dispatch::kBrowser ? action : nullptr;
+}
+
+bool IsBrowserCommandEnabled(BrowserWindowInterface* browser, int id) {
+  const Action* action = BrowserActionForCommand(id);
+  return action && IsAvailable(*action, ContextForWindow(browser));
+}
+
+bool ExecuteBrowserCommand(BrowserWindowInterface* browser, int id) {
+  const Action* action = BrowserActionForCommand(id);
+  if (!action) {
+    return false;
+  }
+  const ActionContext context = ContextForWindow(browser);
+  if (!IsAvailable(*action, context)) {
+    return false;
+  }
+  RunBrowserAction(*action, context, base::DictValue());
+  return true;
+}
+
+void SetBrowserActionHandlerForTesting(std::string_view id,
+                                       BrowserActionHandler handler) {
+  if (handler) {
+    TestHandlers()[std::string(id)] = handler;
+  } else {
+    TestHandlers().erase(std::string(id));
+  }
+}
+
+}  // namespace rac::actions

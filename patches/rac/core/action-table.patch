+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_ACTIONS_RAC_ACTION_IDS_H_
+#define CHROME_BROWSER_RAC_ACTIONS_RAC_ACTION_IDS_H_
+
+// Command ids for the table's own rows. Stable forever: users' shortcut
+// rebinds are saved under them (kCustomAccelerators), so never renumber or
+// reuse one. rac_actions_unittest pins them to a committed list. They sit in
+// IDC_RAC_ACTION_FIRST..LAST, which the command controller hands to the table.
+//
+// The range lives here, not in chrome_command_ids.h: nearly every file in
+// Chrome includes that header, so one line there rebuilds the whole tree.
+// 40800..40999 was free in Chromium 156 and in every Helium and rac patch;
+// check it again at each sync.
+#define IDC_RAC_ACTION_FIRST 40800
+#define IDC_RAC_ACTION_LAST 40999
+
+#define IDC_RAC_OPEN_COMMAND_BAR 40800
+#define IDC_RAC_OPEN_COMMAND_BAR_WITH_URL 40801
+#define IDC_RAC_CLEAR_TABS 40802
+#define IDC_RAC_OPEN_LITTLE_WINDOW 40803
+#define IDC_RAC_COPY_AS_MARKDOWN 40804
+
+static_assert(IDC_RAC_OPEN_COMMAND_BAR >= IDC_RAC_ACTION_FIRST &&
+              IDC_RAC_COPY_AS_MARKDOWN <= IDC_RAC_ACTION_LAST);
+
+#endif  // CHROME_BROWSER_RAC_ACTIONS_RAC_ACTION_IDS_H_

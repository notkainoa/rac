+#ifndef CHROME_BROWSER_UI_RAC_RAC_ACTION_HANDLERS_H_
+#define CHROME_BROWSER_UI_RAC_RAC_ACTION_HANDLERS_H_
+
+#include <string_view>
+
+#include "base/values.h"
+#include "chrome/browser/rac/actions/rac_actions.h"
+
+class BrowserWindowInterface;
+
+// The browser-side half of the action table. The table itself
+// (chrome/browser/rac/actions/) is data only: a Dispatch::kBrowser row names
+// a function here, looked up by the row's `id`. New rows add one entry to the
+// map in rac_action_handlers.cc plus the handler function next to it.
+namespace rac::actions {
+
+using BrowserActionHandler = void (*)(const ActionContext&,
+                                      const base::DictValue&);
+
+// The handler `id` names, or null when no row claims it. The unittest checks
+// every kBrowser row against this.
+BrowserActionHandler FindBrowserActionHandler(std::string_view id);
+
+// Runs the row's browser-side handler with `args` (empty for menu and key
+// invocation). CHECKs that `action` is a kBrowser row with a handler: a row
+// without one is a table bug the coverage unittest catches first.
+void RunBrowserAction(const Action& action,
+                      const ActionContext& context,
+                      const base::DictValue& args);
+
+// The window's current state, for IsAvailable() and handlers.
+ActionContext ContextForWindow(BrowserWindowInterface* browser);
+
+// Command routing for BrowserCommandController. The controller defers to
+// these for every id so the table alone decides which ids it owns.
+//
+// The kBrowser row that owns command `id`, or null when `id` is outside the
+// IDC_RAC_ACTION_FIRST..LAST range or its row is dispatched another way
+// (kCommand rows keep running through Chromium's own command path).
+const Action* BrowserActionForCommand(int id);
+
+// Whether `id`'s row is available in `browser`'s window right now.
+bool IsBrowserCommandEnabled(BrowserWindowInterface* browser, int id);
+
+// Runs `id`'s kBrowser handler through RunBrowserAction and returns true.
+// False when `id` isn't a table command or its row isn't available now, so
+// the caller can fall back to the command updater's own answer.
+bool ExecuteBrowserCommand(BrowserWindowInterface* browser, int id);
+
+// Registers `handler` for `id` ahead of the static map, for tests. Passing
+// null removes it again.
+void SetBrowserActionHandlerForTesting(std::string_view id,
+                                       BrowserActionHandler handler);
+
+}  // namespace rac::actions
+
+#endif  // CHROME_BROWSER_UI_RAC_RAC_ACTION_HANDLERS_H_

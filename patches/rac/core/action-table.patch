+#!/usr/bin/env python3
+"""Rebuilds today's MCP `tools/list` reply from tool_registry.cc, byte for byte.
+
+Run against the ORIGINAL tool_registry.cc (before the table change):
+
+    gen_tools_list_golden.py <tool_registry.cc> [--out tools_list_legacy.json]
+    gen_tools_list_golden.py <tool_registry.cc> --rows     # C++ row literals
+
+It parses the C++ (the StringProp/BoolProp/NumberProp/ObjectSchema helpers and
+the ToolDefinition blocks) instead of re-typing the data, so the golden file
+cannot drift from the source by a typo. It then writes JSON the way the C++
+does:
+
+* base::DictValue is a sorted flat_map, so every object has sorted keys.
+* base::JSONWriter prints no spaces, escapes `<` as \\u003C, U+2028/2029 as
+  \\u2028/\\u2029, other control characters (< 0x20) as \\uXXXX (uppercase),
+  and leaves every other character as is.
+* McpToolSpecToDict (mcp_protocol.cc) emits name, description, inputSchema and,
+  for read tools only, annotations {"readOnlyHint": true}.
+* The reply is MakeMcpResult(id 1, {"tools": [...]}), so the line is
+  {"id":1,"jsonrpc":"2.0","result":{"tools":[...]}} with no trailing newline.
+
+Stdlib only.
+"""
+import json
+import re
+import sys
+
+STR = r'"(?:[^"\\]|\\.)*"'
+STRS = rf'(?:\s*{STR})+'
+
+TYPES = {"StringProp": "string", "BoolProp": "boolean", "NumberProp": "number"}
+
+
+def unquote_all(text):
+    """Concatenates adjacent C++ string literals."""
+    out = []
+    for lit in re.findall(STR, text):
+        body = lit[1:-1]
+        body = re.sub(r'\\(.)', lambda m: {'n': '\n', 't': '\t'}.get(m.group(1), m.group(1)), body)
+        out.append(body)
+    return "".join(out)
+
+
+def parse_tools(src):
+    tools = []
+    for block in re.split(r'\n  \{\n    ToolDefinition t;', src)[1:]:
+        block = block.split("tools.push_back")[0]
+        name = unquote_all(re.search(rf't\.name = ({STR});', block).group(1))
+        desc = unquote_all(re.search(rf't\.description =({STRS});', block).group(1))
+        kind = re.search(r't\.kind = ToolKind::k(\w+);', block).group(1)
+        risk = re.search(r't\.default_risk = RiskClass::k(\w+);', block)
+        params = re.search(r't\.parameters =\s*ObjectSchema\((.*)\);\s*$', block, re.S).group(1)
+        # params = <props expr>, {<required>}
+        req_m = re.search(r',\s*\{([^{}]*)\}\s*\)?\s*$', params + ")", re.S)
+        required = re.findall(STR, req_m.group(1))
+        required = [unquote_all(r) for r in required]
+        props_expr = params[:req_m.start()] if req_m else params
+        props = {}
+        for m in re.finditer(
+                rf'\.Set\(\s*({STR}),\s*(StringProp|BoolProp|NumberProp)\(({STRS})\s*\)'
+                rf'(?:\s*\.Set\("enum",\s*base::ListValue\(\)\.Append\(({STR})\)\))?', props_expr):
+            key = unquote_all(m.group(1))
+            prop = {"type": TYPES[m.group(2)], "description": unquote_all(m.group(3))}
+            if m.group(4):
+                prop["enum"] = [unquote_all(m.group(4))]
+            props[key] = prop
+        n_sets = len(re.findall(r'\.Set\(\s*"', props_expr)) - len(re.findall(r'\.Set\("enum"', props_expr))
+        assert n_sets == len(props), (name, n_sets, len(props))
+        tools.append({
+            "name": name, "description": desc, "kind": kind,
+            "risk": risk.group(1) if risk else "None",
+            "schema": {"type": "object", "properties": props, "required": required,
+                       "additionalProperties": False},
+        })
+    return tools
+
+
+def esc(s):
+    out = ['"']
+    for ch in s:
+        o = ord(ch)
+        if ch == '\b': out.append('\\b')
+        elif ch == '\f': out.append('\\f')
+        elif ch == '\n': out.append('\\n')
+        elif ch == '\r': out.append('\\r')
+        elif ch == '\t': out.append('\\t')
+        elif ch == '\\': out.append('\\\\')
+        elif ch == '"': out.append('\\"')
+        elif ch == '<': out.append('\\u003C')
+        elif o in (0x2028, 0x2029): out.append('\\u%04X' % o)
+        elif o < 32: out.append('\\u%04X' % o)
+        else: out.append(ch)
+    out.append('"')
+    return "".join(out)
+
+
+def dump(v):
+    """base::JSONWriter's output for a DictValue/ListValue tree."""
+    if isinstance(v, dict):
+        return "{" + ",".join(esc(k) + ":" + dump(v[k]) for k in sorted(v)) + "}"
+    if isinstance(v, list):
+        return "[" + ",".join(dump(x) for x in v) + "]"
+    if v is True: return "true"
+    if v is False: return "false"
+    if isinstance(v, int): return str(v)
+    if isinstance(v, str): return esc(v)
+    raise TypeError(v)
+
+
+def tools_list_line(tools):
+    entries = []
+    for t in tools:
+        e = {"name": t["name"], "description": t["description"], "inputSchema": t["schema"]}
+        if t["kind"] == "Read":
+            e["annotations"] = {"readOnlyHint": True}
+        entries.append(e)
+    return dump({"id": 1, "jsonrpc": "2.0", "result": {"tools": entries}})
+
+
+# What each legacy tool really is: (read_only, destructive, idempotent, open_world).
+# See docs/internals/action-table.md. Not on the wire for the 15 (kReadOnlyOnly).
+HINTS = {
+    "snapshot": "TFTF", "get_page_text": "TFTF", "list_tabs": "TFTF", "find_in_page": "TFTF",
+    "click": "FTFT", "type": "FTFT", "press_key": "FTFT", "select_option": "FTTT",
+    "scroll": "FFFF", "wait_for_settle": "FFTF", "navigate": "FFTT",
+    "go_back": "FFFT", "open_tab": "FFFT", "switch_tab": "FFTF", "close_tab": "FTTF",
+}
+
+
+def cxx_literal(s, indent):
+    """A C++ raw-string-free literal, split in <= ~72-column pieces."""
+    pieces, cur = [], ""
+    for word in re.findall(r'\S+\s*', s):
+        if len(cur) + len(word) > 64 and cur:
+            pieces.append(cur); cur = ""
+        cur += word
+    if cur: pieces.append(cur)
+    q = lambda p: '"' + p.replace('\\', '\\\\').replace('"', '\\"') + '"'
+    return ("\n" + " " * indent).join(q(p) for p in pieces)
+
+
+def rows(tools):
+    out = []
+    for t in tools:
+        h = HINTS[t["name"]]
+        assert (h[0] == "T") == (t["kind"] == "Read"), t["name"]
+        schema = dump(t["schema"])
+        out.append(f'''    {{
+        .id = "{t["name"]}",
+        .description =
+            {cxx_literal(t["description"], 12)},
+        .args_json =
+            R"json({schema})json",
+        .surfaces = {{Surface::kBuiltInAgent, Surface::kOutsideAgent}},
+        .risk = RiskClass::k{t["risk"]},
+        .outside = OutsideClass::k{"Read" if t["kind"] == "Read" else "FreeInOwnTabs"},
+        .hints = McpHints{{.read_only = {h[0] == "T"}, .destructive = {h[1] == "T"},
+                          .idempotent = {h[2] == "T"}, .open_world = {h[3] == "T"}}},
+        .wire = WireHints::kReadOnlyOnly,
+        .dispatch = Dispatch::kAgentController,
+    }},'''.replace("True", "true").replace("False", "false"))
+    return "\n".join(out)
+
+
+def main():
+    path = sys.argv[1]
+    tools = parse_tools(open(path).read())
+    assert len(tools) == 15, len(tools)
+    if "--rows" in sys.argv:
+        print(rows(tools))
+        return
+    out = sys.argv[sys.argv.index("--out") + 1] if "--out" in sys.argv else None
+    line = tools_list_line(tools)
+    if out:
+        with open(out, "w", newline="") as f:
+            f.write(line)
+    else:
+        print(line)
+
+
+if __name__ == "__main__":
+    main()

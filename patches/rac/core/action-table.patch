+#!/usr/bin/env python3
+"""Second, independent check: reads rac_actions_agent.cc as text, rebuilds the
+tools/list reply from the string literals in the rows (concatenating adjacent
+literals the way the C++ compiler does), and compares it to the golden file.
+Also checks the row order and the kReadOnlyOnly rule. Stdlib only.
+
+    check_rows_against_golden.py rac_actions_agent.cc tools_list_legacy.json
+"""
+import json, re, sys
+src, golden = open(sys.argv[1]).read(), open(sys.argv[2]).read()
+sys.path.insert(0, __file__.rsplit("/", 1)[0])
+import importlib.util
+spec = importlib.util.spec_from_file_location("g", __file__.rsplit("/", 1)[0] + "/gen_tools_list_golden.py")
+g = importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
+
+STR = g.STR
+tools = []
+for row in re.split(r'\n    \{\n        \.id = ', src)[1:]:
+    name = g.unquote_all(re.match(STR, row).group(0))
+    desc = g.unquote_all(re.search(rf'\.description =({g.STRS}),\n', row).group(1))
+    schema = json.loads(re.search(r'R"json\((.*)\)json"', row).group(1))
+    read_only = re.search(r'\.read_only = (true|false)', row).group(1) == "true"
+    assert "WireHints::kReadOnlyOnly" in row and "Dispatch::kAgentController" in row, name
+    e = {"name": name, "description": desc, "inputSchema": schema}
+    if read_only:
+        e["annotations"] = {"readOnlyHint": True}
+    tools.append(e)
+line = g.dump({"id": 1, "jsonrpc": "2.0", "result": {"tools": tools}})
+print(len(tools), "rows;", "MATCH" if line == golden else "MISMATCH")
+sys.exit(0 if line == golden else 1)

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#import "chrome/browser/ui/rac/rac_action_menu_items.h"
+
+#import <Cocoa/Cocoa.h>
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/rac/actions/rac_actions.h"
+#include "ui/base/l10n/l10n_util.h"
+#import "ui/base/l10n/l10n_util_mac.h"
+
+namespace rac::actions {
+namespace {
+
+// The menu a kMenu row lands in. The Spaces menu has no tag; find it by an
+// item it always contains.
+NSMenu* MenuForActionMenu(NSMenu* main_menu, Menu menu) {
+  int tag;
+  switch (menu) {
+    case Menu::kFile:
+      tag = IDC_FILE_MENU;
+      break;
+    case Menu::kEdit:
+      tag = IDC_EDIT_MENU;
+      break;
+    case Menu::kView:
+      tag = IDC_VIEW_MENU;
+      break;
+    case Menu::kTab:
+      tag = IDC_TAB_MENU;
+      break;
+    case Menu::kWindow:
+      tag = IDC_WINDOW_MENU;
+      break;
+    case Menu::kSpaces:
+      for (NSMenuItem* item in main_menu.itemArray) {
+        if ([item.submenu itemWithTag:IDC_RAC_NEW_SPACE]) {
+          return item.submenu;
+        }
+      }
+      return nil;
+    case Menu::kNone:
+      return nil;
+  }
+  return [main_menu itemWithTag:tag].submenu;
+}
+
+}  // namespace
+
+void InsertActionMenuItems(NSMenu* main_menu) {
+  for (const Action& action : All()) {
+    if (!action.surfaces.Has(Surface::kMenu) || !action.command_id) {
+      continue;
+    }
+    // TODO(core-table): the menu is built before any profile loads, so a
+    // row gated by a pref can't be placed yet. Place or hide these rows
+    // once the last-used profile loads.
+    if (!action.shortcut_pref.empty()) {
+      continue;
+    }
+    const int label_id =
+        action.menu_label_id ? action.menu_label_id : action.label_id;
+    NSMenu* menu = MenuForActionMenu(main_menu, action.menu);
+    if (!label_id || !menu) {
+      continue;
+    }
+    NSMenuItem* item = [[NSMenuItem alloc]
+        initWithTitle:l10n_util::GetNSStringWithFixup(label_id)
+               action:@selector(commandDispatch:)
+        keyEquivalent:@""];
+    item.tag = action.command_id;
+    const NSInteger after = action.menu_after
+                                ? [menu indexOfItemWithTag:action.menu_after]
+                                : NSNotFound;
+    [menu insertItem:item
+             atIndex:(after != NSNotFound) ? after + 1 : menu.numberOfItems];
+  }
+}
+
+}  // namespace rac::actions

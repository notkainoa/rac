+// Ids that exist today. Ids are never removed or reused, so this list only
+// grows. Adding a row means adding its id here too.
+constexpr std::string_view kCommittedIds[] = {
+    "snapshot",   "get_page_text", "list_tabs",       "find_in_page",
+    "click",      "type",          "select_option",   "press_key",
+    "scroll",     "navigate",      "go_back",         "open_tab",
+    "switch_tab", "close_tab",     "wait_for_settle",
+};
+
+// Plan 05's "Never" class. None of these may have an outside surface.
+constexpr std::string_view kNeverForOutsideClients[] = {
+    "change_setting",    "set_site_rule", "set_agent_level",
+    "install_extension", "clear_history", "clear_browsing_data",
+    "delete_space",
+};
+
+constexpr Surface kUiSurfaces[] = {Surface::kSidebar, Surface::kCommandBar,
+                                   Surface::kMenu, Surface::kShortcut};
+
+constexpr Action MadeUp(std::string_view id,
+                        Surfaces surfaces,
+                        bool ai_only = false,
+                        ShortcutSpec shortcut = {}) {
+  return {.id = id,
+          .default_shortcut = shortcut,
+          .surfaces = surfaces,
+          .ai_only = ai_only};
+}
+
+TEST(RacActionsTest, EveryRowIsClassified) {
+  for (const Action& action : All()) {
+    SCOPED_TRACE(std::string(action.id));
+    EXPECT_FALSE(action.id.empty());
+    EXPECT_TRUE(action.risk.has_value());
+    EXPECT_TRUE(action.outside.has_value());
+    ASSERT_TRUE(action.hints.has_value());
+    // A read-only action can't be destructive.
+    EXPECT_FALSE(action.hints->read_only && action.hints->destructive);
+    const bool agent_row = action.surfaces.Has(Surface::kBuiltInAgent) ||
+                           action.surfaces.Has(Surface::kOutsideAgent);
+    if (agent_row) {
+      EXPECT_FALSE(action.description.empty());
+      EXPECT_EQ(*ArgsSchema(action).FindString("type"), "object");
+    }
+    // Chromium runs a kCommand row's id, so it must have one. Handler
+    // coverage for kBrowser rows is tested next to the handlers, in the
+    // //chrome/browser/ui target.
+    if (action.dispatch == Dispatch::kCommand) {
+      EXPECT_NE(action.command_id, 0) << "a command row needs its IDC_ id";
+    }
+    // An outside client sees a row exactly when it was classified for them.
+    EXPECT_EQ(action.surfaces.Has(Surface::kOutsideAgent),
+              action.outside != OutsideClass::kNotOffered);
+  }
+}
+
+TEST(RacActionsTest, IdsAreUniqueAndNeverRemoved) {
+  std::set<std::string_view> seen;
+  for (const Action& action : All()) {
+    EXPECT_TRUE(seen.insert(action.id).second) << "duplicate id " << action.id;
+  }
+  for (std::string_view id : kCommittedIds) {
+    EXPECT_TRUE(Find(id)) << "id was removed: " << id;
+  }
+  EXPECT_EQ(Find("no_such_action"), nullptr);
+}
+
+// The wire bytes of tools/list for the 15 current tools must never change. The
+// golden file is made by testdata/gen_tools_list_golden.py from the original
+// tool_registry.cc. This test assembles the reply the way McpToolSpecToDict
+// does; tools_list_golden_unittest.cc in the agent directory runs the same
+// file through the real MCP handler.
+TEST(RacActionsTest, ToolsListMatchesGoldenBytes) {
+  base::ListValue tools;
+  for (const Action& action : All()) {
+    if (action.dispatch != Dispatch::kAgentController) {
+      continue;
+    }
+    base::DictValue tool;
+    tool.Set("name", std::string(action.id));
+    tool.Set("description", std::string(action.description));
+    tool.Set("inputSchema", ArgsSchema(action));
+    base::DictValue annotations = WireAnnotations(action);
+    if (!annotations.empty()) {
+      tool.Set("annotations", std::move(annotations));
+    }
+    tools.Append(std::move(tool));
+  }
+  base::DictValue reply;
+  reply.Set("jsonrpc", "2.0");
+  reply.Set("id", 1);
+  reply.Set("result", base::DictValue().Set("tools", std::move(tools)));
+  std::string actual;
+  ASSERT_TRUE(base::JSONWriter::Write(reply, &actual));
+
+  base::FilePath golden_path;
+  ASSERT_TRUE(
+      base::PathService::Get(base::DIR_SRC_TEST_DATA_ROOT, &golden_path));
+  golden_path = golden_path.AppendASCII(
+      "chrome/browser/rac/actions/testdata/tools_list_legacy.json");
+  std::string golden;
+  ASSERT_TRUE(base::ReadFileToString(golden_path, &golden)) << golden_path;
+  EXPECT_EQ(actual, golden);
+}
+
+TEST(RacActionsTest, WireAnnotationsFollowTheWireMode) {
+  const Action read = {.id = "r",
+                       .hints = McpHints{.read_only = true,
+                                         .destructive = false,
+                                         .idempotent = true,
+                                         .open_world = false},
+                       .wire = WireHints::kReadOnlyOnly};
+  const Action act = {.id = "a",
+                      .hints = McpHints{.read_only = false,
+                                        .destructive = true,
+                                        .idempotent = false,
+                                        .open_world = true},
+                      .wire = WireHints::kReadOnlyOnly};
+  const Action full = {.id = "f",
+                       .hints = McpHints{.read_only = false,
+                                         .destructive = true,
+                                         .idempotent = true,
+                                         .open_world = false},
+                       .wire = WireHints::kFull};
+
+  std::string json;
+  ASSERT_TRUE(base::JSONWriter::Write(WireAnnotations(read), &json));
+  EXPECT_EQ(json, R"({"readOnlyHint":true})");
+  EXPECT_TRUE(WireAnnotations(act).empty());
+  ASSERT_TRUE(base::JSONWriter::Write(WireAnnotations(full), &json));
+  EXPECT_EQ(json, R"({"destructiveHint":true,"idempotentHint":true,)"
+                  R"("openWorldHint":false,"readOnlyHint":false})");
+}
+
+TEST(RacActionsTest, AiOnlyRowsNeverShowWithAiOff) {
+  const Action rows[] = {
+      MadeUp("plain", {Surface::kCommandBar, Surface::kOutsideAgent}),
+      MadeUp(
+          "ask",
+          {Surface::kCommandBar, Surface::kSidebar, Surface::kMenu,
+           Surface::kShortcut, Surface::kBuiltInAgent, Surface::kOutsideAgent},
+          /*ai_only=*/true),
+  };
+  ActionContext ai_off;
+  ai_off.ai_enabled = false;
+  for (Surface surface :
+       {Surface::kSidebar, Surface::kCommandBar, Surface::kMenu,
+        Surface::kShortcut, Surface::kBuiltInAgent, Surface::kOutsideAgent}) {
+    for (const Action* action : ForSurface(rows, surface, ai_off)) {
+      EXPECT_NE(action->id, "ask");
+    }
+  }
+  ActionContext ai_on;
+  ai_on.ai_enabled = true;
+  EXPECT_EQ(ForSurface(rows, Surface::kCommandBar, ai_on).size(), 2u);
+  EXPECT_EQ(ForSurface(rows, Surface::kCommandBar, ai_off).size(), 1u);
+
+  // The real table too: whatever rows exist, none survives with AI off.
+  for (Surface surface : kUiSurfaces) {
+    for (const Action* action : ForSurface(surface, ai_off)) {
+      EXPECT_FALSE(action->ai_only) << action->id;
+    }
+  }
+}
+
+TEST(RacActionsTest, AvailabilityFiltersUiSurfacesOnly) {
+  Action needs_tab =
+      MadeUp("needs_tab", {Surface::kCommandBar, Surface::kBuiltInAgent});
+  needs_tab.availability = {Need::kTab, Need::kNotIncognito};
+  const Action rows[] = {needs_tab};
+  ActionContext context;
+  EXPECT_TRUE(ForSurface(rows, Surface::kCommandBar, context).empty());
+  EXPECT_EQ(ForSurface(rows, Surface::kBuiltInAgent, context).size(), 1u);
+  context.has_tab = true;
+  EXPECT_EQ(ForSurface(rows, Surface::kCommandBar, context).size(), 1u);
+  context.incognito = true;
+  EXPECT_TRUE(ForSurface(rows, Surface::kCommandBar, context).empty());
+}
+
+TEST(RacActionsTest, NeverActionsHaveNoOutsideSurface) {
+  for (std::string_view id : kNeverForOutsideClients) {
+    const Action* action = Find(id);
+    EXPECT_TRUE(!action || !action->surfaces.Has(Surface::kOutsideAgent)) << id;
+  }
+}
+
+TEST(RacActionsTest, ShortcutsDoNotCollide) {
+  EXPECT_EQ(FirstShortcutCollision(All()), std::nullopt);
+
+  const ShortcutSpec cmd_k = {ui::VKEY_K, ui::EF_COMMAND_DOWN};
+  const Action colliding[] = {
+      MadeUp("a", {Surface::kShortcut}, false, cmd_k),
+      MadeUp("b", {Surface::kShortcut}, false, cmd_k),
+  };
+  EXPECT_EQ(FirstShortcutCollision(colliding), "b");
+
+  const Action no_shortcut_surface[] = {
+      MadeUp("a", {Surface::kShortcut}, false, cmd_k),
+      MadeUp("b", {Surface::kCommandBar}, false, cmd_k),
+      MadeUp("c", {Surface::kShortcut}, false,
+             {ui::VKEY_K, ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN}),
+  };
+  EXPECT_EQ(FirstShortcutCollision(no_shortcut_surface), std::nullopt);
+  // Collisions with Chromium's and Helium's own shortcut tables are checked
+  // when the first shortcut row lands (needs the accelerator list).
+}

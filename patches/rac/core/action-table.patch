+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_ACTIONS_RAC_ACTIONS_H_
+#define CHROME_BROWSER_RAC_ACTIONS_RAC_ACTIONS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/enum_set.h"
+#include "base/containers/span.h"
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+class BrowserWindowInterface;
+namespace gfx {
+struct VectorIcon;
+}
+
+// rac's single action table: one static list of everything rac can do. See
+// docs/internals/action-table.md for the rules about who may edit which field.
+// Compiled-in data with no service and no startup cost: the table is built on
+// first use.
+namespace rac::actions {
+
+enum class Surface {
+  kSidebar,
+  kCommandBar,
+  kCommandBarSuggested,  // Shown in the command bar's empty state.
+  kMenu,
+  kShortcut,
+  kBuiltInAgent,
+  kOutsideAgent,
+  kMaxValue = kOutsideAgent,
+};
+using Surfaces = base::EnumSet<Surface, Surface::kSidebar, Surface::kMaxValue>;
+
+// What an action needs before it can run (plan 07's "availability").
+enum class Need {
+  kTab,
+  kWebPage,  // The active tab shows an http(s) page.
+  kNotIncognito,
+  kSpaces,  // A normal profile window, where spaces exist.
+  kMaxValue = kSpaces,
+};
+using Availability = base::EnumSet<Need, Need::kTab, Need::kMaxValue>;
+
+// The same three values the guard has always used (tool_registry.h aliases
+// this as rac::agent::RiskClass).
+enum class RiskClass {
+  kNone,           // Read tools.
+  kLow,            // Click/type/scroll inside allowed origins.
+  kConsequential,  // Submit/buy/delete/password/cross-origin/etc.
+};
+
+// How an outside client is treated (plan 05's non-page table). The guard
+// applies each client's own level on top of this later.
+enum class OutsideClass {
+  kNotOffered,  // Never reaches an outside client's tools/list.
+  kRead,
+  kFreeInOwnTabs,
+  kAlwaysAsks,
+};
+
+// The four MCP annotation hints, always stored in full.
+struct McpHints {
+  bool read_only;
+  bool destructive;
+  bool idempotent;
+  bool open_world;
+};
+
+// What tools/list sends. kReadOnlyOnly is today's wire format: only
+// {"readOnlyHint":true}, and only on read tools. kFull sends all four.
+enum class WireHints { kReadOnlyOnly, kFull };
+
+// Which Mac menu a kMenu row lands in. The menu builder places rows after
+// `menu_after` (an IDC_ command id in that menu), or at the menu's end.
+enum class Menu { kNone, kFile, kEdit, kView, kSpaces, kTab, kWindow };
+
+// Who runs a row. The table is data only: it holds no function pointers, so
+// it depends on nothing from the browser.
+enum class Dispatch {
+  // A browser-side handler, looked up by `id` in
+  // chrome/browser/ui/rac/rac_action_handlers.cc (the //chrome/browser/ui
+  // target). A test there fails if a kBrowser row has no handler.
+  kBrowser,
+  // Chromium runs `command_id` itself (IDC_NEW_WINDOW, IDC_COPY_URL). The row
+  // only adds surfaces, a label, and keywords. The table's dispatch hook
+  // never routes these ids, so a handler can't call itself in a loop.
+  kCommand,
+  kAgentController,  // AgentController::HandleToolCall does the work.
+};
+
+// What a surface passes to the table. Plain values, so the table stays cheap
+// to build and easy to test.
+struct ActionContext {
+  raw_ptr<BrowserWindowInterface> browser = nullptr;
+  // The window's active space, as SpacesService names it. Empty when the
+  // window has none (incognito, a PWA window).
+  std::string active_space_id;
+  bool ai_enabled = false;
+  bool has_tab = false;
+  bool has_web_page = false;
+  bool incognito = false;
+  bool has_spaces = false;  // A normal profile window.
+};
+
+// Maps 1:1 onto AcceleratorMapping.
+struct ShortcutSpec {
+  ui::KeyboardCode key = ui::VKEY_UNKNOWN;
+  int modifiers = 0;  // ui::EF_*_DOWN flags.
+  // The IDC_ id whose default this shortcut takes over, or 0. The collision
+  // test allows a clash only with this command.
+  int replaces_command_id = 0;
+
+  constexpr bool empty() const { return key == ui::VKEY_UNKNOWN; }
+  // Same keys pressed; ignores `replaces_command_id`.
+  constexpr bool SameKeys(const ShortcutSpec& other) const {
+    return key == other.key && modifiers == other.modifiers;
+  }
+};
+
+// Fields are listed in the order a row sets them (C++ designated initializers
+// must follow it). A field with no value yet means "off" or "unclassified".
+struct Action {
+  // Stable forever, never reused. Also the MCP tool name.
+  std::string_view id;
+  // The IDC_ id menus, accelerators, and the shortcut page use. Stable
+  // forever: users' rebinds are saved under it (kCustomAccelerators). Either
+  // an existing Chromium/rac id (IDC_COPY_URL, IDC_RAC_SHOW_SPACE_0) or one
+  // from rac_action_ids.h inside IDC_RAC_ACTION_FIRST..LAST, which the
+  // command controller dispatches to the table. 0 = no command.
+  int command_id = 0;
+  // For a row that is a numbered set (Show Space 1-9): the last id. The label
+  // takes the ordinal (command_id - first + 1) as $1. 0 = a single command.
+  int command_id_last = 0;
+  int label_id = 0;     // IDS_ string for the command bar and sidebar.
+  int keywords_id = 0;  // UI. IDS_ string of search aliases. 0 = none.
+  const gfx::VectorIcon* icon = nullptr;  // UI. nullptr = none.
+  // UI. The argument that receives the command bar's typed text ("prompt"
+  // for `ask`). "" = none.
+  std::string_view query_arg;
+  int menu_label_id = 0;  // Plan 07. 0 = same as label_id.
+  // English text for tools/list. Not localized.
+  std::string_view description;
+  // JSON Schema for the arguments, written out in full (including the empty
+  // object schema for an action with no arguments).
+  std::string_view args_json;
+  ShortcutSpec default_shortcut;  // Plan 07.
+  // UI. A boolean pref that turns the shortcut and menu item on (D13's
+  // "Cmd+T opens the command bar"). While it is false the row has no default
+  // shortcut and no menu item, and a replaced command keeps its key. Power's
+  // shortcut hook and Core's menu hook both read it. "" = always on.
+  std::string_view shortcut_pref;
+  Availability availability;  // Plan 07.
+  Surfaces surfaces;
+  Menu menu = Menu::kNone;  // UI. Only read for rows with kMenu.
+  int menu_after = 0;       // UI. An IDC_ id in `menu`; 0 = the menu's end.
+  bool ai_only = false;     // Cannot work without the assistant.
+  // Unset until someone classifies the row. A test fails on an unset row.
+  std::optional<RiskClass> risk;
+  std::optional<OutsideClass> outside;
+  std::optional<McpHints> hints;
+  WireHints wire = WireHints::kFull;
+  Dispatch dispatch = Dispatch::kBrowser;
+};
+
+// Whether a surface may show and run `action` now: false for an ai_only row
+// with AI off, or when the context lacks something the row needs. For the
+// sidebar and menus, which show or disable a single row.
+bool IsAvailable(const Action& action, const ActionContext& context);
+
+// Every row, in a stable order: the order of the group list in rac_actions.cc,
+// then the order inside each group's file.
+base::span<const Action> All();
+const Action* Find(std::string_view id);
+// The row whose command id range holds `command_id`, or null.
+const Action* FindByCommand(int command_id);
+
+// The only way UI code walks the table. Drops ai_only rows when AI is off and
+// rows whose availability the context doesn't meet, so no caller checks the AI
+// switch itself. Availability applies to the UI surfaces only: an agent that
+// asks for something with no tab to act on gets an error from the handler.
+std::vector<const Action*> ForSurface(Surface surface,
+                                      const ActionContext& context);
+// Same filter over any list of rows (tests use it with made-up rows).
+std::vector<const Action*> ForSurface(base::span<const Action> rows,
+                                      Surface surface,
+                                      const ActionContext& context);
+
+// The id of the first row whose default shortcut another row also uses, or
+// nullopt. Rows that don't have the kShortcut surface are ignored.
+std::optional<std::string_view> FirstShortcutCollision(
+    base::span<const Action> rows);
+
+// The row's argument schema, parsed from `args_json`. CHECKs on bad JSON; a
+// unit test parses every row.
+base::DictValue ArgsSchema(const Action& action);
+
+// The `annotations` object tools/list sends for this row. Empty when the row
+// sends none (today: every action tool).
+base::DictValue WireAnnotations(const Action& action);
+
+}  // namespace rac::actions
+
+#endif  // CHROME_BROWSER_RAC_ACTIONS_RAC_ACTIONS_H_

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/actions/rac_actions.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/rac/actions/rac_actions_groups.h"
+
+namespace rac::actions {
+namespace {
+
+// The one central list of groups. Row order in All() follows it.
+using GroupFn = base::span<const Action> (*)();
+constexpr GroupFn kGroups[] = {
+    &AgentActions,
+};
+
+bool IsUiSurface(Surface surface) {
+  return surface != Surface::kBuiltInAgent && surface != Surface::kOutsideAgent;
+}
+
+bool MeetsNeeds(const Action& action, const ActionContext& context) {
+  const Availability& need = action.availability;
+  return (!need.Has(Need::kTab) || context.has_tab) &&
+         (!need.Has(Need::kWebPage) || context.has_web_page) &&
+         (!need.Has(Need::kNotIncognito) || !context.incognito) &&
+         (!need.Has(Need::kSpaces) || context.has_spaces);
+}
+
+}  // namespace
+
+bool IsAvailable(const Action& action, const ActionContext& context) {
+  return (!action.ai_only || context.ai_enabled) && MeetsNeeds(action, context);
+}
+
+base::span<const Action> All() {
+  static const base::NoDestructor<std::vector<Action>> kAll([] {
+    std::vector<Action> all;
+    for (GroupFn group : kGroups) {
+      base::span<const Action> rows = group();
+      all.insert(all.end(), rows.begin(), rows.end());
+    }
+    return all;
+  }());
+  return *kAll;
+}
+
+const Action* Find(std::string_view id) {
+  for (const Action& action : All()) {
+    if (action.id == id) {
+      return &action;
+    }
+  }
+  return nullptr;
+}
+
+const Action* FindByCommand(int command_id) {
+  if (command_id == 0) {
+    return nullptr;
+  }
+  for (const Action& action : All()) {
+    const int last =
+        action.command_id_last ? action.command_id_last : action.command_id;
+    if (action.command_id && command_id >= action.command_id &&
+        command_id <= last) {
+      return &action;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<const Action*> ForSurface(Surface surface,
+                                      const ActionContext& context) {
+  return ForSurface(All(), surface, context);
+}
+
+std::vector<const Action*> ForSurface(base::span<const Action> rows,
+                                      Surface surface,
+                                      const ActionContext& context) {
+  std::vector<const Action*> result;
+  for (const Action& action : rows) {
+    if (!action.surfaces.Has(surface)) {
+      continue;
+    }
+    if (action.ai_only && !context.ai_enabled) {
+      continue;
+    }
+    if (IsUiSurface(surface) && !MeetsNeeds(action, context)) {
+      continue;
+    }
+    result.push_back(&action);
+  }
+  return result;
+}
+
+std::optional<std::string_view> FirstShortcutCollision(
+    base::span<const Action> rows) {
+  for (size_t i = 0; i < rows.size(); ++i) {
+    if (rows[i].default_shortcut.empty() ||
+        !rows[i].surfaces.Has(Surface::kShortcut)) {
+      continue;
+    }
+    for (size_t j = i + 1; j < rows.size(); ++j) {
+      if (rows[j].surfaces.Has(Surface::kShortcut) &&
+          rows[j].default_shortcut.SameKeys(rows[i].default_shortcut)) {
+        return rows[j].id;
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+base::DictValue ArgsSchema(const Action& action) {
+  std::optional<base::DictValue> schema =
+      base::JSONReader::ReadDict(action.args_json, base::JSON_PARSE_RFC);
+  CHECK(schema.has_value()) << "bad args_json for " << action.id;
+  return std::move(*schema);
+}
+
+base::DictValue WireAnnotations(const Action& action) {
+  CHECK(action.hints.has_value()) << "unclassified action " << action.id;
+  const McpHints& hints = *action.hints;
+  base::DictValue annotations;
+  if (action.wire == WireHints::kReadOnlyOnly) {
+    if (hints.read_only) {
+      annotations.Set("readOnlyHint", true);
+    }
+    return annotations;
+  }
+  annotations.Set("readOnlyHint", hints.read_only);
+  annotations.Set("destructiveHint", hints.destructive);
+  annotations.Set("idempotentHint", hints.idempotent);
+  annotations.Set("openWorldHint", hints.open_world);
+  return annotations;
+}
+
+}  // namespace rac::actions

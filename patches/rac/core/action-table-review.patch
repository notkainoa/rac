+TEST(RacActionsTest, CommandIdsRespectTheDispatchRange) {
+  // A kBrowser row reaches its handler only through the table's dispatch
+  // range, so its ids must sit inside it. A kCommand row keeps Chromium's
+  // own dispatch, so its ids must stay outside.
+  std::vector<std::pair<int, int>> ranges;
+  for (const Action& action : All()) {
+    SCOPED_TRACE(std::string(action.id));
+    if (!action.command_id) {
+      continue;
+    }
+    const int last =
+        action.command_id_last ? action.command_id_last : action.command_id;
+    switch (action.dispatch) {
+      case Dispatch::kBrowser:
+        EXPECT_GE(action.command_id, IDC_RAC_ACTION_FIRST);
+        EXPECT_LE(last, IDC_RAC_ACTION_LAST);
+        break;
+      case Dispatch::kCommand:
+        EXPECT_TRUE(last < IDC_RAC_ACTION_FIRST ||
+                    action.command_id > IDC_RAC_ACTION_LAST);
+        break;
+      case Dispatch::kAgentController:
+        break;
+    }
+    ranges.emplace_back(action.command_id, last);
+  }
+  // No two rows may claim the same command id: sorted, each range must start
+  // after the one before it ends.
+  std::ranges::sort(ranges);
+  for (size_t i = 1; i < ranges.size(); ++i) {
+    EXPECT_GT(ranges[i].first, ranges[i - 1].second)
+        << "overlapping command id ranges";
+  }

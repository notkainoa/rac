--- /dev/null
+++ b/chrome/browser/rac/dev/BUILD.gn
@@ -0,0 +1,12 @@
+# Copyright 2026 The rac Authors
+# Use of this source code is governed by a GPL-3.0 license.
+
+import("//build/buildflag_header.gni")
+import("//chrome/browser/rac/dev/dev_switches.gni")
+
+# BUILDFLAG(RAC_DEV_SWITCHES). A dev-only switch keeps its code and its name
+# inside the flag, so release binaries don't contain either.
+buildflag_header("buildflags") {
+  header = "buildflags.h"
+  flags = [ "RAC_DEV_SWITCHES=$rac_dev_switches" ]
+}
--- /dev/null
+++ b/chrome/browser/rac/dev/dev_switches.gni
@@ -0,0 +1,8 @@
+# Copyright 2026 The rac Authors
+# Use of this source code is governed by a GPL-3.0 license.
+
+declare_args() {
+  # rac's dev-only command-line switches, such as --rac-window-screenshot.
+  # Release builds are official builds, so they're compiled out there.
+  rac_dev_switches = !is_official_build
+}

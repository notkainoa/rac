+
+base::DictValue DataBackups::RestoreOffer::ToDict() const {
+  base::ListValue space_list;
+  for (size_t i = 0; i < std::min(spaces.size(), kMaxOfferSpaces); ++i) {
+    const SpaceSummary& space = spaces[i];
+    space_list.Append(base::DictValue()
+                          .Set(kSummaryNameKey, space.name)
+                          .Set(kSummaryEmojiKey, space.emoji)
+                          .Set(kSummaryColor1Key, space.color1)
+                          .Set(kSummaryColor2Key, space.color2)
+                          .Set(kSummaryModeKey, ModeName(space.mode)));
+  }
+  return base::DictValue()
+      .Set(kOfferBackupKey, backup_id)
+      .Set(kOfferCreatedKey, base::TimeToValue(created))
+      .Set(kOfferDetectedKey, base::TimeToValue(detected))
+      .Set(kOfferSpacesKey, static_cast<int>(counts.spaces))
+      .Set(kOfferPinnedTabsKey, static_cast<int>(counts.pinned_tabs))
+      .Set(kOfferFavoritesKey, static_cast<int>(counts.favorites))
+      .Set(kOfferSpaceListKey, std::move(space_list));
+}
+
+// static
+std::optional<DataBackups::RestoreOffer> DataBackups::RestoreOffer::FromDict(
+    const base::DictValue& dict) {
+  const std::string* backup_id = dict.FindString(kOfferBackupKey);
+  std::optional<base::Time> created =
+      base::ValueToTime(dict.Find(kOfferCreatedKey));
+  std::optional<base::Time> detected =
+      base::ValueToTime(dict.Find(kOfferDetectedKey));
+  if (!backup_id || !ParseBackupId(*backup_id) || !created || !detected) {
+    return std::nullopt;
+  }
+  auto count = [&](std::string_view key) {
+    return static_cast<size_t>(std::max(dict.FindInt(key).value_or(0), 0));
+  };
+  RestoreOffer offer{.backup_id = *backup_id,
+                     .created = *created,
+                     .counts = {.spaces = count(kOfferSpacesKey),
+                                .pinned_tabs = count(kOfferPinnedTabsKey),
+                                .favorites = count(kOfferFavoritesKey)},
+                     .detected = *detected};
+  // Prefs can be edited or come from another build, so the list is checked
+  // again. A missing or malformed list just means no summaries.
+  if (const base::ListValue* space_list = dict.FindList(kOfferSpaceListKey)) {
+    for (const base::Value& entry : *space_list) {
+      const base::DictValue* summary = entry.GetIfDict();
+      if (!summary) {
+        continue;
+      }
+      if (offer.spaces.size() >= kMaxOfferSpaces) {
+        break;
+      }
+      offer.spaces.push_back(
+          {.name = BoundName(summary->FindString(kSummaryNameKey)),
+           .emoji = BoundEmoji(summary->FindString(kSummaryEmojiKey)),
+           .color1 = ValidColor(summary->FindString(kSummaryColor1Key)),
+           .color2 = ValidColor(summary->FindString(kSummaryColor2Key)),
+           .mode = ParseMode(summary->FindString(kSummaryModeKey))});
+    }
+  }
+  return offer;
+}

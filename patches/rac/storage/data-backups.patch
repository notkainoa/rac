+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/data_backups_factory.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/storage/data_backups.h"
+
+namespace rac {
+
+// static
+DataBackups* DataBackupsFactory::GetForProfile(Profile* profile) {
+  return static_cast<DataBackups*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+DataBackupsFactory* DataBackupsFactory::GetInstance() {
+  static base::NoDestructor<DataBackupsFactory> instance;
+  return instance.get();
+}
+
+DataBackupsFactory::DataBackupsFactory()
+    : ProfileKeyedServiceFactory("RacDataBackups",
+                                 ProfileSelections::BuildForRegularProfile()) {}
+
+DataBackupsFactory::~DataBackupsFactory() = default;
+
+std::unique_ptr<KeyedService>
+DataBackupsFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  return std::make_unique<DataBackups>(profile->GetPrefs(), profile->GetPath());
+}
+
+bool DataBackupsFactory::ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+bool DataBackupsFactory::ServiceIsNULLWhileTesting() const {
+  return true;
+}
+
+}  // namespace rac

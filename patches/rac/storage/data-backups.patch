+// Prefs the user never changed aren't captured, and backing them up never
+// creates state for the pref's owner.
+TEST_F(DataBackupsTest, DefaultPrefsAreNotCaptured) {
+  SetSpaces(MakeSpaces({"Work"}));
+
+  std::unique_ptr<DataBackups> backups = Make();
+  std::optional<std::string> id = TakeSnapshot(*backups, kImportReason);
+  ASSERT_TRUE(id);
+  std::optional<DataBackups::Contents> contents = ReadContents(*backups, *id);
+  ASSERT_TRUE(contents);
+  EXPECT_EQ(contents->prefs.size(), 1u);
+  EXPECT_TRUE(contents->prefs.contains(DataBackups::kSpacesPref));
+  EXPECT_FALSE(contents->prefs.contains(DataBackups::kAgentSiteRulesPref));

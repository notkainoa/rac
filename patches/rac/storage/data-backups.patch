+  ASSERT_TRUE(contents);
+  ASSERT_TRUE(contents->prefs.FindDict(DataBackups::kSpacesPref));
+  EXPECT_EQ(*contents->prefs.FindDict(DataBackups::kSpacesPref), spaces_a);

+template <typename Result>
+void DataBackups::PostFileTask(base::OnceCallback<Result()> task,
+                               base::OnceCallback<void(Result)> reply) {
+  ++file_tasks_posted_;
+  task_runner_->PostTaskAndReplyWithResult(FROM_HERE, std::move(task),
+                                           std::move(reply));
+}
+
+DataBackups::DataBackups(PrefService* prefs,
+                         base::FilePath profile_dir,
+                         const base::Clock* clock)
+    : prefs_(prefs),
+      profile_dir_(std::move(profile_dir)),
+      dir_(profile_dir_.AppendASCII(kDirName)),
+      clock_(clock ? clock : base::DefaultClock::GetInstance()),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})),
+      timer_(clock_, /*tick_clock=*/nullptr) {
+  CHECK(prefs_);
+  sidebar_watch_.Init(prefs_);
+  // Everything here reads prefs already in memory. A file is touched only
+  // when this `Preferences` was never checked against the backups folder: a
+  // new profile's first launch, or the first launch after a reset.
+  const base::DictValue& stored_offer = prefs_->GetDict(kRestoreOfferPref);
+  if (!stored_offer.empty()) {
+    std::optional<RestoreOffer> offer = RestoreOffer::FromDict(stored_offer);
+    if (offer && offer->detected > Now() + kClockSkewAllowance) {
+      // The clock moved back. The offer's lifetime restarts now.
+      offer->detected = Now();
+      prefs_->SetDict(kRestoreOfferPref, offer->ToDict());
+    }
+    if (offer && Now() < offer->detected + kRestoreOfferLifetime) {
+      restore_offer_ = std::move(offer);
+    } else {
+      // An offer nobody answered lapses as if dismissed. The pre-reset copy it
+      // pointed at stays for its own lifetime.
+      prefs_->ClearPref(kRestoreOfferPref);
+    }
+  }
+  if (!prefs_->GetBoolean(kInitializedPref)) {
+    PostFileTask(base::BindOnce(&CheckForReset, dir_, Now()),
+                 base::BindOnce(&DataBackups::DidCheckForReset,
+                                weak_factory_.GetWeakPtr()));
+  }
+  startup_prune_time_ = Now() + kStartupPruneDelay;
+  startup_run_time_ = Now() + kStartupDelay;
+  ScheduleWork(kStartupDelay);
+}

+// A snapshot is deleted kSnapshotLifetime after it was taken, and reads as
+// gone as soon as it's expired, before it's pruned.
+TEST_F(DataBackupsTest, SnapshotExpiresAfterLifetime) {
+  const base::Time start = clock()->Now();
+  std::unique_ptr<DataBackups> backups = Make();
+  std::optional<std::string> id = TakeSnapshot(*backups, kImportReason);
+  ASSERT_TRUE(id);
+  EXPECT_TRUE(FileExists(BackupFile(*id)));
+
+  {
+    // A service whose clock is past the expiry reads nothing, though nothing
+    // has pruned the file yet.
+    base::SimpleTestClock late_clock;
+    late_clock.SetNow(start + DataBackups::kSnapshotLifetime + base::Hours(1));
+    DataBackups late_backups(&prefs_, dir_.GetPath(), &late_clock);
+    EXPECT_FALSE(ReadContents(late_backups, *id));
+    Flush(late_backups);
+    EXPECT_TRUE(FileExists(BackupFile(*id)));
+  }
+  EXPECT_TRUE(ReadContents(*backups, *id));
+
+  FastForward(DataBackups::kSnapshotLifetime + base::Hours(1));
+  EXPECT_FALSE(FileExists(BackupFile(*id)));
+  EXPECT_FALSE(ReadContents(*backups, *id));
+}

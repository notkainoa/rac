+// A space as `rac.spaces` stores it, with the optional icon and theme.
+base::DictValue MakeThemedSpace(int index,
+                                std::string_view name,
+                                std::string_view icon,
+                                std::string_view color1,
+                                std::string_view color2,
+                                std::string_view mode) {
+  base::DictValue space;
+  space.Set("id", base::StringPrintf("0f7a5c9e-6f8b-4b5e-9c1d-2a3b4c5d6e%02d",
+                                     index));
+  space.Set("name", name);
+  if (!icon.empty()) {
+    space.Set("icon", icon);
+  }
+  space.Set("theme", base::DictValue()
+                         .Set("color1", color1)
+                         .Set("color2", color2)
+                         .Set("mode", mode)
+                         .Set("future_field", 7));
+  return space;
+}
+
+base::DictValue SpacesStore(std::vector<base::DictValue> spaces) {
+  base::ListValue list;
+  for (base::DictValue& space : spaces) {
+    list.Append(std::move(space));
+  }
+  return base::DictValue().Set("version", 1).Set("spaces", std::move(list));
+}

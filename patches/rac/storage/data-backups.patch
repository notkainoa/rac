+  std::optional<DataBackups::Contents> offered = ReadOffered(*backups);
+  ASSERT_TRUE(offered);
+  EXPECT_EQ(offered->id, offer.backup_id);
+  EXPECT_EQ(offered->counts, kUserDataCounts);
+  EXPECT_FALSE(offered->spaces_store);
+}

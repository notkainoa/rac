+namespace rac {
+
+namespace backups_internal {
+
+// What the startup check for a reset `Preferences` found.
+struct ResetCheck {
+  // Backup files existed, so this `Preferences` was reset.
+  bool reset = false;
+  // Every daily backup became a pre-reset copy. If not, the check runs again
+  // at the next launch and no daily is written until then.
+  bool rotated = true;
+  std::optional<DataBackups::RestoreOffer> offer;
+};
+
+// What a background write or prune did.
+struct FileWork {
+  FileWork() = default;
+  FileWork(FileWork&&) = default;
+  FileWork& operator=(FileWork&&) = default;
+  ~FileWork() = default;
+
+  std::optional<base::Time> daily_written;
+  std::optional<std::string> snapshot_written;
+  // When the next pre-reset copy or snapshot expires.
+  std::optional<base::Time> next_expiry;
+  // Snapshots still on disk, so pins on deleted ones can be dropped.
+  std::vector<std::string> snapshot_ids;
+};
+
+}  // namespace backups_internal
+
+namespace {
+
+using backups_internal::FileWork;
+using backups_internal::ResetCheck;
+using Kind = DataBackups::Kind;
+
+// File keys. Files carry their own version so a newer rac's backups are
+// never misread by an older one.
+constexpr char kVersionKey[] = "version";
+constexpr char kMinReaderVersionKey[] = "min_reader_version";
+constexpr char kKindKey[] = "kind";
+constexpr char kReasonKey[] = "reason";
+constexpr char kCreatedKey[] = "created";
+constexpr char kPrefsKey[] = "prefs";
+constexpr char kSpacesStoreKey[] = "spaces_store";
+
+constexpr char kKindDaily[] = "daily";
+constexpr char kKindPreReset[] = "prereset";
+constexpr char kKindSnapshot[] = "snapshot";
+
+// File names: "<prefix><time>.json", and snapshots add "-<reason>".
+constexpr char kDailyPrefix[] = "daily-";
+constexpr char kPreResetPrefix[] = "prereset-";
+constexpr char kSnapshotPrefix[] = "snapshot-";
+constexpr char kJsonExtension[] = ".json";
+// "20261027T130501123Z": UTC, to the millisecond.
+constexpr size_t kTimeLength = 19;
+constexpr size_t kMaxReasonLength = 32;
+
+// SpacesStore's file and its previous copy.
+constexpr char kSpacesStoreFile[] = "rac spaces";
+constexpr char kSpacesStoreBackupSuffix[] = ".bak";
+
+// RestoreOffer keys.
+constexpr char kOfferBackupKey[] = "backup";
+constexpr char kOfferCreatedKey[] = "created";
+constexpr char kOfferDetectedKey[] = "detected";
+constexpr char kOfferSpacesKey[] = "spaces";
+constexpr char kOfferPinnedTabsKey[] = "pinned_tabs";
+constexpr char kOfferFavoritesKey[] = "favorites";
+constexpr char kOfferSpaceListKey[] = "space_list";
+constexpr char kSummaryNameKey[] = "name";
+constexpr char kSummaryEmojiKey[] = "emoji";
+constexpr char kSummaryColor1Key[] = "color1";
+constexpr char kSummaryColor2Key[] = "color2";
+constexpr char kSummaryModeKey[] = "mode";
+
+// The shapes of rac.spaces and rac.sidebar.lists, as SpacesService and
+// SidebarItems write them.
+constexpr char kSpacesListKey[] = "spaces";
+constexpr char kSpaceIdKey[] = "id";
+constexpr char kSpaceNameKey[] = "name";
+constexpr char kSpaceIconKey[] = "icon";
+// A space's `theme`: {"color1": "#RRGGBB", "color2": "#RRGGBB",
+// "mode": "light" | "dark" | "auto"}.
+constexpr char kSpaceThemeKey[] = "theme";
+constexpr char kThemeColor1Key[] = "color1";
+constexpr char kThemeColor2Key[] = "color2";
+constexpr char kThemeModeKey[] = "mode";
+constexpr char kModeLight[] = "light";
+constexpr char kModeDark[] = "dark";
+constexpr char kModeAuto[] = "auto";
+constexpr char kFavoritesList[] = "favorites";
+constexpr char kPinnedListPrefix[] = "pinned.";
+constexpr char kEntriesKey[] = "entries";
+constexpr char kFolderItemsKey[] = "items";
+
+// Far bigger than any backup this build writes. Larger files are skipped.
+constexpr size_t kMaxFileSize = 64 * 1024 * 1024;
+
+// How long a failed write or delete waits before it's tried again.
+constexpr base::TimeDelta kRetryDelay = base::Hours(1);
+// The shortest wait between two runs of the scheduled work.
+constexpr base::TimeDelta kMinRunInterval = base::Minutes(1);
+
+std::string FormatTime(base::Time time) {
+  base::Time::Exploded exploded;
+  time.UTCExplode(&exploded);
+  return base::StringPrintf("%04d%02d%02dT%02d%02d%02d%03dZ", exploded.year,
+                            exploded.month, exploded.day_of_month,
+                            exploded.hour, exploded.minute, exploded.second,
+                            exploded.millisecond);
+}
+
+std::optional<base::Time> ParseTime(std::string_view text) {
+  if (text.size() != kTimeLength || text[8] != 'T' || text[18] != 'Z') {
+    return std::nullopt;
+  }
+  auto field = [&](size_t start, size_t length) -> std::optional<int> {
+    std::string_view digits = text.substr(start, length);
+    int value = 0;
+    if (!std::ranges::all_of(digits, base::IsAsciiDigit<char>) ||
+        !base::StringToInt(digits, &value)) {
+      return std::nullopt;
+    }
+    return value;
+  };
+  std::optional<int> year = field(0, 4), month = field(4, 2),
+                     day = field(6, 2), hour = field(9, 2),
+                     minute = field(11, 2), second = field(13, 2),
+                     millisecond = field(15, 3);
+  if (!year || !month || !day || !hour || !minute || !second ||
+      !millisecond) {
+    return std::nullopt;
+  }
+  base::Time::Exploded exploded = {};
+  exploded.year = *year;
+  exploded.month = *month;
+  exploded.day_of_month = *day;
+  exploded.hour = *hour;
+  exploded.minute = *minute;
+  exploded.second = *second;
+  exploded.millisecond = *millisecond;
+  base::Time time;
+  if (!base::Time::FromUTCExploded(exploded, &time)) {
+    return std::nullopt;
+  }
+  return time;
+}
+
+bool IsValidReason(std::string_view reason) {
+  return !reason.empty() && reason.size() <= kMaxReasonLength &&
+         std::ranges::all_of(reason, [](char c) {
+           return base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '-';
+         });
+}
+
+std::string DailyId(base::Time created) {
+  return base::StrCat({kDailyPrefix, FormatTime(created)});
+}
+
+std::string PreResetId(base::Time created) {
+  return base::StrCat({kPreResetPrefix, FormatTime(created)});
+}
+
+std::string SnapshotId(base::Time created, std::string_view reason) {
+  return base::StrCat({kSnapshotPrefix, FormatTime(created), "-", reason});
+}
+
+struct ParsedId {
+  Kind kind;
+  base::Time created;
+};
+
+// Ids become file names, so this strict parser is also what keeps a caller's
+// id from naming any other file.
+std::optional<ParsedId> ParseBackupId(std::string_view id) {
+  for (const auto& [prefix, kind] :
+       {std::pair(kDailyPrefix, Kind::kDaily),
+        std::pair(kPreResetPrefix, Kind::kPreReset)}) {
+    if (base::StartsWith(id, prefix)) {
+      std::optional<base::Time> created =
+          ParseTime(id.substr(std::string_view(prefix).size()));
+      return created ? std::optional<ParsedId>({kind, *created})
+                     : std::nullopt;
+    }
+  }
+  if (!base::StartsWith(id, kSnapshotPrefix)) {
+    return std::nullopt;
+  }
+  id.remove_prefix(std::string_view(kSnapshotPrefix).size());
+  if (id.size() < kTimeLength + 2 || id[kTimeLength] != '-' ||
+      !IsValidReason(id.substr(kTimeLength + 1))) {
+    return std::nullopt;
+  }
+  std::optional<base::Time> created = ParseTime(id.substr(0, kTimeLength));
+  return created ? std::optional<ParsedId>({Kind::kSnapshot, *created})
+                 : std::nullopt;
+}
+
+bool IsSnapshotId(std::string_view id) {
+  std::optional<ParsedId> parsed = ParseBackupId(id);
+  return parsed && parsed->kind == Kind::kSnapshot;
+}
+
+base::FilePath FileForId(const base::FilePath& dir, std::string_view id) {
+  return dir.AppendASCII(base::StrCat({id, kJsonExtension}));
+}
+
+base::DictValue MakeFile(std::string_view kind,
+                         std::string_view reason,
+                         base::Time created) {
+  base::DictValue file;
+  file.Set(kVersionKey, DataBackups::kVersion);
+  file.Set(kMinReaderVersionKey, DataBackups::kMinReaderVersion);
+  file.Set(kKindKey, kind);
+  if (!reason.empty()) {
+    file.Set(kReasonKey, reason);
+  }
+  file.Set(kCreatedKey, base::TimeToValue(created));
+  return file;
+}
+
+bool HasData(const DataBackups::Contents& contents) {
+  return !DataBackups::IsEmpty(
+      contents.prefs.Find(DataBackups::kSpacesPref),
+      contents.prefs.Find(DataBackups::kSidebarListsPref));
+}
+
+// The functions below run on the background sequence.
+
+std::optional<base::DictValue> ReadJsonDict(const base::FilePath& path) {
+  std::string content;
+  if (!base::ReadFileToStringWithMaxSize(path, &content, kMaxFileSize) ||
+      content.empty()) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(content, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(parsed->GetDict());
+}
+
+// The folder is the user's only, and so is every file in it. Backups hold
+// the same data as `Preferences`, but nobody else needs to read them.
+bool WriteBackupFile(const base::FilePath& dir,
+                     std::string_view id,
+                     const base::DictValue& file) {
+  if (!base::CreateDirectory(dir)) {
+    LOG(ERROR) << "rac: couldn't create the backups folder";
+    return false;
+  }
+  std::string json;
+  if (!base::JSONWriter::Write(file, &json)) {
+    LOG(ERROR) << "rac: couldn't serialize a backup";
+    return false;
+  }
+#if BUILDFLAG(IS_POSIX)
+  if (!base::SetPosixFilePermissions(dir, base::FILE_PERMISSION_USER_MASK)) {
+    LOG(ERROR) << "rac: couldn't restrict the backups folder";
+    return false;
+  }
+#endif
+  // The temporary file it renames into place comes from mkstemp, so it's
+  // 0600 from the start. Nothing else needs to change its mode.
+  if (!base::ImportantFileWriter::WriteFileAtomically(FileForId(dir, id), json,
+                                                      "RacDataBackups")) {
+    LOG(ERROR) << "rac: couldn't write a backup";
+    return false;
+  }
+  return true;
+}
+
+// Reads `rac spaces` the way SpacesStore does: the file, else its previous
+// copy, else nothing. A snapshot then holds what the store would load.
+std::optional<base::DictValue> ReadSpacesStore(
+    const base::FilePath& profile_dir) {
+  for (const char* suffix : {"", kSpacesStoreBackupSuffix}) {
+    std::optional<base::DictValue> dict = ReadJsonDict(
+        profile_dir.AppendASCII(base::StrCat({kSpacesStoreFile, suffix})));
+    if (dict) {
+      return dict;
+    }
+  }
+  return std::nullopt;
+}
+
+struct BackupFile {
+  base::FilePath path;
+  std::string id;
+  Kind kind;
+  base::Time created;
+  base::Time modified;
+};
+
+// Oldest first. Names and the directory's stat data only; no file is opened.
+std::vector<BackupFile> ListBackups(const base::FilePath& dir) {
+  std::vector<BackupFile> backups;
+  base::FileEnumerator files(dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("*.json"));
+  for (base::FilePath path = files.Next(); !path.empty();
+       path = files.Next()) {
+    std::string id = path.BaseName().RemoveFinalExtension().MaybeAsASCII();
+    if (std::optional<ParsedId> parsed = ParseBackupId(id)) {
+      backups.push_back({path, std::move(id), parsed->kind, parsed->created,
+                         files.GetInfo().GetLastModifiedTime()});
+    }
+  }
+  std::ranges::sort(backups, {}, &BackupFile::created);
+  return backups;
+}
+
+// When a backup stops being kept. A daily backup expires too, once it passes
+// kDailyLifetime, on top of the count cap.
+//
+// A snapshot's lifetime starts at the older of the time in its name and its
+// file's time, so neither a renamed file nor a skewed name keeps open-tab
+// URLs longer. A daily's starts the same way. A pre-reset copy's starts when
+// it became one (rotation sets its file time), so the copy an offer points
+// at always outlives the offer.
+//
+// If the start is more than kClockSkewAllowance in the future, the clock
+// moved back since it was written. The lifetime then restarts now, recorded
+// in the file's time: the file still goes within one lifetime, and Undo
+// isn't wiped by a clock correction.
+std::optional<base::Time> ExpiryOf(const BackupFile& file, base::Time now) {
+  base::TimeDelta lifetime = DataBackups::kSnapshotLifetime;
+  base::Time start = std::min(file.created, file.modified);
+  switch (file.kind) {
+    case Kind::kDaily:
+      lifetime = DataBackups::kDailyLifetime;
+      break;
+    case Kind::kPreReset:
+      lifetime = DataBackups::kPreResetLifetime;
+      start = file.modified;
+      break;
+    case Kind::kSnapshot:
+      break;
+  }
+  if (start > now + DataBackups::kClockSkewAllowance) {
+    if (!base::TouchFile(file.path, now, now)) {
+      LOG(ERROR) << "rac: couldn't restart a backup's lifetime";
+    }
+    start = now;
+  }
+  return start + lifetime;
+}
+
+bool IsExpired(const BackupFile& file, base::Time now) {
+  std::optional<base::Time> expiry = ExpiryOf(file, now);
+  return expiry && *expiry <= now;
+}
+
+std::optional<DataBackups::Contents> DecodeBackup(const base::DictValue& file,
+                                                  const ParsedId& parsed,
+                                                  std::string_view id) {
+  if (file.FindInt(kMinReaderVersionKey).value_or(DataBackups::kVersion) >
+      DataBackups::kVersion) {
+    return std::nullopt;
+  }
+  std::optional<base::Time> created = base::ValueToTime(file.Find(kCreatedKey));
+  if (!created) {
+    return std::nullopt;
+  }
+  DataBackups::Contents contents;
+  contents.id = std::string(id);
+  contents.kind = parsed.kind;
+  contents.created = *created;
+  if (const std::string* reason = file.FindString(kReasonKey)) {
+    contents.reason = *reason;
+  }
+  // Only the prefs this build restores. A newer build may back up more.
+  if (const base::DictValue* prefs = file.FindDict(kPrefsKey)) {
+    for (const char* name : DataBackups::kBackedUpPrefs) {
+      if (const base::Value* value = prefs->Find(name)) {
+        contents.prefs.Set(name, value->Clone());
+      }
+    }
+  }
+  // Only snapshots may hold open tabs. Anything else that claims to is
+  // ignored, so a daily or pre-reset copy never brings tabs back.
+  if (parsed.kind == Kind::kSnapshot) {
+    if (const base::DictValue* store = file.FindDict(kSpacesStoreKey)) {
+      contents.spaces_store = store->Clone();
+    }
+  }
+  contents.counts =
+      DataBackups::Count(contents.prefs.Find(DataBackups::kSpacesPref),
+                         contents.prefs.Find(DataBackups::kSidebarListsPref));
+  return contents;
+}
+
+std::optional<DataBackups::Contents> ReadBackupFile(const base::FilePath& dir,
+                                                    const std::string& id,
+                                                    base::Time now) {
+  std::optional<ParsedId> parsed = ParseBackupId(id);
+  if (!parsed) {
+    return std::nullopt;
+  }
+  const base::FilePath path = FileForId(dir, id);
+  base::File::Info info;
+  if (!base::GetFileInfo(path, &info)) {
+    return std::nullopt;
+  }
+  // Pruning may not have run yet. An expired backup is gone either way.
+  if (IsExpired({path, id, parsed->kind, parsed->created, info.last_modified},
+                now)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> file = ReadJsonDict(path);
+  if (!file) {
+    return std::nullopt;
+  }
+  return DecodeBackup(*file, *parsed, id);
+}
+
+// The newest pre-reset copy or snapshot with data in it, other than
+// `skip_id`. Daily backups aren't considered: after a reset, every daily is
+// either a pre-reset copy already or holds what was made since.
+std::optional<DataBackups::Contents> NewestWithData(const base::FilePath& dir,
+                                                    base::Time now,
+                                                    std::string_view skip_id) {
+  std::vector<BackupFile> backups = ListBackups(dir);
+  for (const BackupFile& backup : base::Reversed(backups)) {
+    if (backup.kind == Kind::kDaily || backup.id == skip_id) {
+      continue;
+    }
+    std::optional<DataBackups::Contents> contents =
+        ReadBackupFile(dir, backup.id, now);
+    if (contents && HasData(*contents)) {
+      return contents;
+    }
+  }
+  return std::nullopt;
+}
+
+// Deletes expired backups, daily backups beyond kDailyGenerations, and the
+// oldest unpinned snapshots beyond kMaxSnapshots.
+void Prune(const base::FilePath& dir,
+           base::Time now,
+           const base::flat_set<std::string>& pinned,
+           FileWork& work) {
+  std::vector<BackupFile> backups = ListBackups(dir);
+  std::vector<const BackupFile*> dailies;
+  std::vector<const BackupFile*> snapshots;
+  auto note_expiry = [&](base::Time expiry) {
+    work.next_expiry =
+        work.next_expiry ? std::min(*work.next_expiry, expiry) : expiry;
+  };
+  auto remove = [&](const BackupFile& backup) {
+    if (base::DeleteFile(backup.path)) {
+      return true;
+    }
+    LOG(ERROR) << "rac: couldn't delete an old backup";
+    note_expiry(now + kRetryDelay);
+    return false;
+  };
+  for (const BackupFile& backup : backups) {
+    std::optional<base::Time> expiry = ExpiryOf(backup, now);
+    if (expiry && *expiry <= now) {
+      if (remove(backup)) {
+        continue;
+      }
+    } else if (expiry) {
+      note_expiry(*expiry);
+    }
+    if (backup.kind == Kind::kDaily) {
+      dailies.push_back(&backup);
+    } else if (backup.kind == Kind::kSnapshot) {
+      snapshots.push_back(&backup);
+    }
+  }
+  // Both lists are oldest first.
+  for (size_t i = 0; i + DataBackups::kDailyGenerations < dailies.size(); ++i) {
+    remove(*dailies[i]);
+  }
+  size_t snapshot_count = snapshots.size();
+  for (const BackupFile* snapshot : snapshots) {
+    if (snapshot_count <= DataBackups::kMaxSnapshots) {
+      break;
+    }
+    if (!pinned.contains(snapshot->id) && remove(*snapshot)) {
+      --snapshot_count;
+    }
+  }
+  for (const BackupFile* snapshot : snapshots) {
+    if (base::PathExists(snapshot->path)) {
+      work.snapshot_ids.push_back(snapshot->id);
+    }
+  }
+}
+
+FileWork WriteSnapshot(const base::FilePath& profile_dir,
+                       const base::FilePath& dir,
+                       std::string id,
+                       base::DictValue file,
+                       base::Time now,
+                       base::flat_set<std::string> pinned) {
+  if (std::optional<base::DictValue> store = ReadSpacesStore(profile_dir)) {
+    file.Set(kSpacesStoreKey, std::move(*store));
+  }
+  FileWork work;
+  if (WriteBackupFile(dir, id, file)) {
+    work.snapshot_written = std::move(id);
+  }
+  // `pinned` includes the new snapshot, so the cap never takes it.
+  Prune(dir, now, pinned, work);
+  return work;
+}
+
+FileWork DoScheduledWork(
+    const base::FilePath& dir,
+    std::optional<std::pair<std::string, base::DictValue>> daily,
+    base::Time now,
+    base::flat_set<std::string> pinned) {
+  FileWork work;
+  if (daily && WriteBackupFile(dir, daily->first, daily->second)) {
+    work.daily_written = now;
+  }
+  Prune(dir, now, pinned, work);
+  return work;
+}
+
+FileWork DeleteSnapshotFile(const base::FilePath& dir,
+                            const std::string& id,
+                            base::Time now,
+                            base::flat_set<std::string> pinned) {
+  base::DeleteFile(FileForId(dir, id));
+  FileWork work;
+  Prune(dir, now, pinned, work);
+  return work;
+}
+
+// Runs once per `Preferences`, when kInitializedPref is unset. Backup files
+// then mean `Preferences` was reset: every daily backup becomes a pre-reset
+// copy, so nothing written from now on can replace it. The newest backup
+// with data in it is offered even if the live sidebar isn't empty, because
+// restoring merges with whatever is there.
+ResetCheck CheckForReset(const base::FilePath& dir, base::Time now) {
+  ResetCheck result;
+  std::vector<BackupFile> backups = ListBackups(dir);
+  if (backups.empty()) {
+    return result;
+  }
+  result.reset = true;
+  for (const BackupFile& backup : backups) {
+    if (backup.kind != Kind::kDaily) {
+      continue;
+    }
+    const base::FilePath target = FileForId(dir, PreResetId(backup.created));
+    if (base::PathExists(target)) {
+      // Kept at an earlier reset already.
+      base::DeleteFile(backup.path);
+      continue;
+    }
+    // The file's time marks when it became a pre-reset copy, which starts
+    // its kPreResetLifetime.
+    if (!base::Move(backup.path, target) ||
+        !base::TouchFile(target, now, now)) {
+      LOG(ERROR) << "rac: couldn't keep a backup from before a reset";
+      result.rotated = false;
+    }
+  }
+  std::optional<DataBackups::Contents> best =
+      NewestWithData(dir, now, /*skip_id=*/std::string_view());
+  if (!best) {
+    return result;
+  }
+  if (best->kind == Kind::kSnapshot) {
+    // A snapshot expires in at most kSnapshotLifetime, which can be before
+    // the offer lapses. The offer gets a pre-reset copy of its prefs. Its open
+    // tabs aren't copied, so they still go on time.
+    const std::string id = PreResetId(best->created);
+    base::DictValue copy = MakeFile(kKindPreReset, best->reason, best->created);
+    copy.Set(kPrefsKey, best->prefs.Clone());
+    if (!base::PathExists(FileForId(dir, id)) &&
+        WriteBackupFile(dir, id, copy)) {
+      best->id = id;
+    }
+  }
+  // Only the offer's small summaries are made here, not a copy of the prefs.
+  std::vector<DataBackups::SpaceSummary> spaces =
+      DataBackups::SummarizeSpaces(best->prefs.Find(DataBackups::kSpacesPref));
+  result.offer = DataBackups::RestoreOffer{.backup_id = best->id,
+                                           .created = best->created,
+                                           .counts = best->counts,
+                                           .spaces = std::move(spaces),
+                                           .detected = now};
+  return result;
+}
+
+std::optional<DataBackups::Contents> ReadOfferedBackupFile(
+    const base::FilePath& dir,
+    const std::string& id,
+    base::Time now) {
+  std::optional<DataBackups::Contents> offered = ReadBackupFile(dir, id, now);
+  if (offered && HasData(*offered)) {
+    return offered;
+  }
+  LOG(ERROR) << "rac: the offered backup is gone; using the next newest";
+  return NewestWithData(dir, now, id);
+}
+
+// Calls `visit` with each list in rac.sidebar.lists, its key, and its
+// entries.
+template <typename Visitor>
+void ForEachSidebarList(const base::Value* sidebar_lists, Visitor visit) {
+  if (!sidebar_lists || !sidebar_lists->is_dict()) {
+    return;
+  }
+  for (const auto [key, value] : sidebar_lists->GetDict()) {
+    const base::DictValue* list = value.GetIfDict();
+    const base::ListValue* entries =
+        list ? list->FindList(kEntriesKey) : nullptr;
+    if (entries) {
+      visit(key, *entries);
+    }
+  }
+}
+
+const base::ListValue* FindSpacesList(const base::Value* spaces) {
+  return spaces && spaces->is_dict()
+             ? spaces->GetDict().FindList(kSpacesListKey)
+             : nullptr;
+}
+
+bool IsSpace(const base::Value& entry) {
+  return entry.is_dict() && entry.GetDict().FindString(kSpaceIdKey);
+}
+
+// "#RRGGBB" only, the form SpaceTheme stores. Anything else becomes empty, so
+// the UI falls back to its own color instead of parsing a stranger's string.
+std::string ValidColor(const std::string* color) {
+  if (!color || color->size() != 7 || (*color)[0] != '#' ||
+      !std::ranges::all_of(std::string_view(*color).substr(1),
+                           base::IsHexDigit<char>)) {
+    return std::string();
+  }
+  return *color;
+}
+
+DataBackups::SpaceSummary::Mode ParseMode(const std::string* mode) {
+  using Mode = DataBackups::SpaceSummary::Mode;
+  if (mode && *mode == kModeLight) {
+    return Mode::kLight;
+  }
+  if (mode && *mode == kModeDark) {
+    return Mode::kDark;
+  }
+  return Mode::kAuto;
+}
+
+const char* ModeName(DataBackups::SpaceSummary::Mode mode) {
+  using Mode = DataBackups::SpaceSummary::Mode;
+  return mode == Mode::kLight  ? kModeLight
+         : mode == Mode::kDark ? kModeDark
+                               : kModeAuto;
+}
+
+// Bounds a string the offer shows. Names are cut on a character boundary;
+// an emoji that is too long is dropped, because half an emoji is worse than
+// none.
+std::string BoundName(const std::string* name) {
+  return name ? std::string(base::TruncateUTF8ToByteSize(
+                    *name, DataBackups::kMaxSummaryNameBytes))
+              : std::string();
+}
+
+std::string BoundEmoji(const std::string* emoji) {
+  return emoji && emoji->size() <= DataBackups::kMaxSummaryEmojiBytes &&
+                 base::IsStringUTF8(*emoji)
+             ? *emoji
+             : std::string();
+}

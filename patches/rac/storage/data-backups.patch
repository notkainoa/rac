+++ src/chrome/browser/rac/storage/restore_plan.h
@@ -0,0 +1,92 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_STORAGE_RESTORE_PLAN_H_
+#define CHROME_BROWSER_RAC_STORAGE_RESTORE_PLAN_H_
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/values.h"
+#include "chrome/browser/rac/storage/data_backups.h"
+
+namespace rac {
+
+enum class RestoreMode {
+  // For a full restore. The sidebar becomes exactly the backup: its spaces
+  // in its order, its favorites and pinned tabs, and, if the backup has
+  // `rac spaces`, its hidden spaces' tabs. Spaces the backup doesn't have
+  // are deleted, which closes their tabs (they stay in History). Agent
+  // permissions are the exception: they only ever get stricter, as in
+  // kMerge.
+  kExact,
+  // For the restore prompt. The backup's spaces, favorites, and pinned tabs
+  // come back first, and everything live is kept after them. Nothing is
+  // closed or removed, and agent permissions only ever get stricter.
+  kMerge,
+};
+
+// What's live when a restore starts. DataRestorer fills it in from prefs,
+// SpacesWindowManager, and its store, all on the UI thread.
+struct LiveSidebar {
+  LiveSidebar();
+  LiveSidebar(LiveSidebar&&);
+  LiveSidebar& operator=(LiveSidebar&&);
+  ~LiveSidebar();
+
+  // Stored values of DataBackups::kBackedUpPrefs. A pref missing here is at
+  // its default.
+  base::DictValue prefs;
+  // Spaces with tabs open in a window.
+  base::flat_set<std::string> spaces_with_window_tabs;
+  // Spaces with tabs in `rac spaces`.
+  base::flat_set<std::string> spaces_with_stored_tabs;
+};
+
+// Everything a restore changes, worked out before anything is changed.
+// DataRestorer applies it in one UI task, in the order of the fields.
+struct RestorePlan {
+  RestorePlan();
+  RestorePlan(RestorePlan&&);
+  RestorePlan& operator=(RestorePlan&&);
+  ~RestorePlan();
+
+  // Upserted in this order with SpacesService::RestoreSpace(space, index).
+  std::vector<base::DictValue> spaces;
+  // kMerge only: the empty space a reset left. Its window tabs move into
+  // `move_tabs_to`, the first restored space, and then it's deleted, so the
+  // result is exactly the backup plus what was made since. Not set when it
+  // can't be told apart from a space the user made.
+  std::optional<std::string> move_tabs_from;
+  std::string move_tabs_to;
+  // Deleted with SpacesWindowManager::DeleteSpace, after the move.
+  std::vector<std::string> delete_spaces;
+  // New stored values; nullopt clears the pref. rac.spaces isn't here:
+  // SpacesService writes it as it restores `spaces`.
+  std::optional<base::Value> sidebar_lists;
+  std::optional<base::Value> agent_site_rules;
+  std::optional<base::Value> agent_permission_level;
+  // Space id -> its StoredSpace dict from the backup's `rac spaces`, for
+  // SpacesWindowManager::RestoreStoredTabs.
+  std::vector<std::pair<std::string, base::DictValue>> restore_stored_tabs;
+  // kExact only, and only when the backup has `rac spaces`: spaces whose
+  // stored tabs are dropped because they had none at backup time.
+  std::vector<std::string> remove_stored_tabs;
+};
+
+RestorePlan MakeRestorePlan(const DataBackups::Contents& backup,
+                            const LiveSidebar& live,
+                            RestoreMode mode);
+
+// Whether DataRestorer snapshots the live data before applying, so the
+// restore can be undone. Not for kMerge into an empty sidebar: a merge loses
+// nothing, and a full disk mustn't stop the user getting their data back.
+bool NeedsSafetySnapshot(RestoreMode mode, const LiveSidebar& live);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_RESTORE_PLAN_H_

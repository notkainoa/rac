+// Only 1-32 characters of a-z, 0-9, and "-" make a reason, and a bad one
+// writes nothing.
+TEST_F(DataBackupsTest, RejectsBadReason) {
+  std::unique_ptr<DataBackups> backups = Make();
+  const std::vector<std::string> reasons = {

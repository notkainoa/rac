+
+void DataBackups::DidCheckForReset(ResetCheck result) {
+  if (result.rotated) {
+    prefs_->SetBoolean(kInitializedPref, true);
+  }
+  // The offer stands even if the sidebar filled in while the files were
+  // read: restoring merges, so it replaces nothing. An offer already stored
+  // in prefs still wins.
+  if (result.offer && !restore_offer_) {
+    SetRestoreOffer(std::move(result.offer));
+  }
+  ScheduleWork(kMinRunInterval);
+}
+
+void DataBackups::SetRestoreOffer(std::optional<RestoreOffer> offer) {
+  restore_offer_ = std::move(offer);
+  if (restore_offer_) {
+    prefs_->SetDict(kRestoreOfferPref, restore_offer_->ToDict());
+  } else {
+    prefs_->ClearPref(kRestoreOfferPref);
+  }
+  NotifyOfferObservers();
+}
+
+void DataBackups::NotifyOfferObservers() {
+  for (Observer& observer : observers_) {
+    observer.OnRestoreOfferChanged();
+  }
+}
+
+base::Time DataBackups::OfferLapseTime() const {
+  return restore_offer_->detected + kRestoreOfferLifetime;
+}
+
+base::Time DataBackups::DailyDueTime() const {
+  // Not before this `Preferences` was checked for a reset, so a daily never
+  // replaces what the check would keep. Not while the sidebar is empty.
+  if (!prefs_->GetBoolean(kInitializedPref) || !sidebar_watch_.IsEmpty()) {
+    return base::Time::Max();
+  }
+  const base::Time now = Now();
+  const base::Time last = prefs_->GetTime(kLastDailyPref);
+  // A last backup in the future means the clock moved back; don't wait for
+  // it to catch up.
+  base::Time due = last.is_null() || last > now ? now : last + kDailyInterval;
+  if (!daily_soon_.is_null()) {
+    due = std::min(due, daily_soon_);
+  }
+  return std::max(due, daily_retry_);
+}
+
+void DataBackups::ScheduleWork(base::TimeDelta min_delay) {
+  const base::Time now = Now();
+  base::Time due = base::Time::Max();
+  if (!startup_prune_time_.is_null()) {
+    // The early startup prune goes first, at its own time.
+    due = startup_prune_time_;
+  } else if (!startup_run_time_.is_null()) {
+    // Nothing runs before the first full run, which handles everything due.
+    due = startup_run_time_;
+  } else {
+    due = std::min(due, DailyDueTime());
+    if (next_expiry_) {
+      due = std::min(due, *next_expiry_);
+    }
+    if (restore_offer_) {
+      due = std::min(due, OfferLapseTime());
+    }
+  }
+  if (due.is_max()) {
+    // Nothing is due, so nothing wakes the service.
+    timer_.Stop();
+    return;
+  }
+  // The startup prune keeps its due time; anything else waits at least
+  // min_delay so replies don't thrash the timer.
+  const base::Time at = !startup_prune_time_.is_null()
+                            ? due
+                            : std::max(due, now + min_delay);
+  timer_.Start(FROM_HERE, at,
+               base::BindOnce(&DataBackups::RunScheduledWork,
+                              base::Unretained(this)));
+}
+
+void DataBackups::RunScheduledWork() {
+  const base::Time now = Now();
+  // A run while the early prune is still pending and before the first full
+  // run only prunes. The full run still happens at kStartupDelay, and
+  // nothing else runs before it.
+  const bool prune_only =
+      !startup_prune_time_.is_null() && now < startup_run_time_;
+  startup_prune_time_ = base::Time();
+  if (!prune_only) {
+    startup_run_time_ = base::Time();
+  }
+  if (restore_offer_ && now >= OfferLapseTime()) {
+    // Nobody answered. It lapses as if dismissed; the pre-reset copy stays.
+    SetRestoreOffer(std::nullopt);
+  }
+  std::optional<std::pair<std::string, base::DictValue>> daily;
+  bool daily_attempted = false;
+  // An import, Undo, or restore schedules a daily for when it ends.
+  if (!prune_only && !operation_running_ && DailyDueTime() <= now) {
+    if (IsLiveEmpty()) {
+      // Never back up an empty sidebar, and don't wake up to check again.
+      WaitForSidebarData();
+    } else {
+      daily_attempted = true;
+      base::DictValue file = MakeFile(kKindDaily, std::string_view(), now);
+      file.Set(kPrefsKey, CapturePrefs());
+      daily.emplace(DailyId(now), std::move(file));
+    }
+  }
+  // Always prunes, so a snapshot expires on time even if a crash lost the
+  // in-memory expiry.
+  PostFileTask(base::BindOnce(&DoScheduledWork, dir_, std::move(daily), now,
+                              PinnedSnapshots()),
+               base::BindOnce(&DataBackups::DidRunScheduledWork,
+                              weak_factory_.GetWeakPtr(), daily_attempted));
+}
+
+void DataBackups::DidRunScheduledWork(bool daily_attempted, FileWork result) {
+  if (result.daily_written) {
+    prefs_->SetTime(kLastDailyPref, *result.daily_written);
+    daily_soon_ = base::Time();
+    daily_retry_ = base::Time();
+  } else if (daily_attempted) {
+    daily_retry_ = Now() + kRetryDelay;
+  }
+  DidPrune(std::move(result));
+}
+
+void DataBackups::DidCreateSnapshot(SnapshotCallback done, FileWork result) {
+  std::optional<std::string> id = result.snapshot_written;
+  DidPrune(std::move(result));
+  std::move(done).Run(std::move(id));
+}
+
+void DataBackups::DidPrune(FileWork result) {
+  next_expiry_ = result.next_expiry;
+  // Drop pins on snapshots that are gone. Replies arrive in the order their
+  // tasks ran, so a snapshot pinned after it was written is never dropped by
+  // an older prune.
+  const base::ListValue& pinned = prefs_->GetList(kPinnedSnapshotsPref);
+  if (!pinned.empty()) {
+    const base::flat_set<std::string> existing(result.snapshot_ids);
+    base::ListValue kept;
+    for (const base::Value& id : pinned) {
+      if (id.is_string() && existing.contains(id.GetString())) {
+        kept.Append(id.Clone());
+      }
+    }
+    if (kept.size() != pinned.size()) {
+      prefs_->SetList(kPinnedSnapshotsPref, std::move(kept));
+    }
+  }
+  ScheduleWork(kMinRunInterval);
+}
+
+void DataBackups::WaitForSidebarData() {
+  if (!sidebar_watch_.IsEmpty()) {
+    return;
+  }
+  const base::RepeatingClosure changed = base::BindRepeating(
+      &DataBackups::OnSidebarPrefChanged, base::Unretained(this));
+  sidebar_watch_.Add(kSpacesPref, changed);
+  sidebar_watch_.Add(kSidebarListsPref, changed);
+}
+
+void DataBackups::OnSidebarPrefChanged() {
+  if (IsLiveEmpty()) {
+    return;
+  }
+  sidebar_watch_.RemoveAll();
+  ScheduleWork(kMinRunInterval);
+}
+
+void DataBackups::EndOperation(bool data_changed) {
+  operation_running_ = false;
+  if (data_changed) {
+    daily_soon_ = Now() + kDailyAfterChangeDelay;
+    sidebar_watch_.RemoveAll();
+  }
+  if (restore_offer_) {
+    NotifyOfferObservers();
+  }
+  ScheduleWork(kMinRunInterval);
+}
+
+}  // namespace rac

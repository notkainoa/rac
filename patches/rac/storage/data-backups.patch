+  DataBackups::RestoreOffer offer;
+  offer.backup_id = "prereset-20261027T130501123Z";
+  offer.created = base::Time::UnixEpoch() + base::Days(3);
+  offer.detected = base::Time::UnixEpoch() + base::Days(4);
+
+  base::DictValue old_build = offer.ToDict();
+  ASSERT_TRUE(old_build.Remove("space_list"));
+  std::optional<DataBackups::RestoreOffer> decoded =
+      DataBackups::RestoreOffer::FromDict(old_build);
+  ASSERT_TRUE(decoded);
+  EXPECT_TRUE(decoded->spaces.empty());
+
+  base::ListValue list;
+  for (size_t i = 0; i < DataBackups::kMaxOfferSpaces + 8; ++i) {
+    list.Append(base::DictValue()
+                    .Set("name", "S")
+                    .Set("color1", "not a color")
+                    .Set("mode", "neon"));
+    list.Append("junk");
+  }
+  base::DictValue damaged = offer.ToDict();
+  damaged.Set("space_list", std::move(list));
+  decoded = DataBackups::RestoreOffer::FromDict(damaged);
+  ASSERT_TRUE(decoded);
+  ASSERT_EQ(decoded->spaces.size(), DataBackups::kMaxOfferSpaces);
+  EXPECT_TRUE(decoded->spaces[0].color1.empty());
+  EXPECT_EQ(decoded->spaces[0].mode, DataBackups::SpaceSummary::Mode::kAuto);
+
+  // ToDict also stops at the limit.
+  offer.spaces.assign(DataBackups::kMaxOfferSpaces + 3,
+                      DataBackups::SpaceSummary{.name = "S"});
+  EXPECT_EQ(offer.ToDict().FindList("space_list")->size(),
+            DataBackups::kMaxOfferSpaces);

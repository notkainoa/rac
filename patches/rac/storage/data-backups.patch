+// static
+void DataBackups::RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kInitializedPref, false);
+  registry->RegisterTimePref(kLastDailyPref, base::Time());
+  registry->RegisterDictionaryPref(kRestoreOfferPref);
+  registry->RegisterListPref(kPinnedSnapshotsPref);
+}
+
+// static
+DataBackups::Counts DataBackups::Count(const base::Value* spaces,
+                                       const base::Value* sidebar_lists) {
+  Counts counts;
+  if (const base::ListValue* list = FindSpacesList(spaces)) {
+    counts.spaces = static_cast<size_t>(std::ranges::count_if(*list, &IsSpace));
+  }
+  ForEachSidebarList(sidebar_lists, [&](std::string_view key,
+                                        const base::ListValue& entries) {
+    size_t items = 0;
+    for (const base::Value& entry : entries) {
+      const base::DictValue* dict = entry.GetIfDict();
+      if (!dict) {
+        continue;
+      }
+      // A folder holds items; anything else is an item.
+      if (const base::ListValue* folder = dict->FindList(kFolderItemsKey)) {
+        items += static_cast<size_t>(std::ranges::count_if(
+            *folder, [](const base::Value& item) { return item.is_dict(); }));
+      } else {
+        ++items;
+      }
+    }
+    if (key == kFavoritesList) {
+      counts.favorites += items;
+    } else if (base::StartsWith(key, kPinnedListPrefix)) {
+      counts.pinned_tabs += items;
+    }
+  });
+  return counts;
+}
+
+// static
+std::vector<DataBackups::SpaceSummary> DataBackups::SummarizeSpaces(
+    const base::Value* spaces) {
+  std::vector<SpaceSummary> summaries;
+  const base::ListValue* list = FindSpacesList(spaces);
+  if (!list) {
+    return summaries;
+  }
+  summaries.reserve(std::min(list->size(), kMaxOfferSpaces));
+  for (const base::Value& entry : *list) {
+    if (summaries.size() >= kMaxOfferSpaces) {
+      break;
+    }
+    if (!IsSpace(entry)) {
+      continue;
+    }
+    const base::DictValue& space = entry.GetDict();
+    SpaceSummary summary;
+    summary.name = BoundName(space.FindString(kSpaceNameKey));
+    summary.emoji = BoundEmoji(space.FindString(kSpaceIconKey));
+    if (const base::DictValue* theme = space.FindDict(kSpaceThemeKey)) {
+      summary.color1 = ValidColor(theme->FindString(kThemeColor1Key));
+      summary.color2 = ValidColor(theme->FindString(kThemeColor2Key));
+      summary.mode = ParseMode(theme->FindString(kThemeModeKey));
+    }
+    summaries.push_back(std::move(summary));
+  }
+  return summaries;
+}
+
+// static
+bool DataBackups::IsEmpty(const base::Value* spaces,
+                          const base::Value* sidebar_lists) {
+  // An empty folder is something the user made too.
+  bool has_entries = false;
+  ForEachSidebarList(sidebar_lists,
+                     [&](std::string_view, const base::ListValue& entries) {
+                       has_entries |= !entries.empty();
+                     });
+  if (has_entries) {
+    return false;
+  }
+  const base::ListValue* list = FindSpacesList(spaces);
+  if (!list) {
+    return true;
+  }
+  const base::DictValue* only_space = nullptr;
+  for (const base::Value& entry : *list) {
+    if (!IsSpace(entry)) {
+      continue;
+    }
+    if (only_space) {
+      return false;
+    }
+    only_space = &entry.GetDict();
+  }
+  if (!only_space) {
+    return true;
+  }
+  const std::string* name = only_space->FindString(kSpaceNameKey);
+  const std::string* icon = only_space->FindString(kSpaceIconKey);
+  return (!name || name->empty()) && (!icon || icon->empty());
+}
+
+void DataBackups::CreateSnapshot(std::string_view reason,
+                                 SnapshotCallback done) {
+  if (!IsValidReason(reason)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), std::nullopt));
+    return;
+  }
+  const base::Time now = Now();
+  const base::Time created =
+      std::max(now, last_snapshot_time_ + base::Milliseconds(1));
+  last_snapshot_time_ = created;
+
+  base::DictValue file = MakeFile(kKindSnapshot, reason, created);
+  file.Set(kPrefsKey, CapturePrefs());
+
+  // For this session only. If the browser quits first, the prune at the next
+  // launch's kStartupPruneDelay deletes it.
+  const base::Time expiry = created + kSnapshotLifetime;
+  next_expiry_ = next_expiry_ ? std::min(*next_expiry_, expiry) : expiry;
+
+  std::string id = SnapshotId(created, reason);
+  base::flat_set<std::string> pinned = PinnedSnapshots();
+  pinned.insert(id);
+  PostFileTask(base::BindOnce(&WriteSnapshot, profile_dir_, dir_,
+                              std::move(id), std::move(file), now,
+                              std::move(pinned)),
+               base::BindOnce(&DataBackups::DidCreateSnapshot,
+                              weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void DataBackups::ReadBackup(std::string_view id, ReadCallback done) {
+  if (!ParseBackupId(id)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), std::nullopt));
+    return;
+  }
+  PostFileTask(base::BindOnce(&ReadBackupFile, dir_, std::string(id), Now()),
+               std::move(done));
+}
+
+void DataBackups::ReadOfferedBackup(ReadCallback done) {
+  if (!restore_offer_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), std::nullopt));
+    return;
+  }
+  PostFileTask(base::BindOnce(&ReadOfferedBackupFile, dir_,
+                              restore_offer_->backup_id, Now()),
+               std::move(done));
+}
+
+void DataBackups::DeleteSnapshot(std::string_view id) {
+  if (!IsSnapshotId(id)) {
+    return;
+  }
+  UnpinSnapshot(id);
+  PostFileTask(base::BindOnce(&DeleteSnapshotFile, dir_, std::string(id),
+                              Now(), PinnedSnapshots()),
+               base::BindOnce(&DataBackups::DidPrune,
+                              weak_factory_.GetWeakPtr()));
+}
+
+void DataBackups::PinSnapshot(std::string_view id) {
+  if (!IsSnapshotId(id) || PinnedSnapshots().contains(id)) {
+    return;
+  }
+  base::ListValue pinned = prefs_->GetList(kPinnedSnapshotsPref).Clone();
+  pinned.Append(id);
+  prefs_->SetList(kPinnedSnapshotsPref, std::move(pinned));
+}
+
+void DataBackups::UnpinSnapshot(std::string_view id) {
+  base::ListValue pinned = prefs_->GetList(kPinnedSnapshotsPref).Clone();
+  if (pinned.EraseValue(base::Value(id)) > 0) {
+    prefs_->SetList(kPinnedSnapshotsPref, std::move(pinned));
+  }
+}

+namespace rac {
+
+namespace backups_internal {
+struct ResetCheck;
+struct FileWork;
+}  // namespace backups_internal
+
+// Copies of the profile's sidebar data, in `<profile>/rac backups/`, so an
+// import, a migration, or a lost or corrupt `Preferences` can't lose it.
+//
+// - A snapshot is taken on request, before an import or a migration. It
+//   holds the backed-up prefs and the hidden spaces' tabs from `rac spaces`.
+//   It's deleted kSnapshotLifetime after it was taken, which is also how long
+//   "Undo import" lasts, so open-tab URLs are never kept longer than that.
+// - Daily backups hold the backed-up prefs only: spaces, themes, pinned tabs,
+//   favorites, and agent site rules. No open tabs. The newest
+//   kDailyGenerations are kept, and none past kDailyLifetime.
+// - Pre-reset copies. When `Preferences` turns out to have been reset (see
+//   kInitializedPref), every daily backup is renamed to a pre-reset copy and
+//   kept kPreResetLifetime, so nothing written after the reset can replace
+//   it. Prefs only, like the dailies.
+//
+// Nothing is ever restored silently. After a reset, the service offers the
+// newest backup with data in it (see RestoreOffer) and the UI asks. The
+// restore itself goes through SpacesService and SidebarItems, in
+// DataRestorer, because they keep the live copy of this data.
+//
+// While the live data is fine, deciding takes no file work: everything the
+// service needs is already in prefs. The only file task before the first
+// full run is the early prune at kStartupPruneDelay. All methods must be
+// called on the UI thread. Files are read and written on a background
+// sequence.
+class DataBackups : public KeyedService {
+ public:
+  // The newest format this build writes, and the oldest build that can read
+  // it. Builds only ever raise them. A file whose `min_reader_version` is
+  // above kVersion is ignored.
+  static constexpr int kVersion = 1;
+  static constexpr int kMinReaderVersion = 1;
+
+  // Snapshots hold open-tab URLs, so they never live longer than this. It's
+  // also the Undo window; `apply` reads this constant.
+  static constexpr base::TimeDelta kSnapshotLifetime = base::Days(7);
+  // Pre-reset copies hold prefs only, so they can stay long enough for the
+  // user to notice what a reset lost.
+  static constexpr base::TimeDelta kPreResetLifetime = base::Days(30);
+  static constexpr base::TimeDelta kDailyInterval = base::Days(1);
+  // Daily backups kept, newest first. About this many days of history.
+  static constexpr size_t kDailyGenerations = 3;
+  // No daily backup is kept past this, however few are left.
+  static constexpr base::TimeDelta kDailyLifetime = base::Days(30);
+  // How long an unanswered restore offer stays. The backup it points at is a
+  // pre-reset copy, which outlives it.
+  static constexpr base::TimeDelta kRestoreOfferLifetime = base::Days(7);
+  // An even earlier run that only prunes, so an expired file is gone seconds
+  // after launch instead of minutes.
+  static constexpr base::TimeDelta kStartupPruneDelay = base::Seconds(10);
+  // Scheduled work's first full run is this long after the service is
+  // created, so it never competes with startup. Every run prunes expired
+  // files; this one also takes the daily backup.
+  static constexpr base::TimeDelta kStartupDelay = base::Minutes(2);
+  // After an import or a restore, the daily backup is refreshed this soon.
+  static constexpr base::TimeDelta kDailyAfterChangeDelay = base::Minutes(1);
+  // Unpinned snapshots beyond this are deleted early, oldest first.
+  static constexpr size_t kMaxSnapshots = 8;
+  // A backup dated more than this in the future means the clock moved back.
+  // Its lifetime then starts now, so it still ends, and Undo isn't wiped.
+  static constexpr base::TimeDelta kClockSkewAllowance = base::Days(1);
+
+  static constexpr char kDirName[] = "rac backups";
+
+  // The prefs a backup holds. Each is owned elsewhere; DataBackups only reads
+  // their stored values, so backing up the agent rules creates no AI state.
+  // data_backups_pref_names_unittest.cc static_asserts the names it can see.
+  static constexpr char kSpacesPref[] = "rac.spaces";
+  // Must match kListsPref in chrome/browser/ui/rac/sidebar/sidebar_items.cc.
+  static constexpr char kSidebarListsPref[] = "rac.sidebar.lists";
+  static constexpr char kAgentSiteRulesPref[] = "rac.ai.agent_site_rules";
+  static constexpr char kAgentPermissionLevelPref[] =
+      "rac.ai.agent_permission_level";
+  // Agent pref values a merge restore compares, so it only ever tightens.
+  static constexpr char kAgentPermissionAsk[] = "ask";
+  static constexpr char kAgentPermissionCareful[] = "careful";
+  static constexpr char kAgentSiteNever[] = "never";
+  static constexpr std::array<const char*, 4> kBackedUpPrefs = {
+      kSpacesPref, kSidebarListsPref, kAgentSiteRulesPref,
+      kAgentPermissionLevelPref};
+
+  // This service's own prefs. All of them live in `Preferences`, so a reset
+  // clears them together with the data they describe.
+  //
+  // True once this `Preferences` has been checked against the backups
+  // folder. Unset while backup files exist means `Preferences` was reset,
+  // whatever the cause: corrupt, deleted, or unreadable. A new profile has no
+  // backup files, so it's never mistaken for one.
+  static constexpr char kInitializedPref[] = "rac.backups.initialized";
+  // When the newest daily backup was written.
+  static constexpr char kLastDailyPref[] = "rac.backups.last_daily";
+  // The pending restore offer, as RestoreOffer::ToDict(). Unset when none.
+  static constexpr char kRestoreOfferPref[] = "rac.backups.restore_offer";
+  // Snapshot ids the kMaxSnapshots cap must not delete, such as the one a
+  // pending "Undo import" needs. They still expire.
+  static constexpr char kPinnedSnapshotsPref[] = "rac.backups.pinned_snapshots";
+
+  enum class Kind { kDaily, kPreReset, kSnapshot };
+
+  // How much a backup holds, for the restore prompt's text.
+  struct Counts {
+    size_t spaces = 0;
+    size_t pinned_tabs = 0;
+    size_t favorites = 0;
+
+    bool operator==(const Counts&) const = default;
+  };
+
+  // A decoded backup file.
+  struct Contents {
+    Contents();
+    Contents(Contents&&);
+    Contents& operator=(Contents&&);
+    ~Contents();
+
+    std::string id;
+    Kind kind = Kind::kDaily;
+    base::Time created;
+    // Why the snapshot was taken, such as "import-arc". A pre-reset copy of a
+    // snapshot keeps it. Empty for daily backups.
+    std::string reason;
+    // Pref name -> the value it had. A pref missing here had its default
+    // value, so an exact restore clears it.
+    base::DictValue prefs;
+    // `rac spaces` as it was on disk. Snapshots only, and only if the file
+    // existed. Without it, a restore leaves stored tabs alone.
+    std::optional<base::DictValue> spaces_store;
+    Counts counts;
+  };
+
+  // What the restore prompt shows for one space in the offered backup. Taken
+  // from the stored form in `rac.spaces`, so it holds no ids, tabs, or other
+  // fields.
+  struct SpaceSummary {
+    enum class Mode { kAuto, kLight, kDark };
+
+    // Cut to kMaxSummaryNameBytes on a character boundary. Empty for a space
+    // the user never named; the UI shows its usual fallback.
+    std::string name;
+    // The space's emoji, or empty if it shows a dot. Dropped, not cut, if it's
+    // over kMaxSummaryEmojiBytes.
+    std::string emoji;
+    // "#RRGGBB" as stored, or empty if the backup had none or a malformed one.
+    std::string color1;
+    std::string color2;
+    Mode mode = Mode::kAuto;
+
+    bool operator==(const SpaceSummary&) const = default;
+  };
+
+  // The offer lists at most this many spaces, in their stored order.
+  // `Counts::spaces` still counts all of them.
+  static constexpr size_t kMaxOfferSpaces = 12;
+  static constexpr size_t kMaxSummaryNameBytes = 64;
+  static constexpr size_t kMaxSummaryEmojiBytes = 32;
+
+  // "Restore your spaces from <created>." Made once, when a reset is found
+  // and a backup with data exists. It doesn't wait for an empty sidebar,
+  // because restoring merges with what's there. It points at a pre-reset
+  // copy, which outlives the offer. The UI shows it while
+  // ShouldShowRestoreOffer().
+  struct RestoreOffer {
+    std::string backup_id;
+    base::Time created;
+    Counts counts;
+    // The first kMaxOfferSpaces spaces of the backup. Built on the background
+    // sequence with the offer, and kept with it in prefs, so showing the
+    // prompt reads no file. An offer stored by an older build has none.
+    std::vector<SpaceSummary> spaces;
+    // When the reset was found. The offer lapses kRestoreOfferLifetime later.
+    base::Time detected;
+
+    base::DictValue ToDict() const;
+    static std::optional<RestoreOffer> FromDict(const base::DictValue& dict);
+  };
+
+  // Import, Undo, and restore each hold one of these for their whole run, so
+  // they never overlap. Destroying it ends the operation.
+  class Operation {
+   public:
+    Operation(const Operation&) = delete;
+    Operation& operator=(const Operation&) = delete;
+    ~Operation();
+
+    // The sidebar data was changed, by an import or a restore. The daily
+    // backup is refreshed kDailyAfterChangeDelay after the operation ends.
+    void MarkDataChanged() { data_changed_ = true; }
+
+   private:
+    friend class DataBackups;
+    explicit Operation(base::WeakPtr<DataBackups> owner);
+
+    base::WeakPtr<DataBackups> owner_;
+    bool data_changed_ = false;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // The offer appeared, was answered, or lapsed, or ShouldShowRestoreOffer()
+    // changed because an operation started or ended.
+    virtual void OnRestoreOfferChanged() = 0;
+  };
+
+  // Runs with the new snapshot's id, or nullopt if it couldn't be written.
+  // An import must not start without one. Not run if the service is
+  // destroyed first, which happens only when the profile goes away.
+  using SnapshotCallback =
+      base::OnceCallback<void(std::optional<std::string> id)>;
+  using ReadCallback = base::OnceCallback<void(std::optional<Contents>)>;
+
+  // `profile_dir` holds `Preferences` and `rac spaces`. `clock` is for tests;
+  // null means the real clock.
+  DataBackups(PrefService* prefs,
+              base::FilePath profile_dir,
+              const base::Clock* clock = nullptr);
+  DataBackups(const DataBackups&) = delete;
+  DataBackups& operator=(const DataBackups&) = delete;
+  ~DataBackups() override;
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  // True if `spaces` and `sidebar_lists` (stored values of kSpacesPref and
+  // kSidebarListsPref, null if unset) hold nothing a user made: at most one
+  // space with no name and no icon, and no favorites or pinned tabs. That's
+  // what a new profile, or one whose `Preferences` was reset, looks like.
+  static bool IsEmpty(const base::Value* spaces,
+                      const base::Value* sidebar_lists);
+  static Counts Count(const base::Value* spaces,
+                      const base::Value* sidebar_lists);
+  // Summaries of the first kMaxOfferSpaces spaces in `spaces` (a stored value
+  // of kSpacesPref, null if unset), skipping entries that aren't spaces.
+  // Touches only what it returns, so it's cheap enough for the background
+  // sequence and safe on any thread.
+  static std::vector<SpaceSummary> SummarizeSpaces(const base::Value* spaces);
+
+  // Snapshots the backed-up prefs now, as they are at this call, then copies
+  // `rac spaces` and writes the file on the background sequence. A caller
+  // that changes prefs right after, such as a migration, doesn't need to
+  // wait. A caller that changes `rac spaces` must flush that store first and
+  // wait for `done`. `reason` is 1-32 of [a-z0-9-].
+  void CreateSnapshot(std::string_view reason, SnapshotCallback done);
+
+  // Reads any backup by id. Runs with nullopt if it's missing, expired,
+  // unreadable, or too new for this build.
+  void ReadBackup(std::string_view id, ReadCallback done);
+
+  // Reads the backup the pending offer points at. If that one can't be read,
+  // falls back to the newest other pre-reset copy or snapshot with data in
+  // it. Runs with nullopt if there's no offer or nothing usable.
+  void ReadOfferedBackup(ReadCallback done);
+
+  // Deletes a snapshot early, for example once its import can no longer be
+  // undone, and unpins it. Does nothing for other kinds or unknown ids.
+  void DeleteSnapshot(std::string_view id);
+
+  // Keeps the kMaxSnapshots cap from deleting a snapshot that a pending Undo
+  // needs. It still expires after kSnapshotLifetime.
+  void PinSnapshot(std::string_view id);
+  void UnpinSnapshot(std::string_view id);
+
+  // Starts an import, Undo, or restore. Returns null while another one is
+  // running. The restore offer is hidden while one runs.
+  std::unique_ptr<Operation> TryBeginOperation();
+  bool operation_running() const { return operation_running_; }
+
+  // The pending offer, or nullopt.
+  const std::optional<RestoreOffer>& restore_offer() const {
+    return restore_offer_;
+  }
+  // Whether the UI should show the offer now: one is pending and no import,
+  // Undo, or restore is running.
+  bool ShouldShowRestoreOffer() const {
+    return restore_offer_.has_value() && !operation_running_;
+  }
+  // Call only when the user dismissed the offer, or after DataRestorer
+  // restored it successfully. Never after a failed restore: the offer stays.
+  void ResolveRestoreOffer();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Runs the scheduled work now instead of waiting for its timer.
+  void RunScheduledWorkForTesting();
+  // Runs `done` after every file task posted so far has finished and its
+  // reply has run.
+  void FlushForTesting(base::OnceClosure done);
+  // How many tasks were posted to the background sequence.
+  size_t file_tasks_posted_for_testing() const { return file_tasks_posted_; }
+  // Whether a timer will wake the service.
+  bool HasScheduledWorkForTesting() const { return timer_.IsRunning(); }
+
+ private:
+  base::Time Now() const;
+  base::DictValue CapturePrefs() const;
+  bool IsLiveEmpty() const;
+  base::flat_set<std::string> PinnedSnapshots() const;
+
+  // Posts `task` to the background sequence and `reply` back to this one,
+  // dropped if the service is gone.
+  template <typename Result>
+  void PostFileTask(base::OnceCallback<Result()> task,
+                    base::OnceCallback<void(Result)> reply);
+
+  void DidCheckForReset(backups_internal::ResetCheck result);
+  void SetRestoreOffer(std::optional<RestoreOffer> offer);
+  void NotifyOfferObservers();
+  base::Time OfferLapseTime() const;
+
+  // Schedules RunScheduledWork() for when something is next due, and never
+  // sooner than `min_delay` from now. Stops the timer when nothing is due.
+  void ScheduleWork(base::TimeDelta min_delay);
+  base::Time DailyDueTime() const;
+  void RunScheduledWork();
+  void DidRunScheduledWork(bool daily_attempted,
+                           backups_internal::FileWork result);
+  void DidCreateSnapshot(SnapshotCallback done,
+                         backups_internal::FileWork result);
+  // Takes the next expiry from a prune, drops pins on deleted snapshots, and
+  // reschedules.
+  void DidPrune(backups_internal::FileWork result);
+
+  // While the live sidebar is empty, no daily backup is due and nothing
+  // wakes the service for one. A change to the sidebar prefs ends the wait.
+  void WaitForSidebarData();
+  void OnSidebarPrefChanged();
+
+  void EndOperation(bool data_changed);
+
+  const raw_ptr<PrefService> prefs_;
+  const base::FilePath profile_dir_;
+  const base::FilePath dir_;
+  const raw_ptr<const base::Clock> clock_;
+  const scoped_refptr<base::SequencedTaskRunner> task_runner_;
+
+  std::optional<RestoreOffer> restore_offer_;
+  bool operation_running_ = false;
+  // Keeps snapshot ids unique when two are taken in the same millisecond.
+  base::Time last_snapshot_time_;
+  // The first full scheduled run. Null once it has run.
+  base::Time startup_run_time_;
+  // The earlier prune-only run. While it's pending it's the next due time,
+  // and a run before startup_run_time_ only prunes. Null once it has run.
+  base::Time startup_prune_time_;
+  // When the next pre-reset copy or snapshot expires, from the last prune.
+  std::optional<base::Time> next_expiry_;
+  // A daily backup due sooner than usual, after an import or a restore.
+  base::Time daily_soon_;
+  // A daily backup that failed waits until then.
+  base::Time daily_retry_;
+  PrefChangeRegistrar sidebar_watch_;
+  size_t file_tasks_posted_ = 0;
+  // A wall-clock timer, so a Mac that sleeps overnight still backs up daily.
+  base::WallClockTimer timer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<DataBackups> weak_factory_{this};
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_DATA_BACKUPS_H_

+
+// DataBackups names the prefs it copies itself, so the browser needs no code
+// from their owners, and none from AI. Catch a rename here, at compile time.
+// rac.sidebar.lists is private to SidebarItems, so its name is checked by
+// hand.
+static_assert(std::string_view(DataBackups::kSpacesPref) == kSpaces);
+static_assert(std::string_view(DataBackups::kAgentSiteRulesPref) ==
+              ai::kAgentSiteRules);
+static_assert(std::string_view(DataBackups::kAgentPermissionLevelPref) ==
+              ai::kAgentPermissionLevel);
+static_assert(std::string_view(DataBackups::kAgentPermissionAsk) ==
+              ai::kAgentPermissionAsk);
+static_assert(std::string_view(DataBackups::kAgentPermissionCareful) ==
+              ai::kAgentPermissionCareful);
+static_assert(std::string_view(DataBackups::kAgentSiteNever) ==
+              ai::kAgentSiteNever);
+
+}  // namespace

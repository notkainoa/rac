+#if BUILDFLAG(IS_POSIX)
+// Only the user can open the backups folder or read a backup, daily or
+// snapshot. The files are never chmod'ed after the write; they're private
+// from the start.
+TEST_F(DataBackupsTest, FilesArePrivate) {
+  SetUserData();
+  std::unique_ptr<DataBackups> backups = Make();
+  std::optional<std::string> id = TakeSnapshot(*backups, kImportReason);
+  ASSERT_TRUE(id);
+  FastForward(DataBackups::kStartupDelay);
+  ASSERT_EQ(Ids("daily-").size(), 1u);
+
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  int dir_mode = 0;
+  ASSERT_TRUE(base::GetPosixFilePermissions(BackupsDir(), &dir_mode));
+  EXPECT_EQ(dir_mode & base::FILE_PERMISSION_MASK,

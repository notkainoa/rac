+                                 base::Hours(1));
+
+  std::unique_ptr<DataBackups> backups = Make();
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(FileExists(BackupFile(*id)));
+  FastForward(DataBackups::kStartupPruneDelay + base::Seconds(1));

--- /dev/null
+++ src/chrome/browser/rac/storage/restore_plan_unittest.cc
@@ -0,0 +1,458 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/restore_plan.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/test/values_test_util.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+using Ids = std::vector<std::string>;
+
+// {"version":1,"spaces":[{"id":"s1","name":"Work"}, ...]}. An empty name
+// leaves the name out, like a space the user never named.
+base::DictValue MakeSpacesPref(
+    const std::vector<std::pair<std::string, std::string>>& id_and_name) {
+  base::ListValue spaces;
+  for (const auto& [id, name] : id_and_name) {
+    base::DictValue space;
+    space.Set("id", id);
+    if (!name.empty()) {
+      space.Set("name", name);
+    }
+    spaces.Append(std::move(space));
+  }
+  return base::DictValue().Set("version", 1).Set("spaces", std::move(spaces));
+}
+
+// Backup prefs that hold only a spaces pref.
+base::DictValue MakePrefs(
+    const std::vector<std::pair<std::string, std::string>>& id_and_name) {
+  return base::DictValue().Set(DataBackups::kSpacesPref,
+                               MakeSpacesPref(id_and_name));
+}
+
+// {"entries":[{"id":"<id>", ...}, ...]}: one sidebar list.
+base::DictValue MakeEntries(const std::vector<std::string>& ids,
+                            const std::string& title = "T") {
+  base::ListValue entries;
+  for (const std::string& id : ids) {
+    entries.Append(base::DictValue()
+                       .Set("id", id)
+                       .Set("url", "https://a.test/")
+                       .Set("title", title));
+  }
+  return base::DictValue().Set("entries", std::move(entries));
+}
+
+// {"version":1,"spaces":{"<id>":{"tabs":[...]}}}, like `rac spaces`.
+base::DictValue MakeStore(const std::vector<std::string>& ids_with_tabs) {
+  base::DictValue spaces;
+  for (const std::string& id : ids_with_tabs) {
+    spaces.Set(id, base::test::ParseJsonDict(
+                       R"({"tabs":[{"url":"https://t.test/"}]})"));
+  }
+  return base::DictValue().Set("version", 1).Set("spaces", std::move(spaces));
+}
+
+DataBackups::Contents MakeBackup(base::DictValue prefs) {
+  DataBackups::Contents backup;
+  backup.prefs = std::move(prefs);
+  return backup;
+}
+
+LiveSidebar MakeLive(base::DictValue prefs) {
+  LiveSidebar live;
+  live.prefs = std::move(prefs);
+  return live;
+}
+
+Ids IdsOf(const std::vector<base::DictValue>& spaces) {
+  Ids ids;
+  for (const base::DictValue& space : spaces) {
+    const std::string* id = space.FindString("id");
+    ids.push_back(id ? *id : std::string());
+  }
+  return ids;
+}
+
+Ids StoredIdsOf(
+    const std::vector<std::pair<std::string, base::DictValue>>& stored) {
+  Ids ids;
+  for (const auto& [id, tabs] : stored) {
+    ids.push_back(id);
+  }
+  return ids;
+}
+
+// The entry ids in list `key` of a sidebar lists value; empty if it has none.
+Ids EntryIds(const std::optional<base::Value>& lists, const std::string& key) {
+  Ids ids;
+  const base::DictValue* list =
+      lists && lists->is_dict() ? lists->GetDict().FindDict(key) : nullptr;
+  const base::ListValue* entries = list ? list->FindList("entries") : nullptr;
+  if (entries) {
+    for (const base::Value& entry : *entries) {
+      ids.push_back(*entry.GetDict().FindString("id"));
+    }
+  }
+  return ids;
+}
+
+// The permission level a restore picks, or nullopt if it clears the pref.
+std::optional<std::string> RestoredLevel(
+    const std::optional<std::string>& backup_level,
+    const std::optional<std::string>& live_level,
+    RestoreMode mode) {
+  DataBackups::Contents backup;
+  LiveSidebar live;
+  if (backup_level) {
+    backup.prefs.Set(DataBackups::kAgentPermissionLevelPref, *backup_level);
+  }
+  if (live_level) {
+    live.prefs.Set(DataBackups::kAgentPermissionLevelPref, *live_level);
+  }
+  RestorePlan plan = MakeRestorePlan(backup, live, mode);
+  if (!plan.agent_permission_level) {
+    return std::nullopt;
+  }
+  return plan.agent_permission_level->GetString();
+}
+
+RestorePlan RestoredRules(base::DictValue backup_rules,
+                          base::DictValue live_rules,
+                          RestoreMode mode) {
+  DataBackups::Contents backup;
+  backup.prefs.Set(DataBackups::kAgentSiteRulesPref, std::move(backup_rules));
+  LiveSidebar live;
+  live.prefs.Set(DataBackups::kAgentSiteRulesPref, std::move(live_rules));
+  return MakeRestorePlan(backup, live, mode);
+}
+
+// A backup with no `rac spaces` says nothing about stored tabs, so a merge
+// leaves them, and so does an exact restore.
+TEST(RestorePlanTest, MergeWithoutSpacesStoreLeavesStoredTabsAlone) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}, {"s2", "Play"}}));
+  ASSERT_FALSE(backup.spaces_store.has_value());
+  LiveSidebar live;
+  live.spaces_with_stored_tabs.insert("s1");
+  live.spaces_with_stored_tabs.insert("s2");
+
+  RestorePlan merge = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  EXPECT_TRUE(merge.restore_stored_tabs.empty());
+  EXPECT_TRUE(merge.remove_stored_tabs.empty());
+
+  RestorePlan exact = MakeRestorePlan(backup, live, RestoreMode::kExact);
+  EXPECT_TRUE(exact.restore_stored_tabs.empty());
+  EXPECT_TRUE(exact.remove_stored_tabs.empty());
+
+  // A store with no spaces dict says nothing either.
+  backup.spaces_store = base::DictValue().Set("version", 1);
+  exact = MakeRestorePlan(backup, live, RestoreMode::kExact);
+  EXPECT_TRUE(exact.remove_stored_tabs.empty());
+}
+
+// A merge brings back stored tabs the backup has, but never overwrites the
+// live ones and never drops a space's stored tabs.
+TEST(RestorePlanTest, MergeNeverRemovesStoredTabs) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}, {"s2", "Play"}}));
+  backup.spaces_store = MakeStore({"s1"});
+
+  LiveSidebar live;
+  live.spaces_with_stored_tabs.insert("s2");
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  EXPECT_TRUE(plan.remove_stored_tabs.empty());
+  EXPECT_EQ(StoredIdsOf(plan.restore_stored_tabs), Ids({"s1"}));
+
+  // The live stored tabs of s1 aren't clobbered by the backup's.
+  live.spaces_with_stored_tabs.insert("s1");
+  plan = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  EXPECT_TRUE(plan.remove_stored_tabs.empty());
+  EXPECT_TRUE(plan.restore_stored_tabs.empty());
+}
+
+// An exact restore of a backup with `rac spaces` makes stored tabs match it:
+// restored where the backup has them, removed where it doesn't. A space open
+// in a window is left as it is.
+TEST(RestorePlanTest, ExactRemovesStoredTabsOnlyWithSpacesStore) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}, {"s2", "Play"}}));
+  backup.spaces_store = MakeStore({"s1"});
+
+  LiveSidebar live;
+  live.spaces_with_stored_tabs.insert("s2");
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kExact);
+  EXPECT_EQ(plan.remove_stored_tabs, Ids({"s2"}));
+  ASSERT_EQ(plan.restore_stored_tabs.size(), 1u);
+  EXPECT_EQ(plan.restore_stored_tabs[0].first, "s1");
+  EXPECT_EQ(plan.restore_stored_tabs[0].second,
+            *backup.spaces_store->FindDict("spaces")->FindDict("s1"));
+
+  // Both spaces have their tabs open in a window now.
+  live.spaces_with_window_tabs.insert("s1");
+  live.spaces_with_window_tabs.insert("s2");
+  plan = MakeRestorePlan(backup, live, RestoreMode::kExact);
+  EXPECT_TRUE(plan.restore_stored_tabs.empty());
+  EXPECT_TRUE(plan.remove_stored_tabs.empty());
+}
+
+// An exact restore deletes spaces made since the backup and doesn't move
+// their tabs anywhere. The spaces come out in the backup's order.
+TEST(RestorePlanTest, ExactDeletesSpacesNotInBackup) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}, {"s2", "Play"}}));
+  LiveSidebar live = MakeLive(base::DictValue().Set(
+      DataBackups::kSpacesPref, MakeSpacesPref({{"s1", "Work"},
+                                                {"s9", "Since"}})));
+
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kExact);
+  EXPECT_EQ(plan.delete_spaces, Ids({"s9"}));
+  EXPECT_FALSE(plan.move_tabs_from.has_value());
+  EXPECT_TRUE(plan.move_tabs_to.empty());
+  EXPECT_EQ(IdsOf(plan.spaces), Ids({"s1", "s2"}));
+}
+
+// The blank space a reset leaves hands its open tabs to the first restored
+// space and is then deleted, so nothing is closed.
+TEST(RestorePlanTest, MergeMovesPlaceholderTabsIntoFirstRestoredSpace) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}, {"s2", "Play"}}));
+  LiveSidebar live = MakeLive(base::DictValue().Set(
+      DataBackups::kSpacesPref, MakeSpacesPref({{"reset", ""}})));
+
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  ASSERT_TRUE(plan.move_tabs_from.has_value());
+  EXPECT_EQ(*plan.move_tabs_from, "reset");
+  EXPECT_EQ(plan.move_tabs_to, "s1");
+  EXPECT_EQ(plan.delete_spaces, Ids({"reset"}));
+  EXPECT_EQ(IdsOf(plan.spaces), Ids({"s1", "s2"}));
+}
+
+// A merge keeps spaces made since the reset. Only the blank one is the
+// placeholder, and only when there is a restored space to move its tabs to.
+TEST(RestorePlanTest, MergeKeepsSpacesMadeSinceReset) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}, {"s2", "Play"}}));
+  LiveSidebar live = MakeLive(
+      base::DictValue()
+          .Set(DataBackups::kSpacesPref,
+               MakeSpacesPref({{"reset", ""}, {"s9", "New"}}))
+          .Set(DataBackups::kSidebarListsPref,
+               base::DictValue().Set("pinned.s9", MakeEntries({"p9"}))));
+
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  EXPECT_EQ(plan.delete_spaces, Ids({"reset"}));
+  EXPECT_EQ(*plan.move_tabs_from, "reset");
+
+  // An unnamed space with a pinned tab isn't blank, even listed first.
+  live = MakeLive(
+      base::DictValue()
+          .Set(DataBackups::kSpacesPref,
+               MakeSpacesPref({{"s9", ""}, {"reset", ""}}))
+          .Set(DataBackups::kSidebarListsPref,
+               base::DictValue().Set("pinned.s9", MakeEntries({"p9"}))));
+  plan = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  EXPECT_EQ(plan.delete_spaces, Ids({"reset"}));
+  EXPECT_EQ(*plan.move_tabs_from, "reset");
+
+  // With no spaces in the backup, there's nowhere to move tabs, so the blank
+  // space is kept.
+  DataBackups::Contents no_spaces = MakeBackup(base::DictValue());
+  live = MakeLive(base::DictValue().Set(
+      DataBackups::kSpacesPref, MakeSpacesPref({{"reset", ""}})));
+  plan = MakeRestorePlan(no_spaces, live, RestoreMode::kMerge);
+  EXPECT_FALSE(plan.move_tabs_from.has_value());
+  EXPECT_TRUE(plan.delete_spaces.empty());
+}
+
+// A blank space that has stored tabs isn't the placeholder: only open tabs
+// move, and deleting the space would drop the stored ones.
+TEST(RestorePlanTest, MergeKeepsBlankSpaceWithStoredTabs) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}, {"s2", "Play"}}));
+  LiveSidebar live = MakeLive(base::DictValue().Set(
+      DataBackups::kSpacesPref, MakeSpacesPref({{"reset", ""}})));
+  live.spaces_with_stored_tabs.insert("reset");
+
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  EXPECT_FALSE(plan.move_tabs_from.has_value());
+  EXPECT_TRUE(plan.delete_spaces.empty());
+  EXPECT_EQ(IdsOf(plan.spaces), Ids({"s1", "s2"}));
+}
+
+// A merge puts the backup's favorites first and adds the live ones it doesn't
+// have. Live pinned lists stay, and the placeholder's own list is dropped.
+TEST(RestorePlanTest, MergeAppendsLiveSidebarEntries) {
+  DataBackups::Contents backup =
+      MakeBackup(MakePrefs({{"s1", "Work"}}));
+  backup.prefs.Set(
+      DataBackups::kSidebarListsPref,
+      base::DictValue().Set("favorites", MakeEntries({"f1"}, "Backup")));
+  LiveSidebar live = MakeLive(
+      base::DictValue()
+          .Set(DataBackups::kSpacesPref,
+               MakeSpacesPref({{"reset", ""}, {"s9", "New"}}))
+          .Set(DataBackups::kSidebarListsPref,
+               base::DictValue()
+                   .Set("favorites", MakeEntries({"f1", "f2"}, "Live"))
+                   .Set("pinned.s9", MakeEntries({"p9"}))
+                   .Set("pinned.reset", MakeEntries({}))));
+
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kMerge);
+  ASSERT_TRUE(plan.sidebar_lists.has_value());
+  EXPECT_EQ(*plan.move_tabs_from, "reset");
+  EXPECT_EQ(EntryIds(plan.sidebar_lists, "favorites"), Ids({"f1", "f2"}));
+  EXPECT_EQ(EntryIds(plan.sidebar_lists, "pinned.s9"), Ids({"p9"}));
+  EXPECT_EQ(plan.sidebar_lists->GetDict().Find("pinned.reset"), nullptr);
+  // The backup's copy of a shared entry wins.
+  const base::DictValue& first = (*plan.sidebar_lists->GetDict()
+                                       .FindDict("favorites")
+                                       ->FindList("entries"))[0]
+                                     .GetDict();
+  EXPECT_EQ(*first.FindString("title"), "Backup");
+}
+
+// An exact restore makes the lists the backup's, and clears them when the
+// backup had none.
+TEST(RestorePlanTest, ExactSidebarListsAreTheBackups) {
+  base::DictValue backup_lists =
+      base::DictValue().Set("favorites", MakeEntries({"f1"}));
+  DataBackups::Contents backup = MakeBackup(
+      MakePrefs({{"s1", "Work"}}));
+  backup.prefs.Set(DataBackups::kSidebarListsPref, backup_lists.Clone());
+  LiveSidebar live = MakeLive(base::DictValue().Set(
+      DataBackups::kSidebarListsPref,
+      base::DictValue()
+          .Set("favorites", MakeEntries({"f1", "f2"}))
+          .Set("pinned.s9", MakeEntries({"p9"}))));
+
+  RestorePlan plan = MakeRestorePlan(backup, live, RestoreMode::kExact);
+  ASSERT_TRUE(plan.sidebar_lists.has_value());
+  EXPECT_EQ(*plan.sidebar_lists, base::Value(std::move(backup_lists)));
+
+  DataBackups::Contents no_lists = MakeBackup(MakePrefs({{"s1", "Work"}}));
+  plan = MakeRestorePlan(no_lists, live, RestoreMode::kExact);
+  EXPECT_FALSE(plan.sidebar_lists.has_value());
+}
+
+// A merge never loosens the agent's permissions: the stricter level wins, and
+// a "never" for a site wins over an "always".
+TEST(RestorePlanTest, MergeKeepsStricterAgentPermissions) {
+  using Level = std::optional<std::string>;
+  EXPECT_EQ(RestoredLevel(DataBackups::kAgentPermissionAsk, std::nullopt,
+                          RestoreMode::kMerge),
+            Level("ask"));
+  EXPECT_EQ(RestoredLevel("auto", DataBackups::kAgentPermissionAsk,
+                          RestoreMode::kMerge),
+            Level("ask"));
+  EXPECT_EQ(RestoredLevel(DataBackups::kAgentPermissionAsk, "auto",
+                          RestoreMode::kMerge),
+            Level("ask"));
+  EXPECT_EQ(RestoredLevel(std::nullopt, DataBackups::kAgentPermissionCareful,
+                          RestoreMode::kMerge),
+            Level("careful"));
+  EXPECT_EQ(RestoredLevel(DataBackups::kAgentPermissionAsk,
+                          DataBackups::kAgentPermissionCareful,
+                          RestoreMode::kMerge),
+            Level("ask"));
+  EXPECT_FALSE(
+      RestoredLevel(std::nullopt, std::nullopt, RestoreMode::kMerge)
+          .has_value());
+
+  RestorePlan plan = RestoredRules(
+      base::test::ParseJsonDict(R"({"a":"always","b":"always"})"),
+      base::test::ParseJsonDict(R"({"a":"never","c":"always"})"),
+      RestoreMode::kMerge);
+  ASSERT_TRUE(plan.agent_site_rules.has_value());
+  EXPECT_EQ(*plan.agent_site_rules,
+            base::Value(base::test::ParseJsonDict(
+                R"({"a":"never","b":"always","c":"always"})")));
+
+  plan = RestoredRules(base::test::ParseJsonDict(R"({"d":"never"})"),
+                       base::test::ParseJsonDict(R"({"d":"always"})"),
+                       RestoreMode::kMerge);
+  ASSERT_TRUE(plan.agent_site_rules.has_value());
+  EXPECT_EQ(*plan.agent_site_rules,
+            base::Value(base::test::ParseJsonDict(R"({"d":"never"})")));
+}
+
+// An exact restore never loosens the agent's permissions either: a live
+// level stricter than the backup's is kept, a backup "ask" over a live
+// "auto" gives "ask", and a live "never" survives while the backup's rules
+// for other sites come back.
+TEST(RestorePlanTest, ExactAgentPermissionsOnlyTighten) {
+  using Level = std::optional<std::string>;
+  EXPECT_EQ(RestoredLevel("auto", DataBackups::kAgentPermissionAsk,
+                          RestoreMode::kExact),
+            Level("ask"));
+  EXPECT_EQ(RestoredLevel("auto", DataBackups::kAgentPermissionCareful,
+                          RestoreMode::kExact),
+            Level("careful"));
+  EXPECT_EQ(RestoredLevel(DataBackups::kAgentPermissionAsk, "auto",
+                          RestoreMode::kExact),
+            Level("ask"));
+
+  RestorePlan plan = RestoredRules(
+      base::test::ParseJsonDict(R"({"a":"always","b":"always"})"),
+      base::test::ParseJsonDict(R"({"a":"never","c":"always"})"),
+      RestoreMode::kExact);
+  ASSERT_TRUE(plan.agent_site_rules.has_value());
+  EXPECT_EQ(*plan.agent_site_rules,
+            base::Value(base::test::ParseJsonDict(
+                R"({"a":"never","b":"always","c":"always"})")));
+}
+
+// An exact restore with no agent prefs in the backup doesn't clear the live
+// ones: the merge keeps whatever was already there.
+TEST(RestorePlanTest, ExactKeepsLiveAgentPrefsWhenBackupHasNone) {
+  DataBackups::Contents empty_backup;
+  LiveSidebar live = MakeLive(
+      base::DictValue()
+          .Set(DataBackups::kAgentSiteRulesPref,
+               base::test::ParseJsonDict(R"({"a":"never","c":"always"})"))
+          .Set(DataBackups::kAgentPermissionLevelPref,
+               DataBackups::kAgentPermissionAsk));
+
+  RestorePlan plan = MakeRestorePlan(empty_backup, live, RestoreMode::kExact);
+  ASSERT_TRUE(plan.agent_site_rules.has_value());
+  EXPECT_EQ(*plan.agent_site_rules,
+            base::Value(base::test::ParseJsonDict(
+                R"({"a":"never","c":"always"})")));
+  ASSERT_TRUE(plan.agent_permission_level.has_value());
+  EXPECT_EQ(*plan.agent_permission_level, base::Value("ask"));
+}
+
+// Merging into a sidebar with nothing a user made loses nothing, so it skips
+// the safety snapshot. Anything else, and every exact restore, takes one.
+TEST(RestorePlanTest, MergeIntoEmptySidebarSkipsSafetySnapshot) {
+  LiveSidebar blank = MakeLive(base::DictValue().Set(
+      DataBackups::kSpacesPref, MakeSpacesPref({{"reset", ""}})));
+  EXPECT_FALSE(NeedsSafetySnapshot(RestoreMode::kMerge, blank));
+
+  LiveSidebar named = MakeLive(base::DictValue().Set(
+      DataBackups::kSpacesPref, MakeSpacesPref({{"s1", "Work"}})));
+  EXPECT_TRUE(NeedsSafetySnapshot(RestoreMode::kMerge, named));
+
+  LiveSidebar with_favorite = MakeLive(
+      base::DictValue()
+          .Set(DataBackups::kSpacesPref, MakeSpacesPref({{"reset", ""}}))
+          .Set(DataBackups::kSidebarListsPref,
+               base::DictValue().Set("favorites", MakeEntries({"f1"}))));
+  EXPECT_TRUE(NeedsSafetySnapshot(RestoreMode::kMerge, with_favorite));
+
+  EXPECT_TRUE(NeedsSafetySnapshot(RestoreMode::kExact, LiveSidebar()));
+}
+
+}  // namespace
+}  // namespace rac

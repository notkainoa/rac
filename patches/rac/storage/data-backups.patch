+// The shapes SpacesService, SidebarItems, SpacesStore, and the agent guard
+// write. See data_backups.cc for the first two.
+constexpr char kSpacesListKey[] = "spaces";
+constexpr char kSpaceIdKey[] = "id";
+constexpr char kSpaceNameKey[] = "name";
+constexpr char kSpaceIconKey[] = "icon";
+constexpr char kPinnedListPrefix[] = "pinned.";
+constexpr char kEntriesKey[] = "entries";
+constexpr char kEntryIdKey[] = "id";
+// `rac spaces`: {"version": N, "spaces": {<space id>: StoredSpace}}.
+constexpr char kStoreSpacesKey[] = "spaces";
+
+const base::ListValue* SpacesIn(const base::DictValue& prefs) {
+  const base::DictValue* spaces = prefs.FindDict(DataBackups::kSpacesPref);
+  return spaces ? spaces->FindList(kSpacesListKey) : nullptr;
+}
+
+const std::string* SpaceId(const base::Value& space) {
+  return space.is_dict() ? space.GetDict().FindString(kSpaceIdKey) : nullptr;
+}
+
+const base::ListValue* EntriesOf(const base::DictValue* lists,
+                                 std::string_view key) {
+  const base::DictValue* list = lists ? lists->FindDict(key) : nullptr;
+  return list ? list->FindList(kEntriesKey) : nullptr;
+}
+
+bool IsBlankSpace(const base::DictValue& space,
+                  const base::DictValue* live_lists) {
+  const std::string* name = space.FindString(kSpaceNameKey);
+  const std::string* icon = space.FindString(kSpaceIconKey);
+  const std::string* id = space.FindString(kSpaceIdKey);
+  const base::ListValue* pinned =
+      id ? EntriesOf(live_lists, base::StrCat({kPinnedListPrefix, *id}))
+         : nullptr;
+  return (!name || name->empty()) && (!icon || icon->empty()) &&
+         (!pinned || pinned->empty());
+}
+
+// Backup lists first; then, per list, live entries the backup doesn't have.
+// `drop_list` is the placeholder's (empty) pinned list.
+std::optional<base::Value> MergeLists(const base::DictValue* backup,
+                                      const base::DictValue* live,
+                                      std::string_view drop_list) {
+  if (!backup && !live) {
+    return std::nullopt;
+  }
+  base::DictValue merged = backup ? backup->Clone() : base::DictValue();
+  if (live) {
+    for (const auto [key, live_list] : *live) {
+      const base::DictValue* live_dict = live_list.GetIfDict();
+      const base::ListValue* live_entries =
+          live_dict ? live_dict->FindList(kEntriesKey) : nullptr;
+      if (key == drop_list || !live_entries || live_entries->empty()) {
+        continue;
+      }
+      base::DictValue* target = merged.FindDict(key);
+      if (!target) {
+        merged.Set(key, live_dict->Clone());
+        continue;
+      }
+      base::ListValue* entries = target->FindList(kEntriesKey);
+      if (!entries) {
+        // Keep the backup's other fields for this list.
+        target->Set(kEntriesKey, live_entries->Clone());
+        continue;
+      }
+      base::flat_set<std::string> ids;
+      for (const base::Value& entry : *entries) {
+        if (const std::string* id =
+                entry.is_dict() ? entry.GetDict().FindString(kEntryIdKey)
+                                : nullptr) {
+          ids.insert(*id);
+        }
+      }
+      for (const base::Value& entry : *live_entries) {
+        const std::string* id =
+            entry.is_dict() ? entry.GetDict().FindString(kEntryIdKey) : nullptr;
+        if (!id || !ids.contains(*id)) {
+          entries->Append(entry.Clone());
+        }
+      }
+    }
+  }
+  return base::Value(std::move(merged));
+}
+
+// Higher is stricter. A missing or unknown value counts as the default,
+// "auto".
+int Strictness(const base::Value* level) {
+  if (level && level->is_string()) {
+    if (level->GetString() == DataBackups::kAgentPermissionAsk) {
+      return 2;
+    }
+    if (level->GetString() == DataBackups::kAgentPermissionCareful) {
+      return 1;
+    }
+  }
+  return 0;
+}
+
+std::optional<base::Value> MergePermissionLevel(const base::Value* backup,
+                                                const base::Value* live) {
+  if (!backup && !live) {
+    return std::nullopt;
+  }
+  const base::Value* stricter =
+      !live || (backup && Strictness(backup) > Strictness(live)) ? backup
+                                                                  : live;
+  return stricter->Clone();
+}
+
+// The backup's rules, plus live rules for other sites. A "never" from either
+// side wins, so a merge never allows the agent somewhere it was blocked.
+std::optional<base::Value> MergeSiteRules(const base::Value* backup,
+                                          const base::Value* live) {
+  const base::DictValue* backup_rules = backup ? backup->GetIfDict() : nullptr;
+  const base::DictValue* live_rules = live ? live->GetIfDict() : nullptr;
+  if (!backup_rules && !live_rules) {
+    return std::nullopt;
+  }
+  base::DictValue merged = backup_rules ? backup_rules->Clone()
+                                        : base::DictValue();
+  if (live_rules) {
+    for (const auto [origin, rule] : *live_rules) {
+      const bool live_never = rule.is_string() && rule.GetString() ==
+                                   DataBackups::kAgentSiteNever;
+      if (live_never || !merged.contains(origin)) {
+        merged.Set(origin, rule.Clone());
+      }
+    }
+  }
+  return base::Value(std::move(merged));
+}
+
+std::optional<base::Value> CloneOrNull(const base::Value* value) {
+  return value ? std::optional<base::Value>(value->Clone()) : std::nullopt;
+}

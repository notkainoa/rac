+constexpr char kSpacesStoreFile[] = "rac spaces";
+constexpr char kImportReason[] = "import-arc";
+
+// What SetUserData() writes: two named spaces, one favorite, and two pinned
+// tabs (one of them in a folder).
+const DataBackups::Counts kUserDataCounts = {
+    .spaces = 2, .pinned_tabs = 2, .favorites = 1};
+
+// A realistic wall-clock time, for tests that set file times. The mock clock
+// starts near 1970, where going back a few weeks would be before the epoch.
+base::Time RealisticTime() {
+  return base::Time::UnixEpoch() + base::Days(20000);
+}
+
+// {"version":1,"spaces":[{"id":"<uuid>","name":"Work"}, ...]}. An empty name
+// leaves the name out, like a space the user never named.
+base::DictValue MakeSpaces(const std::vector<std::string>& names) {
+  base::ListValue spaces;
+  int index = 0;
+  for (const std::string& name : names) {
+    base::DictValue space;
+    space.Set("id", base::StringPrintf(
+                        "0f7a5c9e-6f8b-4b5e-9c1d-2a3b4c5d6e%02d", ++index));
+    if (!name.empty()) {
+      space.Set("name", name);
+    }
+    spaces.Append(std::move(space));
+  }
+  return base::DictValue().Set("version", 1).Set("spaces", std::move(spaces));
+}
+
+// One favorite, and pinned tabs: one item and a folder holding one more.
+base::DictValue MakeLists() {
+  return base::test::ParseJsonDict(
+      R"({"favorites":{"entries":[)"
+      R"({"id":"f1","url":"https://a.test/","title":"A"}]},)"
+      R"("pinned.0f7a5c9e-6f8b-4b5e-9c1d-2a3b4c5d6e01":{"entries":[)"
+      R"({"id":"p1","url":"https://b.test/","title":"B"},)"
+      R"({"id":"folder1","title":"F","collapsed":false,"items":[)"
+      R"({"id":"p2","url":"https://c.test/","title":"C"}]}]}})");
+}
+
+// A list per kind of sidebar list, with nothing in them.
+base::DictValue MakeEmptyLists() {
+  return base::test::ParseJsonDict(
+      R"({"favorites":{"entries":[]},)"
+      R"("pinned.0f7a5c9e-6f8b-4b5e-9c1d-2a3b4c5d6e01":{"entries":[]}})");
+}
+
+bool IsEmptyFor(const base::DictValue& spaces, const base::DictValue& lists) {
+  const base::Value spaces_value(spaces.Clone());
+  const base::Value lists_value(lists.Clone());
+  return DataBackups::IsEmpty(&spaces_value, &lists_value);
+}
+
+// The time part of a backup id: UTC, to the millisecond.
+std::string IdTime(base::Time time) {
+  base::Time::Exploded exploded;
+  time.UTCExplode(&exploded);
+  return base::StringPrintf("%04d%02d%02dT%02d%02d%02d%03dZ", exploded.year,
+                            exploded.month, exploded.day_of_month,
+                            exploded.hour, exploded.minute, exploded.second,
+                            exploded.millisecond);
+}
+
+// Runs after every file task posted to `backups` so far, and its reply.
+void Flush(DataBackups& backups) {
+  base::RunLoop run_loop;
+  backups.FlushForTesting(run_loop.QuitClosure());
+  run_loop.Run();
+}

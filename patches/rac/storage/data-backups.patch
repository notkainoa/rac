+class TestObserver : public DataBackups::Observer {
+ public:
+  void OnRestoreOfferChanged() override { ++changes_; }
+
+  int changes() const { return changes_; }
+
+ private:
+  int changes_ = 0;
+};
+
+class DataBackupsTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    // What production registers: the prefs owned elsewhere, then this
+    // service's own.
+    prefs_.registry()->RegisterDictionaryPref(DataBackups::kSpacesPref);
+    prefs_.registry()->RegisterDictionaryPref(DataBackups::kSidebarListsPref);
+    prefs_.registry()->RegisterDictionaryPref(
+        DataBackups::kAgentSiteRulesPref);
+    prefs_.registry()->RegisterStringPref(
+        DataBackups::kAgentPermissionLevelPref, "auto");
+    DataBackups::RegisterProfilePrefs(prefs_.registry());
+  }
+  void TearDown() override { task_environment_.RunUntilIdle(); }
+
+  const base::Clock* clock() const { return task_environment_.GetMockClock(); }
+
+  std::unique_ptr<DataBackups> Make() {
+    return std::make_unique<DataBackups>(&prefs_, dir_.GetPath(), clock());
+  }
+
+  // Moves the mock clock, runs the timers that come due, and waits for the
+  // file work they start.
+  void FastForward(base::TimeDelta delta) {
+    task_environment_.FastForwardBy(delta);
+    task_environment_.RunUntilIdle();
+  }
+
+  void SetSpaces(const base::DictValue& spaces) {
+    prefs_.SetUserPref(DataBackups::kSpacesPref, spaces.Clone());
+  }
+  void SetLists(const base::DictValue& lists) {
+    prefs_.SetUserPref(DataBackups::kSidebarListsPref, lists.Clone());
+  }
+  void SetUserData() {
+    SetSpaces(MakeSpaces({"Work", "Play"}));
+    SetLists(MakeLists());
+  }
+
+  // What a corrupt, deleted, or unreadable `Preferences` leaves: every pref
+  // at its default, this service's own included. No `Preferences.bad` is
+  // needed to notice.
+  void ResetPreferences() {
+    for (const char* name :
+         {DataBackups::kSpacesPref, DataBackups::kSidebarListsPref,
+          DataBackups::kAgentSiteRulesPref,
+          DataBackups::kAgentPermissionLevelPref,
+          DataBackups::kInitializedPref, DataBackups::kLastDailyPref,
+          DataBackups::kRestoreOfferPref,
+          DataBackups::kPinnedSnapshotsPref}) {
+      prefs_.ClearPref(name);
+    }
+  }
+
+  std::optional<std::string> TakeSnapshot(DataBackups& backups,
+                                          std::string_view reason) {
+    base::test::TestFuture<std::optional<std::string>> future;
+    backups.CreateSnapshot(reason, future.GetCallback());
+    return future.Take();
+  }
+
+  std::optional<DataBackups::Contents> ReadContents(DataBackups& backups,
+                                                    std::string_view id) {
+    base::test::TestFuture<std::optional<DataBackups::Contents>> future;
+    backups.ReadBackup(id, future.GetCallback());
+    return future.Take();
+  }
+
+  std::optional<DataBackups::Contents> ReadOffered(DataBackups& backups) {
+    base::test::TestFuture<std::optional<DataBackups::Contents>> future;
+    backups.ReadOfferedBackup(future.GetCallback());
+    return future.Take();
+  }
+
+  base::FilePath BackupsDir() const {
+    return dir_.GetPath().AppendASCII(DataBackups::kDirName);
+  }
+  base::FilePath BackupFile(std::string_view id) const {
+    return BackupsDir().AppendASCII(base::StrCat({id, ".json"}));
+  }
+
+  bool FileExists(const base::FilePath& path) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    return base::PathExists(path);
+  }
+
+  // The ids of the backups whose ids start with `prefix`, oldest first. Ids
+  // sort by time within a kind.
+  std::vector<std::string> Ids(std::string_view prefix) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    std::vector<std::string> ids;
+    base::FileEnumerator files(BackupsDir(), /*recursive=*/false,
+                               base::FileEnumerator::FILES);
+    for (base::FilePath path = files.Next(); !path.empty();
+         path = files.Next()) {
+      std::string id = path.BaseName().RemoveFinalExtension().MaybeAsASCII();
+      if (base::StartsWith(id, prefix)) {
+        ids.push_back(std::move(id));
+      }
+    }
+    std::ranges::sort(ids);
+    return ids;
+  }
+
+  std::optional<DataBackups::Contents> ReadNewestDaily(DataBackups& backups) {
+    std::vector<std::string> dailies = Ids("daily-");
+    if (dailies.empty()) {
+      return std::nullopt;
+    }
+    return ReadContents(backups, dailies.back());
+  }
+
+  void WriteTextFile(const base::FilePath& path, std::string_view text) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(path, text));
+  }
+
+  void WriteSpacesFile(std::string_view name, std::string_view json) {
+    WriteTextFile(dir_.GetPath().AppendASCII(name), json);
+  }
+
+  void SetFileTime(const base::FilePath& path, base::Time time) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::TouchFile(path, time, time));
+  }
+
+  std::optional<base::DictValue> ReadRawFile(const base::FilePath& path) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    std::string content;
+    if (!base::ReadFileToString(path, &content)) {
+      return std::nullopt;
+    }
+    return base::JSONReader::ReadDict(content, base::JSON_PARSE_RFC);
+  }
+
+  // A daily backup written by hand, with no prefs in it. Returns its id.
+  std::string WriteDailyFile(int min_reader_version, base::Time created) {
+    const base::DictValue file =
+        base::DictValue()
+            .Set("version", DataBackups::kVersion)
+            .Set("min_reader_version", min_reader_version)
+            .Set("kind", "daily")
+            .Set("created", base::TimeToValue(created))
+            .Set("prefs", base::DictValue());
+    std::optional<std::string> json = base::WriteJson(file);
+    EXPECT_TRUE(json);
+    const std::string id = base::StrCat({"daily-", IdTime(created)});
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    EXPECT_TRUE(base::CreateDirectory(BackupsDir()));
+    EXPECT_TRUE(base::WriteFile(BackupFile(id), json.value_or("")));
+    return id;
+  }
+
+  // Runs a service with user data until a daily backup exists, then quits
+  // it, as the browser would. Returns the backup's creation time. The prefs
+  // are left as they were.
+  base::Time WriteDaily() {
+    SetUserData();
+    std::unique_ptr<DataBackups> backups = Make();
+    FastForward(DataBackups::kStartupDelay);
+    std::optional<DataBackups::Contents> daily = ReadNewestDaily(*backups);
+    EXPECT_TRUE(daily);
+    return daily ? daily->created : base::Time();
+  }
+
+  // A daily backup with user data, then a reset `Preferences`, then a new
+  // service that has found it. Returns the daily's creation time.
+  base::Time WriteDailyThenReset(std::unique_ptr<DataBackups>& backups) {
+    const base::Time created = WriteDaily();
+    ResetPreferences();
+    backups = Make();
+    task_environment_.RunUntilIdle();
+    return created;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  base::ScopedTempDir dir_;
+  TestingPrefServiceSimple prefs_;
+};
+
+// A profile with nothing the user made counts as empty, even with the lists
+// and one default space in it.
+TEST_F(DataBackupsTest, IsEmptyForNewProfile) {
+  EXPECT_TRUE(DataBackups::IsEmpty(nullptr, nullptr));
+  EXPECT_TRUE(IsEmptyFor(MakeSpaces({""}), MakeEmptyLists()));
+  EXPECT_TRUE(IsEmptyFor(MakeSpaces({""}), base::DictValue()));
+}
+
+// Anything a user made makes the profile non-empty: a name, more than one
+// space, an icon, a favorite, a pinned tab, or just a folder.
+TEST_F(DataBackupsTest, IsNotEmptyWithUserData) {
+  const base::DictValue unnamed = MakeSpaces({""});
+  const base::DictValue no_lists = MakeEmptyLists();
+
+  {
+    SCOPED_TRACE("named space");
+    EXPECT_FALSE(IsEmptyFor(MakeSpaces({"Work"}), no_lists));
+  }
+  {
+    SCOPED_TRACE("two spaces");
+    EXPECT_FALSE(IsEmptyFor(MakeSpaces({"", ""}), no_lists));
+  }
+  {
+    SCOPED_TRACE("space with an icon");
+    base::DictValue with_icon = MakeSpaces({""});
+    with_icon.FindList("spaces")->front().GetDict().Set("icon", "star");
+    EXPECT_FALSE(IsEmptyFor(with_icon, no_lists));
+  }
+  {
+    SCOPED_TRACE("favorite");
+    EXPECT_FALSE(IsEmptyFor(
+        unnamed, base::test::ParseJsonDict(
+                     R"({"favorites":{"entries":[)"
+                     R"({"id":"f1","url":"https://a.test/","title":"A"}]}})")));
+  }
+  {
+    SCOPED_TRACE("pinned tab");
+    EXPECT_FALSE(IsEmptyFor(
+        unnamed,
+        base::test::ParseJsonDict(
+            R"({"pinned.0f7a5c9e-6f8b-4b5e-9c1d-2a3b4c5d6e01":{"entries":[)"
+            R"({"id":"p1","url":"https://b.test/","title":"B"}]}})")));
+  }
+  {
+    SCOPED_TRACE("empty folder");
+    EXPECT_FALSE(IsEmptyFor(
+        unnamed,
+        base::test::ParseJsonDict(
+            R"({"pinned.0f7a5c9e-6f8b-4b5e-9c1d-2a3b4c5d6e01":{"entries":[)"
+            R"({"id":"folder1","title":"F","collapsed":false,)"
+            R"("items":[]}]}})")));
+  }
+}
+
+// Items in a folder are counted, the folder itself isn't, and favorites and
+// pinned tabs are counted apart.
+TEST_F(DataBackupsTest, CountsItemsInFolders) {
+  const base::Value spaces(MakeSpaces({"Work", "Play"}));
+  const base::Value lists(MakeLists());
+  const DataBackups::Counts counts = DataBackups::Count(&spaces, &lists);
+  EXPECT_EQ(counts.favorites, 1u);
+  EXPECT_EQ(counts.pinned_tabs, 2u);
+  EXPECT_EQ(counts.spaces, 2u);
+  EXPECT_EQ(counts, kUserDataCounts);
+  EXPECT_EQ(DataBackups::Count(nullptr, nullptr), DataBackups::Counts());
+}
+
+// A snapshot holds all four backed-up prefs and the `rac spaces` file, and
+// reads back the same.
+TEST_F(DataBackupsTest, SnapshotHoldsPrefsAndSpacesStore) {
+  const base::DictValue spaces = MakeSpaces({"Work", "Play"});
+  const base::DictValue lists = MakeLists();
+  const base::DictValue rules =
+      base::test::ParseJsonDict(R"({"a.test":"never"})");
+  SetSpaces(spaces);
+  SetLists(lists);
+  prefs_.SetUserPref(DataBackups::kAgentSiteRulesPref, rules.Clone());
+  prefs_.SetString(DataBackups::kAgentPermissionLevelPref, "ask");
+  WriteSpacesFile(kSpacesStoreFile, R"({"version":1,"spaces":{}})");
+
+  std::unique_ptr<DataBackups> backups = Make();
+  std::optional<std::string> id = TakeSnapshot(*backups, kImportReason);
+  ASSERT_TRUE(id);
+  EXPECT_TRUE(base::StartsWith(*id, "snapshot-"));
+  EXPECT_TRUE(base::EndsWith(*id, "-import-arc"));
+
+  std::optional<DataBackups::Contents> contents = ReadContents(*backups, *id);
+  ASSERT_TRUE(contents);
+  EXPECT_EQ(contents->id, *id);
+  EXPECT_EQ(contents->kind, DataBackups::Kind::kSnapshot);
+  EXPECT_EQ(contents->reason, kImportReason);
+  EXPECT_EQ(contents->prefs.size(), 4u);
+  ASSERT_TRUE(contents->prefs.FindDict(DataBackups::kSpacesPref));
+  EXPECT_EQ(*contents->prefs.FindDict(DataBackups::kSpacesPref), spaces);
+  ASSERT_TRUE(contents->prefs.FindDict(DataBackups::kSidebarListsPref));
+  EXPECT_EQ(*contents->prefs.FindDict(DataBackups::kSidebarListsPref), lists);
+  ASSERT_TRUE(contents->prefs.FindDict(DataBackups::kAgentSiteRulesPref));
+  EXPECT_EQ(*contents->prefs.FindDict(DataBackups::kAgentSiteRulesPref),
+            rules);
+  ASSERT_TRUE(
+      contents->prefs.FindString(DataBackups::kAgentPermissionLevelPref));
+  EXPECT_EQ(
+      *contents->prefs.FindString(DataBackups::kAgentPermissionLevelPref),
+      "ask");
+  ASSERT_TRUE(contents->spaces_store);
+  EXPECT_EQ(*contents->spaces_store,
+            base::test::ParseJsonDict(R"({"version":1,"spaces":{}})"));
+  EXPECT_EQ(contents->counts, kUserDataCounts);
+}

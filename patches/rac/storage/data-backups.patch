+// The offer lists each space's name, emoji, colors, and mode, in stored
+// order, skips what isn't a space, and keeps only what the prompt can trust.
+TEST_F(DataBackupsTest, SummarizeSpacesReadsNameEmojiColorsAndMode) {
+  using Mode = DataBackups::SpaceSummary::Mode;
+  std::vector<base::DictValue> spaces;
+  spaces.push_back(
+      MakeThemedSpace(1, "Work", "\U0001F680", "#FFE9F4", "#F1D1EC", "dark"));
+  // No icon, no theme at all: the defaults.
+  spaces.push_back(MakeSpaces({"Plain"})
+                       .FindList("spaces")
+                       ->front()
+                       .GetDict()
+                       .Clone());
+  // Bad colors and mode are dropped, not copied. An over-long emoji goes; an
+  // over-long name is cut on a character boundary.
+  spaces.push_back(MakeThemedSpace(3, std::string(40, 'a') + "é" +
+                                          std::string(40, 'b'),
+                                   std::string(40, 'x'), "red", "#12345",
+                                   "sepia"));
+  base::DictValue store = SpacesStore(std::move(spaces));
+  // An entry with no id isn't a space.
+  store.FindList("spaces")->Append(base::DictValue().Set("name", "Ghost"));
+  store.FindList("spaces")->Append("not a dict");
+  const base::Value value(std::move(store));
+
+  const std::vector<DataBackups::SpaceSummary> summaries =
+      DataBackups::SummarizeSpaces(&value);
+  ASSERT_EQ(summaries.size(), 3u);
+  EXPECT_EQ(summaries[0],
+            (DataBackups::SpaceSummary{.name = "Work",
+                                       .emoji = "\U0001F680",
+                                       .color1 = "#FFE9F4",
+                                       .color2 = "#F1D1EC",
+                                       .mode = Mode::kDark}));
+  EXPECT_EQ(summaries[1], (DataBackups::SpaceSummary{.name = "Plain"}));
+  EXPECT_LE(summaries[2].name.size(), DataBackups::kMaxSummaryNameBytes);
+  EXPECT_TRUE(base::IsStringUTF8(summaries[2].name));
+  EXPECT_TRUE(base::StartsWith(summaries[2].name, std::string(40, 'a')));
+  EXPECT_TRUE(summaries[2].emoji.empty());
+  EXPECT_TRUE(summaries[2].color1.empty());
+  EXPECT_TRUE(summaries[2].color2.empty());
+  EXPECT_EQ(summaries[2].mode, Mode::kAuto);
+
+  EXPECT_TRUE(DataBackups::SummarizeSpaces(nullptr).empty());
+  const base::Value not_a_store(5);
+  EXPECT_TRUE(DataBackups::SummarizeSpaces(&not_a_store).empty());
+}

+RestorePlan::RestorePlan() = default;
+RestorePlan::RestorePlan(RestorePlan&&) = default;
+RestorePlan& RestorePlan::operator=(RestorePlan&&) = default;
+RestorePlan::~RestorePlan() = default;
+
+RestorePlan MakeRestorePlan(const DataBackups::Contents& backup,
+                            const LiveSidebar& live,
+                            RestoreMode mode) {
+  RestorePlan plan;
+  const base::DictValue* backup_lists =
+      backup.prefs.FindDict(DataBackups::kSidebarListsPref);
+  const base::DictValue* live_lists =
+      live.prefs.FindDict(DataBackups::kSidebarListsPref);
+
+  // 1. The backup's spaces, in order.
+  base::flat_set<std::string> backup_ids;
+  if (const base::ListValue* spaces = SpacesIn(backup.prefs)) {
+    for (const base::Value& space : *spaces) {
+      if (const std::string* id = SpaceId(space)) {
+        backup_ids.insert(*id);
+        plan.spaces.push_back(space.GetDict().Clone());
+      }
+    }
+  }
+
+  // 2. Live spaces the backup doesn't have.
+  if (const base::ListValue* spaces = SpacesIn(live.prefs)) {
+    for (const base::Value& space : *spaces) {
+      const std::string* id = SpaceId(space);
+      if (!id || backup_ids.contains(*id)) {
+        continue;
+      }
+      if (mode == RestoreMode::kExact) {
+        plan.delete_spaces.push_back(*id);
+      } else if (!plan.move_tabs_from && !plan.spaces.empty() &&
+                 IsBlankSpace(space.GetDict(), live_lists) &&
+                 !live.spaces_with_stored_tabs.contains(*id)) {
+        // The space a reset leaves. Whatever is open in it moves, so a merge
+        // closes nothing. A space with stored tabs isn't blank: only open
+        // tabs move, and deleting it would drop those.
+        plan.move_tabs_from = *id;
+        plan.move_tabs_to = *plan.spaces.front().FindString(kSpaceIdKey);
+        plan.delete_spaces.push_back(*id);
+      }
+      // Any other live space is kept, after the backup's.
+    }
+  }
+
+  // 3. Favorites and pinned tabs.
+  if (mode == RestoreMode::kExact) {
+    plan.sidebar_lists = CloneOrNull(
+        backup.prefs.Find(DataBackups::kSidebarListsPref));
+  } else {
+    plan.sidebar_lists = MergeLists(
+        backup_lists, live_lists,
+        plan.move_tabs_from
+            ? base::StrCat({kPinnedListPrefix, *plan.move_tabs_from})
+            : std::string());
+  }
+
+  // 4. Stored tabs. Only a backup that has `rac spaces` says anything about
+  // them. A daily or pre-reset copy doesn't, and a reset of `Preferences`
+  // doesn't touch `rac spaces`, so the live stored tabs are what's left. A
+  // store without its spaces dict is treated as saying nothing, so a
+  // malformed one never wipes live tabs. Spaces in `delete_spaces` lose
+  // their stored tabs through DeleteSpace, not here.
+  const base::DictValue* stored =
+      backup.spaces_store ? backup.spaces_store->FindDict(kStoreSpacesKey)
+                          : nullptr;
+  if (stored) {
+    for (const base::DictValue& space : plan.spaces) {
+      const std::string& id = *space.FindString(kSpaceIdKey);
+      const base::DictValue* tabs = stored->FindDict(id);
+      if (live.spaces_with_window_tabs.contains(id)) {
+        // Its tabs are open in a window. They stay as they are.
+        continue;
+      }
+      if (tabs) {
+        if (mode == RestoreMode::kMerge &&
+            live.spaces_with_stored_tabs.contains(id)) {
+          continue;
+        }
+        plan.restore_stored_tabs.emplace_back(id, tabs->Clone());
+      } else if (mode == RestoreMode::kExact &&
+                 live.spaces_with_stored_tabs.contains(id)) {
+        plan.remove_stored_tabs.push_back(id);
+      }
+    }
+  }
+
+  // 5. Agent permissions. Merged the same way in both modes, so a restore
+  // never loosens the level and never drops a live "never" rule.
+  const base::Value* backup_rules =
+      backup.prefs.Find(DataBackups::kAgentSiteRulesPref);
+  const base::Value* backup_level =
+      backup.prefs.Find(DataBackups::kAgentPermissionLevelPref);
+  plan.agent_site_rules = MergeSiteRules(
+      backup_rules, live.prefs.Find(DataBackups::kAgentSiteRulesPref));
+  plan.agent_permission_level = MergePermissionLevel(
+      backup_level, live.prefs.Find(DataBackups::kAgentPermissionLevelPref));
+  return plan;
+}
+
+bool NeedsSafetySnapshot(RestoreMode mode, const LiveSidebar& live) {
+  return mode == RestoreMode::kExact ||
+         !DataBackups::IsEmpty(
+             live.prefs.Find(DataBackups::kSpacesPref),
+             live.prefs.Find(DataBackups::kSidebarListsPref));
+}
+
+}  // namespace rac

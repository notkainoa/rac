+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/keychain_key_prefs.h"
+
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+// Files in a profile folder that only exist once the profile had a key: the
+// cookie store (in Network/ since M96, at the top before) and saved passwords.
+constexpr const base::FilePath::CharType* kProfileDataFiles[] = {
+    FILE_PATH_LITERAL("Network/Cookies"),
+    FILE_PATH_LITERAL("Cookies"),
+    FILE_PATH_LITERAL("Login Data"),
+};
+
+bool IsProfileFolderWithData(const base::FilePath& folder) {
+  for (const base::FilePath::CharType* file : kProfileDataFiles) {
+    if (base::PathExists(folder.Append(file))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void OnKeyMissingAnswered(PrefService* local_state,
+                          AskNewKeyStep ask,
+                          base::OnceClosure quit,
+                          bool make_new_key);
+
+void OnConfirmAnswered(PrefService* local_state,
+                       base::OnceClosure quit,
+                       bool make_new_key) {
+  if (!make_new_key) {
+    std::move(quit).Run();
+    return;
+  }
+  local_state->SetBoolean(kKeychainAllowNewKey, true);
+  // Quit only once the pref is on disk, or the next launch would still treat
+  // the key as expected and show this dialog again.
+  local_state->CommitPendingWrite(std::move(quit));
+}
+
+void OnKeyMissingAnswered(PrefService* local_state,
+                          AskNewKeyStep ask,
+                          base::OnceClosure quit,
+                          bool make_new_key) {
+  if (!make_new_key) {
+    std::move(quit).Run();
+    return;
+  }
+  ask.Run(NewKeyStep::kConfirm,
+          base::BindOnce(&OnConfirmAnswered, base::Unretained(local_state),
+                         std::move(quit)));
+}
+
+}  // namespace
+
+void RegisterKeychainKeyPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kKeychainKeySeen, false);
+  registry->RegisterBooleanPref(kKeychainAllowNewKey, false);
+}
+
+bool HasProfileData(const base::FilePath& user_data_dir) {
+  // The usual profile first, so a normal install needs no listing.
+  if (IsProfileFolderWithData(user_data_dir.AppendASCII("Default"))) {
+    return true;
+  }
+  base::FileEnumerator folders(user_data_dir, /*recursive=*/false,
+                               base::FileEnumerator::DIRECTORIES);
+  size_t checked = 0;
+  for (base::FilePath folder = folders.Next();
+       !folder.empty() && checked < kMaxProfileFoldersChecked;
+       folder = folders.Next(), ++checked) {
+    if (IsProfileFolderWithData(folder)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsKeychainKeyExpected(const PrefService& local_state,
+                           const base::FilePath& user_data_dir) {
+  if (local_state.GetBoolean(kKeychainAllowNewKey)) {
+    return false;
+  }
+  if (local_state.GetBoolean(kKeychainKeySeen)) {
+    return true;
+  }
+  const PrefService::Preference* profiles =
+      local_state.FindPreference(kKeychainProfilesPref);
+  const base::DictValue* dict =
+      profiles ? profiles->GetValue()->GetIfDict() : nullptr;
+  if (dict && !dict->empty()) {
+    return true;
+  }
+  // Local State doesn't know: a first run, or a Local State that was lost or
+  // couldn't be read. The profile folders still show whether a key existed.
+  return !user_data_dir.empty() && HasProfileData(user_data_dir);
+}
+
+void RecordKeychainKeySeen(PrefService* local_state) {
+  if (!local_state->GetBoolean(kKeychainKeySeen)) {
+    local_state->SetBoolean(kKeychainKeySeen, true);
+  }
+  if (local_state->HasPrefPath(kKeychainAllowNewKey)) {
+    local_state->ClearPref(kKeychainAllowNewKey);
+  }
+}
+
+NewKeyStepReply::NewKeyStepReply(base::OnceCallback<void(bool)> callback)
+    : callback_(std::move(callback)) {}
+
+NewKeyStepReply::~NewKeyStepReply() = default;
+
+void NewKeyStepReply::Accept() {
+  Reply(true);
+}
+
+void NewKeyStepReply::Cancel() {
+  Reply(false);
+}
+
+void NewKeyStepReply::Close() {
+  Reply(false);
+}
+
+void NewKeyStepReply::Reply(bool make_new_key) {
+  if (!callback_) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(callback_), make_new_key));
+}
+
+void RunNewKeychainKeyFlow(PrefService* local_state,
+                           AskNewKeyStep ask,
+                           base::OnceClosure quit) {
+  AskNewKeyStep ask_copy = ask;
+  ask_copy.Run(
+      NewKeyStep::kKeyMissing,
+      base::BindOnce(&OnKeyMissingAnswered, base::Unretained(local_state),
+                     std::move(ask), std::move(quit)));
+}
+
+}  // namespace rac

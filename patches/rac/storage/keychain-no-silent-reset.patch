@@ -0,0 +1,32 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_STORAGE_KEYCHAIN_KEY_DIALOG_H_
+#define CHROME_BROWSER_UI_RAC_STORAGE_KEYCHAIN_KEY_DIALOG_H_
+
+#include "base/functional/callback.h"
+
+class PrefService;
+
+namespace rac {
+
+// BrowserProcessImpl's one call into rac here, kept to one line because it
+// sits on a line Helium's own patch added. Installs rac's Keychain key guard
+// (keychain_key_guard_mac.h) with Local State and the user data folder, and
+// returns the failure closure for Helium's KeychainKeyProvider: rac's
+// missing-key dialog if the key was expected and not found, otherwise
+// `on_failure`, Helium's Keychain error.
+base::OnceClosure GuardKeychainKey(base::OnceClosure on_failure);
+
+// Shown when the Keychain key provider gave up and this install's key was
+// expected but not found (see keychain_key_guard_mac.h). Profile loading is
+// still waiting for the key, so the dialog has no parent window. Asks whether
+// to make a new key, confirms, and quits rac either way; rac::
+// RunNewKeychainKeyFlow() has the steps. Quits without flushing profile prefs,
+// like Helium's Keychain error.
+void ShowMissingKeychainKeyDialog(PrefService* local_state);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_STORAGE_KEYCHAIN_KEY_DIALOG_H_

+TEST_F(KeychainKeyGuardTest, UnexpectedMissingKeyIsAddedOnce) {
+  ScriptedKeychain keychain;
+  int key_seen = 0;
+  GuardedKeychainV2 guard(
+      keychain, /*key_expected=*/false,
+      base::BindOnce([](int* count) { ++*count; }, &key_seen));
+  KeychainPassword password(guard);
+
+  auto made = password.GetPasswordWithError();
+  ASSERT_TRUE(made.has_value());
+  ASSERT_FALSE(made->empty());
+  EXPECT_EQ(keychain.add_calls(), 1);
+  // No lookup that asks for the item's data, so no second prompt.
+  EXPECT_EQ(keychain.copy_matching_calls(), 0);
+  EXPECT_EQ(keychain.update_calls(), 0);
+  EXPECT_EQ(key_seen, 1);
+
+  NSDictionary* add = keychain.last_add();
+  ASSERT_TRUE(add);
+  EXPECT_EQ(add.count, 5u);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecClass)]
+      isEqual:CFToNSPtrCast(kSecClassGenericPassword)]);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecAttrService)] isEqual:@"rac Storage Key"]);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecAttrAccount)] isEqual:@"rac"]);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecAttrAccessible)]
+      isEqual:CFToNSPtrCast(kSecAttrAccessibleWhenUnlocked)]);
+  EXPECT_EQ(keychain.item(), *made);
+
+  // The next read finds it and adds nothing.
+  auto read = password.GetPasswordWithError();
+  ASSERT_TRUE(read.has_value());
+  EXPECT_EQ(*read, *made);
+  EXPECT_EQ(keychain.add_calls(), 1);
+  EXPECT_EQ(key_seen, 1);
+}

--- /dev/null
+++ src/chrome/browser/rac/storage/keychain_key_prefs.h
@@ -0,0 +1,122 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_PREFS_H_
+#define CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_PREFS_H_
+
+#include <stddef.h>
+
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace base {
+class FilePath;
+}
+
+// What Local State says about the Keychain item that holds the key for
+// cookies, saved passwords, and other os_crypt data. The guard that uses it is
+// in keychain_key_guard_mac.h. These are plain prefs, so they're registered on
+// every platform.
+namespace rac {
+
+// Local State: set the first time this install reads or makes its key. Once
+// it's set, "not found" means the key is missing, not that it was never made.
+inline constexpr char kKeychainKeySeen[] = "rac.keychain.key_seen";
+
+// Local State: set only when the user confirms "Make a New Key" in the
+// missing-key dialog. It lets the next launch make a key, and is cleared as
+// soon as a key is read or made.
+inline constexpr char kKeychainAllowNewKey[] = "rac.keychain.allow_new_key";
+
+// prefs::kProfileAttributes. Spelled out so this stays free of //chrome deps;
+// keychain_key_dialog.cc static_asserts that it still matches.
+inline constexpr char kKeychainProfilesPref[] = "profile.info_cache";
+
+// HasProfileData() looks in at most this many folders.
+inline constexpr size_t kMaxProfileFoldersChecked = 100;
+
+void RegisterKeychainKeyPrefs(PrefRegistrySimple* registry);
+
+// Whether `user_data_dir` holds a profile's data: a folder with a Cookies or
+// Login Data file, which only a profile that had a key writes. A bare profile
+// folder isn't enough, because a first run can write Default/Preferences from
+// initial preferences before the key exists. Lists only the folder's own
+// entries, at most kMaxProfileFoldersChecked folders, and looks only inside
+// those. Blocks on disk.
+bool HasProfileData(const base::FilePath& user_data_dir);
+
+// Whether this install has had a key before, so a missing one must not be
+// replaced silently. False once the user confirmed making a new key.
+// Otherwise true if the key was seen, or, for installs from before that pref,
+// if Local State lists any profile. Every install that ran has made a key,
+// because the Keychain key provider runs at every startup.
+//
+// If Local State says neither, because it's new, missing, unreadable, or its
+// profile list is empty or not a dictionary, this falls back to
+// HasProfileData(`user_data_dir`), which blocks on disk. That happens only on
+// a first run or with a broken Local State. An empty `user_data_dir` skips it.
+bool IsKeychainKeyExpected(const PrefService& local_state,
+                           const base::FilePath& user_data_dir);
+
+// Records that a key was read or made. Writes nothing if that's already
+// recorded, so a healthy launch doesn't touch Local State.
+void RecordKeychainKeySeen(PrefService* local_state);
+
+// The steps of the missing-key dialog.
+enum class NewKeyStep {
+  // "rac can't find its encryption key." Quit (default) or Make a New Key…
+  kKeyMissing,
+  // "Make a new key?" Cancel (default) or Make New Key.
+  kConfirm,
+};
+
+// Shows one step and replies true only for "Make a New Key…" or
+// "Make New Key". Anything else, including closing it, replies false.
+using AskNewKeyStep =
+    base::RepeatingCallback<void(NewKeyStep, base::OnceCallback<void(bool)>)>;
+
+// The one answer a step of the dialog gives, whichever way it's closed. The
+// dialog binds its accept, cancel, and close callbacks to this, so Views code
+// stays out of the logic. Escape runs the close callback, because the dialog
+// has one. Each step's default button is the one that doesn't make a key, so
+// Return never makes one.
+class NewKeyStepReply : public base::RefCounted<NewKeyStepReply> {
+ public:
+  explicit NewKeyStepReply(base::OnceCallback<void(bool)> callback);
+  NewKeyStepReply(const NewKeyStepReply&) = delete;
+  NewKeyStepReply& operator=(const NewKeyStepReply&) = delete;
+
+  // "Make a New Key…" or "Make New Key".
+  void Accept();
+  // "Quit" or "Cancel".
+  void Cancel();
+  // Escape, or the window closing any other way.
+  void Close();
+
+ private:
+  friend class base::RefCounted<NewKeyStepReply>;
+  ~NewKeyStepReply();
+
+  // Replies once, in a task, so the widget finishes closing before the next
+  // step opens. Later calls do nothing.
+  void Reply(bool make_new_key);
+
+  base::OnceCallback<void(bool)> callback_;
+};
+
+// Runs the missing-key dialog: asks `kKeyMissing`, then `kConfirm`. Only when
+// both say yes, it sets kKeychainAllowNewKey and waits until Local State is
+// written. Then, whatever the answers, it runs `quit`. The next launch makes
+// the key. If writing Local State fails, `quit` still runs, and the next launch
+// still expects the old key, so it asks again.
+void RunNewKeychainKeyFlow(PrefService* local_state,
+                           AskNewKeyStep ask,
+                           base::OnceClosure quit);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_PREFS_H_

+
+class PrefService;
+
+namespace rac {
+
+// Shown when the Keychain key provider gave up and this install's key was
+// expected but not found (see keychain_key_guard_mac.h). Profile loading is
+// still waiting for the key, so the dialog has no parent window. Asks whether
+// to make a new key, confirms, and quits rac either way; rac::
+// RunNewKeychainKeyFlow() has the steps. Quits without flushing profile prefs,
+// like Helium's Keychain error.
+void ShowMissingKeychainKeyDialog(PrefService* local_state);
+
+}  // namespace rac

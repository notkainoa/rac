+++ src/chrome/browser/rac/storage/guarded_keychain_mac.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_STORAGE_GUARDED_KEYCHAIN_MAC_H_
+#define CHROME_BROWSER_RAC_STORAGE_GUARDED_KEYCHAIN_MAC_H_
+
+#include <stdint.h>
+
+#include <atomic>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/types/expected.h"
+#include "crypto/apple/keychain_v2.h"
+
+// The keychain that keychain_key_guard_mac.h installs. A separate header
+// because keychain_v2.h imports Objective-C headers, and the code that
+// installs the guard is C++.
+namespace rac {
+
+class GuardedKeychainV2 : public crypto::apple::KeychainV2 {
+ public:
+  // `inner` answers FindGenericPassword() and ItemAdd(). Every other call is
+  // KeychainV2's own, the real Security call. `on_key_seen` runs once, on the
+  // thread that read or made the key, so bind it to a task runner.
+  GuardedKeychainV2(crypto::apple::KeychainV2& inner,
+                    bool key_expected,
+                    base::OnceClosure on_key_seen);
+  GuardedKeychainV2(const GuardedKeychainV2&) = delete;
+  GuardedKeychainV2& operator=(const GuardedKeychainV2&) = delete;
+  ~GuardedKeychainV2() override;
+
+  // crypto::apple::KeychainV2:
+  base::expected<std::vector<uint8_t>, OSStatus> FindGenericPassword(
+      std::string_view service_name,
+      std::string_view account_name) override;
+  OSStatus AddGenericPassword(std::string_view service_name,
+                              std::string_view account_name,
+                              base::span<const uint8_t> password) override;
+
+  // Whether the last lookup of the storage key said "not found" while a key
+  // was expected. Set on a worker thread, read on the UI thread.
+  bool key_missing() const;
+
+  // Makes this what KeychainV2::GetInstance() returns, until
+  // ClearAsInstance().
+  void SetAsInstance();
+  void ClearAsInstance();
+
+ private:
+  static bool IsStorageKey(std::string_view service_name,
+                           std::string_view account_name);
+  void ReportKeySeen();
+
+  const raw_ref<crypto::apple::KeychainV2> inner_;
+  const bool key_expected_;
+  std::atomic<bool> key_missing_{false};
+  std::atomic<bool> key_seen_reported_{false};
+  // Moved out only by the call that flips `key_seen_reported_`.
+  base::OnceClosure on_key_seen_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_GUARDED_KEYCHAIN_MAC_H_

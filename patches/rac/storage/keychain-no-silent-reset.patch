+++ src/chrome/browser/rac/storage/keychain_key_guard_mac.mm
@@ -0,0 +1,205 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/keychain_key_guard_mac.h"
+
+#import <Foundation/Foundation.h>
+#import <Security/Security.h>
+
+#include <utility>
+
+#include "base/apple/bridging.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/rac/storage/guarded_keychain_mac.h"
+#include "chrome/browser/rac/storage/keychain_key_prefs.h"
+#include "components/os_crypt/common/keychain_password_mac.h"
+#include "components/os_crypt/common/os_crypt_switches.h"
+#include "components/prefs/pref_service.h"
+#include "crypto/apple/keychain_util.h"
+
+using base::apple::CFToNSPtrCast;
+using base::apple::NSToCFPtrCast;
+
+namespace rac {
+
+namespace {
+
+// Lives until the process exits once installed, because KeychainV2 callers
+// keep the reference GetInstance() gave them.
+GuardedKeychainV2* g_guard = nullptr;
+
+void RunOnFailure(base::OnceClosure on_failure,
+                  base::OnceClosure on_key_missing) {
+  if (g_guard && g_guard->key_missing()) {
+    std::move(on_key_missing).Run();
+    return;
+  }
+  std::move(on_failure).Run();
+}
+
+}  // namespace
+
+GuardedKeychainV2::GuardedKeychainV2(crypto::apple::KeychainV2& inner,
+                                     bool key_expected,
+                                     base::OnceClosure on_key_seen)
+    : inner_(inner),
+      key_expected_(key_expected),
+      on_key_seen_(std::move(on_key_seen)) {}
+
+GuardedKeychainV2::~GuardedKeychainV2() = default;
+
+base::expected<std::vector<uint8_t>, OSStatus>
+GuardedKeychainV2::FindGenericPassword(std::string_view service_name,
+                                       std::string_view account_name) {
+  auto result = inner_->FindGenericPassword(service_name, account_name);
+  if (!IsStorageKey(service_name, account_name)) {
+    return result;
+  }
+  // Only the latest lookup counts: AddGenericPassword() sets it again if this
+  // one said "not found".
+  key_missing_.store(false);
+  if (result.has_value()) {
+    ReportKeySeen();
+  }
+  return result;
+}
+
+OSStatus GuardedKeychainV2::AddGenericPassword(
+    std::string_view service_name,
+    std::string_view account_name,
+    base::span<const uint8_t> password) {
+  if (!IsStorageKey(service_name, account_name)) {
+    return inner_->AddGenericPassword(service_name, account_name, password);
+  }
+
+  // KeychainPassword only adds after its lookup said "not found". When this
+  // install had a key, that's a key that is missing or not visible yet, never
+  // one to replace.
+  if (key_expected_) {
+    LOG(ERROR) << "The Keychain has no storage key, but this install had one. "
+                  "Not making a new one.";
+    key_missing_.store(true);
+    return errSecItemNotFound;
+  }
+
+  // Add only. Unlike KeychainV2::AddGenericPassword(), there's no lookup
+  // first: it would ask for the item's data, which can show a second prompt,
+  // and if it found an item, the upsert would overwrite it. SecItemAdd fails
+  // with errSecDuplicateItem instead, and the provider's retry reads that
+  // item. These are the attributes upstream uses for a new item.
+  NSData* value = [NSData dataWithBytes:password.data() length:password.size()];
+  NSDictionary* attributes = @{
+    CFToNSPtrCast(kSecClass) : CFToNSPtrCast(kSecClassGenericPassword),
+    CFToNSPtrCast(kSecAttrService) : base::SysUTF8ToNSString(service_name),
+    CFToNSPtrCast(kSecAttrAccount) : base::SysUTF8ToNSString(account_name),
+    CFToNSPtrCast(kSecValueData) : value,
+    CFToNSPtrCast(kSecAttrAccessible) :
+        CFToNSPtrCast(crypto::apple::GetKeychainAccessibilityAttribute()),
+  };
+  OSStatus status = inner_->ItemAdd(NSToCFPtrCast(attributes),
+                                    /*result=*/nullptr);
+  if (status == noErr) {
+    ReportKeySeen();
+  }
+  return status;
+}
+
+bool GuardedKeychainV2::key_missing() const {
+  return key_missing_.load();
+}
+
+void GuardedKeychainV2::SetAsInstance() {
+  SetInstanceOverride(this);
+}
+
+void GuardedKeychainV2::ClearAsInstance() {
+  ClearInstanceOverride();
+}
+
+// static
+bool GuardedKeychainV2::IsStorageKey(std::string_view service_name,
+                                     std::string_view account_name) {
+  return service_name == KeychainPassword::GetServiceName() &&
+         account_name == KeychainPassword::GetAccountName();
+}
+
+void GuardedKeychainV2::ReportKeySeen() {
+  if (!key_seen_reported_.exchange(true) && on_key_seen_) {
+    std::move(on_key_seen_).Run();
+  }
+}
+
+// static
+base::OnceClosure KeychainKeyGuard::Install(PrefService* local_state,
+                                            const base::FilePath& user_data_dir,
+                                            base::OnceClosure on_failure,
+                                            base::OnceClosure on_key_missing) {
+  return InstallOver(/*inner=*/nullptr, local_state, user_data_dir,
+                     std::move(on_failure), std::move(on_key_missing));
+}
+
+// static
+base::OnceClosure KeychainKeyGuard::InstallOverForTesting(
+    crypto::apple::KeychainV2& inner,
+    PrefService* local_state,
+    const base::FilePath& user_data_dir,
+    base::OnceClosure on_failure,
+    base::OnceClosure on_key_missing) {
+  return InstallOver(&inner, local_state, user_data_dir, std::move(on_failure),
+                     std::move(on_key_missing));
+}
+
+// static
+base::OnceClosure KeychainKeyGuard::InstallOver(
+    crypto::apple::KeychainV2* inner,
+    PrefService* local_state,
+    const base::FilePath& user_data_dir,
+    base::OnceClosure on_failure,
+    base::OnceClosure on_key_missing) {
+  // Dev builds and browser tests use a fake keychain, so there's nothing to
+  // guard, and the real Keychain is never touched.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          os_crypt::switches::kUseMockKeychain)) {
+    return on_failure;
+  }
+  // One guard per process. Another instance override (only tests set them)
+  // CHECKs in SetAsInstance() below: refusing to install instead would leave
+  // the provider unguarded.
+  CHECK(!g_guard);
+  // Take the real instance before the guard replaces it.
+  if (!inner) {
+    inner = &crypto::apple::KeychainV2::GetInstance();
+  }
+  g_guard = new GuardedKeychainV2(
+      *inner, IsKeychainKeyExpected(*local_state, user_data_dir),
+      base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                         base::BindOnce(&RecordKeychainKeySeen,
+                                        base::Unretained(local_state))));
+  g_guard->SetAsInstance();
+  return base::BindOnce(&RunOnFailure, std::move(on_failure),
+                        std::move(on_key_missing));
+}
+
+// static
+GuardedKeychainV2* KeychainKeyGuard::GetForTesting() {
+  return g_guard;
+}
+
+// static
+void KeychainKeyGuard::UninstallForTesting() {
+  if (!g_guard) {
+    return;
+  }
+  g_guard->ClearAsInstance();
+  delete g_guard;
+  g_guard = nullptr;
+}
+
+}  // namespace rac

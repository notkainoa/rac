+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_PREFS_H_
+#define CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_PREFS_H_
+
+#include "base/functional/callback.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+// What Local State says about the Keychain item that holds the key for
+// cookies, saved passwords, and other os_crypt data. The guard that uses it is
+// in keychain_key_guard_mac.h. These are plain prefs, so they're registered on
+// every platform.
+namespace rac {
+
+// Local State: set the first time this install reads or makes its key. Once
+// it's set, "not found" means the key is missing, not that it was never made.
+inline constexpr char kKeychainKeySeen[] = "rac.keychain.key_seen";
+
+// Local State: set only when the user confirms "Make a New Key" in the
+// missing-key dialog. It lets the next launch make a key, and is cleared as
+// soon as a key is read or made.
+inline constexpr char kKeychainAllowNewKey[] = "rac.keychain.allow_new_key";
+
+// prefs::kProfileAttributes. Spelled out so this stays free of //chrome deps;
+// keychain_key_dialog.cc static_asserts that it still matches.
+inline constexpr char kKeychainProfilesPref[] = "profile.info_cache";
+
+void RegisterKeychainKeyPrefs(PrefRegistrySimple* registry);
+
+// Whether this install has had a key before, so a missing one must not be
+// replaced silently. True if the key was seen, or, for installs from before
+// that pref, if Local State lists any profile. Every install that ran has
+// made a key, because the Keychain key provider runs at every startup. False
+// once the user confirmed making a new key.
+bool IsKeychainKeyExpected(const PrefService& local_state);
+
+// Records that a key was read or made. Writes nothing if that's already
+// recorded, so a healthy launch doesn't touch Local State.
+void RecordKeychainKeySeen(PrefService* local_state);
+
+// The steps of the missing-key dialog.
+enum class NewKeyStep {
+  // "rac can't find its encryption key." Quit (default) or Make a New Key…
+  kKeyMissing,
+  // "Make a new key? This can't be undone." Cancel (default) or Make New Key.
+  kConfirm,
+};
+
+// Shows one step and replies true only for "Make a New Key…" or
+// "Make New Key". Anything else, including closing it, replies false.
+using AskNewKeyStep =
+    base::RepeatingCallback<void(NewKeyStep, base::OnceCallback<void(bool)>)>;
+
+// Runs the missing-key dialog: asks `kKeyMissing`, then `kConfirm`. Only when
+// both say yes, it sets kKeychainAllowNewKey and waits until Local State is
+// written. Then, whatever the answers, it runs `quit`. The next launch makes
+// the key.
+void RunNewKeychainKeyFlow(PrefService* local_state,
+                           AskNewKeyStep ask,
+                           base::OnceClosure quit);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_PREFS_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/keychain_key_prefs.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+void OnKeyMissingAnswered(PrefService* local_state,
+                          AskNewKeyStep ask,
+                          base::OnceClosure quit,
+                          bool make_new_key);
+
+void OnConfirmAnswered(PrefService* local_state,
+                       base::OnceClosure quit,
+                       bool make_new_key) {
+  if (!make_new_key) {
+    std::move(quit).Run();
+    return;
+  }
+  local_state->SetBoolean(kKeychainAllowNewKey, true);
+  // Quit only once the pref is on disk, or the next launch would still treat
+  // the key as expected and show this dialog again.
+  local_state->CommitPendingWrite(std::move(quit));
+}
+
+void OnKeyMissingAnswered(PrefService* local_state,
+                          AskNewKeyStep ask,
+                          base::OnceClosure quit,
+                          bool make_new_key) {
+  if (!make_new_key) {
+    std::move(quit).Run();
+    return;
+  }
+  ask.Run(NewKeyStep::kConfirm,
+          base::BindOnce(&OnConfirmAnswered, base::Unretained(local_state),
+                         std::move(quit)));
+}
+
+}  // namespace
+
+void RegisterKeychainKeyPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kKeychainKeySeen, false);
+  registry->RegisterBooleanPref(kKeychainAllowNewKey, false);
+}
+
+bool IsKeychainKeyExpected(const PrefService& local_state) {
+  if (local_state.GetBoolean(kKeychainAllowNewKey)) {
+    return false;
+  }
+  if (local_state.GetBoolean(kKeychainKeySeen)) {
+    return true;
+  }
+  const PrefService::Preference* profiles =
+      local_state.FindPreference(kKeychainProfilesPref);
+  if (!profiles) {
+    return false;
+  }
+  const base::DictValue* dict = profiles->GetValue()->GetIfDict();
+  return dict && !dict->empty();
+}
+
+void RecordKeychainKeySeen(PrefService* local_state) {
+  if (!local_state->GetBoolean(kKeychainKeySeen)) {
+    local_state->SetBoolean(kKeychainKeySeen, true);
+  }
+  if (local_state->HasPrefPath(kKeychainAllowNewKey)) {
+    local_state->ClearPref(kKeychainAllowNewKey);
+  }
+}
+
+void RunNewKeychainKeyFlow(PrefService* local_state,
+                           AskNewKeyStep ask,
+                           base::OnceClosure quit) {
+  AskNewKeyStep ask_copy = ask;
+  ask_copy.Run(
+      NewKeyStep::kKeyMissing,
+      base::BindOnce(&OnKeyMissingAnswered, base::Unretained(local_state),
+                     std::move(ask), std::move(quit)));
+}
+
+}  // namespace rac

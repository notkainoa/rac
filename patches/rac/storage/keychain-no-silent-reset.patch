+    std::unique_ptr<PrefService> local_state =
+        LoadLocalState(user_data.GetPath().AppendASCII("Local State"));
+    EXPECT_EQ(local_state->GetInitializationStatus(),
+              PrefService::INITIALIZATION_STATUS_CREATED_NEW_PREF_STORE);
+    bool added = AddsKey(local_state.get(), user_data.GetPath());
+    local_state.reset();
+    task_environment_.RunUntilIdle();
+    return added;
+  };
+
+  // A first run.
+  EXPECT_TRUE(adds_key_with({}));
+  // A first run can write Default/Preferences from initial preferences before
+  // the key exists.
+  EXPECT_TRUE(adds_key_with({"Default/Preferences"}));
+
+  // Cookies, in either place, or saved passwords, in any profile folder.
+  EXPECT_FALSE(adds_key_with({"Default/Network/Cookies"}));
+  EXPECT_FALSE(adds_key_with({"Default/Cookies"}));
+  EXPECT_FALSE(adds_key_with({"Default/Login Data"}));
+  EXPECT_FALSE(adds_key_with({"Profile 2/Login Data"}));
+  EXPECT_FALSE(adds_key_with({"Default/Preferences", "Work/Network/Cookies"}));
+
+  // A missing user data folder has none.
+  base::ScopedTempDir empty;
+  ASSERT_TRUE(empty.CreateUniqueTempDir());
+  EXPECT_FALSE(HasProfileData(empty.GetPath().AppendASCII("missing")));

+// Local State that can't be read, or whose profile list is empty or isn't a
+// dictionary, says nothing either way, so the profile folders decide.
+TEST_F(KeychainKeyGuardTest, UnreadableLocalStateChecksProfileFolders) {
+  struct Case {
+    const char* json;
+    PrefService::PrefInitializationStatus status;
+  };
+  const Case kCases[] = {
+      {"{ not json", PrefService::INITIALIZATION_STATUS_ERROR},
+      {"[]", PrefService::INITIALIZATION_STATUS_ERROR},
+      {R"({"profile": {"info_cache": {}}})",
+       PrefService::INITIALIZATION_STATUS_SUCCESS},
+      {R"({"profile": {"info_cache": []}})",
+       PrefService::INITIALIZATION_STATUS_SUCCESS},
+      {R"({"profile": {"info_cache": "Default"}})",
+       PrefService::INITIALIZATION_STATUS_SUCCESS},
+  };
+  for (const Case& c : kCases) {
+    for (bool profile_data : {false, true}) {
+      SCOPED_TRACE(testing::Message() << c.json << " " << profile_data);
+      base::ScopedTempDir user_data;
+      ASSERT_TRUE(user_data.CreateUniqueTempDir());
+      const base::FilePath path =
+          user_data.GetPath().AppendASCII("Local State");
+      ASSERT_TRUE(base::WriteFile(path, c.json));
+      if (profile_data) {
+        MakeFile(user_data.GetPath(), "Default/Network/Cookies");
+      }
+      std::unique_ptr<PrefService> local_state = LoadLocalState(path);
+      EXPECT_EQ(local_state->GetInitializationStatus(), c.status);
+      EXPECT_FALSE(local_state->GetBoolean(kKeychainKeySeen));
+      EXPECT_EQ(AddsKey(local_state.get(), user_data.GetPath()), !profile_data);
+      local_state.reset();
+      task_environment_.RunUntilIdle();
+    }
+  }
+}
+
+// If Local State can't be written, a lost marker or a lost allow_new_key
+// leaves the next launch failing closed, never making a key it shouldn't.
+TEST_F(KeychainKeyGuardTest, LocalStateWriteFailureFailsClosed) {
+  base::ScopedTempDir user_data;
+  ASSERT_TRUE(user_data.CreateUniqueTempDir());
+  const base::FilePath dir = user_data.GetPath();
+  const base::FilePath path = dir.AppendASCII("Local State");
+  // A read-only folder: Local State reads, and every write fails.
+  auto set_writable = [&](bool writable) {
+    ASSERT_TRUE(base::SetPosixFilePermissions(dir, writable ? 0700 : 0500));
+  };
+  base::ScopedClosureRunner restore(
+      base::BindLambdaForTesting([&]() { set_writable(true); }));
+
+  // The marker. A first launch makes the key, and the marker is lost.
+  ASSERT_TRUE(base::WriteFile(path, "{}"));
+  set_writable(false);
+  {
+    std::unique_ptr<PrefService> local_state = LoadLocalState(path);
+    EXPECT_TRUE(AddsKey(local_state.get(), dir));
+    EXPECT_TRUE(local_state->GetBoolean(kKeychainKeySeen));
+    local_state->CommitPendingWrite();
+    task_environment_.RunUntilIdle();
+    local_state.reset();
+    task_environment_.RunUntilIdle();
+  }
+  set_writable(true);
+  std::string contents;
+  ASSERT_TRUE(base::ReadFileToString(path, &contents));
+  EXPECT_EQ(contents, "{}");
+  // The profile then wrote its data, which the next launch finds instead.
+  MakeFile(dir, "Default/Network/Cookies");
+  {
+    std::unique_ptr<PrefService> local_state = LoadLocalState(path);
+    EXPECT_FALSE(local_state->GetBoolean(kKeychainKeySeen));
+    EXPECT_FALSE(AddsKey(local_state.get(), dir));
+    local_state.reset();
+    task_environment_.RunUntilIdle();
+  }
+
+  // allow_new_key. The user confirms a new key; rac still quits, and the next
+  // launch asks again instead of making one.
+  ASSERT_TRUE(
+      base::WriteFile(path, R"({"rac": {"keychain": {"key_seen": true}}})"));
+  set_writable(false);
+  {
+    std::unique_ptr<PrefService> local_state = LoadLocalState(path);
+    ASSERT_TRUE(local_state->GetBoolean(kKeychainKeySeen));
+    bool quit = false;
+    RunNewKeychainKeyFlow(
+        local_state.get(),
+        base::BindRepeating(
+            [](NewKeyStep, base::OnceCallback<void(bool)> reply) {
+              std::move(reply).Run(true);
+            }),
+        base::BindLambdaForTesting([&]() { quit = true; }));
+    task_environment_.RunUntilIdle();
+    EXPECT_TRUE(quit);
+    EXPECT_TRUE(local_state->GetBoolean(kKeychainAllowNewKey));
+    local_state.reset();
+    task_environment_.RunUntilIdle();
+  }
+  set_writable(true);
+  {
+    std::unique_ptr<PrefService> local_state = LoadLocalState(path);
+    EXPECT_FALSE(local_state->GetBoolean(kKeychainAllowNewKey));
+    ScriptedKeychain keychain;
+    EXPECT_FALSE(RunProvider(Install(keychain, local_state.get(), dir)));
+    EXPECT_EQ(keychain.add_calls(), 0);
+    EXPECT_EQ(rac_dialogs_, 1);
+    KeychainKeyGuard::UninstallForTesting();
+  }
+}
+
+// The guard must be what GetInstance() returns, or the provider would run
+// unguarded. So installing over another override, or twice, crashes instead
+// of going on without it. Only tests set overrides.
+TEST_F(KeychainKeyGuardTest, InstallingOverAnotherOverrideChecks) {
+  ScriptedKeychain other;
+  other.SetAsInstance();
+  ScriptedKeychain keychain;
+  EXPECT_CHECK_DEATH({ base::OnceClosure on_failure = Install(keychain); });
+  other.ClearAsInstance();
+
+  base::OnceClosure on_failure = Install(keychain);
+  EXPECT_EQ(&crypto::apple::KeychainV2::GetInstance(),
+            KeychainKeyGuard::GetForTesting());
+  EXPECT_CHECK_DEATH({ base::OnceClosure again = Install(keychain); });
+}
+
+}  // namespace
+}  // namespace rac

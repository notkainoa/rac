--- /dev/null
+++ src/chrome/browser/rac/storage/keychain_key_guard_mac.h
@@ -0,0 +1,84 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_GUARD_MAC_H_
+#define CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_GUARD_MAC_H_
+
+#include "base/functional/callback.h"
+
+class PrefService;
+
+namespace base {
+class FilePath;
+}
+
+namespace crypto::apple {
+class KeychainV2;
+}
+
+// Chromium makes a new storage key as soon as the Keychain says "not found",
+// and KeychainV2::AddGenericPassword() is an upsert. If the lookup only
+// failed for a moment, as it can while the login keychain is coming up, the
+// new key makes every cookie, saved password, and AI provider key unreadable,
+// and the upsert can overwrite the real item that appeared in the meantime.
+//
+// rac installs GuardedKeychainV2 (guarded_keychain_mac.h) as
+// KeychainV2::GetInstance(), which is what KeychainKeyProvider uses outside
+// tests, so nothing in //crypto or //components changes:
+// - When a key is expected (see IsKeychainKeyExpected()), "not found" adds
+//   nothing and stays an error. Helium's fail-closed provider retries, then
+//   gives up, and rac's missing-key dialog offers a confirmed new key.
+// - When no key is expected, the key is added with SecItemAdd only. If an
+//   item appeared, that fails with errSecDuplicateItem, and the provider's
+//   retry reads the existing item. Nothing is ever updated or overwritten.
+// Calls for any other Keychain item pass through unchanged.
+//
+// browser_process_impl.cc installs it through rac::GuardKeychainKey()
+// (keychain_key_dialog.h), so Helium's line there changes as little as
+// possible.
+namespace rac {
+
+class GuardedKeychainV2;
+
+class KeychainKeyGuard {
+ public:
+  // Call on the UI thread while building Helium's KeychainKeyProvider, before
+  // it asks for the key and before any profile loads. Installs the guard, and
+  // returns the closure the provider runs when it gives up: `on_key_missing`
+  // if the key was expected and not found, otherwise Helium's `on_failure`.
+  // With --use-mock-keychain, installs nothing and returns `on_failure`.
+  //
+  // `user_data_dir` is checked for profile data only when Local State can't
+  // say whether a key existed (see IsKeychainKeyExpected()), which blocks on
+  // disk. Startup still allows that here, and it's rare.
+  //
+  // Installing twice, or over another KeychainV2 instance override, CHECKs.
+  // Only tests set overrides, and going on unguarded could replace the key.
+  static base::OnceClosure Install(PrefService* local_state,
+                                   const base::FilePath& user_data_dir,
+                                   base::OnceClosure on_failure,
+                                   base::OnceClosure on_key_missing);
+
+  // As Install(), but guards `inner` instead of the real Keychain.
+  static base::OnceClosure InstallOverForTesting(
+      crypto::apple::KeychainV2& inner,
+      PrefService* local_state,
+      const base::FilePath& user_data_dir,
+      base::OnceClosure on_failure,
+      base::OnceClosure on_key_missing);
+
+  static GuardedKeychainV2* GetForTesting();
+  static void UninstallForTesting();
+
+ private:
+  static base::OnceClosure InstallOver(crypto::apple::KeychainV2* inner,
+                                       PrefService* local_state,
+                                       const base::FilePath& user_data_dir,
+                                       base::OnceClosure on_failure,
+                                       base::OnceClosure on_key_missing);
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_STORAGE_KEYCHAIN_KEY_GUARD_MAC_H_

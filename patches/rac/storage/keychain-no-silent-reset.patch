--- /dev/null
+++ src/chrome/browser/rac/storage/keychain_key_guard_mac_unittest.mm
@@ -0,0 +1,468 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/keychain_key_guard_mac.h"
+
+#import <Foundation/Foundation.h>
+#import <Security/Security.h>
+
+#include <deque>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/apple/bridging.h"
+#include "base/apple/foundation_util.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/test/scoped_command_line.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/rac/storage/guarded_keychain_mac.h"
+#include "chrome/browser/rac/storage/keychain_key_prefs.h"
+#include "components/os_crypt/async/browser/keychain_key_provider.h"
+#include "components/os_crypt/async/browser/os_crypt_async.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "components/os_crypt/common/keychain_password_mac.h"
+#include "components/os_crypt/common/os_crypt_switches.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+using base::apple::CFToNSPtrCast;
+
+namespace rac {
+namespace {
+
+// A keychain with at most one item, the storage key. Nothing here reaches
+// the real Keychain: every KeychainV2 call that KeychainPassword, the guard,
+// or upstream's AddGenericPassword() can make is answered here.
+class ScriptedKeychain : public crypto::apple::KeychainV2 {
+ public:
+  ScriptedKeychain() = default;
+  ~ScriptedKeychain() override = default;
+
+  // The item exists, with this password.
+  void Store(std::string password) { item_ = std::move(password); }
+  // The next FindGenericPassword() calls return these, before the item
+  // answers. noErr is not allowed here; use Store().
+  void ScriptFind(std::vector<OSStatus> results) {
+    script_.assign(results.begin(), results.end());
+  }
+  // The item appears just before the next ItemAdd(), as if another process or
+  // a slow login made it visible after the lookup.
+  void AppearBeforeAdd(std::string password) {
+    appear_before_add_ = std::move(password);
+  }
+
+  const std::optional<std::string>& item() const { return item_; }
+  int find_calls() const { return find_calls_; }
+  int add_calls() const { return add_calls_; }
+  int update_calls() const { return update_calls_; }
+  int copy_matching_calls() const { return copy_matching_calls_; }
+  NSDictionary* last_add() const { return last_add_; }
+
+  // crypto::apple::KeychainV2:
+  base::expected<std::vector<uint8_t>, OSStatus> FindGenericPassword(
+      std::string_view service_name,
+      std::string_view account_name) override {
+    ++find_calls_;
+    if (!script_.empty()) {
+      OSStatus status = script_.front();
+      script_.pop_front();
+      return base::unexpected(status);
+    }
+    if (!item_) {
+      return base::unexpected(errSecItemNotFound);
+    }
+    auto bytes = base::as_byte_span(*item_);
+    return std::vector<uint8_t>(bytes.begin(), bytes.end());
+  }
+
+  OSStatus ItemAdd(CFDictionaryRef attributes, CFTypeRef* result) override {
+    ++add_calls_;
+    if (appear_before_add_) {
+      item_ = std::move(appear_before_add_);
+      appear_before_add_.reset();
+    }
+    if (item_) {
+      return errSecDuplicateItem;
+    }
+    last_add_ = [base::apple::CFToNSPtrCast(attributes) copy];
+    item_ = PasswordFrom(attributes);
+    return noErr;
+  }
+
+  OSStatus ItemCopyMatching(CFDictionaryRef query, CFTypeRef* result) override {
+    ++copy_matching_calls_;
+    return item_ ? OSStatus{noErr} : OSStatus{errSecItemNotFound};
+  }
+
+  OSStatus ItemUpdate(CFDictionaryRef query,
+                      CFDictionaryRef keychain_data) override {
+    ++update_calls_;
+    item_ = PasswordFrom(keychain_data);
+    return noErr;
+  }
+
+  OSStatus ItemDelete(CFDictionaryRef query) override {
+    ADD_FAILURE() << "Nothing should delete the item.";
+    return errSecUnimplemented;
+  }
+
+ private:
+  static std::string PasswordFrom(CFDictionaryRef dict) {
+    NSData* data = base::apple::ObjCCast<NSData>(
+        base::apple::CFToNSPtrCast(dict)[CFToNSPtrCast(kSecValueData)]);
+    return std::string(static_cast<const char*>(data.bytes), data.length);
+  }
+
+  std::optional<std::string> item_;
+  std::deque<OSStatus> script_;
+  std::optional<std::string> appear_before_add_;
+  NSDictionary* __strong last_add_ = nil;
+  int find_calls_ = 0;
+  int add_calls_ = 0;
+  int update_calls_ = 0;
+  int copy_matching_calls_ = 0;
+};
+
+class KeychainKeyGuardTest : public ::testing::Test {
+ protected:
+  KeychainKeyGuardTest() {
+    RegisterKeychainKeyPrefs(local_state_.registry());
+    local_state_.registry()->RegisterDictionaryPref(kKeychainProfilesPref);
+  }
+
+  void SetUp() override {
+    ASSERT_FALSE(base::CommandLine::ForCurrentProcess()->HasSwitch(
+        os_crypt::switches::kUseMockKeychain));
+    ASSERT_FALSE(KeychainKeyGuard::GetForTesting());
+  }
+
+  void TearDown() override { KeychainKeyGuard::UninstallForTesting(); }
+
+  // Installs the guard over `keychain` the way BrowserProcessImpl does, with
+  // counters for Helium's dialog and rac's.
+  base::OnceClosure Install(ScriptedKeychain& keychain) {
+    return KeychainKeyGuard::InstallOverForTesting(
+        keychain, &local_state_,
+        base::BindOnce([](int* count) { ++*count; }, &helium_dialogs_),
+        base::BindOnce([](int* count) { ++*count; }, &rac_dialogs_));
+  }
+
+  // Builds Helium's fail-closed provider inside OSCryptAsync, as
+  // BrowserProcessImpl does, and lets every retry run. Returns the encryptor,
+  // or null if the provider never delivered a key.
+  scoped_refptr<os_crypt_async::Encryptor> RunProvider(
+      base::OnceClosure on_failure) {
+    // Without the guard, the provider would use the real Keychain.
+    CHECK(KeychainKeyGuard::GetForTesting());
+    std::vector<std::pair<os_crypt_async::OSCryptAsync::Precedence,
+                          std::unique_ptr<os_crypt_async::KeyProvider>>>
+        providers;
+    providers.emplace_back(
+        10u, std::make_unique<os_crypt_async::KeychainKeyProvider>(
+                 std::move(on_failure)));
+    os_crypt_async::OSCryptAsync os_crypt(std::move(providers));
+    scoped_refptr<os_crypt_async::Encryptor> encryptor;
+    os_crypt.GetInstance(base::BindOnce(
+        [](scoped_refptr<os_crypt_async::Encryptor>* out,
+           scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+          *out = std::move(encryptor);
+        },
+        &encryptor));
+    // Helium retries 3 times, 1 s apart.
+    task_environment_.FastForwardBy(base::Seconds(10));
+    return encryptor;
+  }
+
+  // What the encryptor for `password` makes of a fixed string. The Keychain
+  // key's encryption (AES-128-CBC, fixed IV) is deterministic, so equal output
+  // means an equal key.
+  // Uses its own Local State, so the test's isn't marked as having a key.
+  std::string EncryptWithKeyFrom(const std::string& password) {
+    TestingPrefServiceSimple local_state;
+    RegisterKeychainKeyPrefs(local_state.registry());
+    ScriptedKeychain keychain;
+    keychain.Store(password);
+    base::OnceClosure on_failure = KeychainKeyGuard::InstallOverForTesting(
+        keychain, &local_state, base::DoNothing(), base::DoNothing());
+    scoped_refptr<os_crypt_async::Encryptor> encryptor =
+        RunProvider(std::move(on_failure));
+    KeychainKeyGuard::UninstallForTesting();
+    return Encrypt(encryptor);
+  }
+
+  static std::string Encrypt(
+      const scoped_refptr<os_crypt_async::Encryptor>& encryptor) {
+    std::string ciphertext;
+    CHECK(encryptor);
+    CHECK(encryptor->EncryptString("probe", &ciphertext));
+    return ciphertext;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  TestingPrefServiceSimple local_state_;
+  int helium_dialogs_ = 0;
+  int rac_dialogs_ = 0;
+};
+
+// The plan's test. A slow login: the first lookup says "not found", and the
+// real item is there by the retry. Upstream adds a second key on the first
+// attempt and uses it.
+TEST_F(KeychainKeyGuardTest, NotFoundThenFoundWritesNoSecondKey) {
+  const std::string expected = EncryptWithKeyFrom("existing");
+  ASSERT_NE(expected, EncryptWithKeyFrom("other"));
+
+  local_state_.SetBoolean(kKeychainKeySeen, true);
+  ScriptedKeychain keychain;
+  keychain.Store("existing");
+  keychain.ScriptFind({errSecItemNotFound});
+  scoped_refptr<os_crypt_async::Encryptor> encryptor =
+      RunProvider(Install(keychain));
+
+  ASSERT_TRUE(encryptor);
+  EXPECT_EQ(Encrypt(encryptor), expected);
+  EXPECT_EQ(keychain.find_calls(), 2);
+  EXPECT_EQ(keychain.add_calls(), 0);
+  EXPECT_EQ(keychain.update_calls(), 0);
+  EXPECT_EQ(keychain.copy_matching_calls(), 0);
+  EXPECT_EQ(keychain.item(), "existing");
+  EXPECT_EQ(helium_dialogs_, 0);
+  EXPECT_EQ(rac_dialogs_, 0);
+}
+
+TEST_F(KeychainKeyGuardTest, ExpectedKeyMissingFailsClosed) {
+  local_state_.SetBoolean(kKeychainKeySeen, true);
+  ScriptedKeychain keychain;
+  scoped_refptr<os_crypt_async::Encryptor> encryptor =
+      RunProvider(Install(keychain));
+
+  // The key callback never ran, so nothing loads without the key.
+  EXPECT_FALSE(encryptor);
+  // The first try and 3 retries, none of which added anything.
+  EXPECT_EQ(keychain.find_calls(), 4);
+  EXPECT_EQ(keychain.add_calls(), 0);
+  EXPECT_EQ(keychain.update_calls(), 0);
+  EXPECT_FALSE(keychain.item());
+  EXPECT_TRUE(KeychainKeyGuard::GetForTesting()->key_missing());
+  // rac's dialog, which can make a new key, instead of Helium's.
+  EXPECT_EQ(rac_dialogs_, 1);
+  EXPECT_EQ(helium_dialogs_, 0);
+}
+
+TEST_F(KeychainKeyGuardTest, ExpectedKeyNotFoundAddsNothing) {
+  ScriptedKeychain keychain;
+  GuardedKeychainV2 guard(keychain, /*key_expected=*/true, base::DoNothing());
+  KeychainPassword password(guard);
+
+  auto result = password.GetPasswordWithError();
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(), errSecItemNotFound);
+  EXPECT_TRUE(guard.key_missing());
+  EXPECT_EQ(keychain.add_calls(), 0);
+  EXPECT_EQ(keychain.update_calls(), 0);
+  EXPECT_FALSE(keychain.item());
+}
+
+TEST_F(KeychainKeyGuardTest, AddNeverOverwritesAnExistingItem) {
+  // Upstream's upsert, on the same fake, would overwrite the item. This shows
+  // the fake can tell.
+  {
+    ScriptedKeychain keychain;
+    keychain.Store("existing");
+    const std::string fresh = "fresh";
+    EXPECT_EQ(keychain.AddGenericPassword("rac Storage Key", "rac",
+                                          base::as_byte_span(fresh)),
+              noErr);
+    EXPECT_EQ(keychain.update_calls(), 1);
+    EXPECT_EQ(keychain.item(), "fresh");
+  }
+
+  // Directly: the add fails as a duplicate and the item is untouched.
+  {
+    ScriptedKeychain keychain;
+    keychain.AppearBeforeAdd("existing");
+    GuardedKeychainV2 guard(keychain, /*key_expected=*/false,
+                            base::DoNothing());
+    auto result = KeychainPassword(guard).GetPasswordWithError();
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), errSecDuplicateItem);
+    EXPECT_FALSE(guard.key_missing());
+    EXPECT_EQ(keychain.update_calls(), 0);
+    EXPECT_EQ(keychain.copy_matching_calls(), 0);
+    EXPECT_EQ(keychain.item(), "existing");
+  }
+
+  // Through the provider: its retry reads the item that won.
+  const std::string expected = EncryptWithKeyFrom("existing");
+  ScriptedKeychain keychain;
+  keychain.AppearBeforeAdd("existing");
+  scoped_refptr<os_crypt_async::Encryptor> encryptor =
+      RunProvider(Install(keychain));
+  ASSERT_TRUE(encryptor);
+  EXPECT_EQ(Encrypt(encryptor), expected);
+  EXPECT_EQ(keychain.add_calls(), 1);
+  EXPECT_EQ(keychain.update_calls(), 0);
+  EXPECT_EQ(keychain.item(), "existing");
+  EXPECT_EQ(helium_dialogs_, 0);
+  EXPECT_EQ(rac_dialogs_, 0);
+}
+
+TEST_F(KeychainKeyGuardTest, UnexpectedMissingKeyIsAddedOnce) {
+  ScriptedKeychain keychain;
+  int key_seen = 0;
+  GuardedKeychainV2 guard(
+      keychain, /*key_expected=*/false,
+      base::BindOnce([](int* count) { ++*count; }, &key_seen));
+  KeychainPassword password(guard);
+
+  auto made = password.GetPasswordWithError();
+  ASSERT_TRUE(made.has_value());
+  ASSERT_FALSE(made->empty());
+  EXPECT_EQ(keychain.add_calls(), 1);
+  // No lookup that asks for the item's data, so no second prompt.
+  EXPECT_EQ(keychain.copy_matching_calls(), 0);
+  EXPECT_EQ(keychain.update_calls(), 0);
+  EXPECT_EQ(key_seen, 1);
+
+  NSDictionary* add = keychain.last_add();
+  ASSERT_TRUE(add);
+  EXPECT_EQ(add.count, 5u);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecClass)]
+      isEqual:CFToNSPtrCast(kSecClassGenericPassword)]);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecAttrService)] isEqual:@"rac Storage Key"]);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecAttrAccount)] isEqual:@"rac"]);
+  EXPECT_TRUE([add[CFToNSPtrCast(kSecAttrAccessible)]
+      isEqual:CFToNSPtrCast(kSecAttrAccessibleWhenUnlocked)]);
+  EXPECT_EQ(keychain.item(), *made);
+
+  // The next read finds it and adds nothing.
+  auto read = password.GetPasswordWithError();
+  ASSERT_TRUE(read.has_value());
+  EXPECT_EQ(*read, *made);
+  EXPECT_EQ(keychain.add_calls(), 1);
+  EXPECT_EQ(key_seen, 1);
+}
+
+TEST_F(KeychainKeyGuardTest, ErrorIsNotTreatedAsMissing) {
+  // Directly: an error is passed on, and nothing is added.
+  {
+    ScriptedKeychain keychain;
+    keychain.ScriptFind({errSecInteractionNotAllowed});
+    GuardedKeychainV2 guard(keychain, /*key_expected=*/false,
+                            base::DoNothing());
+    auto result = KeychainPassword(guard).GetPasswordWithError();
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), errSecInteractionNotAllowed);
+    EXPECT_FALSE(guard.key_missing());
+    EXPECT_EQ(keychain.add_calls(), 0);
+  }
+
+  // Through the provider, with a key expected: Helium's dialog, not rac's,
+  // so nobody is offered a new key because the Keychain was locked. Only
+  // the last attempt counts.
+  local_state_.SetBoolean(kKeychainKeySeen, true);
+  ScriptedKeychain keychain;
+  keychain.ScriptFind({errSecItemNotFound, errSecItemNotFound,
+                       errSecItemNotFound, errSecInteractionNotAllowed});
+  scoped_refptr<os_crypt_async::Encryptor> encryptor =
+      RunProvider(Install(keychain));
+  EXPECT_FALSE(encryptor);
+  EXPECT_EQ(keychain.find_calls(), 4);
+  EXPECT_EQ(keychain.add_calls(), 0);
+  EXPECT_FALSE(KeychainKeyGuard::GetForTesting()->key_missing());
+  EXPECT_EQ(helium_dialogs_, 1);
+  EXPECT_EQ(rac_dialogs_, 0);
+}
+
+TEST_F(KeychainKeyGuardTest, ExpectationComesFromLocalState) {
+  // Whether the guard lets KeychainPassword add a key to an empty keychain.
+  auto adds_key = [&]() {
+    ScriptedKeychain keychain;
+    base::OnceClosure on_failure = Install(keychain);
+    bool added = KeychainPassword(*KeychainKeyGuard::GetForTesting())
+                     .GetPasswordWithError()
+                     .has_value();
+    KeychainKeyGuard::UninstallForTesting();
+    task_environment_.RunUntilIdle();
+    local_state_.ClearPref(kKeychainKeySeen);
+    return added;
+  };
+
+  // A fresh Local State: a first launch, so a key may be made.
+  EXPECT_TRUE(adds_key());
+
+  // The marker.
+  local_state_.SetBoolean(kKeychainKeySeen, true);
+  EXPECT_FALSE(adds_key());
+
+  // No marker, but a profile: an install from before the marker.
+  local_state_.SetDict(
+      kKeychainProfilesPref,
+      base::DictValue().Set("Default", base::DictValue().Set("name", "Me")));
+  EXPECT_FALSE(adds_key());
+
+  // The user confirmed a new key, which overrides both.
+  local_state_.SetBoolean(kKeychainKeySeen, true);
+  local_state_.SetBoolean(kKeychainAllowNewKey, true);
+  EXPECT_TRUE(adds_key());
+  local_state_.ClearPref(kKeychainProfilesPref);
+
+  // With --use-mock-keychain, as in dev builds and browser tests, nothing is
+  // installed, and Helium's failure closure comes back as it was.
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch(
+      os_crypt::switches::kUseMockKeychain);
+  base::OnceClosure on_failure = KeychainKeyGuard::Install(
+      &local_state_,
+      base::BindOnce([](int* count) { ++*count; }, &helium_dialogs_),
+      base::BindOnce([](int* count) { ++*count; }, &rac_dialogs_));
+  EXPECT_FALSE(KeychainKeyGuard::GetForTesting());
+  std::move(on_failure).Run();
+  EXPECT_EQ(helium_dialogs_, 1);
+  EXPECT_EQ(rac_dialogs_, 0);
+}
+
+TEST_F(KeychainKeyGuardTest, KeySeenIsRecordedOnce) {
+  // As after a confirmed new key: allow_new_key set, no marker yet.
+  local_state_.SetBoolean(kKeychainAllowNewKey, true);
+  ScriptedKeychain keychain;
+  keychain.Store("existing");
+  base::OnceClosure on_failure = Install(keychain);
+
+  int changes = 0;
+  PrefChangeRegistrar registrar;
+  registrar.Init(&local_state_);
+  auto count = base::BindRepeating([](int* count) { ++*count; }, &changes);
+  registrar.Add(kKeychainKeySeen, count);
+  registrar.Add(kKeychainAllowNewKey, count);
+
+  KeychainPassword password(*KeychainKeyGuard::GetForTesting());
+  ASSERT_TRUE(password.GetPasswordWithError().has_value());
+  // Recorded on the UI thread, not on the Keychain worker.
+  EXPECT_EQ(changes, 0);
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(local_state_.GetBoolean(kKeychainKeySeen));
+  EXPECT_FALSE(local_state_.HasPrefPath(kKeychainAllowNewKey));
+  EXPECT_EQ(changes, 2);
+
+  // Later reads, and recording it again, write nothing.
+  ASSERT_TRUE(password.GetPasswordWithError().has_value());
+  task_environment_.RunUntilIdle();
+  RecordKeychainKeySeen(&local_state_);
+  EXPECT_EQ(changes, 2);
+}
+
+}  // namespace
+}  // namespace rac

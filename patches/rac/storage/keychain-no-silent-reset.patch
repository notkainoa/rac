+// The whole way out of a missing key: rac's dialog, the user's two yeses,
+// and the relaunch that may make the key.
+TEST_F(KeychainKeyGuardTest, ConfirmedNewKeyThenRelaunch) {
+  const std::string old_key = EncryptWithKeyFrom("old");
+  local_state_.SetBoolean(kKeychainKeySeen, true);
+
+  // The key is missing: rac's dialog, and nothing added.
+  {
+    ScriptedKeychain keychain;
+    EXPECT_FALSE(RunProvider(Install(keychain)));
+    EXPECT_EQ(keychain.add_calls(), 0);
+    EXPECT_EQ(rac_dialogs_, 1);
+    KeychainKeyGuard::UninstallForTesting();
+  }
+
+  // The user says yes twice, and rac quits.
+  auto confirm = [&]() {
+    bool quit = false;
+    RunNewKeychainKeyFlow(
+        &local_state_,
+        base::BindRepeating(
+            [](NewKeyStep, base::OnceCallback<void(bool)> reply) {
+              std::move(reply).Run(true);
+            }),
+        base::BindLambdaForTesting([&]() { quit = true; }));
+    task_environment_.RunUntilIdle();
+    EXPECT_TRUE(quit);
+    EXPECT_TRUE(local_state_.GetBoolean(kKeychainAllowNewKey));
+  };
+  confirm();
+
+  // The relaunch. The first lookup says "not found" for a moment, and the old
+  // item is back by the add: the add fails as a duplicate, and the retry uses
+  // the old key. Nothing is overwritten.
+  {
+    ScriptedKeychain keychain;
+    keychain.Store("old");
+    keychain.ScriptFind({errSecItemNotFound});
+    scoped_refptr<os_crypt_async::Encryptor> encryptor =
+        RunProvider(Install(keychain));
+    ASSERT_TRUE(encryptor);
+    EXPECT_EQ(Encrypt(encryptor), old_key);
+    EXPECT_EQ(keychain.add_calls(), 1);
+    EXPECT_EQ(keychain.update_calls(), 0);
+    EXPECT_EQ(keychain.item(), "old");
+    KeychainKeyGuard::UninstallForTesting();
+  }
+  // Reading the old key used up the permission to make one.
+  EXPECT_FALSE(local_state_.HasPrefPath(kKeychainAllowNewKey));
+  EXPECT_TRUE(IsKeychainKeyExpected(local_state_, base::FilePath()));
+
+  // Again, with the old item really gone: the relaunch makes one key, once.
+  confirm();
+  ScriptedKeychain keychain;
+  keychain.ScriptFind({errSecItemNotFound});
+  scoped_refptr<os_crypt_async::Encryptor> encryptor =
+      RunProvider(Install(keychain));
+  ASSERT_TRUE(encryptor);
+  const std::string new_key = Encrypt(encryptor);
+  EXPECT_NE(new_key, old_key);
+  EXPECT_EQ(keychain.add_calls(), 1);
+  EXPECT_TRUE(keychain.item());
+  KeychainKeyGuard::UninstallForTesting();
+  EXPECT_FALSE(local_state_.HasPrefPath(kKeychainAllowNewKey));
+
+  // The launch after that has a brief "not found" too. The new key is expected
+  // now, so nothing is added, and the retry reads it.
+  keychain.ScriptFind({errSecItemNotFound});
+  encryptor = RunProvider(Install(keychain));
+  ASSERT_TRUE(encryptor);
+  EXPECT_EQ(Encrypt(encryptor), new_key);
+  EXPECT_EQ(keychain.add_calls(), 1);
+  EXPECT_EQ(keychain.update_calls(), 0);
+  EXPECT_EQ(rac_dialogs_, 1);
+  EXPECT_EQ(helium_dialogs_, 0);
+}

+++ src/chrome/browser/rac/storage/keychain_key_prefs_unittest.cc
@@ -0,0 +1,155 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/storage/keychain_key_prefs.h"
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/test/task_environment.h"
+#include "base/values.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+// Answers each step of the missing-key dialog from a script, as a user would.
+class FakeAsker {
+ public:
+  explicit FakeAsker(std::vector<bool> answers)
+      : answers_(std::move(answers)) {}
+
+  AskNewKeyStep Callback() {
+    return base::BindRepeating(&FakeAsker::Ask, base::Unretained(this));
+  }
+
+  const std::vector<NewKeyStep>& asked() const { return asked_; }
+
+ private:
+  void Ask(NewKeyStep step, base::OnceCallback<void(bool)> reply) {
+    asked_.push_back(step);
+    ASSERT_LT(asked_.size() - 1, answers_.size());
+    std::move(reply).Run(answers_[asked_.size() - 1]);
+  }
+
+  std::vector<bool> answers_;
+  std::vector<NewKeyStep> asked_;
+};
+
+class KeychainKeyPrefsTest : public ::testing::Test {
+ protected:
+  KeychainKeyPrefsTest() {
+    RegisterKeychainKeyPrefs(local_state_.registry());
+    local_state_.registry()->RegisterDictionaryPref(kKeychainProfilesPref);
+  }
+
+  // Runs the flow with `answers` and reports whether Local State was
+  // committed by the time rac quit, or nullopt if it never quit.
+  std::optional<bool> RunFlow(FakeAsker& asker) {
+    std::optional<bool> committed_at_quit;
+    RunNewKeychainKeyFlow(
+        &local_state_, asker.Callback(),
+        base::BindOnce(
+            [](std::optional<bool>* out, TestingPrefStore* store) {
+              *out = store->committed();
+            },
+            &committed_at_quit,
+            base::Unretained(local_state_.user_prefs_store().get())));
+    task_environment_.RunUntilIdle();
+    return committed_at_quit;
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  TestingPrefServiceSimple local_state_;
+};
+
+TEST_F(KeychainKeyPrefsTest, NewKeyNeedsTwoConfirmations) {
+  // Quit at the first step: no second step, nothing written.
+  {
+    FakeAsker asker({false});
+    EXPECT_TRUE(RunFlow(asker).has_value());
+    EXPECT_EQ(asker.asked(), std::vector<NewKeyStep>{NewKeyStep::kKeyMissing});
+    EXPECT_FALSE(local_state_.HasPrefPath(kKeychainAllowNewKey));
+  }
+  // Make a New Key…, then Cancel: still nothing written, and rac quits.
+  {
+    FakeAsker asker({true, false});
+    EXPECT_TRUE(RunFlow(asker).has_value());
+    EXPECT_EQ(asker.asked(), (std::vector<NewKeyStep>{NewKeyStep::kKeyMissing,
+                                                      NewKeyStep::kConfirm}));
+    EXPECT_FALSE(local_state_.HasPrefPath(kKeychainAllowNewKey));
+  }
+  // Both confirmed: allow_new_key is set and committed before rac quits.
+  // (Setting the pref marks the store uncommitted, so `true` here means a
+  // commit came after it.)
+  {
+    FakeAsker asker({true, true});
+    EXPECT_EQ(RunFlow(asker), true);
+    EXPECT_EQ(asker.asked().size(), 2u);
+    EXPECT_TRUE(local_state_.GetBoolean(kKeychainAllowNewKey));
+  }
+}
+
+TEST_F(KeychainKeyPrefsTest, AllowNewKeyOverridesEveryReasonToExpectAKey) {
+  EXPECT_FALSE(IsKeychainKeyExpected(local_state_, base::FilePath()));
+  local_state_.SetBoolean(kKeychainKeySeen, true);
+  EXPECT_TRUE(IsKeychainKeyExpected(local_state_, base::FilePath()));
+  local_state_.SetBoolean(kKeychainAllowNewKey, true);
+  EXPECT_FALSE(IsKeychainKeyExpected(local_state_, base::FilePath()));
+
+  // A key read or made clears it, so the next missing key fails closed again.
+  RecordKeychainKeySeen(&local_state_);
+  EXPECT_FALSE(local_state_.HasPrefPath(kKeychainAllowNewKey));
+  EXPECT_TRUE(IsKeychainKeyExpected(local_state_, base::FilePath()));
+}
+
+TEST_F(KeychainKeyPrefsTest, ProfilesWithoutTheMarkerMeanAKeyExisted) {
+  base::DictValue profiles;
+  profiles.Set("Default", base::DictValue().Set("name", "Personal"));
+  local_state_.SetDict(kKeychainProfilesPref, std::move(profiles));
+  EXPECT_FALSE(local_state_.GetBoolean(kKeychainKeySeen));
+  EXPECT_TRUE(IsKeychainKeyExpected(local_state_, base::FilePath()));
+}
+
+// The dialog's buttons, Escape, and closing the window all go through
+// NewKeyStepReply. Views runs the close callback after Accept or Cancel too,
+// as the widget closes, and the step still answers once.
+TEST_F(KeychainKeyPrefsTest, EachDialogStepAnswersOnce) {
+  struct Case {
+    const char* what;
+    void (*press)(NewKeyStepReply&);
+    bool make_new_key;
+  };
+  const Case kCases[] = {
+      {"Make a New Key", [](NewKeyStepReply& r) { r.Accept(); }, true},
+      {"Quit or Cancel", [](NewKeyStepReply& r) { r.Cancel(); }, false},
+      {"Escape or closing", [](NewKeyStepReply& r) { r.Close(); }, false},
+  };
+  for (const Case& c : kCases) {
+    SCOPED_TRACE(c.what);
+    std::vector<bool> answers;
+    auto reply = base::MakeRefCounted<NewKeyStepReply>(base::BindOnce(
+        [](std::vector<bool>* out, bool answer) { out->push_back(answer); },
+        &answers));
+    c.press(*reply);
+    // Not yet: the answer waits for the widget to finish closing.
+    EXPECT_TRUE(answers.empty());
+    // Whatever runs next, as Views would after a button: nothing more.
+    reply->Close();
+    reply->Accept();
+    reply->Cancel();
+    task_environment_.RunUntilIdle();
+    EXPECT_EQ(answers, std::vector<bool>{c.make_new_key});
+  }
+}
+
+}  // namespace
+}  // namespace rac

+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+# The missing Keychain key dialog, and the hook that installs the Keychain key
+# guard. Shown before any browser window exists, so it needs only Views, not
+# //chrome/browser/ui. Used by //chrome/browser:core, on macOS only.
+source_set("keychain_key_dialog") {
+  sources = [
+    "keychain_key_dialog.cc",
+    "keychain_key_dialog.h",
+  ]
+  deps = [
+    "//base",
+    "//chrome/app:rac_strings",
+    "//chrome/browser:browser_process",
+    "//chrome/browser/rac/storage",
+    "//chrome/browser/rac/storage:keychain",
+    "//chrome/common:constants",
+    "//components/prefs",
+    "//components/strings",
+    "//ui/base",

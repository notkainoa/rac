+TEST_F(KeychainKeyGuardTest, LocalStateMissingChecksProfileFolders) {
+  // Whether a key may be made with no Local State and these files.
+  auto adds_key_with = [&](std::vector<std::string_view> files) {
+    base::ScopedTempDir user_data;
+    CHECK(user_data.CreateUniqueTempDir());
+    for (std::string_view file : files) {

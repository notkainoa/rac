+  local_state_.SetBoolean(kKeychainKeySeen, true);
+  local_state_.SetBoolean(kKeychainAllowNewKey, true);
+  EXPECT_TRUE(adds_key());
+  local_state_.ClearPref(kKeychainProfilesPref);
+
+  // With --use-mock-keychain, as in dev builds and browser tests, nothing is
+  // installed, and Helium's failure closure comes back as it was.
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch(
+      os_crypt::switches::kUseMockKeychain);
+  base::OnceClosure on_failure = KeychainKeyGuard::Install(
+      &local_state_, base::FilePath(),
+      base::BindOnce([](int* count) { ++*count; }, &helium_dialogs_),
+      base::BindOnce([](int* count) { ++*count; }, &rac_dialogs_));
+  EXPECT_FALSE(KeychainKeyGuard::GetForTesting());
+  std::move(on_failure).Run();
+  EXPECT_EQ(helium_dialogs_, 1);
+  EXPECT_EQ(rac_dialogs_, 0);

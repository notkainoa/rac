+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/storage/keychain_key_dialog.h"
+
+#include <stdlib.h>
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/process/process.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/rac/storage/keychain_key_guard_mac.h"
+#include "chrome/browser/rac/storage/keychain_key_prefs.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/grit/rac_strings.h"
+#include "components/strings/grit/components_strings.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/base/mojom/ui_base_types.mojom-shared.h"
+#include "ui/base/ui_base_types.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/controls/message_box_view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+
+static_assert(std::string_view(rac::kKeychainProfilesPref) ==
+              prefs::kProfileAttributes);
+
+namespace rac {
+
+namespace {
+
+// The dialogs' delegates. The widgets don't own them, and rac quits after the
+// last one, so they're kept until then.
+std::vector<std::unique_ptr<views::DialogDelegate>>& Delegates() {
+  static base::NoDestructor<std::vector<std::unique_ptr<views::DialogDelegate>>>
+      delegates;
+  return *delegates;
+}
+
+void AskStep(NewKeyStep step, base::OnceCallback<void(bool)> callback) {
+  const bool confirm = step == NewKeyStep::kConfirm;
+  auto reply = base::MakeRefCounted<NewKeyStepReply>(std::move(callback));
+
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetModalType(ui::mojom::ModalType::kNone);
+  dialog->SetShowCloseButton(false);
+  dialog->SetTitle(confirm ? IDS_RAC_KEYCHAIN_NEW_KEY_CONFIRM_TITLE
+                           : IDS_RAC_KEYCHAIN_KEY_MISSING_TITLE);
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+                     static_cast<int>(ui::mojom::DialogButton::kCancel));
+  // OK makes the key. Cancel (Quit at the first step) is the default, so
+  // Return never makes one.
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         l10n_util::GetStringUTF16(
+                             confirm ? IDS_RAC_KEYCHAIN_NEW_KEY_CONFIRM
+                                     : IDS_RAC_KEYCHAIN_KEY_MISSING_NEW_KEY));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kCancel,
+      l10n_util::GetStringUTF16(confirm ? IDS_CANCEL
+                                        : IDS_RAC_KEYCHAIN_KEY_MISSING_QUIT));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  // Escape runs the close callback, since there is one.
+  dialog->SetAcceptCallback(base::BindOnce(&NewKeyStepReply::Accept, reply));
+  dialog->SetCancelCallback(base::BindOnce(&NewKeyStepReply::Cancel, reply));
+  dialog->SetCloseCallback(base::BindOnce(&NewKeyStepReply::Close, reply));
+  dialog->SetContentsView(std::make_unique<views::MessageBoxView>(
+      l10n_util::GetStringUTF16(confirm
+                                    ? IDS_RAC_KEYCHAIN_NEW_KEY_CONFIRM_MESSAGE
+                                    : IDS_RAC_KEYCHAIN_KEY_MISSING_MESSAGE)));
+
+  // No browser window exists yet, so there's no parent. Float it above other
+  // windows, like Chromium's parentless message boxes.
+  views::Widget* widget = views::DialogDelegate::CreateDialogWidget(
+      dialog.get(), gfx::NativeWindow(), gfx::NativeView());
+  Delegates().push_back(std::move(dialog));
+  widget->SetZOrderLevel(ui::ZOrderLevel::kFloatingWindow);
+  widget->Show();
+}
+
+void Quit() {
+  // Profile initialization is still waiting for the key. Exit without
+  // flushing partially initialized preferences, as Helium's Keychain error
+  // does. If the user asked for a new key, writing Local State has finished,
+  // or failed, by now.
+  base::Process::TerminateCurrentProcessImmediately(EXIT_FAILURE);
+}
+
+}  // namespace
+
+base::OnceClosure GuardKeychainKey(base::OnceClosure on_failure) {
+  PrefService* local_state = g_browser_process->local_state();
+  CHECK(local_state);
+  base::FilePath user_data_dir;
+  base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir);
+  return KeychainKeyGuard::Install(
+      local_state, user_data_dir, std::move(on_failure),
+      base::BindOnce(&ShowMissingKeychainKeyDialog,
+                     base::Unretained(local_state)));
+}
+
+void ShowMissingKeychainKeyDialog(PrefService* local_state) {
+  RunNewKeychainKeyFlow(local_state, base::BindRepeating(&AskStep),
+                        base::BindOnce(&Quit));
+}
+
+}  // namespace rac

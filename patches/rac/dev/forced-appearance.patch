+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/dev/forced_appearance.h"
+
+#import <Cocoa/Cocoa.h>
+#include <objc/runtime.h>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+
+namespace rac::dev {
+namespace {
+
+constexpr char kForceColorModeSwitch[] = "rac-force-color-mode";
+constexpr char kForceIncreasedContrastSwitch[] = "rac-force-increased-contrast";
+
+// Sets this app's appearance. Chromium's OS settings provider watches
+// NSApp.effectiveAppearance, so its light/dark preference follows.
+bool SetColorMode(const std::string& mode) {
+  if (mode == "light") {
+    NSApp.appearance = [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+  } else if (mode == "dark") {
+    NSApp.appearance = [NSAppearance appearanceNamed:NSAppearanceNameDarkAqua];
+  } else if (mode == "system") {
+    NSApp.appearance = nil;
+  } else {
+    LOG(ERROR) << "rac forced appearance: unknown color mode " << mode;
+    return false;
+  }
+  return true;
+}
+
+// Answers -[NSWorkspace accessibilityDisplayShouldIncreaseContrast] with YES
+// while on, then posts the notification macOS sends when the setting
+// changes, so Chromium's theme and web pages look again.
+void SetIncreasedContrast(bool on) {
+  static IMP original = nullptr;
+  static IMP forced = nullptr;
+  Method method = class_getInstanceMethod(
+      [NSWorkspace class],
+      @selector(accessibilityDisplayShouldIncreaseContrast));
+  if (!method) {
+    LOG(ERROR) << "rac forced appearance: no contrast setting to override";
+    return;
+  }
+  if (!original) {
+    original = method_getImplementation(method);
+    forced = imp_implementationWithBlock(^BOOL(id workspace) {
+      return YES;
+    });
+  }
+  method_setImplementation(method, on ? forced : original);
+  [NSWorkspace.sharedWorkspace.notificationCenter
+      postNotificationName:
+          NSWorkspaceAccessibilityDisplayOptionsDidChangeNotification
+                    object:NSWorkspace.sharedWorkspace];
+}
+
+}  // namespace
+
+void MaybeForceAppearance() {
+  static bool applied = false;
+  if (applied) {
+    return;
+  }
+  applied = true;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kForceColorModeSwitch)) {
+    SetColorMode(command_line->GetSwitchValueASCII(kForceColorModeSwitch));
+  }
+  if (command_line->HasSwitch(kForceIncreasedContrastSwitch)) {
+    SetIncreasedContrast(true);
+  }
+}
+
+bool HandleAppearanceRequest(const std::vector<std::string>& words) {
+  if (words.size() != 2) {
+    return false;
+  }
+  if (words[0] == "appearance") {
+    SetColorMode(words[1]);
+    return true;
+  }
+  if (words[0] == "contrast" && (words[1] == "on" || words[1] == "off")) {
+    SetIncreasedContrast(words[1] == "on");
+    return true;
+  }
+  return false;
+}
+
+}  // namespace rac::dev

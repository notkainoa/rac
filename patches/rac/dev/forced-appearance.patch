+namespace rac::dev {
+
+// Applies --rac-force-color-mode=light|dark and
+// --rac-force-increased-contrast to this process only. The Mac's own
+// settings are never touched.
+//   Color mode sets NSApp.appearance, so AppKit, Chromium's native theme and
+//   web pages (prefers-color-scheme) follow, as if macOS's appearance changed.
+//   Increase Contrast reaches Chromium's theme (the high-contrast color
+//   pipeline) and web pages (prefers-contrast: more), but not AppKit's own
+//   drawing, such as system colors and the traffic lights.
+// Runs once, from the first browser window's show; windows already open
+// switch then.
+void MaybeForceAppearance();
+
+// Handles `appearance light|dark|system` and `contrast on|off`, the same
+// overrides changed while running. Returns false for other requests.
+bool HandleAppearanceRequest(const std::vector<std::string>& words);
+
+}  // namespace rac::dev
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_DEV_FORCED_APPEARANCE_H_

+// Sends one step of a trackpad swipe, then the rest, a trackpad's 120 Hz
+// apart. Ends with the fingers lifting unless `hold`.
+void SendSwipe(base::WeakPtr<views::Widget> widget,
+               gfx::Point point,
+               float delta,
+               int remaining,
+               bool began,
+               bool hold) {
+  if (!widget || widget->IsClosed()) {
+    return;
+  }
+  views::Widget* target = WidgetAt(widget.get(), &point);
+  const bool end = remaining == 0;
+  if (end && hold) {
+    return;
+  }
+  ui::ScrollEvent event(
+      ui::EventType::kScroll, gfx::PointF(point), gfx::PointF(point),
+      ui::EventTimeForNow(), ui::EF_NONE, end ? 0 : delta, 0, end ? 0 : delta,
+      0, 2, ui::EventMomentumPhase::NONE,
+      end ? ui::ScrollEventPhase::kEnd
+          : (began ? ui::ScrollEventPhase::kBegan
+                   : ui::ScrollEventPhase::kUpdate));
+  target->OnScrollEvent(&event);
+  if (end) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&SendSwipe, widget, point, delta, remaining - 1, false,
+                     hold),
+      base::Milliseconds(8));
+}

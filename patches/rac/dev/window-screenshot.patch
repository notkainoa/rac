+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_WINDOW_SCREENSHOT_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_WINDOW_SCREENSHOT_H_
+
+namespace views {
+class Widget;
+}
+
+namespace rac {
+
+// If launched with --rac-window-screenshot=PATH, paints this window's views
+// after the first layout and writes a PNG. No-op otherwise.
+//
+// Agents use this on macOS 26, where screencapture / ScreenCaptureKit of
+// another process (and often this one) returns a blank image.
+void MaybeScheduleWindowScreenshot(views::Widget* widget);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_WINDOW_SCREENSHOT_H_

+constexpr char kFrameLogSwitch[] = "rac-frame-log";
+
+int64_t Micros(base::TimeTicks ticks) {
+  return ticks.since_origin().InMicroseconds();
+}
+
+// Appends lines to the log file on a background sequence, so the UI thread
+// never touches the disk.
+class LogFile {
+ public:
+  static LogFile* Get() {
+    static base::NoDestructor<std::unique_ptr<LogFile>> file([] {
+      const base::FilePath path =
+          base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+              kFrameLogSwitch);
+      return path.empty() ? nullptr : std::make_unique<LogFile>(path);
+    }());
+    return file->get();
+  }
+
+  explicit LogFile(base::FilePath path)
+      : path_(std::move(path)),
+        runner_(base::ThreadPool::CreateSequencedTaskRunner(
+            {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+             base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+    // Pairs this log's clock with the wall clock, so page times
+    // (performance.timeOrigin + performance.now()) can be put on it.
+    Write(base::StringPrintf(
+              "{\"ev\":\"clock\",\"ticks_us\":%lld,\"wall_ms\":%.3f}",
+              static_cast<long long>(Micros(base::TimeTicks::Now())),
+              base::Time::Now().InMillisecondsFSinceUnixEpoch()),
+          /*truncate=*/true);
+  }
+
+  void Write(std::string line, bool truncate = false) {
+    line += '\n';
+    runner_->PostTask(FROM_HERE, base::BindOnce(
+                                     [](const base::FilePath& path,
+                                        std::string line, bool truncate) {
+                                       if (truncate) {
+                                         base::WriteFile(path, line);
+                                       } else {
+                                         base::AppendToFile(path, line);
+                                       }
+                                     },
+                                     path_, std::move(line), truncate));
+  }
+
+ private:
+  const base::FilePath path_;
+  const scoped_refptr<base::SequencedTaskRunner> runner_;
+};
+
+std::string Quoted(std::string_view text) {
+  std::string out;
+  base::EscapeJSONString(text, /*put_in_quotes=*/true, &out);
+  return out;
+}
+
+// Where `view` is drawn in its widget. ConvertRectToWidget() applies each
+// view's transform, so a layer slide is already in `x`.
+std::string Probe(const views::View* view) {
+  if (!view || !view->GetWidget()) {
+    return "null";
+  }
+  const gfx::Rect bounds = view->ConvertRectToWidget(view->GetLocalBounds());
+  return base::StringPrintf(
+      "{\"x\":%d,\"y\":%d,\"w\":%d,\"h\":%d,\"drawn\":%s}", bounds.x(),
+      bounds.y(), bounds.width(), bounds.height(),
+      view->IsDrawn() ? "true" : "false");
+}
+
+views::View* FindByClassName(views::View* root, std::string_view name) {
+  if (!root) {
+    return nullptr;
+  }
+  if (root->GetClassName() == name) {
+    return root;
+  }
+  for (views::View* child : root->children()) {
+    if (views::View* found = FindByClassName(child, name)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// Logs each frame one window presents, and the layout each commit sends to
+// the screen. Deletes itself with the widget.
+//
+// Two kinds of line, both stamped with the time the frame reached the
+// screen:
+//   "frame": every presented frame, for idle-frame budgets.
+//   "layout": the sidebar's and page's bounds as committed, paired with the
+//             frame that commit produced. Reading bounds when the frame is
+//             presented instead would be one to three frames late.
+class FrameObserver : public ui::CompositorObserver,
+                      public views::WidgetObserver {
+ public:
+  FrameObserver(views::Widget* widget, int id) : widget_(widget), id_(id) {
+    widget_observation_.Observe(widget);
+    compositor_observation_.Observe(widget->GetCompositor());
+  }
+
+  static std::set<views::Widget*>& Observed() {
+    static base::NoDestructor<std::set<views::Widget*>> observed;
+    return *observed;
+  }
+
+  // ui::CompositorObserver:
+  void OnCompositingDidCommit(ui::Compositor* compositor) override {
+    UpdateProbes();
+    compositor->RequestPresentationTimeForNextFrame(base::BindOnce(
+        &FrameObserver::OnLayoutPresented, weak_factory_.GetWeakPtr(),
+        Micros(base::TimeTicks::Now()),
+        base::StringPrintf("\"sidebar\":%s,\"page\":%s",
+                           Probe(sidebar_.view()).c_str(),
+                           Probe(page_.view()).c_str())));
+  }
+
+  void OnDidPresentCompositorFrame(
+      ui::Compositor* compositor,
+      uint32_t frame_token,
+      const gfx::PresentationFeedback& feedback) override {
+    if (LogFile* file = LogFile::Get()) {
+      file->Write(base::StringPrintf(
+          "{\"ev\":\"frame\",\"win\":%d,\"token\":%u,\"t_us\":%lld,"
+          "\"now_us\":%lld,\"interval_us\":%lld,\"flags\":%u}",
+          id_, frame_token, static_cast<long long>(Micros(feedback.timestamp)),
+          static_cast<long long>(Micros(base::TimeTicks::Now())),
+          static_cast<long long>(feedback.interval.InMicroseconds()),
+          feedback.flags));
+    }
+  }
+
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override {
+    compositor_observation_.Reset();
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override {
+    Observed().erase(widget_);
+    delete this;
+  }
+
+ private:
+  void OnLayoutPresented(int64_t commit_us,
+                         std::string probes,
+                         const gfx::PresentationFeedback& feedback) {
+    if (LogFile* file = LogFile::Get(); file && !feedback.failed()) {
+      file->Write(base::StringPrintf(
+          "{\"ev\":\"layout\",\"win\":%d,\"t_us\":%lld,"
+          "\"commit_us\":%lld,%s}",
+          id_, static_cast<long long>(Micros(feedback.timestamp)),
+          static_cast<long long>(commit_us), probes.c_str()));
+    }
+  }
+
+  // The views are found again whenever one goes away, since layouts swap
+  // them. A window without them (an app window) is searched at most once a
+  // second, so the search doesn't slow the frames being measured.
+  void UpdateProbes() {
+    if (sidebar_.view() && page_.view()) {
+      return;
+    }
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (now - last_search_ < base::Seconds(1)) {
+      return;
+    }
+    last_search_ = now;
+    BrowserView* browser_view =
+        BrowserView::GetBrowserViewForNativeWindow(widget_->GetNativeWindow());
+    if (!browser_view) {
+      return;
+    }
+    if (!sidebar_.view()) {
+      sidebar_.SetView(
+          FindByClassName(browser_view, "VerticalTabStripRegionView"));
+    }
+    if (!page_.view()) {
+      page_.SetView(browser_view->contents_container());
+    }
+  }
+
+  const raw_ptr<views::Widget> widget_;
+  const int id_;
+  base::TimeTicks last_search_;
+  views::ViewTracker sidebar_;
+  views::ViewTracker page_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  base::ScopedObservation<ui::Compositor, ui::CompositorObserver>
+      compositor_observation_{this};
+  base::WeakPtrFactory<FrameObserver> weak_factory_{this};
+};
+
+}  // namespace
+
+void MaybeLogFrames(views::Widget* widget) {
+  LogFile* file = LogFile::Get();
+  if (!file || !widget || !widget->GetCompositor() ||
+      !FrameObserver::Observed().insert(widget).second) {
+    return;
+  }
+  static int next_id = 0;
+  const int id = next_id++;
+  file->Write(base::StringPrintf(
+      "{\"ev\":\"window\",\"win\":%d,\"name\":%s,\"t_us\":%lld}", id,
+      Quoted(widget->GetName()).c_str(),
+      static_cast<long long>(Micros(base::TimeTicks::Now()))));
+  new FrameObserver(widget, id);
+}
+
+void LogRequest(std::string_view request) {
+  if (LogFile* file = LogFile::Get()) {
+    file->Write(base::StringPrintf(
+        "{\"ev\":\"req\",\"t_us\":%lld,\"line\":%s}",
+        static_cast<long long>(Micros(base::TimeTicks::Now())),
+        Quoted(request).c_str()));
+  }
+}
+
+void LogAnimationStep(std::string_view name, double value) {
+  if (LogFile* file = LogFile::Get()) {
+    file->Write(base::StringPrintf(
+        "{\"ev\":\"step\",\"t_us\":%lld,\"name\":%s,\"v\":%.6f}",
+        static_cast<long long>(Micros(base::TimeTicks::Now())),
+        Quoted(name).c_str(), value));
+  }
+}
+
+}  // namespace rac::dev

+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_DEV_FRAME_LOG_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_DEV_FRAME_LOG_H_
+
+#include <string_view>
+
+#include "chrome/browser/rac/dev/buildflags.h"
+
+namespace views {
+class Widget;
+}
+
+namespace rac::dev {
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+
+// With --rac-frame-log=PATH, appends one JSON line to PATH for every frame
+// `widget` presents, with where its sidebar and page sit. Safe to call more
+// than once for a widget. No-op without the switch.
+void MaybeLogFrames(views::Widget* widget);
+
+// Notes a harness request in the frame log, so a log shows when each input
+// was sent. No-op without the switch.
+void LogRequest(std::string_view request);
+
+// Notes one step of a rac animation, such as a spring's value, in the frame
+// log. rac's own motion code may call it anywhere: official builds compile
+// it to nothing, and developer builds do nothing without the switch.
+void LogAnimationStep(std::string_view name, double value);
+
+#else
+
+inline void MaybeLogFrames(views::Widget* widget) {}
+inline void LogRequest(std::string_view request) {}
+inline void LogAnimationStep(std::string_view name, double value) {}
+
+#endif  // BUILDFLAG(RAC_DEV_SWITCHES)
+
+}  // namespace rac::dev
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_DEV_FRAME_LOG_H_

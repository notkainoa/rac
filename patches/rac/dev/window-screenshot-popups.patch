+// The window, or the popup of it, that a click at window point `point`
+// lands in, with the point in its coordinates.
+views::Widget* WidgetAt(views::Widget* widget, gfx::Point* point) {
+  const gfx::Point origin = widget->GetWindowBoundsInScreen().origin();
+  const gfx::Point screen = origin + point->OffsetFromOrigin();
+  for (const base::WeakPtr<views::Widget>& popup : VisiblePopups(widget)) {
+    const gfx::Rect rect = popup->GetWindowBoundsInScreen();
+    if (rect.Contains(screen)) {
+      *point = screen - rect.OffsetFromOrigin();
+      return popup.get();
+    }
+  }
+  return widget;
+}
+
+// The popup that has focus, else the window.
+views::Widget* FocusedWidget(views::Widget* widget) {
+  views::Widget* focused = widget;
+  for (const base::WeakPtr<views::Widget>& popup : VisiblePopups(widget)) {
+    if (popup->IsActive() || focused == widget) {
+      focused = popup.get();
+    }
+  }
+  return focused;
+}
+
+void SendMouse(views::Widget* target,
+               ui::EventType type,
+               const gfx::Point& point) {
+  const int flags =
+      type == ui::EventType::kMouseMoved ? 0 : ui::EF_LEFT_MOUSE_BUTTON;
+  ui::MouseEvent event(type, point, point, ui::EventTimeForNow(), flags, flags);
+  target->OnMouseEvent(&event);
+}
+
+std::optional<ui::KeyboardCode> KeyNamed(std::string_view name) {
+  if (name == "return") {
+    return ui::VKEY_RETURN;
+  }
+  if (name == "escape") {
+    return ui::VKEY_ESCAPE;
+  }
+  if (name == "tab") {
+    return ui::VKEY_TAB;
+  }
+  if (name == "backspace") {
+    return ui::VKEY_BACK;
+  }
+  if (name == "up") {
+    return ui::VKEY_UP;
+  }
+  if (name == "down") {
+    return ui::VKEY_DOWN;
+  }
+  if (name == "left") {
+    return ui::VKEY_LEFT;
+  }
+  if (name == "right") {
+    return ui::VKEY_RIGHT;
+  }
+  return std::nullopt;
+}
+
+void RunCommand(base::WeakPtr<views::Widget> widget, int command_id);
+
+// Drives the window from a request, without the real mouse or keyboard.
+// Points are in window coordinates, as in screenshots divided by their
+// scale:
+//   command ID      runs a browser command
+//   move X Y        moves the pointer there, for hover states
+//   click X Y       clicks there, in a popup if one is on top
+//   type TEXT       types into the focused text field
+//   key NAME        presses return, escape, tab, backspace, or an arrow
+bool HandleInput(views::Widget* widget,
+                 const std::vector<std::string>& words,
+                 const std::string& line) {
+  const std::string& verb = words[0];
+  int x = 0;
+  int y = 0;
+  if (verb == "command" && words.size() == 2 &&
+      base::StringToInt(words[1], &x)) {
+    RunCommand(widget->GetWeakPtr(), x);
+    return true;
+  }
+  if ((verb == "move" || verb == "click") && words.size() == 3 &&
+      base::StringToInt(words[1], &x) && base::StringToInt(words[2], &y)) {
+    gfx::Point point(x, y);
+    views::Widget* target = WidgetAt(widget, &point);
+    SendMouse(target, ui::EventType::kMouseMoved, point);
+    if (verb == "click") {
+      SendMouse(target, ui::EventType::kMousePressed, point);
+      SendMouse(target, ui::EventType::kMouseReleased, point);
+    }
+    return true;
+  }
+  if (verb == "type" && words.size() >= 2) {
+    views::Widget* target = FocusedWidget(widget);
+    views::View* focused = target->GetFocusManager()
+                               ? target->GetFocusManager()->GetFocusedView()
+                               : nullptr;
+    if (auto* field = views::AsViewClass<views::Textfield>(focused)) {
+      field->InsertText(
+          base::UTF8ToUTF16(base::TrimWhitespaceASCII(
+              std::string_view(line).substr(verb.size()), base::TRIM_ALL)),
+          ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+    } else {
+      LOG(ERROR) << "rac window screenshot: no text field has focus";
+    }
+    return true;
+  }
+  if (verb == "key" && words.size() == 2) {
+    if (std::optional<ui::KeyboardCode> code = KeyNamed(words[1])) {
+      views::Widget* target = FocusedWidget(widget);
+      ui::KeyEvent press(ui::EventType::kKeyPressed, *code, ui::EF_NONE);
+      target->OnKeyEvent(&press);
+      // The press may have closed the popup.
+      target = FocusedWidget(widget);
+      ui::KeyEvent release(ui::EventType::kKeyReleased, *code, ui::EF_NONE);
+      target->OnKeyEvent(&release);
+    }
+    return true;
+  }
+  return false;
+}

+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_DEV_WINDOW_SELECT_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_DEV_WINDOW_SELECT_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace views {
+class Widget;
+}
+
+namespace rac::dev {
+
+// The window a selector names, or null. Selectors:
+//   #N             the Nth window in `windows` output
+//   first          the window that polls for requests
+//   normal         the first normal browser window
+//   app[:ID]       an installed web app's window (that app's, with ID)
+//   incognito      an incognito browser window
+//   profile:NAME   a browser window of the profile in folder NAME
+//   pip            a picture-in-picture window
+//   onboarding     the welcome tour
+//   name:NAME      the widget named NAME
+views::Widget* FindWindow(std::string_view selector);
+
+// The window input requests act on: the one `target` chose while it's
+// open, else `first`, the window that polls for requests.
+views::Widget* TargetWindow(views::Widget* first);
+
+// Handles `windows OUT.txt`, `target SEL` and `profile-window NAME`. Returns
+// false for other requests.
+bool HandleWindowRequest(views::Widget* first,
+                         const std::vector<std::string>& words);
+
+}  // namespace rac::dev
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_DEV_WINDOW_SELECT_H_

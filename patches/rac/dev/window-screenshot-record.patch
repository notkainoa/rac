+// Bytes of frames copied but not yet written. Past this, frames are skipped
+// and counted, so a slow disk can't eat the machine's memory.
+constexpr int64_t kMaxPendingBytes = 512 * 1024 * 1024;
+constexpr int kScaleDenominator = 1000;
+
+constexpr base::TaskTraits kWriteTraits = {
+    base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+    base::TaskShutdownBehavior::BLOCK_SHUTDOWN};
+
+int64_t Micros(base::TimeTicks ticks) {
+  return ticks.since_origin().InMicroseconds();
+}
+
+bool EncodeAndWrite(const SkBitmap& bitmap,
+                    const base::FilePath& path,
+                    bool fast) {
+  std::optional<std::vector<uint8_t>> png =
+      fast ? gfx::PNGCodec::FastEncodeBGRASkBitmap(
+                 bitmap, /*discard_transparency=*/false)
+           : gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                               /*discard_transparency=*/false);
+  if (!png) {
+    LOG(ERROR) << "rac window screenshot: PNG encode failed";
+    return false;
+  }
+  if (!base::WriteFile(path, *png)) {
+    LOG(ERROR) << "rac window screenshot write failed: " << path;
+    // A half-written frame must not stay behind like a captured one.
+    base::DeleteFile(path);
+    return false;
+  }
+  return true;
+}
+
+// Frame files are named f%04d.png (and wider past frame 9999), so a name is
+// f, four or more digits, .png -- nothing else may be deleted as one.
+bool IsFrameFileName(std::string_view name) {
+  if (name.size() < std::string_view("f0000.png").size() ||
+      name.front() != 'f' || !name.ends_with(".png")) {
+    return false;
+  }
+  for (char c :
+       name.substr(1, name.size() - std::string_view("f.png").size())) {
+    if (!base::IsAsciiDigit(c)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Creates the recording's dir, drops an earlier recording's frames from it,
+// and starts a fresh frames.jsonl. Runs on the recording's write sequence.
+bool PrepareDir(const base::FilePath& dir) {
+  if (!base::CreateDirectory(dir)) {
+    return false;
+  }
+  base::FileEnumerator files(dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("f*.png"));
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    if (IsFrameFileName(path.BaseName().AsUTF8Unsafe())) {
+      base::DeleteFile(path);
+    }
+  }
+  return base::WriteFile(dir.AppendASCII("frames.jsonl"), "");
+}
+
+// Records one window's frames for a fixed time, then writes a last "done"
+// line once every copied frame is on disk. Deletes itself then, or at once
+// if the window goes away.
+class Recorder : public ui::CompositorObserver, public views::WidgetObserver {
+ public:
+  Recorder(views::Widget* widget,
+           base::FilePath dir,
+           base::TimeDelta duration,
+           int scale)
+      : widget_(widget),
+        dir_(std::move(dir)),
+        scale_(scale),
+        log_(base::ThreadPool::CreateSequencedTaskRunner(kWriteTraits)) {
+    widget_observation_.Observe(widget);
+    // Capture starts when the dir is ready, so a frame is never written
+    // before its folder exists.
+    log_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&PrepareDir, dir_),
+        base::BindOnce(&Recorder::OnDirReady, weak_factory_.GetWeakPtr(),
+                       duration));
+  }
+
+  // ui::CompositorObserver:
+  void OnCompositingDidCommit(ui::Compositor* compositor) override {
+    // Ask for a copy of the next frame. Posted, since a copy request
+    // commits again.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&Recorder::RequestFrame, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override {
+    Abandon();
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override { Abandon(); }
+
+ private:
+  // Runs on the UI sequence once the write sequence has the dir ready.
+  void OnDirReady(base::TimeDelta duration, bool ready) {
+    if (!ready) {
+      LOG(ERROR) << "rac window record: cannot write to " << dir_;
+      // Deleted at once: a posted delete would leave the widget observed,
+      // and Abandon() would post a second one if the window closed first.
+      delete this;
+      return;
+    }
+    if (widget_->IsClosed() || !widget_->GetCompositor()) {
+      Abandon();
+      return;
+    }
+    compositor_observation_.Observe(widget_->GetCompositor());
+    // Its own deadline, since commits stop when the window can't draw.
+    deadline_.Start(FROM_HERE, duration,
+                    base::BindOnce(&Recorder::Finish, base::Unretained(this)));
+    LOG(ERROR) << "rac window record started -> " << dir_;
+    RequestFrame();
+  }
+
+  void RequestFrame() {
+    if (finished_) {
+      return;
+    }
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (now == last_request_) {
+      return;
+    }
+    ui::Compositor* compositor = widget_->GetCompositor();
+    ui::Layer* layer = compositor ? compositor->root_layer() : nullptr;
+    if (!layer) {
+      Abandon();
+      return;
+    }
+    const gfx::Size size = layer->size();
+    const int64_t bytes = int64_t{4} * size.width() * size.height() * scale_ /
+                          kScaleDenominator * scale_ / kScaleDenominator;
+    if (pending_ > 0 && pending_bytes_ + bytes > kMaxPendingBytes) {
+      ++skipped_;
+      compositor->ScheduleDraw();
+      return;
+    }
+    last_request_ = now;
+    auto request = std::make_unique<viz::CopyOutputRequest>(
+        viz::CopyOutputRequest::ResultFormat::RGBA,
+        viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+        base::BindOnce(&Recorder::OnFrame, weak_factory_.GetWeakPtr(),
+                       requested_++, now, bytes));
+    request->set_area(gfx::Rect(size));
+    if (scale_ != kScaleDenominator) {
+      request->SetUniformScaleRatio(kScaleDenominator, scale_);
+    }
+    ++pending_;
+    pending_bytes_ += bytes;
+    layer->RequestCopyOfOutput(std::move(request));
+    compositor->ScheduleDraw();
+  }
+
+  void OnFrame(int index,
+               base::TimeTicks requested,
+               int64_t bytes,
+               std::unique_ptr<viz::CopyOutputResult> result) {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (!result || result->IsEmpty()) {
+      OnWritten(bytes, std::string(), /*written=*/false);
+      return;
+    }
+    SkBitmap bitmap = result->ScopedAccessSkBitmap().GetOutScopedBitmap();
+    std::string line = base::StringPrintf(
+        "{\"i\":%d,\"req_us\":%lld,\"res_us\":%lld,\"w\":%d,\"h\":%d,"
+        "\"skipped\":%d}\n",
+        index, static_cast<long long>(Micros(requested)),
+        static_cast<long long>(Micros(now)), bitmap.width(), bitmap.height(),
+        skipped_);
+    // Frames encode in parallel; each line is logged once its PNG exists.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, kWriteTraits,
+        base::BindOnce(
+            [](SkBitmap bitmap, base::FilePath path) {
+              return EncodeAndWrite(bitmap, path, /*fast=*/true);
+            },
+            std::move(bitmap),
+            dir_.AppendASCII(base::StringPrintf("f%04d.png", index))),
+        base::BindOnce(&Recorder::OnWritten, weak_factory_.GetWeakPtr(), bytes,
+                       std::move(line)));
+  }
+
+  void OnWritten(int64_t bytes, std::string line, bool written) {
+    --pending_;
+    pending_bytes_ -= bytes;
+    if (!written) {
+      ++skipped_;
+    } else {
+      log_->PostTask(FROM_HERE,
+                     base::BindOnce(
+                         [](base::FilePath path, std::string line) {
+                           base::AppendToFile(path, line);
+                         },
+                         dir_.AppendASCII("frames.jsonl"), std::move(line)));
+    }
+    if (finished_ && pending_ == 0) {
+      Done();
+    }
+  }
+
+  // Stops asking for frames; the ones in flight still land.
+  void Finish() {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    deadline_.Stop();
+    compositor_observation_.Reset();
+    if (pending_ == 0) {
+      Done();
+    }
+  }
+
+  // The window is going away: frames in flight won't come.
+  void Abandon() {
+    Finish();
+    widget_ = nullptr;
+    if (!done_) {
+      skipped_ += pending_;
+      Done();
+    }
+  }
+
+  void Done() {
+    if (done_) {
+      return;
+    }
+    done_ = true;
+    widget_observation_.Reset();
+    weak_factory_.InvalidateWeakPtrs();
+    log_->PostTask(
+        FROM_HERE,
+        base::BindOnce([](base::FilePath path,
+                          std::string line) { base::AppendToFile(path, line); },
+                       dir_.AppendASCII("frames.jsonl"),
+                       base::StringPrintf(
+                           "{\"done\":true,\"requested\":%d,\"skipped\":%d}\n",
+                           requested_, skipped_)));
+    LOG(ERROR) << "rac window record done: " << requested_ << " frames, "
+               << skipped_ << " skipped";
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  raw_ptr<views::Widget> widget_;
+  const base::FilePath dir_;
+  const int scale_;
+  const scoped_refptr<base::SequencedTaskRunner> log_;
+  base::OneShotTimer deadline_;
+  base::TimeTicks last_request_;
+  int requested_ = 0;
+  int pending_ = 0;
+  int64_t pending_bytes_ = 0;
+  int skipped_ = 0;
+  bool finished_ = false;
+  bool done_ = false;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  base::ScopedObservation<ui::Compositor, ui::CompositorObserver>
+      compositor_observation_{this};
+  base::WeakPtrFactory<Recorder> weak_factory_{this};
+};
+
+}  // namespace
+
+void EncodeAndWritePng(SkBitmap bitmap, base::FilePath path, bool fast) {
+  base::ThreadPool::PostTask(
+      FROM_HERE, kWriteTraits,
+      base::BindOnce(
+          [](SkBitmap bitmap, base::FilePath path, bool fast) {
+            if (EncodeAndWrite(bitmap, path, fast)) {
+              LOG(ERROR) << "rac window screenshot wrote " << path;
+            }
+          },
+          std::move(bitmap), std::move(path), fast));
+}
+
+bool HandleRecordRequest(views::Widget* widget,
+                         const std::vector<std::string>& words) {
+  int ms = 0;
+  if (words.empty() || words[0] != "record" ||
+      (words.size() != 3 && words.size() != 4) ||
+      !base::StringToInt(words[2], &ms) || ms <= 0) {
+    return false;
+  }
+  double scale = 1.0;
+  if (words.size() == 4 &&
+      (!base::StringToDouble(words[3], &scale) || scale <= 0 || scale > 1)) {
+    LOG(ERROR) << "rac window record: SCALE must be in (0, 1]";
+    return true;
+  }
+  if (!widget || widget->IsClosed() || !widget->GetCompositor()) {
+    return true;
+  }
+  new Recorder(widget, base::FilePath(words[1]), base::Milliseconds(ms),
+               std::max(1, static_cast<int>(scale * kScaleDenominator + 0.5)));
+  return true;
+}
+

+// Holds a paint-as-active lock for a window's lifetime, so an inactive test
+// window draws its frame and tabs like the focused window a user sees.
+class PaintAsActive : public views::WidgetObserver {
+ public:
+  explicit PaintAsActive(views::Widget* widget)
+      : lock_(widget->LockPaintAsActive()) {
+    observation_.Observe(widget);
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override { delete this; }
+
+ private:
+  std::unique_ptr<views::Widget::PaintAsActiveLock> lock_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+};
+
+// Turns NSApp's activation calls into no-ops. Chromium activates the app when
+// a window shows or a tab is activated (also over DevTools), and each would
+// take the keyboard from whatever app the user is typing in.
+void StopAppActivation() {
+  Class app_class = [NSApp class];
+  Method activate_ignoring = class_getInstanceMethod(
+      [NSApplication class], @selector(activateIgnoringOtherApps:));
+  if (activate_ignoring) {
+    class_replaceMethod(app_class, @selector(activateIgnoringOtherApps:),
+                        imp_implementationWithBlock(^(id app, BOOL flag){
+                        }),
+                        method_getTypeEncoding(activate_ignoring));
+  }
+  Method activate =
+      class_getInstanceMethod([NSApplication class], @selector(activate));
+  if (activate) {
+    class_replaceMethod(app_class, @selector(activate),
+                        imp_implementationWithBlock(^(id app){
+                        }),
+                        method_getTypeEncoding(activate));
+  }
+}

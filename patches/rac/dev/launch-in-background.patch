+void MaybeKeepInBackground(views::Widget* widget) {
+  if (!widget || !base::CommandLine::ForCurrentProcess()->HasSwitch(
+                     kLaunchInBackgroundSwitch)) {
+    return;
+  }
+  static bool stopped = false;
+  if (!stopped) {
+    stopped = true;
+    StopAppActivation();
+  }
+  new PaintAsActive(widget);
+}

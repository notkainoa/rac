+// An occluded window stops painting, and a window a test shoots often reads
+// as occluded on a shared screen. A --rac-window-screenshot* switch means the
+// run wants real pixels, so it takes the same way out browser tests take.
+// This runs before the first browser window shows, and WebContents reads
+// the switch whenever its visibility changes.
+void MaybeKeepOccludedWindowsPainting() {
+  static bool checked = false;
+  if (checked) {
+    return;
+  }
+  checked = true;
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  for (const auto& [name, value] : command_line->GetSwitches()) {
+    if (name.starts_with("rac-window-screenshot")) {
+      command_line->AppendSwitch(
+          switches::kDisableBackgroundingOccludedWindowsForTesting);
+      return;
+    }
+  }
+}

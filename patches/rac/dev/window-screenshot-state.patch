+// Handles the requests that set up state or move the pointer for `widget`:
+//   space-theme PRESET|- [auto|light|dark]  sets the active space's colors
+//                                           (PRESET 0-7, - keeps them) and
+//                                           light/dark mode
+//   space-new                  adds a space and shows it in the window
+//   open-urls URL...           opens URLs the way macOS hands them to rac
+//                              (-[NSApplicationDelegate application:openURLs:])
+//   pointer X Y                puts the pointer at window point X,Y, as the
+//                              real mouse would: [NSEvent mouseLocation]
+//                              reports it, a native mouse-moved event goes
+//                              to AppKit's monitors, and the window's views
+//                              get the move. The real cursor never moves
+//   pointer-path X0 Y0 X1 Y1 MS  moves it in a line over MS ms at 120 Hz
+//   pointer off                gives the real pointer back
+// Returns false for other requests.
+bool HandleStateRequest(views::Widget* widget,
+                        const std::vector<std::string>& words);
+

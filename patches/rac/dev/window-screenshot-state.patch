+// A drawn WebView's page, with the window point it shows at.
+struct WebViewShot {
+  gfx::Rect bounds;
+  base::WeakPtr<content::WebContents> contents;
+};
+
+// A views::WebView can draw its WebContents through a surface of its own
+// instead of the widget's compositor (the welcome tour's window works that
+// way), so the root layer copy leaves the page out. Each drawn WebView's
+// contents is painted over the bitmap where it sits on screen. Browser
+// windows skip this: their pages are already in the copy, and painting them
+// again would square off the content card's corners, cover views drawn over
+// the page (such as the revealed sidebar) and mix in a later frame.
+void CollectWebViews(views::View* view, std::vector<WebViewShot>* out) {
+  if (!view || !view->IsDrawn()) {
+    return;
+  }
+  if (auto* web_view = views::AsViewClass<views::WebView>(view)) {
+    if (content::WebContents* contents = web_view->web_contents()) {
+      out->push_back({web_view->GetBoundsInScreen(), contents->GetWeakPtr()});
+    }
+  }
+  for (views::View* child : view->children()) {
+    CollectWebViews(child, out);
+  }
+}
+
+void DrawWebViews(base::WeakPtr<views::Widget> widget,
+                  SkBitmap bitmap,
+                  std::vector<WebViewShot> webviews,
+                  base::OnceCallback<void(SkBitmap)> done) {
+  while (!webviews.empty() && !webviews.back().contents) {
+    webviews.pop_back();
+  }
+  if (!widget || webviews.empty()) {
+    std::move(done).Run(std::move(bitmap));
+    return;
+  }
+  const WebViewShot shot = webviews.back();
+  webviews.pop_back();
+  content::RenderWidgetHostView* view =
+      shot.contents->GetRenderWidgetHostView();
+  if (!view) {
+    DrawWebViews(widget, std::move(bitmap), std::move(webviews),
+                 std::move(done));
+    return;
+  }
+  const gfx::Rect window = widget->GetWindowBoundsInScreen();
+  const float scale = window.width() > 0
+                          ? static_cast<float>(bitmap.width()) / window.width()
+                          : 1.0f;
+  const gfx::Size pixels = gfx::ScaleToRoundedSize(shot.bounds.size(), scale);
+  auto draw = base::BindOnce(
+      [](base::WeakPtr<views::Widget> widget, SkBitmap bitmap,
+         std::vector<WebViewShot> webviews,
+         base::OnceCallback<void(SkBitmap)> done, gfx::Rect dest, float scale,
+         const content::CopyFromSurfaceResult& result) {
+        if (widget && result.has_value() && !result->bitmap.drawsNothing()) {
+          SkCanvas canvas(bitmap);
+          canvas.drawImageRect(
+              result->bitmap.asImage(),
+              SkRect::MakeXYWH(dest.x() * scale, dest.y() * scale,
+                               dest.width() * scale, dest.height() * scale),
+              SkSamplingOptions(SkFilterMode::kLinear));
+        }
+        DrawWebViews(widget, std::move(bitmap), std::move(webviews),
+                     std::move(done));
+      },
+      widget, std::move(bitmap), std::move(webviews), std::move(done),
+      shot.bounds - window.OffsetFromOrigin(), scale);
+  // The result may arrive on another sequence; the widget, the WebContents
+  // and the bitmap are only touched on this one.
+  view->CopyFromSurface(gfx::Rect(shot.bounds.size()), pixels, base::Seconds(2),
+                        base::BindPostTaskToCurrentDefault(std::move(draw)));
+}

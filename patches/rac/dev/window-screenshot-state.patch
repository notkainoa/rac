+// A trackpad reports at 120 Hz.
+constexpr base::TimeDelta kPointerStep = base::Microseconds(8333);
+
+BrowserWindowInterface* BrowserFor(views::Widget* widget) {
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(widget->GetNativeWindow());
+  return browser_view ? browser_view->browser() : nullptr;
+}
+
+// --- Spaces ---------------------------------------------------------------
+
+bool SetSpaceTheme(views::Widget* widget,
+                   const std::vector<std::string>& words) {
+  BrowserWindowInterface* browser = BrowserFor(widget);
+  SpacesWindowManager* manager =
+      browser ? SpacesWindowManager::From(browser) : nullptr;
+  std::optional<SpaceId> space =
+      manager ? manager->GetActiveSpaceId(browser) : std::nullopt;
+  if (!space) {
+    LOG(ERROR) << "rac window screenshot: the window shows no space";
+    return false;
+  }
+  size_t preset = 0;
+  if (words[1] != "-") {
+    if (!base::StringToSizeT(words[1], &preset) ||
+        !manager->spaces()->SetSpaceThemePreset(*space, preset)) {
+      LOG(ERROR) << "rac window screenshot: bad preset " << words[1];
+      return false;
+    }
+  }
+  if (words.size() == 3) {
+    SpaceTheme::Mode mode;
+    if (words[2] == "auto") {
+      mode = SpaceTheme::Mode::kAuto;
+    } else if (words[2] == "light") {
+      mode = SpaceTheme::Mode::kLight;
+    } else if (words[2] == "dark") {
+      mode = SpaceTheme::Mode::kDark;
+    } else {
+      LOG(ERROR) << "rac window screenshot: bad mode " << words[2];
+      return false;
+    }
+    manager->spaces()->SetSpaceThemeMode(*space, mode);
+  }
+  return true;
+}
+
+void NewSpace(views::Widget* widget) {
+  BrowserWindowInterface* browser = BrowserFor(widget);
+  if (SpacesWindowManager* manager =
+          browser ? SpacesWindowManager::From(browser) : nullptr) {
+    manager->CreateAndShowSpace(browser);
+  } else {
+    LOG(ERROR) << "rac window screenshot: the window has no spaces";
+  }
+}
+
+// --- open-urls --------------------------------------------------------------
+
+void OpenUrls(const std::vector<std::string>& words) {
+  NSMutableArray<NSURL*>* urls = [NSMutableArray array];
+  for (size_t i = 1; i < words.size(); ++i) {
+    if (NSURL* url = [NSURL URLWithString:base::SysUTF8ToNSString(words[i])]) {
+      [urls addObject:url];
+    }
+  }
+  id<NSApplicationDelegate> delegate = NSApp.delegate;
+  if (urls.count == 0 ||
+      ![delegate respondsToSelector:@selector(application:openURLs:)]) {
+    LOG(ERROR) << "rac window screenshot: can't open the URLs";
+    return;
+  }
+  [delegate application:NSApp openURLs:urls];
+}
+
+// --- pointer ----------------------------------------------------------------
+
+// Where +[NSEvent mouseLocation] says the pointer is, in AppKit screen
+// coordinates, while a test holds it. Any thread may ask, so it's locked.
+struct HeldPointer {
+  base::Lock lock;
+  std::optional<NSPoint> point GUARDED_BY(lock);
+};
+
+HeldPointer& Held() {
+  static base::NoDestructor<HeldPointer> held;
+  return *held;
+}
+
+void SetHeldPointer(std::optional<NSPoint> point) {
+  base::AutoLock lock(Held().lock);
+  Held().point = point;
+}
+
+// Routes +[NSEvent mouseLocation] through Held(). Views read the pointer
+// there (display::Screen::GetCursorScreenPoint), including the hidden
+// sidebar's edge reveal.
+void HoldPointerLocation() {
+  static bool installed = false;
+  if (installed) {
+    return;
+  }
+  installed = true;
+  Method method =
+      class_getClassMethod([NSEvent class], @selector(mouseLocation));
+  using MouseLocation = NSPoint (*)(id, SEL);
+  static MouseLocation original =
+      reinterpret_cast<MouseLocation>(method_getImplementation(method));
+  method_setImplementation(method,
+                           imp_implementationWithBlock(^NSPoint(id cls) {
+                             {
+                               base::AutoLock lock(Held().lock);
+                               if (Held().point) {
+                                 return *Held().point;
+                               }
+                             }
+                             return original(cls, @selector(mouseLocation));
+                           }));
+}
+
+void MovePointer(views::Widget* widget, const gfx::PointF& point) {
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  if (!window) {
+    return;
+  }
+  HoldPointerLocation();
+  const gfx::Point origin = widget->GetWindowBoundsInScreen().origin();
+  const NSPoint screen = gfx::ScreenPointToNSPoint(gfx::ToRoundedPoint(
+      gfx::PointF(origin.x() + point.x(), origin.y() + point.y())));
+  SetHeldPointer(screen);
+  // The native event reaches AppKit's event monitors, as the mouse would.
+  // Views only track the mouse in the active app, so they get the move
+  // directly too, for hover.
+  NSEvent* event =
+      [NSEvent mouseEventWithType:NSEventTypeMouseMoved
+                         location:[window convertPointFromScreen:screen]
+                    modifierFlags:0
+                        timestamp:NSProcessInfo.processInfo.systemUptime
+                     windowNumber:window.windowNumber
+                          context:nil
+                      eventNumber:0
+                       clickCount:0
+                         pressure:0];
+  [NSApp postEvent:event atStart:NO];
+  const gfx::Point local = gfx::ToRoundedPoint(point);
+  ui::MouseEvent move(ui::EventType::kMouseMoved, local, local,
+                      ui::EventTimeForNow(), ui::EF_NONE, ui::EF_NONE);
+  widget->OnMouseEvent(&move);
+}
+
+void MovePointerAlong(base::WeakPtr<views::Widget> widget,
+                      gfx::PointF from,
+                      gfx::PointF to,
+                      int step,
+                      int steps) {
+  if (!widget || widget->IsClosed()) {
+    return;
+  }
+  const float t = static_cast<float>(step) / steps;
+  MovePointer(widget.get(), gfx::PointF(from.x() + (to.x() - from.x()) * t,
+                                        from.y() + (to.y() - from.y()) * t));
+  if (step < steps) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&MovePointerAlong, widget, from, to, step + 1, steps),
+        kPointerStep);
+  }
+}
+
+}  // namespace
+
+bool HandleStateRequest(views::Widget* widget,
+                        const std::vector<std::string>& words) {
+  if (words.empty()) {
+    return false;
+  }
+  const std::string& verb = words[0];
+  if (verb == "space-theme" && (words.size() == 2 || words.size() == 3)) {
+    SetSpaceTheme(widget, words);
+    return true;
+  }
+  if (verb == "space-new" && words.size() == 1) {
+    NewSpace(widget);
+    return true;
+  }
+  if (verb == "open-urls" && words.size() >= 2) {
+    OpenUrls(words);
+    return true;
+  }
+  if (verb == "pointer" && words.size() == 2 && words[1] == "off") {
+    SetHeldPointer(std::nullopt);
+    return true;
+  }
+  double x = 0;
+  double y = 0;
+  if (verb == "pointer" && words.size() == 3 &&
+      base::StringToDouble(words[1], &x) &&
+      base::StringToDouble(words[2], &y)) {
+    MovePointer(widget, gfx::PointF(x, y));
+    return true;
+  }
+  double x1 = 0;
+  double y1 = 0;
+  int ms = 0;
+  if (verb == "pointer-path" && words.size() == 6 &&
+      base::StringToDouble(words[1], &x) &&
+      base::StringToDouble(words[2], &y) &&
+      base::StringToDouble(words[3], &x1) &&
+      base::StringToDouble(words[4], &y1) && base::StringToInt(words[5], &ms) &&
+      ms >= 0) {
+    MovePointerAlong(
+        widget->GetWeakPtr(), gfx::PointF(x, y), gfx::PointF(x1, y1), 0,
+        std::max(1, static_cast<int>(base::Milliseconds(ms) / kPointerStep)));
+    return true;
+  }
+  return false;
+}
+

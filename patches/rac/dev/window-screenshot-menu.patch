+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_DEV_MENU_DUMP_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_DEV_MENU_DUMP_H_
+
+#include <string>
+#include <vector>
+
+namespace rac::dev {
+
+// Starts remembering the native NSMenu that is open, from AppKit's
+// NSMenuDidBeginTracking / NSMenuDidEndTracking notifications. Call it once
+// at startup: a menu that opened earlier is not seen. Does nothing the
+// second time. Views menus need no setup.
+void ObserveMenus();
+
+// Handles `menu-dump OUT.txt`: writes the open menu (a views menu, else a native one), one item per
+// line, tab separated:
+//   INDEX  LABEL  enabled|disabled  checked|-  separator|-  submenu|-
+//          [name=SPOKEN]
+// The last column appears only for a views menu item whose accessible name
+// differs from its label, such as a space list's current space.
+// A submenu's items follow it with dotted indexes (2.0, 2.1). Writes
+// "no open menu" when none is open.
+// `menu-dump OUT main:TITLE` writes instead the submenu of the main menu
+// bar's top-level item titled TITLE (one word of [A-Za-z0-9._-]), after its
+// delegate's menuNeedsUpdate:, with two more columns: hidden|- and the key
+// equivalent (such as ⇧⌘N, or none). Hidden items are listed. Writes
+// "no menu TITLE" if there is none.
+// Returns false for other requests.
+bool HandleMenuRequest(const std::vector<std::string>& words);
+
+}  // namespace rac::dev
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_DEV_MENU_DUMP_H_

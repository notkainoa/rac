+
+import("//build/buildflag_header.gni")
+import("//chrome/browser/rac/dev/dev_switches.gni")
+
+# BUILDFLAG(RAC_DEV_SWITCHES): code for a dev-only switch goes inside it,
+# including the switch's name, so release binaries don't contain it.
+buildflag_header("buildflags") {
+  header = "buildflags.h"
+  flags = [ "RAC_DEV_SWITCHES=$rac_dev_switches" ]
+}
--- /dev/null
+++ b/chrome/browser/rac/dev/dev_switches.gni
@@ -0,0 +1,9 @@
+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+declare_args() {
+  # rac's dev-only command-line switches, such as --rac-import-source-root.
+  # Release builds are official builds, so they're compiled out there.
+  rac_dev_switches = !is_official_build
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_DEV_WEB_WHEEL_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_DEV_WEB_WHEEL_H_
+
+#include "ui/gfx/geometry/point.h"
+
+namespace views {
+class Widget;
+}
+
+namespace rac::dev {
+
+// Scrolls the page under `point` (in `widget`'s coordinates) by `delta_y`
+// device-independent pixels, positive up like a wheel, as a
+// began/changed/ended wheel gesture sent straight to the page's
+// RenderWidgetHost. A Views wheel event stops at the NativeViewHost, so it
+// can't scroll a page. Returns false, and does nothing, when the point is not
+// over web contents.
+bool ScrollPageAt(views::Widget* widget, const gfx::Point& point, int delta_y);
+
+}  // namespace rac::dev
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_DEV_WEB_WHEEL_H_

+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/dev/web_wheel.h"
+
+#include "base/time/time.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/input/web_mouse_wheel_event.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace rac::dev {
+namespace {
+
+void Forward(content::RenderWidgetHost* host,
+             const gfx::Point& in_page,
+             const gfx::Point& on_screen,
+             int delta_y,
+             blink::WebMouseWheelEvent::Phase phase) {
+  blink::WebMouseWheelEvent event(blink::WebInputEvent::Type::kMouseWheel,
+                                  blink::WebInputEvent::kNoModifiers,
+                                  base::TimeTicks::Now());
+  event.SetPositionInWidget(in_page.x(), in_page.y());
+  event.SetPositionInScreen(on_screen.x(), on_screen.y());
+  event.delta_y = delta_y;
+  event.wheel_ticks_y = delta_y / 120.0f;
+  event.phase = phase;
+  host->ForwardWheelEvent(event);
+}
+
+}  // namespace
+
+bool ScrollPageAt(views::Widget* widget,
+                  const gfx::Point& point,
+                  int delta_y) {
+  if (!widget || !widget->GetRootView()) {
+    return false;
+  }
+  views::WebView* web_view = nullptr;
+  for (views::View* view = widget->GetRootView()->GetEventHandlerForPoint(point);
+       view && !web_view; view = view->parent()) {
+    web_view = views::AsViewClass<views::WebView>(view);
+  }
+  content::WebContents* contents = web_view ? web_view->web_contents() : nullptr;
+  content::RenderWidgetHostView* host_view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (!host_view || !web_view->GetVisible()) {
+    return false;
+  }
+  gfx::Point in_page = point;
+  views::View::ConvertPointFromWidget(web_view, &in_page);
+  const gfx::Point on_screen =
+      widget->GetWindowBoundsInScreen().origin() + point.OffsetFromOrigin();
+  content::RenderWidgetHost* host = host_view->GetRenderWidgetHost();
+  const int first = delta_y / 2;
+  Forward(host, in_page, on_screen, first, blink::WebMouseWheelEvent::kPhaseBegan);
+  Forward(host, in_page, on_screen, delta_y - first,
+          blink::WebMouseWheelEvent::kPhaseChanged);
+  Forward(host, in_page, on_screen, 0, blink::WebMouseWheelEvent::kPhaseEnded);
+  return true;
+}
+
+}  // namespace rac::dev

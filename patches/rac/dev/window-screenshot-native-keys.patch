+// Modifier flags named like "ctrl,shift", or "none".
+NSEventModifierFlags NativeModifiers(std::string_view names) {
+  NSEventModifierFlags flags = 0;
+  for (std::string_view name : base::SplitStringPiece(
+           names, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (name == "ctrl") {
+      flags |= NSEventModifierFlagControl;
+    } else if (name == "shift") {
+      flags |= NSEventModifierFlagShift;
+    } else if (name == "cmd") {
+      flags |= NSEventModifierFlagCommand;
+    } else if (name == "alt") {
+      flags |= NSEventModifierFlagOption;
+    }
+  }
+  return flags;
+}
+
+// Queues a native key event for `widget`'s window, as the keyboard would.
+// It goes through the whole AppKit path (event monitors, key equivalents,
+// the window), even while the app is in the background.
+void PostNativeKey(views::Widget* widget,
+                   NSEventType type,
+                   unsigned short key_code,
+                   NSString* characters,
+                   NSEventModifierFlags flags) {
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  NSEvent* event =
+      [NSEvent keyEventWithType:type
+                             location:NSZeroPoint
+                        modifierFlags:flags
+                            timestamp:NSProcessInfo.processInfo.systemUptime
+                         windowNumber:window.windowNumber
+                              context:nil
+                           characters:characters
+          charactersIgnoringModifiers:characters
+                            isARepeat:NO
+                              keyCode:key_code];
+  [NSApp postEvent:event atStart:NO];
+}

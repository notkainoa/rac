+
+// The number of items, inside folders or not, before `position`.
+size_t CountItemsBefore(const SidebarList& list,
+                        const SidebarPosition& position) {
+  size_t count = 0;
+  for (size_t i = 0; i < list.entries.size(); ++i) {
+    const SidebarList::Entry& entry = list.entries[i];
+    if (position.folder_id.empty() && i == position.index) {
+      break;
+    }
+    if (std::holds_alternative<SidebarItem>(entry)) {
+      ++count;
+      continue;
+    }
+    const auto& folder = std::get<SidebarFolder>(entry);
+    if (folder.id == position.folder_id) {
+      return count + std::min(position.index, folder.items.size());
+    }
+    count += folder.items.size();
+  }
+  return count;
+}

+SidebarList WithoutDraggedItems(const SidebarList& list,
+                                const SidebarWindowSync::Drag& drag) {
+  std::set<std::string> ids;
+  for (const SidebarWindowSync::Drag::DraggedTab& dragged : drag.tabs) {
+    if (const tabs::TabInterface* tab = dragged.tab.Get()) {
+      ids.insert(GetSidebarItemId(tab->GetContents()));
+    }
+  }
+  SidebarList result;
+  for (const SidebarList::Entry& entry : list.entries) {
+    if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+      if (!ids.contains(item->id)) {
+        result.entries.push_back(*item);
+      }
+      continue;
+    }
+    SidebarFolder folder = std::get<SidebarFolder>(entry);
+    std::erase_if(folder.items, [&](const SidebarItem& item) {
+      return ids.contains(item.id);
+    });
+    result.entries.push_back(std::move(folder));
+  }
+  return result;

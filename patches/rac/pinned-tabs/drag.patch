+bool PinnedSection::HandleTabDrag(TabDragHandler& handler,
+                                  const TabCollectionNode& container_node,
+                                  const views::ProposedLayout& layout,
+                                  const gfx::Rect& dragged_bounds) const {
+  SidebarWindowSync* sync =
+      browser_ ? SidebarWindows::ForBrowser(browser_) : nullptr;
+  const SidebarWindowSync::Drag* drag = sync ? sync->drag() : nullptr;
+  if (!drag) {
+    return false;
+  }
+  const SidebarList base = WithoutDraggedItems(GetList(), *drag);
+
+  // Where each pinned tab that isn't dragged is, and its place among all the
+  // items.
+  struct ItemPlace {
+    SidebarPosition position;
+    size_t order = 0;
+  };
+  base::flat_map<std::string, ItemPlace> item_places;
+  base::flat_map<std::string, size_t> folder_indexes;
+  size_t order = 0;
+  for (size_t i = 0; i < base.entries.size(); ++i) {
+    const SidebarList::Entry& entry = base.entries[i];
+    if (const auto* item = std::get_if<SidebarItem>(&entry)) {
+      item_places[item->id] = {SidebarPosition{std::string(), i}, order++};
+      continue;
+    }
+    const auto& folder = std::get<SidebarFolder>(entry);
+    folder_indexes[folder.id] = i;
+    for (size_t j = 0; j < folder.items.size(); ++j) {
+      item_places[folder.items[j].id] = {SidebarPosition{folder.id, j},
+                                         order++};
+    }
+  }
+  auto get_place = [&](const TabCollectionNode& node) -> const ItemPlace* {
+    const tabs::TabInterface* tab = GetNodeTab(node);
+    if (!tab) {
+      return nullptr;
+    }
+    auto it = item_places.find(GetSidebarItemId(tab->GetContents()));
+    return it == item_places.end() ? nullptr : &it->second;
+  };
+  auto expanded_folder = [&](const std::string& folder_id) {
+    const SidebarFolder* folder =
+        folder_id.empty() ? nullptr : base.FindFolder(folder_id);
+    return folder && !folder->collapsed ? folder_id : std::string();
+  };
+
+  // The rows and tabs the drop can go before, top to bottom, with the
+  // dragged tabs' own space taken out.
+  struct Slot {
+    // Where the drop goes if it's before this slot, or nullopt for open tabs.
+    std::optional<SidebarPosition> position;
+    // The open folder this slot is the header or a tab of.
+    std::string folder_id;
+    raw_ptr<const TabCollectionNode> node = nullptr;
+    int center_y = 0;
+  };
+  std::vector<Slot> slots;
+  const int dragged_height = dragged_bounds.height();
+  bool after_dragged = false;
+  for (const views::ChildLayout& child : layout.child_layouts) {
+    if (!child.visible) {
+      continue;
+    }
+    if (handler.IsViewDragging(*child.child_view)) {
+      after_dragged = true;
+      continue;
+    }
+    Slot slot;
+    slot.center_y =
+        child.bounds.CenterPoint().y() - (after_dragged ? dragged_height : 0);
+    if (child.child_view == divider_) {
+      slot.position = SidebarPosition{std::string(), base.entries.size()};
+    } else if (const auto* header =
+                   views::AsViewClass<FolderHeaderView>(child.child_view)) {
+      auto it = std::ranges::find_if(folder_headers_, [&](const auto& entry) {
+        return entry.second == header;
+      });
+      if (it == folder_headers_.end() || !folder_indexes.contains(it->first)) {
+        continue;
+      }
+      slot.position =
+          SidebarPosition{std::string(), folder_indexes.at(it->first)};
+      slot.folder_id = expanded_folder(it->first);
+    } else if (const TabCollectionNode* node =
+                   GetNodeForView(child.child_view)) {
+      slot.node = node;
+      if (const ItemPlace* place = get_place(*node)) {
+        slot.position = place->position;
+        slot.folder_id = expanded_folder(place->position.folder_id);
+      }
+    } else {
+      continue;
+    }
+    slots.push_back(std::move(slot));
+  }
+
+  // The drop goes before the first slot whose middle is below the top of the
+  // dragged tabs, as when Chromium reorders tabs.
+  const int dragged_top = dragged_bounds.y();
+  size_t next = 0;
+  while (next < slots.size() && dragged_top >= slots[next].center_y) {
+    ++next;
+  }
+  std::optional<SidebarPosition> position;
+  if (next < slots.size()) {
+    position = slots[next].position;
+  }
+  // Below the last tab of an open folder, the upper half of the gap is the
+  // end of the folder and the lower half is after it.
+  if (next > 0 && !slots[next - 1].folder_id.empty() &&
+      (next == slots.size() ||
+       slots[next].folder_id != slots[next - 1].folder_id)) {
+    const Slot& previous = slots[next - 1];
+    const int next_center = next < slots.size()
+                                ? slots[next].center_y
+                                : previous.center_y + dragged_height;
+    if (dragged_top < (previous.center_y + next_center) / 2) {
+      position =
+          SidebarPosition{previous.folder_id,
+                          base.FindFolder(previous.folder_id)->items.size()};
+    }
+  }
+  if (!drag->can_pin) {
+    position.reset();
+  }
+
+  // Move the dragged tabs in the tab strip to match: before the first tab
+  // that comes after the drop.
+  const TabCollectionNode* target = nullptr;
+  if (position || (next < slots.size() && slots[next].position)) {
+    const size_t before = position ? CountItemsBefore(base, *position) : order;
+    for (const auto& child : container_node.children()) {
+      if (handler.IsViewDragging(*child->view())) {
+        continue;
+      }
+      const ItemPlace* place = get_place(*child);
+      if (!place || place->order >= before) {
+        target = child.get();
+        break;
+      }
+    }
+  } else if (next < slots.size()) {
+    target = slots[next].node;
+  }
+  sync->SetDragPinnedPosition(position);
+  handler.HandleDraggedTabsIntoPosition(container_node, target);
+  return true;
+}

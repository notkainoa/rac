+void SidebarWindowSync::CommitDrag(const Drag& drag) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::vector<tabs::TabInterface*> tabs;
+  for (const Drag::DraggedTab& dragged : drag.tabs) {
+    tabs::TabInterface* tab = dragged.tab.Get();
+    if (tab && model->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+      tabs.push_back(tab);
+    }
+  }
+
+  // Tabs dropped among the favorites. Reconcile() turns open tabs pinned
+  // there into favorites.
+  for (tabs::TabInterface* tab : tabs) {
+    const std::string id = GetSidebarItemId(tab->GetContents());
+    if (tab->IsPinned() && !id.empty() && items_->FindItem(id) &&
+        !IsFavorite(tab)) {
+      items_->MoveItem(
+          id, SidebarItems::kFavorites,
+          SidebarPosition{std::string(),
+                          static_cast<size_t>(model->GetIndexOfTab(tab))});
+    }
+  }
+  PullFavoritesOrder();
+
+  // The rest become pinned tabs or open tabs.
+  const std::string pinned_key = SidebarItems::PinnedListKey(space_);
+  std::vector<std::string> pinned_ids;
+  for (tabs::TabInterface* tab : tabs) {
+    if (tab->IsPinned()) {
+      continue;
+    }
+    content::WebContents* contents = tab->GetContents();
+    std::string id = GetSidebarItemId(contents);
+    if (!id.empty() && !items_->FindItem(id)) {
+      SetSidebarItemId(contents, std::string());
+      id.clear();
+    }
+    const bool pin = drag.can_pin && drag.pinned_position && !tab->GetGroup() &&
+                     !tab->IsSplit();
+    if (!pin) {
+      Release(tab);
+      continue;
+    }
+    if (id.empty()) {
+      id = items_->AddItem(pinned_key, SidebarPosition{std::string(), SIZE_MAX},
+                           GetPageUrl(tab), contents->GetTitle());
+      if (id.empty()) {
+        continue;
+      }
+      SetSidebarItemId(contents, id);
+    }
+    pinned_ids.push_back(std::move(id));
+  }
+  if (!pinned_ids.empty()) {
+    items_->MoveItems(pinned_ids, pinned_key, *drag.pinned_position);
+  }
+}
+
+void SidebarWindowSync::CancelDrag(const Drag& drag) {
+  // The drag controller still holds the dragged tabs' views, which pinning
+  // or unpinning the tabs would replace, so wait for it to go away.
+  restoring_drag_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SidebarWindowSync::RestoreDraggedTabs,
+                                weak_factory_.GetWeakPtr(), drag.tabs));
+}
+
+void SidebarWindowSync::RestoreDraggedTabs(std::vector<Drag::DraggedTab> tabs) {
+  restoring_drag_ = false;
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (!drag_ && !model->closing_all()) {
+    base::AutoReset<int> changing(&changing_tabs_, changing_tabs_ + 1);
+    for (const Drag::DraggedTab& dragged : tabs) {
+      tabs::TabInterface* tab = dragged.tab.Get();
+      int index = tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+      if (index == TabStripModel::kNoTab ||
+          tab->IsPinned() == dragged.was_pinned) {
+        continue;
+      }
+      index = model->SetTabPinned(index, dragged.was_pinned);
+      model->MoveWebContentsAt(index,
+                               std::min(dragged.index, model->count() - 1),
+                               /*select_after_move=*/false);
+    }
+  }
+  ScheduleReconcile();
+}

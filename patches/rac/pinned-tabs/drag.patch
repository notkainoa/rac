+namespace rac {
+
+// Hooks that let a tab drag in the vertical sidebar move tabs between
+// favorites, pinned tabs, and open tabs. Chromium keeps a drag of pinned
+// tabs among the pinned tabs; in rac, where the pointer is decides.
+
+// Called when dragged tabs attach to `model`'s window, at the start of a drag
+// or when it moves in from another window.
+void OnTabDragStarted(TabStripModel& model, const DragSessionData& session);
+// Called when the dragged tabs are dropped in `model`'s window.
+void OnTabsDropped(TabStripModel& model);
+// Called when the drag stops or leaves `model`'s window.
+void OnTabDragEnded(TabStripModel& model);
+
+// Returns whether a drag at `point_in_screen` goes to the favorites, which
+// are above `unpinned_container`, instead of the open tabs.
+bool DragTargetsFavorites(TabDragHandler& handler,
+                          views::View* unpinned_container,
+                          const gfx::Point& point_in_screen);
+
+// A dragged tab's new slot view, with the dragged view's offset from the
+// source view at the start of the drag.
+struct RecreatedDragView {
+  raw_ptr<TabSlotView> slot_view;
+  gfx::Vector2d offset;
+};
+
+// Pins the dragged tabs as they enter the favorites, or unpins them as they
+// leave. That recreates their views, so this points `session` at the new
+// ones and returns them for the caller to prepare for dragging.
+std::vector<RecreatedDragView> MatchDraggedTabsToContainer(
+    TabDragHandler& handler,
+    DragSessionData& session,
+    bool pinned);
+
+}  // namespace rac

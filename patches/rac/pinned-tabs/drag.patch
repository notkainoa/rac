+
+DragList MakeDragList(const SidebarList& list,
+                      const SidebarWindowSync::Drag& drag) {
+  DragList result;
+  result.list = WithoutDraggedItems(list, drag);
+  const std::vector<const tabs::TabInterface*> tabs = GetTabsToPin(drag);
+  if (tabs.empty()) {
+    return result;
+  }
+  std::vector<SidebarItem> items;
+  for (const tabs::TabInterface* tab : tabs) {
+    SidebarItem& item = items.emplace_back();
+    item.id = "rac.drag." + base::NumberToString(items.size());
+    result.dragged_tabs.emplace(item.id, tab);
+  }
+  const SidebarPosition& position = *drag.pinned_position;
+  std::vector<SidebarList::Entry>& entries = result.list.entries;
+  if (position.folder_id.empty()) {
+    const size_t index = std::min(position.index, entries.size());
+    entries.insert(entries.begin() + index, items.begin(), items.end());
+    return result;
+  }
+  for (SidebarList::Entry& entry : entries) {
+    auto* folder = std::get_if<SidebarFolder>(&entry);
+    if (folder && folder->id == position.folder_id) {
+      const size_t index = std::min(position.index, folder->items.size());
+      folder->items.insert(folder->items.begin() + index, items.begin(),
+                           items.end());
+      break;
+    }
+  }

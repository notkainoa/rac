+SidebarWindowSync* GetDraggingWindow(TabStripModel& model) {
+  SidebarWindowSync* sync = SidebarWindows::ForTabStripModel(&model);
+  return sync && sync->drag() && sync->drag()->can_pin ? sync : nullptr;
+}
+
+}  // namespace
+
+void OnTabDragStarted(TabStripModel& model, const DragSessionData& session) {
+  SidebarWindowSync* sync = SidebarWindows::ForTabStripModel(&model);
+  if (!sync) {
+    return;
+  }
+  bool can_pin =
+      !session.group_header_drag_data_ && session.dragging_groups.empty();
+  std::vector<tabs::TabInterface*> tabs;
+  for (const TabDragData& data : session.tab_drag_data_) {
+    tabs::TabInterface* tab =
+        data.contents ? tabs::TabInterface::GetFromContents(data.contents)
+                      : nullptr;
+    if (!tab || model.GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+      continue;
+    }
+    can_pin = can_pin && !tab->IsSplit();
+    tabs.push_back(tab);
+  }
+  sync->StartDrag(tabs, can_pin);
+}
+
+void OnTabsDropped(TabStripModel& model) {
+  if (SidebarWindowSync* sync = SidebarWindows::ForTabStripModel(&model)) {
+    sync->SetDragDropped();
+  }
+}
+
+void OnTabDragEnded(TabStripModel& model) {
+  if (SidebarWindowSync* sync = SidebarWindows::ForTabStripModel(&model)) {
+    sync->EndDrag();
+  }
+}
+
+bool DragTargetsFavorites(TabDragHandler& handler,
+                          views::View* unpinned_container,
+                          const gfx::Point& point_in_screen) {
+  TabDragContext* context = handler.GetDragContext();
+  views::ScrollView* scroll_view =
+      unpinned_container
+          ? views::ScrollView::GetScrollViewForContents(unpinned_container)
+          : nullptr;
+  if (!context || !GetDraggingWindow(*context->GetTabStripModel()) ||
+      !scroll_view || !PinnedSection::Get(unpinned_container)) {
+    return handler.IsDraggingPinnedTabs();
+  }
+  return point_in_screen.y() < scroll_view->GetBoundsInScreen().y();
+}
+
+std::vector<RecreatedDragView> MatchDraggedTabsToContainer(
+    TabDragHandler& handler,
+    DragSessionData& session,
+    bool pinned) {
+  TabDragContext* context = handler.GetDragContext();
+  TabStripModel& model = *context->GetTabStripModel();
+  if (!GetDraggingWindow(model)) {
+    return {};
+  }
+  struct Change {
+    raw_ptr<TabDragData> data;
+    raw_ptr<tabs::TabInterface> tab;
+    gfx::Vector2d offset;
+  };
+  std::vector<Change> changes;
+  for (TabDragData& data : session.tab_drag_data_) {
+    tabs::TabInterface* tab =
+        data.contents ? tabs::TabInterface::GetFromContents(data.contents)
+                      : nullptr;
+    if (!tab || tab->IsPinned() == pinned || !data.attached_view) {
+      continue;
+    }
+    changes.push_back({&data, tab,
+                       handler
+                           .GetOffsetFromSourceAtDragStart(
+                               handler.ViewFromTabSlot(data.attached_view))
+                           .value_or(gfx::Vector2d())});
+  }
+  if (changes.empty()) {
+    return {};
+  }
+
+  // Changing a tab's pin state destroys its view and slot view, and the
+  // layouts it triggers ask which views are dragging.
+  for (Change& change : changes) {
+    change.data->attached_view = nullptr;
+  }
+  // Pinning moves a tab to the end of the favorites, and unpinning moves it
+  // to the top of the open tabs. Unpin last to first to keep their order.
+  if (!pinned) {
+    std::ranges::reverse(changes);
+  }
+  for (Change& change : changes) {
+    const int index = model.GetIndexOfTab(change.tab);
+    if (index != TabStripModel::kNoTab) {
+      model.SetTabPinned(index, pinned);
+    }
+  }
+
+  std::vector<RecreatedDragView> views;
+  for (Change& change : changes) {
+    change.data->pinned = change.tab->IsPinned();
+    change.data->attached_view =
+        context->GetTabForContents(change.data->contents);
+    if (change.data->attached_view) {
+      views.push_back({change.data->attached_view, change.offset});
+    }
+  }
+  return views;
+}

+void SidebarWindowSync::StartDrag(const std::vector<tabs::TabInterface*>& tabs,
+                                  bool can_pin) {
+  // Also runs before Start() in the window a drag creates for tabs dragged
+  // out of the tab strip. It waits for the drag, so a window that only
+  // carried the tabs to another window closes without opening any items.
+  drag_.emplace();
+  drag_->can_pin = can_pin;
+  for (tabs::TabInterface* tab : tabs) {
+    drag_->tabs.push_back({tab->GetHandle(), tab->IsPinned(),
+                           browser_->GetTabStripModel()->GetIndexOfTab(tab)});
+  }
+  // Pinned tabs stay in place until the drag moves them.
+  const std::string pinned_key = SidebarItems::PinnedListKey(space_);
+  for (tabs::TabInterface* tab : tabs) {
+    if (tab->IsPinned()) {
+      continue;
+    }
+    const std::string id = GetSidebarItemId(tab->GetContents());
+    std::string list_key;
+    if (!id.empty() && items_->FindItem(id, &list_key) &&
+        list_key == pinned_key) {
+      drag_->pinned_position = GetItemPosition(items_->GetList(pinned_key), id);
+    }
+    break;
+  }
+  drag_changed_callbacks_.Notify();

+#include "chrome/browser/ui/views/rac/sidebar/sidebar_style.h"
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/views/view.h"
+
+namespace rac::sidebar_style {
+
+namespace {
+
+// The active tab's color, faded so a resting tile is a soft step up from the
+// sidebar in light, dark, and themed windows alike.
+constexpr float kRestOpacity = 0.45f;
+
+}  // namespace
+
+void PaintFavoriteTileRest(gfx::Canvas* canvas,
+                           const views::View& tile,
+                           const SkPath& path,
+                           bool frame_active) {
+  const ui::ColorProvider* color_provider = tile.GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  const SkColor color = color_provider->GetColor(
+      frame_active ? kColorTabBackgroundActiveFrameActive
+                   : kColorTabBackgroundActiveFrameInactive);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(
+      color, static_cast<U8CPU>(SkColorGetA(color) * kRestOpacity)));
+  canvas->DrawPath(path, flags);
+}
+
+}  // namespace rac::sidebar_style

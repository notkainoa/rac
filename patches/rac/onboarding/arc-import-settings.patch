+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {html, nothing} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsSpacesImportCardElement} from './spaces_import_card.js';
+
+export function getHtml(this: SettingsSpacesImportCardElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-section page-title="$i18n{racSpacesImportTitle}">
+  ${this.isUndone_() ? html`
+    <div class="cr-row first">
+      <div class="flex cr-padded-text">${this.undoneText_()}</div>
+    </div>
+  ` : nothing}
+  ${this.isImported_() ? html`
+    <div class="cr-row first two-line">
+      <div class="flex cr-padded-text">
+        <div>${this.importedOnText_()}</div>
+        <div class="secondary">${this.undoUntilText_()}</div>
+      </div>
+      ${this.canUndo_() ? html`
+        <cr-button id="undoButton" @click="${this.onUndoClick_}">
+          $i18n{racArcUndoImport}
+        </cr-button>` : nothing}
+    </div>
+  ` : nothing}
+  ${this.isFound_() ? html`
+    <div class="cr-row ${this.isImported_() || this.isUndone_() ? '' : 'first'} two-line">
+      <div class="flex cr-padded-text description">
+        <div>${this.importTitle_()}</div>
+        <div class="secondary">${this.importDescription_()}</div>
+      </div>
+      <cr-button id="importButton" @click="${this.onImportClick_}">
+        $i18n{racArcImportButton}
+      </cr-button>
+    </div>
+  ` : nothing}
+  <cr-link-row id="otherBrowser"
+      class="${this.isImported_() || this.isUndone_() || this.isFound_() ?
+          'hr' : 'first'}"
+      label="$i18n{racImportOtherBrowser}"
+      sub-label="$i18n{racImportOtherBrowserDescription}"
+      @click="${this.onOtherBrowserClick_}">
+  </cr-link-row>
+</settings-section>
+
+${this.showUndoDialog_ ? html`
+  <cr-dialog id="undoDialog" show-on-attach
+      @close="${this.onUndoDialogClose_}">
+    <div slot="title">$i18n{racArcUndoTitle}</div>
+    <div slot="body">
+      <p>${this.undoBodyText_()}</p>
+      <p>$i18n{racArcUndoKeeps}</p>
+      ${this.undoError_.length ? html`
+        <div id="undoError" role="alert">
+          ${this.undoError_.map(text => html`<p>${text}</p>`)}
+        </div>` : nothing}
+    </div>
+    <div slot="button-container">
+      <cr-button class="cancel-button" ?disabled="${this.undoing_}"
+          @click="${this.onUndoCancelClick_}">
+        $i18n{cancel}
+      </cr-button>
+      <cr-button class="action-button" ?disabled="${this.undoing_}"
+          @click="${this.onUndoConfirmClick_}">
+        $i18n{racArcUndoImport}
+      </cr-button>
+    </div>
+  </cr-dialog>` : nothing}
+<!--_html_template_end_-->`;
+  // clang-format on
+}

@@ -0,0 +1,254 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-spaces-import-card' is the Spaces and import card on the General
+ * page. It opens the Arc step of the welcome tour in its own window
+ * (chrome://setup?arc, the same screens as the tour), offers Undo for the 7
+ * days the importer keeps its snapshot, with a confirm dialog, and links to
+ * the import dialog for other browsers. It talks to ArcImportHandler, which
+ * Settings gets with OnboardingHandler. With no Arc on the Mac and no import
+ * to undo, it shows only the other-browsers row.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import '../settings_page/settings_section.js';
+
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {PluralStringProxyImpl} from 'chrome://resources/js/plural_string_proxy.js';
+import {CrLitElement, css} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+import {routes} from '../route.js';
+import {Router} from '../router.js';
+import {getCss as getSettingsSharedLit} from '../settings_shared_lit.css.js';
+
+import {getHtml} from './spaces_import_card.html.js';
+
+/** racArcImportGetState; see arc_import_proxy.ts in rac_onboarding. */
+export interface ArcImportSummary {
+  found: boolean;
+  status: 'none'|'undoable'|'undone'|'expired';
+  importedAt: string|null;
+  undoUntil: string|null;
+  undoSnapshot: string|null;
+  /** 'undone' only, and null if the record doesn't say when. */
+  undoneAt: string|null;
+  signInsAvailable: boolean;
+}
+
+export type UndoResult =
+    'undone'|'partlyUndone'|'busy'|'expired'|'nothingToUndo'|'failed';
+
+/** racArcImportUndo's reply; the lists are filled only for partlyUndone. */
+export interface UndoOutcome {
+  undoResult: UndoResult;
+  keptSpaces: string[];
+  blockedProfiles: string[];
+}
+
+const SettingsSpacesImportCardElementBase =
+    WebUiListenerMixinLit(CrLitElement);
+
+export class SettingsSpacesImportCardElement extends
+    SettingsSpacesImportCardElementBase {
+  static get is() {
+    return 'settings-spaces-import-card';
+  }
+
+  static override get styles() {
+    return [
+      getCrSharedStyle(),
+      getSettingsSharedLit(),
+      // Keeps a two-line description clear of the button beside it.
+      css`.description { margin-inline-end: var(--rac-spacing-24); }`,
+    ];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      summary_: {type: Object},
+      showUndoDialog_: {type: Boolean},
+      undoing_: {type: Boolean},
+      undoError_: {type: Array},
+      undoSnapshot_: {type: String},
+    };
+  }
+
+  protected accessor summary_: ArcImportSummary|null = null;
+  protected accessor showUndoDialog_: boolean = false;
+  protected accessor undoing_: boolean = false;
+  /** Why the last Undo didn't finish, a paragraph each, or empty. */
+  protected accessor undoError_: string[] = [];
+  /** The snapshot date the open dialog names, fixed when it opens. */
+  protected accessor undoSnapshot_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refresh_();
+    // The tour window imports, and another Settings tab may undo; this card
+    // follows along.
+    this.addWebUiListener('rac-arc-import-changed', () => this.refresh_());
+  }
+
+  private async refresh_() {
+    // eslint-disable-next-line no-restricted-properties
+    this.summary_ = await sendWithPromise('racArcImportGetState');
+  }
+
+  /** An import stands in this profile, undoable or past its 7 days. */
+  protected isImported_(): boolean {
+    const status = this.summary_?.status;
+    return status === 'undoable' || status === 'expired';
+  }
+
+  /** Every import into this profile was undone. */
+  protected isUndone_(): boolean {
+    return this.summary_?.status === 'undone';
+  }
+
+  protected undoneText_(): string {
+    const at = this.summary_?.undoneAt;
+    return at ? loadTimeData.getStringF('racArcUndoneOn', at) :
+                loadTimeData.getString('racArcUndone');
+  }
+
+  /** Arc is on this Mac. */
+  protected isFound_(): boolean {
+    return !!this.summary_?.found;
+  }
+
+  protected importedOnText_(): string {
+    return loadTimeData.getStringF(
+        'racArcImportedOn', this.summary_?.importedAt ?? '');
+  }
+
+  protected undoUntilText_(): string {
+    const until = this.summary_?.undoUntil;
+    return this.canUndo_() && until ?
+        loadTimeData.getStringF('racArcUndoUntil', until) :
+        loadTimeData.getString('racArcUndoOver');
+  }
+
+  protected canUndo_(): boolean {
+    return this.summary_?.status === 'undoable' && !!this.summary_.undoUntil;
+  }
+
+  protected importTitle_(): string {
+    return loadTimeData.getString(
+        this.isImported_() ? 'racArcImportAgain' : 'racArcImport');
+  }
+
+  protected importDescription_(): string {
+    return loadTimeData.getString(
+        this.isImported_() ? 'racArcImportAgainDescription' :
+                             'racArcImportDescription');
+  }
+
+  protected undoBodyText_(): string {
+    return loadTimeData.getStringF('racArcUndoBody', this.undoSnapshot_);
+  }
+
+  protected onImportClick_() {
+    // eslint-disable-next-line no-restricted-properties
+    chrome.send('racOnboardingShowArcImport');
+  }
+
+  protected onUndoClick_() {
+    this.undoError_ = [];
+    this.undoSnapshot_ = this.summary_?.undoSnapshot ?? '';
+    this.showUndoDialog_ = true;
+  }
+
+  protected onUndoCancelClick_() {
+    this.shadowRoot.querySelector<CrDialogElement>('#undoDialog')?.cancel();
+  }
+
+  protected onUndoDialogClose_() {
+    this.showUndoDialog_ = false;
+  }
+
+  protected async onUndoConfirmClick_() {
+    this.undoError_ = [];
+    this.undoing_ = true;
+    let outcome: UndoOutcome = {
+      undoResult: 'failed',
+      keptSpaces: [],
+      blockedProfiles: [],
+    };
+    try {
+      // eslint-disable-next-line no-restricted-properties
+      outcome = await sendWithPromise('racArcImportUndo');
+    } finally {
+      this.undoing_ = false;
+    }
+    switch (outcome.undoResult) {
+      case 'partlyUndone':
+        this.undoError_ = await this.partlyUndoneText_(outcome);
+        break;
+      case 'busy':
+        this.undoError_ = [loadTimeData.getString('racArcUndoBusy')];
+        break;
+      case 'failed':
+        this.undoError_ = [loadTimeData.getString('racArcUndoFailed')];
+        break;
+      default:
+        // Undone, or there was nothing left to undo: either way the card
+        // now shows the truth.
+        this.shadowRoot.querySelector<CrDialogElement>('#undoDialog')
+            ?.close();
+        break;
+    }
+    await this.refresh_();
+  }
+
+  /**
+   * What stayed after a partial Undo and how to finish it: the spaces a page
+   * kept open first, then the profiles with a newer import to undo there.
+   */
+  private async partlyUndoneText_(outcome: UndoOutcome): Promise<string[]> {
+    const lang = document.documentElement.lang || undefined;
+    const list = new Intl.ListFormat(lang, {type: 'conjunction'});
+    const sentence = async (name: string, names: string[]) =>
+        loadTimeData.substituteString(
+            await PluralStringProxyImpl.getInstance().getPluralString(
+                name, names.length),
+            list.format(names));
+    const paragraphs: string[] = [];
+    if (outcome.keptSpaces.length) {
+      paragraphs.push(
+          await sentence('racArcUndoKeptSpaces', outcome.keptSpaces));
+    }
+    // A profile without a name is "another profile", named once.
+    const profiles = [...new Set(outcome.blockedProfiles.map(
+        name => name || loadTimeData.getString('racArcUndoAnotherProfile')))];
+    if (profiles.length) {
+      paragraphs.push(await sentence('racArcUndoBlockedProfiles', profiles));
+    }
+    return paragraphs.length ? paragraphs :
+                               [loadTimeData.getString('racArcUndoPartly')];
+  }
+
+  protected onOtherBrowserClick_() {
+    Router.getInstance().navigateTo(routes.IMPORT_DATA);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-spaces-import-card': SettingsSpacesImportCardElement;
+  }
+}
+
+customElements.define(
+    SettingsSpacesImportCardElement.is, SettingsSpacesImportCardElement);

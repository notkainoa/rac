+
+namespace rac::onboarding {
+
+namespace {
+
+// The name the sidebar shows an imported space: Arc's title, or rac's own
+// "Space <position>" fallback when Arc had none. Forwards to Data's
+// ImportedSpaceTitle(space, position) when arc_importer.h lands.
+std::u16string ImportedSpaceTitle(const ImportSpace& space, size_t position) {
+  const std::string name = ImportedSpaceName(space);
+  if (!name.empty()) {
+    return base::UTF8ToUTF16(name);
+  }
+  return l10n_util::GetStringFUTF16(IDS_RAC_SPACE_FALLBACK_NAME,
+                                    base::NumberToString16(position));
+}
+
+base::ListValue StopsValue(std::string_view first, std::string_view second) {
+  base::ListValue pair;
+  pair.Append(std::string(first));
+  pair.Append(std::string(second));
+  return pair;
+}
+
+// A favorite's tile letter: the custom name's first letter, else the page
+// title's, else the host's. Never an icon, so nothing is read or fetched for
+// the preview.
+std::string Letter(const ImportItem& item) {
+  std::u16string text =
+      base::UTF8ToUTF16(!item.title.empty()     ? item.title
+                        : !item.page_title.empty() ? item.page_title
+                                                   : GURL(item.url).host());
+  if (text.empty()) {
+    return "·";
+  }
+  return base::UTF16ToUTF8(base::i18n::ToUpper(text.substr(0, 1)));
+}
+
+// Tabs count wherever they sit; split views and tab groups aren't folders
+// to the user, since they arrive as plain tabs.
+void Count(const std::vector<ImportItem>& items, int& tabs, int& folders) {
+  for (const ImportItem& item : items) {
+    if (item.kind == ImportItem::Kind::kTab) {
+      ++tabs;
+      continue;
+    }
+    if (item.group == ImportItem::Group::kNone) {
+      ++folders;
+    }
+    Count(item.children, tabs, folders);
+  }
+}
+
+// GetArcImportState()'s file work: reads the import record on a MayBlock
+// sequence. Until Data's applier owns this, a corrupt or too-new record
+// reads as "never imported" — no import could have run anyway.
+ArcImportState ReadImportState(const base::FilePath& profile_dir) {
+  ArcImportState state;
+  ArcImportRecord::ReadResult read = ArcImportRecord::Read(profile_dir);
+  if (read.status != ArcImportRecord::ReadStatus::kOk) {
+    return state;
+  }
+  if (!read.record.last_import.is_null()) {
+    state.last_import = read.record.last_import;
+  }
+  if (const ArcImportRecord::Run* run =
+          read.record.UndoableRun(base::Time::Now())) {
+    state.undo_until = run->undo_until;
+    state.undo_snapshot_time = run->snapshot_time;
+  }
+  return state;
+}
+
+// A QuitWait for a build without the Arc-quit watcher: Arc can't be running
+// for sign-ins purposes yet, so `on_quit` runs from a posted task, matching
+// ArcQuitWatcher's contract for an app that isn't running.
+class PostedQuitWait : public ArcImportBackend::QuitWait {
+ public:
+  explicit PostedQuitWait(base::OnceClosure on_quit)
+      : on_quit_(std::move(on_quit)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PostedQuitWait::Run,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void Run() {
+    if (on_quit_) {
+      std::move(on_quit_).Run();
+    }
+  }
+
+  base::OnceClosure on_quit_;
+  base::WeakPtrFactory<PostedQuitWait> weak_factory_{this};
+};
+
+}  // namespace

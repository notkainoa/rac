+
+void RealArcImportBackend::StartImport(
+    ImportPlan plan,
+    ArcImportOptions options,
+    ArcImportProgressCallback progress,
+    ArcImportDoneCallback done) {
+  // HOOK(arc_importer): rac::StartArcImport(profile_, std::move(plan),
+  // options, progress, done). Until the applier lands, report "not
+  // available": a failed result with no failure cause.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](ArcImportDoneCallback done) {
+                       ArcImportResult result;
+                       result.status = ArcImportResult::Status::kFailed;
+                       std::move(done).Run(result);
+                     },
+                     std::move(done)));
+}
+
+void RealArcImportBackend::RetrySignIns(ArcImportProgressCallback progress,
+                                        ArcImportDoneCallback done) {
+  // HOOK(signins): RetryArcSignIns(). Same "not available" as StartImport.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](ArcImportDoneCallback done) {
+                       ArcImportResult result;
+                       result.status = ArcImportResult::Status::kFailed;
+                       std::move(done).Run(result);
+                     },
+                     std::move(done)));
+}
+
+void RealArcImportBackend::UndoImport(
+    base::OnceCallback<void(ArcUndoResult)> done) {
+  // HOOK(arc_importer): rac::UndoArcImport(profile_, done).
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce([](base::OnceCallback<void(ArcUndoResult)> done) {
+        std::move(done).Run(ArcUndoResult::kFailed);
+      }, std::move(done)));
+}
+
+void RealArcImportBackend::OpenProfile(const base::FilePath& profile_path,
+                                       base::OnceCallback<void(bool)> done) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    std::move(done).Run(false);
+    return;
+  }
+  manager->LoadProfileByPath(
+      profile_path, /*incognito=*/false,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> done, Profile* loaded) {
+            if (!loaded) {
+              std::move(done).Run(false);
+              return;
+            }
+            profiles::OpenBrowserWindowForProfile(
+                base::BindOnce(
+                    [](base::OnceCallback<void(bool)> done,
+                       BrowserWindowInterface* browser) {
+                      std::move(done).Run(browser != nullptr);
+                    },
+                    std::move(done)),
+                /*always_create=*/true, /*is_new_profile=*/false,
+                /*open_command_line_urls=*/false, loaded);
+          },
+          std::move(done)));
+}
+
+std::optional<DataBackups::RestoreOffer>
+RealArcImportBackend::GetRestoreOffer() {
+  DataBackups* service = backups();
+  if (!service || !service->ShouldShowRestoreOffer()) {
+    return std::nullopt;
+  }
+  return service->restore_offer();
+}
+
+void RealArcImportBackend::SetRestoreOfferChangedCallback(
+    base::RepeatingClosure changed) {
+  offer_changed_ = std::move(changed);
+}
+
+void RealArcImportBackend::AnswerRestoreOffer(
+    bool restore,
+    base::OnceCallback<void(bool restored)> done) {
+  DataBackups* service = backups();
+  if (!restore) {
+    if (service) {
+      service->ResolveRestoreOffer();
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), false));
+    return;
+  }
+  // HOOK(data_restorer): DataRestorer::RestoreOffer(profile_, done ->
+  // result == kRestored). Until it lands, restoring reports failure; the
+  // offer stays pending so it can be tried again.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), false));
+}
+
+bool RealArcImportBackend::IsArcRunning() {
+  // HOOK(appstate): rac::import::IsArcRunning(). Sign-ins aren't in this
+  // build, so Arc doesn't have to be quit for anything.
+  return false;
+}
+
+std::unique_ptr<ArcImportBackend::QuitWait>
+RealArcImportBackend::WatchArcQuit(base::OnceClosure on_quit) {
+  // HOOK(appstate): wrap rac::import::ArcQuitWatcher.
+  return std::make_unique<PostedQuitWait>(std::move(on_quit));
+}
+
+void RealArcImportBackend::OnRestoreOfferChanged() {
+  if (offer_changed_) {
+    offer_changed_.Run();
+  }
+}
+
+}  // namespace rac::onboarding

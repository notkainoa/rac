+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_ONBOARDING_ARC_IMPORT_BACKEND_H_
+#define CHROME_BROWSER_UI_RAC_ONBOARDING_ARC_IMPORT_BACKEND_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+#include "chrome/browser/rac/import/arc_import_types.h"
+#include "chrome/browser/rac/import/arc_reader.h"
+#include "chrome/browser/rac/import/import_plan.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "chrome/browser/rac/storage/data_backups.h"
+#include "chrome/browser/ui/rac/import/arc_importer.h"  // nogncheck
+
+class Profile;
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace rac::onboarding {
+
+// What the Spaces-and-import card in Settings shows beyond the import state
+// (racArcImportGetSummary): the tiles of the spaces the newest import
+// brought, as they look in the sidebar now, the two counted summary lines,
+// and whether the password hand-off row exists.
+struct ArcImportSummary {
+  // One space tile: its emoji and two stops in light and in dark mode.
+  struct Space {
+    std::string emoji;
+    std::string light1;
+    std::string light2;
+    std::string dark1;
+    std::string dark2;
+  };
+
+  bool found = false;
+  ArcImportState state;
+  std::vector<Space> imported_spaces;
+  // "5 spaces, 37 pinned tabs, and 6 favorites" and the same with the open
+  // tabs. Composed with the page stream's count strings; empty until they
+  // land, and scripted verbatim by the fixture.
+  std::string found_summary;
+  std::string imported_summary;
+  // The "Passwords from Arc" hand-off row exists (plan 04 M2 / D45).
+  bool passwords_available = false;
+};
+
+// A space tile's two gradient stops in each mode. The preview, the
+// Settings summary, and the restore offer all paint their tiles from one
+// of these.
+struct SpaceTileStops {
+  std::string light1;
+  std::string light2;
+  std::string dark1;
+  std::string dark2;
+};
+
+// The stops `theme` gives a tile: light is theme.GetStops(false); dark is
+// the pair a separate Arc dark look left in unknown_fields under
+// kDarkStop1Key/kDarkStop2Key when both are there, else
+// theme.GetStops(true) — a preset's dark pair, or the light pair again
+// for a single-look theme.
+SpaceTileStops TileStopsFor(const SpaceTheme& theme);
+
+// What the Arc import and restore screens talk to. The methods mirror the
+// importer's interface (chrome/browser/ui/rac/import/arc_importer.h) one to
+// one: detection, reading the plan, starting an import, progress, the
+// result, Undo, the async import state, the restore offer, and the Arc-quit
+// gate for sign-ins.
+//
+// The interface exists so the screens can run against a scripted import in
+// dev builds. Two implementations:
+//
+// - RealArcImportBackend forwards to Data's stack: the reader
+//   (ArcSourceExists, ReadArc), the importer (StartArcImport,
+//   UndoArcImport, GetArcImportState), the mapping, DataRestorer, and
+//   DataBackups' restore offer. The sign-ins step isn't in this build, so
+//   the page never offers it while SignInsAvailable() is false.
+// - FixtureArcImportBackend, compiled only under RAC_DEV_SWITCHES and
+//   chosen by --rac-arc-import-fixture=<path>, replays a JSON script in
+//   the shape of .scratch/mocks/fixture.js, with timed progress events so
+//   the progress state can be filmed. It is never chosen when the switch
+//   is unset.
+//
+// All callbacks run on the UI thread. Nothing here makes a network
+// request.
+class ArcImportBackend {
+ public:
+  // The wait on Arc quitting, for the sign-ins row. Dropping it cancels
+  // the wait.
+  class QuitWait {
+   public:
+    virtual ~QuitWait() = default;
+  };
+
+  virtual ~ArcImportBackend() = default;
+
+  // ArcSourceExists(): whether Arc's sidebar file is there. One stat, no
+  // parse, on a MayBlock sequence.
+  virtual void CheckSource(base::OnceCallback<void(bool exists)> done) = 0;
+
+  // ReadArc(): the plan the preview shows and StartImport() applies.
+  virtual void ReadPlan(
+      base::OnceCallback<void(base::expected<ImportPlan, ArcReadError>)>
+          done) = 0;
+
+  // The plan as the page's preview dictionary (ArcPreview in
+  // arc_import_proxy.ts): profiles in order with source keys, resolved
+  // names, `offered` flags, favorites as letter tiles, spaces with the
+  // importer's own theme stops and per-space counts, the open-tab total,
+  // and `signInsAvailable`. The fixture returns its scripted dictionary.
+  virtual base::DictValue PlanToPreviewValue(const ImportPlan& plan) = 0;
+
+  // GetArcImportState(): when this profile last received an Arc import,
+  // and until when it can be undone. Async: the record is on disk.
+  virtual void GetImportState(
+      base::OnceCallback<void(const ArcImportState&)> done) = 0;
+
+  // What the Settings card shows: ArcSourceExists() and GetArcImportState()
+  // plus the tiles of the spaces the newest run put in this profile. Async
+  // for the same reason; the tile join with SpacesService happens on the UI
+  // thread.
+  virtual void GetSummary(
+      base::OnceCallback<void(const ArcImportSummary&)> done) = 0;
+
+  // Whether this build has the sign-ins step (plan 04 M2). The sign-ins
+  // row is hidden while it doesn't.
+  virtual bool SignInsAvailable() const = 0;
+
+  // StartArcImport(). `plan` is the one ReadPlan() returned. `progress`
+  // runs on the UI thread, in bursts; `done` runs once.
+  virtual void StartImport(ImportPlan plan,
+                           ArcImportOptions options,
+                           ArcImportProgressCallback progress,
+                           ArcImportDoneCallback done) = 0;
+
+  // The sign-ins step's retry (04 M2): retries only the sign-ins, with the
+  // same callbacks as StartImport().
+  virtual void RetrySignIns(ArcImportProgressCallback progress,
+                            ArcImportDoneCallback done) = 0;
+
+  // UndoArcImport(): removes what the newest import added, in every
+  // profile it touched, and puts back the blank space it replaced. Never
+  // deletes a profile.
+  virtual void UndoImport(base::OnceCallback<void(ArcUndoResult)> done) = 0;
+
+  // Opens a browser window on a profile this import created.
+  // `profile_path` is one of the paths a result's `newProfiles` carried.
+  virtual void OpenProfile(const base::FilePath& profile_path,
+                           base::OnceCallback<void(bool)> done) = 0;
+
+  // The pending restore offer (DataBackups::restore_offer()), or null
+  // while none or while an operation hides it. Borrowed; do not store.
+  virtual const DataBackups::RestoreOffer* GetRestoreOffer() = 0;
+
+  // `changed` runs when the offer appears, is answered, or lapses, and
+  // when an operation hides or reveals it (DataBackups::Observer).
+  virtual void SetRestoreOfferChangedCallback(
+      base::RepeatingClosure changed) = 0;
+
+  // The prompt's answer. `restore` false resolves the offer without
+  // restoring; `restore` true restores it (DataRestorer, kMerge). `done`
+  // runs with whether the user's data came back.
+  virtual void AnswerRestoreOffer(
+      bool restore,
+      base::OnceCallback<void(bool restored)> done) = 0;
+
+  // Whether Arc is running: it must be quit before sign-ins (cookies) come
+  // over; its cookie store stays open while it runs.
+  virtual bool IsArcRunning() = 0;
+
+  // A wait on Arc quitting: `on_quit` runs once, when Arc is not running.
+  // If it already isn't, `on_quit` still runs, from a posted task, never
+  // from this call. Drop the returned wait to cancel it.
+  virtual std::unique_ptr<QuitWait> WatchArcQuit(
+      base::OnceClosure on_quit) = 0;
+};
+
+// The backend for `profile`: the fixture when --rac-arc-import-fixture
+// named a readable JSON file (dev builds only), else the real one.
+std::unique_ptr<ArcImportBackend> CreateArcImportBackend(Profile* profile);
+
+}  // namespace rac::onboarding
+
+#endif  // CHROME_BROWSER_UI_RAC_ONBOARDING_ARC_IMPORT_BACKEND_H_

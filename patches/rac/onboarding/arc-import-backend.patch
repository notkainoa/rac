+
+namespace rac::onboarding {
+
+namespace {
+
+base::ListValue StopsValue(std::string_view first, std::string_view second) {
+  base::ListValue pair;
+  pair.Append(std::string(first));
+  pair.Append(std::string(second));
+  return pair;
+}
+
+// A favorite's tile letter: the custom name's first letter, else the page
+// title's, else the host's. Never an icon, so nothing is read or fetched for
+// the preview.
+std::string Letter(const ImportItem& item) {
+  std::u16string text =
+      base::UTF8ToUTF16(!item.title.empty()     ? item.title
+                        : !item.page_title.empty() ? item.page_title
+                                                   : GURL(item.url).host());
+  if (text.empty()) {
+    return "·";
+  }
+  // The first character, never half of a surrogate pair (an emoji title).
+  const size_t length = U16_IS_LEAD(text[0]) && text.size() > 1 ? 2 : 1;
+  return base::UTF16ToUTF8(base::i18n::ToUpper(text.substr(0, length)));
+}
+
+// Tabs count wherever they sit; split views and tab groups aren't folders
+// to the user, since they arrive as plain tabs.
+void Count(const std::vector<ImportItem>& items, int& tabs, int& folders) {
+  for (const ImportItem& item : items) {
+    if (item.kind == ImportItem::Kind::kTab) {
+      ++tabs;
+      continue;
+    }
+    if (item.group == ImportItem::Group::kNone) {
+      ++folders;
+    }
+    Count(item.children, tabs, folders);
+  }
+}
+
+// GetSummary()'s file work: ArcSourceExists() and the rac ids of the
+// spaces the newest run added, for the card's tiles. The import state
+// itself comes from GetArcImportState(), the one reader of it. The
+// counted summary lines aren't composed here: they need the page
+// stream's count strings.
+std::pair<ArcImportSummary, base::flat_set<std::string>> ReadSummaryFiles(
+    const base::FilePath& profile_dir) {
+  ArcImportSummary summary;
+  summary.found = ArcSourceExists(GetArcSourcePaths());
+  base::flat_set<std::string> space_ids;
+  ArcImportRecord::ReadResult read = ArcImportRecord::Read(profile_dir);
+  if (read.status == ArcImportRecord::ReadStatus::kOk &&
+      !read.record.runs().empty()) {
+    for (const std::string& id :
+         read.record.SpacesOfRun(read.record.runs().back().id)) {
+      space_ids.insert(id);
+    }
+  }
+  return {std::move(summary), std::move(space_ids)};
+}
+
+// A QuitWait while the sign-ins step isn't in this build: nothing waits on
+// Arc quitting, so `on_quit` runs from a posted task, matching the wait's
+// contract for an app that isn't running.
+class PostedQuitWait : public ArcImportBackend::QuitWait {
+ public:
+  explicit PostedQuitWait(base::OnceClosure on_quit)
+      : on_quit_(std::move(on_quit)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PostedQuitWait::Run,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void Run() {
+    if (on_quit_) {
+      std::move(on_quit_).Run();
+    }
+  }
+
+  base::OnceClosure on_quit_;
+  base::WeakPtrFactory<PostedQuitWait> weak_factory_{this};
+};
+
+}  // namespace
+
+RealArcImportBackend::RealArcImportBackend(Profile* profile)
+    : profile_(profile) {
+  if (DataBackups* service = backups()) {
+    backups_observation_.Observe(service);
+  }
+}
+
+RealArcImportBackend::~RealArcImportBackend() = default;
+
+DataBackups* RealArcImportBackend::backups() {
+  return DataBackupsFactory::GetForProfile(profile_);
+}
+
+void RealArcImportBackend::CheckSource(
+    base::OnceCallback<void(bool exists)> done) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ArcSourceExists, GetArcSourcePaths()),
+      std::move(done));
+}
+
+void RealArcImportBackend::ReadPlan(
+    base::OnceCallback<void(base::expected<ImportPlan, ArcReadError>)> done) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadArc, GetArcSourcePaths(), ArcReadLimits()),
+      std::move(done));
+}
+
+size_t RealArcImportBackend::SpacePositionBase(
+    const ImportProfile& source) const {
+  if (!source.is_default) {
+    // A checked non-default profile becomes a new rac profile, where the
+    // import replaces the blank space: positions start at 1.
+    return 0;
+  }
+  SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile_);
+  if (!spaces) {
+    return 0;
+  }
+  const std::vector<Space>& existing = spaces->spaces();
+  // The import replaces the one unnamed space of a fresh profile, so the
+  // first imported space is still "Space 1".
+  if (existing.size() == 1 && existing.front().name.empty() &&
+      existing.front().icon.empty()) {
+    return 0;
+  }
+  return existing.size();
+}
+
+base::DictValue RealArcImportBackend::PlanToPreviewValue(
+    const ImportPlan& plan) {
+  base::ListValue profiles;
+  for (size_t i = 0; i < plan.profiles.size(); ++i) {
+    const ImportProfile& source = plan.profiles[i];
+    base::DictValue profile;
+    profile.Set("key", source.source_key);
+    // The label's fallback is data, not a settled string: the page writes
+    // the "Your Arc profile" / "Arc profile N" copy.
+    const ArcProfileLabel label = ArcProfileLabelFor(plan, i);
+    profile.Set("name", label.name);
+    static constexpr const char* kFallbacks[] = {"none", "default",
+                                                 "numbered"};
+    profile.Set("nameFallback", kFallbacks[std::to_underlying(label.fallback)]);
+    profile.Set("nameNumber", label.number);
+    profile.Set("isDefault", source.is_default);
+    // Another Arc profile becomes its own rac profile, which only the
+    // sign-ins step makes; it isn't in this build, so those stay in Arc.
+    profile.Set("offered", source.is_default || SignInsAvailable());
+
+    base::ListValue favorites;
+    for (const ImportItem& item : source.favorites) {
+      base::DictValue favorite;
+      favorite.Set("letter", Letter(item));
+      favorite.Set("title",
+                   !item.title.empty() ? item.title : item.page_title);
+      favorites.Append(std::move(favorite));
+    }
+    profile.Set("favorites", std::move(favorites));
+
+    base::ListValue spaces;
+    const size_t base_position = SpacePositionBase(source);
+    for (size_t j = 0; j < source.spaces.size(); ++j) {
+      const ImportSpace& source_space = source.spaces[j];
+      base::DictValue space;
+      space.Set("id", source_space.source_id);
+      space.Set("title", rac::ImportedSpaceTitle(source_space,
+                                                 base_position + j + 1));
+      space.Set("emoji", source_space.emoji);
+      // The importer's own mapping, so the tile is the space's real color.
+      const SpaceTileStops stops =
+          TileStopsFor(ToSpaceTheme(source_space.theme));
+      space.Set("light", StopsValue(stops.light1, stops.light2));
+      space.Set("dark", StopsValue(stops.dark1, stops.dark2));
+      int pinned = 0;
+      int folders = 0;
+      int open = 0;
+      int ignored = 0;
+      Count(source_space.pinned, pinned, folders);
+      Count(source_space.open_tabs, open, ignored);
+      space.Set("pinned", pinned);
+      space.Set("folders", folders);
+      space.Set("openTabs", open);
+      spaces.Append(std::move(space));
+    }
+    profile.Set("spaces", std::move(spaces));
+    profiles.Append(std::move(profile));
+  }
+  base::DictValue preview;
+  preview.Set("profiles", std::move(profiles));
+  preview.Set("openTabs", plan.report.open_tabs);
+  preview.Set("signInsAvailable", SignInsAvailable());
+  return preview;
+}
+
+void RealArcImportBackend::GetImportState(
+    base::OnceCallback<void(const ArcImportState&)> done) {
+  // The importer's callback carries the state by value; adapt it to the
+  // backend's const ref.
+  rac::GetArcImportState(
+      profile_,
+      base::BindOnce(
+          [](base::OnceCallback<void(const ArcImportState&)> done,
+             ArcImportState state) { std::move(done).Run(state); },
+          std::move(done)));
+}
+
+void RealArcImportBackend::GetSummary(
+    base::OnceCallback<void(const ArcImportSummary&)> done) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadSummaryFiles, profile_->GetPath()),
+      base::BindOnce(&RealArcImportBackend::OnSummarySpaceIds,
+                     weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void RealArcImportBackend::OnSummarySpaceIds(
+    base::OnceCallback<void(const ArcImportSummary&)> done,
+    std::pair<ArcImportSummary, base::flat_set<std::string>> files) {
+  GetImportState(base::BindOnce(
+      &RealArcImportBackend::OnSummaryFiles, weak_factory_.GetWeakPtr(),
+      std::move(done), std::move(files.first), std::move(files.second)));
+}
+
+void RealArcImportBackend::OnSummaryFiles(
+    base::OnceCallback<void(const ArcImportSummary&)> done,
+    ArcImportSummary summary,
+    base::flat_set<std::string> space_ids,
+    const ArcImportState& state) {
+  summary.state = state;
+  if (SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile_)) {
+    for (const Space& space : spaces->spaces()) {
+      if (!space_ids.contains(space.id.AsLowercaseString())) {
+        continue;
+      }
+      const SpaceTileStops stops = TileStopsFor(space.theme);
+      ArcImportSummary::Space tile;
+      tile.emoji = space.icon;
+      tile.light1 = stops.light1;
+      tile.light2 = stops.light2;
+      tile.dark1 = stops.dark1;
+      tile.dark2 = stops.dark2;
+      summary.imported_spaces.push_back(std::move(tile));
+    }
+  }
+  // The password hand-off isn't in this build, so `passwords_available`
+  // stays false; the two counted summary lines wait on the strings stream.
+  std::move(done).Run(summary);
+}
+
+bool RealArcImportBackend::SignInsAvailable() const {
+  // The sign-ins step isn't in this build; the page never offers it while
+  // this is false.
+  return false;
+}
+
+void RealArcImportBackend::StartImport(
+    ImportPlan plan,
+    ArcImportOptions options,
+    ArcImportProgressCallback progress,
+    ArcImportDoneCallback done) {
+  rac::StartArcImport(profile_, std::move(plan), std::move(options),
+                      std::move(progress), std::move(done));
+}
+
+void RealArcImportBackend::RetrySignIns(ArcImportProgressCallback progress,
+                                        ArcImportDoneCallback done) {
+  // Unreachable while the sign-ins step isn't in this build: the page
+  // never offers it while SignInsAvailable() is false. Still answers like
+  // a failed import, asynchronously.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](ArcImportDoneCallback done) {
+                       ArcImportResult result;
+                       result.status = ArcImportResult::Status::kFailed;
+                       std::move(done).Run(result);
+                     },
+                     std::move(done)));
+}
+
+void RealArcImportBackend::UndoImport(
+    base::OnceCallback<void(ArcUndoResult)> done) {
+  rac::UndoArcImport(profile_, std::move(done));
+}
+
+void RealArcImportBackend::OpenProfile(const base::FilePath& profile_path,
+                                       base::OnceCallback<void(bool)> done) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    std::move(done).Run(false);
+    return;
+  }
+  manager->LoadProfileByPath(
+      profile_path, /*incognito=*/false,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> done, Profile* loaded) {
+            if (!loaded) {
+              std::move(done).Run(false);
+              return;
+            }
+            profiles::OpenBrowserWindowForProfile(
+                base::BindOnce(
+                    [](base::OnceCallback<void(bool)> done,
+                       BrowserWindowInterface* browser) {
+                      std::move(done).Run(browser != nullptr);
+                    },
+                    std::move(done)),
+                /*always_create=*/true, /*is_new_profile=*/false,
+                /*open_command_line_urls=*/false, loaded);
+          },
+          std::move(done)));
+}
+
+const DataBackups::RestoreOffer* RealArcImportBackend::GetRestoreOffer() {
+  DataBackups* service = backups();
+  if (!service || !service->ShouldShowRestoreOffer()) {
+    return nullptr;
+  }
+  const std::optional<DataBackups::RestoreOffer>& offer =
+      service->restore_offer();
+  return offer ? &*offer : nullptr;
+}
+
+void RealArcImportBackend::SetRestoreOfferChangedCallback(
+    base::RepeatingClosure changed) {
+  offer_changed_ = std::move(changed);
+}
+
+void RealArcImportBackend::AnswerRestoreOffer(
+    bool restore,
+    base::OnceCallback<void(bool restored)> done) {
+  DataBackups* service = backups();
+  if (!restore) {
+    // Only an offer the page could show: not one that lapsed, or one held
+    // while another restore, import, or Undo runs.
+    if (service && service->ShouldShowRestoreOffer()) {
+      service->ResolveRestoreOffer();
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), false));
+    return;
+  }
+  // DataRestorer resolves the offer itself on kRestored; on any other
+  // result the offer stays pending so it can be tried again.
+  DataRestorer::RestoreOffer(
+      profile_,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> done,
+             DataRestorer::Result result) {
+            std::move(done).Run(result == DataRestorer::Result::kRestored);
+          },
+          std::move(done)));
+}
+
+bool RealArcImportBackend::IsArcRunning() {
+  // Arc only has to be quit for the sign-ins step, which isn't in this
+  // build.
+  return false;
+}
+
+std::unique_ptr<ArcImportBackend::QuitWait>
+RealArcImportBackend::WatchArcQuit(base::OnceClosure on_quit) {
+  // Nothing waits on Arc quitting while the sign-ins step isn't in this
+  // build; `on_quit` still runs from a posted task.
+  return std::make_unique<PostedQuitWait>(std::move(on_quit));
+}
+
+void RealArcImportBackend::OnRestoreOfferChanged() {
+  if (offer_changed_) {
+    offer_changed_.Run();
+  }
+}
+
+}  // namespace rac::onboarding

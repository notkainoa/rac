+#ifndef CHROME_BROWSER_UI_RAC_ONBOARDING_REAL_ARC_IMPORT_BACKEND_H_
+#define CHROME_BROWSER_UI_RAC_ONBOARDING_REAL_ARC_IMPORT_BACKEND_H_
+
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/rac/storage/data_backups.h"
+#include "chrome/browser/ui/rac/onboarding/arc_import_backend.h"
+
+namespace rac::onboarding {
+
+// The real Arc import backend: the reader, the import record, the mapping,
+// and DataBackups, which are in the tree today; the applier, DataRestorer,
+// and the Arc-quit watcher once their patches land. See arc_import_backend.h
+// for what reports "not available" until then.
+class RealArcImportBackend : public ArcImportBackend,
+                             public DataBackups::Observer {
+ public:
+  explicit RealArcImportBackend(Profile* profile);
+  RealArcImportBackend(const RealArcImportBackend&) = delete;
+  RealArcImportBackend& operator=(const RealArcImportBackend&) = delete;
+  ~RealArcImportBackend() override;
+
+  // ArcImportBackend:
+  void CheckSource(base::OnceCallback<void(bool exists)> done) override;
+  void ReadPlan(
+      base::OnceCallback<void(base::expected<ImportPlan, ArcReadError>)> done)
+      override;
+  base::DictValue PlanToPreviewValue(const ImportPlan& plan) override;
+  void GetImportState(
+      base::OnceCallback<void(const ArcImportState&)> done) override;
+  bool SignInsAvailable() const override;
+  void StartImport(ImportPlan plan,
+                   ArcImportOptions options,
+                   ArcImportProgressCallback progress,
+                   ArcImportDoneCallback done) override;
+  void RetrySignIns(ArcImportProgressCallback progress,
+                    ArcImportDoneCallback done) override;
+  void UndoImport(base::OnceCallback<void(ArcUndoResult)> done) override;
+  void OpenProfile(const base::FilePath& profile_path,
+                   base::OnceCallback<void(bool)> done) override;
+  std::optional<DataBackups::RestoreOffer> GetRestoreOffer() override;
+  void SetRestoreOfferChangedCallback(
+      base::RepeatingClosure changed) override;
+  void AnswerRestoreOffer(bool restore,
+                          base::OnceCallback<void(bool restored)> done)
+      override;
+  bool IsArcRunning() override;
+  std::unique_ptr<QuitWait> WatchArcQuit(base::OnceClosure on_quit) override;
+
+  // DataBackups::Observer:
+  void OnRestoreOfferChanged() override;
+
+ private:
+  DataBackups* backups();
+  // The profile's place in the space switcher where `source`'s first space
+  // lands: after the existing spaces, or at the top when the only space is
+  // the blank one the import replaces.
+  size_t SpacePositionBase(const ImportProfile& source) const;
+
+  const raw_ptr<Profile> profile_;
+  base::RepeatingClosure offer_changed_;
+  base::ScopedObservation<DataBackups, DataBackups::Observer>
+      backups_observation_{this};
+  base::WeakPtrFactory<RealArcImportBackend> weak_factory_{this};
+};
+
+}  // namespace rac::onboarding
+
+#endif  // CHROME_BROWSER_UI_RAC_ONBOARDING_REAL_ARC_IMPORT_BACKEND_H_

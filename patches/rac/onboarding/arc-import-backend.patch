+namespace rac::onboarding {
+
+// The page side of the Arc import and the restore prompt
+// (arc_import_proxy.ts). Every state-changing or file-touching call goes to
+// the page's ArcImportBackend: the real one, or the scripted fixture under
+// --rac-arc-import-fixture in dev builds. Added to chrome://setup and to
+// Settings, next to OnboardingHandler. It loads no AI code and makes no
+// network request: favorites are sent as letters, never as icons.
+class ArcImportHandler : public content::WebUIMessageHandler {
+ public:
+  explicit ArcImportHandler(Profile* profile);
+  ArcImportHandler(const ArcImportHandler&) = delete;
+  ArcImportHandler& operator=(const ArcImportHandler&) = delete;
+  ~ArcImportHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void HandleGetState(const base::ListValue& args);
+  void HandleGetSummary(const base::ListValue& args);
+  void HandleShowPasswordSteps(const base::ListValue& args);
+  void HandleRead(const base::ListValue& args);
+  void HandleStart(const base::ListValue& args);
+  void HandleUndo(const base::ListValue& args);
+  void HandleGetRestoreOffer(const base::ListValue& args);
+  void HandleAnswerRestore(const base::ListValue& args);
+  void HandleShowArcImport(const base::ListValue& args);
+  void HandleClose(const base::ListValue& args);
+
+  void OnSourceChecked(base::Value callback_id, bool found);
+  void OnRead(base::Value callback_id,
+              base::expected<ImportPlan, ArcReadError> plan);
+  void OnProgress(const ArcImportProgress& progress);
+  void OnFinished(base::Value callback_id, const ArcImportResult& result);
+  void OnRestoreOfferChanged();
+  void OnChangedElsewhere();
+
+  // The result and the restore offer, as the page's dictionaries.
+  base::DictValue ResultToValue(const ArcImportResult& result) const;
+  base::Value RestoreOfferToValue() const;
+  // The preview's profile dict for `source_key`, or null.
+  const base::DictValue* PreviewProfile(std::string_view source_key) const;
+
+  const raw_ptr<Profile> profile_;
+  const std::unique_ptr<ArcImportBackend> backend_;
+  // The plan and the preview dictionary the page is showing, so StartImport
+  // applies exactly that and the result can name what came over.
+  std::optional<ImportPlan> plan_;
+  base::DictValue preview_;
+  bool importing_ = false;
+
+  // The subscription to "an import or Undo finished elsewhere for this
+  // profile", so every page that shows the card stays current.
+  base::CallbackListSubscription changed_subscription_;
+
+  base::WeakPtrFactory<ArcImportHandler> weak_factory_{this};
+};
+
+}  // namespace rac::onboarding
+
+#endif  // CHROME_BROWSER_UI_RAC_ONBOARDING_ARC_IMPORT_HANDLER_H_

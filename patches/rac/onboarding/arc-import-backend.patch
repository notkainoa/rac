@@ -0,0 +1,86 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/onboarding/arc_import_backend.h"
+
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "chrome/browser/rac/dev/buildflags.h"
+#include "chrome/browser/ui/rac/onboarding/real_arc_import_backend.h"
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+#include "base/command_line.h"
+#include "chrome/browser/ui/rac/onboarding/fixture_arc_import_backend.h"
+#endif
+
+namespace rac::onboarding {
+
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+namespace {
+
+// Not in release builds, so a release can only ever read real Arc data.
+constexpr char kArcImportFixtureSwitch[] = "rac-arc-import-fixture";
+
+// The scripted backend, or null if the file can't be read or isn't a JSON
+// object. Fields (all optional):
+//
+//   state: {found, signInsAvailable, importedDaysAgo, undoUntilDays,
+//           undoSnapshotHoursAgo}
+//   arcRunning, arcQuitAfterMs — the sign-ins quit gate, scripted
+//   readError — racArcImportRead fails
+//   preview — the page's preview dictionary, verbatim
+//   report — ImportReport counts for the result's skip and damage lines
+//   progress — a list of {step, done, total, spaceId, spaceTitle}; without
+//              it, events are made from the preview's spaces
+//   progressIntervalMs — between events, 150 default
+//   result — ArcImportResult's fields: status, the ArcImportCounts names,
+//            history, handoffsSaved, pinnedExtensions, undoUntilDays,
+//            failure, and a profiles list of {key, status, newProfile,
+//            path, history, undoUntilDays, pinnedExtensions, <counts>}
+//   undoResult — 'undone'|'partlyUndone'|'busy'|'expired'|'nothingToUndo'|
+//                'failed'
+//   restoreOffer — {createdHoursAgo, counts, spaces:[{name, emoji, light,
+//            dark}]}
+//
+std::unique_ptr<ArcImportBackend> FixtureFromSwitch() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(kArcImportFixtureSwitch)) {
+    return nullptr;
+  }
+  const base::FilePath path =
+      command_line.GetSwitchValuePath(kArcImportFixtureSwitch);
+  std::string json;
+  if (!path.IsAbsolute() || !base::ReadFileToString(path, &json)) {
+    LOG(ERROR) << "--" << kArcImportFixtureSwitch
+               << " needs an absolute path to a readable file";
+    return nullptr;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(json);
+  if (!parsed || !parsed->is_dict()) {
+    LOG(ERROR) << "--" << kArcImportFixtureSwitch
+               << ": the fixture isn't a JSON object";
+    return nullptr;
+  }
+  return std::make_unique<FixtureArcImportBackend>(
+      std::move(*parsed).TakeDict());
+}
+
+}  // namespace
+#endif
+
+std::unique_ptr<ArcImportBackend> CreateArcImportBackend(Profile* profile) {
+#if BUILDFLAG(RAC_DEV_SWITCHES)
+  if (std::unique_ptr<ArcImportBackend> fixture = FixtureFromSwitch()) {
+    return fixture;
+  }
+#endif
+  return std::make_unique<RealArcImportBackend>(profile);
+}
+
+}  // namespace rac::onboarding

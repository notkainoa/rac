+namespace rac::onboarding {
+
+// Replays a scripted Arc import for the screens' development, from the JSON
+// file --rac-arc-import-fixture points at (in the shape of
+// .scratch/mocks/fixture.js; see arc_import_backend.cc for the fields).
+// Progress events are sent on a timer, so the progress state can be filmed.
+// Compiled out of release builds with the rest of the dev switches.
+class FixtureArcImportBackend : public ArcImportBackend {
+ public:
+  explicit FixtureArcImportBackend(base::DictValue script);
+  FixtureArcImportBackend(const FixtureArcImportBackend&) = delete;
+  FixtureArcImportBackend& operator=(const FixtureArcImportBackend&) = delete;
+  ~FixtureArcImportBackend() override;
+
+  // ArcImportBackend:
+  void CheckSource(base::OnceCallback<void(bool exists)> done) override;
+  void ReadPlan(
+      base::OnceCallback<void(base::expected<ImportPlan, ArcReadError>)> done)
+      override;
+  base::DictValue PlanToPreviewValue(const ImportPlan& plan) override;
+  void GetImportState(
+      base::OnceCallback<void(const ArcImportState&)> done) override;
+  bool SignInsAvailable() const override;
+  void StartImport(ImportPlan plan,
+                   ArcImportOptions options,
+                   ArcImportProgressCallback progress,
+                   ArcImportDoneCallback done) override;
+  void RetrySignIns(ArcImportProgressCallback progress,
+                    ArcImportDoneCallback done) override;
+  void UndoImport(base::OnceCallback<void(ArcUndoResult)> done) override;
+  void OpenProfile(const base::FilePath& profile_path,
+                   base::OnceCallback<void(bool)> done) override;
+  std::optional<DataBackups::RestoreOffer> GetRestoreOffer() override;
+  void SetRestoreOfferChangedCallback(
+      base::RepeatingClosure changed) override;
+  void AnswerRestoreOffer(bool restore,
+                          base::OnceCallback<void(bool restored)> done)
+      override;
+  bool IsArcRunning() override;
+  std::unique_ptr<QuitWait> WatchArcQuit(base::OnceClosure on_quit) override;
+
+  // A scripted quit leaves Arc not running for later IsArcRunning() calls.
+  void SetArcNotRunning() { arc_running_ = false; }
+
+ private:
+  // The events StartImport() will send: the script's `progress` list if it
+  // has one, else a snapshot step, one kSpaces per space of every profile
+  // `options` leaves checked, and a history step when `options.history`.
+  std::vector<ArcImportProgress> ProgressEvents(
+      const ArcImportOptions& options) const;
+  void SendNextProgress();
+  void FireOfferChanged();
+
+  const base::DictValue script_;
+  const base::DictValue preview_;
+  // The synthesized plan ReadPlan() returns: profile keys, names, and the
+  // import report, so the handler's result fields work like the real path.
+  ImportPlan plan_;
+
+  bool found_;
+  bool sign_ins_available_;
+  bool read_error_;
+  bool arc_running_;
+  bool arc_quit_after_set_;
+  base::TimeDelta read_delay_;
+  base::TimeDelta progress_interval_;
+  base::TimeDelta arc_quit_after_;
+  ArcImportState state_;
+  std::optional<DataBackups::RestoreOffer> offer_;
+  ArcImportResult result_;
+  ArcUndoResult undo_result_;
+
+  // The in-flight import or retry.
+  std::vector<ArcImportProgress> pending_;
+  size_t next_event_ = 0;
+  ArcImportProgressCallback progress_;
+  ArcImportDoneCallback done_;
+  base::OneShotTimer timer_;
+
+  base::RepeatingClosure offer_changed_;
+  bool offer_announced_ = false;
+  base::WeakPtrFactory<FixtureArcImportBackend> weak_factory_{this};
+};
+
+}  // namespace rac::onboarding
+
+#endif  // CHROME_BROWSER_UI_RAC_ONBOARDING_FIXTURE_ARC_IMPORT_BACKEND_H_

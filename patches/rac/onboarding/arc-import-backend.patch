@@ -0,0 +1,532 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/onboarding/arc_import_handler.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "base/i18n/time_formatting.h"
+#include "base/i18n/unicodestring.h"
+#include "base/no_destructor.h"
+#include "base/notreached.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/types/expected.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/rac/onboarding/arc_import_backend.h"
+#include "chrome/browser/ui/rac/onboarding/onboarding_window.h"
+#include "content/public/browser/web_ui.h"
+#include "third_party/icu/source/common/unicode/unistr.h"
+#include "third_party/icu/source/i18n/unicode/datefmt.h"
+
+namespace rac::onboarding {
+
+namespace {
+
+// A date in the user's locale, from an ICU skeleton: "MMMMd" is
+// "October 27", "EEEEMMMMd" is "Tuesday, November 3", and "EEEEMMMMdjmm" is
+// "Monday, October 26 at 9:14 PM". The shapes the import and restore
+// screens declare are the skeletons the drafts named.
+std::string FormatArcDate(base::Time time, const char* skeleton) {
+  UErrorCode status = U_ZERO_ERROR;
+  std::unique_ptr<icu::DateFormat> format(
+      icu::DateFormat::createInstanceForSkeleton(
+          icu::UnicodeString(skeleton, -1, US_INV), status));
+  if (U_FAILURE(status) || !format) {
+    return base::UTF16ToUTF8(base::TimeFormatFriendlyDate(time));
+  }
+  icu::UnicodeString formatted;
+  format->format(time.InMillisecondsFSinceUnixEpoch(), formatted);
+  return base::UTF16ToUTF8(base::i18n::UnicodeStringToString16(formatted));
+}
+
+// `time` as a skeleton-formatted localized string, or JSON null.
+base::Value ArcDateOrNull(const std::optional<base::Time>& time,
+                          const char* skeleton) {
+  return time ? base::Value(FormatArcDate(*time, skeleton)) : base::Value();
+}
+
+base::ListValue StopsValue(std::string_view first, std::string_view second) {
+  base::ListValue pair;
+  pair.Append(std::string(first));
+  pair.Append(std::string(second));
+  return pair;
+}
+
+// A SpaceTile: title, emoji, and the space's two stops in each mode.
+base::DictValue TileValue(std::string_view title,
+                          std::string_view emoji,
+                          std::string_view light1,
+                          std::string_view light2,
+                          std::string_view dark1,
+                          std::string_view dark2) {
+  base::DictValue tile;
+  tile.Set("title", title);
+  tile.Set("emoji", emoji);
+  tile.Set("light", StopsValue(light1, light2));
+  tile.Set("dark", StopsValue(dark1, dark2));
+  return tile;
+}
+
+// Every page that shows the import, so the tour, the standalone Arc step,
+// and Settings' card follow each other: an import in the tour updates the
+// Settings card, an Undo in Settings updates the tour, and so on.
+base::RepeatingCallbackList<void(Profile*)>& ChangedCallbacks() {
+  static base::NoDestructor<base::RepeatingCallbackList<void(Profile*)>> list;
+  return *list;
+}
+
+// The page's names for Data's enums. Switches rather than tables, so a
+// value Data adds fails the build here instead of reading past a table.
+const char* StepName(ArcImportProgress::Step step) {
+  switch (step) {
+    case ArcImportProgress::Step::kSnapshot:
+      return "snapshot";
+    case ArcImportProgress::Step::kSpaces:
+      return "spaces";
+    case ArcImportProgress::Step::kHistory:
+      return "history";
+    case ArcImportProgress::Step::kSignIns:
+      return "signIns";
+    case ArcImportProgress::Step::kWaitingForMac:
+      return "waitingForMac";
+  }
+  NOTREACHED();
+}
+
+const char* StatusName(ArcImportResult::Status status) {
+  switch (status) {
+    case ArcImportResult::Status::kDone:
+      return "done";
+    case ArcImportResult::Status::kNothingNew:
+      return "nothingNew";
+    case ArcImportResult::Status::kFailed:
+      return "failed";
+  }
+  NOTREACHED();
+}
+
+const char* UndoResultName(ArcUndoResult result) {
+  switch (result) {
+    case ArcUndoResult::kUndone:
+      return "undone";
+    case ArcUndoResult::kPartlyUndone:
+      return "partlyUndone";
+    case ArcUndoResult::kBusy:
+      return "busy";
+    case ArcUndoResult::kExpired:
+      return "expired";
+    case ArcUndoResult::kNothingToUndo:
+      return "nothingToUndo";
+    case ArcUndoResult::kFailed:
+      return "failed";
+  }
+  NOTREACHED();
+}
+
+}  // namespace
+
+ArcImportHandler::ArcImportHandler(Profile* profile)
+    : profile_(profile), backend_(CreateArcImportBackend(profile)) {}
+
+ArcImportHandler::~ArcImportHandler() = default;
+
+void ArcImportHandler::RegisterMessages() {
+  const auto add = [this](const char* name, auto method) {
+    web_ui()->RegisterMessageCallback(
+        name, base::BindRepeating(method, base::Unretained(this)));
+  };
+  add("racArcImportGetState", &ArcImportHandler::HandleGetState);
+  add("racArcImportGetSummary", &ArcImportHandler::HandleGetSummary);
+  add("racArcImportShowPasswordSteps",
+      &ArcImportHandler::HandleShowPasswordSteps);
+  add("racArcImportRead", &ArcImportHandler::HandleRead);
+  add("racArcImportStart", &ArcImportHandler::HandleStart);
+  add("racArcImportUndo", &ArcImportHandler::HandleUndo);
+  add("racRestoreGetOffer", &ArcImportHandler::HandleGetRestoreOffer);
+  add("racRestoreAnswer", &ArcImportHandler::HandleAnswerRestore);
+  add("racOnboardingShowArcImport",
+      &ArcImportHandler::HandleShowArcImport);
+  add("racOnboardingClose", &ArcImportHandler::HandleClose);
+}
+
+void ArcImportHandler::OnJavascriptAllowed() {
+  backend_->SetRestoreOfferChangedCallback(
+      base::BindRepeating(&ArcImportHandler::OnRestoreOfferChanged,
+                          weak_factory_.GetWeakPtr()));
+  changed_subscription_ = ChangedCallbacks().Add(base::BindRepeating(
+      [](base::WeakPtr<ArcImportHandler> self, Profile* profile) {
+        if (self && profile == self->profile_) {
+          self->OnChangedElsewhere();
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+}
+
+void ArcImportHandler::OnJavascriptDisallowed() {
+  backend_->SetRestoreOfferChangedCallback(base::RepeatingClosure());
+  changed_subscription_ = {};
+  weak_factory_.InvalidateWeakPtrs();
+  // A reload mid-import drops the finish callback; the backend still refuses
+  // a second import while the first runs.
+  importing_ = false;
+}
+
+void ArcImportHandler::OnChangedElsewhere() {
+  FireWebUIListener("rac-arc-import-changed");
+}
+
+void ArcImportHandler::HandleGetState(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  backend_->CheckSource(
+      base::BindOnce(&ArcImportHandler::OnSourceChecked,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::OnSourceChecked(base::Value callback_id, bool found) {
+  backend_->GetImportState(base::BindOnce(
+      [](base::WeakPtr<ArcImportHandler> self, base::Value callback_id,
+         bool found, const ArcImportState& state) {
+        if (!self) {
+          return;
+        }
+        base::DictValue value;
+        value.Set("found", found);
+        value.Set("importedAt", ArcDateOrNull(state.last_import, "MMMMd"));
+        value.Set("undoUntil", ArcDateOrNull(state.undo_until, "EEEEMMMMd"));
+        // For the Undo prompt's "Your sidebar goes back to how it was on…".
+        value.Set("undoSnapshot",
+                  ArcDateOrNull(state.undo_snapshot_time, "MMMMd"));
+        value.Set("signInsAvailable", self->backend_->SignInsAvailable());
+        self->ResolveJavascriptCallback(callback_id, std::move(value));
+      },
+      weak_factory_.GetWeakPtr(), std::move(callback_id), found));
+}
+
+void ArcImportHandler::HandleGetSummary(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  backend_->GetSummary(base::BindOnce(
+      [](base::WeakPtr<ArcImportHandler> self, base::Value callback_id,
+         const ArcImportSummary& summary) {
+        if (!self) {
+          return;
+        }
+        base::DictValue value;
+        value.Set("found", summary.found);
+        value.Set("importedAt",
+                  ArcDateOrNull(summary.state.last_import, "MMMMd"));
+        value.Set("undoUntil",
+                  ArcDateOrNull(summary.state.undo_until, "EEEEMMMMd"));
+        value.Set("foundSummary", summary.found_summary);
+        value.Set("importedSummary", summary.imported_summary);
+        base::ListValue tiles;
+        for (const ArcImportSummary::Space& space :
+             summary.imported_spaces) {
+          base::DictValue tile;
+          tile.Set("emoji", space.emoji);
+          tile.Set("light", StopsValue(space.light1, space.light2));
+          tile.Set("dark", StopsValue(space.dark1, space.dark2));
+          tiles.Append(std::move(tile));
+        }
+        value.Set("spaces", std::move(tiles));
+        value.Set("passwordsAvailable", summary.passwords_available);
+        self->ResolveJavascriptCallback(callback_id, std::move(value));
+      },
+      weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::HandleShowPasswordSteps(const base::ListValue& args) {
+  // The password hand-off isn't in this build. The Settings card only
+  // shows the "Move…" row when GetSummary says it's available, so this is
+  // never sent.
+}
+
+void ArcImportHandler::HandleRead(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  // The running import's result is read against the plan it started from.
+  if (importing_) {
+    ResolveJavascriptCallback(args[0], base::DictValue().Set("error", true));
+    return;
+  }
+  backend_->ReadPlan(base::BindOnce(&ArcImportHandler::OnRead,
+                                    weak_factory_.GetWeakPtr(),
+                                    args[0].Clone()));
+}
+
+void ArcImportHandler::OnRead(
+    base::Value callback_id,
+    base::expected<ImportPlan, ArcReadError> plan) {
+  base::DictValue reply;
+  if (!plan.has_value()) {
+    plan_.reset();
+    preview_.clear();
+    reply.Set("error", true);
+  } else {
+    preview_ = backend_->PlanToPreviewValue(*plan);
+    reply.Set("preview", preview_.Clone());
+    plan_ = std::move(*plan);
+  }
+  ResolveJavascriptCallback(callback_id, std::move(reply));
+}
+
+void ArcImportHandler::HandleStart(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  const base::DictValue* dict = args[1].GetIfDict();
+  if (!plan_ || importing_ || !dict) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  ArcImportOptions options;
+  if (const base::ListValue* skipped = dict->FindList("skippedProfileKeys")) {
+    for (const base::Value& key : *skipped) {
+      if (key.is_string()) {
+        options.skipped_profile_keys.insert(key.GetString());
+      }
+    }
+  }
+  // Never import a profile the preview didn't offer: an Arc profile other
+  // than the default one needs the sign-ins step to become a rac profile.
+  for (const ImportProfile& profile : plan_->profiles) {
+    if (!profile.is_default && !backend_->SignInsAvailable()) {
+      options.skipped_profile_keys.insert(profile.source_key);
+    }
+  }
+  options.open_tabs = dict->FindBool("openTabs").value_or(true);
+  options.history = dict->FindBool("history").value_or(true);
+  options.sign_ins = backend_->SignInsAvailable() &&
+                     dict->FindBool("signIns").value_or(false);
+
+  importing_ = true;
+  backend_->StartImport(
+      *plan_, options,
+      base::BindRepeating(&ArcImportHandler::OnProgress,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&ArcImportHandler::OnFinished,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::OnProgress(const ArcImportProgress& progress) {
+  base::DictValue value;
+  value.Set("step", StepName(progress.step));
+  value.Set("done", progress.done);
+  value.Set("total", progress.total);
+  value.Set("spaceId", progress.space_id);
+  value.Set("spaceTitle", progress.space_title);
+  FireWebUIListener("rac-arc-import-progress", value);
+}
+
+void ArcImportHandler::OnFinished(base::Value callback_id,
+                                  const ArcImportResult& result) {
+  importing_ = false;
+  ResolveJavascriptCallback(callback_id, ResultToValue(result));
+  if (result.status == ArcImportResult::Status::kDone) {
+    ChangedCallbacks().Notify(profile_);
+  }
+}
+
+const base::DictValue* ArcImportHandler::PreviewProfile(
+    std::string_view source_key) const {
+  if (const base::ListValue* profiles = preview_.FindList("profiles")) {
+    for (const base::Value& entry : *profiles) {
+      const base::DictValue* profile = entry.GetIfDict();
+      const std::string* key = profile ? profile->FindString("key") : nullptr;
+      if (key && *key == source_key) {
+        return profile;
+      }
+    }
+  }
+  return nullptr;
+}
+
+base::DictValue ArcImportHandler::ResultToValue(
+    const ArcImportResult& result) const {
+  base::DictValue value;
+  value.Set("status", StatusName(result.status));
+  // The only failure cause the page names: another import, Undo, or
+  // restore was running.
+  value.Set("busy", result.failure == ArcImportFailure::kBusy);
+
+  const ArcImportCounts& counts = result.counts;
+  value.Set("spaces", counts.spaces);
+  value.Set("pinnedTabs", counts.pinned_tabs);
+  value.Set("favorites", counts.favorites);
+  value.Set("openTabs", counts.open_tabs);
+  value.Set("folders", counts.folders);
+  value.Set("nestedFolders", counts.nested_folders);
+  value.Set("firstFlattenedName", counts.first_flattened_name);
+  value.Set("splitViews", counts.split_views);
+  value.Set("tabGroups", counts.tab_groups);
+
+  // What the reader left out or couldn't read; the importer's rejected
+  // URLs join the damage line.
+  const ImportReport& report = plan_ ? plan_->report : ImportReport();
+  value.Set("skippedLiveFolders", report.skipped_live_folders);
+  value.Set("skippedEasels", report.skipped_easels);
+  value.Set("skippedNotes", report.skipped_notes);
+  value.Set("damaged", report.damage_total() + counts.invalid_urls);
+
+  bool history_imported = false;
+  bool history_failed = false;
+  for (const ArcProfileResult& profile : result.profiles) {
+    history_imported |=
+        profile.history == ArcProfileResult::History::kImported;
+    history_failed |= profile.history == ArcProfileResult::History::kFailed;
+  }
+  value.Set("history", history_imported ? "imported"
+                       : history_failed   ? "failed"
+                                          : "none");
+  value.Set("pinnedExtensions", result.pinned_extensions);
+  value.Set("handoffsSaved", result.handoffs_saved);
+  value.Set("undoUntil",
+            result.undo_until
+                ? FormatArcDate(*result.undo_until, "EEEEMMMMd")
+                : std::string());
+
+  // The spaces that came over, as tiles, and the Arc profiles that became
+  // rac profiles, both resolved against the preview the page is showing.
+  base::ListValue tiles;
+  base::ListValue new_profiles;
+  for (const ArcProfileResult& profile : result.profiles) {
+    if (profile.status != ArcProfileResult::Status::kDone) {
+      continue;
+    }
+    const base::DictValue* source = PreviewProfile(profile.source_key);
+    if (!source) {
+      continue;
+    }
+    const base::ListValue* spaces = source->FindList("spaces");
+    if (!spaces) {
+      continue;
+    }
+    for (const base::Value& entry : *spaces) {
+      const base::DictValue* space = entry.GetIfDict();
+      const std::string* title = space ? space->FindString("title") : nullptr;
+      const std::string* emoji = space ? space->FindString("emoji") : nullptr;
+      const base::ListValue* light = space ? space->FindList("light") : nullptr;
+      const base::ListValue* dark = space ? space->FindList("dark") : nullptr;
+      if (!light || !dark || light->size() < 2 || dark->size() < 2 ||
+          !(*light)[0].is_string() || !(*light)[1].is_string() ||
+          !(*dark)[0].is_string() || !(*dark)[1].is_string()) {
+        continue;
+      }
+      tiles.Append(TileValue(title ? *title : "", emoji ? *emoji : "",
+                             (*light)[0].GetString(), (*light)[1].GetString(),
+                             (*dark)[0].GetString(), (*dark)[1].GetString()));
+    }
+    if (profile.new_profile) {
+      base::DictValue new_profile;
+      const std::string* name = source->FindString("name");
+      new_profile.Set("name", name ? *name : "");
+      new_profile.Set("spaces", static_cast<int>(spaces->size()));
+      new_profiles.Append(std::move(new_profile));
+    }
+  }
+  value.Set("tiles", std::move(tiles));
+  value.Set("newProfiles", std::move(new_profiles));
+  return value;
+}
+
+void ArcImportHandler::HandleUndo(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  if (importing_) {
+    ResolveJavascriptCallback(args[0], base::Value("busy"));
+    return;
+  }
+  backend_->UndoImport(base::BindOnce(
+      [](base::WeakPtr<ArcImportHandler> self, base::Value callback_id,
+         ArcUndoResult result) {
+        if (!self) {
+          return;
+        }
+        self->ResolveJavascriptCallback(callback_id,
+                                        base::Value(UndoResultName(result)));
+        if (result == ArcUndoResult::kUndone ||
+            result == ArcUndoResult::kPartlyUndone) {
+          ChangedCallbacks().Notify(self->profile_);
+        }
+      },
+      weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+base::Value ArcImportHandler::RestoreOfferToValue() const {
+  const DataBackups::RestoreOffer* offer = backend_->GetRestoreOffer();
+  if (!offer) {
+    return base::Value();
+  }
+  base::DictValue value;
+  value.Set("created", FormatArcDate(offer->created, "EEEEMMMMdjmm"));
+  value.Set("spaces", static_cast<int>(offer->counts.spaces));
+  value.Set("pinnedTabs", static_cast<int>(offer->counts.pinned_tabs));
+  value.Set("favorites", static_cast<int>(offer->counts.favorites));
+  base::ListValue tiles;
+  for (const DataBackups::SpaceSummary& source : offer->spaces) {
+    // A summary's dark stops aren't stored; the theme derives them like
+    // the sidebar does.
+    const SpaceTileStops stops = TileStopsFor(source.theme);
+    tiles.Append(TileValue(source.name, source.emoji, stops.light1,
+                           stops.light2, stops.dark1, stops.dark2));
+  }
+  value.Set("tiles", std::move(tiles));
+  return base::Value(std::move(value));
+}
+
+void ArcImportHandler::HandleGetRestoreOffer(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], RestoreOfferToValue());
+}
+
+void ArcImportHandler::OnRestoreOfferChanged() {
+  FireWebUIListener("rac-restore-offer-changed", RestoreOfferToValue());
+}
+
+void ArcImportHandler::HandleAnswerRestore(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  if (importing_) {
+    ResolveJavascriptCallback(args[0], base::Value(false));
+    return;
+  }
+  // Only an explicit answer counts: "Don't restore" drops the offer for good.
+  const std::optional<bool> restore = args[1].GetIfBool();
+  if (!restore) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  backend_->AnswerRestoreOffer(
+      *restore,
+      base::BindOnce(
+          [](base::WeakPtr<ArcImportHandler> self, base::Value callback_id,
+             bool restored) {
+            if (self) {
+              self->ResolveJavascriptCallback(callback_id,
+                                              base::Value(restored));
+            }
+          },
+          weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::HandleShowArcImport(const base::ListValue& args) {
+  // The import fills a regular profile's sidebar; never an off-the-record
+  // or guest one.
+  if (!profile_->IsRegularProfile()) {
+    return;
+  }
+  ShowArcImport(profile_);
+}
+
+void ArcImportHandler::HandleClose(const base::ListValue& args) {
+  CloseWelcomeTour(web_ui()->GetWebContents());
+}
+
+}  // namespace rac::onboarding

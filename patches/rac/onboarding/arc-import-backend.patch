--- /dev/null
+++ src/chrome/browser/ui/rac/onboarding/arc_import_handler.cc
@@ -0,0 +1,407 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/onboarding/arc_import_handler.h"
+
+#include <string>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/i18n/time_formatting.h"
+#include "base/types/expected.h"
+#include "chrome/browser/ui/rac/onboarding/arc_import_backend.h"
+#include "chrome/browser/ui/rac/onboarding/onboarding_window.h"
+#include "content/public/browser/web_ui.h"
+
+namespace rac::onboarding {
+
+namespace {
+
+// "Tuesday, November 3" and "Monday, October 26 at 9:14 PM", in the
+// user's locale.
+std::u16string Day(base::Time time) {
+  return base::LocalizedTimeFormatWithPattern(time, "EEEEMMMMd");
+}
+std::u16string DayAndTime(base::Time time) {
+  return base::LocalizedTimeFormatWithPattern(time, "EEEEMMMMdjmm");
+}
+
+base::ListValue StopsValue(std::string_view first, std::string_view second) {
+  base::ListValue pair;
+  pair.Append(std::string(first));
+  pair.Append(std::string(second));
+  return pair;
+}
+
+void SetLabel(base::DictValue& value, const ArcProfileLabel& label) {
+  value.Set("name", label.name);
+  static constexpr const char* kFallbacks[] = {"none", "default", "numbered"};
+  value.Set("nameFallback", kFallbacks[std::to_underlying(label.fallback)]);
+  value.Set("nameNumber", label.number);
+}
+
+}  // namespace
+
+ArcImportHandler::ArcImportHandler(Profile* profile)
+    : backend_(CreateArcImportBackend(profile)) {}
+
+ArcImportHandler::~ArcImportHandler() = default;
+
+void ArcImportHandler::RegisterMessages() {
+  const auto add = [this](const char* name, auto method) {
+    web_ui()->RegisterMessageCallback(
+        name, base::BindRepeating(method, base::Unretained(this)));
+  };
+  add("racArcImportGetState", &ArcImportHandler::HandleGetState);
+  add("racArcImportRead", &ArcImportHandler::HandleRead);
+  add("racArcImportStart", &ArcImportHandler::HandleStart);
+  add("racArcImportRetrySignIns", &ArcImportHandler::HandleRetrySignIns);
+  add("racArcImportUndo", &ArcImportHandler::HandleUndo);
+  add("racArcImportOpenProfile", &ArcImportHandler::HandleOpenProfile);
+  add("racArcImportIsRunning", &ArcImportHandler::HandleIsArcRunning);
+  add("racArcImportWatchQuit", &ArcImportHandler::HandleWatchArcQuit);
+  add("racRestoreGetOffer", &ArcImportHandler::HandleGetRestoreOffer);
+  add("racRestoreAnswer", &ArcImportHandler::HandleAnswerRestore);
+  add("racOnboardingClose", &ArcImportHandler::HandleClose);
+}
+
+void ArcImportHandler::OnJavascriptAllowed() {
+  backend_->SetRestoreOfferChangedCallback(
+      base::BindRepeating(&ArcImportHandler::OnRestoreOfferChanged,
+                          weak_factory_.GetWeakPtr()));
+}
+
+void ArcImportHandler::OnJavascriptDisallowed() {
+  backend_->SetRestoreOfferChangedCallback(base::RepeatingClosure());
+  weak_factory_.InvalidateWeakPtrs();
+  // A reload mid-import drops the finish callback; the backend still refuses
+  // a second import while the first runs.
+  importing_ = false;
+  quit_wait_.reset();
+}
+
+void ArcImportHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  backend_->CheckSource(
+      base::BindOnce(&ArcImportHandler::OnSourceChecked,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::OnSourceChecked(base::Value callback_id, bool found) {
+  backend_->GetImportState(base::BindOnce(
+      [](base::WeakPtr<ArcImportHandler> self, base::Value callback_id,
+         bool found, const ArcImportState& state) {
+        if (!self) {
+          return;
+        }
+        base::DictValue value;
+        value.Set("found", found);
+        value.Set("importedAt",
+                  state.last_import ? base::Value(Day(*state.last_import))
+                                    : base::Value());
+        value.Set("undoUntil",
+                  state.undo_until ? base::Value(Day(*state.undo_until))
+                                   : base::Value());
+        // For the Undo prompt's "Your sidebar goes back to how it was on…".
+        value.Set("undoSnapshot",
+                  state.undo_snapshot_time
+                      ? base::Value(DayAndTime(*state.undo_snapshot_time))
+                      : base::Value());
+        value.Set("signInsAvailable", self->backend_->SignInsAvailable());
+        self->ResolveJavascriptCallback(callback_id, std::move(value));
+      },
+      weak_factory_.GetWeakPtr(), std::move(callback_id), found));
+}
+
+void ArcImportHandler::HandleRead(const base::ListValue& args) {
+  AllowJavascript();
+  backend_->ReadPlan(base::BindOnce(&ArcImportHandler::OnRead,
+                                    weak_factory_.GetWeakPtr(),
+                                    args[0].Clone()));
+}
+
+void ArcImportHandler::OnRead(
+    base::Value callback_id,
+    base::expected<ImportPlan, ArcReadError> plan) {
+  base::DictValue reply;
+  if (!plan.has_value()) {
+    plan_.reset();
+    reply.Set("error", true);
+  } else {
+    reply.Set("preview", backend_->PlanToPreviewValue(*plan));
+    plan_ = std::move(*plan);
+  }
+  ResolveJavascriptCallback(callback_id, std::move(reply));
+}
+
+void ArcImportHandler::HandleStart(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  const base::DictValue* dict = args[1].GetIfDict();
+  if (!plan_ || importing_ || !dict) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  ArcImportOptions options;
+  if (const base::ListValue* skipped = dict->FindList("skippedProfileKeys")) {
+    for (const base::Value& key : *skipped) {
+      if (key.is_string()) {
+        options.skipped_profile_keys.insert(key.GetString());
+      }
+    }
+  }
+  options.open_tabs = dict->FindBool("openTabs").value_or(true);
+  options.history = dict->FindBool("history").value_or(true);
+  options.sign_ins = backend_->SignInsAvailable() &&
+                     dict->FindBool("signIns").value_or(false);
+
+  importing_ = true;
+  created_profiles_.clear();
+  backend_->StartImport(
+      *plan_, options,
+      base::BindRepeating(&ArcImportHandler::OnProgress,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&ArcImportHandler::OnFinished,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::OnProgress(const ArcImportProgress& progress) {
+  static constexpr const char* kSteps[] = {"snapshot", "spaces", "history",
+                                           "signIns", "waitingForMac"};
+  base::DictValue value;
+  value.Set("step", kSteps[static_cast<size_t>(progress.step)]);
+  value.Set("done", progress.done);
+  value.Set("total", progress.total);
+  value.Set("spaceId", progress.space_id);
+  value.Set("spaceTitle", progress.space_title);
+  FireWebUIListener("rac-arc-import-progress", value);
+}
+
+void ArcImportHandler::OnFinished(base::Value callback_id,
+                                  const ArcImportResult& result) {
+  importing_ = false;
+  for (const ArcProfileResult& profile : result.profiles) {
+    if (profile.new_profile && !profile.profile_path.empty()) {
+      created_profiles_.insert(profile.profile_path.value());
+    }
+  }
+  ResolveJavascriptCallback(callback_id, ResultToValue(result));
+}
+
+void ArcImportHandler::HandleRetrySignIns(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  if (!backend_->SignInsAvailable() || importing_) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  importing_ = true;
+  backend_->RetrySignIns(
+      base::BindRepeating(&ArcImportHandler::OnProgress,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&ArcImportHandler::OnFinished,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+ArcProfileLabel ArcImportHandler::LabelFor(const std::string& source_key,
+                                           size_t index) const {
+  if (plan_) {
+    for (size_t i = 0; i < plan_->profiles.size(); ++i) {
+      if (plan_->profiles[i].source_key == source_key) {
+        return ArcProfileLabelFor(*plan_, i);
+      }
+    }
+  }
+  ArcProfileLabel label;
+  label.fallback = ArcProfileLabel::Fallback::kNumbered;
+  label.number = static_cast<int>(index) + 2;
+  return label;
+}
+
+base::DictValue ArcImportHandler::ResultToValue(
+    const ArcImportResult& result) const {
+  static constexpr const char* kStatuses[] = {"done", "nothingNew", "failed"};
+  static constexpr const char* kFailures[] = {
+      "none",          "busy",          "snapshotFailed",
+      "recordTooNew",  "recordNotSaved", "profileGone"};
+
+  base::DictValue value;
+  value.Set("status", kStatuses[static_cast<size_t>(result.status)]);
+  value.Set("failure", kFailures[static_cast<size_t>(result.failure)]);
+
+  const ArcImportCounts& counts = result.counts;
+  value.Set("spaces", counts.spaces);
+  value.Set("pinnedTabs", counts.pinned_tabs);
+  value.Set("favorites", counts.favorites);
+  value.Set("openTabs", counts.open_tabs);
+  value.Set("folders", counts.folders);
+  value.Set("nestedFolders", counts.nested_folders);
+  value.Set("firstFlattenedName", counts.first_flattened_name);
+  value.Set("splitViews", counts.split_views);
+  value.Set("tabGroups", counts.tab_groups);
+  value.Set("invalidUrls", counts.invalid_urls);
+  value.Set("unsupportedUrls", counts.unsupported_urls);
+  value.Set("favoritesAlreadyThere", counts.favorites_already_there);
+  value.Set("alreadyImported", counts.already_imported);
+  value.Set("removedSince", counts.removed_since);
+  value.Set("openTabsNotReopened", counts.open_tabs_not_reopened);
+
+  // What the reader left out or couldn't read; the applier's rejected URLs
+  // join the damage line.
+  const ImportReport& report = plan_ ? plan_->report : ImportReport();
+  value.Set("skippedLiveFolders", report.skipped_live_folders);
+  value.Set("skippedEasels", report.skipped_easels);
+  value.Set("skippedNotes", report.skipped_notes);
+  value.Set("skippedUnknown", report.skipped_unknown);
+  value.Set("skippedTabsWithoutUrl", report.skipped_tabs_without_url);
+  value.Set("damaged", report.damage_total() + counts.invalid_urls);
+  value.Set("firstNestedFolderPath", report.first_nested_folder_path);
+
+  bool history_failed = false;
+  bool history_imported = false;
+  for (const ArcProfileResult& profile : result.profiles) {
+    switch (profile.history) {
+      case ArcProfileResult::History::kFailed:
+        history_failed = true;
+        break;
+      case ArcProfileResult::History::kImported:
+      case ArcProfileResult::History::kAlreadyImported:
+        history_imported = true;
+        break;
+      default:
+        break;
+    }
+  }
+  value.Set("history", history_failed    ? "failed"
+                       : history_imported ? "imported"
+                                          : "skipped");
+  // The sign-ins step (04 M2) isn't in this build.
+  value.Set("signIns", "notAvailable");
+  value.Set("passwords", "notOffered");
+  value.Set("pinnedExtensions", result.pinned_extensions);
+  value.Set("handoffsSaved", result.handoffs_saved);
+
+  base::ListValue new_profiles;
+  for (const ArcProfileResult& profile : result.profiles) {
+    if (!profile.new_profile ||
+        profile.status != ArcProfileResult::Status::kDone ||
+        profile.profile_path.empty()) {
+      continue;
+    }
+    base::DictValue created;
+    created.Set("key", profile.source_key);
+    SetLabel(created, LabelFor(profile.source_key, new_profiles.size()));
+    created.Set("spaces", profile.counts.spaces);
+    created.Set("path", profile.profile_path.value());
+    new_profiles.Append(std::move(created));
+  }
+  value.Set("newProfiles", std::move(new_profiles));
+  value.Set("undoUntil",
+            result.undo_until ? base::Value(Day(*result.undo_until))
+                              : base::Value());
+  return value;
+}
+
+void ArcImportHandler::HandleUndo(const base::ListValue& args) {
+  AllowJavascript();
+  backend_->UndoImport(base::BindOnce(
+      [](base::WeakPtr<ArcImportHandler> self, base::Value callback_id,
+         ArcUndoResult result) {
+        if (!self) {
+          return;
+        }
+        static constexpr const char* kResults[] = {
+            "undone",  "partlyUndone", "busy",
+            "expired", "nothingToUndo", "failed"};
+        self->ResolveJavascriptCallback(
+            callback_id, base::Value(kResults[static_cast<size_t>(result)]));
+      },
+      weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::HandleOpenProfile(const base::ListValue& args) {
+  AllowJavascript();
+  const std::string* path = args[0].GetIfString();
+  if (!path || !created_profiles_.contains(*path)) {
+    return;
+  }
+  backend_->OpenProfile(base::FilePath(*path),
+                        base::BindOnce([](bool) {}));
+}
+
+void ArcImportHandler::HandleIsArcRunning(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], base::Value(backend_->IsArcRunning()));
+}
+
+void ArcImportHandler::HandleWatchArcQuit(const base::ListValue& args) {
+  AllowJavascript();
+  // One watch at a time; a second request replaces the first.
+  quit_wait_ = backend_->WatchArcQuit(
+      base::BindOnce([](base::WeakPtr<ArcImportHandler> self) {
+        if (self) {
+          self->FireWebUIListener("rac-arc-quit");
+        }
+      }, weak_factory_.GetWeakPtr()));
+}
+
+base::Value ArcImportHandler::RestoreOfferToValue() const {
+  const std::optional<DataBackups::RestoreOffer> offer =
+      backend_->GetRestoreOffer();
+  if (!offer) {
+    return base::Value();
+  }
+  base::DictValue value;
+  value.Set("created", DayAndTime(offer->created));
+  base::DictValue counts;
+  counts.Set("spaces", static_cast<int>(offer->counts.spaces));
+  counts.Set("pinnedTabs", static_cast<int>(offer->counts.pinned_tabs));
+  counts.Set("favorites", static_cast<int>(offer->counts.favorites));
+  value.Set("counts", std::move(counts));
+  base::ListValue spaces;
+  for (const DataBackups::SpaceSummary& source : offer->spaces) {
+    base::DictValue space;
+    space.Set("name", source.name);
+    space.Set("emoji", source.emoji);
+    // SpaceSummary carries no dark stops: the prompt paints the same pair.
+    space.Set("light", StopsValue(source.color1, source.color2));
+    space.Set("dark", StopsValue(source.color1, source.color2));
+    spaces.Append(std::move(space));
+  }
+  value.Set("spaces", std::move(spaces));
+  return base::Value(std::move(value));
+}
+
+void ArcImportHandler::HandleGetRestoreOffer(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], RestoreOfferToValue());
+}
+
+void ArcImportHandler::OnRestoreOfferChanged() {
+  FireWebUIListener("rac-restore-offer-changed", RestoreOfferToValue());
+}
+
+void ArcImportHandler::HandleAnswerRestore(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  const bool restore = args[1].GetIfBool().value_or(false);
+  backend_->AnswerRestoreOffer(
+      restore,
+      base::BindOnce(
+          [](base::WeakPtr<ArcImportHandler> self, base::Value callback_id,
+             bool restored) {
+            if (self) {
+              self->ResolveJavascriptCallback(callback_id,
+                                              base::Value(restored));
+            }
+          },
+          weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::HandleClose(const base::ListValue& args) {
+  CloseWelcomeTour(web_ui()->GetWebContents());
+}
+
+}  // namespace rac::onboarding

+
+// Days or hours as numbers, so the script's dates stay fresh.
+base::Time DaysAgo(const base::DictValue& dict, std::string_view key) {
+  return base::Time::Now() -
+         base::Days(static_cast<int64_t>(dict.FindDouble(key).value_or(0)));
+}
+base::Time DaysAhead(const base::DictValue& dict, std::string_view key) {
+  return base::Time::Now() +
+         base::Days(static_cast<int64_t>(dict.FindDouble(key).value_or(0)));
+}
+base::Time HoursAgo(const base::DictValue& dict, std::string_view key) {
+  return base::Time::Now() -
+         base::Hours(static_cast<int64_t>(dict.FindDouble(key).value_or(0)));
+}
+
+std::optional<ArcImportProgress::Step> ParseStep(std::string_view step) {
+  static constexpr std::pair<std::string_view, ArcImportProgress::Step>
+      kSteps[] = {
+          {"snapshot", ArcImportProgress::Step::kSnapshot},
+          {"spaces", ArcImportProgress::Step::kSpaces},
+          {"history", ArcImportProgress::Step::kHistory},
+          {"signIns", ArcImportProgress::Step::kSignIns},
+          {"waitingForMac", ArcImportProgress::Step::kWaitingForMac},
+      };
+  for (const auto& [name, value] : kSteps) {
+    if (step == name) {
+      return value;
+    }
+  }
+  return std::nullopt;
+}
+
+ArcImportResult::Status ParseStatus(const std::string* status) {
+  if (status && *status == "nothingNew") {
+    return ArcImportResult::Status::kNothingNew;
+  }
+  if (status && *status == "failed") {
+    return ArcImportResult::Status::kFailed;
+  }
+  return ArcImportResult::Status::kDone;
+}
+
+ArcImportFailure ParseFailure(const std::string* failure) {
+  static constexpr std::pair<std::string_view, ArcImportFailure> kFailures[] =
+      {{"busy", ArcImportFailure::kBusy},
+       {"snapshotFailed", ArcImportFailure::kSnapshotFailed},
+       {"recordTooNew", ArcImportFailure::kRecordTooNew},
+       {"recordNotSaved", ArcImportFailure::kRecordNotSaved},
+       {"profileGone", ArcImportFailure::kProfileGone}};
+  if (failure) {
+    for (const auto& [name, value] : kFailures) {
+      if (*failure == name) {
+        return value;
+      }
+    }
+  }
+  return ArcImportFailure::kNone;
+}
+
+ArcProfileResult::Status ParseProfileStatus(const std::string* status) {
+  static constexpr std::pair<std::string_view, ArcProfileResult::Status>
+      kStatuses[] = {
+          {"done", ArcProfileResult::Status::kDone},
+          {"nothingNew", ArcProfileResult::Status::kNothingNew},
+          {"skipped", ArcProfileResult::Status::kSkipped},
+          {"needsProfile", ArcProfileResult::Status::kNeedsProfile},
+          {"failed", ArcProfileResult::Status::kFailed},
+      };
+  if (status) {
+    for (const auto& [name, value] : kStatuses) {
+      if (*status == name) {
+        return value;
+      }
+    }
+  }
+  return ArcProfileResult::Status::kDone;
+}
+
+ArcProfileResult::History ParseHistory(const std::string* history) {
+  static constexpr std::pair<std::string_view, ArcProfileResult::History>
+      kValues[] = {
+          {"notRequested", ArcProfileResult::History::kNotRequested},
+          {"imported", ArcProfileResult::History::kImported},
+          {"alreadyImported", ArcProfileResult::History::kAlreadyImported},
+          {"notAvailable", ArcProfileResult::History::kNotAvailable},
+          {"failed", ArcProfileResult::History::kFailed},
+      };
+  if (history) {
+    for (const auto& [name, value] : kValues) {
+      if (*history == name) {
+        return value;
+      }
+    }
+  }
+  return ArcProfileResult::History::kNotRequested;
+}
+
+ArcUndoResult ParseUndoResult(const std::string* result) {
+  static constexpr std::pair<std::string_view, ArcUndoResult> kResults[] = {
+      {"undone", ArcUndoResult::kUndone},
+      {"partlyUndone", ArcUndoResult::kPartlyUndone},
+      {"busy", ArcUndoResult::kBusy},
+      {"expired", ArcUndoResult::kExpired},
+      {"nothingToUndo", ArcUndoResult::kNothingToUndo},
+      {"failed", ArcUndoResult::kFailed},
+  };
+  if (result) {
+    for (const auto& [name, value] : kResults) {
+      if (*result == name) {
+        return value;
+      }
+    }
+  }
+  return ArcUndoResult::kUndone;
+}
+
+int IntAt(const base::DictValue& dict, std::string_view key) {
+  return static_cast<int>(dict.FindDouble(key).value_or(0));
+}
+
+void CountsFromJson(const base::DictValue& json, ArcImportCounts& counts) {
+  counts.spaces = IntAt(json, "spaces");
+  counts.pinned_tabs = IntAt(json, "pinnedTabs");
+  counts.folders = IntAt(json, "folders");
+  counts.favorites = IntAt(json, "favorites");
+  counts.open_tabs = IntAt(json, "openTabs");
+  counts.nested_folders = IntAt(json, "nestedFolders");
+  if (const std::string* name = json.FindString("firstFlattenedName")) {
+    counts.first_flattened_name = *name;
+  }
+  counts.split_views = IntAt(json, "splitViews");
+  counts.tab_groups = IntAt(json, "tabGroups");
+  counts.invalid_urls = IntAt(json, "invalidUrls");
+  counts.unsupported_urls = IntAt(json, "unsupportedUrls");
+  counts.favorites_already_there = IntAt(json, "favoritesAlreadyThere");
+  counts.already_imported = IntAt(json, "alreadyImported");
+  counts.removed_since = IntAt(json, "removedSince");
+  counts.open_tabs_not_reopened = IntAt(json, "openTabsNotReopened");
+}
+
+// The page dict's preview becomes a real plan's skeleton: the result's
+// profile names resolve against it, and the report feeds the result's
+// skip and damage lines.
+ImportPlan PlanFromScript(const base::DictValue& preview,
+                          const base::DictValue* report) {
+  ImportPlan plan;
+  if (const base::ListValue* profiles = preview.FindList("profiles")) {
+    for (const base::Value& entry : *profiles) {
+      const base::DictValue* dict = entry.GetIfDict();
+      if (!dict) {
+        continue;
+      }
+      ImportProfile profile;
+      if (const std::string* key = dict->FindString("key")) {
+        profile.source_key = *key;
+      }
+      if (const std::string* name = dict->FindString("name")) {
+        profile.display_name = *name;
+      }
+      profile.is_default = dict->FindBool("isDefault").value_or(false);
+      plan.profiles.push_back(std::move(profile));
+    }
+  }
+  if (report) {
+    ImportReport& out = plan.report;
+    out.skipped_live_folders = IntAt(*report, "skippedLiveFolders");
+    out.skipped_easels = IntAt(*report, "skippedEasels");
+    out.skipped_notes = IntAt(*report, "skippedNotes");
+    out.skipped_unknown = IntAt(*report, "skippedUnknown");
+    out.skipped_tabs_without_url = IntAt(*report, "skippedTabsWithoutUrl");
+    out.missing_items = IntAt(*report, "missingItems");
+    out.repeated_items = IntAt(*report, "repeatedItems");
+    out.too_deep = IntAt(*report, "tooDeep");
+    out.malformed_entries = IntAt(*report, "malformedEntries");
+    out.invalid_urls = IntAt(*report, "invalidUrls");
+    out.open_tabs = IntAt(*report, "openTabs");
+    if (const std::string* path = report->FindString("firstNestedFolderPath")) {
+      out.first_nested_folder_path = *path;
+    }
+  }
+  return plan;
+}
+
+ArcImportResult ResultFromScript(const base::DictValue& json) {
+  ArcImportResult result;
+  result.status = ParseStatus(json.FindString("status"));
+  result.failure = ParseFailure(json.FindString("failure"));
+  CountsFromJson(json, result.counts);
+  result.handoffs_saved = json.FindBool("handoffsSaved").value_or(false);
+  result.pinned_extensions = IntAt(json, "pinnedExtensions");
+  if (json.FindDouble("undoUntilDays")) {
+    result.undo_until = DaysAhead(json, "undoUntilDays");
+  }
+  const std::string* history = json.FindString("history");
+  if (const base::ListValue* profiles = json.FindList("profiles")) {
+    for (const base::Value& entry : *profiles) {
+      const base::DictValue* dict = entry.GetIfDict();
+      if (!dict) {
+        continue;
+      }
+      ArcProfileResult profile;
+      if (const std::string* key = dict->FindString("key")) {
+        profile.source_key = *key;
+      }
+      profile.status = ParseProfileStatus(dict->FindString("status"));
+      profile.failure = ParseFailure(dict->FindString("failure"));
+      profile.new_profile = dict->FindBool("newProfile").value_or(false);
+      if (const std::string* path = dict->FindString("path")) {
+        profile.profile_path = base::FilePath(*path);
+      }
+      CountsFromJson(*dict, profile.counts);
+      profile.history =
+          ParseHistory(dict->FindString("history") ? dict->FindString("history")
+                                                 : history);
+      if (dict->FindDouble("undoUntilDays")) {
+        profile.undo_until = DaysAhead(*dict, "undoUntilDays");
+      }
+      profile.pinned_extensions = IntAt(*dict, "pinnedExtensions");
+      result.profiles.push_back(profile);
+    }
+  } else if (history) {
+    // No per-profile rows: history still applies to the import as a whole.
+    ArcProfileResult profile;
+    profile.status = ArcProfileResult::Status::kDone;
+    profile.history = ParseHistory(history);
+    result.profiles.push_back(profile);
+  }
+  return result;
+}
+
+ArcImportState StateFromScript(const base::DictValue& state) {
+  ArcImportState out;
+  if (state.FindDouble("importedDaysAgo")) {
+    out.last_import = DaysAgo(state, "importedDaysAgo");
+  }
+  if (state.FindDouble("undoUntilDays")) {
+    out.undo_until = DaysAhead(state, "undoUntilDays");
+    out.undo_snapshot_time = state.FindDouble("undoSnapshotHoursAgo")
+                                 ? HoursAgo(state, "undoSnapshotHoursAgo")
+                                 : out.undo_until;
+  }
+  return out;
+}
+
+std::optional<DataBackups::RestoreOffer> OfferFromScript(
+    const base::DictValue* offer) {
+  if (!offer) {
+    return std::nullopt;
+  }
+  DataBackups::RestoreOffer out;
+  out.backup_id = "fixture";
+  out.created = offer->FindDouble("createdHoursAgo")
+                    ? HoursAgo(*offer, "createdHoursAgo")
+                    : base::Time::Now();
+  out.detected = out.created;
+  if (const base::DictValue* counts = offer->FindDict("counts")) {
+    out.counts.spaces = static_cast<size_t>(IntAt(*counts, "spaces"));
+    out.counts.pinned_tabs = static_cast<size_t>(IntAt(*counts, "pinnedTabs"));
+    out.counts.favorites = static_cast<size_t>(IntAt(*counts, "favorites"));
+  }
+  if (const base::ListValue* spaces = offer->FindList("spaces")) {
+    for (const base::Value& entry : *spaces) {
+      const base::DictValue* dict = entry.GetIfDict();
+      if (!dict) {
+        continue;
+      }
+      DataBackups::SpaceSummary space;
+      if (const std::string* name = dict->FindString("name")) {
+        space.name = *name;
+      }
+      if (const std::string* emoji = dict->FindString("emoji")) {
+        space.emoji = *emoji;
+      }
+      if (const base::ListValue* light = dict->FindList("light")) {
+        if (light->size() >= 2 && (*light)[0].is_string() &&
+            (*light)[1].is_string()) {
+          space.color1 = (*light)[0].GetString();
+          space.color2 = (*light)[1].GetString();
+        }
+      }
+      out.spaces.push_back(std::move(space));
+    }
+  }
+  return out;
+}
+
+// A QuitWait on a timer, or one that never fires (Arc running, no scripted
+// quit), or one that runs from a posted task (Arc not running). Like
+// ArcQuitWatcher: destroyed to cancel, `on_quit` never from the constructor.
+class FixtureQuitWait : public ArcImportBackend::QuitWait {
+ public:
+  // `delay` nullopt: never fires.
+  FixtureQuitWait(FixtureArcImportBackend* backend,
+                  std::optional<base::TimeDelta> delay,
+                  base::OnceClosure on_quit)
+      : backend_(backend), on_quit_(std::move(on_quit)) {
+    if (delay) {
+      timer_.Start(FROM_HERE, *delay,
+                   base::BindOnce(&FixtureQuitWait::Run,
+                                  base::Unretained(this)));
+    }
+  }
+
+ private:
+  void Run() {
+    backend_->SetArcNotRunning();
+    if (on_quit_) {
+      std::move(on_quit_).Run();
+    }
+  }
+
+  const raw_ptr<FixtureArcImportBackend> backend_;
+  base::OnceClosure on_quit_;
+  base::OneShotTimer timer_;
+};
+
+}  // namespace
+
+FixtureArcImportBackend::FixtureArcImportBackend(base::DictValue script)
+    : script_(std::move(script)),
+      preview_(script_.FindDict("preview") ? script_.FindDict("preview")->Clone()
+                                           : base::DictValue()),
+      plan_(PlanFromScript(preview_, script_.FindDict("report"))) {
+  const base::DictValue* state = script_.FindDict("state");
+  found_ = state ? state->FindBool("found").value_or(true) : true;
+  sign_ins_available_ =
+      state ? state->FindBool("signInsAvailable").value_or(false) : false;
+  state_ = state ? StateFromScript(*state) : ArcImportState();
+  read_error_ = script_.FindBool("readError").value_or(false);
+  arc_running_ = script_.FindBool("arcRunning").value_or(false);
+  const std::optional<double> quit_after = script_.FindDouble("arcQuitAfterMs");
+  arc_quit_after_set_ = quit_after.has_value();
+  arc_quit_after_ =
+      base::Milliseconds(static_cast<int64_t>(quit_after.value_or(0)));
+  read_delay_ = base::Milliseconds(
+      static_cast<int64_t>(script_.FindDouble("readDelayMs").value_or(30)));
+  progress_interval_ = base::Milliseconds(static_cast<int64_t>(
+      script_.FindDouble("progressIntervalMs").value_or(150)));
+  offer_ = OfferFromScript(script_.FindDict("restoreOffer"));
+  undo_result_ = ParseUndoResult(script_.FindString("undoResult"));
+  result_ = script_.FindDict("result")
+                ? ResultFromScript(*script_.FindDict("result"))
+                : ArcImportResult();
+}
+
+FixtureArcImportBackend::~FixtureArcImportBackend() = default;
+
+void FixtureArcImportBackend::CheckSource(
+    base::OnceCallback<void(bool exists)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), found_));
+}
+
+void FixtureArcImportBackend::ReadPlan(
+    base::OnceCallback<void(base::expected<ImportPlan, ArcReadError>)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<FixtureArcImportBackend> self,
+             base::OnceCallback<void(
+                 base::expected<ImportPlan, ArcReadError>)> done) {
+            if (!self) {
+              return;
+            }
+            if (self->read_error_) {
+              std::move(done).Run(
+                  base::unexpected(ArcReadError::kUnreadable));
+            } else {
+              std::move(done).Run(base::ok(self->plan_));
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(done)),
+      read_delay_);
+}
+
+base::DictValue FixtureArcImportBackend::PlanToPreviewValue(
+    const ImportPlan& plan) {
+  // The script's preview is already the page's dictionary.
+  return preview_.Clone();
+}
+
+void FixtureArcImportBackend::GetImportState(
+    base::OnceCallback<void(const ArcImportState&)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), state_));
+}
+
+bool FixtureArcImportBackend::SignInsAvailable() const {
+  return sign_ins_available_;
+}
+
+std::vector<ArcImportProgress> FixtureArcImportBackend::ProgressEvents(
+    const ArcImportOptions& options) const {
+  std::vector<ArcImportProgress> events;
+  if (const base::ListValue* scripted = script_.FindList("progress")) {
+    for (const base::Value& entry : *scripted) {
+      const base::DictValue* dict = entry.GetIfDict();
+      const std::string* step_name =
+          dict ? dict->FindString("step") : nullptr;
+      std::optional<ArcImportProgress::Step> step =
+          step_name ? ParseStep(*step_name) : std::nullopt;
+      if (!step) {
+        continue;
+      }
+      ArcImportProgress progress;
+      progress.step = *step;
+      progress.done = IntAt(*dict, "done");
+      progress.total = IntAt(*dict, "total");
+      if (const std::string* id = dict->FindString("spaceId")) {
+        progress.space_id = *id;
+      }
+      if (const std::string* title = dict->FindString("spaceTitle")) {
+        progress.space_title = *title;
+      }
+      events.push_back(std::move(progress));
+    }
+    return events;
+  }
+
+  ArcImportProgress snapshot;
+  snapshot.step = ArcImportProgress::Step::kSnapshot;
+  events.push_back(snapshot);
+
+  // One kSpaces per space of every checked profile, in preview order.
+  const auto is_checked = [&options](const base::DictValue* profile) {
+    const std::string* key = profile ? profile->FindString("key") : nullptr;
+    return key && !options.skipped_profile_keys.contains(*key);
+  };
+  int total = 0;
+  if (const base::ListValue* profiles = preview_.FindList("profiles")) {
+    for (const base::Value& entry : *profiles) {
+      const base::DictValue* profile = entry.GetIfDict();
+      if (!is_checked(profile)) {
+        continue;
+      }
+      if (const base::ListValue* spaces = profile->FindList("spaces")) {
+        total += static_cast<int>(spaces->size());
+      }
+    }
+    int done = 0;
+    for (const base::Value& entry : *profiles) {
+      const base::DictValue* profile = entry.GetIfDict();
+      if (!is_checked(profile)) {
+        continue;
+      }
+      const base::ListValue* spaces = profile->FindList("spaces");
+      if (!spaces) {
+        continue;
+      }
+      for (const base::Value& space_entry : *spaces) {
+        const base::DictValue* space = space_entry.GetIfDict();
+        if (!space) {
+          continue;
+        }
+        ArcImportProgress progress;
+        progress.step = ArcImportProgress::Step::kSpaces;
+        progress.done = ++done;
+        progress.total = total;
+        if (const std::string* id = space->FindString("id")) {
+          progress.space_id = *id;
+        }
+        if (const std::string* title = space->FindString("title")) {
+          progress.space_title = *title;
+        }
+        events.push_back(std::move(progress));
+      }
+    }
+  }
+  if (options.history) {
+    ArcImportProgress history;
+    history.step = ArcImportProgress::Step::kHistory;
+    events.push_back(history);
+  }
+  return events;
+}
+
+void FixtureArcImportBackend::StartImport(
+    ImportPlan plan,
+    ArcImportOptions options,
+    ArcImportProgressCallback progress,
+    ArcImportDoneCallback done) {
+  pending_ = ProgressEvents(options);
+  next_event_ = 0;
+  progress_ = std::move(progress);
+  done_ = std::move(done);
+  SendNextProgress();
+}
+
+void FixtureArcImportBackend::RetrySignIns(
+    ArcImportProgressCallback progress,
+    ArcImportDoneCallback done) {
+  ArcImportProgress event;
+  event.step = ArcImportProgress::Step::kSignIns;
+  pending_.assign(1, std::move(event));
+  next_event_ = 0;
+  progress_ = std::move(progress);
+  done_ = std::move(done);
+  SendNextProgress();
+}
+
+void FixtureArcImportBackend::SendNextProgress() {
+  if (next_event_ >= pending_.size()) {
+    ArcImportDoneCallback done = std::move(done_);
+    progress_.Reset();
+    timer_.Stop();
+    std::move(done).Run(result_);
+    return;
+  }
+  progress_.Run(pending_[next_event_++]);
+  timer_.Start(FROM_HERE, progress_interval_, this,
+               &FixtureArcImportBackend::SendNextProgress);
+}
+
+void FixtureArcImportBackend::UndoImport(
+    base::OnceCallback<void(ArcUndoResult)> done) {
+  if (undo_result_ == ArcUndoResult::kUndone ||
+      undo_result_ == ArcUndoResult::kPartlyUndone) {
+    state_.undo_until.reset();
+    state_.undo_snapshot_time.reset();
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(std::move(done), undo_result_),
+      progress_interval_ * 2);
+}
+
+void FixtureArcImportBackend::OpenProfile(
+    const base::FilePath& profile_path,
+    base::OnceCallback<void(bool)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), true));
+}
+
+std::optional<DataBackups::RestoreOffer>
+FixtureArcImportBackend::GetRestoreOffer() {
+  return offer_;
+}
+
+void FixtureArcImportBackend::SetRestoreOfferChangedCallback(
+    base::RepeatingClosure changed) {
+  offer_changed_ = std::move(changed);
+  // A real offer arrives after startup; the scripted one announces itself
+  // once, shortly after the page starts listening.
+  if (offer_ && !offer_announced_) {
+    offer_announced_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&FixtureArcImportBackend::FireOfferChanged,
+                       weak_factory_.GetWeakPtr()),
+        progress_interval_);
+  }
+}
+
+void FixtureArcImportBackend::FireOfferChanged() {
+  if (offer_changed_) {
+    offer_changed_.Run();
+  }
+}
+
+void FixtureArcImportBackend::AnswerRestoreOffer(
+    bool restore,
+    base::OnceCallback<void(bool restored)> done) {
+  offer_.reset();
+  FireOfferChanged();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(std::move(done), restore),
+      progress_interval_ * 2);
+}
+
+bool FixtureArcImportBackend::IsArcRunning() {
+  return arc_running_;
+}
+
+std::unique_ptr<ArcImportBackend::QuitWait>
+FixtureArcImportBackend::WatchArcQuit(base::OnceClosure on_quit) {
+  std::optional<base::TimeDelta> delay;
+  if (!arc_running_) {
+    delay.emplace(base::Milliseconds(0));
+  } else if (arc_quit_after_set_) {
+    delay = arc_quit_after_;
+  }
+  return std::make_unique<FixtureQuitWait>(this, delay, std::move(on_quit));
+}
+
+}  // namespace rac::onboarding

+void FixtureArcImportBackend::CheckSource(
+    base::OnceCallback<void(bool exists)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), found_));
+}
+
+void FixtureArcImportBackend::ReadPlan(
+    base::OnceCallback<void(base::expected<ImportPlan, ArcReadError>)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<FixtureArcImportBackend> self,
+             base::OnceCallback<void(
+                 base::expected<ImportPlan, ArcReadError>)> done) {
+            if (!self) {
+              return;
+            }
+            if (self->read_error_) {
+              std::move(done).Run(
+                  base::unexpected(ArcReadError::kUnreadable));
+            } else {
+              std::move(done).Run(base::ok(self->plan_));
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(done)),
+      read_delay_);
+}
+
+base::DictValue FixtureArcImportBackend::PlanToPreviewValue(
+    const ImportPlan& plan) {
+  // The script's preview is already the page's dictionary, except the two
+  // fields the real backend derives: `offered` per profile (another Arc
+  // profile needs the sign-ins step to become a rac profile) and the
+  // top-level `signInsAvailable`.
+  base::DictValue preview = preview_.Clone();
+  if (base::ListValue* profiles = preview.FindList("profiles")) {
+    for (base::Value& entry : *profiles) {
+      if (base::DictValue* profile = entry.GetIfDict()) {
+        profile->Set("offered",
+                     profile->FindBool("isDefault").value_or(false) ||
+                         sign_ins_available_);
+      }
+    }
+  }
+  preview.Set("signInsAvailable", sign_ins_available_);
+  return preview;
+}
+
+void FixtureArcImportBackend::GetImportState(
+    base::OnceCallback<void(const ArcImportState&)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(std::move(done), RecordedState().value_or(state_)));
+}
+
+void FixtureArcImportBackend::GetSummary(
+    base::OnceCallback<void(const ArcImportSummary&)> done) {
+  ArcImportSummary summary;
+  summary.found = found_;
+  summary.state = RecordedState().value_or(state_);
+  if (const base::DictValue* scripted = script_.FindDict("summary")) {
+    if (const std::string* text = scripted->FindString("foundSummary")) {
+      summary.found_summary = *text;
+    }
+    if (const std::string* text = scripted->FindString("importedSummary")) {
+      summary.imported_summary = *text;
+    }
+    summary.passwords_available =
+        scripted->FindBool("passwordsAvailable").value_or(false);
+    if (const base::ListValue* spaces = scripted->FindList("spaces")) {
+      const auto stops = [](const base::DictValue& tile,
+                            std::string_view key, std::string& first,
+                            std::string& second) {
+        const base::ListValue* list = tile.FindList(key);
+        if (list && list->size() >= 2 && (*list)[0].is_string() &&
+            (*list)[1].is_string()) {
+          first = (*list)[0].GetString();
+          second = (*list)[1].GetString();
+        }
+      };
+      for (const base::Value& entry : *spaces) {
+        const base::DictValue* dict = entry.GetIfDict();
+        if (!dict) {
+          continue;
+        }
+        ArcImportSummary::Space tile;
+        if (const std::string* emoji = dict->FindString("emoji")) {
+          tile.emoji = *emoji;
+        }
+        stops(*dict, "light", tile.light1, tile.light2);
+        stops(*dict, "dark", tile.dark1, tile.dark2);
+        summary.imported_spaces.push_back(std::move(tile));
+      }
+    }
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), std::move(summary)));
+}
+
+bool FixtureArcImportBackend::SignInsAvailable() const {
+  return sign_ins_available_;
+}
+
+std::vector<ArcImportProgress> FixtureArcImportBackend::ProgressEvents(
+    const ArcImportOptions& options) const {
+  std::vector<ArcImportProgress> events;
+  if (const base::ListValue* scripted = script_.FindList("progress")) {
+    for (const base::Value& entry : *scripted) {
+      const base::DictValue* dict = entry.GetIfDict();
+      const std::string* step_name =
+          dict ? dict->FindString("step") : nullptr;
+      std::optional<ArcImportProgress::Step> step =
+          step_name ? ParseStep(*step_name) : std::nullopt;
+      if (!step) {
+        continue;
+      }
+      ArcImportProgress progress;
+      progress.step = *step;
+      progress.done = IntAt(*dict, "done");
+      progress.total = IntAt(*dict, "total");
+      if (const std::string* id = dict->FindString("spaceId")) {
+        progress.space_id = *id;
+      }
+      if (const std::string* title = dict->FindString("spaceTitle")) {
+        progress.space_title = *title;
+      }
+      events.push_back(std::move(progress));
+    }
+    return events;
+  }
+
+  ArcImportProgress snapshot;
+  snapshot.step = ArcImportProgress::Step::kSnapshot;
+  events.push_back(snapshot);
+
+  // One kSpaces per space of every checked profile, in preview order.
+  const auto is_checked = [&options](const base::DictValue* profile) {
+    const std::string* key = profile ? profile->FindString("key") : nullptr;
+    return key && !options.skipped_profile_keys.contains(*key);
+  };
+  int total = 0;
+  if (const base::ListValue* profiles = preview_.FindList("profiles")) {
+    for (const base::Value& entry : *profiles) {
+      const base::DictValue* profile = entry.GetIfDict();
+      if (!is_checked(profile)) {
+        continue;
+      }
+      if (const base::ListValue* spaces = profile->FindList("spaces")) {
+        total += static_cast<int>(spaces->size());
+      }
+    }
+    int done = 0;
+    for (const base::Value& entry : *profiles) {
+      const base::DictValue* profile = entry.GetIfDict();
+      if (!is_checked(profile)) {
+        continue;
+      }
+      const base::ListValue* spaces = profile->FindList("spaces");
+      if (!spaces) {
+        continue;
+      }
+      for (const base::Value& space_entry : *spaces) {
+        const base::DictValue* space = space_entry.GetIfDict();
+        if (!space) {
+          continue;
+        }
+        ArcImportProgress progress;
+        progress.step = ArcImportProgress::Step::kSpaces;
+        progress.done = ++done;
+        progress.total = total;
+        if (const std::string* id = space->FindString("id")) {
+          progress.space_id = *id;
+        }
+        if (const std::string* title = space->FindString("title")) {
+          progress.space_title = *title;
+        }
+        events.push_back(std::move(progress));
+      }
+    }
+  }
+  if (options.history) {
+    ArcImportProgress history;
+    history.step = ArcImportProgress::Step::kHistory;
+    events.push_back(history);
+  }
+  return events;
+}
+
+void FixtureArcImportBackend::StartImport(
+    ImportPlan plan,
+    ArcImportOptions options,
+    ArcImportProgressCallback progress,
+    ArcImportDoneCallback done) {
+  pending_ = ProgressEvents(options);
+  next_event_ = 0;
+  progress_ = std::move(progress);
+  done_ = std::move(done);
+  SendNextProgress();
+}
+
+void FixtureArcImportBackend::RetrySignIns(
+    ArcImportProgressCallback progress,
+    ArcImportDoneCallback done) {
+  ArcImportProgress event;
+  event.step = ArcImportProgress::Step::kSignIns;
+  pending_.assign(1, std::move(event));
+  next_event_ = 0;
+  progress_ = std::move(progress);
+  done_ = std::move(done);
+  SendNextProgress();
+}
+
+void FixtureArcImportBackend::SendNextProgress() {
+  if (next_event_ >= pending_.size()) {
+    ArcImportDoneCallback done = std::move(done_);
+    progress_.Reset();
+    timer_.Stop();
+    if (result_.status == ArcImportResult::Status::kDone) {
+      const base::Time now = base::Time::Now();
+      ArcImportState recorded;
+      recorded.last_import = now;
+      recorded.undo_until = result_.undo_until.value_or(now + base::Days(7));
+      recorded.undo_snapshot_time = now;
+      RecordedState() = recorded;
+    }
+    std::move(done).Run(result_);
+    return;
+  }
+  progress_.Run(pending_[next_event_++]);
+  timer_.Start(FROM_HERE, progress_interval_, this,
+               &FixtureArcImportBackend::SendNextProgress);
+}
+
+void FixtureArcImportBackend::UndoImport(
+    base::OnceCallback<void(ArcUndoResult)> done) {
+  if (undo_result_ == ArcUndoResult::kUndone ||
+      undo_result_ == ArcUndoResult::kPartlyUndone) {
+    // An undone import leaves nothing to show; a partly undone one keeps
+    // its date, like the record.
+    ArcImportState state = RecordedState().value_or(state_);
+    if (undo_result_ == ArcUndoResult::kUndone) {
+      state.last_import.reset();
+    }
+    state.undo_until.reset();
+    state.undo_snapshot_time.reset();
+    RecordedState() = state;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(std::move(done), undo_result_),
+      progress_interval_ * 2);
+}
+
+void FixtureArcImportBackend::OpenProfile(
+    const base::FilePath& profile_path,
+    base::OnceCallback<void(bool)> done) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), true));
+}
+
+const DataBackups::RestoreOffer* FixtureArcImportBackend::GetRestoreOffer() {
+  return offer_ ? &*offer_ : nullptr;
+}
+
+void FixtureArcImportBackend::SetRestoreOfferChangedCallback(
+    base::RepeatingClosure changed) {
+  offer_changed_ = std::move(changed);
+  // A real offer arrives after startup; the scripted one announces itself
+  // once, shortly after the page starts listening.
+  if (offer_ && !offer_announced_) {
+    offer_announced_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&FixtureArcImportBackend::FireOfferChanged,
+                       weak_factory_.GetWeakPtr()),
+        progress_interval_);
+  }
+}
+
+void FixtureArcImportBackend::FireOfferChanged() {
+  if (offer_changed_) {
+    offer_changed_.Run();
+  }
+}
+
+void FixtureArcImportBackend::AnswerRestoreOffer(
+    bool restore,
+    base::OnceCallback<void(bool restored)> done) {
+  offer_.reset();
+  FireOfferChanged();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(std::move(done), restore),
+      progress_interval_ * 2);
+}
+
+bool FixtureArcImportBackend::IsArcRunning() {
+  return arc_running_;
+}
+
+std::unique_ptr<ArcImportBackend::QuitWait>
+FixtureArcImportBackend::WatchArcQuit(base::OnceClosure on_quit) {
+  std::optional<base::TimeDelta> delay;
+  if (!arc_running_) {
+    delay.emplace(base::Milliseconds(0));
+  } else if (arc_quit_after_set_) {
+    delay = arc_quit_after_;
+  }
+  return std::make_unique<FixtureQuitWait>(this, delay, std::move(on_quit));
+}

+
+void ArcImportHandler::HandleWatchArcQuit(const base::ListValue& args) {
+  AllowJavascript();
+  // A second ask replaces the first wait; the page listens for one event.
+  quit_wait_ = backend_->WatchArcQuit(
+      base::BindOnce(&ArcImportHandler::OnArcQuit, weak_factory_.GetWeakPtr()));
+}
+
+void ArcImportHandler::HandleStopWatchingArcQuit(const base::ListValue& args) {
+  quit_wait_.reset();
+}
+
+void ArcImportHandler::OnArcQuit() {
+  // The wait is calling this; it goes once the call has returned.
+  if (quit_wait_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(quit_wait_));
+  }
+  FireWebUIListener("rac-arc-quit");
+}
+
+void ArcImportHandler::HandleRetrySignIns(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  quit_wait_.reset();
+  // Retry brings over only the sign-ins of this session's newest import. It
+  // doesn't wait for Arc: the page holds Retry until Arc has quit.
+  if (importing_ || !backend_->SignInsAvailable()) {
+    ArcImportResult refused;
+    refused.status = ArcImportResult::Status::kFailed;
+    if (importing_) {
+      refused.failure = ArcImportFailure::kBusy;
+    }
+    ResolveJavascriptCallback(args[0], ResultToValue(refused));
+    return;
+  }
+  importing_ = true;
+  backend_->RetrySignIns(
+      base::BindRepeating(&ArcImportHandler::OnProgress,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&ArcImportHandler::OnSignInsRetried,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ArcImportHandler::OnSignInsRetried(base::Value callback_id,
+                                        const ArcImportResult& result) {
+  importing_ = false;
+  // Only the sign-ins changed: the sidebar parts read kNothingNew, and the
+  // import record and the Settings card stay as they were.
+  ResolveJavascriptCallback(callback_id, ResultToValue(result));
+}

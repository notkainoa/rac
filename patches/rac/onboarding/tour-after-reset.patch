+class Profile;
+
+namespace rac::onboarding {
+
+// Chromium's settings reset has finished for `profile`, so the welcome tour
+// is due again: marks the tour as not finished and opens its window. It
+// changes no other pref and no profile data. Call it only once the reset has
+// succeeded; a reset the user cancels never reaches it.
+void RunTourAfterReset(Profile* profile);
+
+// Replaces what opens the tour window, so a test doesn't create one.
+void SetTourOpenerForTesting(base::RepeatingCallback<void(Profile*)> opener);
+
+}  // namespace rac::onboarding

+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_ONBOARDING_ONBOARDING_RESET_H_
+#define CHROME_BROWSER_UI_RAC_ONBOARDING_ONBOARDING_RESET_H_
+
+#include "base/functional/callback.h"
+
+class PrefService;
+
+namespace rac::onboarding {
+
+// Chromium's settings reset has finished, so the welcome tour is due again:
+// marks the tour as not finished in `prefs`, then runs `open_tour`. It
+// changes no other pref and touches no profile data. Call it only once the
+// reset has succeeded; a reset the user cancels never reaches it.
+void RunTourAfterReset(PrefService* prefs, base::OnceClosure open_tour);
+
+}  // namespace rac::onboarding
+
+#endif  // CHROME_BROWSER_UI_RAC_ONBOARDING_ONBOARDING_RESET_H_

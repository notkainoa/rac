+base::RepeatingCallback<void(Profile*)>& TourOpener() {
+  static base::NoDestructor<base::RepeatingCallback<void(Profile*)>> opener(
+      base::BindRepeating(&ShowWelcomeTour));
+  return *opener;
+}
+
+}  // namespace
+
+void RunTourAfterReset(Profile* profile) {
+  if (!profile || !profile->IsRegularProfile()) {
+    return;
+  }
+  // The tour decides whether to show at launch from this one pref, and sets
+  // it again when the user finishes.
+  profile->GetPrefs()->SetBoolean(prefs::kHeliumDidOnboarding, false);
+  TourOpener().Run(profile);
+}
+
+void SetTourOpenerForTesting(base::RepeatingCallback<void(Profile*)> opener) {
+  TourOpener() = opener ? std::move(opener)
+                        : base::BindRepeating(&ShowWelcomeTour);
+}
+
+}  // namespace rac::onboarding

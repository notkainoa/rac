+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/onboarding/onboarding_reset.h"
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/ui/rac/onboarding/onboarding_prefs.h"
+#include "components/helium_services/pref_names.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::onboarding {
+
+namespace {
+
+class OnboardingResetTest : public testing::Test {
+ public:
+  OnboardingResetTest() {
+    prefs_.registry()->RegisterBooleanPref(prefs::kHeliumDidOnboarding, false);
+    prefs_.registry()->RegisterBooleanPref(prefs::kHeliumServicesConsented,
+                                           false);
+    RegisterProfilePrefs(prefs_.registry());
+  }
+
+  TestingPrefServiceSimple prefs_;
+};
+
+TEST_F(OnboardingResetTest, MarksTheTourNotFinishedAndOpensIt) {
+  prefs_.SetBoolean(prefs::kHeliumDidOnboarding, true);
+  int opened = 0;
+
+  RunTourAfterReset(&prefs_, base::BindOnce([](int* n) { ++*n; }, &opened));
+
+  EXPECT_FALSE(prefs_.GetBoolean(prefs::kHeliumDidOnboarding));
+  EXPECT_EQ(1, opened);
+}
+
+TEST_F(OnboardingResetTest, ChangesNoOtherPref) {
+  prefs_.SetBoolean(prefs::kHeliumDidOnboarding, true);
+  prefs_.SetBoolean(prefs::kHeliumServicesConsented, true);
+  prefs_.SetBoolean(kSkipAssistant, true);
+
+  RunTourAfterReset(&prefs_, base::DoNothing());
+
+  EXPECT_TRUE(prefs_.GetBoolean(prefs::kHeliumServicesConsented));
+  EXPECT_TRUE(prefs_.GetBoolean(kSkipAssistant));
+}
+
+TEST_F(OnboardingResetTest, TheTourPrefIsSetBeforeTheWindowOpens) {
+  prefs_.SetBoolean(prefs::kHeliumDidOnboarding, true);
+  bool pref_when_opened = true;
+
+  RunTourAfterReset(
+      &prefs_, base::BindOnce(
+                   [](PrefService* prefs, bool* out) {
+                     *out = prefs->GetBoolean(prefs::kHeliumDidOnboarding);
+                   },
+                   &prefs_, &pref_when_opened));
+
+  EXPECT_FALSE(pref_when_opened);
+}
+
+}  // namespace
+
+}  // namespace rac::onboarding

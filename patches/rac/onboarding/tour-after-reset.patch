+
+namespace rac::onboarding {
+
+void RunTourAfterReset(PrefService* prefs, base::OnceClosure open_tour) {
+  // The tour decides whether to show at launch from this one pref, and sets
+  // it again when the user finishes.
+  prefs->SetBoolean(prefs::kHeliumDidOnboarding, false);
+  std::move(open_tour).Run();
+}
+
+}  // namespace rac::onboarding

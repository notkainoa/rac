+// A resetter that holds its callback until the test says the reset is done.
+class DeferredResetter : public FakeProfileResetter {
+ public:
+  explicit DeferredResetter(TestingProfile* profile)
+      : FakeProfileResetter(profile) {}
+
+  void ResetSettings(ResettableFlags,
+                     std::unique_ptr<BrandcodedDefaultSettings>,
+                     base::OnceClosure callback) override {
+    done_ = std::move(callback);
+  }
+
+  void Finish() { std::move(done_).Run(); }
+
+ private:
+  base::OnceClosure done_;
+};
+
+class DeferredResetSettingsHandler : public ResetSettingsHandler {
+ public:
+  DeferredResetSettingsHandler(TestingProfile* profile, content::WebUI* web_ui)
+      : ResetSettingsHandler(profile), resetter_(profile) {
+    set_web_ui(web_ui);
+  }
+
+  DeferredResetter* deferred() { return &resetter_; }
+
+  using settings::ResetSettingsHandler::HandleResetProfileSettings;
+
+ protected:
+  ProfileResetter* GetResetter() override { return &resetter_; }
+
+ private:
+  DeferredResetter resetter_;
+};
+
+base::ListValue ResetArgs() {
+  base::ListValue list;
+  list.Append("dummyCallbackId");
+  list.Append(false);
+  list.Append("");
+  return list;
+}
+
+// rac: a finished reset sends the user back through the welcome tour.
+TEST_F(ResetSettingsHandlerTest, ResetRunsTheTourAgain) {
+  profile()->GetPrefs()->SetBoolean(prefs::kHeliumDidOnboarding, true);
+  profile()->GetPrefs()->SetBoolean(rac::onboarding::kSkipAssistant, true);
+  int opened = 0;
+  Profile* opened_for = nullptr;
+  rac::onboarding::SetTourOpenerForTesting(
+      base::BindLambdaForTesting([&](Profile* p) {
+        ++opened;
+        opened_for = p;
+      }));
+
+  handler()->HandleResetProfileSettings(ResetArgs());
+
+  EXPECT_FALSE(profile()->GetPrefs()->GetBoolean(prefs::kHeliumDidOnboarding));
+  EXPECT_EQ(1, opened);
+  EXPECT_EQ(profile(), opened_for);
+  // Nothing beyond the tour pref changes.
+  EXPECT_TRUE(
+      profile()->GetPrefs()->GetBoolean(rac::onboarding::kSkipAssistant));
+  rac::onboarding::SetTourOpenerForTesting(base::NullCallback());
+}
+
+// The tour waits for the reset to finish, and a reset that never starts (the
+// user cancels the dialog) changes nothing.
+TEST_F(ResetSettingsHandlerTest, TourWaitsForTheResetToFinish) {
+  profile()->GetPrefs()->SetBoolean(prefs::kHeliumDidOnboarding, true);
+  int opened = 0;
+  rac::onboarding::SetTourOpenerForTesting(
+      base::BindLambdaForTesting([&](Profile*) { ++opened; }));
+  DeferredResetSettingsHandler deferred_handler(profile(), web_ui());
+
+  // Cancelled: the handler is never asked to reset.
+  EXPECT_TRUE(profile()->GetPrefs()->GetBoolean(prefs::kHeliumDidOnboarding));
+  EXPECT_EQ(0, opened);
+
+  // Asked, but Chromium's reset has not finished.
+  deferred_handler.HandleResetProfileSettings(ResetArgs());
+  EXPECT_TRUE(profile()->GetPrefs()->GetBoolean(prefs::kHeliumDidOnboarding));
+  EXPECT_EQ(0, opened);
+
+  deferred_handler.deferred()->Finish();
+  EXPECT_FALSE(profile()->GetPrefs()->GetBoolean(prefs::kHeliumDidOnboarding));
+  EXPECT_EQ(1, opened);
+  rac::onboarding::SetTourOpenerForTesting(base::NullCallback());
+}

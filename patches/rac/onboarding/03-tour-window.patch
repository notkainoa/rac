+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "ui/base/base_window.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/controls/webview/unhandled_keyboard_event_handler.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/layout/fill_layout.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+#include "url/gurl.h"
+
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/ui/views/rac/onboarding/onboarding_native_widget_mac.h"
+#endif
+
+namespace rac::onboarding {
+
+namespace {
+
+constexpr gfx::Size kMinimumSize(720, 540);
+constexpr gfx::Size kDefaultSize(1100, 760);
+
+// The page tells its window mode from the query, see app.ts.
+constexpr char kTourUrl[] = "chrome://setup/?tour";
+constexpr char kAssistantSettingsUrl[] = "chrome://settings/assistant";
+
+class TourWindow;
+TourWindow* g_tour = nullptr;
+
+// The window's content: the page, filling it.
+class TourView : public views::View {
+  METADATA_HEADER(TourView, views::View)
+
+ public:
+  explicit TourView(Profile* profile) {
+    SetLayoutManager(std::make_unique<views::FillLayout>());
+    web_view_ = AddChildView(std::make_unique<views::WebView>(profile));
+    web_view_->set_allow_accelerators(true);
+    web_view_->LoadInitialURL(GURL(kTourUrl));
+  }
+  TourView(const TourView&) = delete;
+  TourView& operator=(const TourView&) = delete;
+  ~TourView() override = default;
+
+  // views::View:
+  gfx::Size GetMinimumSize() const override { return kMinimumSize; }
+
+  views::WebView* web_view() { return web_view_; }
+
+ private:
+  raw_ptr<views::WebView> web_view_ = nullptr;
+};
+
+BEGIN_METADATA(TourView)
+END_METADATA
+
+// Owns the widget and its content, and is the page's WebContentsDelegate:
+// links open in a browser window, and closing the page closes the window.
+// Deletes itself when the window closes.
+class TourWindow : public content::WebContentsDelegate {
+ public:
+  TourWindow(Profile* profile, const gfx::Rect& bounds)
+      : profile_(profile),
+        delegate_(std::make_unique<views::WidgetDelegate>()) {
+    CHECK(!g_tour);
+    g_tour = this;
+
+    delegate_->SetHasWindowSizeControls(true);
+    delegate_->SetTitle(u"Welcome to rac");
+    delegate_->SetShowTitle(false);
+    view_ = delegate_->SetContentsView(std::make_unique<TourView>(profile));
+
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW);
+    // The widget keeps a raw pointer to the delegate; `delegate_` owns it.
+    params.delegate = delegate_.get();
+    params.bounds = bounds;
+    widget_ = std::make_unique<views::Widget>();
+#if BUILDFLAG(IS_MAC)
+    params.native_widget = new OnboardingNativeWidgetMac(widget_.get());
+#endif
+    widget_->Init(std::move(params));
+    widget_->MakeCloseSynchronous(
+        base::BindOnce(&TourWindow::OnCloseRequested, base::Unretained(this)));
+    web_contents()->SetDelegate(this);
+    widget_->Show();
+  }
+  TourWindow(const TourWindow&) = delete;
+  TourWindow& operator=(const TourWindow&) = delete;
+
+  ~TourWindow() override {
+    if (content::WebContents* contents = web_contents()) {
+      contents->SetDelegate(nullptr);
+    }
+    // `widget_` goes before `delegate_`, which it points at.
+    widget_.reset();
+    g_tour = nullptr;
+  }
+
+  content::WebContents* web_contents() {
+    return view_->web_view()->GetWebContents();
+  }
+
+  void Activate() { widget_->Activate(); }
+
+  void Close() {
+    widget_->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+  }
+
+  void OpenInBrowser(const GURL& url) {
+    NavigateParams nav(profile_, url, ui::PAGE_TRANSITION_LINK);
+    nav.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&nav);
+  }
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    OpenInBrowser(params.url);
+    return nullptr;
+  }
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override {
+    // Links with target=_blank, such as Helium's policies.
+    OpenInBrowser(target_url);
+    return nullptr;
+  }
+  void CloseContents(content::WebContents* source) override { Close(); }
+  bool HandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    return keyboard_handler_.HandleKeyboardEvent(event,
+                                                 view_->GetFocusManager());
+  }
+
+ private:
+  // The red button, Cmd+W, or the page closing itself. The widget stays
+  // until the next turn, since this can run inside the page's own call.
+  void OnCloseRequested(views::Widget::ClosedReason reason) {
+    if (closing_) {
+      return;
+    }
+    closing_ = true;
+    widget_->Hide();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  const raw_ptr<Profile> profile_;
+  std::unique_ptr<views::WidgetDelegate> delegate_;
+  // Owned by `delegate_`.
+  raw_ptr<TourView> view_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+  views::UnhandledKeyboardEventHandler keyboard_handler_;
+  bool closing_ = false;
+};
+
+// The profile's last active browser window's bounds, so the tour covers it
+// exactly; otherwise a centered default.
+gfx::Rect TourBounds(Profile* profile) {
+  if (ProfileBrowserCollection* collection =
+          ProfileBrowserCollection::GetForProfile(profile)) {
+    if (BrowserWindowInterface* browser = collection->GetLastActiveBrowser()) {
+      if (ui::BaseWindow* window = browser->GetWindow()) {
+        const gfx::Rect bounds = window->GetBounds();
+        if (!bounds.IsEmpty()) {
+          return bounds;
+        }
+      }
+    }
+  }
+  gfx::Rect bounds(kDefaultSize);
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetPrimaryDisplay().work_area();
+  bounds.set_x(work_area.x() + (work_area.width() - bounds.width()) / 2);
+  bounds.set_y(work_area.y() + (work_area.height() - bounds.height()) / 2);
+  return bounds;
+}
+
+// Waits for the profile's first browser window, then shows the tour over it.
+class WindowWaiter : public BrowserCollectionObserver {
+ public:
+  explicit WindowWaiter(Profile* profile) : profile_(profile) {
+    observation_.Observe(ProfileBrowserCollection::GetForProfile(profile));
+  }
+  WindowWaiter(const WindowWaiter&) = delete;
+  WindowWaiter& operator=(const WindowWaiter&) = delete;
+  ~WindowWaiter() override = default;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    if (browser->GetProfile() != profile_) {
+      return;
+    }
+    observation_.Reset();
+    // The window has its bounds by the next turn.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ShowWelcomeTour, profile_));
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+ private:
+  const raw_ptr<Profile> profile_;
+  base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+};
+
+}  // namespace
+
+void ShowWelcomeTour(Profile* profile) {
+  if (g_tour) {
+    g_tour->Activate();
+    return;
+  }
+  // Self-owned; deleted when its window closes.
+  new TourWindow(profile, TourBounds(profile));
+}
+
+void ShowWelcomeTourWhenWindowOpens(Profile* profile) {
+  if (g_tour) {
+    return;
+  }
+  ProfileBrowserCollection* collection =
+      ProfileBrowserCollection::GetForProfile(profile);
+  if (collection && collection->GetLastActiveBrowser()) {
+    ShowWelcomeTour(profile);
+    return;
+  }
+  if (!collection) {
+    return;
+  }
+  // Self-owned; deleted once it has shown the tour.
+  new WindowWaiter(profile);
+}
+
+bool FinishWelcomeTour(content::WebContents* web_contents,
+                       bool open_assistant_settings) {
+  if (!g_tour || g_tour->web_contents() != web_contents) {
+    return false;
+  }
+  if (open_assistant_settings) {
+    g_tour->OpenInBrowser(GURL(kAssistantSettingsUrl));
+  }
+  g_tour->Close();
+  return true;
+}
+
+}  // namespace rac::onboarding

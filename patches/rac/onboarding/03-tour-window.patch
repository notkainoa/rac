+// assistant settings in a browser window when asked, closes the tour window,
+// and returns true. Returns false when the page runs in an ordinary tab,
+// which then navigates itself.
+bool FinishWelcomeTour(content::WebContents* web_contents,
+                       bool open_assistant_settings);
+

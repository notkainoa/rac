+
+export interface ArcState {
+  /** Arc is on this Mac. One stat, no parse. */
+  found: boolean;
+  status: ArcImportStatus;
+  /** Localized day of the last Arc import into this profile, or null. */
+  importedAt: string|null;
+  /** Localized last day Undo works, or null. */
+  undoUntil: string|null;
+  /** Localized day the sidebar goes back to on Undo, or null. */
+  undoSnapshot: string|null;
+  /** 'undone' only: localized day of the Undo, or null if not recorded. */
+  undoneAt: string|null;
+  /** The sign-ins step exists (plan 04 M2). */
+  signInsAvailable: boolean;
+}
+
+export interface ArcFavorite {
+  /** One letter for the tile; the preview never shows an icon. */
+  letter: string;
+  title: string;
+}
+
+export interface ArcSpace extends SpaceTile {
+  id: string;
+  pinned: number;
+  folders: number;
+  openTabs: number;
+}
+
+export interface ArcProfile {
+  key: string;
+  /** Localized, with the fallback already applied. */
+  name: string;
+  isDefault: boolean;
+  /**
+   * False for an Arc profile other than the default one while rac can't
+   * make it a profile of its own yet. It stays in Arc.
+   */
+  offered: boolean;
+  favorites: ArcFavorite[];
+  spaces: ArcSpace[];
+}
+
+export interface ArcPreview {
+  profiles: ArcProfile[];
+  openTabs: number;
+  signInsAvailable: boolean;
+}
+
+export type ArcReadResult = {preview: ArcPreview}|{error: true};
+
+export interface ArcImportOptions {
+  skippedProfileKeys: string[];
+  openTabs: boolean;
+  history: boolean;
+  signIns: boolean;
+}
+

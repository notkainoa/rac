+
+/** [first stop, second stop], as the space's theme paints them. */
+export type Stops = [string, string];
+
+/** A space's icon on its colors, as the space switcher shows it. */
+export interface SpaceTile {
+  title: string;
+  /** May be empty: the tile shows the switcher's dot. */
+  emoji: string;
+  light: Stops;
+  dark: Stops;
+}
+

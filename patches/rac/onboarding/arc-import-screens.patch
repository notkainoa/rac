+}
+
+export function stopListening(listener: WebUiListener) {
+  removeWebUiListener(listener);
+}
+
+export function undoArcImport(): Promise<UndoOutcome> {
+  return sendWithPromise('racArcImportUndo');
+}
+
+export function getRestoreOffer(): Promise<RestoreOffer|null> {
+  return sendWithPromise('racRestoreGetOffer');
+}
+
+/**
+ * The offer as it changes: it can arrive after the page asked, lapse, or be
+ * answered elsewhere. `null` once there's none.
+ */
+export function onRestoreOfferChanged(
+    listener: (offer: RestoreOffer|null) => void): WebUiListener {
+  return addWebUiListener('rac-restore-offer-changed', listener);
+}
+
+/**
+ * Restore or don’t; either answers the offer for good. Resolves true
+ * once the spaces are back. A restore that fails keeps the offer.
+ */
+export function answerRestoreOffer(restore: boolean): Promise<boolean> {
+  return sendWithPromise('racRestoreAnswer', restore);
+}

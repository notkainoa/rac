+export function getArcState(): Promise<ArcState> {
+  return sendWithPromise('racArcImportGetState');
+}
+
+/** Reads Arc on a background sequence. */
+export function readArc(): Promise<ArcReadResult> {
+  return sendWithPromise('racArcImportRead');
+}
+
+/** Resolves once everything has ended, history included. */
+export function startArcImport(options: ArcImportOptions):
+    Promise<ArcResult> {
+  return sendWithPromise('racArcImportStart', options);
+}
+
+export function onArcProgress(listener: (progress: ArcProgress) => void):
+    WebUiListener {

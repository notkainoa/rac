+  status: 'done'|'nothingNew'|'failed';
+  /** Failed because another import, Undo, or restore was running. */
+  busy: boolean;
+  spaces: number;
+  pinnedTabs: number;
+  favorites: number;
+  openTabs: number;
+  folders: number;
+  nestedFolders: number;
+  firstFlattenedName: string;
+  splitViews: number;
+  tabGroups: number;
+  skippedLiveFolders: number;
+  skippedEasels: number;
+  skippedNotes: number;
+  /** Left out as unreadable: damage in Arc's files and broken URLs. */
+  damaged: number;
+  history: 'imported'|'failed'|'none';
+  pinnedExtensions: number;
+  handoffsSaved: boolean;
+  /** Localized, or empty when nothing can be undone. */
+  undoUntil: string;
+  tiles: SpaceTile[];
+  newProfiles: Array<{name: string, spaces: number}>;
+}
+
+export interface RestoreOffer {
+  /** Localized "Monday, October 26 at 9:14 PM". */
+  created: string;
+  spaces: number;
+  pinnedTabs: number;
+  favorites: number;
+  /** May be empty: the prompt then shows only the counts. */
+  tiles: SpaceTile[];
+}

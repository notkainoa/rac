@@ -0,0 +1,44 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_ONBOARDING_ONBOARDING_HANDLER_H_
+#define CHROME_BROWSER_UI_RAC_ONBOARDING_ONBOARDING_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+class Profile;
+
+namespace rac::onboarding {
+
+// The rac half of the welcome tour (chrome://setup). Helium's
+// OnboardingMessageHandler keeps serving the helium.* prefs and the services
+// consent; this one reads and writes rac's own choices: the window layout,
+// the first space's theme, and whether the assistant is on. It sets prefs
+// only. With the assistant off it never touches any AI code.
+class OnboardingHandler : public content::WebUIMessageHandler {
+ public:
+  explicit OnboardingHandler(Profile* profile);
+  OnboardingHandler(const OnboardingHandler&) = delete;
+  OnboardingHandler& operator=(const OnboardingHandler&) = delete;
+  ~OnboardingHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  base::DictValue GetState() const;
+
+  void HandleGetState(const base::ListValue& args);
+  void HandleSetLayout(const base::ListValue& args);
+  void HandleSetTheme(const base::ListValue& args);
+  void HandleSetAssistant(const base::ListValue& args);
+
+  const raw_ptr<Profile> profile_;
+};
+
+}  // namespace rac::onboarding
+
+#endif  // CHROME_BROWSER_UI_RAC_ONBOARDING_ONBOARDING_HANDLER_H_

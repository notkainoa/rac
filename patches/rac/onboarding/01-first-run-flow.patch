--- /dev/null
+++ src/chrome/browser/ui/rac/onboarding/onboarding_handler.cc
@@ -0,0 +1,151 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/onboarding/onboarding_handler.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/ai/ai_prefs.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "chrome/browser/rac/spaces/spaces_service.h"
+#include "chrome/browser/rac/spaces/spaces_service_factory.h"
+#include "chrome/browser/ui/rac/layout_prefs.h"
+#include "chrome/browser/ui/rac/onboarding/onboarding_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_ui.h"
+
+namespace rac::onboarding {
+
+namespace {
+
+// The preset whose light stops a space's theme has, if any. A custom theme
+// (none today, but the model allows one) matches nothing.
+std::optional<size_t> PresetIndex(const SpaceTheme& theme) {
+  for (size_t i = 0; i < SpaceTheme::kPresetCount; ++i) {
+    const SpaceTheme preset = SpaceTheme::Preset(i);
+    if (theme.color1 == preset.color1 && theme.color2 == preset.color2) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+// The space the tour themes: the profile's first space. On a first run it's
+// the only one.
+const Space* FirstSpace(SpacesService* spaces) {
+  if (!spaces || spaces->spaces().empty()) {
+    return nullptr;
+  }
+  return &spaces->spaces().front();
+}
+
+base::ListValue Pair(std::string_view first, std::string_view second) {
+  base::ListValue pair;
+  pair.Append(std::string(first));
+  pair.Append(std::string(second));
+  return pair;
+}
+
+}  // namespace
+
+OnboardingHandler::OnboardingHandler(Profile* profile) : profile_(profile) {}
+
+OnboardingHandler::~OnboardingHandler() = default;
+
+void OnboardingHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "racOnboardingGetState",
+      base::BindRepeating(&OnboardingHandler::HandleGetState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racOnboardingSetLayout",
+      base::BindRepeating(&OnboardingHandler::HandleSetLayout,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racOnboardingSetTheme",
+      base::BindRepeating(&OnboardingHandler::HandleSetTheme,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "racOnboardingSetAssistant",
+      base::BindRepeating(&OnboardingHandler::HandleSetAssistant,
+                          base::Unretained(this)));
+}
+
+base::DictValue OnboardingHandler::GetState() const {
+  const PrefService* prefs = profile_->GetPrefs();
+  base::DictValue state;
+  state.Set("layout", std::to_underlying(GetLayout(prefs)));
+
+  base::ListValue themes;
+  for (size_t i = 0; i < SpaceTheme::kPresetCount; ++i) {
+    const SpaceTheme preset = SpaceTheme::Preset(i);
+    const auto [dark1, dark2] = preset.GetStops(/*dark=*/true);
+    base::DictValue theme;
+    theme.Set("name", std::u16string(SpaceTheme::PresetName(i)));
+    theme.Set("swatch", std::string(SpaceTheme::PresetSwatch(i)));
+    theme.Set("light", Pair(preset.color1, preset.color2));
+    theme.Set("dark", Pair(dark1, dark2));
+    themes.Append(std::move(theme));
+  }
+  state.Set("themes", std::move(themes));
+
+  int theme = -1;
+  if (const Space* space =
+          FirstSpace(SpacesServiceFactory::GetForProfile(profile_))) {
+    theme = static_cast<int>(PresetIndex(space->theme).value_or(-1));
+  }
+  state.Set("theme", theme);
+
+  state.Set("assistantEnabled", ai::IsAiEnabled(prefs));
+  state.Set("skipAssistant", prefs->GetBoolean(kSkipAssistant));
+  return state;
+}
+
+void OnboardingHandler::HandleGetState(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], GetState());
+}
+
+void OnboardingHandler::HandleSetLayout(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  const std::optional<int> layout = args[0].GetIfInt();
+  if (layout != std::to_underlying(Layout::kSidebar) &&
+      layout != std::to_underlying(Layout::kTopBar)) {
+    return;
+  }
+  profile_->GetPrefs()->SetInteger(kLayout, *layout);
+}
+
+void OnboardingHandler::HandleSetTheme(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  const std::optional<int> preset = args[0].GetIfInt();
+  if (!preset || *preset < 0 ||
+      static_cast<size_t>(*preset) >= SpaceTheme::kPresetCount) {
+    return;
+  }
+  SpacesService* spaces = SpacesServiceFactory::GetForProfile(profile_);
+  if (const Space* space = FirstSpace(spaces)) {
+    spaces->SetSpaceThemePreset(space->id, static_cast<size_t>(*preset));
+  }
+}
+
+void OnboardingHandler::HandleSetAssistant(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  const std::optional<bool> enabled = args[0].GetIfBool();
+  const std::optional<bool> skip = args[1].GetIfBool();
+  if (!enabled || !skip) {
+    return;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  prefs->SetBoolean(ai::kEnabled, *enabled);
+  prefs->SetBoolean(kSkipAssistant, *skip);
+}
+
+}  // namespace rac::onboarding

+++ src/chrome/browser/resources/rac_onboarding/app.css
@@ -0,0 +1,656 @@
+/* Copyright 2026 The rac Authors
+ * You can use, redistribute, and/or modify this source code under
+ * the terms of the GPL-3.0 license that can be found in the LICENSE file.
+ *
+ * The welcome tour. One column, Dia's measurements (15px body, 10px cards,
+ * pill buttons), the system font, and the space wash behind everything,
+ * painted the way the window paints it. */
+
+:root {
+  color-scheme: light dark;
+  --text: light-dark(rgb(0 0 0 / 88%), rgb(255 255 255 / 90%));
+  --text-muted: light-dark(rgb(0 0 0 / 58%), rgb(255 255 255 / 62%));
+  --text-faint: light-dark(rgb(0 0 0 / 36%), rgb(255 255 255 / 40%));
+  --card: light-dark(rgb(255 255 255 / 72%), rgb(255 255 255 / 7%));
+  --card-hover: light-dark(rgb(255 255 255 / 92%), rgb(255 255 255 / 11%));
+  --hairline: light-dark(rgb(0 0 0 / 9%), rgb(255 255 255 / 12%));
+  --ink: light-dark(#1d1d1f, #f5f5f7);
+  --ink-text: light-dark(#fff, #111);
+  --track: light-dark(rgb(0 0 0 / 14%), rgb(255 255 255 / 20%));
+  --radius-card: 14px;
+  --column: 580px;
+  --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
+  --screen-in: 220ms;
+  --screen-out: 140ms;
+  font: 15px/1.5 system-ui, -apple-system, sans-serif;
+  font-synthesis: none;
+  -webkit-font-smoothing: antialiased;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html,
+body {
+  color: var(--text);
+  height: 100%;
+  margin: 0;
+}
+
+/* The space wash: the window's base, then the theme's two stops at the
+ * tint's alpha (see space_tint_background.cc). Neutral paints flat. */
+.wash {
+  --base: light-dark(#fff, #1c1a1f);
+  --stop-1: transparent;
+  --stop-2: transparent;
+  --tint: 30%;
+  background:
+      linear-gradient(to bottom right,
+          color-mix(in srgb, var(--stop-1) var(--tint), transparent),
+          color-mix(in srgb, var(--stop-2) var(--tint), transparent)),
+      var(--base);
+  inset: 0;
+  position: fixed;
+  transition: background 320ms var(--ease);
+  z-index: -1;
+}
+
+.wash.neutral {
+  --base: light-dark(#e6e6e6, #181818);
+  --stop-1: transparent;
+  --stop-2: transparent;
+}
+
+@media (prefers-color-scheme: dark) {
+  .wash {
+    --tint: 18%;
+  }
+}
+
+.app {
+  display: grid;
+  grid-template-rows: auto 1fr auto;
+  height: 100%;
+  margin: 0 auto;
+  max-width: var(--column);
+  padding: 16px 28px 24px;
+}
+
+.top {
+  align-items: center;
+  display: flex;
+  height: 36px;
+}
+
+.screens {
+  display: grid;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 24px 0;
+  position: relative;
+}
+
+/* Only the active screen takes up room; the others sit on top of it,
+ * invisible, so the page is as tall as the step it's on. */
+.screen {
+  display: flex;
+  flex-direction: column;
+  grid-area: 1 / 1;
+  inset: 24px 0;
+  justify-content: center;
+  pointer-events: none;
+  position: absolute;
+  opacity: 0;
+  transform: translateY(10px);
+  transition:
+      opacity var(--screen-out) ease,
+      transform var(--screen-out) ease,
+      visibility 0s var(--screen-out);
+  visibility: hidden;
+}
+
+.screen.active {
+  opacity: 1;
+  pointer-events: auto;
+  position: static;
+  transform: none;
+  transition:
+      opacity var(--screen-in) var(--ease) 60ms,
+      transform var(--screen-in) var(--ease) 60ms,
+      visibility 0s;
+  visibility: visible;
+}
+
+.logo {
+  border-radius: 16px;
+  display: block;
+  height: 64px;
+  margin-bottom: 24px;
+  width: 64px;
+}
+
+h1 {
+  outline: none;
+  font-size: 30px;
+  font-weight: 650;
+  letter-spacing: -0.02em;
+  line-height: 1.15;
+  margin: 0 0 10px;
+}
+
+.lead {
+  color: var(--text-muted);
+  font-size: 16px;
+  margin: 0 0 24px;
+  max-width: 48ch;
+}
+
+.caption,
+.fine {
+  color: var(--text-faint);
+  font-size: 13px;
+  margin: 12px 0 0;
+  min-height: 1.5em;
+}
+
+.fine a {
+  color: var(--text-muted);
+}
+
+.badge {
+  background: var(--card);
+  border: 1px solid var(--hairline);
+  border-radius: 999px;
+  color: var(--text-muted);
+  display: inline-block;
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  margin: 0 0 14px;
+  padding: 3px 10px;
+  width: fit-content;
+}
+
+/* Buttons */
+
+button {
+  color: inherit;
+  cursor: pointer;
+  font: inherit;
+}
+
+button:focus-visible,
+input:focus-visible,
+a:focus-visible,
+label:has(input:focus-visible) {
+  outline: 2px solid var(--ink);
+  outline-offset: 2px;
+}
+
+.primary-button {
+  background: var(--ink);
+  border: 0;
+  border-radius: 999px;
+  color: var(--ink-text);
+  font-weight: 600;
+  min-width: 128px;
+  padding: 10px 22px;
+  transition: transform 120ms var(--ease), opacity 120ms ease;
+}
+
+.primary-button:hover {
+  opacity: 0.9;
+}
+
+.primary-button:active {
+  transform: scale(0.98);
+}
+
+.primary-button:disabled {
+  cursor: default;
+  opacity: 0.45;
+}
+
+.text-button {
+  align-items: center;
+  background: transparent;
+  border: 0;
+  border-radius: 999px;
+  color: var(--text-muted);
+  display: inline-flex;
+  gap: 4px;
+  padding: 8px 12px;
+}
+
+.text-button:hover {
+  background: var(--card);
+  color: var(--text);
+}
+
+.text-button svg {
+  fill: none;
+  height: 16px;
+  stroke: currentcolor;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 1.8;
+  width: 16px;
+}
+
+.back {
+  margin-left: -12px;
+}
+
+/* Choice cards */
+
+.choices {
+  display: grid;
+  gap: 12px;
+}
+
+.choices.two {
+  grid-template-columns: 1fr 1fr;
+}
+
+.choice {
+  background: var(--card);
+  border: 1px solid var(--hairline);
+  border-radius: var(--radius-card);
+  box-shadow: 0 0 0 0 var(--ink);
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 14px;
+  text-align: left;
+  transition:
+      background 120ms ease,
+      box-shadow 160ms var(--ease),
+      transform 160ms var(--ease);
+}
+
+.choice:hover {
+  background: var(--card-hover);
+}
+
+.choice:active {
+  transform: scale(0.99);
+}
+
+.choice[aria-checked='true'] {
+  border-color: transparent;
+  box-shadow: 0 0 0 2px var(--ink);
+}
+
+.choice strong {
+  font-weight: 600;
+}
+
+.choice span {
+  color: var(--text-muted);
+  font-size: 13px;
+}
+
+.choice.row {
+  padding: 12px 16px;
+}
+
+/* A tiny browser window, painted with the chosen space color. Sizes are
+ * explicit: the mock sits inside a <button>, which doesn't stretch flex
+ * children reliably. */
+
+.mock {
+  --page: light-dark(#fff, rgb(255 255 255 / 10%));
+  --pill: light-dark(rgb(0 0 0 / 10%), rgb(255 255 255 / 26%));
+  --tab: light-dark(rgb(0 0 0 / 9%), rgb(255 255 255 / 14%));
+  background:
+      linear-gradient(to bottom right,
+          color-mix(in srgb, var(--stop-1) var(--tint), transparent),
+          color-mix(in srgb, var(--stop-2) var(--tint), transparent)),
+      var(--base);
+  border: 1px solid var(--hairline);
+  border-radius: 10px;
+  display: block;
+  height: 140px;
+  margin-bottom: 12px;
+  overflow: hidden;
+  width: 100%;
+}
+
+.mock-bar {
+  align-items: center;
+  display: flex;
+  gap: 4px;
+  height: 22px;
+  padding: 0 8px;
+  width: 100%;
+}
+
+.mock-body {
+  display: flex;
+  gap: 6px;
+  height: 116px;
+  padding: 0 6px 6px;
+  width: 100%;
+}
+
+.mock.side .mock-body {
+  height: 138px;
+  padding-top: 6px;
+}
+
+.mock-side {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  height: 100%;
+  width: 30%;
+}
+
+.mock-lights {
+  display: flex;
+  gap: 4px;
+  padding: 2px 2px 3px;
+}
+
+.mock i {
+  background: var(--tab);
+  border-radius: 50%;
+  display: block;
+  flex: none;
+  height: 6px;
+  width: 6px;
+}
+
+.mock b {
+  background: var(--pill);
+  border-radius: 999px;
+  display: block;
+  flex: none;
+  height: 10px;
+  opacity: 0.9;
+}
+
+.mock-bar b {
+  flex: 1;
+  margin: 0 18%;
+}
+
+.mock-side b {
+  margin-bottom: 2px;
+  width: 100%;
+}
+
+.mock s {
+  background: var(--tab);
+  border-radius: 4px;
+  display: block;
+  flex: none;
+  height: 8px;
+  text-decoration: none;
+  width: 100%;
+}
+
+.mock-page {
+  background: var(--page);
+  border-radius: 6px;
+  flex: 1;
+  height: 100%;
+}
+
+/* Swatches */
+
+.swatches {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+  margin-top: 4px;
+}
+
+.swatch {
+  background: var(--swatch);
+  border: 0;
+  border-radius: 50%;
+  box-shadow: inset 0 0 0 1px rgb(0 0 0 / 10%);
+  height: 40px;
+  padding: 0;
+  position: relative;
+  transition: transform 160ms var(--ease);
+  width: 40px;
+}
+
+.swatch:hover {
+  transform: scale(1.08);
+}
+
+.swatch::after {
+  border: 2px solid var(--ink);
+  border-radius: 50%;
+  content: '';
+  inset: -6px;
+  opacity: 0;
+  position: absolute;
+  transform: scale(0.85);
+  transition: opacity 160ms ease, transform 160ms var(--ease);
+}
+
+.swatch[aria-checked='true']::after {
+  opacity: 1;
+  transform: none;
+}
+
+/* Lists and toggles */
+
+.list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.list h2 {
+  color: var(--text-muted);
+  font-size: 13px;
+  font-weight: 600;
+  margin: 10px 0 2px;
+}
+
+.list h2:first-child {
+  margin-top: 0;
+}
+
+.check {
+  align-items: center;
+  background: var(--card);
+  border: 1px solid var(--hairline);
+  border-radius: 12px;
+  cursor: pointer;
+  display: flex;
+  gap: 12px;
+  padding: 10px 14px;
+}
+
+.check:hover {
+  background: var(--card-hover);
+}
+
+.check input {
+  accent-color: var(--ink);
+  height: 16px;
+  margin: 0;
+  width: 16px;
+}
+
+.check .toggle-text {
+  flex: 1;
+}
+
+.check .state {
+  color: var(--text-faint);
+  font-size: 13px;
+}
+
+.toggles {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.toggle {
+  align-items: center;
+  background: var(--card);
+  border: 1px solid var(--hairline);
+  border-radius: 12px;
+  cursor: pointer;
+  display: flex;
+  gap: 16px;
+  padding: 12px 14px;
+}
+
+.toggle.master {
+  border-radius: var(--radius-card);
+}
+
+.toggle-group {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  transition: opacity 160ms ease;
+}
+
+.toggle-group.off {
+  opacity: 0.45;
+  pointer-events: none;
+}
+
+.toggle-group .toggle {
+  padding: 7px 14px;
+}
+
+.toggle-group .toggle-text span {
+  font-size: 12.5px;
+  line-height: 1.35;
+}
+
+.toggle-text {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 1px;
+}
+
+.toggle-text strong {
+  font-weight: 600;
+}
+
+.toggle-text span {
+  color: var(--text-muted);
+  font-size: 13px;
+}
+
+.switch {
+  appearance: none;
+  background: var(--track);
+  border-radius: 999px;
+  cursor: pointer;
+  flex: none;
+  height: 22px;
+  margin: 0;
+  position: relative;
+  transition: background 160ms ease;
+  width: 36px;
+}
+
+.switch::before {
+  background: #fff;
+  border-radius: 50%;
+  box-shadow: 0 1px 2px rgb(0 0 0 / 25%);
+  content: '';
+  height: 18px;
+  left: 2px;
+  position: absolute;
+  top: 2px;
+  transition: transform 160ms var(--ease);
+  width: 18px;
+}
+
+.switch:checked {
+  background: light-dark(#34c759, #30d158);
+}
+
+.switch:checked::before {
+  transform: translateX(14px);
+}
+
+.facts {
+  color: var(--text);
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin: 0 0 24px;
+  padding-left: 20px;
+}
+
+/* Footer: progress dots, like the space switcher, and the actions. */
+
+.bottom {
+  align-items: center;
+  display: flex;
+  justify-content: space-between;
+}
+
+.dots {
+  display: flex;
+  gap: 6px;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.dots li {
+  background: var(--text-faint);
+  border-radius: 999px;
+  height: 6px;
+  transition: background 200ms ease, width 240ms var(--ease);
+  width: 6px;
+}
+
+.dots li.on {
+  background: var(--ink);
+  width: 18px;
+}
+
+.actions {
+  align-items: center;
+  display: flex;
+  gap: 6px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .wash,
+  .screen,
+  .screen.active,
+  .choice,
+  .swatch,
+  .swatch::after,
+  .switch,
+  .switch::before,
+  .toggle-group,
+  .dots li,
+  .primary-button {
+    transition: none;
+  }
+
+  .screen {
+    transform: none;
+  }
+
+  .swatch:hover,
+  .choice:active,
+  .primary-button:active {
+    transform: none;
+  }
+}
Index: src/chrome/browser/resources/rac_onboarding/app.ts
===================================================================
--- /dev/null
+++ src/chrome/browser/resources/rac_onboarding/app.ts
@@ -0,0 +1,488 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// The welcome tour: a calm sequence of screens a person can finish in under
+// a minute. Every choice writes the same pref the matching setting writes,
+// as soon as it's made, so the window behind the page changes live and
+// nothing is lost if the tab is closed early. Only the two consents wait
+// for a button: Helium services (Continue on that screen) and finishing
+// the tour (Start browsing).
+
+import {acceptLatestSchema, getHeliumPrefs, getRacState, importProfile, LAYOUT_SIDEBAR, LAYOUT_TOP_BAR, listImportableProfiles, onHeliumPrefsChanged, setAssistant, setHeliumPref, setLayout, setTheme} from './browser_proxy.js';
+import type {BrowserProfile, HeliumPrefKey, HeliumPrefs, Layout, RacState} from './browser_proxy.js';
+
+type Screen = 'welcome'|'layout'|'theme'|'import'|'assistant'|'services'|'done';
+const ALL_SCREENS: Screen[] =
+    ['welcome', 'layout', 'theme', 'import', 'assistant', 'services', 'done'];
+
+type AssistantChoice = 'now'|'later'|'never';
+
+const NEW_TAB_URL = 'chrome://newtab';
+const ASSISTANT_SETTINGS_URL = 'chrome://settings/assistant';
+const NEUTRAL_PRESET = 0;
+
+function byId<T extends HTMLElement>(id: string): T {
+  const element = document.getElementById(id);
+  if (!element) {
+    throw new Error(`missing #${id}`);
+  }
+  return element as T;
+}
+
+function screenElement(screen: Screen): HTMLElement {
+  const element =
+      document.querySelector<HTMLElement>(`.screen[data-screen="${screen}"]`);
+  if (!element) {
+    throw new Error(`missing screen ${screen}`);
+  }
+  return element;
+}
+
+function setChecked(group: Iterable<HTMLElement>, picked: HTMLElement|null) {
+  for (const option of group) {
+    option.setAttribute('aria-checked', String(option === picked));
+  }
+}
+
+class Tour {
+  private screens: Screen[] = ['welcome'];
+  private current: Screen = 'welcome';
+  private state: RacState|null = null;
+  private prefs: HeliumPrefs|null = null;
+  private profiles: BrowserProfile[] = [];
+  private selected = new Set<number>();
+  private imported = new Set<number>();
+  private failed = new Set<number>();
+  private importing = false;
+  private advancing = false;
+  private assistant: AssistantChoice = 'later';
+  private readonly darkMedia = matchMedia('(prefers-color-scheme: dark)');
+
+  private readonly app = byId<HTMLElement>('app');
+  private readonly wash = byId<HTMLElement>('wash');
+  private readonly back = byId<HTMLButtonElement>('back');
+  private readonly primary = byId<HTMLButtonElement>('primary');
+  private readonly secondary = byId<HTMLButtonElement>('secondary');
+  private readonly dots = byId<HTMLOListElement>('dots');
+  private readonly swatches = byId<HTMLElement>('swatches');
+  private readonly themeName = byId<HTMLElement>('themeName');
+  private readonly profileList = byId<HTMLElement>('profiles');
+  private readonly importStatus = byId<HTMLElement>('importStatus');
+  private readonly serviceDetails = byId<HTMLElement>('serviceDetails');
+
+  async start() {
+    const [state, prefs, profiles] = await Promise.all([
+      getRacState(),
+      getHeliumPrefs(),
+      listImportableProfiles(),
+    ]);
+    this.state = state;
+    this.prefs = prefs;
+    // Chromium lists "Bookmarks HTML file" as a browser; the tour only
+    // imports from installed browsers.
+    this.profiles = profiles.filter(
+        profile => !profile.name.toLowerCase().includes('html'));
+
+    this.renderLayout();
+    this.renderThemes();
+    this.renderProfiles();
+    this.renderAssistant();
+    this.renderServices();
+    this.applyWash();
+
+    onHeliumPrefsChanged(changed => {
+      this.prefs = changed;
+      this.renderServices();
+    });
+    this.darkMedia.addEventListener('change', () => this.applyWash());
+
+    this.back.addEventListener('click', () => this.previous());
+    this.primary.addEventListener('click', () => this.advance());
+    this.secondary.addEventListener('click', () => this.skipToConsent());
+    document.addEventListener('keydown', event => this.onKeyDown(event));
+
+    this.screens = this.visibleScreens();
+    this.app.hidden = false;
+    this.show('welcome');
+  }
+
+  // Screens that don't apply are left out rather than shown empty: import
+  // when there's nothing to import, and the assistant when it's already on
+  // or the person asked not to be asked again.
+  private visibleScreens(): Screen[] {
+    return ALL_SCREENS.filter(screen => {
+      switch (screen) {
+        case 'import':
+          return this.profiles.length > 0;
+        case 'assistant':
+          return !!this.state && !this.state.assistantEnabled &&
+              !this.state.skipAssistant;
+        default:
+          return true;
+      }
+    });
+  }
+
+  private show(screen: Screen) {
+    screenElement(this.current).classList.remove('active');
+    this.current = screen;
+    const element = screenElement(screen);
+    element.classList.add('active');
+    this.renderChrome();
+    // Focus the heading so screen readers announce the step; sighted
+    // keyboard users keep Enter for Continue.
+    const heading = element.querySelector<HTMLElement>('h1');
+    if (heading) {
+      heading.tabIndex = -1;
+      heading.focus({preventScroll: true});
+    }
+  }
+
+  private renderChrome() {
+    const index = this.screens.indexOf(this.current);
+    this.back.hidden = index <= 0;
+
+    this.dots.replaceChildren(...this.screens.map(screen => {
+      const dot = document.createElement('li');
+      dot.classList.toggle('on', screen === this.current);
+      return dot;
+    }));
+
+    let primary = 'Continue';
+    let secondary: string|null = null;
+    switch (this.current) {
+      case 'welcome':
+        primary = 'Get started';
+        secondary = 'Skip the tour';
+        break;
+      case 'import':
+        primary = this.importing         ? 'Importing…' :
+            this.pendingImports().length ? 'Import and continue' :
+                                           'Continue';
+        break;
+      case 'services':
+        primary = 'Continue';
+        break;
+      case 'done':
+        primary = this.assistant === 'now' ? 'Open assistant settings' :
+                                             'Start browsing';
+        break;
+      default:
+        break;
+    }
+    this.primary.textContent = primary;
+    this.primary.disabled = this.importing;
+    this.back.disabled = this.importing;
+    this.secondary.textContent = secondary ?? '';
+    this.secondary.hidden = secondary === null;
+  }
+
+  private previous() {
+    const index = this.screens.indexOf(this.current);
+    const target = this.screens[index - 1];
+    if (target) {
+      this.show(target);
+    }
+  }
+
+  private next() {
+    const index = this.screens.indexOf(this.current);
+    const target = this.screens[index + 1];
+    if (target) {
+      this.show(target);
+    }
+  }
+
+  // Skipping keeps the defaults for everything the tour would have asked,
+  // but never answers the services consent on the person's behalf.
+  private skipToConsent() {
+    this.show('services');
+  }
+
+  private async advance() {
+    // A step that waits on the browser (consent, finishing) must not run
+    // twice from a double click.
+    if (this.advancing) {
+      return;
+    }
+    this.advancing = true;
+    try {
+      await this.runStep();
+    } finally {
+      this.advancing = false;
+    }
+  }
+
+  private async runStep() {
+    switch (this.current) {
+      case 'import':
+        if (this.pendingImports().length) {
+          await this.runImports();
+        }
+        this.next();
+        break;
+      case 'assistant':
+        setAssistant(this.assistant === 'now', this.assistant === 'never');
+        this.next();
+        break;
+      case 'services':
+        // Continuing past this screen is the consent, as in Helium's tour.
+        await setHeliumPref('services.user_consented', true);
+        acceptLatestSchema();
+        this.next();
+        break;
+      case 'done':
+        await setHeliumPref('completed_onboarding', true);
+        // Settings opens in its own tab, so open it first and then turn
+        // this tab into the first new tab page.
+        if (this.assistant === 'now') {
+          window.open(ASSISTANT_SETTINGS_URL, '_blank');
+        }
+        window.location.replace(NEW_TAB_URL);
+        break;
+      default:
+        this.next();
+        break;
+    }
+  }
+
+  private onKeyDown(event: KeyboardEvent) {
+    if (event.key !== 'Enter' || event.defaultPrevented || event.repeat) {
+      return;
+    }
+    const target = event.target as HTMLElement | null;
+    // Enter on a control activates that control; anywhere else it continues.
+    if (target && target.closest('button, a, input, select, textarea')) {
+      return;
+    }
+    if (!this.primary.disabled) {
+      event.preventDefault();
+      this.primary.click();
+    }
+  }
+
+  // Layout
+
+  private renderLayout() {
+    const options =
+        Array.from(document.querySelectorAll<HTMLElement>('[data-layout]'));
+    const pick = (layout: Layout) => {
+      setChecked(
+          options,
+          options.find(o => o.dataset['layout'] === String(layout)) ?? null);
+    };
+    pick(
+        this.state?.layout === LAYOUT_SIDEBAR ? LAYOUT_SIDEBAR :
+                                                LAYOUT_TOP_BAR);
+    for (const option of options) {
+      option.addEventListener('click', () => {
+        const layout: Layout =
+            option.dataset['layout'] === '0' ? LAYOUT_SIDEBAR : LAYOUT_TOP_BAR;
+        pick(layout);
+        setLayout(layout);
+      });
+    }
+  }
+
+  // Theme
+
+  private renderThemes() {
+    const themes = this.state?.themes ?? [];
+    const buttons = themes.map((theme, i) => {
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.className = 'swatch';
+      button.setAttribute('role', 'radio');
+      button.setAttribute('aria-label', theme.name);
+      button.title = theme.name;
+      button.style.setProperty('--swatch', theme.swatch);
+      button.dataset['preset'] = String(i);
+      return button;
+    });
+    this.swatches.replaceChildren(...buttons);
+
+    const pick = (preset: number) => {
+      if (this.state) {
+        this.state.theme = preset;
+      }
+      setChecked(buttons, buttons[preset] ?? null);
+      this.themeName.textContent = themes[preset]?.name ?? '';
+      this.applyWash();
+    };
+    pick(
+        this.state && this.state.theme >= 0 ? this.state.theme :
+                                              NEUTRAL_PRESET);
+    buttons.forEach((button, i) => button.addEventListener('click', () => {
+      pick(i);
+      setTheme(i);
+    }));
+  }
+
+  // Paints the chosen theme behind the page the way the window paints it,
+  // so the page and the window around it agree.
+  private applyWash() {
+    const preset =
+        this.state && this.state.theme >= 0 ? this.state.theme : NEUTRAL_PRESET;
+    const theme = this.state?.themes[preset];
+    const neutral = preset === NEUTRAL_PRESET || !theme;
+    const [stop1, stop2]: [string, string] = theme && !neutral ?
+        (this.darkMedia.matches ? theme.dark : theme.light) :
+        ['transparent', 'transparent'];
+    const targets = [
+      this.wash,
+      ...document.querySelectorAll<HTMLElement>('.mock'),
+    ];
+    for (const target of targets) {
+      target.classList.toggle('neutral', neutral);
+      target.style.setProperty('--stop-1', stop1);
+      target.style.setProperty('--stop-2', stop2);
+    }
+  }
+
+  // Import
+
+  private pendingImports(): number[] {
+    return [...this.selected].filter(index => !this.imported.has(index));
+  }
+
+  private renderProfiles() {
+    const groups = new Map<string, BrowserProfile[]>();
+    for (const profile of this.profiles) {
+      const list = groups.get(profile.name) ?? [];
+      list.push(profile);
+      groups.set(profile.name, list);
+    }
+    const nodes: HTMLElement[] = [];
+    for (const [browser, profiles] of [...groups.entries()].sort(
+             ([a], [b]) => a.localeCompare(b))) {
+      const heading = document.createElement('h2');
+      heading.textContent = browser;
+      nodes.push(heading);
+      for (const profile of profiles) {
+        nodes.push(this.profileRow(profile));
+      }
+    }
+    this.profileList.replaceChildren(...nodes);
+  }
+
+  private profileRow(profile: BrowserProfile): HTMLElement {
+    const row = document.createElement('label');
+    row.className = 'check';
+    row.dataset['index'] = String(profile.index);
+
+    const box = document.createElement('input');
+    box.type = 'checkbox';
+    box.addEventListener('change', () => {
+      if (box.checked) {
+        this.selected.add(profile.index);
+      } else {
+        this.selected.delete(profile.index);
+      }
+      this.renderChrome();
+    });
+
+    const text = document.createElement('span');
+    text.className = 'toggle-text';
+    const title = document.createElement('strong');
+    title.textContent = profile.profileName || profile.name;
+    const detail = document.createElement('span');
+    detail.textContent = [
+      profile.favorites ? 'Bookmarks' : '',
+      profile.history ? 'History' : '',
+    ].filter(Boolean).join(', ');
+    text.append(title, detail);
+
+    const state = document.createElement('span');
+    state.className = 'state';
+
+    row.append(box, text, state);
+    return row;
+  }
+
+  private setRowState(index: number, label: string, done: boolean) {
+    const row =
+        this.profileList.querySelector<HTMLElement>(`[data-index="${index}"]`);
+    if (!row) {
+      return;
+    }
+    const state = row.querySelector<HTMLElement>('.state');
+    if (state) {
+      state.textContent = label;
+    }
+    const box = row.querySelector<HTMLInputElement>('input');
+    if (box && done) {
+      box.checked = true;
+      box.disabled = true;
+    }
+  }
+
+  private async runImports() {
+    this.importing = true;
+    this.renderChrome();
+    this.importStatus.textContent = 'Importing…';
+    for (const index of this.pendingImports()) {
+      this.setRowState(index, 'Importing…', false);
+      const ok = await importProfile(index);
+      if (ok) {
+        this.imported.add(index);
+        this.failed.delete(index);
+        this.setRowState(index, 'Imported', true);
+      } else {
+        this.failed.add(index);
+        this.setRowState(index, 'Couldn’t import', false);
+      }
+    }
+    this.importing = false;
+    this.importStatus.textContent = this.failed.size ?
+        'Some of it couldn’t be imported. You can try again from ' +
+            'Settings › General › Import.' :
+        'Done.';
+    this.renderChrome();
+  }
+
+  // Assistant
+
+  private renderAssistant() {
+    const options =
+        Array.from(document.querySelectorAll<HTMLElement>('[data-assistant]'));
+    for (const option of options) {
+      option.addEventListener('click', () => {
+        this.assistant =
+            (option.dataset['assistant'] ?? 'later') as AssistantChoice;
+        setChecked(options, option);
+      });
+    }
+  }
+
+  // Helium services
+
+  private renderServices() {
+    const prefs = this.prefs;
+    if (!prefs) {
+      return;
+    }
+    const switches = Array.from(
+        document.querySelectorAll<HTMLInputElement>('.switch[data-pref]'));
+    for (const toggle of switches) {
+      const key = toggle.dataset['pref'] as HeliumPrefKey;
+      const value = prefs[key];
+      if (typeof value === 'boolean') {
+        toggle.checked = value;
+      }
+      if (!toggle.dataset['bound']) {
+        toggle.dataset['bound'] = '1';
+        toggle.addEventListener('change', () => {
+          void setHeliumPref(key, toggle.checked);
+        });
+      }
+    }
+    const enabled = prefs['services.enabled'];
+    this.serviceDetails.classList.toggle('off', !enabled);
+    for (const toggle of this.serviceDetails.querySelectorAll('input')) {
+      toggle.disabled = !enabled;
+    }
+  }
+}
+
+new Tour().start();

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// The welcome tour talks to its handlers with chrome.send, like Helium's
+// page it replaces: Helium's OnboardingMessageHandler (helium.* prefs and
+// the services consent), Chromium's import handler, and rac's own handler.
+// Mojo would add bindings for a few one-shot messages. The lint rules that
+// steer new pages to Mojo are switched off here, in the one file that uses
+// the old calls.
+/* eslint-disable no-restricted-properties, no-restricted-imports */
+
+import {addWebUiListener, removeWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+import type {WebUiListener} from 'chrome://resources/js/cr.js';
+
+export type Layout = 0|1;
+export const LAYOUT_SIDEBAR: Layout = 0;
+export const LAYOUT_TOP_BAR: Layout = 1;
+
+export interface Theme {
+  name: string;
+  swatch: string;
+  light: [string, string];
+  dark: [string, string];
+}
+
+export interface RacState {
+  layout: Layout;
+  theme: number;
+  themes: Theme[];
+  assistantEnabled: boolean;
+  skipAssistant: boolean;
+}
+
+/** Helium's prefs, keyed without their "helium." prefix. */
+export interface HeliumPrefs {
+  'completed_onboarding': boolean;
+  'services.enabled': boolean;
+  'services.user_consented': boolean;
+  'services.ext_proxy': boolean;
+  'services.bangs': boolean;
+  'services.ublock_assets': boolean;
+  'services.browser_updates': boolean;
+}
+export type HeliumPrefKey = keyof HeliumPrefs;
+
+/** One profile of another browser, as Chromium's import handler lists it. */
+export interface BrowserProfile {
+  name: string;
+  index: number;
+  profileName: string;
+  history: boolean;
+  favorites: boolean;
+}
+
+export type ImportStatus = 'initial'|'inProgress'|'succeeded'|'failed';
+
+export function getRacState(): Promise<RacState> {
+  return sendWithPromise('racOnboardingGetState');
+}
+
+export function setLayout(layout: Layout) {
+  chrome.send('racOnboardingSetLayout', [layout]);
+}
+
+export function setTheme(preset: number) {
+  chrome.send('racOnboardingSetTheme', [preset]);
+}
+
+export function setAssistant(enabled: boolean, skip: boolean) {
+  chrome.send('racOnboardingSetAssistant', [enabled, skip]);
+}
+
+export function getHeliumPrefs(): Promise<HeliumPrefs> {
+  return sendWithPromise('getPrefs');
+}
+
+export function setHeliumPref<K extends HeliumPrefKey>(
+    name: K, value: HeliumPrefs[K]): Promise<void> {
+  return sendWithPromise('setPref', name, value);
+}
+
+export function acceptLatestSchema() {
+  chrome.send('acceptLatestSchema');
+}
+
+export function onHeliumPrefsChanged(listener: (prefs: HeliumPrefs) => void):
+    WebUiListener {
+  return addWebUiListener('helium-prefs-changed', listener);
+}
+
+export function listImportableProfiles(): Promise<BrowserProfile[]> {
+  return sendWithPromise('initializeImportDialog');
+}
+
+/** Imports bookmarks and history from one profile. Resolves when it's done. */
+export function importProfile(index: number): Promise<boolean> {
+  return new Promise(resolve => {
+    const listener = addWebUiListener(
+        'import-data-status-changed', (status: ImportStatus) => {
+          if (status !== 'succeeded' && status !== 'failed') {
+            return;
+          }
+          removeWebUiListener(listener);
+          resolve(status === 'succeeded');
+        });
+    chrome.send('importData', [
+      index,
+      {
+        import_dialog_autofill_form_data: false,
+        import_dialog_bookmarks: true,
+        import_dialog_history: true,
+        import_dialog_saved_passwords: false,
+        import_dialog_search_engine: false,
+        import_dialog_extensions: false,
+      },
+    ]);
+  });
+}

+
+#include "chrome/browser/ui/browser_window/public/browser_window_features.h"
+#include "chrome/browser/ui/browser_window/test/mock_browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_prefs.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/common/pref_names.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/unowned_user_data/unowned_user_data_host.h"
+
+namespace rac {
+namespace {
+
+class SidebarDelegate : public tabs::VerticalTabStripStateController::Delegate {
+ public:
+  void SetCollapsedStateUpdatedCallback(
+      base::RepeatingCallback<void(bool)> callback) override {
+    callback_ = std::move(callback);
+  }
+  bool IsCollapsing() override { return false; }
+  void RequestCollapse(bool collapse) override {
+    ++collapse_requests;
+    callback_.Run(collapse);
+  }
+  void ReportCollapsed() { callback_.Run(true); }
+
+  int collapse_requests = 0;
+
+ private:
+  base::RepeatingCallback<void(bool)> callback_;
+};
+
+class RacSidebarStateTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    tabs::RegisterProfilePrefs(prefs_.registry());
+    ON_CALL(browser_, GetUnownedUserDataHost())
+        .WillByDefault(testing::ReturnRef(host_));
+    ON_CALL(browser_, GetFeatures())
+        .WillByDefault(testing::ReturnRef(features_));
+    CreateController();
+  }
+
+  void TearDown() override {
+    controller_->SetDelegate(nullptr);
+    controller_.reset();
+  }
+
+  void CreateController(std::optional<bool> collapsed = std::nullopt,
+                        std::optional<int> width = std::nullopt) {
+    if (controller_) {
+      controller_->SetDelegate(nullptr);
+      controller_.reset();
+    }
+    controller_ = std::make_unique<tabs::VerticalTabStripStateController>(
+        &browser_, &prefs_, /*root_action_item=*/nullptr,
+        /*session_service=*/nullptr, SessionID::FromSerializedValue(123),
+        collapsed, width);
+    controller_->SetDelegate(&delegate_);
+  }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+  ui::UnownedUserDataHost host_;
+  BrowserWindowFeatures features_;
+  testing::NiceMock<MockBrowserWindowInterface> browser_;
+  SidebarDelegate delegate_;
+  std::unique_ptr<tabs::VerticalTabStripStateController> controller_;
+};
+
+TEST_F(RacSidebarStateTest, CollapseRequestsIgnored) {
+  controller_->RequestCollapse(true);
+  controller_->RequestCollapse(false);
+  EXPECT_EQ(0, delegate_.collapse_requests);
+  EXPECT_FALSE(controller_->IsCollapsed());
+  EXPECT_FALSE(controller_->GetState().collapsed);
+  EXPECT_EQ(tabs::VerticalTabStripCollapseState::kExpanded,
+            controller_->GetCollapseState());
+}
+
+TEST_F(RacSidebarStateTest, RestoredCompactStateIgnored) {
+  prefs_.SetBoolean(prefs::kVerticalTabsCollapsedState, true);
+  CreateController(/*collapsed=*/true, /*width=*/300);
+  EXPECT_FALSE(controller_->IsCollapsed());
+  EXPECT_FALSE(controller_->GetState().collapsed);
+  EXPECT_FALSE(prefs_.GetBoolean(prefs::kVerticalTabsCollapsedState));
+  EXPECT_EQ(300, controller_->GetUncollapsedWidth());
+}
+
+TEST_F(RacSidebarStateTest, DelegateCannotRestoreCompactState) {
+  delegate_.ReportCollapsed();
+  EXPECT_FALSE(controller_->IsCollapsed());
+  EXPECT_EQ(tabs::VerticalTabStripCollapseState::kExpanded,
+            controller_->GetCollapseState());
+}
+
+TEST_F(RacSidebarStateTest, ResizedWidthPersistsWithoutCompactState) {
+  controller_->SetUncollapsedWidth(300);
+  EXPECT_EQ(300, prefs_.GetInteger(prefs::kVerticalTabsUncollapsedWidth));
+  EXPECT_FALSE(prefs_.GetBoolean(prefs::kVerticalTabsCollapsedState));
+}
+

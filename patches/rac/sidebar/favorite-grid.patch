+int GetFavoriteColumns(int count) {
+  constexpr int kMaxColumns = 3;
+  if (count <= kMaxColumns) {
+    return std::max(count, 1);
+  }
+  const int rows = (count + kMaxColumns - 1) / kMaxColumns;
+  return (count + rows - 1) / rows;
+}

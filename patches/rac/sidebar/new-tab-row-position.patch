+#ifndef CHROME_BROWSER_UI_RAC_NEW_TAB_ROW_POSITION_H_
+#define CHROME_BROWSER_UI_RAC_NEW_TAB_ROW_POSITION_H_
+
+namespace rac {
+
+// Profile pref: where the sidebar's "+ New Tab" row sits.
+inline constexpr char kNewTabRowPosition[] = "rac.sidebar.new_tab_row_position";
+
+// The values are stored in the pref and must match the options in the
+// Appearance settings page.
+enum class NewTabRowPosition {
+  // Right under the last open tab, scrolling with the list, as Dia does.
+  kBottom = 0,
+  // Above the first open tab, under the space's name and pinned tabs, as Arc
+  // does.
+  kTop = 1,
+};
+
+inline constexpr NewTabRowPosition kDefaultNewTabRowPosition =
+    NewTabRowPosition::kBottom;
+
+// Returns the default, kBottom, for a value this version doesn't know.
+constexpr NewTabRowPosition NewTabRowPositionFromPref(int value) {
+  return value == static_cast<int>(NewTabRowPosition::kTop)
+             ? NewTabRowPosition::kTop
+             : kDefaultNewTabRowPosition;
+}
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_NEW_TAB_ROW_POSITION_H_

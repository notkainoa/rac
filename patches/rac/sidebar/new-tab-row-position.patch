+++ b/chrome/browser/ui/rac/new_tab_row_position_unittest.cc
@@ -0,0 +1,33 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/new_tab_row_position.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+
+TEST(NewTabRowPositionTest, DefaultsToBottom) {
+  EXPECT_EQ(kDefaultNewTabRowPosition, NewTabRowPosition::kBottom);
+}
+
+TEST(NewTabRowPositionTest, ReadsBothOptions) {
+  EXPECT_EQ(NewTabRowPositionFromPref(0), NewTabRowPosition::kBottom);
+  EXPECT_EQ(NewTabRowPositionFromPref(1), NewTabRowPosition::kTop);
+}
+
+TEST(NewTabRowPositionTest, UnknownValuesFallBackToTheDefault) {
+  EXPECT_EQ(NewTabRowPositionFromPref(-1), kDefaultNewTabRowPosition);
+  EXPECT_EQ(NewTabRowPositionFromPref(2), kDefaultNewTabRowPosition);
+  EXPECT_EQ(NewTabRowPositionFromPref(1000), kDefaultNewTabRowPosition);
+}
+
+// The pref stores these numbers, so changing them would flip every profile's
+// choice.
+TEST(NewTabRowPositionTest, StoredValuesAreStable) {
+  EXPECT_EQ(static_cast<int>(NewTabRowPosition::kBottom), 0);
+  EXPECT_EQ(static_cast<int>(NewTabRowPosition::kTop), 1);
+}
+
+}  // namespace rac

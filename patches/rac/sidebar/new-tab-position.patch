+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/tabs/new_tab_position.h"
+
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+constexpr TabSlot kPinned{.pinned = true, .in_view = true};
+constexpr TabSlot kOpen{.pinned = false, .in_view = true};
+constexpr TabSlot kElsewhere{.pinned = false, .in_view = false};
+
+TEST(NewTabPositionTest, ParsesTheStoredValue) {
+  EXPECT_EQ(NewTabPositionFromInt(0), NewTabPosition::kBottom);
+  EXPECT_EQ(NewTabPositionFromInt(1), NewTabPosition::kTop);
+}
+
+TEST(NewTabPositionTest, UnknownValuesMeanBottom) {
+  EXPECT_EQ(NewTabPositionFromInt(-1), NewTabPosition::kBottom);
+  EXPECT_EQ(NewTabPositionFromInt(2), NewTabPosition::kBottom);
+  EXPECT_EQ(NewTabPositionFromInt(1000), NewTabPosition::kBottom);
+}
+
+TEST(NewTabPositionTest, BottomIsAlwaysTheEnd) {
+  const std::vector<TabSlot> tabs = {kPinned, kOpen, kOpen, kElsewhere};
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kBottom, tabs), -1);
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kBottom, {}), -1);
+}
+
+TEST(NewTabPositionTest, TopWithOnlyOpenTabsIsTheFront) {
+  const std::vector<TabSlot> tabs = {kOpen, kOpen, kOpen};
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kTop, tabs), 0);
+}
+
+TEST(NewTabPositionTest, TopComesAfterFavoritesAndPinnedTabs) {
+  const std::vector<TabSlot> tabs = {kPinned, kPinned, kPinned,
+                                     kOpen,   kOpen};
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kTop, tabs), 3);
+}
+
+TEST(NewTabPositionTest, TopSkipsOtherSpacesTabs) {
+  // The model keeps another space's tabs between the pinned tabs and this
+  // space's. They are hidden, so the first open tab in view is the answer.
+  const std::vector<TabSlot> tabs = {kPinned,    kElsewhere, kElsewhere,
+                                     kOpen,      kOpen,      kElsewhere};
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kTop, tabs), 3);
+}
+
+TEST(NewTabPositionTest, TopInAnEmptySpaceIsTheEnd) {
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kTop, {}), -1);
+  const std::vector<TabSlot> only_pinned = {kPinned, kPinned};
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kTop, only_pinned), -1);
+  const std::vector<TabSlot> only_elsewhere = {kPinned, kElsewhere,
+                                               kElsewhere};
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kTop, only_elsewhere), -1);
+}
+
+TEST(NewTabPositionTest, TopWithoutFavoritesInAnIncognitoStyleWindow) {
+  // Windows without spaces have no hidden tabs and no favorites.
+  const std::vector<TabSlot> tabs = {kOpen};
+  EXPECT_EQ(PickNewTabIndex(NewTabPosition::kTop, tabs), 0);
+}

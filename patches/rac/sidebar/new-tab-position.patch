+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/tabs/new_tab_insertion.h"
+
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/spaces/space_tab_tag.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/rac/new_tab_position_prefs.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "chrome/browser/ui/rac/tabs/new_tab_position.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace rac {
+
+int NewTabInsertionIndex(BrowserWindowInterface* browser) {
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return -1;
+  }
+  // An incognito window follows the profile it came from.
+  const NewTabPosition position = GetNewTabPosition(
+      browser->GetProfile()->GetOriginalProfile()->GetPrefs());
+  if (position == NewTabPosition::kBottom) {
+    return -1;
+  }
+  // The "open in another window" screen is this window's only visible tab.
+  if (auto* spaces = SpacesWindowManager::From(browser);
+      spaces && spaces->IsShowingElsewhereScreen(browser)) {
+    return -1;
+  }
+  std::vector<TabSlot> slots;
+  for (const tabs::TabInterface* tab : *browser->GetTabStripModel()) {
+    slots.push_back({.pinned = tab->IsPinned(),
+                     .in_view = SpaceTabTag::IsVisible(tab)});
+  }
+  return PickNewTabIndex(position, slots);
+}
+
+void KeepOpenerForNewTab(BrowserWindowInterface* browser,
+                         content::WebContents* new_tab,
+                         const tabs::TabInterface* opener) {
+  TabStripModel* model = browser->GetTabStripModel();
+  const int index = model->GetIndexOfWebContents(new_tab);
+  if (!opener || index == TabStripModel::kNoTab ||
+      index == model->count() - 1) {
+    return;
+  }
+  // The model's setter takes a mutable tab; it doesn't change it.
+  model->SetOpenerOfTabAt(index, const_cast<tabs::TabInterface*>(opener));
+  static_cast<tabs::TabModel*>(model->GetTabAtIndex(index))
+      ->set_reset_opener_on_active_tab_change(true);
+}
+
+}  // namespace rac

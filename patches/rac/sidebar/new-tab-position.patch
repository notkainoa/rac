+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/tabs/new_tab_position.h"
+
+namespace rac {
+
+NewTabPosition NewTabPositionFromInt(int value) {
+  return value == static_cast<int>(NewTabPosition::kTop)
+             ? NewTabPosition::kTop
+             : NewTabPosition::kBottom;
+}
+
+int PickNewTabIndex(NewTabPosition position, base::span<const TabSlot> tabs) {
+  if (position != NewTabPosition::kTop) {
+    return -1;
+  }
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    if (!tabs[i].pinned && tabs[i].in_view) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+}  // namespace rac

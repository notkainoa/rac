+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_TABS_NEW_TAB_POSITION_H_
+#define CHROME_BROWSER_UI_RAC_TABS_NEW_TAB_POSITION_H_
+
+#include "base/containers/span.h"
+
+namespace rac {
+
+// Profile pref: where a tab the user creates appears among the open tabs of
+// the space the window shows. The values are stored in the pref and must
+// match the radio buttons in the Appearance settings page.
+inline constexpr char kNewTabPosition[] = "rac.tabs.new_tab_position";
+
+enum class NewTabPosition {
+  // After the space's other open tabs (the default, and how Chromium works).
+  kBottom = 0,
+  // Before them, right under the favorites and pinned tabs.
+  kTop = 1,
+};
+
+// Returns kBottom for a value this version doesn't know.
+NewTabPosition NewTabPositionFromInt(int value);
+
+// One tab of a window's tab strip model, in model order.
+struct TabSlot {
+  // Chromium-pinned: a favorite or a pinned tab. These lead the model.
+  bool pinned = false;
+  // Shown in the window's current space. False for tabs of other spaces,
+  // which stay in the model but are hidden.
+  bool in_view = false;
+};
+
+// The model index where a new tab goes, or -1 for "at the end", which is what
+// the tab strip does with no index. kTop returns the index of the first open
+// (not pinned) tab of the shown space, so the new tab lands after the pinned
+// tabs and before the other open tabs, and never among another space's tabs.
+// A space with no open tabs has no first one: the answer is -1.
+int PickNewTabIndex(NewTabPosition position, base::span<const TabSlot> tabs);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_TABS_NEW_TAB_POSITION_H_

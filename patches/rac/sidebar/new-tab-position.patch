+
+#ifndef CHROME_BROWSER_UI_RAC_TABS_NEW_TAB_INSERTION_H_
+#define CHROME_BROWSER_UI_RAC_TABS_NEW_TAB_INSERTION_H_
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace rac {
+
+// The model index for a tab the user is creating in `browser` (Cmd+T, the
+// sidebar's New Tab row, a new tab from the command bar), per the "New tabs
+// appear" setting; -1 means the end, which is the tab strip's own default.
+// Call it only for tabs the user asked for, never for links, restored tabs, or
+// helper tabs. Windows without spaces (incognito) use the setting too; their
+// only pinned tabs are the ones the user pinned.
+int NewTabInsertionIndex(BrowserWindowInterface* browser);
+
+// A tab inserted away from the end doesn't get the opener Chromium gives a new
+// tab at the end, so closing it would not return to the tab it was opened
+// from. Gives `new_tab` the same opener, forgotten as soon as the user
+// switches tabs. Does nothing when `new_tab` is at the end.
+void KeepOpenerForNewTab(BrowserWindowInterface* browser,
+                         content::WebContents* new_tab,
+                         const tabs::TabInterface* opener);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_TABS_NEW_TAB_INSERTION_H_

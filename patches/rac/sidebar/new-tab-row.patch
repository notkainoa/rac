+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_NEW_TAB_ROW_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_NEW_TAB_ROW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/mojom/menu_source_type.mojom-forward.h"
+#include "ui/menus/simple_menu_model.h"
+#include "ui/views/context_menu_controller.h"
+#include "ui/views/controls/button/button.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class ImageView;
+class Label;
+class MenuRunner;
+}  // namespace views
+
+namespace rac {
+
+// Arc's "+ New Tab" row. It sits above the open tabs in the vertical
+// sidebar, has the same metrics as a tab row, and shows only the plus icon
+// when the sidebar is collapsed to icons. Pressing it opens a new tab, which
+// joins the window's active space like any other new tab.
+class NewTabRow : public views::Button, public views::ContextMenuController {
+  METADATA_HEADER(NewTabRow, views::Button)
+
+ public:
+  explicit NewTabRow(BrowserWindowInterface* browser);
+  NewTabRow(const NewTabRow&) = delete;
+  NewTabRow& operator=(const NewTabRow&) = delete;
+  ~NewTabRow() override;
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+ private:
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SIDEBAR_NEW_TAB_ROW_H_

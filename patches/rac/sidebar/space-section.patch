+#include "ui/views/widget/widget.h"
+
+namespace rac {
+
+namespace {
+
+enum SpaceMenuCommand {
+  kRenameCommand = 1,
+  kMoveLeftCommand,
+  kMoveRightCommand,
+  kUnloadCommand,
+  kDeleteCommand,
+  kThemeSubmenuCommand,
+  kIconSubmenuCommand,
+  kFirstThemeCommand = 100,
+  kThemeAutoCommand = 108,
+  kThemeLightCommand,
+  kThemeDarkCommand,
+  kFirstIconCommand = 200,
+  kClearIconCommand = 208,
+};
+
+constexpr std::array<std::string_view, 8> kIcons = {
+    "🌸", "🍑", "🌿", "☁️", "🌙", "🍁", "☀️", "🌊"};
+static_assert(kThemeAutoCommand - kFirstThemeCommand >=
+              static_cast<int>(SpaceTheme::kPresetCount));
+static_assert(kClearIconCommand - kFirstIconCommand >=
+              static_cast<int>(kIcons.size()));
+
+// A filled circle for the color menu, as in Dia's picker.
+ui::ImageModel CreateSwatch(size_t preset) {
+  constexpr int kSize = 12;
+  constexpr float kScale = 2.0f;
+  uint32_t rgb = 0;
+  base::HexStringToUInt(SpaceTheme::PresetSwatch(preset).substr(1), &rgb);
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(kSize * kScale, kSize * kScale);
+  bitmap.eraseColor(SK_ColorTRANSPARENT);
+  SkCanvas canvas(bitmap);
+  SkPaint paint;
+  paint.setAntiAlias(true);
+  paint.setColor(SkColorSetA(rgb, SK_AlphaOPAQUE));
+  const float r = kSize * kScale / 2;
+  canvas.drawCircle(r, r, r - 1, paint);
+  paint.setStyle(SkPaint::kStroke_Style);
+  paint.setStrokeWidth(1);
+  paint.setColor(SkColorSetA(SK_ColorBLACK, 0x26));
+  canvas.drawCircle(r, r, r - 1.5f, paint);
+  return ui::ImageModel::FromImageSkia(
+      gfx::ImageSkia(gfx::ImageSkiaRep(bitmap, kScale)));
+}
+
+}  // namespace
+
+SpaceMenu::SpaceMenu(SpacesWindowManager* manager) : manager_(manager) {}
+
+SpaceMenu::~SpaceMenu() = default;
+
+void SpaceMenu::Show(const base::Uuid& space,
+                     views::View* bubble_anchor,
+                     views::View* source,
+                     const gfx::Rect& anchor_bounds,
+                     views::MenuAnchorPosition anchor_position,
+                     ui::mojom::MenuSourceType source_type,
+                     base::RepeatingClosure on_closed) {
+  if (!manager_ || !source->GetWidget()) {
+    return;
+  }
+  space_ = space;
+  bubble_anchor_ = bubble_anchor;
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  theme_menu_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (size_t i = 0; i < SpaceTheme::kPresetCount; ++i) {
+    theme_menu_->AddCheckItem(kFirstThemeCommand + i,
+                              std::u16string(SpaceTheme::PresetName(i)));
+    theme_menu_->SetIcon(theme_menu_->GetItemCount() - 1, CreateSwatch(i));
+  }
+  theme_menu_->AddSeparator(ui::NORMAL_SEPARATOR);
+  theme_menu_->AddCheckItem(kThemeAutoCommand, u"Automatic");
+  theme_menu_->AddCheckItem(kThemeLightCommand, u"Light");
+  theme_menu_->AddCheckItem(kThemeDarkCommand, u"Dark");
+
+  icon_menu_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (size_t i = 0; i < kIcons.size(); ++i) {
+    icon_menu_->AddCheckItem(kFirstIconCommand + i,
+                             base::UTF8ToUTF16(kIcons[i]));
+  }
+  icon_menu_->AddSeparator(ui::NORMAL_SEPARATOR);
+  icon_menu_->AddCheckItem(kClearIconCommand, u"Use Dot");
+
+  menu_model_->AddItemWithStringId(kRenameCommand, IDS_RAC_SPACES_RENAME);
+  menu_model_->AddSubMenu(kIconSubmenuCommand, u"Icon", icon_menu_.get());
+  menu_model_->AddSubMenu(kThemeSubmenuCommand, u"Color", theme_menu_.get());
+  menu_model_->AddItemWithStringId(kMoveLeftCommand, IDS_RAC_SPACES_MOVE_LEFT);
+  menu_model_->AddItemWithStringId(kMoveRightCommand,
+                                   IDS_RAC_SPACES_MOVE_RIGHT);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kUnloadCommand, IDS_RAC_SPACES_UNLOAD);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kDeleteCommand, IDS_RAC_SPACES_DELETE);
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU, std::move(on_closed));
+  menu_runner_->RunMenuAt(source->GetWidget(), nullptr, anchor_bounds,
+                          anchor_position, source_type);
+}
+
+bool SpaceMenu::IsShowing() const {
+  return menu_runner_ && menu_runner_->IsRunning();
+}
+
+void SpaceMenu::Cancel() {
+  if (IsShowing()) {
+    menu_runner_->Cancel();
+  }
+}
+
+bool SpaceMenu::IsCommandIdChecked(int command_id) const {
+  if (!manager_ || !space_) {
+    return false;
+  }
+  const Space* space = manager_->spaces()->FindSpace(*space_);
+  if (!space) {
+    return false;
+  }
+  if (command_id >= kFirstThemeCommand &&
+      command_id < kFirstThemeCommand + SpaceTheme::kPresetCount) {
+    const auto preset = SpaceTheme::Preset(command_id - kFirstThemeCommand);
+    return space->theme.color1 == preset.color1 &&
+           space->theme.color2 == preset.color2;
+  }
+  if (command_id >= kFirstIconCommand &&
+      command_id < kFirstIconCommand + static_cast<int>(kIcons.size())) {
+    return space->icon == kIcons[command_id - kFirstIconCommand];
+  }
+  switch (command_id) {
+    case kThemeAutoCommand:
+      return space->theme.mode == SpaceTheme::Mode::kAuto;
+    case kThemeLightCommand:
+      return space->theme.mode == SpaceTheme::Mode::kLight;
+    case kThemeDarkCommand:
+      return space->theme.mode == SpaceTheme::Mode::kDark;
+    case kClearIconCommand:
+      return space->icon.empty();
+    default:
+      return false;
+  }
+}
+
+bool SpaceMenu::IsCommandIdEnabled(int command_id) const {
+  if (!manager_ || !space_) {
+    return false;
+  }
+  SpacesService* spaces = manager_->spaces();
+  const std::optional<size_t> index = spaces->GetIndex(*space_);
+  if (!index) {
+    return false;
+  }
+  switch (command_id) {
+    case kMoveLeftCommand:
+      return *index > 0;
+    case kMoveRightCommand:
+      return *index + 1 < spaces->spaces().size();
+    case kUnloadCommand:
+      return !manager_->GetWindowHoldingSpace(*space_) &&
+             !manager_->IsSpaceUnloaded(*space_) &&
+             manager_->GetTabCount(*space_) > 0;
+    case kDeleteCommand:
+      return spaces->spaces().size() > 1;
+    default:
+      return true;
+  }
+}
+
+void SpaceMenu::ExecuteCommand(int command_id, int event_flags) {
+  if (!manager_ || !space_) {
+    return;
+  }
+  const base::Uuid space = *space_;
+  SpacesService* spaces = manager_->spaces();
+  if (command_id >= kFirstThemeCommand &&
+      command_id < kFirstThemeCommand + SpaceTheme::kPresetCount) {
+    spaces->SetSpaceThemePreset(space, command_id - kFirstThemeCommand);
+    return;
+  }
+  if (command_id >= kFirstIconCommand &&
+      command_id < kFirstIconCommand + static_cast<int>(kIcons.size())) {
+    spaces->SetSpaceIcon(space,
+                         std::string(kIcons[command_id - kFirstIconCommand]));
+    return;
+  }
+  const std::optional<size_t> index = spaces->GetIndex(space);
+  switch (command_id) {
+    case kRenameCommand:
+      ShowRenameSpaceBubble(bubble_anchor_, spaces, space);
+      break;
+    case kThemeAutoCommand:
+      spaces->SetSpaceThemeMode(space, SpaceTheme::Mode::kAuto);
+      break;
+    case kThemeLightCommand:
+      spaces->SetSpaceThemeMode(space, SpaceTheme::Mode::kLight);
+      break;
+    case kThemeDarkCommand:
+      spaces->SetSpaceThemeMode(space, SpaceTheme::Mode::kDark);
+      break;
+    case kClearIconCommand:
+      spaces->SetSpaceIcon(space, "");
+      break;
+    case kMoveLeftCommand:
+      if (index && *index > 0) {
+        spaces->MoveSpace(space, *index - 1);
+      }
+      break;
+    case kMoveRightCommand:
+      if (index && *index + 1 < spaces->spaces().size()) {
+        spaces->MoveSpace(space, *index + 1);
+      }
+      break;
+    case kUnloadCommand:
+      manager_->UnloadSpace(space);
+      break;
+    case kDeleteCommand:
+      ShowDeleteSpaceBubble(bubble_anchor_, manager_, space);
+      break;
+  }
+}
+
+}  // namespace rac

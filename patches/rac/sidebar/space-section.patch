+namespace rac {
+
+class SpacesWindowManager;
+
+// A space's menu: rename, icon, color, order, unload, and delete. Shown from
+// the space dots and the space's name above its pinned tabs.
+class SpaceMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  explicit SpaceMenu(SpacesWindowManager* manager);
+  SpaceMenu(const SpaceMenu&) = delete;
+  SpaceMenu& operator=(const SpaceMenu&) = delete;
+  ~SpaceMenu() override;
+
+  // `bubble_anchor` anchors the rename and delete bubbles, so it must outlive
+  // them.
+  void Show(const base::Uuid& space,
+            views::View* bubble_anchor,
+            views::View* source,
+            const gfx::Rect& anchor_bounds,
+            views::MenuAnchorPosition anchor_position,
+            ui::mojom::MenuSourceType source_type,
+            base::RepeatingClosure on_closed = base::RepeatingClosure());
+  bool IsShowing() const;
+  void Cancel();
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  bool IsCommandIdEnabled(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  const raw_ptr<SpacesWindowManager> manager_;
+  // Set while the menu is open: the space it acts on.
+  std::optional<base::Uuid> space_;
+  raw_ptr<views::View> bubble_anchor_ = nullptr;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<ui::SimpleMenuModel> theme_menu_;
+  std::unique_ptr<ui::SimpleMenuModel> icon_menu_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SPACES_SPACE_MENU_H_

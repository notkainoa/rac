@@ -0,0 +1,52 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_SPACES_SPACE_H_
+#define CHROME_BROWSER_RAC_SPACES_SPACE_H_
+
+#include <optional>
+#include <string>
+
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "base/values.h"
+
+namespace rac {
+
+// A set of tabs inside a profile. Spaces belong to the profile, not to a
+// window, and a window shows one space at a time.
+struct Space {
+  Space();
+  Space(base::Uuid id, std::string name);
+  Space(const Space&) = delete;
+  Space& operator=(const Space&) = delete;
+  Space(Space&&);
+  Space& operator=(Space&&);
+  ~Space();
+
+  // Stable across restarts. Session data refers to spaces by this ID, since
+  // Chromium's own window and tab IDs change on every launch.
+  base::Uuid id;
+
+  // What the user named the space. Empty until they name it; the UI then
+  // shows a fallback.
+  std::string name;
+
+  // When a window last showed this space. Null if no window has yet.
+  base::Time last_active;
+
+  // Fields this version doesn't read, such as a theme or pinned tabs written
+  // by a newer rac. They're written back unchanged so an older build can't
+  // erase them.
+  base::DictValue unknown_fields;
+
+  base::DictValue ToDict() const;
+
+  // Returns nullopt if `dict` has no valid ID.
+  static std::optional<Space> FromDict(const base::DictValue& dict);
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_SPACES_SPACE_H_

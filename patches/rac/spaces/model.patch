+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_SPACES_SPACES_SERVICE_H_
+#define CHROME_BROWSER_RAC_SPACES_SPACES_SERVICE_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+class PrefService;
+
+namespace base {
+class Clock;
+}
+
+namespace rac {
+
+// The profile's list of spaces: their order, names, and IDs. It's the only
+// owner of that list, so windows never rebuild it from what they show. The
+// list always has at least one space.
+//
+// It knows nothing about tabs. Deleting a space here doesn't touch the
+// space's tabs; callers move or close them first.
+class SpacesService : public KeyedService {
+ public:
+  // Observers get IDs rather than spaces, since an observer may change the
+  // list and invalidate references into it.
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnSpaceAdded(const base::Uuid& id) {}
+    virtual void OnSpaceRenamed(const base::Uuid& id) {}
+    virtual void OnSpaceRemoved(const base::Uuid& id) {}
+    virtual void OnSpacesReordered() {}
+  };
+
+  // The newest format this build writes. Builds only ever raise it.
+  static constexpr int kVersion = 1;
+
+  // `clock` is for tests; null means the real clock.
+  explicit SpacesService(PrefService* prefs,
+                         const base::Clock* clock = nullptr);
+  SpacesService(const SpacesService&) = delete;
+  SpacesService& operator=(const SpacesService&) = delete;
+  ~SpacesService() override;
+
+  // In the order the switcher shows them. Never empty.
+  const std::vector<Space>& spaces() const { return spaces_; }
+
+  const Space* FindSpace(const base::Uuid& id) const;
+  std::optional<size_t> GetIndex(const base::Uuid& id) const;
+
+  // Adds a space at the end and returns its ID.
+  base::Uuid CreateSpace(std::string name = std::string());
+
+  // These return false if `id` isn't a space.
+  bool RenameSpace(const base::Uuid& id, std::string name);
+  // Also false if `id` is the only space.
+  bool RemoveSpace(const base::Uuid& id);
+  // `index` is the space's position after the move. False if it's out of
+  // range.
+  bool MoveSpace(const base::Uuid& id, size_t index);
+
+  // Records that a window just showed `id`.
+  void MarkSpaceActive(const base::Uuid& id);
+
+  // Space IDs, most recently shown first. Spaces never shown come last, in
+  // switcher order.
+  std::vector<base::Uuid> GetSpacesByRecentUse() const;
+
+  // The space a tab belongs to. That's `tab_space` if it still exists,
+  // otherwise `active_space` (the space the tab's window shows), otherwise
+  // the first space. A tab never loses its place because its space is gone.
+  base::Uuid ResolveSpaceForTab(
+      const std::optional<base::Uuid>& tab_space,
+      const std::optional<base::Uuid>& active_space) const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  void Load();
+  void Save();
+  std::vector<Space>::iterator FindIterator(const base::Uuid& id);
+
+  const raw_ptr<PrefService> prefs_;
+  const raw_ptr<const base::Clock> clock_;
+
+  std::vector<Space> spaces_;
+
+  // The stored version, which may be newer than kVersion.
+  int version_ = kVersion;
+
+  // Top-level pref keys this build doesn't read, written back unchanged.
+  base::DictValue unknown_fields_;
+
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_SPACES_SPACES_SERVICE_H_

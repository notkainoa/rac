+
+#include "chrome/browser/rac/spaces/space_tab_tag.h"
+
+#include <utility>
+
+#include "base/check.h"
+
+namespace rac {
+
+SpaceTabTag::SpaceTabTag(content::WebContents* contents, base::Uuid space_id)
+    : content::WebContentsUserData<SpaceTabTag>(*contents),
+      space_id_(std::move(space_id)) {}
+
+SpaceTabTag::~SpaceTabTag() = default;
+
+// static
+std::optional<base::Uuid> SpaceTabTag::Get(
+    const content::WebContents* contents) {
+  const SpaceTabTag* tag = FromWebContents(contents);
+  if (!tag) {
+    return std::nullopt;
+  }
+  return tag->space_id_;
+}
+
+// static
+void SpaceTabTag::Set(content::WebContents* contents,
+                      const base::Uuid& space_id) {
+  CHECK(space_id.is_valid());
+  if (SpaceTabTag* tag = FromWebContents(contents)) {
+    tag->space_id_ = space_id;
+  } else {
+    CreateForWebContents(contents, space_id);
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SpaceTabTag);
+
+}  // namespace rac

Index: src/chrome/browser/rac/spaces/spaces_service.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/spaces/spaces_service.cc	2026-10-12 00:20:57.675833574 -0700
@@ -0,0 +1,195 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/spaces_service.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/check.h"
+#include "base/containers/to_vector.h"
+#include "base/time/clock.h"
+#include "base/time/default_clock.h"
+#include "chrome/browser/rac/spaces/spaces_prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+namespace {
+
+constexpr char kVersionKey[] = "version";
+constexpr char kSpacesKey[] = "spaces";
+
+}  // namespace
+
+SpacesService::SpacesService(PrefService* prefs, const base::Clock* clock)
+    : prefs_(prefs), clock_(clock ? clock : base::DefaultClock::GetInstance()) {
+  CHECK(prefs_);
+  Load();
+}
+
+SpacesService::~SpacesService() = default;
+
+const Space* SpacesService::FindSpace(const base::Uuid& id) const {
+  auto it = std::ranges::find(spaces_, id, &Space::id);
+  return it == spaces_.end() ? nullptr : &*it;
+}
+
+std::optional<size_t> SpacesService::GetIndex(const base::Uuid& id) const {
+  auto it = std::ranges::find(spaces_, id, &Space::id);
+  if (it == spaces_.end()) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(it - spaces_.begin());
+}
+
+base::Uuid SpacesService::CreateSpace(std::string name) {
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  spaces_.emplace_back(id, std::move(name));
+  Save();
+  for (Observer& observer : observers_) {
+    observer.OnSpaceAdded(id);
+  }
+  return id;
+}
+
+bool SpacesService::RenameSpace(const base::Uuid& id, std::string name) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  if (it->name == name) {
+    return true;
+  }
+  it->name = std::move(name);
+  Save();
+  const base::Uuid renamed_id = it->id;
+  for (Observer& observer : observers_) {
+    observer.OnSpaceRenamed(renamed_id);
+  }
+  return true;
+}
+
+bool SpacesService::RemoveSpace(const base::Uuid& id) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end() || spaces_.size() == 1) {
+    return false;
+  }
+  // Copied first, since `id` may refer into the space being erased.
+  const base::Uuid removed_id = id;
+  spaces_.erase(it);
+  Save();
+  for (Observer& observer : observers_) {
+    observer.OnSpaceRemoved(removed_id);
+  }
+  return true;
+}
+
+bool SpacesService::MoveSpace(const base::Uuid& id, size_t index) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end() || index >= spaces_.size()) {
+    return false;
+  }
+  const size_t from = static_cast<size_t>(it - spaces_.begin());
+  if (from == index) {
+    return true;
+  }
+  if (from < index) {
+    std::rotate(it, it + 1, spaces_.begin() + index + 1);
+  } else {
+    std::rotate(spaces_.begin() + index, it, it + 1);
+  }
+  Save();
+  for (Observer& observer : observers_) {
+    observer.OnSpacesReordered();
+  }
+  return true;
+}
+
+void SpacesService::MarkSpaceActive(const base::Uuid& id) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end()) {
+    return;
+  }
+  it->last_active = clock_->Now();
+  Save();
+}
+
+std::vector<base::Uuid> SpacesService::GetSpacesByRecentUse() const {
+  std::vector<const Space*> ordered =
+      base::ToVector(spaces_, [](const Space& space) { return &space; });
+  // Stable, so spaces never shown keep their switcher order.
+  std::ranges::stable_sort(
+      ordered, std::ranges::greater(),
+      [](const Space* space) { return space->last_active; });
+  return base::ToVector(ordered, [](const Space* space) { return space->id; });
+}
+
+base::Uuid SpacesService::ResolveSpaceForTab(
+    const std::optional<base::Uuid>& tab_space,
+    const std::optional<base::Uuid>& active_space) const {
+  if (tab_space && FindSpace(*tab_space)) {
+    return *tab_space;
+  }
+  if (active_space && FindSpace(*active_space)) {
+    return *active_space;
+  }
+  return spaces_.front().id;
+}
+
+void SpacesService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpacesService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SpacesService::Load() {
+  const base::DictValue& stored = prefs_->GetDict(kSpaces);
+
+  version_ = std::max(stored.FindInt(kVersionKey).value_or(kVersion), kVersion);
+
+  unknown_fields_ = stored.Clone();
+  unknown_fields_.Remove(kVersionKey);
+  unknown_fields_.Remove(kSpacesKey);
+
+  if (const base::ListValue* list = stored.FindList(kSpacesKey)) {
+    std::set<base::Uuid> seen;
+    for (const base::Value& entry : *list) {
+      if (!entry.is_dict()) {
+        continue;
+      }
+      std::optional<Space> space = Space::FromDict(entry.GetDict());
+      if (space && seen.insert(space->id).second) {
+        spaces_.push_back(std::move(*space));
+      }
+    }
+  }
+
+  if (spaces_.empty()) {
+    // First run, or nothing usable was stored. Save right away so the space
+    // keeps its ID, which session data will refer to.
+    spaces_.emplace_back(base::Uuid::GenerateRandomV4(), std::string());
+    Save();
+  }
+}
+
+void SpacesService::Save() {
+  base::ListValue list;
+  for (const Space& space : spaces_) {
+    list.Append(space.ToDict());
+  }
+  base::DictValue dict = unknown_fields_.Clone();
+  dict.Set(kVersionKey, version_);
+  dict.Set(kSpacesKey, std::move(list));
+  prefs_->SetDict(kSpaces, std::move(dict));
+}
+
+std::vector<Space>::iterator SpacesService::FindIterator(const base::Uuid& id) {
+  return std::ranges::find(spaces_, id, &Space::id);
+}
+
+}  // namespace rac

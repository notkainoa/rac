+namespace rac {
+
+// Which space a tab belongs to. It lives on the tab's WebContents, so it
+// follows the tab between windows and survives discarding, which keeps the
+// WebContents. An untagged tab hasn't been placed yet; resolve its space with
+// SpacesService::ResolveSpaceForTab().
+class SpaceTabTag : public content::WebContentsUserData<SpaceTabTag> {
+ public:
+  SpaceTabTag(const SpaceTabTag&) = delete;
+  SpaceTabTag& operator=(const SpaceTabTag&) = delete;
+  ~SpaceTabTag() override;
+
+  static std::optional<base::Uuid> Get(const content::WebContents* contents);
+  static void Set(content::WebContents* contents, const base::Uuid& space_id);
+
+ private:
+  friend class content::WebContentsUserData<SpaceTabTag>;
+
+  SpaceTabTag(content::WebContents* contents, base::Uuid space_id);
+
+  base::Uuid space_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace rac

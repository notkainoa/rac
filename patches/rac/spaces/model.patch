@@ -0,0 +1,70 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/space.h"
+
+#include <utility>
+
+#include "base/json/values_util.h"
+
+namespace rac {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kLastActiveKey[] = "last_active";
+
+}  // namespace
+
+Space::Space() = default;
+
+Space::Space(base::Uuid id, std::string name)
+    : id(std::move(id)), name(std::move(name)) {}
+
+Space::Space(Space&&) = default;
+Space& Space::operator=(Space&&) = default;
+Space::~Space() = default;
+
+base::DictValue Space::ToDict() const {
+  base::DictValue dict = unknown_fields.Clone();
+  dict.Set(kIdKey, id.AsLowercaseString());
+  dict.Set(kNameKey, name);
+  if (last_active.is_null()) {
+    dict.Remove(kLastActiveKey);
+  } else {
+    dict.Set(kLastActiveKey, base::TimeToValue(last_active));
+  }
+  return dict;
+}
+
+// static
+std::optional<Space> Space::FromDict(const base::DictValue& dict) {
+  const std::string* stored_id = dict.FindString(kIdKey);
+  if (!stored_id) {
+    return std::nullopt;
+  }
+  base::Uuid uuid = base::Uuid::ParseCaseInsensitive(*stored_id);
+  if (!uuid.is_valid()) {
+    return std::nullopt;
+  }
+
+  Space space;
+  space.id = std::move(uuid);
+  if (const std::string* stored_name = dict.FindString(kNameKey)) {
+    space.name = *stored_name;
+  }
+  if (std::optional<base::Time> stored_last_active =
+          base::ValueToTime(dict.Find(kLastActiveKey))) {
+    space.last_active = *stored_last_active;
+  }
+
+  space.unknown_fields = dict.Clone();
+  space.unknown_fields.Remove(kIdKey);
+  space.unknown_fields.Remove(kNameKey);
+  space.unknown_fields.Remove(kLastActiveKey);
+  return space;
+}
+
+}  // namespace rac

Index: src/chrome/browser/rac/spaces/spaces_service_unittest.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/spaces/spaces_service_unittest.cc	2026-10-12 00:20:57.677314528 -0700
@@ -0,0 +1,267 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/spaces_service.h"
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/scoped_observation.h"
+#include "base/strings/string_util.h"
+#include "base/test/simple_test_clock.h"
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/rac/spaces/spaces_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+using ::testing::ElementsAre;
+
+class RecordingObserver : public SpacesService::Observer {
+ public:
+  void OnSpaceAdded(const base::Uuid& id) override { added.push_back(id); }
+  void OnSpaceRenamed(const base::Uuid& id) override { renamed.push_back(id); }
+  void OnSpaceRemoved(const base::Uuid& id) override { removed.push_back(id); }
+  void OnSpacesReordered() override { ++reordered; }
+
+  std::vector<base::Uuid> added;
+  std::vector<base::Uuid> renamed;
+  std::vector<base::Uuid> removed;
+  int reordered = 0;
+};
+
+class SpacesServiceTest : public testing::Test {
+ protected:
+  SpacesServiceTest() {
+    RegisterSpacesProfilePrefs(prefs_.registry());
+    clock_.SetNow(base::Time::FromSecondsSinceUnixEpoch(1'700'000'000));
+  }
+
+  std::unique_ptr<SpacesService> MakeService() {
+    return std::make_unique<SpacesService>(&prefs_, &clock_);
+  }
+
+  std::vector<base::Uuid> Ids(const SpacesService& service) {
+    std::vector<base::Uuid> ids;
+    for (const Space& space : service.spaces()) {
+      ids.push_back(space.id);
+    }
+    return ids;
+  }
+
+  const base::DictValue& Stored() { return prefs_.GetDict(kSpaces); }
+
+  TestingPrefServiceSimple prefs_;
+  base::SimpleTestClock clock_;
+};
+
+TEST_F(SpacesServiceTest, FirstRunCreatesAndSavesOneSpace) {
+  auto service = MakeService();
+  ASSERT_EQ(service->spaces().size(), 1u);
+  const base::Uuid id = service->spaces()[0].id;
+  EXPECT_TRUE(id.is_valid());
+  EXPECT_TRUE(service->spaces()[0].name.empty());
+
+  // A new service sees the same space, so its ID survives a restart.
+  service.reset();
+  auto reloaded = MakeService();
+  EXPECT_THAT(Ids(*reloaded), ElementsAre(id));
+  EXPECT_EQ(Stored().FindInt("version"), SpacesService::kVersion);
+}
+
+TEST_F(SpacesServiceTest, CreateRenameRemoveAndPersist) {
+  auto service = MakeService();
+  RecordingObserver observer;
+  base::ScopedObservation<SpacesService, SpacesService::Observer> observation(
+      &observer);
+  observation.Observe(service.get());
+
+  const base::Uuid first = service->spaces()[0].id;
+  const base::Uuid work = service->CreateSpace("Work");
+  EXPECT_THAT(observer.added, ElementsAre(work));
+  EXPECT_THAT(Ids(*service), ElementsAre(first, work));
+  EXPECT_EQ(service->GetIndex(work), 1u);
+
+  EXPECT_TRUE(service->RenameSpace(work, "Office"));
+  EXPECT_EQ(service->FindSpace(work)->name, "Office");
+  EXPECT_THAT(observer.renamed, ElementsAre(work));
+  // Renaming to the same name isn't a change.
+  EXPECT_TRUE(service->RenameSpace(work, "Office"));
+  EXPECT_EQ(observer.renamed.size(), 1u);
+
+  EXPECT_FALSE(service->RenameSpace(base::Uuid::GenerateRandomV4(), "x"));
+
+  observation.Reset();
+  service.reset();
+  auto reloaded = MakeService();
+  EXPECT_THAT(Ids(*reloaded), ElementsAre(first, work));
+  EXPECT_EQ(reloaded->FindSpace(work)->name, "Office");
+
+  EXPECT_TRUE(reloaded->RemoveSpace(first));
+  EXPECT_THAT(Ids(*reloaded), ElementsAre(work));
+  EXPECT_EQ(reloaded->FindSpace(first), nullptr);
+  EXPECT_EQ(reloaded->GetIndex(first), std::nullopt);
+}
+
+TEST_F(SpacesServiceTest, RemoveRefusesTheLastSpace) {
+  auto service = MakeService();
+  RecordingObserver observer;
+  service->AddObserver(&observer);
+  EXPECT_FALSE(service->RemoveSpace(service->spaces()[0].id));
+  EXPECT_EQ(service->spaces().size(), 1u);
+  EXPECT_FALSE(service->RemoveSpace(base::Uuid::GenerateRandomV4()));
+  EXPECT_TRUE(observer.removed.empty());
+  service->RemoveObserver(&observer);
+}
+
+TEST_F(SpacesServiceTest, RemoveNotifiesWithACopyOfTheId) {
+  auto service = MakeService();
+  const base::Uuid second = service->CreateSpace("Second");
+  RecordingObserver observer;
+  service->AddObserver(&observer);
+  // Pass a reference into the list itself; it's erased during the call.
+  EXPECT_TRUE(service->RemoveSpace(service->spaces()[1].id));
+  EXPECT_THAT(observer.removed, ElementsAre(second));
+  service->RemoveObserver(&observer);
+}
+
+TEST_F(SpacesServiceTest, MoveSpace) {
+  auto service = MakeService();
+  const base::Uuid a = service->spaces()[0].id;
+  const base::Uuid b = service->CreateSpace("B");
+  const base::Uuid c = service->CreateSpace("C");
+  RecordingObserver observer;
+  service->AddObserver(&observer);
+
+  EXPECT_TRUE(service->MoveSpace(a, 2));
+  EXPECT_THAT(Ids(*service), ElementsAre(b, c, a));
+  EXPECT_TRUE(service->MoveSpace(a, 0));
+  EXPECT_THAT(Ids(*service), ElementsAre(a, b, c));
+  EXPECT_TRUE(service->MoveSpace(c, 1));
+  EXPECT_THAT(Ids(*service), ElementsAre(a, c, b));
+  EXPECT_EQ(observer.reordered, 3);
+
+  EXPECT_TRUE(service->MoveSpace(c, 1));
+  EXPECT_EQ(observer.reordered, 3);
+  EXPECT_FALSE(service->MoveSpace(c, 3));
+  EXPECT_FALSE(service->MoveSpace(base::Uuid::GenerateRandomV4(), 0));
+  EXPECT_THAT(Ids(*service), ElementsAre(a, c, b));
+
+  service->RemoveObserver(&observer);
+  service.reset();
+  EXPECT_THAT(Ids(*MakeService()), ElementsAre(a, c, b));
+}
+
+TEST_F(SpacesServiceTest, SpacesByRecentUse) {
+  auto service = MakeService();
+  const base::Uuid a = service->spaces()[0].id;
+  const base::Uuid b = service->CreateSpace("B");
+  const base::Uuid c = service->CreateSpace("C");
+  const base::Uuid d = service->CreateSpace("D");
+
+  // Never-shown spaces keep switcher order.
+  EXPECT_THAT(service->GetSpacesByRecentUse(), ElementsAre(a, b, c, d));
+
+  service->MarkSpaceActive(c);
+  clock_.Advance(base::Minutes(1));
+  service->MarkSpaceActive(b);
+  EXPECT_THAT(service->GetSpacesByRecentUse(), ElementsAre(b, c, a, d));
+
+  // Survives a restart.
+  service.reset();
+  auto reloaded = MakeService();
+  EXPECT_EQ(reloaded->FindSpace(b)->last_active, clock_.Now());
+  EXPECT_THAT(reloaded->GetSpacesByRecentUse(), ElementsAre(b, c, a, d));
+
+  reloaded->MarkSpaceActive(base::Uuid::GenerateRandomV4());
+  EXPECT_THAT(reloaded->GetSpacesByRecentUse(), ElementsAre(b, c, a, d));
+}
+
+TEST_F(SpacesServiceTest, ResolveSpaceForTab) {
+  auto service = MakeService();
+  const base::Uuid a = service->spaces()[0].id;
+  const base::Uuid b = service->CreateSpace("B");
+  const base::Uuid gone = base::Uuid::GenerateRandomV4();
+
+  EXPECT_EQ(service->ResolveSpaceForTab(b, a), b);
+  EXPECT_EQ(service->ResolveSpaceForTab(gone, b), b);
+  EXPECT_EQ(service->ResolveSpaceForTab(std::nullopt, b), b);
+  EXPECT_EQ(service->ResolveSpaceForTab(gone, gone), a);
+  EXPECT_EQ(service->ResolveSpaceForTab(std::nullopt, std::nullopt), a);
+}
+
+TEST_F(SpacesServiceTest, KeepsFieldsFromNewerVersions) {
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  prefs_.SetDict(
+      kSpaces,
+      base::DictValue()
+          .Set("version", SpacesService::kVersion + 1)
+          .Set("future_top_level", "kept")
+          .Set("spaces",
+               base::ListValue().Append(
+                   base::DictValue()
+                       .Set("id", id.AsLowercaseString())
+                       .Set("name", "Home")
+                       .Set("theme", base::DictValue().Set("hue", 200)))));
+
+  auto service = MakeService();
+  ASSERT_THAT(Ids(*service), ElementsAre(id));
+  service->CreateSpace("New");
+
+  const base::DictValue& stored = Stored();
+  EXPECT_EQ(stored.FindInt("version"), SpacesService::kVersion + 1);
+  EXPECT_EQ(*stored.FindString("future_top_level"), "kept");
+  const base::ListValue* spaces = stored.FindList("spaces");
+  ASSERT_TRUE(spaces);
+  ASSERT_EQ(spaces->size(), 2u);
+  const base::DictValue& home = (*spaces)[0].GetDict();
+  EXPECT_EQ(*home.FindString("name"), "Home");
+  EXPECT_EQ(home.FindIntByDottedPath("theme.hue"), 200);
+}
+
+TEST_F(SpacesServiceTest, SkipsInvalidAndDuplicateEntries) {
+  const base::Uuid a = base::Uuid::GenerateRandomV4();
+  const base::Uuid b = base::Uuid::GenerateRandomV4();
+  prefs_.SetDict(
+      kSpaces,
+      base::DictValue()
+          .Set("version", 1)
+          .Set("spaces",
+               base::ListValue()
+                   .Append("not a dict")
+                   .Append(base::DictValue().Set("name", "No ID"))
+                   .Append(base::DictValue().Set("id", "not-a-uuid"))
+                   .Append(base::DictValue()
+                               .Set("id", a.AsLowercaseString())
+                               .Set("name", "A"))
+                   .Append(base::DictValue()
+                               .Set("id", a.AsLowercaseString())
+                               .Set("name", "A again"))
+                   .Append(base::DictValue().Set(
+                       "id", base::ToUpperASCII(b.AsLowercaseString())))));
+
+  auto service = MakeService();
+  EXPECT_THAT(Ids(*service), ElementsAre(a, b));
+  EXPECT_EQ(service->FindSpace(a)->name, "A");
+  EXPECT_TRUE(service->FindSpace(b)->name.empty());
+}
+
+TEST_F(SpacesServiceTest, NothingUsableStoredCreatesASpace) {
+  prefs_.SetDict(
+      kSpaces,
+      base::DictValue().Set("spaces", base::ListValue().Append(
+                                          base::DictValue().Set("id", "bad"))));
+  auto service = MakeService();
+  EXPECT_EQ(service->spaces().size(), 1u);
+  EXPECT_TRUE(service->spaces()[0].id.is_valid());
+}
+
+}  // namespace
+}  // namespace rac

+// Unloading leaves alone the tabs a user is likely to notice stopping:
+// sound, picture-in-picture, and tabs still loading.
+bool CanUnload(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  return !contents->WasDiscarded() && !contents->IsLoading() &&
+         !contents->IsCurrentlyAudible() &&
+         !contents->HasPictureInPictureVideo();
+}

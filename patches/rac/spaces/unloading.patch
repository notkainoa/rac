+void SpacesWindowManager::UnloadSpace(const base::Uuid& space) {
+  auto it = hidden_.find(space);
+  if (it == hidden_.end()) {
+    return;
+  }
+  for (tabs::TabInterface* tab : it->second.GetTabs()) {
+    if (CanUnload(tab)) {
+      tab->GetContents()->Discard(base::DoNothing());
+    }
+  }
+}
+
+bool SpacesWindowManager::IsSpaceUnloaded(const base::Uuid& space) const {
+  auto it = hidden_.find(space);
+  if (it == hidden_.end() || it->second.empty()) {
+    return false;
+  }
+  for (tabs::TabInterface* tab : it->second.GetTabs()) {
+    if (!tab->GetContents()->WasDiscarded()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void SpacesWindowManager::UnloadStaleHiddenSpaces() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  for (const auto& [space, hidden] : hidden_) {
+    if (now - hidden.hidden_at() >= kHiddenUnloadDelay) {
+      UnloadSpace(space);
+    }
+  }
+  UpdateUnloadTimer();
+}
+
+void SpacesWindowManager::UpdateUnloadTimer() {
+  if (hidden_.empty()) {
+    unload_timer_.Stop();
+    return;
+  }
+  if (!unload_timer_.IsRunning()) {
+    unload_timer_.Start(FROM_HERE, base::Minutes(1), this,
+                        &SpacesWindowManager::UnloadStaleHiddenSpaces);
+  }
+}

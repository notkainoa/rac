+// A space's page as it last looked: a copy of the page's layers, each
+// replaying the paint its original last recorded.
+class SpacePager::Page {
+ public:
+  static std::unique_ptr<Page> Record(views::View& view) {
+    ui::Layer* source = view.layer();
+    if (!source || !source->GetCompositor()) {
+      return nullptr;
+    }
+    auto page = base::WrapUnique(new Page(source->size(),
+                                          source->device_scale_factor()));
+    std::unique_ptr<ui::Layer> root = page->Copy(*source);
+    root->SetBounds(gfx::Rect(source->size()));
+    root->SetTransform(gfx::Transform());
+    root->SetOpacity(1.0f);
+    root->SetVisible(true);
+    page->CopyChildren(*source, *root);
+    page->tree_ = std::make_unique<ui::LayerTreeOwner>(std::move(root));
+    return page;
+  }
+
+  Page(const Page&) = delete;
+  Page& operator=(const Page&) = delete;
+  ~Page() {
+    if (root()->parent()) {
+      root()->parent()->Remove(root());
+    }
+  }
+
+  ui::Layer* root() { return tree_->root(); }
+  const gfx::Size& size() const { return size_; }
+  // Spaces have different numbers of tabs, so only the width has to match.
+  bool Fits(const ui::Layer& layer) const {
+    return layer.size().width() == size_.width() &&
+           layer.device_scale_factor() == device_scale_factor_;
+  }
+
+ private:
+  Page(const gfx::Size& size, float device_scale_factor)
+      : size_(size), device_scale_factor_(device_scale_factor) {}
+
+  std::unique_ptr<ui::Layer> Copy(ui::Layer& source) {
+    std::unique_ptr<ui::Layer> copy = source.Clone();
+    // The copy can't scroll, so it's moved by the original's scroll offset.
+    const gfx::PointF scroll = source.CurrentScrollOffset();
+    if (!scroll.IsOrigin()) {
+      gfx::Transform transform =
+          gfx::Transform::MakeTranslation(-scroll.x(), -scroll.y());
+      transform.PreConcat(copy->transform());
+      copy->SetTransform(transform);
+    }
+    if (source.type() == ui::LAYER_TEXTURED && source.delegate()) {
+      painters_.push_back(std::make_unique<RecordedPainter>(source));
+      copy->set_delegate(painters_.back().get());
+      copy->SchedulePaint(gfx::Rect(copy->size()));
+    }
+    return copy;
+  }
+
+  void CopyChildren(ui::Layer& source, ui::Layer& destination) {
+    for (ui::Layer* child : source.children()) {
+      if (!child->GetTargetVisibility() || child->bounds().IsEmpty()) {
+        continue;
+      }
+      std::unique_ptr<ui::Layer> copy = Copy(*child);
+      CopyChildren(*child, *copy);
+      // The tree owner deletes the whole tree.
+      destination.Add(copy.release());
+    }
+  }
+
+  const gfx::Size size_;
+  const float device_scale_factor_;
+  // Outlives the layers that paint with it.
+  std::vector<std::unique_ptr<RecordedPainter>> painters_;
+  std::unique_ptr<ui::LayerTreeOwner> tree_;
+};
+
+float SpacePager::Spring::OffsetAt(base::TimeDelta time) const {
+  const double t = std::max(0.0, time.InSecondsF());
+  const double rate = velocity + kSpringOmega * offset;
+  return (offset + rate * t) * std::exp(-kSpringOmega * t);
+}
+
+float SpacePager::Spring::VelocityAt(base::TimeDelta time) const {
+  const double t = std::max(0.0, time.InSecondsF());
+  const double rate = velocity + kSpringOmega * offset;
+  return (rate - kSpringOmega * (offset + rate * t)) *
+         std::exp(-kSpringOmega * t);
+}
+
+base::TimeDelta SpacePager::Spring::Duration() const {
+  // Arc samples its spring at 240 Hz; the same steps find where it rests.
+  constexpr base::TimeDelta kStep = base::Hertz(240);
+  constexpr base::TimeDelta kLongest = base::Milliseconds(1500);
+  base::TimeDelta time = kStep;
+  while (time < kLongest &&
+         (std::abs(OffsetAt(time)) > 0.25f ||
+          std::abs(VelocityAt(time)) > 15.0f)) {
+    time += kStep;
+  }
+  return time;
+}
+
+// static
+std::unique_ptr<SpacePager> SpacePager::Create(BrowserWindowInterface* browser,
+                                               PageGetter get_page) {
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  return manager ? std::make_unique<SpacePager>(browser, manager,
+                                                std::move(get_page))
+                 : nullptr;
+}
+
+SpacePager::SpacePager(BrowserWindowInterface* browser,
+                       SpacesWindowManager* manager,
+                       PageGetter get_page)
+    : browser_(browser), manager_(manager), get_page_(std::move(get_page)) {
+  manager_observation_.Observe(manager_);
+}
+
+SpacePager::~SpacePager() {
+  // The animations can outlive the pager; stop hearing about them first.
+  if (settling_) {
+    settling_->RemoveObserver(this);
+  }
+  ClearFade();
+  HidePages();
+  pages_.clear();
+}
+
+bool SpacePager::BeginDrag() {
+  views::View* page = GetPage();
+  if (!page || gfx::Animation::PrefersReducedMotion() ||
+      !manager_->GetActiveSpaceId(browser_)) {
+    return false;
+  }
+  drag_offset_ = Stop();
+  dragging_ = true;
+  samples_.clear();
+  samples_.push_back({base::TimeTicks::Now(), drag_offset_});
+  ShowNeighbors();
+  SetOffset(RubberBand(drag_offset_));
+  return true;
+}
+
+void SpacePager::UpdateDrag(float delta) {
+  if (!dragging_) {
+    return;
+  }
+  drag_offset_ += delta * kDragScale;
+  SetOffset(RubberBand(drag_offset_));
+  const base::TimeTicks now = base::TimeTicks::Now();
+  samples_.push_back({now, drag_offset_});
+  while (samples_.size() > 2 &&
+         now - samples_.front().time > kVelocityWindow) {
+    samples_.pop_front();
+  }
+}
+
+void SpacePager::EndDrag() {
+  if (!dragging_) {
+    return;
+  }
+  dragging_ = false;
+  const float offset = GetOffset();
+  const float velocity = GetDragVelocity();
+  const float half = GetPageSpacing() / 2;
+  // Negative offsets show the next space.
+  int direction = 0;
+  if (offset < -kFlickMinimumOffset && GetAdjacentSpace(1) &&
+      velocity < kFlickVelocity &&
+      (offset < -half || velocity < -kFlickVelocity)) {
+    direction = 1;
+  } else if (offset > kFlickMinimumOffset && GetAdjacentSpace(-1) &&
+             velocity > -kFlickVelocity &&
+             (offset > half || velocity > kFlickVelocity)) {
+    direction = -1;
+  }
+  if (direction) {
+    release_ = Spring{offset, velocity};
+    manager_->ShowAdjacentSpace(browser_, direction);
+    if (!release_) {
+      return;
+    }
+    // The window didn't switch after all.
+    release_.reset();
+  }
+  Settle(offset, velocity);
+}
+
+void SpacePager::OnWindowSpaceWillChange(BrowserWindowInterface* browser) {
+  if (browser != browser_) {
+    return;
+  }
+  views::View* page = GetPage();
+  if (!page || !manager_->GetActiveSpaceId(browser_)) {
+    return;
+  }
+  dragging_ = false;
+  leaving_offset_ = release_ ? release_->offset : Stop();
+  HidePages();
+  leaving_ = Page::Record(*page);
+}
+
+void SpacePager::OnActiveSpaceChanged(BrowserWindowInterface* browser,
+                                      const std::optional<SpaceId>& previous,
+                                      const std::optional<SpaceId>& current) {
+  if (browser != browser_) {
+    return;
+  }
+  std::unique_ptr<Page> leaving = std::move(leaving_);
+  const std::optional<Spring> release = std::exchange(release_, std::nullopt);
+  views::View* page = GetPage();
+  if (!page) {
+    return;
+  }
+  const std::optional<size_t> from =
+      previous ? manager_->spaces()->GetIndex(*previous) : std::nullopt;
+  const std::optional<size_t> to =
+      current ? manager_->spaces()->GetIndex(*current) : std::nullopt;
+  if (!leaving || !from || !to || *from == *to) {
+    SetOffset(0);
+    return;
+  }
+  if (gfx::Animation::PrefersReducedMotion()) {
+    SetOffset(0);
+    CrossFade(std::move(leaving));
+    return;
+  }
+  const int direction = *to > *from ? 1 : -1;
+  const float spacing = GetPageSpacing();
+  Page* old_page = leaving.get();
+  Remember(*previous, std::move(leaving));
+  // The new page comes in from beside the old one, which stays where it was
+  // and leaves the other way.
+  ShowPage(old_page, -direction * spacing);
+  Settle(leaving_offset_ + direction * spacing,
+         release ? release->velocity : 0.0f);
+}
+
+void SpacePager::OnWindowSpaceChanged(BrowserWindowInterface* browser) {
+  if (browser != browser_ || !leaving_) {
+    return;
+  }
+  // The window left for the "open in another window" screen.
+  leaving_.reset();
+  release_.reset();
+  SetOffset(0);
+}
+
+void SpacePager::OnSpacesChanged() {
+  // Names, icons, and order show on the pages.
+  if (dragging_ || settling_) {
+    stale_ = true;
+    return;
+  }
+  pages_.clear();
+}
+
+void SpacePager::OnLayerAnimationEnded(ui::LayerAnimationSequence* sequence) {
+  if (sequence == settling_) {
+    settling_ = nullptr;
+    HidePages();
+  } else if (sequence == fading_sequence_) {
+    fading_sequence_ = nullptr;
+    PostClearFade();
+  }
+}
+
+void SpacePager::OnLayerAnimationAborted(
+    ui::LayerAnimationSequence* sequence) {
+  if (sequence == settling_) {
+    settling_ = nullptr;
+    if (!stopping_) {
+      HidePages();
+    }
+  } else if (sequence == fading_sequence_) {
+    fading_sequence_ = nullptr;
+    PostClearFade();
+  }
+}
+
+views::View* SpacePager::GetPage() const {
+  views::View* page = get_page_.Run();
+  if (!page || !page->IsDrawn() || page->width() <= 0) {
+    return nullptr;
+  }
+  if (!page->layer()) {
+    page->SetPaintToLayer();
+    page->layer()->SetFillsBoundsOpaquely(false);
+  }
+  return page;
+}
+
+float SpacePager::GetPageSpacing() const {
+  views::View* page = GetPage();
+  return page ? page->width() + kPageGap : 0;
+}
+
+std::optional<SpaceId> SpacePager::GetAdjacentSpace(int direction) const {
+  const std::optional<SpaceId> current = manager_->GetActiveSpaceId(browser_);
+  const std::optional<size_t> index =
+      current ? manager_->spaces()->GetIndex(*current) : std::nullopt;
+  if (!index) {
+    return std::nullopt;
+  }
+  const auto& spaces = manager_->spaces()->spaces();
+  const int next = static_cast<int>(*index) + direction;
+  if (next < 0 || static_cast<size_t>(next) >= spaces.size()) {
+    return std::nullopt;
+  }
+  return spaces[next].id;
+}
+
+float SpacePager::GetOffset() const {
+  if (settling_) {
+    return static_cast<SpringElement*>(settling_->FirstElement())->GetOffset();
+  }
+  views::View* page = GetPage();
+  return page ? page->layer()->transform().To2dTranslation().x() : 0;
+}
+
+float SpacePager::Stop() {
+  const float offset = GetOffset();
+  if (settling_) {
+    stopping_ = true;
+    if (views::View* page = GetPage()) {
+      page->layer()->GetAnimator()->AbortAllAnimations();
+    }
+    stopping_ = false;
+    settling_ = nullptr;
+  }
+  ClearFade();
+  HidePages();
+  SetOffset(offset);
+  return offset;
+}
+
+void SpacePager::ShowNeighbors() {
+  const float spacing = GetPageSpacing();
+  for (int direction : {-1, 1}) {
+    if (const std::optional<SpaceId> space = GetAdjacentSpace(direction)) {
+      if (Page* page = Recall(*space)) {
+        ShowPage(page, direction * spacing);
+      }
+    }
+  }
+}
+
+void SpacePager::ShowPage(Page* page, float position) {
+  views::View* view = GetPage();
+  ui::Layer* strip = view ? view->layer()->parent() : nullptr;
+  ui::Layer* host = strip ? strip->parent() : nullptr;
+  if (!host) {
+    return;
+  }
+  // The tab strip clips to its own height, which follows the current space's
+  // tabs, so the other pages go in a clip of their own above it.
+  if (!clip_) {
+    clip_ = ui::Layer::Create(ui::LAYER_NOT_DRAWN);
+    clip_->SetName("SpacePager");
+    clip_->SetMasksToBounds(true);
+  }
+  if (clip_->parent() != host) {
+    host->Add(clip_.get());
+  }
+  host->StackAbove(clip_.get(), strip);
+  shown_.push_back({page, position});
+  clip_->Add(page->root());
+
+  const gfx::Rect& live = view->layer()->bounds();
+  int height = live.height();
+  for (const Shown& shown : shown_) {
+    height = std::max(height, shown.page->size().height());
+    shown.page->root()->SetBounds(
+        gfx::Rect(gfx::Point(live.x(), 0), shown.page->size()));
+  }
+  clip_->SetBounds(gfx::Rect(strip->bounds().x(), strip->bounds().y() + live.y(),
+                             strip->bounds().width(), height));
+  page->root()->SetTransform(Translation(
+      position + view->layer()->transform().To2dTranslation().x()));
+}
+
+void SpacePager::HidePages() {
+  for (const Shown& shown : std::exchange(shown_, {})) {
+    shown.page->root()->GetAnimator()->AbortAllAnimations();
+    clip_->Remove(shown.page->root());
+  }
+  if (clip_ && clip_->parent()) {
+    clip_->parent()->Remove(clip_.get());
+  }
+  if (stale_ && !dragging_ && !settling_) {
+    stale_ = false;
+    pages_.clear();
+  }
+}
+
+void SpacePager::SetOffset(float offset) {
+  if (views::View* page = GetPage()) {
+    page->layer()->SetTransform(Translation(offset));
+  }
+  for (const Shown& shown : shown_) {
+    shown.page->root()->SetTransform(Translation(shown.position + offset));
+  }
+}
+
+void SpacePager::Settle(float offset, float velocity) {
+  views::View* page = GetPage();
+  if (!page) {
+    return;
+  }
+  // Toward rest, a spring this fast would overshoot by a visible amount.
+  const float limit = 2 * kSpringOmega * std::abs(offset);
+  if (velocity * offset < 0) {
+    velocity = std::clamp(velocity, -limit, limit);
+  }
+  const Spring spring{offset, velocity};
+  ui::LayerAnimator* animator = page->layer()->GetAnimator();
+  if (settling_) {
+    stopping_ = true;
+    animator->AbortAllAnimations();
+    stopping_ = false;
+    settling_ = nullptr;
+  }
+  for (const Shown& shown : shown_) {
+    shown.page->root()->GetAnimator()->AbortAllAnimations();
+  }
+  SetOffset(offset);
+  // The pages beside run the same spring. They start in the same frame, so
+  // they keep their distance.
+  for (const Shown& shown : shown_) {
+    shown.page->root()->GetAnimator()->StartAnimation(
+        CreateSpring(spring, shown.position).release());
+  }
+  std::unique_ptr<ui::LayerAnimationSequence> sequence =
+      CreateSpring(spring, 0);
+  sequence->AddObserver(this);
+  settling_ = sequence.get();
+  animator->StartAnimation(sequence.release());
+}
+
+void SpacePager::CrossFade(std::unique_ptr<Page> page) {
+  ClearFade();
+  fading_ = std::move(page);
+  ShowPage(fading_.get(), 0);
+  auto sequence = std::make_unique<ui::LayerAnimationSequence>(
+      ui::LayerAnimationElement::CreateOpacityElement(0.0f,
+                                                      kCrossFadeDuration));
+  sequence->AddObserver(this);
+  fading_sequence_ = sequence.get();
+  fading_->root()->GetAnimator()->StartAnimation(sequence.release());
+}
+
+void SpacePager::PostClearFade() {
+  // The fading layer's animator is still notifying.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SpacePager::ClearFade,
+                                weak_ptr_factory_.GetWeakPtr()));
+}
+
+void SpacePager::ClearFade() {
+  if (fading_sequence_) {
+    fading_sequence_->RemoveObserver(this);
+    fading_sequence_ = nullptr;
+  }
+  if (!fading_) {
+    return;
+  }
+  std::erase_if(shown_, [this](const Shown& shown) {
+    return shown.page == fading_.get();
+  });
+  fading_.reset();
+  if (shown_.empty() && clip_->parent()) {
+    clip_->parent()->Remove(clip_.get());
+  }
+}
+
+void SpacePager::Remember(const SpaceId& space, std::unique_ptr<Page> page) {
+  pages_[space] = std::move(page);
+}
+
+SpacePager::Page* SpacePager::Recall(const SpaceId& space) {
+  auto it = pages_.find(space);
+  views::View* view = GetPage();
+  if (it == pages_.end() || !view) {
+    return nullptr;
+  }
+  if (!it->second->Fits(*view->layer())) {
+    pages_.erase(it);
+    return nullptr;
+  }
+  return it->second.get();
+}
+
+float SpacePager::RubberBand(float offset) const {
+  const float spacing = GetPageSpacing();
+  const float lowest = GetAdjacentSpace(1) ? -spacing : 0;
+  const float highest = GetAdjacentSpace(-1) ? spacing : 0;
+  const auto band = [](float distance) {
+    return distance * kRubberBandDimension * kRubberBandCoefficient /
+           (kRubberBandDimension + kRubberBandCoefficient * distance);
+  };
+  if (offset > highest) {
+    return highest + band(offset - highest);
+  }
+  if (offset < lowest) {
+    return lowest - band(lowest - offset);
+  }
+  return offset;
+}
+
+float SpacePager::GetDragVelocity() const {
+  if (samples_.size() < 2) {
+    return 0;
+  }
+  const Sample& last = samples_.back();
+  if (base::TimeTicks::Now() - last.time > kRestTime) {
+    return 0;
+  }
+  const Sample* first = &samples_.front();
+  for (const Sample& sample : samples_) {
+    if (last.time - sample.time <= kVelocityWindow) {
+      first = &sample;
+      break;
+    }
+  }
+  const double seconds = (last.time - first->time).InSecondsF();
+  if (seconds < 0.008) {
+    return 0;
+  }
+  return (last.offset - first->offset) / seconds;
+}
+
+}  // namespace rac

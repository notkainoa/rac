+// Arc's page spring: critically damped with a 0.25 s response.
+constexpr double kSpringOmega = 2 * std::numbers::pi / 0.25;
+// Arc moves its pages half as far as the scroll delta, which keeps a page
+// under control for a whole trackpad's travel.
+constexpr float kDragScale = 0.5f;
+// Arc's resistance past the first and last space, in Apple's rubber band
+// formula.
+constexpr float kRubberBandCoefficient = 0.15f;
+constexpr float kRubberBandDimension = 255.0f;
+// A flick this fast, in DIPs per second, turns the page even if it hasn't
+// gone halfway.
+constexpr float kFlickVelocity = 300.0f;
+// Before a flick counts, so a tap with a wobble doesn't switch.
+constexpr float kFlickMinimumOffset = 4.0f;
+// How far back the release speed is measured, and how long the fingers can
+// rest before letting go still counts as a stop.
+constexpr base::TimeDelta kVelocityWindow = base::Milliseconds(100);
+constexpr base::TimeDelta kRestTime = base::Milliseconds(60);
+constexpr int kPageGap = 12;
+constexpr base::TimeDelta kCrossFadeDuration = base::Milliseconds(150);
+
+gfx::Transform Translation(float x) {
+  return gfx::Transform::MakeTranslation(x, 0);
+}
+
+// Replays one layer's recorded paint, so the copy keeps looking like the
+// original after the original changes.
+class RecordedPainter : public ui::LayerDelegate {
+ public:
+  explicit RecordedPainter(ui::Layer& source) : size_(source.size()) {
+    auto list = base::MakeRefCounted<cc::DisplayItemList>();
+    source.delegate()->OnPaintLayer(ui::PaintContext(
+        list.get(), source.device_scale_factor(), gfx::Rect(size_),
+        source.GetCompositor()->is_pixel_canvas()));
+    list->Finalize();
+    record_ = list->paint_op_buffer().DeepCopyAsRecord();
+  }
+  RecordedPainter(const RecordedPainter&) = delete;
+  RecordedPainter& operator=(const RecordedPainter&) = delete;
+  ~RecordedPainter() override = default;
+
+  // ui::LayerDelegate:
+  void OnPaintLayer(const ui::PaintContext& context) override {
+    // The record is already in the context's space, so it's replayed
+    // without the recorder's own scale.
+    ui::PaintRecorder recorder(
+        context,
+        gfx::ScaleToRoundedSize(size_, context.is_pixel_canvas()
+                                           ? context.device_scale_factor()
+                                           : 1.0f),
+        1.0f, 1.0f, nullptr);
+    recorder.canvas()->sk_canvas()->drawPicture(record_);
+  }
+  void OnDeviceScaleFactorChanged(float old_device_scale_factor,
+                                  float new_device_scale_factor) override {}
+
+ private:
+  const gfx::Size size_;
+  cc::PaintRecord record_;
+};
+
+// The spring as a compositor curve, so it runs on the compositor thread.
+// `rest` is where the layer ends up.
+class SpringCurve : public gfx::TransformAnimationCurve {
+ public:
+  SpringCurve(const SpacePager::Spring& spring, float rest)
+      : spring_(spring), rest_(rest), duration_(spring.Duration()) {}
+  SpringCurve(const SpringCurve&) = default;
+  SpringCurve& operator=(const SpringCurve&) = delete;
+  ~SpringCurve() override = default;
+
+  // gfx::TransformAnimationCurve:
+  base::TimeDelta Duration() const override { return duration_; }
+  std::unique_ptr<gfx::AnimationCurve> Clone() const override {
+    return std::make_unique<SpringCurve>(*this);
+  }
+  gfx::TransformOperations GetValue(base::TimeDelta t) const override {
+    gfx::TransformOperations operations;
+    operations.AppendTranslate(
+        rest_ + (t >= duration_ ? 0 : spring_.OffsetAt(t)), 0, 0);
+    return operations;
+  }
+  gfx::TransformOperations GetTransformedValue(
+      base::TimeDelta t,
+      gfx::TimingFunction::LimitDirection limit_direction) const override {
+    return GetValue(t);
+  }
+  bool PreservesAxisAlignment() const override { return true; }
+  bool MaximumScale(float* max_scale) const override {
+    *max_scale = 1.0f;
+    return true;
+  }
+
+ private:
+  const SpacePager::Spring spring_;
+  const float rest_;
+  const base::TimeDelta duration_;
+};
+
+// Moves a layer from the spring's offset to `rest`. ui::LayerAnimator's own
+// transitions only take fixed curves, which can't start at the swipe's
+// speed.
+class SpringElement : public ui::LayerAnimationElement {
+ public:
+  SpringElement(const SpacePager::Spring& spring, float rest)
+      : ui::LayerAnimationElement(TRANSFORM, spring.Duration()),
+        spring_(spring),
+        rest_(rest) {}
+  SpringElement(const SpringElement&) = delete;
+  SpringElement& operator=(const SpringElement&) = delete;
+  ~SpringElement() override = default;
+
+  // How far from rest the compositor has the layer now.
+  float GetOffset() const {
+    const base::TimeTicks start = effective_start_time();
+    return start.is_null() ? spring_.offset
+                           : spring_.OffsetAt(base::TimeTicks::Now() - start);
+  }
+
+  // ui::LayerAnimationElement:
+  bool IsThreaded(ui::LayerAnimationDelegate* delegate) const override {
+    return true;
+  }
+
+ protected:
+  std::string DebugName() const override { return "SpacePagerSpring"; }
+  void OnStart(ui::LayerAnimationDelegate* delegate) override {
+    delegate->SetTransformFromAnimation(
+        Translation(rest_ + spring_.offset),
+        ui::PropertyChangeReason::FROM_ANIMATION);
+  }
+  bool OnProgress(double t, ui::LayerAnimationDelegate* delegate) override {
+    if (t < 1.0) {
+      return false;
+    }
+    if (Started()) {
+      delegate->GetThreadedAnimationDelegate()->RemoveThreadedAnimation(
+          keyframe_model_id());
+    }
+    delegate->SetTransformFromAnimation(
+        Translation(rest_), ui::PropertyChangeReason::FROM_ANIMATION);
+    return true;
+  }
+  void OnGetTarget(TargetValue* target) const override {
+    target->transform = Translation(rest_);
+  }
+  void OnAbort(ui::LayerAnimationDelegate* delegate) override {
+    if (!delegate || !Started()) {
+      return;
+    }
+    delegate->GetThreadedAnimationDelegate()->RemoveThreadedAnimation(
+        keyframe_model_id());
+    delegate->SetTransformFromAnimation(
+        Translation(rest_ + GetOffset()),
+        ui::PropertyChangeReason::FROM_ANIMATION);
+  }
+  void RequestEffectiveStart(ui::LayerAnimationDelegate* delegate) override {
+    // The compositor sets the real start time when it first ticks the curve.
+    set_effective_start_time(base::TimeTicks());
+    UpdateKeyframeModelId();
+    std::unique_ptr<cc::KeyframeModel> keyframe_model =
+        cc::KeyframeModel::Create(
+            std::make_unique<SpringCurve>(spring_, rest_), keyframe_model_id(),
+            animation_group_id(),
+            cc::KeyframeModel::TargetPropertyId(
+                cc::TargetProperty::TRANSFORM));
+    keyframe_model->set_needs_synchronized_start_time(true);
+    delegate->GetThreadedAnimationDelegate()->AddThreadedAnimation(
+        std::move(keyframe_model));
+  }
+
+ private:
+  const SpacePager::Spring spring_;
+  const float rest_;
+};
+
+std::unique_ptr<ui::LayerAnimationSequence> CreateSpring(
+    const SpacePager::Spring& spring,
+    float rest) {
+  return std::make_unique<ui::LayerAnimationSequence>(
+      std::make_unique<SpringElement>(spring, rest));
+}

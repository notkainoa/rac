+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_PAGER_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_PAGER_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/containers/circular_deque.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_animation_observer.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class View;
+}  // namespace views
+
+namespace rac {
+
+// Lays a window's spaces side by side in the sidebar, as in Arc. Everything
+// below the favorites is one space's page. A switch slides the old page out
+// and the new one in, and a two-finger swipe drags the pages, then lets go
+// into a spring that keeps the swipe's speed.
+//
+// Only the current space's tabs exist as views, so the other pages are
+// recordings of how each space last looked, taken as the window left it.
+// They hold paint commands, not pixels, and are on screen only while pages
+// move. Every frame of motion changes only layer transforms, and the spring
+// runs on the compositor thread, so it stays smooth while the new space
+// loads.
+class SpacePager : public SpacesWindowManager::Observer,
+                   public ui::LayerAnimationObserver {
+ public:
+  // Returns the view that slides as the page: the open tabs below the
+  // favorites. Null while there isn't one.
+  using PageGetter = base::RepeatingCallback<views::View*()>;
+
+  // Null for windows without spaces.
+  static std::unique_ptr<SpacePager> Create(BrowserWindowInterface* browser,
+                                            PageGetter get_page);
+
+  SpacePager(BrowserWindowInterface* browser,
+             SpacesWindowManager* manager,
+             PageGetter get_page);
+  SpacePager(const SpacePager&) = delete;
+  SpacePager& operator=(const SpacePager&) = delete;
+  ~SpacePager() override;
+
+  // Starts dragging the pages with a swipe. Returns false when the pages
+  // can't follow the fingers: the sidebar isn't showing, or the system asks
+  // for reduced motion.
+  bool BeginDrag();
+  // `delta` is the swipe's horizontal scroll delta. Negative moves toward
+  // the next space.
+  void UpdateDrag(float delta);
+  // Settles on a page, switching spaces if the swipe went far or fast
+  // enough.
+  void EndDrag();
+  bool is_dragging() const { return dragging_; }
+
+  // SpacesWindowManager::Observer:
+  void OnWindowSpaceWillChange(BrowserWindowInterface* browser) override;
+  void OnActiveSpaceChanged(BrowserWindowInterface* browser,
+                            const std::optional<SpaceId>& previous,
+                            const std::optional<SpaceId>& current) override;
+  void OnWindowSpaceChanged(BrowserWindowInterface* browser) override;
+  void OnSpacesChanged() override;
+
+  // ui::LayerAnimationObserver:
+  void OnLayerAnimationEnded(ui::LayerAnimationSequence* sequence) override;
+  void OnLayerAnimationAborted(ui::LayerAnimationSequence* sequence) override;
+  void OnLayerAnimationScheduled(
+      ui::LayerAnimationSequence* sequence) override {}
+
+  // A critically damped spring, as Arc settles its pages: no bounce, and it
+  // starts at the speed it's given.
+  struct Spring {
+    // Distance from the resting place, and speed, in DIPs and DIPs per
+    // second.
+    float offset = 0;
+    float velocity = 0;
+
+    float OffsetAt(base::TimeDelta time) const;
+    float VelocityAt(base::TimeDelta time) const;
+    // When it's close enough to rest to stop.
+    base::TimeDelta Duration() const;
+  };
+
+ private:
+  class Page;
+
+  // The open tabs and everything else that slides. Null while the sidebar
+  // isn't showing.
+  views::View* GetPage() const;
+  // How far apart the pages are.
+  float GetPageSpacing() const;
+  std::optional<SpaceId> GetAdjacentSpace(int direction) const;
+  // Where the page is drawn right now, mid-spring included.
+  float GetOffset() const;
+  // Stops any spring where it is and puts the other pages away.
+  float Stop();
+  // Shows the recorded pages beside the current one, for a drag.
+  void ShowNeighbors();
+  void ShowPage(Page* page, float position);
+  void HidePages();
+  void SetOffset(float offset);
+  void Settle(float offset, float velocity);
+  void CrossFade(std::unique_ptr<Page> page);
+  // Deletes the faded page once its animator is done with it.
+  void PostClearFade();
+  void ClearFade();
+  // Keeps `page`, the space's latest look, until the window shows it again.
+  void Remember(const SpaceId& space, std::unique_ptr<Page> page);
+  Page* Recall(const SpaceId& space);
+  float RubberBand(float offset) const;
+  float GetDragVelocity() const;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<SpacesWindowManager> manager_;
+  const PageGetter get_page_;
+
+  // Each space's last look, by space.
+  std::map<SpaceId, std::unique_ptr<Page>> pages_;
+  // The recorded pages on screen, and where each rests beside the live one.
+  struct Shown {
+    raw_ptr<Page> page;
+    float position;
+  };
+  std::vector<Shown> shown_;
+  // Holds the recorded pages while they're on screen.
+  std::unique_ptr<ui::Layer> clip_;
+  // The page leaving during a switch, until it's known where it goes.
+  std::unique_ptr<Page> leaving_;
+  // Where the leaving page was when the switch started.
+  float leaving_offset_ = 0;
+  // Under reduced motion, the old page fading out over the new one.
+  std::unique_ptr<Page> fading_;
+  raw_ptr<ui::LayerAnimationSequence> fading_sequence_ = nullptr;
+  // The space list changed while pages were showing; forget them after.
+  bool stale_ = false;
+
+  bool dragging_ = false;
+  // The fingers' travel, before rubber banding.
+  float drag_offset_ = 0;
+  struct Sample {
+    base::TimeTicks time;
+    float offset;
+  };
+  base::circular_deque<Sample> samples_;
+  // Set while a swipe switches spaces, so the switch starts where the
+  // swipe let go.
+  std::optional<Spring> release_;
+
+  raw_ptr<ui::LayerAnimationSequence> settling_ = nullptr;
+  // True while stopping the spring on purpose, which keeps the pages.
+  bool stopping_ = false;
+
+  base::ScopedObservation<SpacesWindowManager, SpacesWindowManager::Observer>
+      manager_observation_{this};
+  base::WeakPtrFactory<SpacePager> weak_ptr_factory_{this};
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_PAGER_H_

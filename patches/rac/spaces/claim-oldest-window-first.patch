Index: src/chrome/browser/ui/rac/spaces/spaces_window_manager.cc
===================================================================
--- src.orig/chrome/browser/ui/rac/spaces/spaces_window_manager.cc
+++ src/chrome/browser/ui/rac/spaces/spaces_window_manager.cc
@@ -723,8 +723,22 @@ void SpacesWindowManager::ScheduleReconc
 
 void SpacesWindowManager::OnStoreReady() {
   store_ready_ = true;
-  for (auto& [browser, state] : windows_) {
-    ScheduleReconcile(*state);
+  // Windows claim spaces in the order they opened, oldest first. A window
+  // opened while the store was loading must not take the space the first
+  // window already shows; that would move the first window, tabs and all,
+  // to another space. `windows_` is keyed by pointer, so its order is
+  // arbitrary, and a posted reconcile could run after the new window's.
+  std::vector<BrowserWindowInterface*> browsers;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&browsers](BrowserWindowInterface* browser) {
+        browsers.push_back(browser);
+        return true;
+      },
+      BrowserCollection::Order::kCreation);
+  for (BrowserWindowInterface* browser : browsers) {
+    if (FindState(browser)) {
+      ReconcileWindow(browser);
+    }
   }
 }
 

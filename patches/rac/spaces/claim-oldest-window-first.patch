+// The theme a window that hasn't claimed its space yet is about to show, so
+// its first frames already paint that wash instead of the plain frame color.
+// The claim waits for the spaces file, but the spaces list is a pref, so this
+// reads only memory. It mirrors SpacesWindowManager::OnStoreReady: older
+// unclaimed windows claim first, so the spaces they will take are skipped.
+// A window that will create a new space gets that preset in `new_space`.
+const SpaceTheme* PredictedTheme(SpacesWindowManager& manager,
+                                 BrowserWindowInterface* browser,
+                                 std::optional<SpaceTheme>& new_space) {
+  std::set<base::Uuid> taken;
+  size_t new_spaces = 0;
+  const Space* predicted = nullptr;
+  ProfileBrowserCollection::GetForProfile(browser->GetProfile())
+      ->ForEach(
+          [&](BrowserWindowInterface* other) {
+            const Space* space = PredictedSpace(manager, other, taken);
+            if (other == browser) {
+              predicted = space;
+              return false;
+            }
+            if (SpacesWindowManager::From(other) == &manager &&
+                !manager.GetSpaceForWindow(other)) {
+              if (space) {
+                taken.insert(space->id);
+              } else {
+                ++new_spaces;
+              }
+            }
+            return true;
+          },
+          BrowserCollection::Order::kCreation);
+  if (predicted) {
+    return &predicted->theme;
+  }
+  return &new_space.emplace(
+      SpaceTheme::Preset(manager.spaces()->spaces().size() + new_spaces));
 }
 

+// The theme of the wash `browser` paints: its active space's, or, before the
+// window claims one, the predicted space's. Null for a window pointing at a
+// space held elsewhere, which keeps the plain frame. `new_space` is as for
+// PredictedTheme.
+const SpaceTheme* GetWashTheme(SpacesWindowManager& manager,
+                               BrowserWindowInterface* browser,
+                               std::optional<SpaceTheme>& new_space) {
+  if (const auto active = manager.GetActiveSpaceId(browser)) {
+    const Space* space = manager.spaces()->FindSpace(*active);
+    return space ? &space->theme : nullptr;
+  }
+  if (manager.GetSpaceForWindow(browser)) {
+    return nullptr;
+  }
+  return PredictedTheme(manager, browser, new_space);
+}
+
+// Dia's neutral theme is monochrome: a flat gray window with no tint (its
+// Monochrome sidebar art and its opaque window stand-in).
+bool IsNeutral(const SpaceTheme& theme) {
+  const SpaceTheme neutral = SpaceTheme::Preset(0);
+  return theme.color1 == neutral.color1 && theme.color2 == neutral.color2;
+}
+
 }  // namespace
 
 bool HasWindowWash(const views::View& view) {
   return GetWashedBrowserView(view);
 }
 
+std::optional<SkColor> GetActiveTabFill(const views::View& view) {
+  const views::Widget* widget = view.GetWidget();
+  BrowserView* browser_view = GetWashedBrowserView(view);
+  if (!widget || !browser_view ||
+      widget->GetColorMode() != ui::ColorProviderKey::ColorMode::kDark) {
+    return std::nullopt;
+  }
+  SpacesWindowManager* manager =
+      SpacesWindowManager::From(browser_view->browser());
+  std::optional<SpaceTheme> new_space;
+  const SpaceTheme* theme =
+      manager ? GetWashTheme(*manager, browser_view->browser(), new_space)
+              : nullptr;
+  if (!theme || !IsNeutral(*theme)) {
+    return std::nullopt;
+  }
+  // Dia's dark selected tab is black, which reads on its colored washes but
+  // is 1.18:1 on Neutral's flat #181818. Raise it to an opaque gray instead,
+  // like Dia's Monochrome art, a step above a hovered tab (#3D3D3D). Opaque,
+  // so the white shadow under it doesn't show through.
+  return SkColorSetRGB(0x42, 0x42, 0x42);
+}

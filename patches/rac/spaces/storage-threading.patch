+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/spaces_store.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/task_environment.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+class SpacesStoreTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+  void TearDown() override { task_environment_.RunUntilIdle(); }
+
+  StoredSpace MakeSpace(const base::Uuid& id, const std::string& marker) {
+    StoredSpace space;
+    space.space = id;
+    space.unknown_fields.Set("marker", marker);
+    return space;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME,
+      base::test::TaskEnvironment::ThreadPoolExecutionMode::QUEUED};
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(SpacesStoreTest, DelayedSaveDoesNotBlockUIThread) {
+  SpacesStore store(dir_.GetPath());
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  store.Put(MakeSpace(id, "saved"));
+
+  {
+    // The browser disallows blocking once its main loop starts. Exercise the
+    // same timer-driven save that runs just after creating a new space.
+    base::ScopedDisallowBlocking disallow_blocking;
+    task_environment_.FastForwardBy(base::Seconds(1));
+  }
+
+  EXPECT_FALSE(store.HasPendingWrite());
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  ASSERT_TRUE(reloaded.Find(id));
+  EXPECT_EQ(*reloaded.Find(id)->unknown_fields.FindString("marker"), "saved");
+}
+
+TEST_F(SpacesStoreTest, ExplicitSaveQueuesIOAndOutlivesStore) {
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  {
+    SpacesStore store(dir_.GetPath());
+    store.Put(MakeSpace(id, "saved"));
+    base::ScopedDisallowBlocking disallow_blocking;
+    store.SaveNow();
+    EXPECT_FALSE(store.HasPendingWrite());
+  }
+  // No disk work runs until the background tasks are allowed to execute.
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("rac spaces")));
+  task_environment_.RunUntilIdle();
+
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  ASSERT_TRUE(reloaded.Find(id));
+  EXPECT_EQ(*reloaded.Find(id)->unknown_fields.FindString("marker"), "saved");
+}
+
+TEST_F(SpacesStoreTest, DestructionFlushesPendingSaveWithoutBlocking) {
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  auto store = std::make_unique<SpacesStore>(dir_.GetPath());
+  store->Put(MakeSpace(id, "saved on quit"));
+  {
+    base::ScopedDisallowBlocking disallow_blocking;
+    store.reset();
+  }
+  task_environment_.RunUntilIdle();
+
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  ASSERT_TRUE(reloaded.Find(id));
+  EXPECT_EQ(*reloaded.Find(id)->unknown_fields.FindString("marker"),
+            "saved on quit");
+}
+
+TEST_F(SpacesStoreTest, SavesRemainOrderedAndKeepPreviousSnapshot) {
+  SpacesStore store(dir_.GetPath());
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  {
+    base::ScopedDisallowBlocking disallow_blocking;
+    store.Put(MakeSpace(id, "first"));
+    store.SaveNow();
+    store.Put(MakeSpace(id, "second"));
+    store.SaveNow();
+  }
+  task_environment_.RunUntilIdle();
+
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  ASSERT_TRUE(reloaded.Find(id));
+  EXPECT_EQ(*reloaded.Find(id)->unknown_fields.FindString("marker"), "second");
+
+  // A damaged primary file should restore the previous completed save.
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().AppendASCII("rac spaces"), "{"));
+  SpacesStore fallback(dir_.GetPath());
+  fallback.Load();
+  ASSERT_TRUE(fallback.Find(id));
+  EXPECT_EQ(*fallback.Find(id)->unknown_fields.FindString("marker"), "first");
+}
+
+TEST_F(SpacesStoreTest, CoalescesChangesUntilOneSecondAfterLastChange) {
+  SpacesStore store(dir_.GetPath());
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  store.Put(MakeSpace(id, "first"));
+  task_environment_.FastForwardBy(base::Milliseconds(500));
+  store.Put(MakeSpace(id, "second"));
+  task_environment_.FastForwardBy(base::Milliseconds(999));
+  EXPECT_TRUE(store.HasPendingWrite());
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("rac spaces")));
+  {
+    base::ScopedDisallowBlocking disallow_blocking;
+    task_environment_.FastForwardBy(base::Milliseconds(1));
+  }
+
+  EXPECT_FALSE(store.HasPendingWrite());
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("rac spaces.bak")));
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  ASSERT_TRUE(reloaded.Find(id));
+  EXPECT_EQ(*reloaded.Find(id)->unknown_fields.FindString("marker"), "second");
+}
+
+TEST_F(SpacesStoreTest, RemovalIsSavedWithoutBlocking) {
+  SpacesStore store(dir_.GetPath());
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  store.Put(MakeSpace(id, "saved"));
+  store.SaveNow();
+  task_environment_.RunUntilIdle();
+
+  {
+    base::ScopedDisallowBlocking disallow_blocking;
+    store.Remove(id);
+    task_environment_.FastForwardBy(base::Seconds(1));
+  }
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  EXPECT_FALSE(reloaded.Find(id));
+}
+
+TEST_F(SpacesStoreTest, SaveWithoutChangesDoesNotOverwriteBackup) {
+  SpacesStore store(dir_.GetPath());
+  const base::Uuid id = base::Uuid::GenerateRandomV4();
+  store.Put(MakeSpace(id, "first"));
+  store.SaveNow();
+  task_environment_.RunUntilIdle();
+  store.Put(MakeSpace(id, "second"));
+  store.SaveNow();
+  task_environment_.RunUntilIdle();
+  {
+    base::ScopedDisallowBlocking disallow_blocking;
+    store.SaveNow();
+    task_environment_.RunUntilIdle();
+  }
+
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().AppendASCII("rac spaces"), "{"));
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  ASSERT_TRUE(reloaded.Find(id));
+  EXPECT_EQ(*reloaded.Find(id)->unknown_fields.FindString("marker"), "first");
+}
+

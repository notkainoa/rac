+bool SpaceSwitcherView::IsCommandIdEnabled(int command_id) const {
+  if (!manager_ || !menu_space_) {
+    return false;
+  }
+  SpacesService* spaces = manager_->spaces();
+  const std::optional<size_t> index = spaces->GetIndex(*menu_space_);
+  switch (command_id) {
+    case kMoveLeftCommand:
+      return index && *index > 0;
+    case kMoveRightCommand:
+      return index && *index + 1 < spaces->spaces().size();
+    case kUnloadCommand:
+      return !manager_->GetWindowHoldingSpace(*menu_space_) &&
+             !manager_->IsSpaceUnloaded(*menu_space_) &&
+             manager_->GetTabCount(*menu_space_) > 0;
+    case kDeleteCommand:
+      return spaces->spaces().size() > 1;
+    default:
+      return true;
+  }
+}
+
+void SpaceSwitcherView::ExecuteCommand(int command_id, int event_flags) {
+  if (!manager_ || !menu_space_) {
+    return;
+  }
+  const base::Uuid space = *menu_space_;
+  SpacesService* spaces = manager_->spaces();
+  const std::optional<size_t> index = spaces->GetIndex(space);
+  switch (command_id) {
+    case kRenameCommand:
+      ShowRenameSpaceBubble(menu_anchor_, spaces, space);
+      break;
+    case kMoveLeftCommand:
+      if (index && *index > 0) {
+        spaces->MoveSpace(space, *index - 1);
+      }
+      break;
+    case kMoveRightCommand:
+      if (index && *index + 1 < spaces->spaces().size()) {
+        spaces->MoveSpace(space, *index + 1);
+      }
+      break;
+    case kUnloadCommand:
+      manager_->UnloadSpace(space);
+      break;
+    case kDeleteCommand:
+      ShowDeleteSpaceBubble(menu_anchor_, manager_, space);
+      break;
+  }
+}
+
+void SpaceSwitcherView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto* dot = views::AsViewClass<SpaceDotButton>(source);
+  if (!dot || !manager_) {
+    return;
+  }
+  menu_space_ = dot->space();
+  menu_anchor_ = dot;
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItemWithStringId(kRenameCommand, IDS_RAC_SPACES_RENAME);
+  menu_model_->AddItemWithStringId(kMoveLeftCommand,
+                                   IDS_RAC_SPACES_MOVE_LEFT);
+  menu_model_->AddItemWithStringId(kMoveRightCommand,
+                                   IDS_RAC_SPACES_MOVE_RIGHT);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kUnloadCommand, IDS_RAC_SPACES_UNLOAD);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kDeleteCommand, IDS_RAC_SPACES_DELETE);
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                          source->GetBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
 void SpaceSwitcherView::SetOrientation(bool collapsed) {
   layout_->SetOrientation(collapsed ? views::LayoutOrientation::kVertical
                                     : views::LayoutOrientation::kHorizontal);

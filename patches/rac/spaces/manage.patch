+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kSpaceNameFieldId);
+
+std::u16string SpaceDisplayName(SpacesService* spaces,
+                                const base::Uuid& space) {
+  const Space* found = spaces->FindSpace(space);
+  if (found && !found->name.empty()) {
+    return base::UTF8ToUTF16(found->name);
+  }
+  if (std::optional<size_t> index = spaces->GetIndex(space)) {
+    return l10n_util::GetStringFUTF16(IDS_RAC_SPACE_FALLBACK_NAME,
+                                      base::NumberToString16(*index + 1));
+  }
+  return std::u16string();
+}
+
+// The delegate of the rename bubble; saves the field's text on Rename.
+class RenameSpaceDelegate : public ui::DialogModelDelegate {
+ public:
+  RenameSpaceDelegate(SpacesService* spaces, const base::Uuid& space)
+      : spaces_(spaces), space_(space) {}
+
+  void OnRename() {
+    std::u16string name =
+        dialog_model()->GetTextfieldByUniqueId(kSpaceNameFieldId)->text();
+    spaces_->RenameSpace(space_,
+                         base::UTF16ToUTF8(base::CollapseWhitespace(
+                             name, /*trim_sequences_with_line_breaks=*/true)));
+  }
+
+ private:
+  const raw_ptr<SpacesService> spaces_;
+  const base::Uuid space_;
+};
+
+}  // namespace
+
+void ShowRenameSpaceBubble(views::View* anchor,
+                           SpacesService* spaces,
+                           const base::Uuid& space) {
+  const Space* found = spaces->FindSpace(space);
+  if (!found) {
+    return;
+  }
+  auto delegate = std::make_unique<RenameSpaceDelegate>(spaces, space);
+  auto* delegate_ptr = delegate.get();
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetInternalName("rac::RenameSpace")
+          .SetTitle(l10n_util::GetStringUTF16(IDS_RAC_SPACES_RENAME_TITLE))
+          .AddTextfield(kSpaceNameFieldId,
+                        l10n_util::GetStringUTF16(IDS_RAC_SPACES_RENAME_FIELD),
+                        base::UTF8ToUTF16(found->name))
+          .AddOkButton(
+              base::BindOnce(&RenameSpaceDelegate::OnRename,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params()
+                  .SetLabel(l10n_util::GetStringUTF16(
+                      IDS_RAC_SPACES_RENAME_CONFIRM))
+                  .SetStyle(ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::BindOnce([]() {}))
+          .Build();
+
+  auto host = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::TOP_CENTER);
+  auto widget =
+      views::BubbleDialogDelegate::CreateBubble(host.release());
+  // The bubble deletes itself once closed.
+  widget->MakeCloseSynchronous(base::BindOnce(
+      [](std::unique_ptr<views::Widget> closed,
+         views::Widget::ClosedReason) {},
+      std::move(widget)));
+  widget->Show();
+}
+
+void ShowDeleteSpaceBubble(views::View* anchor,
+                           SpacesWindowManager* manager,
+                           const base::Uuid& space) {
+  const size_t tab_count = manager->GetTabCount(space);
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetInternalName("rac::DeleteSpace")
+          .SetTitle(l10n_util::GetStringFUTF16(
+              IDS_RAC_SPACES_DELETE_TITLE,
+              SpaceDisplayName(manager->spaces(), space)))
+          .AddParagraph(ui::DialogModelLabel(
+              l10n_util::GetPluralStringFUTF16(IDS_RAC_SPACES_DELETE_BODY,
+                                               tab_count)))
+          .AddOkButton(
+              base::BindOnce(&SpacesWindowManager::DeleteSpace,
+                             base::Unretained(manager), space),
+              ui::DialogModel::Button::Params()
+                  .SetLabel(l10n_util::GetStringUTF16(
+                      IDS_RAC_SPACES_DELETE_CONFIRM))
+                  .SetStyle(ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::BindOnce([]() {}))
+          .Build();
+
+  auto host = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::TOP_CENTER);
+  auto widget =
+      views::BubbleDialogDelegate::CreateBubble(host.release());
+  // The bubble deletes itself once closed.
+  widget->MakeCloseSynchronous(base::BindOnce(
+      [](std::unique_ptr<views::Widget> closed,
+         views::Widget::ClosedReason) {},
+      std::move(widget)));
+  widget->Show();
+}
+
+}  // namespace rac

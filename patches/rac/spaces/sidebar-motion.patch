@@ -0,0 +1,138 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/spaces/space_tab_list_header.h"
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "chrome/browser/rac/spaces/spaces_service.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/grit/generated_resources.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_animator.h"
+#include "ui/compositor/scoped_layer_animation_settings.h"
+#include "ui/gfx/animation/animation.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/fill_layout.h"
+
+namespace rac {
+
+BEGIN_METADATA(SpaceTabListHeader)
+END_METADATA
+
+SpaceTabListHeader::SpaceTabListHeader(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser), manager_(SpacesWindowManager::From(browser)) {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+  label_ = AddChildView(std::make_unique<views::Label>());
+  label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label_->SetEnabledColor(kColorToolbarButtonIcon);
+  label_->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(5, 12, 5, 12)));
+  if (!manager_) {
+    SetVisible(false);
+    return;
+  }
+  manager_->AddObserver(this);
+  if (state_controller) {
+    collapsed_ = state_controller->GetCollapseState() !=
+                 tabs::VerticalTabStripCollapseState::kExpanded;
+    collapse_subscription_ =
+        state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+            [](SpaceTabListHeader* self,
+               tabs::VerticalTabStripCollapseState state) {
+              self->collapsed_ =
+                  state != tabs::VerticalTabStripCollapseState::kExpanded;
+              self->UpdateTitle();
+            },
+            base::Unretained(this)));
+  }
+  UpdateTitle();
+}
+
+SpaceTabListHeader::~SpaceTabListHeader() {
+  if (manager_) {
+    manager_->RemoveObserver(this);
+  }
+}
+
+void SpaceTabListHeader::SetTabList(views::View* tab_list) {
+  tab_list_ = tab_list;
+}
+
+void SpaceTabListHeader::OnActiveSpaceChanged(
+    BrowserWindowInterface* browser,
+    const std::optional<SpaceId>& previous,
+    const std::optional<SpaceId>& current) {
+  if (browser != browser_) {
+    return;
+  }
+  UpdateTitle();
+  if (previous && current && !collapsed_ && GetVisible()) {
+    AnimateTabList(*previous, *current);
+  }
+}
+
+void SpaceTabListHeader::OnWindowSpaceChanged(BrowserWindowInterface* browser) {
+  if (browser == browser_) {
+    UpdateTitle();
+  }
+}
+
+void SpaceTabListHeader::OnSpacesChanged() {
+  UpdateTitle();
+}
+
+void SpaceTabListHeader::UpdateTitle() {
+  const auto active =
+      manager_ ? manager_->GetActiveSpaceId(browser_) : std::nullopt;
+  const Space* space =
+      active ? manager_->spaces()->FindSpace(*active) : nullptr;
+  SetVisible(space && !collapsed_);
+  if (!space) {
+    return;
+  }
+  const auto index = manager_->spaces()->GetIndex(*active);
+  label_->SetText(space->name.empty()
+                      ? l10n_util::GetStringFUTF16(
+                            IDS_RAC_SPACE_FALLBACK_NAME,
+                            base::NumberToString16(index.value_or(0) + 1))
+                      : base::UTF8ToUTF16(space->name));
+}
+
+void SpaceTabListHeader::AnimateTabList(const SpaceId& previous,
+                                        const SpaceId& current) {
+  if (!tab_list_ || !tab_list_->GetVisible() || !tab_list_->layer()) {
+    return;
+  }
+  ui::Layer* layer = tab_list_->layer();
+  layer->GetAnimator()->StopAnimating();
+  // The model has already changed. Bring the new list in without holding
+  // input or retaining an image of the old tabs.
+  layer->SetOpacity(0.35f);
+  const bool reduced_motion = gfx::Animation::PrefersReducedMotion();
+  gfx::Transform start;
+  if (!reduced_motion) {
+    const size_t before = manager_->spaces()->GetIndex(previous).value_or(0);
+    const size_t after = manager_->spaces()->GetIndex(current).value_or(0);
+    start.Translate(after > before ? 24 : -24, 0);
+  }
+  layer->SetTransform(start);
+  ui::ScopedLayerAnimationSettings animation(layer->GetAnimator());
+  animation.SetTransitionDuration(
+      base::Milliseconds(reduced_motion ? 140 : 180));
+  animation.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+  layer->SetOpacity(1.0f);
+  layer->SetTransform(gfx::Transform());
+}
+
+}  // namespace rac

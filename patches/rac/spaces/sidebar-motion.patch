+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_TAB_LIST_HEADER_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_TAB_LIST_HEADER_H_
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+namespace tabs {
+class VerticalTabStripStateController;
+}
+namespace views {
+class Label;
+}
+
+namespace rac {
+
+// The space title above the tab list, and its compositor-only page transition.
+class SpaceTabListHeader : public views::View,
+                           public SpacesWindowManager::Observer {
+  METADATA_HEADER(SpaceTabListHeader, views::View)
+
+ public:
+  SpaceTabListHeader(BrowserWindowInterface* browser,
+                     tabs::VerticalTabStripStateController* state_controller);
+  ~SpaceTabListHeader() override;
+
+  // The tab strip may be reset when the layout changes.
+  void SetTabList(views::View* tab_list);
+
+  void OnActiveSpaceChanged(BrowserWindowInterface* browser,
+                            const std::optional<SpaceId>& previous,
+                            const std::optional<SpaceId>& current) override;
+  void OnWindowSpaceChanged(BrowserWindowInterface* browser) override;
+  void OnSpacesChanged() override;
+
+ private:
+  void UpdateTitle();
+  void AnimateTabList(const SpaceId& previous, const SpaceId& current);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<SpacesWindowManager> manager_;
+  raw_ptr<views::Label> label_ = nullptr;
+  raw_ptr<views::View> tab_list_ = nullptr;
+  bool collapsed_ = false;
+  base::CallbackListSubscription collapse_subscription_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_TAB_LIST_HEADER_H_

+// sRGB "#RRGGBB" to OKLab, to measure how far two colors look apart.
+Lab ToLab(std::string_view hex) {
+  auto channel = [&](size_t i) {
+    const double c =
+        std::stoi(std::string(hex.substr(1 + 2 * i, 2)), nullptr, 16) / 255.0;
+    return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4);
+  };
+  const double r = channel(0), g = channel(1), b = channel(2);
+  const double l = std::cbrt(0.4122214708 * r + 0.5363325363 * g +
+                             0.0514459929 * b);
+  const double m = std::cbrt(0.2119034982 * r + 0.6806995451 * g +
+                             0.1073969566 * b);
+  const double s = std::cbrt(0.0883024619 * r + 0.2817188376 * g +
+                             0.6299787005 * b);
+  return {0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+          1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+          0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s};
+}
+
+double Distance(std::string_view a, std::string_view b) {
+  const Lab x = ToLab(a);
+  const Lab y = ToLab(b);
+  return std::hypot(x.L - y.L, x.a - y.a, x.b - y.b);
+}
+
+TEST(SpaceColorsTest, DerivesTheDarkPairFromTheLightPair) {
+  for (const Case& c : kCases) {
+    SCOPED_TRACE(c.name);
+    EXPECT_EQ(DeriveDarkStops(c.color1, c.color2), Stops(c.dark1, c.dark2));
+  }
+}
+
+TEST(SpaceColorsTest, AFlatPairStaysFlat) {
+  for (const char* color :
+       {"#FF6B6B", "#5E4AE3", "#F4F1EA", "#3A3A3C", "#FF0080", "#00FF00"}) {
+    SCOPED_TRACE(color);
+    const SpaceStops dark = DeriveDarkStops(color, color);
+    EXPECT_EQ(dark.first, dark.second);
+  }
+  // Letter case doesn't make a pair a gradient.
+  const SpaceStops lower = DeriveDarkStops("#ff6b6b", "#FF6B6B");
+  EXPECT_EQ(lower.first, lower.second);
+  EXPECT_EQ(lower, DeriveDarkStops("#FF6B6B", "#FF6B6B"));
+  // Nor does a difference too small to see under the wash.
+  const SpaceStops near = DeriveDarkStops("#FF6B6B", "#FF6C6B");
+  EXPECT_EQ(near.first, near.second);
+  // But a real gradient doesn't collapse.
+  const SpaceStops gradient = DeriveDarkStops("#5E4AE3", "#9B8CFF");
+  EXPECT_NE(gradient.first, gradient.second);
+}
+
+TEST(SpaceColorsTest, TitlesReadAtTheFloorInBothModes) {
+  for (const Case& c : kCases) {
+    SCOPED_TRACE(c.name);
+    const SpaceStops light =
+        WithTitleContrastFloor(Stops(c.color1, c.color2), false);
+    EXPECT_GE(TitleContrast(light.first, light.second, false), 4.5);
+    const SpaceStops dark = WithTitleContrastFloor(
+        DeriveDarkStops(c.color1, c.color2), true);
+    EXPECT_GE(TitleContrast(dark.first, dark.second, true), 4.5);
+  }
+}
+
+// No color can fall under 4.5:1. The wash is only 30% (light) or 18% (dark)
+// of the stop, so the worst colors are black in light (5.43:1) and white in
+// dark (6.70:1). The floor is there for a change to those numbers, and
+// until then it must leave every stop as it is.
+TEST(SpaceColorsTest, TheFloorLeavesEveryColorAsItIs) {
+  for (const Case& c : kCases) {
+    SCOPED_TRACE(c.name);
+    EXPECT_EQ(WithTitleContrastFloor(Stops(c.color1, c.color2), false),
+              Stops(c.color1, c.color2));
+    EXPECT_EQ(WithTitleContrastFloor(Stops(c.dark1, c.dark2), true),
+              Stops(c.dark1, c.dark2));
+  }
+  EXPECT_GE(TitleContrast("#000000", "#000000", false), 4.5);
+  EXPECT_GE(TitleContrast("#FFFFFF", "#FFFFFF", true), 4.5);
+}
+
+struct Preset {
+  const char* name;
+  const char* light1;
+  const char* light2;
+  const char* dia_dark1;
+  const char* dia_dark2;
+};
+
+// Dia's pairs, as in space.cc. Presets paint these, not derived pairs. The
+// rule is fitted to them, so they show how close it comes.
+constexpr Preset kDiaPresets[] = {
+    {"Red", "#C1575C", "#FCD098", "#CC4A55", "#632E20"},
+    {"Orange", "#D87249", "#FFD1B1", "#C95125", "#65251A"},
+    {"Yellow", "#E3AC38", "#F9E6C0", "#C98400", "#60371E"},
+    {"Green", "#3EB489", "#C8E8AD", "#008B5D", "#00544D"},
+    {"Blue", "#3A88C4", "#CFEFE9", "#007FBD", "#004263"},
+    {"Pink", "#D37B8B", "#D4D5F0", "#BD556B", "#4E5081"},
+    {"Purple", "#5F5B9E", "#E2BEBF", "#625DA5", "#562F43"},
+};
+
+// Neutral is left out. Its stops only name the theme (the window paints it
+// as flat gray), and Dia's dark pair for it is a blue and a pink that no
+// rule would find from its light pair.
+TEST(SpaceColorsTest, DerivedDarkPairsAreNearDiasOwn) {
+  for (const Preset& preset : kDiaPresets) {
+    SCOPED_TRACE(preset.name);
+    const SpaceStops derived =
+        DeriveDarkStops(preset.light1, preset.light2);
+    EXPECT_LT(Distance(derived.first, preset.dia_dark1), 0.06);
+    // Pink's second stop is the outlier, 0.093 away: Dia turns it blue.
+    EXPECT_LT(Distance(derived.second, preset.dia_dark2), 0.10);
+  }
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/space_colors.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <limits>
+#include <numbers>
+
+#include "base/check.h"
+#include "base/strings/stringprintf.h"
+
+// Each step below is rounded to a double on its own, so the 8-bit results
+// don't depend on whether the compiler fuses a multiply and an add.
+#pragma STDC FP_CONTRACT OFF
+
+namespace rac {
+
+namespace {
+
+// Dia only hand-tuned dark pairs for its seven presets. A color the user
+// picks gets a dark pair from a rule fitted to those pairs, in OKLCH
+// (Bjorn Ottosson's OKLab) so that it keeps its hue as it darkens:
+//   dark1 = (clamp(0.58 + 0.45 * (L1 - 0.62), 0.30, 0.70), 1.12 * C1, h1)
+//   dark2 = (0.38, clamp(max(C2, 0.6 * C1), 0.05, 0.10), halfway h2 to h1)
+// A gray pair keeps dark2 gray. Presets never come through here: they keep
+// Dia's own pairs.
+
+using Rgb = std::array<double, 3>;
+
+// What PaintSpaceTint lays the stops over, and at what opacity.
+constexpr Rgb kLightBase = {1, 1, 1};
+constexpr Rgb kDarkBase = {0x1C / 255.0, 0x1A / 255.0, 0x1F / 255.0};
+constexpr double kLightAlpha = 0x4D / 255.0;
+constexpr double kDarkAlpha = 0x2E / 255.0;
+
+// kColorRacTabTitleUnselected: black at 0xAD in light, white at 0xC7 in dark.
+constexpr Rgb kTitleLight = {0, 0, 0};
+constexpr Rgb kTitleDark = {1, 1, 1};
+constexpr double kTitleLightAlpha = 0xAD / 255.0;
+constexpr double kTitleDarkAlpha = 0xC7 / 255.0;
+
+// WCAG AA for normal text.
+constexpr double kContrastFloor = 4.5;
+
+// Below this chroma a color is gray and its hue means nothing.
+constexpr double kGrayChroma = 0.02;
+
+// Two stops closer than this in OKLab look like one color under the wash,
+// so the theme counts as flat.
+constexpr double kFlatDistance = 0.02;
+
+constexpr double kRadiansPerDegree = std::numbers::pi / 180.0;
+constexpr double kDegreesPerRadian = 180.0 / std::numbers::pi;
+
+struct Oklab {
+  double L, a, b;
+};
+
+struct Oklch {
+  double L, C, h;
+};
+
+// The remainder with the sign of `y`, like a modulo on angles.
+double Modulo(double x, double y) {
+  double mod = std::fmod(x, y);
+  if (mod == 0) {
+    return std::copysign(0.0, y);
+  }
+  if ((y < 0) != (mod < 0)) {
+    mod += y;
+  }
+  return mod;
+}
+
+int HexNibble(char c) {
+  if (c >= '0' && c <= '9') {
+    return c - '0';
+  }
+  if (c >= 'a' && c <= 'f') {
+    return c - 'a' + 10;
+  }
+  if (c >= 'A' && c <= 'F') {
+    return c - 'A' + 10;
+  }
+  return -1;
+}
+
+// SpaceTheme::FromDict has already checked saved colors, so anything else is
+// a bug in the caller. Black keeps the paint code from crashing on it.
+Rgb HexToRgb(std::string_view hex) {
+  Rgb rgb = {0, 0, 0};
+  bool valid = hex.size() == 7 && hex[0] == '#';
+  for (size_t i = 0; valid && i < 3; ++i) {
+    const int high = HexNibble(hex[1 + 2 * i]);
+    const int low = HexNibble(hex[2 + 2 * i]);
+    if (high < 0 || low < 0) {
+      valid = false;
+      break;
+    }
+    rgb[i] = (high * 16 + low) / 255.0;
+  }
+  DCHECK(valid) << hex;
+  return valid ? rgb : Rgb{0, 0, 0};
+}
+
+std::string RgbToHex(const Rgb& rgb) {
+  int bytes[3];
+  for (size_t i = 0; i < 3; ++i) {
+    // The default rounding mode rounds halves to even.
+    bytes[i] = static_cast<int>(
+        std::nearbyint(std::min(1.0, std::max(0.0, rgb[i])) * 255));
+  }
+  return base::StringPrintf("#%02X%02X%02X", bytes[0], bytes[1], bytes[2]);
+}
+
+double ToLinear(double c) {
+  return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4);
+}
+
+double ToSrgb(double c) {
+  return c <= 0.0031308 ? 12.92 * c
+                        : 1.055 * std::pow(c, 1 / 2.4) - 0.055;
+}
+
+double Cbrt(double x) {
+  return std::copysign(std::pow(std::abs(x), 1.0 / 3), x);
+}
+
+Oklab RgbToOklab(const Rgb& rgb) {
+  const double r = ToLinear(rgb[0]);
+  const double g = ToLinear(rgb[1]);
+  const double b = ToLinear(rgb[2]);
+  const double l = Cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+  const double m = Cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+  const double s = Cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+  return {0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+          1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+          0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s};
+}
+
+Rgb OklabToLinear(const Oklab& lab) {
+  const double l = std::pow(lab.L + 0.3963377774 * lab.a + 0.2158037573 * lab.b,
+                            3.0);
+  const double m = std::pow(lab.L - 0.1055613458 * lab.a - 0.0638541728 * lab.b,
+                            3.0);
+  const double s = std::pow(lab.L - 0.0894841775 * lab.a - 1.2914855480 * lab.b,
+                            3.0);
+  return {4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+          -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+          -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s};
+}
+
+Oklch RgbToOklch(const Rgb& rgb) {
+  const Oklab lab = RgbToOklab(rgb);
+  return {lab.L, std::hypot(lab.a, lab.b),
+          Modulo(std::atan2(lab.b, lab.a) * kDegreesPerRadian, 360)};
+}
+
+Rgb OklchToLinear(double L, double C, double h) {
+  const double radians = h * kRadiansPerDegree;
+  return OklabToLinear({L, C * std::cos(radians), C * std::sin(radians)});
+}
+
+bool FitsSrgb(const Rgb& linear) {
+  for (double x : linear) {
+    if (!(x >= -1e-6 && x <= 1 + 1e-6)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Keeps L and h and lowers chroma until sRGB can show the color. Clipping the
+// channels instead would shift the hue.
+Rgb OklchToRgb(double L, double C, double h) {
+  if (!FitsSrgb(OklchToLinear(L, C, h))) {
+    double lo = 0.0;
+    double hi = C;
+    for (int i = 0; i < 40; ++i) {
+      const double mid = (lo + hi) / 2;
+      if (FitsSrgb(OklchToLinear(L, mid, h))) {
+        lo = mid;
+      } else {
+        hi = mid;
+      }
+    }
+    C = lo;
+  }
+  const Rgb linear = OklchToLinear(L, C, h);
+  Rgb rgb;
+  for (size_t i = 0; i < 3; ++i) {
+    rgb[i] = ToSrgb(std::min(1.0, std::max(0.0, linear[i])));
+  }
+  return rgb;
+}
+
+double Luminance(const Rgb& rgb) {
+  return 0.2126 * ToLinear(rgb[0]) + 0.7152 * ToLinear(rgb[1]) +
+         0.0722 * ToLinear(rgb[2]);
+}
+
+double Contrast(const Rgb& a, const Rgb& b) {
+  const double la = Luminance(a);
+  const double lb = Luminance(b);
+  return (std::max(la, lb) + 0.05) / (std::min(la, lb) + 0.05);
+}
+
+// `top` at `alpha` over an opaque `bottom`, in sRGB as Skia blends.
+Rgb Over(const Rgb& top, double alpha, const Rgb& bottom) {
+  return {top[0] * alpha + bottom[0] * (1 - alpha),
+          top[1] * alpha + bottom[1] * (1 - alpha),
+          top[2] * alpha + bottom[2] * (1 - alpha)};
+}
+
+// From hue `a` toward hue `b` by `t`, the short way round.
+double MixHue(double a, double b, double t) {
+  const double d = Modulo(b - a + 180, 360) - 180;
+  return Modulo(a + d * t, 360);
+}
+
+// The stop as painted: over the window's base, at the wash's opacity.
+Rgb Wash(std::string_view stop, bool dark) {
+  return Over(HexToRgb(stop), dark ? kDarkAlpha : kLightAlpha,
+              dark ? kDarkBase : kLightBase);
+}
+
+}  // namespace
+
+SpaceStops DeriveDarkStops(std::string_view color1, std::string_view color2) {
+  const Oklch first = RgbToOklch(HexToRgb(color1));
+  const Oklch second = RgbToOklch(HexToRgb(color2));
+  const double L1 = first.L;
+  const double C1 = first.C;
+  const double C2 = second.C;
+  double h1 = first.h;
+  double h2 = second.h;
+  // A gray has no hue to keep; borrow the other stop's, else stay gray.
+  if (C1 < kGrayChroma && C2 >= kGrayChroma) {
+    h1 = h2;
+  }
+  if (C2 < kGrayChroma) {
+    h2 = h1;
+  }
+  const Oklch dark1 = {
+      std::min(0.70, std::max(0.30, 0.58 + 0.45 * (L1 - 0.62))), 1.12 * C1, h1};
+  const double chroma2 =
+      std::max(C1, C2) < kGrayChroma
+          ? 0.0
+          : std::min(0.10, std::max(0.05, std::max(C2, 0.6 * C1)));
+  const Oklch dark2 = {0.38, chroma2, MixHue(h2, h1, 0.5)};
+
+  const Rgb rgb1 = OklchToRgb(dark1.L, dark1.C, dark1.h);
+  const Rgb rgb2 = OklchToRgb(dark2.L, dark2.C, dark2.h);
+  const Oklab lab1 = RgbToOklab(HexToRgb(color1));
+  const Oklab lab2 = RgbToOklab(HexToRgb(color2));
+  if (std::hypot(lab1.L - lab2.L, lab1.a - lab2.a, lab1.b - lab2.b) <
+      kFlatDistance) {
+    // A flat theme stays flat: the OKLab midpoint of the two stops, at the
+    // color's own hue. Picked by eye over the first stop alone and over a
+    // fixed lightness; it reads as the gradient's average.
+    const Oklab a = RgbToOklab(rgb1);
+    const Oklab b = RgbToOklab(rgb2);
+    const double L = (a.L + b.L) / 2;
+    const double A = (a.a + b.a) / 2;
+    const double B = (a.b + b.b) / 2;
+    std::string flat = RgbToHex(OklchToRgb(L, std::hypot(A, B), h1));
+    return {flat, flat};
+  }
+  return {RgbToHex(rgb1), RgbToHex(rgb2)};
+}
+
+double TitleContrast(std::string_view color1,
+                     std::string_view color2,
+                     bool dark) {
+  const Rgb& title = dark ? kTitleDark : kTitleLight;
+  const double alpha = dark ? kTitleDarkAlpha : kTitleLightAlpha;
+  const Rgb a = HexToRgb(color1);
+  const Rgb b = HexToRgb(color2);
+  // Both ends and three points between, since contrast isn't linear along
+  // the gradient. Each is a stop of its own so that it is rounded to 8 bits,
+  // as the gradient's pixels are.
+  double worst = std::numeric_limits<double>::infinity();
+  for (double t : {0.0, 0.25, 0.5, 0.75, 1.0}) {
+    const Rgb mixed = {a[0] * (1 - t) + b[0] * t, a[1] * (1 - t) + b[1] * t,
+                       a[2] * (1 - t) + b[2] * t};
+    const Rgb ground = Wash(RgbToHex(mixed), dark);
+    worst = std::min(worst, Contrast(Over(title, alpha, ground), ground));
+  }
+  return worst;
+}
+
+SpaceStops WithTitleContrastFloor(SpaceStops stops, bool dark) {
+  // A step is 0.01 of lightness, so 100 steps cover the whole range.
+  for (int i = 0; i < 100; ++i) {
+    if (TitleContrast(stops.first, stops.second, dark) >= kContrastFloor) {
+      break;
+    }
+    const SpaceStops before = stops;
+    for (std::string* stop : {&stops.first, &stops.second}) {
+      const Oklch lch = RgbToOklch(HexToRgb(*stop));
+      const double L = dark ? lch.L - 0.01 : lch.L + 0.01;
+      *stop = RgbToHex(OklchToRgb(std::max(0.0, std::min(1.0, L)), lch.C,
+                                  lch.h));
+    }
+    // At black or white there's nowhere further to go.
+    if (stops == before) {
+      break;
+    }
+  }
+  return stops;
+}
+

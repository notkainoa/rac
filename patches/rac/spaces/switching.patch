+#ifndef CHROME_BROWSER_UI_RAC_SPACES_HIDDEN_SPACE_H_
+#define CHROME_BROWSER_UI_RAC_SPACES_HIDDEN_SPACE_H_
+
+#include <memory>
+#include <variant>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+
+class TabStripModel;
+struct DetachedTabCollection;
+
+namespace tabs {
+class TabInterface;
+class TabModel;
+}  // namespace tabs
+
+namespace rac {
+
+// The tabs of a space that no window shows. They're detached from every
+// window but stay alive, with their pages, groups, and splits, until a window
+// shows the space again.
+class HiddenSpace {
+ public:
+  // A single tab, or a tab group or split view with its tabs.
+  using Item = std::variant<std::unique_ptr<tabs::TabModel>,
+                            std::unique_ptr<DetachedTabCollection>>;
+
+  HiddenSpace();
+  HiddenSpace(const HiddenSpace&) = delete;
+  HiddenSpace& operator=(const HiddenSpace&) = delete;
+  HiddenSpace(HiddenSpace&&);
+  HiddenSpace& operator=(HiddenSpace&&);
+  ~HiddenSpace();
+
+  // Detaches the tabs at `indices` from `model`, keeping their order, groups,
+  // and splits. Whole groups move only when all their tabs are in `indices`.
+  // The model must keep at least one tab, or its window closes.
+  static HiddenSpace Detach(TabStripModel* model,
+                            const std::vector<int>& indices);
+
+  // Moves the tabs of `other` to the end of this space.
+  void Append(HiddenSpace other);
+
+  // Inserts the tabs at the end of `model` without activating any, and empties
+  // this space. Returns the tab that was active when the space was hidden, or
+  // the first tab inserted if that's gone. Null if there were no tabs.
+  tabs::TabInterface* InsertInto(TabStripModel* model);
+
+  bool empty() const { return items_.empty(); }
+  std::vector<tabs::TabInterface*> GetTabs() const;
+
+  tabs::TabInterface* active_tab() const { return active_tab_; }
+  void set_active_tab(tabs::TabInterface* tab) { active_tab_ = tab; }
+
+  base::TimeTicks hidden_at() const { return hidden_at_; }
+
+  // Destroys every tab. Callers record them for reopening first.
+  void Clear();
+
+ private:
+  std::vector<Item> items_;
+  // One of the tabs in `items_`, or null. Declared after `items_` so it's
+  // cleared before the tabs are destroyed.
+  raw_ptr<tabs::TabInterface> active_tab_ = nullptr;
+  base::TimeTicks hidden_at_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SPACES_HIDDEN_SPACE_H_

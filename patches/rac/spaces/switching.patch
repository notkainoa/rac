+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/spaces/hidden_space.h"
+
+#include <utility>
+
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/split_tab_collection.h"
+#include "components/tabs/public/tab_group_tab_collection.h"
+
+namespace rac {
+
+namespace {
+
+std::vector<tabs::TabInterface*> GetCollectionTabs(
+    const DetachedTabCollection& collection) {
+  if (std::holds_alternative<std::unique_ptr<tabs::TabGroupTabCollection>>(
+          collection.collection_)) {
+    return std::get<std::unique_ptr<tabs::TabGroupTabCollection>>(
+               collection.collection_)
+        ->GetTabsRecursive();
+  }
+  return std::get<std::unique_ptr<tabs::SplitTabCollection>>(
+             collection.collection_)
+      ->GetTabsRecursive();
+}
+
+bool IsGroup(const DetachedTabCollection& collection) {
+  return std::holds_alternative<std::unique_ptr<tabs::TabGroupTabCollection>>(
+      collection.collection_);
+}
+
+}  // namespace
+
+HiddenSpace::HiddenSpace() = default;
+HiddenSpace::HiddenSpace(HiddenSpace&&) = default;
+HiddenSpace& HiddenSpace::operator=(HiddenSpace&&) = default;
+
+HiddenSpace::~HiddenSpace() {
+  Clear();
+}
+
+// static
+HiddenSpace HiddenSpace::Detach(TabStripModel* model,
+                                const std::vector<int>& indices) {
+  HiddenSpace space;
+  space.hidden_at_ = base::TimeTicks::Now();
+  if (indices.empty()) {
+    return space;
+  }
+  tabs::TabInterface* const active = model->GetActiveTab();
+  for (auto& detached : model->DetachTabsAndCollectionsForInsertion(indices)) {
+    if (auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&detached)) {
+      space.items_.emplace_back(std::move((*tab)->tab));
+    } else {
+      space.items_.emplace_back(std::move(
+          std::get<std::unique_ptr<DetachedTabCollection>>(detached)));
+    }
+  }
+  for (tabs::TabInterface* tab : space.GetTabs()) {
+    if (tab == active) {
+      space.active_tab_ = tab;
+    }
+  }
+  return space;
+}
+
+void HiddenSpace::Append(HiddenSpace other) {
+  if (!active_tab_) {
+    active_tab_ = other.active_tab_;
+  }
+  other.active_tab_ = nullptr;
+  for (Item& item : other.items_) {
+    items_.push_back(std::move(item));
+  }
+  other.items_.clear();
+}
+
+tabs::TabInterface* HiddenSpace::InsertInto(TabStripModel* model) {
+  tabs::TabInterface* const active = active_tab_;
+  active_tab_ = nullptr;
+  tabs::TabInterface* first = nullptr;
+  for (Item& item : items_) {
+    if (auto* tab = std::get_if<std::unique_ptr<tabs::TabModel>>(&item)) {
+      tabs::TabInterface* raw = tab->get();
+      model->InsertDetachedTabAt(model->count(), std::move(*tab),
+                                 AddTabTypes::ADD_NONE);
+      first = first ? first : raw;
+      continue;
+    }
+    auto& collection = std::get<std::unique_ptr<DetachedTabCollection>>(item);
+    if (!first) {
+      std::vector<tabs::TabInterface*> collection_tabs =
+          GetCollectionTabs(*collection);
+      if (!collection_tabs.empty()) {
+        first = collection_tabs.front();
+      }
+    }
+    if (IsGroup(*collection)) {
+      model->InsertDetachedTabGroupAt(std::move(collection), model->count());
+    } else {
+      model->InsertDetachedSplitTabAt(std::move(collection), model->count(),
+                                      /*pinned=*/false);
+    }
+  }
+  items_.clear();
+  return active ? active : first;
+}
+
+std::vector<tabs::TabInterface*> HiddenSpace::GetTabs() const {
+  std::vector<tabs::TabInterface*> result;
+  for (const Item& item : items_) {
+    if (const auto* tab = std::get_if<std::unique_ptr<tabs::TabModel>>(&item)) {
+      result.push_back(tab->get());
+    } else {
+      for (tabs::TabInterface* collection_tab : GetCollectionTabs(
+               *std::get<std::unique_ptr<DetachedTabCollection>>(item))) {
+        result.push_back(collection_tab);
+      }
+    }
+  }
+  return result;
+}
+
+void HiddenSpace::Clear() {
+  active_tab_ = nullptr;
+  items_.clear();
+}
+
+}  // namespace rac

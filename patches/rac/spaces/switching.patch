+namespace rac {
+
+// Decides which space each window shows, and holds the tabs of spaces no
+// window shows.
+//
+// A window shows one space at a time, and a space is open in at most one
+// window. A window can also point at a space another window holds; it then
+// shows a screen saying so, with a button to move the space over. That screen
+// lives in a hidden placeholder tab, so the window always has a tab.
+//
+// Pinned tabs (rac's favorites) belong to the window and stay when the window
+// switches spaces. Every other tab belongs to the window's space.
+class SpacesWindowManager : public KeyedService,
+                            public BrowserCollectionObserver,
+                            public TabStripModelObserver,
+                            public SpacesService::Observer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // `browser` shows a different space, or started or stopped showing the
+    // "open in another window" screen.
+    virtual void OnWindowSpaceChanged(BrowserWindowInterface* browser) {}
+    // A space was added, renamed, removed, or moved.
+    virtual void OnSpacesChanged() {}
+  };
+
+  SpacesWindowManager(Profile* profile, SpacesService* spaces);
+  SpacesWindowManager(const SpacesWindowManager&) = delete;
+  SpacesWindowManager& operator=(const SpacesWindowManager&) = delete;
+  ~SpacesWindowManager() override;
+
+  // Null for windows without spaces: incognito, guest, apps, and popups.
+  static SpacesWindowManager* From(BrowserWindowInterface* browser);
+
+  // Called when the user closes `browser`, before its tabs close. Takes the
+  // window's space out so its tabs survive. Does nothing when quitting, since
+  // session restore saves the window as it is.
+  static void OnWindowClosing(BrowserWindowInterface* browser);
+
+  SpacesService* spaces() { return spaces_; }
+
+  // The space `browser` shows. While the window shows the "open in another
+  // window" screen, this is the space it points at.
+  std::optional<base::Uuid> GetSpaceForWindow(
+      const BrowserWindowInterface* browser) const;
+  bool IsShowingElsewhereScreen(const BrowserWindowInterface* browser) const;
+
+  // The window holding the tabs of `space`, or null if no window does.
+  BrowserWindowInterface* GetWindowHoldingSpace(const base::Uuid& space) const;
+
+  // Switching. These do nothing for windows without spaces.
+  void ShowSpace(BrowserWindowInterface* browser, const base::Uuid& space);
+  void ShowSpaceAt(BrowserWindowInterface* browser, size_t index);
+  // Doesn't wrap around at either end.
+  void ShowAdjacentSpace(BrowserWindowInterface* browser, int offset);
+  void CreateAndShowSpace(BrowserWindowInterface* browser);
+
+  // For a window showing the "open in another window" screen: moves the space
+  // here from the window holding it. That window then shows the screen.
+  void MoveSpaceHere(BrowserWindowInterface* browser);
+  void GoToWindowHoldingSpace(BrowserWindowInterface* browser);
+
+  // Moves the unpinned tabs at `indices` in `browser` to `space`.
+  void MoveTabsToSpace(BrowserWindowInterface* browser,
+                       const std::vector<int>& indices,
+                       const base::Uuid& space);
+
+  // Closes the space's tabs, keeping them in History, and removes the space.
+  // Windows showing it switch to another space. Does nothing for the last
+  // space.
+  void DeleteSpace(const base::Uuid& space);
+
+  size_t GetTabCount(const base::Uuid& space) const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  struct WindowState;
+
+  WindowState* FindState(const BrowserWindowInterface* browser) const;
+  WindowState* FindState(const TabStripModel* model) const;
+
+  // Gives a new window its space, once its first tabs are in.
+  void ClaimInitialSpace(BrowserWindowInterface* browser);
+  // The most recently shown space no window holds, or a new space.
+  base::Uuid PickFreeSpace(const std::optional<base::Uuid>& excluding);
+
+  // The window's tabs that belong to its space: unpinned, and not the
+  // placeholder.
+  std::vector<tabs::TabInterface*> GetSpaceTabs(const WindowState& state) const;
+
+  // Moves `tabs` out of the window into the hidden tabs of `space`. The window
+  // must keep another tab.
+  void HideTabs(WindowState& state,
+                const base::Uuid& space,
+                const std::vector<tabs::TabInterface*>& tabs);
+  // Inserts the hidden tabs of `space`, or a new tab if it has none. Returns
+  // the tab to activate.
+  tabs::TabInterface* RevealSpace(WindowState& state, const base::Uuid& space);
+
+  void EnsurePlaceholder(WindowState& state);
+  void ClosePlaceholder(WindowState& state);
+  void UpdateElsewhereDialog(WindowState& state);
+  void CloseElsewhereDialog(WindowState& state);
+  void OnElsewhereDialogClosed(BrowserWindowInterface* browser);
+  // The window stops pointing at a space held elsewhere and takes a free one,
+  // keeping the tabs it has.
+  void LeaveElsewhereScreen(WindowState& state);
+
+  void HandleWindowClosing(BrowserWindowInterface* browser);
+  void RecordInHistory(HiddenSpace& space);
+  void NotifyWindowSpaceChanged(BrowserWindowInterface* browser);
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+  // SpacesService::Observer:
+  void OnSpaceAdded(const base::Uuid& id) override;
+  void OnSpaceRenamed(const base::Uuid& id) override;
+  void OnSpaceRemoved(const base::Uuid& id) override;
+  void OnSpacesReordered() override;
+
+  // Runs when an elsewhere dialog finishes closing, for any reason. Deletes

+#include "chrome/browser/ui/rac/spaces/spaces_window_manager_factory.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rac/spaces/spaces_service_factory.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+
+namespace rac {
+
+// static
+SpacesWindowManager* SpacesWindowManagerFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<SpacesWindowManager*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+SpacesWindowManagerFactory* SpacesWindowManagerFactory::GetInstance() {
+  static base::NoDestructor<SpacesWindowManagerFactory> instance;
+  return instance.get();
+}
+
+SpacesWindowManagerFactory::SpacesWindowManagerFactory()
+    : ProfileKeyedServiceFactory("RacSpacesWindowManager",
+                                 ProfileSelections::BuildForRegularProfile()) {
+  DependsOn(SpacesServiceFactory::GetInstance());
+}
+
+std::unique_ptr<KeyedService>
+SpacesWindowManagerFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  return std::make_unique<SpacesWindowManager>(
+      profile, SpacesServiceFactory::GetForProfile(profile));
+}
+
+bool SpacesWindowManagerFactory::ServiceIsCreatedWithBrowserContext() const {
+  // The manager watches windows from the moment they're created, so it must
+  // exist before the profile's first window.
+  return true;
+}
+
+}  // namespace rac

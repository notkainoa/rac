+namespace rac {
+
+namespace {
+
+// Wraps the OnceClosures so the dialog model's three callbacks can share
+// them, and reports through `on_dismissed` if the dialog closes without
+// either button.
+class ElsewhereDialogCallbacks
+    : public base::RefCounted<ElsewhereDialogCallbacks> {
+ public:
+  ElsewhereDialogCallbacks(base::OnceClosure on_move_here,
+                           base::OnceClosure on_go_to_window,
+                           base::OnceClosure on_dismissed)
+      : on_move_here_(std::move(on_move_here)),
+        on_go_to_window_(std::move(on_go_to_window)),
+        on_dismissed_(std::move(on_dismissed)) {}
+
+  void MoveHere() {
+    chose_ = true;
+    std::move(on_move_here_).Run();
+  }
+
+  void GoToWindow() {
+    chose_ = true;
+    std::move(on_go_to_window_).Run();
+  }
+
+  void Dismissed() {
+    if (!chose_) {
+      std::move(on_dismissed_).Run();
+    }
+  }
+
+ private:
+  friend class base::RefCounted<ElsewhereDialogCallbacks>;
+  ~ElsewhereDialogCallbacks() = default;
+
+  bool chose_ = false;
+  base::OnceClosure on_move_here_;
+  base::OnceClosure on_go_to_window_;
+  base::OnceClosure on_dismissed_;
+};
+
+}  // namespace
+
+std::unique_ptr<views::Widget> ShowSpaceElsewhereDialog(
+    tabs::TabInterface* tab,
+    base::OnceClosure on_move_here,
+    base::OnceClosure on_go_to_window,
+    base::OnceClosure on_dismissed) {
+  tabs::TabDialogManager* dialog_manager =
+      tab->GetTabFeatures()->tab_dialog_manager();
+  if (!tab->CanShowModalUI() || !dialog_manager) {
+    return nullptr;
+  }
+
+  auto callbacks = base::MakeRefCounted<ElsewhereDialogCallbacks>(
+      std::move(on_move_here), std::move(on_go_to_window),
+      std::move(on_dismissed));
+
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetInternalName("rac::SpaceElsewhere")
+          .SetTitle(l10n_util::GetStringUTF16(IDS_RAC_SPACE_ELSEWHERE_TITLE))
+          .AddParagraph(ui::DialogModelLabel(
+              l10n_util::GetStringUTF16(IDS_RAC_SPACE_ELSEWHERE_BODY)))
+          .AddOkButton(
+              base::BindOnce(&ElsewhereDialogCallbacks::MoveHere, callbacks),
+              ui::DialogModel::Button::Params()
+                  .SetLabel(l10n_util::GetStringUTF16(
+                      IDS_RAC_SPACE_ELSEWHERE_MOVE_HERE))
+                  .SetStyle(ui::ButtonStyle::kProminent))
+          .AddCancelButton(
+              base::BindOnce(&ElsewhereDialogCallbacks::GoToWindow, callbacks),
+              ui::DialogModel::Button::Params()
+                  .SetLabel(l10n_util::GetStringUTF16(
+                      IDS_RAC_SPACE_ELSEWHERE_GO_TO_WINDOW))
+                  .SetStyle(ui::ButtonStyle::kTonal))
+          .SetCloseActionCallback(
+              base::BindOnce(&ElsewhereDialogCallbacks::Dismissed, callbacks))
+          .Build();
+
+  views::BubbleDialogModelHost* host =
+      views::BubbleDialogModelHost::CreateModal(std::move(model),
+                                                ui::mojom::ModalType::kChild)
+          .release();
+  host->SetOwnershipOfNewWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+  return dialog_manager->CreateAndShowDialog(
+      host, std::make_unique<tabs::TabDialogManager::Params>());
+}
+
+}  // namespace rac

+namespace rac {
+
+struct SpacesWindowManager::WindowState {
+  // The window this state belongs to. Set once, before the state is stored.
+  raw_ptr<BrowserWindowInterface> browser = nullptr;
+
+  // The space this window shows or, when `showing_elsewhere` is set, points
+  // at.
+  std::optional<base::Uuid> space;
+
+  // True while the space is open in another window and this window shows the
+  // "open in another window" screen.
+  bool showing_elsewhere = false;
+
+  // The hidden tab the elsewhere screen sits on. Null when the window isn't
+  // showing the screen.
+  raw_ptr<tabs::TabInterface> placeholder_tab = nullptr;
+
+  // Owned through CLIENT_OWNS_WIDGET. Closed via CloseElsewhereDialog, never
+  // reset directly; the MakeCloseSynchronous callback clears it.
+  std::unique_ptr<views::Widget> elsewhere_dialog;
+
+  // Set while we close the dialog ourselves, so its close callback doesn't
+  // treat that as the user dismissing the screen.
+  bool closing_elsewhere_dialog = false;
+};
+
+namespace {
+
+bool IsSupportedBrowser(const BrowserWindowInterface* browser) {
+  return browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+         !browser->GetProfile()->IsOffTheRecord();
+}
+
+// True for the starting page of a new window: a tab that hasn't gone
+// anywhere. It's dropped, not kept, when the window claims a space that has
+// tabs of its own.
+bool IsUnusedInitialTab(tabs::TabInterface* tab, Profile* profile) {
+  content::WebContents* contents = tab->GetContents();
+  return contents->GetController().IsInitialBlankNavigation() ||
+         search::IsNTPOrRelatedURL(contents->GetVisibleURL(), profile);
+}
+
+}  // namespace
+
+SpacesWindowManager::SpacesWindowManager(Profile* profile,
+                                         SpacesService* spaces)
+    : profile_(profile), spaces_(spaces) {
+  CHECK(profile_);
+  CHECK(spaces_);
+  ProfileBrowserCollection* collection =
+      ProfileBrowserCollection::GetForProfile(profile_);
+  browser_collection_observation_.Observe(collection);
+  collection->ForEach([this](BrowserWindowInterface* browser) {
+    OnBrowserCreated(browser);
+    return true;
+  });
+  spaces_observation_.Observe(spaces_);
+}
+
+SpacesWindowManager::~SpacesWindowManager() {
+  DCHECK(windows_.empty());
+}
+
+// static
+SpacesWindowManager* SpacesWindowManager::From(
+    BrowserWindowInterface* browser) {
+  if (!browser || browser->GetProfile()->IsOffTheRecord()) {
+    return nullptr;
+  }
+  return SpacesWindowManagerFactory::GetForProfile(
+      Profile::FromBrowserContext(browser->GetProfile()->GetOriginalProfile()));
+}
+
+// static
+void SpacesWindowManager::OnWindowClosing(BrowserWindowInterface* browser) {
+  if (SpacesWindowManager* manager = From(browser)) {
+    manager->HandleWindowClosing(browser);
+  }
+}
+
+std::optional<base::Uuid> SpacesWindowManager::GetSpaceForWindow(
+    const BrowserWindowInterface* browser) const {
+  const WindowState* state = FindState(browser);
+  return state ? state->space : std::nullopt;
+}
+
+bool SpacesWindowManager::IsShowingElsewhereScreen(
+    const BrowserWindowInterface* browser) const {
+  const WindowState* state = FindState(browser);
+  return state && state->showing_elsewhere;
+}
+
+BrowserWindowInterface* SpacesWindowManager::GetWindowHoldingSpace(
+    const base::Uuid& space) const {
+  for (const auto& [browser, state] : windows_) {
+    if (state->space == space && !state->showing_elsewhere) {
+      return const_cast<BrowserWindowInterface*>(browser);
+    }
+  }
+  return nullptr;
+}
+
+void SpacesWindowManager::ShowSpace(BrowserWindowInterface* browser,
+                                    const base::Uuid& space) {
+  WindowState* state = FindState(browser);
+  if (!state || !spaces_->FindSpace(space)) {
+    return;
+  }
+  if (state->space == space && !state->showing_elsewhere) {
+    return;
+  }
+
+  TabStripModel* model = browser->GetTabStripModel();
+  tab_groups::TabGroupSyncService* tab_group_service =
+      tab_groups::TabGroupSyncServiceFactory::GetForProfile(profile_);
+  // Keep tab-group sync from treating the detach and re-insert as a close
+  // followed by new tabs.
+  std::unique_ptr<tab_groups::ScopedLocalObservationPauser> observation_pauser;
+  if (tab_group_service) {
+    observation_pauser = tab_group_service->CreateScopedLocalObserverPauser();
+  }
+
+  const bool was_elsewhere = state->showing_elsewhere;
+  // A window with no space yet (a new window claiming one) adopts the tabs it
+  // has; otherwise the old space's tabs are hidden below.
+  const bool claiming = !state->space.has_value();
+  const bool will_hide_old =
+      !claiming && !was_elsewhere && *state->space != space;
+
+  // Snapshot before inserting, so the incoming tabs aren't mistaken for the
+  // old space's.
+  std::vector<tabs::TabInterface*> old_tabs = GetSpaceTabs(*state);
+
+  BrowserWindowInterface* holder = GetWindowHoldingSpace(space);
+  const bool elsewhere = holder && holder != browser;
+
+  tabs::TabInterface* activate = nullptr;
+  if (elsewhere) {
+    EnsurePlaceholder(*state);
+  } else {
+    tabs::TabInterface* initial_tab =
+        (claiming && old_tabs.size() == 1 &&
+         IsUnusedInitialTab(old_tabs.front(), profile_))
+            ? old_tabs.front()
+            : nullptr;
+    activate = RevealSpace(*state, space);
+    if (initial_tab && activate) {
+      // The claimed space has tabs of its own; drop the starting page.
+      model->CloseWebContents(initial_tab->GetContents(), CLOSE_NONE);
+      old_tabs.clear();
+      initial_tab = nullptr;
+    }
+    const bool keeping_old = !will_hide_old && !old_tabs.empty();
+    if (!activate && !keeping_old) {
+      // An empty space shows a new tab.
+      chrome::AddTabAt(browser, GURL(), -1, /*foreground=*/false);
+      activate = model->GetTabAtIndex(model->count() - 1);
+    }
+    if (was_elsewhere) {
+      ClosePlaceholder(*state);
+    }
+  }
+
+  // Detach the old space's tabs only after the window has other tabs, so the
+  // strip never becomes empty.
+  if (will_hide_old && !old_tabs.empty()) {
+    HideTabs(*state, *state->space, old_tabs);
+  }
+
+  state->space = space;
+  state->showing_elsewhere = elsewhere;
+  if (elsewhere) {
+    UpdateElsewhereDialog(*state);
+  } else {
+    if (activate && model->GetIndexOfTab(activate) != TabStripModel::kNoTab) {
+      model->ActivateTab(activate);
+    }
+    spaces_->MarkSpaceActive(space);
+  }
+  NotifyWindowSpaceChanged(browser);
+}
+
+void SpacesWindowManager::ShowSpaceAt(BrowserWindowInterface* browser,
+                                      size_t index) {
+  const auto& spaces = spaces_->spaces();
+  if (index < spaces.size()) {
+    ShowSpace(browser, spaces[index].id);
+  }
+}
+
+void SpacesWindowManager::ShowAdjacentSpace(BrowserWindowInterface* browser,
+                                            int offset) {
+  WindowState* state = FindState(browser);
+  if (!state || !state->space) {
+    return;
+  }
+  const std::optional<size_t> index = spaces_->GetIndex(*state->space);
+  if (!index) {
+    return;
+  }
+  const int next = static_cast<int>(*index) + offset;
+  if (next < 0 || static_cast<size_t>(next) >= spaces_->spaces().size()) {
+    return;
+  }
+  ShowSpaceAt(browser, static_cast<size_t>(next));
+}
+
+void SpacesWindowManager::CreateAndShowSpace(BrowserWindowInterface* browser) {
+  ShowSpace(browser, spaces_->CreateSpace());
+}
+
+void SpacesWindowManager::MoveSpaceHere(BrowserWindowInterface* browser) {
+  WindowState* state = FindState(browser);
+  if (!state || !state->space || !state->showing_elsewhere) {
+    return;
+  }
+  const base::Uuid space = *state->space;
+  if (BrowserWindowInterface* holder = GetWindowHoldingSpace(space)) {
+    WindowState* holder_state = FindState(holder);
+    // The holder gets the screen first, so its strip keeps a tab while its
+    // space's tabs move over.
+    EnsurePlaceholder(*holder_state);
+    HideTabs(*holder_state, space, GetSpaceTabs(*holder_state));
+    holder_state->space = space;
+    holder_state->showing_elsewhere = true;
+    UpdateElsewhereDialog(*holder_state);
+    NotifyWindowSpaceChanged(holder);
+  }
+  ShowSpace(browser, space);
+}
+
+void SpacesWindowManager::GoToWindowHoldingSpace(
+    BrowserWindowInterface* browser) {
+  WindowState* state = FindState(browser);
+  if (!state || !state->space) {
+    return;
+  }
+  if (BrowserWindowInterface* holder = GetWindowHoldingSpace(*state->space)) {
+    holder->GetWindow()->Activate();
+  }
+}
+
+void SpacesWindowManager::MoveTabsToSpace(BrowserWindowInterface* browser,
+                                          const std::vector<int>& indices,
+                                          const base::Uuid& space) {
+  WindowState* state = FindState(browser);
+  if (!state || !state->space || *state->space == space ||
+      state->showing_elsewhere || !spaces_->FindSpace(space)) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  std::vector<tabs::TabInterface*> tabs;
+  for (int index : indices) {
+    if (!model->ContainsIndex(index) || model->IsTabPinned(index)) {
+      continue;
+    }
+    tabs::TabInterface* tab = model->GetTabAtIndex(index);
+    if (tab == state->placeholder_tab || std::ranges::contains(tabs, tab)) {
+      continue;
+    }
+    // A split moves as a whole. If one half is pinned (a favorite), neither
+    // half can move.
+    if (std::optional<split_tabs::SplitTabId> split = tab->GetSplit()) {
+      bool has_pinned_member = false;
+      for (tabs::TabInterface* member :
+           model->GetSplitData(*split)->ListTabs()) {
+        const int member_index = model->GetIndexOfTab(member);
+        if (member_index != TabStripModel::kNoTab &&
+            model->IsTabPinned(member_index)) {
+          has_pinned_member = true;
+        }
+      }
+      if (has_pinned_member) {
+        continue;
+      }
+    }
+    tabs.push_back(tab);
+  }
+  if (tabs.empty()) {
+    return;
+  }
+
+  if (static_cast<int>(tabs.size()) == model->count()) {
+    // Moving every tab would close the window. Leave a new tab behind; it's
+    // what an empty space shows anyway.
+    chrome::AddTabAt(browser, GURL(), -1, /*foreground=*/true);
+  }
+
+  std::vector<int> detach_indices;
+  for (tabs::TabInterface* tab : tabs) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      detach_indices.push_back(index);
+    }
+  }
+  HiddenSpace moved = HiddenSpace::Detach(model, detach_indices);
+  if (BrowserWindowInterface* holder = GetWindowHoldingSpace(space)) {
+    moved.InsertInto(holder->GetTabStripModel());
+  } else {
+    hidden_[space].Append(std::move(moved));
+  }
+}
+
+void SpacesWindowManager::DeleteSpace(const base::Uuid& space) {
+  if (spaces_->spaces().size() <= 1 || !spaces_->FindSpace(space)) {
+    return;
+  }
+  const Space& first = spaces_->spaces().front();
+  const base::Uuid fallback =
+      first.id == space ? spaces_->spaces()[1].id : first.id;
+
+  std::vector<BrowserWindowInterface*> showing;
+  for (const auto& [browser, state] : windows_) {
+    if (state->space == space) {
+      showing.push_back(const_cast<BrowserWindowInterface*>(browser));
+    }
+  }
+  // Switching moves the space's tabs into `hidden_`, below.
+  for (BrowserWindowInterface* browser : showing) {
+    ShowSpace(browser, fallback);
+  }
+
+  if (auto it = hidden_.find(space); it != hidden_.end()) {
+    RecordInHistory(it->second);
+    it->second.Clear();
+    hidden_.erase(it);
+  }
+  spaces_->RemoveSpace(space);
+}
+
+size_t SpacesWindowManager::GetTabCount(const base::Uuid& space) const {
+  if (auto it = hidden_.find(space); it != hidden_.end()) {
+    return it->second.GetTabs().size();
+  }
+  if (BrowserWindowInterface* holder = GetWindowHoldingSpace(space)) {
+    return GetSpaceTabs(*FindState(holder)).size();
+  }
+  return 0;
+}
+
+void SpacesWindowManager::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpacesWindowManager::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SpacesWindowManager::Shutdown() {
+  for (auto& [browser, state] : windows_) {
+    const_cast<BrowserWindowInterface*>(browser)
+        ->GetTabStripModel()
+        ->RemoveObserver(this);
+    CloseElsewhereDialog(*state);
+  }
+  windows_.clear();
+  hidden_.clear();
+}
+
+SpacesWindowManager::WindowState* SpacesWindowManager::FindState(
+    const BrowserWindowInterface* browser) const {
+  auto it = windows_.find(browser);
+  return it == windows_.end() ? nullptr : it->second.get();
+}
+
+SpacesWindowManager::WindowState* SpacesWindowManager::FindState(
+    const TabStripModel* model) const {
+  for (const auto& [browser, state] : windows_) {
+    if (browser->GetTabStripModel() == model) {
+      return state.get();
+    }
+  }
+  return nullptr;
+}
+
+void SpacesWindowManager::ClaimInitialSpace(BrowserWindowInterface* browser) {
+  WindowState* state = FindState(browser);
+  if (!state || state->space) {
+    return;
+  }
+  ShowSpace(browser, PickFreeSpace(std::nullopt));
+}
+
+base::Uuid SpacesWindowManager::PickFreeSpace(
+    const std::optional<base::Uuid>& excluding) {
+  for (const base::Uuid& id : spaces_->GetSpacesByRecentUse()) {
+    if (excluding && id == *excluding) {
+      continue;
+    }
+    if (!GetWindowHoldingSpace(id)) {
+      return id;
+    }
+  }
+  return spaces_->CreateSpace();
+}
+
+std::vector<tabs::TabInterface*> SpacesWindowManager::GetSpaceTabs(
+    const WindowState& state) const {
+  std::vector<tabs::TabInterface*> tabs;
+  TabStripModel* model = state.browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    if (model->IsTabPinned(i)) {
+      continue;
+    }
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (tab != state.placeholder_tab) {
+      tabs.push_back(tab);
+    }
+  }
+  return tabs;
+}
+
+void SpacesWindowManager::HideTabs(
+    WindowState& state,
+    const base::Uuid& space,
+    const std::vector<tabs::TabInterface*>& tabs) {
+  if (tabs.empty()) {
+    return;
+  }
+  TabStripModel* model = state.browser->GetTabStripModel();
+  std::vector<int> indices;
+  for (tabs::TabInterface* tab : tabs) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      indices.push_back(index);
+    }
+  }
+  // This may empty the strip when the window is closing; that's the one case
+  // where an empty strip is expected.
+  hidden_[space].Append(HiddenSpace::Detach(model, indices));
+}
+
+tabs::TabInterface* SpacesWindowManager::RevealSpace(WindowState& state,
+                                                     const base::Uuid& space) {
+  auto it = hidden_.find(space);
+  if (it == hidden_.end() || it->second.empty()) {
+    return nullptr;
+  }
+  HiddenSpace hidden = std::move(it->second);
+  hidden_.erase(it);
+  return hidden.InsertInto(state.browser->GetTabStripModel());
+}
+
+void SpacesWindowManager::EnsurePlaceholder(WindowState& state) {
+  if (state.placeholder_tab) {
+    return;
+  }
+  TabStripModel* model = state.browser->GetTabStripModel();
+  chrome::AddTabAt(state.browser, GURL(), -1, /*foreground=*/true);
+  tabs::TabInterface* tab = model->GetActiveTab();
+  tab->GetContents()->WasHidden();
+  state.placeholder_tab = tab;
+  UpdateElsewhereDialog(state);
+}
+
+void SpacesWindowManager::ClosePlaceholder(WindowState& state) {
+  state.showing_elsewhere = false;
+  tabs::TabInterface* placeholder = state.placeholder_tab;
+  state.placeholder_tab = nullptr;
+  CloseElsewhereDialog(state);
+  if (placeholder) {
+    TabStripModel* model = state.browser->GetTabStripModel();
+    if (model->GetIndexOfTab(placeholder) != TabStripModel::kNoTab) {
+      model->CloseWebContents(placeholder->GetContents(), CLOSE_NONE);
+    }
+  }
+}
+
+void SpacesWindowManager::UpdateElsewhereDialog(WindowState& state) {
+  if (!state.showing_elsewhere || !state.placeholder_tab ||
+      state.elsewhere_dialog) {
+    return;
+  }
+  state.elsewhere_dialog = ShowSpaceElsewhereDialog(
+      state.placeholder_tab,
+      base::BindOnce(&SpacesWindowManager::MoveSpaceHere,
+                     weak_ptr_factory_.GetWeakPtr(), state.browser),
+      base::BindOnce(&SpacesWindowManager::GoToWindowHoldingSpace,
+                     weak_ptr_factory_.GetWeakPtr(), state.browser),
+      base::BindOnce(&SpacesWindowManager::OnElsewhereDialogClosed,
+                     weak_ptr_factory_.GetWeakPtr(), state.browser));
+  if (state.elsewhere_dialog) {
+    state.elsewhere_dialog->MakeCloseSynchronous(base::BindOnce(
+        [](base::WeakPtr<SpacesWindowManager> self,
+           BrowserWindowInterface* browser, views::Widget::ClosedReason) {
+          if (self) {
+            self->OnElsewhereWidgetClosed(browser);
+          }
+        },
+        weak_ptr_factory_.GetWeakPtr(), state.browser));
+  }
+}
+
+void SpacesWindowManager::CloseElsewhereDialog(WindowState& state) {
+  if (!state.elsewhere_dialog || state.elsewhere_dialog->IsClosed()) {
+    state.elsewhere_dialog.reset();
+    return;
+  }
+  state.closing_elsewhere_dialog = true;
+  // The MakeCloseSynchronous callback resets `elsewhere_dialog`.
+  state.elsewhere_dialog->CloseWithReason(
+      views::Widget::ClosedReason::kUnspecified);
+  state.closing_elsewhere_dialog = false;
+}
+
+void SpacesWindowManager::OnElsewhereWidgetClosed(
+    BrowserWindowInterface* browser) {
+  WindowState* state = FindState(browser);
+  if (state) {
+    state->elsewhere_dialog.reset();
+  }
+}
+
+void SpacesWindowManager::OnElsewhereDialogClosed(
+    BrowserWindowInterface* browser) {
+  WindowState* state = FindState(browser);
+  if (!state || state->closing_elsewhere_dialog || !state->showing_elsewhere) {
+    return;
+  }
+  // Dismissing the screen lets the space go: the window takes a free space
+  // and keeps the tabs it has.
+  LeaveElsewhereScreen(*state);
+  NotifyWindowSpaceChanged(browser);
+}
+
+void SpacesWindowManager::LeaveElsewhereScreen(WindowState& state) {
+  BrowserWindowInterface* browser = state.browser;
+  const std::optional<base::Uuid> previous = state.space;
+  state.space.reset();
+  ClosePlaceholder(state);
+  ShowSpace(browser, PickFreeSpace(previous));
+}
+
+void SpacesWindowManager::HandleWindowClosing(BrowserWindowInterface* browser) {
+  WindowState* state = FindState(browser);
+  if (!state || browser_shutdown::IsTryingToQuit()) {
+    return;
+  }
+  const std::optional<base::Uuid> space = state->space;
+  const bool was_elsewhere = state->showing_elsewhere;
+
+  if (!was_elsewhere && space) {
+    // Take the space's tabs out before the session service records the
+    // closing window.
+    HideTabs(*state, *space, GetSpaceTabs(*state));
+  }
+
+  // Windows pointing at this space can have it now.
+  if (space) {
+    std::vector<BrowserWindowInterface*> waiting;
+    for (const auto& [other, other_state] : windows_) {
+      if (other != browser && other_state->space == space &&
+          other_state->showing_elsewhere) {
+        waiting.push_back(const_cast<BrowserWindowInterface*>(other));
+      }
+    }
+    for (BrowserWindowInterface* other : waiting) {
+      ShowSpace(other, *space);
+    }
+  }
+}
+
+void SpacesWindowManager::RecordInHistory(HiddenSpace& space) {
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return;
+  }
+  for (tabs::TabInterface* tab : space.GetTabs()) {
+    service->CreateHistoricalTab(
+        sessions::ContentLiveTab::GetOrCreateForWebContents(tab->GetContents()),
+        -1);
+  }
+}
+
+void SpacesWindowManager::NotifyWindowSpaceChanged(
+    BrowserWindowInterface* browser) {
+  for (Observer& observer : observers_) {
+    observer.OnWindowSpaceChanged(browser);
+  }
+}
+
+void SpacesWindowManager::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (!IsSupportedBrowser(browser)) {
+    return;
+  }
+  auto state = std::make_unique<WindowState>();
+  state->browser = browser;
+  WindowState* raw_state = state.get();
+  windows_[browser] = std::move(state);
+  browser->GetTabStripModel()->AddObserver(this);
+  // Session restore assigns the space itself once the window is built.
+  if (BrowserInitState::From(browser)->creation_source() ==
+      BrowserWindowCreateParams::CreationSource::kSessionRestore) {
+    return;
+  }
+  if (browser->GetTabStripModel()->count() > 0) {
+    ClaimInitialSpace(browser);
+  }
+}
+
+void SpacesWindowManager::OnBrowserClosed(BrowserWindowInterface* browser) {
+  auto it = windows_.find(browser);
+  if (it == windows_.end()) {
+    return;
+  }
+  browser->GetTabStripModel()->RemoveObserver(this);
+  windows_.erase(it);
+}
+
+void SpacesWindowManager::OnBrowserActivated(BrowserWindowInterface* browser) {
+  WindowState* state = FindState(browser);
+  if (state && state->space && !state->showing_elsewhere) {
+    spaces_->MarkSpaceActive(*state->space);
+  }
+}
+
+void SpacesWindowManager::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  WindowState* state = FindState(tab_strip_model);
+  if (!state) {
+    return;
+  }
+  if (change.type() == TabStripModelChange::kRemoved) {
+    for (const auto& removed : change.GetRemove()->contents) {
+      if (removed.tab == state->placeholder_tab) {
+        state->placeholder_tab = nullptr;
+      }
+    }
+    // The user closed the screen's tab; put the screen back.
+    if (state->showing_elsewhere && !state->placeholder_tab &&
+        !tab_strip_model->closing_all()) {
+      EnsurePlaceholder(*state);
+    }
+    return;
+  }
+  if (change.type() == TabStripModelChange::kInserted && !state->space) {
+    BrowserWindowInterface* browser = nullptr;
+    for (const auto& [candidate, window_state] : windows_) {
+      if (window_state.get() == state) {
+        browser = const_cast<BrowserWindowInterface*>(candidate);
+        break;
+      }
+    }
+    if (browser) {
+      ClaimInitialSpace(browser);
+    }
+  }
+}
+
+void SpacesWindowManager::OnTabChangedAt(tabs::TabInterface* tab,
+                                         TabChangeType change_type) {}
+
+void SpacesWindowManager::OnSpaceAdded(const base::Uuid& id) {
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+}
+
+void SpacesWindowManager::OnSpaceRenamed(const base::Uuid& id) {
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+}
+
+void SpacesWindowManager::OnSpaceRemoved(const base::Uuid& id) {
+  if (auto it = hidden_.find(id); it != hidden_.end()) {
+    it->second.Clear();
+    hidden_.erase(it);
+  }
+  const base::Uuid fallback = spaces_->spaces().front().id;
+  for (const auto& [browser, state] : windows_) {
+    if (state->space == id) {
+      ShowSpace(const_cast<BrowserWindowInterface*>(browser), fallback);
+    }
+  }
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+}
+
+void SpacesWindowManager::OnSpacesReordered() {
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+}

+// Lays the switcher out in one row, or one column when the strip is
+// collapsed: as many dots as fit, then the list button if any didn't, then
+// the New Space button, centered. The host's children are the dots, the
+// list button, and the New Space button, in that order. Nothing animates:
+// a dot that no longer fits leaves at once, and so does the list button
+// once every dot fits again.
+class SpaceSwitcherLayout : public views::LayoutManagerBase {
+ public:
+  // Told how many dots show each time the layout is applied.
+  using FitCallback = base::RepeatingCallback<void(size_t visible_dots)>;
+
+  explicit SpaceSwitcherLayout(FitCallback on_fit)
+      : on_fit_(std::move(on_fit)) {}
+  SpaceSwitcherLayout(const SpaceSwitcherLayout&) = delete;
+  SpaceSwitcherLayout& operator=(const SpaceSwitcherLayout&) = delete;
+  ~SpaceSwitcherLayout() override = default;
+
+  void SetVertical(bool vertical) {
+    if (vertical_ == vertical) {
+      return;
+    }
+    vertical_ = vertical;
+    InvalidateHost(true);
+  }
+
+ protected:
+  // views::LayoutManagerBase:
+  views::ProposedLayout CalculateProposedLayout(
+      const views::SizeBounds& size_bounds) const override {
+    std::vector<views::View*> items;
+    for (views::View* child : host_view()->children()) {
+      if (IsChildIncludedInLayout(child, /*include_hidden=*/true)) {
+        items.push_back(child);
+      }
+    }
+    views::ProposedLayout layout;
+    const int cross = kSlotSize + 2 * kRowPadding;
+    layout.host_size = Orient(0, cross);
+    if (items.size() < 2) {
+      for (views::View* item : items) {
+        layout.child_layouts.push_back({.child_view = item});
+      }
+      return layout;
+    }
+
+    const size_t spaces = items.size() - 2;
+    const views::SizeBound main_bound =
+        vertical_ ? size_bounds.height() : size_bounds.width();
+    size_t slots =
+        main_bound.is_bounded()
+            ? static_cast<size_t>(std::max(0, main_bound.value()) / kSlotSize)
+            : spaces + 1;
+    if (vertical_) {
+      slots = std::min(slots, kMaxColumnSlots);
+    }
+    const SwitcherFit fit = FitSwitcher(spaces, slots);
+
+    const auto shown = [&](size_t i) {
+      return i < fit.dots || (i == spaces && fit.list) ||
+             (i == spaces + 1 && fit.add);
+    };
+    const int run =
+        static_cast<int>(fit.dots + (fit.list ? 1 : 0) + (fit.add ? 1 : 0)) *
+        kSlotSize;
+    layout.host_size = Orient(run, cross);
+
+    const views::SizeBound cross_bound =
+        vertical_ ? size_bounds.width() : size_bounds.height();
+    const int main_size =
+        main_bound.is_bounded() ? std::max(run, main_bound.value()) : run;
+    const int cross_size =
+        cross_bound.is_bounded() ? cross_bound.value() : cross;
+    int main_pos = (main_size - run) / 2 + kDotGap;
+    const int cross_pos = (cross_size - kDotTargetSize) / 2;
+    for (size_t i = 0; i < items.size(); ++i) {
+      if (!shown(i)) {
+        layout.child_layouts.push_back({.child_view = items[i]});
+        continue;
+      }
+      const gfx::Point origin = vertical_ ? gfx::Point(cross_pos, main_pos)
+                                          : gfx::Point(main_pos, cross_pos);
+      layout.child_layouts.push_back(
+          {.child_view = items[i],
+           .visible = true,
+           .bounds =
+               gfx::Rect(origin, gfx::Size(kDotTargetSize, kDotTargetSize))});
+      main_pos += kSlotSize;
+    }
+    return layout;
+  }
+
+  void BeforeApplyLayout(const views::ProposedLayout& layout) override {
+    size_t visible_dots = 0;
+    const size_t count = layout.child_layouts.size();
+    for (size_t i = 0; i + 2 < count; ++i) {
+      if (layout.child_layouts[i].visible) {
+        ++visible_dots;
+      }
+    }
+    on_fit_.Run(visible_dots);
+  }
+
+ private:
+  gfx::Size Orient(int main, int cross) const {
+    return vertical_ ? gfx::Size(cross, main) : gfx::Size(main, cross);
+  }
+
+  FitCallback on_fit_;
+  bool vertical_ = false;
+};

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_SPACES_SWITCHER_FIT_H_
+#define CHROME_BROWSER_RAC_SPACES_SWITCHER_FIT_H_
+
+#include <algorithm>
+#include <cstddef>
+#include <optional>
+
+namespace rac {
+
+// One place in the space switcher: a 22 px button and 1 px on each side.
+inline constexpr int kSwitcherSlotSize = 24;
+// A collapsed sidebar stacks the switcher into a column. Past this many
+// places it would crowd out the tabs, so the rest go to the list.
+inline constexpr size_t kMaxColumnSlots = 6;
+
+// What the space switcher shows when its row (or column) has room for
+// `slots` equal places: the first `dots` spaces, then the button that lists
+// every space when some don't fit, then the New Space button.
+struct SwitcherFit {
+  size_t dots = 0;
+  bool list = false;
+  bool add = false;
+
+  friend bool operator==(const SwitcherFit&, const SwitcherFit&) = default;
+};
+
+constexpr SwitcherFit FitSwitcher(size_t spaces, size_t slots) {
+  if (spaces + 1 <= slots) {
+    return {.dots = spaces, .list = false, .add = true};
+  }
+  // Dots give way first, so the list and New Space both stay.
+  if (slots >= 2) {
+    return {.dots = slots - 2, .list = true, .add = true};
+  }
+  // Room for one button only. New Space alone would leave every space out
+  // of reach; the list reaches every space and ends with New Space.
+  if (slots == 1) {
+    return {.dots = 0, .list = true, .add = false};
+  }
+  return {};
+}
+
+// How many places the switcher has: `length` px along its row or column, or
+// room for every space and New Space when it's unbounded. A column stops at
+// kMaxColumnSlots.
+constexpr size_t SwitcherSlots(std::optional<int> length,
+                               size_t spaces,
+                               bool column) {
+  const size_t slots =
+      length ? static_cast<size_t>(std::max(0, *length) / kSwitcherSlotSize)
+             : spaces + 1;
+  return column ? std::min(slots, kMaxColumnSlots) : slots;
+}
+
+// Whether the window's space, at `current` in the list, is behind the list
+// button when the first `visible_dots` dots show.
+constexpr bool ListHoldsCurrent(std::optional<size_t> current,
+                                size_t visible_dots) {
+  return current.has_value() && *current >= visible_dots;
+}
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_SPACES_SWITCHER_FIT_H_

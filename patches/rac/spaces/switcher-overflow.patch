+// The list button's menu: every space, then New Space. Plain rows, each led
+// by the space's mark, keep every name in one column; the window's space has
+// the bright mark, and VoiceOver hears that it's the current one.
+class SpaceListMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  SpaceListMenu(SpacesWindowManager* manager, BrowserWindowInterface* browser)
+      : manager_(manager), browser_(browser) {}
+  SpaceListMenu(const SpaceListMenu&) = delete;
+  SpaceListMenu& operator=(const SpaceListMenu&) = delete;
+  ~SpaceListMenu() override = default;
+
+  void Show(views::View* anchor,
+            ui::mojom::MenuSourceType source_type,
+            base::RepeatingClosure on_closed) {
+    if (!manager_ || !anchor->GetWidget()) {
+      on_closed.Run();
+      return;
+    }
+    const std::optional<base::Uuid> current =
+        manager_->GetSpaceForWindow(browser_);
+    spaces_.clear();
+    model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    const auto& spaces = manager_->spaces()->spaces();
+    for (size_t i = 0; i < spaces.size(); ++i) {
+      const Space& space = spaces[i];
+      const std::u16string name = SpaceName(space, i);
+      const bool is_current = current == space.id;
+      spaces_.push_back(space.id);
+      model_->AddItem(kFirstSpaceCommand + static_cast<int>(i),
+                      ui::EscapeMenuLabelAmpersands(name));
+      const size_t index = model_->GetItemCount() - 1;
+      model_->SetIcon(index, SpaceMark(space, is_current));
+      if (is_current) {
+        model_->SetAccessibleNameAt(
+            index,
+            l10n_util::GetStringFUTF16(IDS_RAC_SPACES_LIST_CURRENT, name));
+      }
+    }
+    model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    model_->AddItemWithStringId(kNewSpaceCommand, IDS_RAC_SPACES_NEW_SPACE);
+    model_->SetIcon(model_->GetItemCount() - 1,
+                    ui::ImageModel::FromVectorIcon(
+                        kAddIcon, kColorRacTextSecondary, kListMarkSize));
+
+    runner_ = std::make_unique<views::MenuRunner>(
+        model_.get(), views::MenuRunner::NO_FLAGS, std::move(on_closed));
+    runner_->RunMenuAt(anchor->GetWidget(), nullptr,
+                       anchor->GetAnchorBoundsInScreen(),
+                       views::MenuAnchorPosition::kTopLeft, source_type);
+  }
+
+  bool IsShowing() const { return runner_ && runner_->IsRunning(); }
+
+  // When the menu last closed. A press that closed it mustn't reopen it.
+  base::TimeTicks closing_event_time() const {
+    return runner_ ? runner_->closing_event_time() : base::TimeTicks();
+  }
+
+  void Cancel() {
+    if (IsShowing()) {
+      runner_->Cancel();
+    }
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (!manager_) {
+      return;
+    }
+    if (command_id == kNewSpaceCommand) {
+      manager_->CreateAndShowSpace(browser_);
+      return;
+    }
+    if (const std::optional<base::Uuid> space = SpaceFor(command_id)) {
+      manager_->ShowSpace(browser_, *space);
+    }
+  }
+
+ private:
+  std::optional<base::Uuid> SpaceFor(int command_id) const {
+    if (command_id < kFirstSpaceCommand) {
+      return std::nullopt;
+    }
+    const size_t index = static_cast<size_t>(command_id - kFirstSpaceCommand);
+    if (index >= spaces_.size()) {
+      return std::nullopt;
+    }
+    return spaces_[index];
+  }
+
+  const raw_ptr<SpacesWindowManager> manager_;
+  const raw_ptr<BrowserWindowInterface> browser_;
+  // The spaces as listed when the menu opened, in command order.
+  std::vector<base::Uuid> spaces_;
+  std::unique_ptr<ui::SimpleMenuModel> model_;
+  std::unique_ptr<views::MenuRunner> runner_;
+};

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/switcher_fit.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+// The view computes this during layout; it stays cheap enough to be constexpr.
+static_assert(FitSwitcher(3, 5) == SwitcherFit{3, false, true});
+
+TEST(SwitcherFitTest, EverythingFits) {
+  EXPECT_EQ(FitSwitcher(3, 5), (SwitcherFit{3, false, true}));
+  // Exactly enough room: every dot and New Space, no list.
+  EXPECT_EQ(FitSwitcher(4, 5), (SwitcherFit{4, false, true}));
+  EXPECT_EQ(FitSwitcher(1, 2), (SwitcherFit{1, false, true}));
+}
+
+TEST(SwitcherFitTest, OverflowKeepsListAndNewSpace) {
+  // One space too many: the list replaces two dots, so it always holds at
+  // least two spaces.
+  EXPECT_EQ(FitSwitcher(5, 5), (SwitcherFit{3, true, true}));
+  EXPECT_EQ(FitSwitcher(10, 5), (SwitcherFit{3, true, true}));
+  EXPECT_EQ(FitSwitcher(20, 6), (SwitcherFit{4, true, true}));
+  EXPECT_EQ(FitSwitcher(20, 2), (SwitcherFit{0, true, true}));
+}
+
+TEST(SwitcherFitTest, NeverShowsMoreThanFits) {
+  for (size_t spaces = 1; spaces <= 30; ++spaces) {
+    for (size_t slots = 0; slots <= 30; ++slots) {
+      const SwitcherFit fit = FitSwitcher(spaces, slots);
+      const size_t shown = fit.dots + (fit.list ? 1 : 0) + (fit.add ? 1 : 0);
+      EXPECT_LE(shown, slots) << spaces << " spaces, " << slots << " slots";
+      EXPECT_LE(fit.dots, spaces);
+      // Every space is a dot or in the list, whenever anything shows.
+      if (slots > 0) {
+        EXPECT_TRUE(fit.dots == spaces || fit.list)
+            << spaces << " spaces, " << slots << " slots";
+      }
+      // The list appears only when a dot is missing.
+      EXPECT_EQ(fit.list, slots > 0 && fit.dots < spaces);
+    }
+  }
+}
+
+TEST(SwitcherFitTest, TooNarrow) {
+  EXPECT_EQ(FitSwitcher(10, 1), (SwitcherFit{0, true, false}));
+  EXPECT_EQ(FitSwitcher(10, 0), SwitcherFit());
+  // Even one space without room for New Space goes in the list, which holds
+  // New Space.
+  EXPECT_EQ(FitSwitcher(1, 1), (SwitcherFit{0, true, false}));
+}
+

+  void Cancel() {
+    if (IsShowing()) {
+      runner_->Cancel();
+    }
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override {
+    const std::optional<base::Uuid> space = SpaceFor(command_id);
+    return space && space == current_;
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (!manager_) {
+      return;
+    }
+    if (command_id == kNewSpaceCommand) {
+      manager_->CreateAndShowSpace(browser_);
+      return;
+    }
+    if (const std::optional<base::Uuid> space = SpaceFor(command_id)) {
+      manager_->ShowSpace(browser_, *space);
+    }
+  }
+
+ private:
+  std::optional<base::Uuid> SpaceFor(int command_id) const {
+    if (command_id < kFirstSpaceCommand) {
+      return std::nullopt;
+    }
+    const size_t index = static_cast<size_t>(command_id - kFirstSpaceCommand);
+    if (index >= spaces_.size()) {
+      return std::nullopt;
+    }
+    return spaces_[index];
+  }

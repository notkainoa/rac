+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/spaces/space_switcher_layout.h"
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/i18n/rtl.h"
+#include "base/test/icu_test_util.h"
+#include "chrome/browser/rac/spaces/switcher_fit.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/accessibility/platform/ax_platform_for_test.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+
+namespace rac {
+namespace {
+
+// A switcher with `spaces` dots, the list button, and New Space, laid out
+// at `size`.
+class SpaceSwitcherLayoutTest : public testing::Test {
+ protected:
+  void Build(size_t spaces, bool vertical = false) {
+    host_ = std::make_unique<views::View>();
+    layout_ = host_->SetLayoutManager(std::make_unique<SpaceSwitcherLayout>(
+        base::BindRepeating([](std::optional<size_t>* out,
+                               size_t visible_dots) { *out = visible_dots; },
+                            &visible_dots_)));
+    layout_->SetVertical(vertical);
+    dots_.clear();
+    for (size_t i = 0; i < spaces; ++i) {
+      dots_.push_back(host_->AddChildView(std::make_unique<views::View>()));
+    }
+    list_ = host_->AddChildView(std::make_unique<views::View>());
+    add_ = host_->AddChildView(std::make_unique<views::View>());
+  }
+
+  void LayOut(const gfx::Size& size) {
+    host_->SetSize(size);
+    host_->DeprecatedLayoutImmediately();
+  }
+
+  size_t VisibleDots() const {
+    size_t count = 0;
+    for (const views::View* dot : dots_) {
+      count += dot->GetVisible() ? 1 : 0;
+    }
+    return count;
+  }
+
+  // Views make accessibility objects as they're created.
+  ui::AXPlatformForTest ax_platform_;
+  std::unique_ptr<views::View> host_;
+  raw_ptr<SpaceSwitcherLayout> layout_ = nullptr;
+  std::vector<raw_ptr<views::View>> dots_;
+  raw_ptr<views::View> list_ = nullptr;
+  raw_ptr<views::View> add_ = nullptr;
+  std::optional<size_t> visible_dots_;
+};
+
+TEST_F(SpaceSwitcherLayoutTest, PreferredSizeHoldsEverySpace) {
+  Build(10);
+  // Ten dots and New Space, in a 28 px row.
+  EXPECT_EQ(host_->GetPreferredSize(), gfx::Size(11 * kSwitcherSlotSize, 28));
+}
+
+TEST_F(SpaceSwitcherLayoutTest, EverythingFitsCentered) {
+  Build(3);
+  LayOut(gfx::Size(130, 28));
+  EXPECT_EQ(VisibleDots(), 3u);
+  EXPECT_FALSE(list_->GetVisible());
+  EXPECT_TRUE(add_->GetVisible());
+  // Four places, 96 px, centered in 130: (130 - 96) / 2 = 17, plus 1.
+  EXPECT_EQ(dots_[0]->bounds(), gfx::Rect(18, 3, 22, 22));
+  EXPECT_EQ(add_->bounds(), gfx::Rect(18 + 3 * 24, 3, 22, 22));
+  EXPECT_EQ(visible_dots_, 3u);
+}
+
+TEST_F(SpaceSwitcherLayoutTest, OverflowShowsListBeforeNewSpace) {
+  Build(10);
+  LayOut(gfx::Size(130, 28));
+  // Five places: three dots, the list, New Space.
+  EXPECT_EQ(VisibleDots(), 3u);
+  for (size_t i = 3; i < dots_.size(); ++i) {
+    EXPECT_FALSE(dots_[i]->GetVisible()) << i;
+  }
+  ASSERT_TRUE(list_->GetVisible());
+  ASSERT_TRUE(add_->GetVisible());
+  EXPECT_EQ(list_->x(), dots_[2]->x() + kSwitcherSlotSize);
+  EXPECT_EQ(add_->x(), list_->x() + kSwitcherSlotSize);
+  EXPECT_EQ(visible_dots_, 3u);
+}
+
+TEST_F(SpaceSwitcherLayoutTest, TwoPlaces) {
+  Build(10);
+  LayOut(gfx::Size(48, 28));
+  EXPECT_EQ(VisibleDots(), 0u);
+  EXPECT_TRUE(list_->GetVisible());
+  EXPECT_TRUE(add_->GetVisible());
+  EXPECT_EQ(visible_dots_, 0u);
+}
+
+TEST_F(SpaceSwitcherLayoutTest, WideningBringsDotsBackAndHidesList) {
+  Build(6);
+  LayOut(gfx::Size(130, 28));
+  EXPECT_TRUE(list_->GetVisible());
+  LayOut(gfx::Size(7 * kSwitcherSlotSize, 28));
+  EXPECT_EQ(VisibleDots(), 6u);
+  EXPECT_FALSE(list_->GetVisible());
+  EXPECT_TRUE(add_->GetVisible());
+  EXPECT_EQ(visible_dots_, 6u);
+}
+
+TEST_F(SpaceSwitcherLayoutTest, ColumnStopsAtSixPlaces) {
+  Build(20, /*vertical=*/true);
+  const gfx::Size preferred = host_->GetPreferredSize();
+  EXPECT_EQ(preferred, gfx::Size(28, static_cast<int>(kMaxColumnSlots) * 24));
+  LayOut(gfx::Size(40, preferred.height()));
+  EXPECT_EQ(VisibleDots(), 4u);
+  EXPECT_TRUE(list_->GetVisible());
+  EXPECT_TRUE(add_->GetVisible());
+  // Stacked top to bottom, centered across.
+  EXPECT_EQ(dots_[0]->bounds(), gfx::Rect(9, 1, 22, 22));
+  EXPECT_EQ(dots_[1]->y(), dots_[0]->y() + kSwitcherSlotSize);
+  EXPECT_EQ(add_->y(), list_->y() + kSwitcherSlotSize);
+}
+
+TEST_F(SpaceSwitcherLayoutTest, ShortColumnFitsWhole) {
+  Build(3, /*vertical=*/true);
+  EXPECT_EQ(host_->GetPreferredSize(), gfx::Size(28, 4 * 24));
+}
+
+TEST_F(SpaceSwitcherLayoutTest, RightToLeftMirrorsTheRow) {
+  base::test::ScopedRestoreICUDefaultLocale restore_locale;
+  base::i18n::SetICUDefaultLocale("he");
+  ASSERT_TRUE(base::i18n::IsRTL());
+  Build(10);
+  LayOut(gfx::Size(130, 28));
+  // The first space sits at the start of the row, on the right, and New
+  // Space at its end, on the left.
+  const int first = dots_[0]->GetMirroredBounds().x();
+  const int list = list_->GetMirroredBounds().x();
+  const int add = add_->GetMirroredBounds().x();
+  EXPECT_GT(first, list);
+  EXPECT_GT(list, add);
+  EXPECT_EQ(dots_[0]->GetMirroredBounds().right(), 130 - dots_[0]->x());
+}

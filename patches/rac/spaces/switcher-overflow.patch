+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/spaces/space_switcher_layout.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/rac/spaces/switcher_fit.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/layout/proposed_layout.h"
+#include "ui/views/view.h"
+
+namespace rac {
+
+namespace {
+
+// The gap on each side of a button inside its place.
+constexpr int kButtonGap = (kSwitcherSlotSize - kSwitcherButtonSize) / 2;
+// Space above and below the row.
+constexpr int kRowPadding = 2;
+
+std::optional<int> Length(const views::SizeBound& bound) {
+  return bound.is_bounded() ? std::optional<int>(bound.value()) : std::nullopt;
+}
+
+}  // namespace
+
+SpaceSwitcherLayout::SpaceSwitcherLayout(FitCallback on_fit)
+    : on_fit_(std::move(on_fit)) {}
+
+SpaceSwitcherLayout::~SpaceSwitcherLayout() = default;
+
+void SpaceSwitcherLayout::SetVertical(bool vertical) {
+  if (vertical_ == vertical) {
+    return;
+  }
+  vertical_ = vertical;
+  InvalidateHost(true);
+}
+
+views::ProposedLayout SpaceSwitcherLayout::CalculateProposedLayout(
+    const views::SizeBounds& size_bounds) const {
+  std::vector<views::View*> items;
+  for (views::View* child : host_view()->children()) {
+    if (IsChildIncludedInLayout(child, /*include_hidden=*/true)) {
+      items.push_back(child);
+    }
+  }
+  views::ProposedLayout layout;
+  const int cross = kSwitcherSlotSize + 2 * kRowPadding;
+  layout.host_size = Orient(0, cross);
+  if (items.size() < 2) {
+    for (views::View* item : items) {
+      layout.child_layouts.push_back({.child_view = item});
+    }
+    return layout;
+  }
+
+  const size_t spaces = items.size() - 2;
+  const std::optional<int> main_length =
+      Length(vertical_ ? size_bounds.height() : size_bounds.width());
+  const SwitcherFit fit =
+      FitSwitcher(spaces, SwitcherSlots(main_length, spaces, vertical_));
+  const auto shown = [&](size_t i) {
+    return i < fit.dots || (i == spaces && fit.list) ||
+           (i == spaces + 1 && fit.add);
+  };
+  const int run =
+      static_cast<int>(fit.dots + (fit.list ? 1 : 0) + (fit.add ? 1 : 0)) *
+      kSwitcherSlotSize;
+  layout.host_size = Orient(run, cross);
+
+  const std::optional<int> cross_length =
+      Length(vertical_ ? size_bounds.width() : size_bounds.height());
+  const int main_size = std::max(run, main_length.value_or(run));
+  int main_pos = (main_size - run) / 2 + kButtonGap;
+  const int cross_pos =
+      (cross_length.value_or(cross) - kSwitcherButtonSize) / 2;
+  for (size_t i = 0; i < items.size(); ++i) {
+    if (!shown(i)) {
+      layout.child_layouts.push_back({.child_view = items[i]});
+      continue;
+    }
+    const gfx::Point origin = vertical_ ? gfx::Point(cross_pos, main_pos)
+                                        : gfx::Point(main_pos, cross_pos);
+    layout.child_layouts.push_back(
+        {.child_view = items[i],
+         .visible = true,
+         .bounds = gfx::Rect(
+             origin, gfx::Size(kSwitcherButtonSize, kSwitcherButtonSize))});
+    main_pos += kSwitcherSlotSize;
+  }
+  return layout;
+}
+
+void SpaceSwitcherLayout::BeforeApplyLayout(
+    const views::ProposedLayout& layout) {
+  size_t visible_dots = 0;
+  const size_t count = layout.child_layouts.size();
+  for (size_t i = 0; i + 2 < count; ++i) {
+    if (layout.child_layouts[i].visible) {
+      ++visible_dots;
+    }
+  }
+  on_fit_.Run(visible_dots);
+}
+
+gfx::Size SpaceSwitcherLayout::Orient(int main, int cross) const {
+  return vertical_ ? gfx::Size(cross, main) : gfx::Size(main, cross);
+}
+
+}  // namespace rac

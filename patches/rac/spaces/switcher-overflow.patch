+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/switcher_fit.h"
+
+#include <optional>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+// The view computes this during layout; it stays cheap enough to be constexpr.
+static_assert(FitSwitcher(3, 5) == SwitcherFit{3, false, true});
+
+TEST(SwitcherFitTest, EverythingFits) {
+  EXPECT_EQ(FitSwitcher(3, 5), (SwitcherFit{3, false, true}));
+  // Exactly enough room: every dot and New Space, no list.
+  EXPECT_EQ(FitSwitcher(4, 5), (SwitcherFit{4, false, true}));
+  EXPECT_EQ(FitSwitcher(1, 2), (SwitcherFit{1, false, true}));
+}
+
+TEST(SwitcherFitTest, OverflowKeepsListAndNewSpace) {
+  // One space too many: the list replaces two dots, so it always holds at
+  // least two spaces.
+  EXPECT_EQ(FitSwitcher(5, 5), (SwitcherFit{3, true, true}));
+  EXPECT_EQ(FitSwitcher(10, 5), (SwitcherFit{3, true, true}));
+  EXPECT_EQ(FitSwitcher(20, 6), (SwitcherFit{4, true, true}));
+  EXPECT_EQ(FitSwitcher(20, 2), (SwitcherFit{0, true, true}));
+}
+
+TEST(SwitcherFitTest, NeverShowsMoreThanFits) {
+  for (size_t spaces = 1; spaces <= 30; ++spaces) {
+    for (size_t slots = 0; slots <= 30; ++slots) {
+      const SwitcherFit fit = FitSwitcher(spaces, slots);
+      const size_t shown = fit.dots + (fit.list ? 1 : 0) + (fit.add ? 1 : 0);
+      EXPECT_LE(shown, slots) << spaces << " spaces, " << slots << " slots";
+      EXPECT_LE(fit.dots, spaces);
+      // Every space is a dot or in the list, whenever anything shows.
+      if (slots > 0) {
+        EXPECT_TRUE(fit.dots == spaces || fit.list)
+            << spaces << " spaces, " << slots << " slots";
+      }
+      // The list appears only when a dot is missing.
+      EXPECT_EQ(fit.list, slots > 0 && fit.dots < spaces);
+    }
+  }
+}
+
+TEST(SwitcherFitTest, TooNarrow) {
+  EXPECT_EQ(FitSwitcher(10, 1), (SwitcherFit{0, true, false}));
+  EXPECT_EQ(FitSwitcher(10, 0), SwitcherFit());
+  // Even one space without room for New Space goes in the list, which holds
+  // New Space.
+  EXPECT_EQ(FitSwitcher(1, 1), (SwitcherFit{0, true, false}));
+}
+
+TEST(SwitcherFitTest, TwoSlotsKeepListAndNewSpace) {
+  EXPECT_EQ(FitSwitcher(2, 2), (SwitcherFit{0, true, true}));
+  EXPECT_EQ(FitSwitcher(500, 2), (SwitcherFit{0, true, true}));
+  // One space and New Space still fit in two places.
+  EXPECT_EQ(FitSwitcher(1, 2), (SwitcherFit{1, false, true}));
+}
+
+TEST(SwitcherFitTest, SlotsFromLength) {
+  // Whole places only: 24 px each.
+  EXPECT_EQ(SwitcherSlots(0, 10, false), 0u);
+  EXPECT_EQ(SwitcherSlots(23, 10, false), 0u);
+  EXPECT_EQ(SwitcherSlots(24, 10, false), 1u);
+  EXPECT_EQ(SwitcherSlots(47, 10, false), 1u);
+  EXPECT_EQ(SwitcherSlots(48, 10, false), 2u);
+  // The usual sidebar leaves the row about 130 px: five places.
+  EXPECT_EQ(SwitcherSlots(130, 10, false), 5u);
+  EXPECT_EQ(SwitcherSlots(1000, 10, false), 41u);
+  // A negative length (a squeezed parent) holds nothing.
+  EXPECT_EQ(SwitcherSlots(-5, 10, false), 0u);
+  // Unbounded: every space and New Space.
+  EXPECT_EQ(SwitcherSlots(std::nullopt, 10, false), 11u);
+  EXPECT_EQ(SwitcherSlots(std::nullopt, 0, false), 1u);
+}
+
+TEST(SwitcherFitTest, ColumnStopsAtSixPlaces) {
+  EXPECT_EQ(kMaxColumnSlots, 6u);
+  EXPECT_EQ(SwitcherSlots(std::nullopt, 3, true), 4u);
+  EXPECT_EQ(SwitcherSlots(std::nullopt, 5, true), 6u);
+  EXPECT_EQ(SwitcherSlots(std::nullopt, 20, true), 6u);
+  EXPECT_EQ(SwitcherSlots(1000, 20, true), 6u);
+  EXPECT_EQ(SwitcherSlots(72, 20, true), 3u);
+  // Twenty spaces in a column: four dots, the list, and New Space.
+  EXPECT_EQ(FitSwitcher(20, SwitcherSlots(std::nullopt, 20, true)),
+            (SwitcherFit{4, true, true}));
+  // Five spaces still fit a column whole.
+  EXPECT_EQ(FitSwitcher(5, SwitcherSlots(std::nullopt, 5, true)),
+            (SwitcherFit{5, false, true}));
+}
+
+TEST(SwitcherFitTest, ListHoldsCurrent) {
+  // No space for the window (incognito, or before the window claims one).
+  EXPECT_FALSE(ListHoldsCurrent(std::nullopt, 3));
+  EXPECT_FALSE(ListHoldsCurrent(0, 3));
+  EXPECT_FALSE(ListHoldsCurrent(2, 3));
+  // The first hidden space and the ones after it.
+  EXPECT_TRUE(ListHoldsCurrent(3, 3));
+  EXPECT_TRUE(ListHoldsCurrent(19, 3));
+  // With no dots showing, the list holds every space.
+  EXPECT_TRUE(ListHoldsCurrent(0, 0));
+  // When every dot fits, the current dot shows.
+  for (size_t spaces = 1; spaces <= 30; ++spaces) {
+    const SwitcherFit fit = FitSwitcher(spaces, spaces + 1);
+    for (size_t current = 0; current < spaces; ++current) {
+      EXPECT_FALSE(ListHoldsCurrent(current, fit.dots));
+    }
+  }
+}
+
+}  // namespace
+}  // namespace rac

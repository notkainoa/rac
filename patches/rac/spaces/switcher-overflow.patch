+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_SWITCHER_LAYOUT_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_SWITCHER_LAYOUT_H_
+
+#include <cstddef>
+
+#include "base/functional/callback.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/layout/layout_manager_base.h"
+
+namespace rac {
+
+// The space switcher's buttons: 22 px, in 24 px places (kSwitcherSlotSize).
+inline constexpr int kSwitcherButtonSize = 22;
+
+// Lays the space switcher out in one row, or one column when the sidebar is
+// collapsed: as many dots as fit, then the list button if any didn't, then
+// the New Space button, centered. The host's children are the dots, the
+// list button, and the New Space button, in that order. Bounds are in
+// left-to-right coordinates; views mirrors them for right-to-left languages.
+// Nothing animates: a dot that no longer fits leaves at once, and so does
+// the list button once every dot fits again.
+class SpaceSwitcherLayout : public views::LayoutManagerBase {
+ public:
+  // Told how many dots show each time the layout is applied.
+  using FitCallback = base::RepeatingCallback<void(size_t visible_dots)>;
+
+  explicit SpaceSwitcherLayout(FitCallback on_fit);
+  SpaceSwitcherLayout(const SpaceSwitcherLayout&) = delete;
+  SpaceSwitcherLayout& operator=(const SpaceSwitcherLayout&) = delete;
+  ~SpaceSwitcherLayout() override;
+
+  void SetVertical(bool vertical);
+
+ protected:
+  // views::LayoutManagerBase:
+  views::ProposedLayout CalculateProposedLayout(
+      const views::SizeBounds& size_bounds) const override;
+  void BeforeApplyLayout(const views::ProposedLayout& layout) override;
+
+ private:
+  gfx::Size Orient(int main, int cross) const;
+
+  FitCallback on_fit_;
+  bool vertical_ = false;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_SWITCHER_LAYOUT_H_

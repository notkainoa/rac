+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/spaces/move_tab_to_space_sub_menu_model.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "chrome/browser/rac/spaces/spaces_service.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/grit/generated_resources.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace rac {
+
+MoveTabToSpaceSubMenuModel::MoveTabToSpaceSubMenuModel(
+    ui::SimpleMenuModel::Delegate* parent_delegate,
+    TabStripModel* model,
+    int context_index)
+    : ExistingBaseSubMenuModel(parent_delegate,
+                               model,
+                               context_index,
+                               kMinMoveTabToSpaceCommandId,
+                               IDC_RAC_MOVE_TAB_TO_NEW_SPACE) {
+  std::vector<MenuItemInfo> items;
+  BrowserWindowInterface* browser =
+      model->delegate()->GetBrowserWindowInterface();
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  const std::optional<base::Uuid> current =
+      manager ? manager->GetSpaceForWindow(browser) : std::nullopt;
+  for (const Space& space : manager->spaces()->spaces()) {
+    MenuItemInfo item(space.name.empty() ? l10n_util::GetStringUTF16(
+                                               IDS_RAC_SPACE_FALLBACK_NAME)
+                                         : base::UTF8ToUTF16(space.name));
+    item.target_index = items.size();
+    // Moving to the space the window already shows does nothing; show it
+    // anyway so the list stays stable, marked as the current one.
+    if (current == space.id) {
+      item.accessible_name = item.text;
+    }
+    items.push_back(std::move(item));
+  }
+  Build(IDS_RAC_SPACES_NEW_SPACE, items);
+}
+
+MoveTabToSpaceSubMenuModel::~MoveTabToSpaceSubMenuModel() = default;
+
+// static
+bool MoveTabToSpaceSubMenuModel::ShouldShowSubmenu(TabStripModel* model) {
+  BrowserWindowInterface* browser =
+      model->delegate()->GetBrowserWindowInterface();
+  return SpacesWindowManager::From(browser) != nullptr;
+}
+
+void MoveTabToSpaceSubMenuModel::ExecuteExistingCommand(size_t target_index) {
+  BrowserWindowInterface* browser =
+      model()->delegate()->GetBrowserWindowInterface();
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  if (!manager) {
+    return;
+  }
+  const auto& spaces = manager->spaces()->spaces();
+  if (target_index >= spaces.size()) {
+    return;
+  }
+  manager->MoveTabsToSpace(browser, GetTabsToMove(), spaces[target_index].id);
+}
+
+std::vector<int> MoveTabToSpaceSubMenuModel::GetTabsToMove() {
+  const int context_index = GetContextIndex();
+  if (model()->IsTabSelected(context_index)) {
+    const ui::ListSelectionModel::SelectedIndices selected =
+        model()->selection_model().GetListSelectionModel().selected_indices();
+    return std::vector<int>(selected.begin(), selected.end());
+  }
+  return {context_index};
+}
+
+}  // namespace rac

+#ifndef CHROME_BROWSER_UI_RAC_SPACES_MOVE_TAB_TO_SPACE_SUB_MENU_MODEL_H_
+#define CHROME_BROWSER_UI_RAC_SPACES_MOVE_TAB_TO_SPACE_SUB_MENU_MODEL_H_
+
+#include <vector>
+
+#include "chrome/browser/ui/tabs/existing_base_sub_menu_model.h"
+
+class TabStripModel;
+
+namespace rac {
+
+// The "Move Tab to Space" submenu of the tab context menu: the profile's
+// spaces, plus a "New Space" entry.
+class MoveTabToSpaceSubMenuModel : public ExistingBaseSubMenuModel {
+ public:
+  MoveTabToSpaceSubMenuModel(ui::SimpleMenuModel::Delegate* parent_delegate,
+                             TabStripModel* model,
+                             int context_index);
+  MoveTabToSpaceSubMenuModel(const MoveTabToSpaceSubMenuModel&) = delete;
+  MoveTabToSpaceSubMenuModel& operator=(const MoveTabToSpaceSubMenuModel&) =
+      delete;
+  ~MoveTabToSpaceSubMenuModel() override;
+
+  // True when the window has spaces, so moving tabs between them makes
+  // sense.
+  static bool ShouldShowSubmenu(TabStripModel* model);
+
+ private:
+  // ExistingBaseSubMenuModel:
+  void ExecuteExistingCommand(size_t target_index) override;
+
+  // The tabs the command acts on: the context tab, or the selection when
+  // the context tab is selected.
+  std::vector<int> GetTabsToMove();
+};
+
+}  // namespace rac

+void SpacesWindowManager::UpdateColorMode(const WindowState& state) {
+  ui::BaseWindow* window = state.browser->GetWindow();
+  views::Widget* widget =
+      window
+          ? views::Widget::GetWidgetForNativeWindow(window->GetNativeWindow())
+          : nullptr;
+  if (!widget) {
+    return;
+  }
+  const Space* space = state.space ? spaces_->FindSpace(*state.space) : nullptr;
+  std::optional<ui::ColorProviderKey::ColorMode> color_mode;
+  if (space && space->theme.mode == SpaceTheme::Mode::kLight) {
+    color_mode = ui::ColorProviderKey::ColorMode::kLight;
+  } else if (space && space->theme.mode == SpaceTheme::Mode::kDark) {
+    color_mode = ui::ColorProviderKey::ColorMode::kDark;
+  }
+  widget->SetColorModeOverride(color_mode);
+}
+
+void SpacesWindowManager::ResetBrowserTheme() {
+  theme_reset_pending_ = false;
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(profile_);
+  if (!theme || theme->UsingPolicyTheme()) {
+    return;
+  }
+  if (theme->GetBrowserColorScheme() !=
+      ThemeService::BrowserColorScheme::kSystem) {
+    theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kSystem);
+  }
+  // Extension themes stay; only Chrome's seed colors are cleared.
+  if (!theme->UsingExtensionTheme() &&
+      (!theme->GetIsGrayscale() || theme->GetUserColor())) {
+    theme->SetIsGrayscale(true);
+  }
+}
+
+void SpacesWindowManager::OnThemeChanged() {
+  // Profile creation and theme sync can still set a seed color. Reset after
+  // the change finishes notifying rather than from inside it.
+  if (theme_reset_pending_) {
+    return;
+  }
+  theme_reset_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SpacesWindowManager::ResetBrowserTheme,
+                                weak_ptr_factory_.GetWeakPtr()));
+}

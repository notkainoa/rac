+TEST_F(SpacesServiceTest, AppearancePresetsAndIconPersistPerSpace) {
+  auto service = MakeService();
+  const SpaceId first = service->spaces()[0].id;
+  const SpaceId second = service->CreateSpace("Work");
+  RecordingObserver observer;
+  service->AddObserver(&observer);
+
+  ASSERT_EQ(service->FindSpace(first)->theme.color1, "#FFE9F4");
+  ASSERT_EQ(service->FindSpace(second)->theme.color1, "#FFCBD2");
+  EXPECT_FALSE(service->SetSpaceThemePreset(second, SpaceTheme::kPresetCount));
+  EXPECT_TRUE(service->SetSpaceThemePreset(second, 7));
+  EXPECT_TRUE(service->SetSpaceThemeMode(second, SpaceTheme::Mode::kDark));
+  EXPECT_TRUE(service->SetSpaceIcon(second, "🌊"));
+  EXPECT_FALSE(service->SetSpaceIcon(first, std::string(33, 'x')));
+  EXPECT_THAT(observer.appearance, ElementsAre(second, second, second));
+  service->RemoveObserver(&observer);
+
+  service.reset();
+  auto restored = MakeService();
+  ASSERT_NE(restored->FindSpace(second), nullptr);
+  EXPECT_EQ(restored->FindSpace(second)->theme.color1, "#226149");
+  EXPECT_EQ(restored->FindSpace(second)->theme.color2, "#26456B");
+  EXPECT_EQ(restored->FindSpace(second)->theme.mode, SpaceTheme::Mode::kDark);
+  EXPECT_EQ(restored->FindSpace(second)->icon, "🌊");
+  EXPECT_EQ(restored->FindSpace(first)->theme.color1, "#FFE9F4");
+}
+
+TEST_F(SpacesServiceTest, UnknownThemeFieldsSurviveAppearanceEdits) {
+  auto service = MakeService();
+  const SpaceId id = service->spaces()[0].id;
+  service->SetSpaceThemePreset(id, 2);
+  base::DictValue stored = Stored().Clone();
+  base::DictValue& space = (*stored.FindList("spaces"))[0].GetDict();
+  space.FindDict("theme")->Set("future_texture", "grain");
+  prefs_.SetDict(kSpaces, std::move(stored));
+
+  service.reset();
+  service = MakeService();
+  EXPECT_TRUE(service->SetSpaceThemeMode(id, SpaceTheme::Mode::kLight));
+  const auto* theme =
+      (*Stored().FindList("spaces"))[0].GetDict().FindDict("theme");
+  ASSERT_TRUE(theme);
+  EXPECT_EQ(*theme->FindString("future_texture"), "grain");
+}

+bool SpacesService::SetSpaceThemePreset(const SpaceId& id, size_t preset) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end() || preset >= SpaceTheme::kPresetCount) {
+    return false;
+  }
+  SpaceTheme chosen = SpaceTheme::Preset(preset);
+  if (it->theme.color1 == chosen.color1 && it->theme.color2 == chosen.color2) {
+    return true;
+  }
+  it->theme.color1 = std::move(chosen.color1);
+  it->theme.color2 = std::move(chosen.color2);
+  it->unknown_fields.Remove("theme");
+  Save();
+  for (Observer& observer : observers_) {
+    observer.OnSpaceAppearanceChanged(id);
+  }
+  return true;
+}
+
+bool SpacesService::SetSpaceThemeMode(const SpaceId& id,
+                                      SpaceTheme::Mode mode) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  if (it->theme.mode == mode) {
+    return true;
+  }
+  it->theme.mode = mode;
+  it->unknown_fields.Remove("theme");
+  Save();
+  for (Observer& observer : observers_) {
+    observer.OnSpaceAppearanceChanged(id);
+  }
+  return true;
+}
+
+bool SpacesService::SetSpaceIcon(const SpaceId& id, std::string icon) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end() || icon.size() > 32 || !base::IsStringUTF8(icon)) {
+    return false;
+  }
+  if (it->icon == icon) {
+    return true;
+  }
+  it->icon = std::move(icon);
+  Save();
+  for (Observer& observer : observers_) {
+    observer.OnSpaceAppearanceChanged(id);
+  }
+  return true;
+}
 

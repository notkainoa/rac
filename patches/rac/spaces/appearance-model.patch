+// The eight pairs use the SpaceStyleEditor pastel and drab picker colors.
+// Display P3 channels were converted to sRGB, then clipped where necessary.
+SpaceTheme SpaceTheme::Preset(size_t index) {
+  static constexpr std::array<std::pair<std::string_view, std::string_view>,
+                              kPresetCount>
+      kColors = {{{"#FFE9F4", "#F1D1EC"},
+                  {"#FFCBD2", "#FFE0D3"},
+                  {"#FFF9E5", "#DEFDEB"},
+                  {"#DCF3FC", "#C5C6E5"},
+                  {"#4E3A5A", "#693558"},
+                  {"#8F3F42", "#B16D40"},
+                  {"#D7B35D", "#7AA982"},
+                  {"#226149", "#26456B"}}};
+  const auto& [first, second] = kColors[index % kColors.size()];
+  SpaceTheme theme;
+  theme.color1 = first;
+  theme.color2 = second;
+  return theme;
+}
+
+base::DictValue SpaceTheme::ToDict() const {
+  base::DictValue dict = unknown_fields.Clone();
+  dict.Set("color1", color1);
+  dict.Set("color2", color2);
+  dict.Set("mode", mode == Mode::kLight  ? "light"
+                   : mode == Mode::kDark ? "dark"
+                                         : "auto");
+  return dict;
+}
+
+std::optional<SpaceTheme> SpaceTheme::FromDict(const base::DictValue& dict) {
+  const std::string* color1 = dict.FindString("color1");
+  const std::string* color2 = dict.FindString("color2");
+  if (!color1 || !color2 || !IsSrgbHex(*color1) || !IsSrgbHex(*color2)) {
+    return std::nullopt;
+  }
+  SpaceTheme theme;
+  theme.color1 = *color1;
+  theme.color2 = *color2;
+  if (const std::string* mode = dict.FindString("mode")) {
+    if (*mode == "light") {
+      theme.mode = Mode::kLight;
+    } else if (*mode == "dark") {
+      theme.mode = Mode::kDark;
+    } else if (*mode != "auto") {
+      return std::nullopt;
+    }
+  }
+  theme.unknown_fields = dict.Clone();
+  theme.unknown_fields.Remove("color1");
+  theme.unknown_fields.Remove("color2");
+  theme.unknown_fields.Remove("mode");
+  return theme;
+}

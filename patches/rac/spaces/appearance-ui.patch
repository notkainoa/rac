@@ -0,0 +1,87 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/spaces/space_tint_background.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "chrome/browser/rac/spaces/spaces_service.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/skia_paint_util.h"
+#include "ui/native_theme/native_theme.h"
+
+namespace rac {
+namespace {
+
+SkColor TintColor(const std::string& hex, SkAlpha alpha) {
+  uint32_t rgb = 0;
+  if (!base::HexStringToUInt(std::string_view(hex).substr(1), &rgb)) {
+    return SK_ColorTRANSPARENT;
+  }
+  return SkColorSetA(SK_ColorBLACK | rgb, alpha);
+}
+
+}  // namespace
+
+SpaceTintBackground::SpaceTintBackground(views::View& view,
+                                         BrowserView& browser_view)
+    : CustomCornersBackground(view, browser_view, FrameTheme(), ToolbarTheme()),
+      view_(&view),
+      browser_(browser_view.browser()),
+      manager_(SpacesWindowManager::From(browser_)) {
+  if (manager_) {
+    manager_->AddObserver(this);
+  }
+}
+
+SpaceTintBackground::~SpaceTintBackground() {
+  if (manager_) {
+    manager_->RemoveObserver(this);
+  }
+}
+
+void SpaceTintBackground::Paint(gfx::Canvas* canvas, views::View* view) const {
+  CustomCornersBackground::Paint(canvas, view);
+  if (!manager_) {
+    return;
+  }
+  const auto active = manager_->GetActiveSpaceId(browser_);
+  const Space* space =
+      active ? manager_->spaces()->FindSpace(*active) : nullptr;
+  const ui::ColorProvider* colors = view->GetColorProvider();
+  if (!space || !colors || view->width() <= 0 || view->height() <= 0) {
+    return;
+  }
+  const bool dark = space->theme.mode == SpaceTheme::Mode::kDark ||
+                    (space->theme.mode == SpaceTheme::Mode::kAuto &&
+                     view->GetNativeTheme()->preferred_color_scheme() ==
+                         ui::NativeTheme::PreferredColorScheme::kDark);
+  const SkAlpha alpha = SkColorGetA(colors->GetColor(
+      dark ? kColorRacSpaceTintDark : kColorRacSpaceTintLight));
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setShader(gfx::CreateGradientShader(
+      gfx::Point(), gfx::Point(view->width(), view->height()),
+      TintColor(space->theme.color1, alpha),
+      TintColor(space->theme.color2, alpha)));
+  canvas->DrawPath(GetBackgroundPath(), flags);
+}
+
+void SpaceTintBackground::OnActiveSpaceChanged(
+    BrowserWindowInterface* browser,
+    const std::optional<SpaceId>& previous,
+    const std::optional<SpaceId>& current) {
+  if (browser == browser_) {
+    view_->SchedulePaint();
+  }
+}
+
+void SpaceTintBackground::OnSpacesChanged() {
+  view_->SchedulePaint();
+}
+
+}  // namespace rac

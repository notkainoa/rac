+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_TINT_BACKGROUND_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_TINT_BACKGROUND_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "chrome/browser/ui/views/frame/custom_corners_background.h"
+
+namespace rac {
+
+// Paints a space's translucent gradient on this window's sidebar frame.
+// Observes changes rather than repainting on a timer.
+class SpaceTintBackground : public CustomCornersBackground,
+                            public SpacesWindowManager::Observer {
+ public:
+  SpaceTintBackground(views::View& view, BrowserView& browser_view);
+  ~SpaceTintBackground() override;
+
+  void Paint(gfx::Canvas* canvas, views::View* view) const override;
+
+  void OnActiveSpaceChanged(BrowserWindowInterface* browser,
+                            const std::optional<SpaceId>& previous,
+                            const std::optional<SpaceId>& current) override;
+  void OnSpacesChanged() override;
+
+ private:
+  const raw_ptr<views::View> view_;
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<SpacesWindowManager> manager_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SPACES_SPACE_TINT_BACKGROUND_H_

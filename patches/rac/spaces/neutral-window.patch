+// The theme a window that hasn't claimed its space yet is about to show, so
+// its first frames already paint that wash instead of the plain frame color.
+// The claim waits for the spaces file, but the spaces list is a pref, so this
+// reads only memory. It mirrors ClaimInitialSpace: a restored window's own
+// space, else the most recent space no window holds, else the new space the
+// window will create, whose preset is kept in `new_space`.
+const SpaceTheme* PredictedTheme(SpacesWindowManager& manager,
+                                 BrowserWindowInterface* browser,
+                                 std::optional<SpaceTheme>& new_space) {
+  SpacesService* spaces = manager.spaces();
+  const BrowserInitState* init = BrowserInitState::From(browser);
+  if (init && init->creation_source() ==
+                  BrowserWindowCreateParams::CreationSource::kSessionRestore) {
+    const auto& extra = init->restored_window_extra_data();
+    if (auto it = extra.find(kWindowSpaceExtraDataKey); it != extra.end()) {
+      if (const Space* space =
+              spaces->FindSpace(base::Uuid::ParseCaseInsensitive(it->second))) {
+        return &space->theme;
+      }
+    }
+  }
+  for (const base::Uuid& id : spaces->GetSpacesByRecentUse()) {
+    const Space* space = spaces->FindSpace(id);
+    if (space && !manager.GetWindowHoldingSpace(id)) {
+      return &space->theme;
+    }
+  }
+  return &new_space.emplace(SpaceTheme::Preset(spaces->spaces().size()));
+}
+

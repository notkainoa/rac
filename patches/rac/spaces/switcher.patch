+
+#ifndef CHROME_BROWSER_UI_RAC_SPACES_SPACE_SWITCHER_VIEW_H_
+#define CHROME_BROWSER_UI_RAC_SPACES_SPACE_SWITCHER_VIEW_H_
+
+#include <memory>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/rac/spaces/spaces_window_manager.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class FlexLayout;
+}
+
+namespace tabs {
+class VerticalTabStripStateController;
+}  // namespace tabs
+
+namespace rac {
+
+// The row of space dots at the bottom of the vertical tab strip: one dot
+// per space, then a button that creates a space. Dots stack into a column
+// when the strip is collapsed. Hidden in windows without spaces (incognito,
+// apps, popups).
+class SpaceSwitcherView : public views::View,
+                          public SpacesWindowManager::Observer {
+  METADATA_HEADER(SpaceSwitcherView, views::View)
+
+ public:
+  SpaceSwitcherView(BrowserWindowInterface* browser,
+                    tabs::VerticalTabStripStateController* state_controller);
+  SpaceSwitcherView(const SpaceSwitcherView&) = delete;
+  SpaceSwitcherView& operator=(const SpaceSwitcherView&) = delete;
+  ~SpaceSwitcherView() override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+  // SpacesWindowManager::Observer:
+  void OnWindowSpaceChanged(BrowserWindowInterface* browser) override;
+  void OnSpacesChanged() override;
+
+ private:
+  // Rebuilds the dots from the profile's spaces, keeping the new-space
+  // button last.
+  void Rebuild();
+  // Restacks the dots for the strip's width.
+  void SetOrientation(bool collapsed);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  // Null in windows without spaces.
+  const raw_ptr<SpacesWindowManager> manager_;
+
+  raw_ptr<views::FlexLayout> layout_ = nullptr;
+
+  base::CallbackListSubscription collapse_subscription_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SPACES_SPACE_SWITCHER_VIEW_H_

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_SPACES_SPACE_SWIPE_CONTROLLER_H_
+#define CHROME_BROWSER_UI_RAC_SPACES_SPACE_SWIPE_CONTROLLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "build/build_config.h"
+#include "ui/events/event_handler.h"
+
+class VerticalTabStripRegionView;
+
+namespace rac {
+
+// Handles two-finger horizontal swipes across the vertical tab strip to
+// move between spaces. Installed as a pre-target handler on
+// VerticalTabStripRegionView, after the tab-group focus swipe controller,
+// which gets events first while its feature is on.
+class SpaceSwipeController : public ui::EventHandler {
+ public:
+  static constexpr float kAxisLockThreshold = 15.0f;
+  static constexpr float kSwipeThreshold = 75.0f;
+  static constexpr base::TimeDelta kGestureResetTimeout =
+      base::Milliseconds(300);
+
+  explicit SpaceSwipeController(VerticalTabStripRegionView* region_view);
+  SpaceSwipeController(const SpaceSwipeController&) = delete;
+  SpaceSwipeController& operator=(const SpaceSwipeController&) = delete;
+  ~SpaceSwipeController() override;
+
+  // ui::EventHandler:
+#if BUILDFLAG(IS_MAC)
+  void OnScrollEvent(ui::ScrollEvent* event) override;
+#endif
+
+ private:
+  enum class GestureState {
+    kNone,
+    kHorizontalSwipe,
+    kVerticalPassthrough,
+  };
+
+  void ProcessSwipeOffset(float x_offset, float y_offset, ui::Event* event);
+  void ResetGesture();
+  // Switches the window's space, if it can move in that direction. Returns
+  // false when there's nothing to switch to.
+  bool SwitchSpace(bool forward);
+
+  const raw_ptr<VerticalTabStripRegionView> region_view_;
+
+  GestureState gesture_state_ = GestureState::kNone;
+  float cumulative_x_ = 0.0f;
+  float cumulative_y_ = 0.0f;
+  bool has_triggered_in_current_gesture_ = false;
+  base::TimeTicks last_event_time_;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_SPACES_SPACE_SWIPE_CONTROLLER_H_

+
+#include "chrome/browser/ui/rac/spaces/space_switcher_view.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/rac/spaces/space.h"
+#include "chrome/browser/rac/spaces/spaces_service.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_ink_drop_util.h"
+#include "chrome/grit/generated_resources.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/layout/flex_layout.h"
+
+namespace rac {
+
+namespace {
+
+constexpr int kDotTargetSize = 24;
+constexpr float kDotRadius = 4.0f;
+constexpr float kActiveDotRadius = 5.0f;
+constexpr int kDotGap = 2;
+constexpr int kAddIconSize = 14;
+
+// One dot in the switcher. A filled circle; the current space's dot is
+// bigger and brighter.
+class SpaceDotButton : public views::Button {
+  METADATA_HEADER(SpaceDotButton, views::Button)
+
+ public:
+  SpaceDotButton(base::RepeatingClosure on_pressed, bool active)
+      : views::Button(std::move(on_pressed)), active_(active) {
+    SetPreferredSize(gfx::Size(kDotTargetSize, kDotTargetSize));
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    ConfigureInkDrop(this);
+  }
+
+  // views::Button:
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    const SkColor color = color_provider->GetColor(
+        active_ ? kColorToolbarButtonIcon : kColorToolbarButtonIconInactive);
+    const gfx::Rect bounds = GetLocalBounds();
+    const float radius = active_ ? kActiveDotRadius : kDotRadius;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color);
+    canvas->DrawCircle(bounds.CenterPoint(), radius, flags);
+  }
+
+ private:
+  bool active_;
+};
+
+BEGIN_METADATA(SpaceDotButton)
+END_METADATA
+
+}  // namespace
+
+SpaceSwitcherView::SpaceSwitcherView(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser), manager_(SpacesWindowManager::From(browser_)) {
+  layout_ = SetLayoutManager(std::make_unique<views::FlexLayout>());
+  layout_->SetMainAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetInteriorMargin(gfx::Insets::VH(2, 0))
+      .SetDefault(views::kMarginsKey, gfx::Insets(kDotGap));
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kToolbar);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_RAC_SPACES_SWITCHER_ACCESSIBLE_NAME));
+
+  if (!manager_) {
+    SetVisible(false);
+    return;
+  }
+  manager_->AddObserver(this);
+
+  if (state_controller) {
+    SetOrientation(state_controller->GetCollapseState() !=
+                   tabs::VerticalTabStripCollapseState::kExpanded);
+    collapse_subscription_ =
+        state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+            [](SpaceSwitcherView* self,
+               tabs::VerticalTabStripCollapseState state) {
+              self->SetOrientation(
+                  state != tabs::VerticalTabStripCollapseState::kExpanded);
+            },
+            base::Unretained(this)));
+  }
+
+  Rebuild();
+}
+
+BEGIN_METADATA(SpaceSwitcherView)
+END_METADATA
+
+SpaceSwitcherView::~SpaceSwitcherView() {
+  if (manager_) {
+    manager_->RemoveObserver(this);
+  }
+}
+
+void SpaceSwitcherView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  SchedulePaint();
+}
+
+void SpaceSwitcherView::OnWindowSpaceChanged(BrowserWindowInterface* browser) {
+  if (browser == browser_) {
+    Rebuild();
+  }
+}
+
+void SpaceSwitcherView::OnSpacesChanged() {
+  Rebuild();
+}
+
+void SpaceSwitcherView::Rebuild() {
+  RemoveAllChildViews();
+  if (!manager_) {
+    return;
+  }
+  const std::optional<base::Uuid> current =
+      manager_->GetSpaceForWindow(browser_);
+  const auto& spaces = manager_->spaces()->spaces();
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    const Space& space = spaces[i];
+    const std::u16string name =
+        space.name.empty()
+            ? l10n_util::GetStringFUTF16(IDS_RAC_SPACE_FALLBACK_NAME,
+                                         base::NumberToString16(i + 1))
+            : base::UTF8ToUTF16(space.name);
+    auto dot = std::make_unique<SpaceDotButton>(
+        base::BindRepeating(&SpacesWindowManager::ShowSpace,
+                            base::Unretained(manager_), browser_, space.id),
+        current == space.id);
+    dot->SetTooltipText(name);
+    dot->SetAccessibleName(name);
+    AddChildView(std::move(dot));
+  }
+
+  auto add_button = std::make_unique<views::LabelButton>(
+      base::BindRepeating(&SpacesWindowManager::CreateAndShowSpace,
+                          base::Unretained(manager_), browser_));
+  const int icon_size = kAddIconSize;
+  add_button->SetImageModel(views::Button::STATE_NORMAL,
+                            ui::ImageModel::FromVectorIcon(
+                                kAddIcon, kColorToolbarButtonIcon, icon_size));
+  const std::u16string add_name =
+      l10n_util::GetStringUTF16(IDS_RAC_SPACES_NEW_SPACE);
+  add_button->SetTooltipText(add_name);
+  add_button->SetAccessibleName(add_name);
+  add_button->SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  ConfigureInkDrop(add_button.get());
+  AddChildView(std::move(add_button));
+}
+
+void SpaceSwitcherView::SetOrientation(bool collapsed) {
+  layout_->SetOrientation(collapsed ? views::LayoutOrientation::kVertical
+                                    : views::LayoutOrientation::kHorizontal);
+}
+
+}  // namespace rac

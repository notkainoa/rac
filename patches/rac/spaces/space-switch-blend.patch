+void SpacePager::BlendTowardNeighbor() {
+  const float offset = GetOffset();
+  // Negative offsets show the next space.
+  const std::optional<SpaceId> current = manager_->GetActiveSpaceId(browser_);
+  const std::optional<SpaceId> neighbor =
+      offset == 0 ? std::nullopt : GetAdjacentSpace(offset < 0 ? 1 : -1);
+  if (!current || !neighbor) {
+    EndBlend();
+    return;
+  }
+  blend_ = Blend{*current, *neighbor, /*toward_current=*/false,
+                 offset < 0 ? -1.0f : 1.0f};
+  PublishBlend(base::TimeTicks::Now());
+}
+
+void SpacePager::PublishBlend(base::TimeTicks now) {
+  if (!blend_) {
+    return;
+  }
+  float progress = 0;
+  if (!fade_start_.is_null()) {
+    const double linear =
+        (now - fade_start_) / tokens::kReducedFade.duration;
+    const Curve& curve = tokens::kReducedFade.curve;
+    const double eased =
+        gfx::CubicBezier(curve.x1, curve.y1, curve.x2, curve.y2)
+            .Solve(std::clamp(linear, 0.0, 1.0));
+    progress = fade_from_ + (fade_to_ - fade_from_) * eased;
+  } else {
+    const float spacing = GetPageSpacing();
+    // Past rest, a spring has already arrived.
+    const float apart =
+        spacing > 0
+            ? std::min(1.0f, std::max(0.0f, GetOffset() * blend_->sign) /
+                                 spacing)
+            : 0;
+    progress = blend_->toward_current ? 1 - apart : apart;
+  }
+  progress = std::clamp(progress, 0.0f, 1.0f);
+  // Dev builds log the moves on their own apart from a drag's, which only
+  // follows the fingers.
+  dev::LogAnimationStep(dragging_ ? "space.drag" : "space.switch", progress);
+  SetSpaceSwitchBlend(browser_,
+                      SpaceSwitchBlend{blend_->from, blend_->to, progress});
+}
+
+void SpacePager::EndBlend() {
+  StopTicking();
+  if (std::exchange(blend_, std::nullopt)) {
+    dev::LogAnimationStep("space.switch", -1);
+    SetSpaceSwitchBlend(browser_, std::nullopt);
+  }
+}
+
+void SpacePager::StartTicking() {
+  views::View* page = GetPage();
+  ui::Compositor* compositor =
+      page && blend_ ? page->layer()->GetCompositor() : nullptr;
+  if (!compositor || compositor == ticking_) {
+    return;
+  }
+  StopTicking();
+  ticking_ = compositor;
+  compositor->AddAnimationObserver(this);
+}
+
+void SpacePager::StopTicking() {
+  if (ticking_) {
+    ticking_->RemoveAnimationObserver(this);
+    ticking_ = nullptr;
   }

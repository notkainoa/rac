+      return l10n_util::GetStringUTF16(IDS_RAC_EMOJI_GROUP_TRAVEL_AND_PLACES);
+    case EmojiGroup::kActivities:
+      return l10n_util::GetStringUTF16(IDS_RAC_EMOJI_GROUP_ACTIVITIES);
+    case EmojiGroup::kObjects:
+      return l10n_util::GetStringUTF16(IDS_RAC_EMOJI_GROUP_OBJECTS);
+    case EmojiGroup::kSymbols:
+      return l10n_util::GetStringUTF16(IDS_RAC_EMOJI_GROUP_SYMBOLS);
+    case EmojiGroup::kFlags:
+      return l10n_util::GetStringUTF16(IDS_RAC_EMOJI_GROUP_FLAGS);

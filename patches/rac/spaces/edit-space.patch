+// The emoji themselves. Painted rather than built from a view per emoji,
+// since there are nearly two thousand and only a few dozen show at once.
+class EmojiPickerView::Grid : public views::View {
+  METADATA_HEADER(Grid, views::View)
+
+ public:
+  explicit Grid(PickCallback on_pick) : on_pick_(std::move(on_pick)) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kGrid);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_RAC_SPACES_ICON_EMOJI));
+  }
+  Grid(const Grid&) = delete;
+  Grid& operator=(const Grid&) = delete;
+  ~Grid() override = default;
+
+  // Lays out `items`, with a heading over each category when `grouped`.
+  void SetItems(base::span<const EmojiInfo* const> items, bool grouped) {
+    items_.clear();
+    headings_.clear();
+    hovered_ = selected_ = pressed_ = -1;
+    int y = 0;
+    int column = 0;
+    std::optional<EmojiGroup> group;
+    for (const EmojiInfo* info : items) {
+      if (grouped && info->group != group) {
+        if (column > 0) {
+          y += kCellSize;
+          column = 0;
+        }
+        group = info->group;
+        headings_.push_back({*group, GroupName(*group), y});
+        y += kHeadingHeight;
+      }
+      items_.push_back(
+          {info, base::UTF8ToUTF16(info->emoji),
+           gfx::Rect(column * kCellSize, y, kCellSize, kCellSize)});
+      if (++column == kColumns) {
+        y += kCellSize;
+        column = 0;
+      }
+    }
+    height_ = y + (column > 0 ? kCellSize : 0);
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+
+  void SetCurrent(const std::string& emoji) {
+    current_ = emoji;
+    SchedulePaint();
+  }
+
+  bool empty() const { return items_.empty(); }
+
+  std::optional<int> GetGroupTop(EmojiGroup group) const {
+    for (const Heading& heading : headings_) {
+      if (heading.group == group) {
+        return heading.y;
+      }
+    }
+    return std::nullopt;
+  }
+
+  // The category whose heading is at or above `y`.
+  std::optional<EmojiGroup> GetGroupAt(int y) const {
+    std::optional<EmojiGroup> group;
+    for (const Heading& heading : headings_) {
+      if (heading.y > y) {
+        break;
+      }
+      group = heading.group;
+    }
+    return group;
+  }
+
+  bool has_selection() const { return selected_ >= 0; }
+
+  void ClearSelection() {
+    selected_ = -1;
+    SchedulePaint();
+  }
+
+  // Moves the keyboard selection by `columns` within a row, or by one row
+  // up or down when `rows` is set. Starts at the first emoji. False if the
+  // selection can't move that way.
+  bool MoveSelection(int columns, int rows) {
+    if (items_.empty()) {
+      return false;
+    }
+    if (selected_ < 0) {
+      if (rows < 0) {
+        return false;
+      }
+      SetSelected(0);
+      return true;
+    }
+    int next = selected_;
+    if (rows == 0) {
+      next = std::clamp(selected_ + columns, 0,
+                        static_cast<int>(items_.size()) - 1);
+    } else {
+      const gfx::Rect& from = items_[selected_].bounds;
+      const int step = rows > 0 ? 1 : -1;
+      int row_y = -1;
+      for (int i = selected_ + step;
+           i >= 0 && i < static_cast<int>(items_.size()); i += step) {
+        const gfx::Rect& bounds = items_[i].bounds;
+        if (row_y < 0 && bounds.y() != from.y()) {
+          row_y = bounds.y();
+        }
+        if (row_y < 0) {
+          continue;
+        }
+        if (bounds.y() != row_y) {
+          break;
+        }
+        next = i;
+        // Going down, the nearest column is the last one not past this one.
+        // Going up, it's the first one not before it.
+        if (rows > 0 ? bounds.x() >= from.x() : bounds.x() <= from.x()) {
+          break;
+        }
+      }
+    }
+    if (next == selected_) {
+      return false;
+    }
+    SetSelected(next);
+    return true;
+  }
+
+  // Picks the selected emoji, or the first when searching left none
+  // selected. False if there's nothing to pick.
+  bool PickSelected() {
+    if (items_.empty()) {
+      return false;
+    }
+    Pick(std::max(selected_, 0));
+    return true;
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kColumns * kCellSize, height_);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    gfx::Rect clip = GetVisibleBounds();
+    gfx::Rect canvas_clip;
+    if (canvas->GetClipBounds(&canvas_clip)) {
+      clip.Intersect(canvas_clip);
+    }
+    for (const Heading& heading : headings_) {
+      const gfx::Rect bounds(6, heading.y, width() - 12, kHeadingHeight);
+      if (bounds.Intersects(clip)) {
+        canvas->DrawStringRectWithFlags(
+            heading.text, HeadingFont(),
+            colors->GetColor(ui::kColorSysOnSurfaceSubtle), bounds,
+            gfx::Canvas::TEXT_ALIGN_LEFT);
+      }
+    }
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    for (size_t i = 0; i < items_.size(); ++i) {
+      const Item& item = items_[i];
+      if (!item.bounds.Intersects(clip)) {
+        continue;
+      }
+      const int index = static_cast<int>(i);
+      const bool current = !current_.empty() && current_ == item.info->emoji;
+      const bool highlighted = index == hovered_ || index == selected_;
+      if (current || highlighted) {
+        fill.setColor(FaintFill(colors, current ? 0x24 : 0x14));
+        canvas->DrawRoundRect(gfx::RectF(item.bounds), kCellRadius, fill);
+      }
+      canvas->DrawStringRectWithFlags(
+          item.text, EmojiFont(), colors->GetColor(ui::kColorSysOnSurface),
+          item.bounds, gfx::Canvas::TEXT_ALIGN_CENTER);
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    pressed_ = IndexAt(event.location());
+    return pressed_ >= 0;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    const int index = IndexAt(event.location());
+    if (index >= 0 && index == pressed_) {
+      Pick(index);
+    }
+    pressed_ = -1;
+  }
+
+  void OnMouseMoved(const ui::MouseEvent& event) override {
+    SetHovered(IndexAt(event.location()));
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override { SetHovered(-1); }
+
+  std::u16string GetRenderedTooltipText(
+      const gfx::Point& point) const override {
+    const int index = IndexAt(point);
+    return index >= 0 ? base::UTF8ToUTF16(items_[index].info->name)
+                      : std::u16string();
+  }
+
+ private:
+  struct Item {
+    raw_ptr<const EmojiInfo> info;
+    std::u16string text;
+    gfx::Rect bounds;
+  };
+  struct Heading {
+    EmojiGroup group;
+    std::u16string text;
+    int y;
+  };
+
+  int IndexAt(const gfx::Point& point) const {
+    // Items are in reading order, so the first whose bottom is below the
+    // point starts its row.
+    auto it = std::ranges::partition_point(items_, [&](const Item& item) {
+      return item.bounds.bottom() <= point.y();
+    });
+    for (; it != items_.end() && it->bounds.y() <= point.y(); ++it) {
+      if (it->bounds.Contains(point)) {
+        return static_cast<int>(it - items_.begin());
+      }
+    }
+    return -1;
+  }
+
+  void SetHovered(int index) {
+    if (hovered_ == index) {
+      return;
+    }
+    hovered_ = index;
+    TooltipTextChanged();
+    SchedulePaint();
+  }
+
+  void SetSelected(int index) {
+    if (selected_ == index) {
+      return;
+    }
+    selected_ = index;
+    ScrollRectToVisible(items_[index].bounds);
+    GetViewAccessibility().AnnouncePolitely(
+        base::UTF8ToUTF16(items_[index].info->name));
+    SchedulePaint();
+  }
+
+  void Pick(int index) {
+    // Runs last: picking may rebuild the grid.
+    const std::string emoji = items_[index].info->emoji;
+    on_pick_.Run(emoji);
+  }
+
+  PickCallback on_pick_;
+  std::vector<Item> items_;
+  std::vector<Heading> headings_;
+  int height_ = 0;
+  int hovered_ = -1;
+  int selected_ = -1;
+  int pressed_ = -1;
+  std::string current_;
+};
+
+BEGIN_METADATA(EmojiPickerView, Grid)
+END_METADATA

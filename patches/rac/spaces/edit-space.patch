+// The first drawn view of class T under `view`.
+template <typename T>
+T* FindDrawn(views::View* view) {
+  if (!view->IsDrawn()) {
+    return nullptr;
+  }
+  if (auto* found = views::AsViewClass<T>(view)) {
+    return found;
+  }
+  for (views::View* child : view->children()) {
+    if (T* found = FindDrawn<T>(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}

+
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace rac {
+
+// The picker's categories, in the order the table lists them.
+enum class EmojiGroup {
+  kSmileysAndPeople,
+  kAnimalsAndNature,
+  kFoodAndDrink,
+  kTravelAndPlaces,
+  kActivities,
+  kObjects,
+  kSymbols,
+  kFlags,
+  kMaxValue = kFlags,
+};
+
+struct EmojiInfo {
+  // Fully qualified UTF-8, ready to store as a space's icon.
+  const char* emoji;
+  // CLDR's English name, such as "grinning face".
+  const char* name;
+  // The lowercase name and keywords, separated by '|'.
+  const char* search_terms;
+  EmojiGroup group;
+};
+
+// Every emoji the picker offers, grouped by category, without skin tone
+// variants.
+base::span<const EmojiInfo> GetEmoji();
+
+// Emoji whose name or keywords have a word starting with each word of
+// `query`, in table order. Case doesn't matter.
+std::vector<const EmojiInfo*> SearchEmoji(std::u16string_view query);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_SPACES_EMOJI_DATA_H_

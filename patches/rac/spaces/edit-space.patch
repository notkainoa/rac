+void ShowEditSpaceBubble(views::View* anchor,
+                         SpacesService* spaces,
+                         const base::Uuid& space) {
+  if (!anchor || !anchor->GetWidget() || !spaces->FindSpace(space)) {
+    return;
+  }
+  // In the sidebar, open toward the page, from whichever end the anchor is
+  // nearer.
+  const gfx::Rect bounds =
+      anchor->ConvertRectToWidget(anchor->GetLocalBounds());
+  const bool open_below = bounds.CenterPoint().y() <
+                          anchor->GetWidget()->GetRootView()->height() / 2;
+  new EditSpaceBubble(anchor, gfx::Rect(),
+                      GetSidebarBubbleArrow(anchor, open_below),
+                      anchor->GetWidget(), spaces, space);
+}
+
+void ShowEditSpaceBubbleForBrowser(BrowserWindowInterface* browser) {
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!manager || !browser_view) {
+    return;
+  }
+  const std::optional<SpaceId> space = manager->GetActiveSpaceId(browser);
+  if (!space) {
+    return;
+  }
+  // Prefer the space's own controls, so the popup points at what it edits.
+  views::View* anchor = FindDrawn<SpaceSwitcherView>(browser_view);
+  if (!anchor) {
+    anchor = FindDrawn<SpaceTabListHeader>(browser_view);
+  }
+  if (anchor) {
+    ShowEditSpaceBubble(anchor, manager->spaces(), *space);
+    return;
+  }
+  // With the sidebar hidden, open from the page's top corner.
+  constexpr int kPageInset = 12;
+  const gfx::Rect page =
+      browser_view->contents_container()->GetBoundsInScreen();
+  new EditSpaceBubble(
+      nullptr, gfx::Rect(page.x() + kPageInset, page.y() + kPageInset, 0, 0),
+      views::BubbleBorder::TOP_LEFT, browser_view->GetWidget(),
+      manager->spaces(), *space);
+}
+
+}  // namespace rac

+EmojiPickerView::EmojiPickerView(PickCallback on_pick) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kGap));
+
+  auto* row = AddChildView(std::make_unique<views::View>());
+  auto* row_layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), kGap));
+  search_row_ = row;
+
+  auto box = std::make_unique<views::View>();
+  auto* box_layout = box->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 10), 6));
+  box_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  box->SetPreferredSize(gfx::Size(0, kSearchHeight));
+  auto* icon = box->AddChildView(
+      std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+          vector_icons::kSearchIcon, ui::kColorSysOnSurfaceSubtle,
+          kSearchIconSize)));
+  icon->SetCanProcessEventsWithinSubtree(false);
+  search_ = box->AddChildView(std::make_unique<views::Textfield>());
+  search_->set_controller(this);
+  search_->SetBorder(views::NullBorder());
+  search_->SetBackgroundEnabled(false);
+  search_->RemoveHoverEffect();
+  const std::u16string placeholder =
+      l10n_util::GetStringUTF16(IDS_RAC_SPACES_EMOJI_SEARCH);
+  search_->SetPlaceholderText(placeholder);
+  search_->GetViewAccessibility().SetName(placeholder);
+  search_->SetTextColorId(ui::kColorSysOnSurface);
+  search_->SetPlaceholderTextColorId(ui::kColorSysOnSurfaceSubtle);
+  box_layout->SetFlexForView(search_, 1);
+  search_box_ = row->AddChildView(std::move(box));
+  row_layout->SetFlexForView(search_box_, 1);
+
+  scroll_ = AddChildView(std::make_unique<views::ScrollView>(
+      views::ScrollView::ScrollWithLayers::kDisabled));
+  scroll_->SetBackgroundColor(std::nullopt);
+  scroll_->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_->SetDrawOverflowIndicator(false);
+  scroll_->SetPreferredSize(gfx::Size(kColumns * kCellSize, kGridHeight));
+  // Bounds the height so the scroll view sizes the grid to its width.
+  scroll_->ClipHeightTo(kGridHeight, kGridHeight);
+  grid_ = scroll_->SetContents(std::make_unique<Grid>(std::move(on_pick)));
+  scroll_subscription_ =
+      scroll_->AddContentsScrolledCallback(base::BindRepeating(
+          &EmojiPickerView::UpdateTabs, base::Unretained(this)));
+
+  no_matches_ = AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_RAC_SPACES_EMOJI_NO_MATCHES)));
+  no_matches_->SetEnabledColor(ui::kColorSysOnSurfaceSubtle);
+  no_matches_->SetPreferredSize(gfx::Size(kColumns * kCellSize, kGridHeight));
+  no_matches_->SetVisible(false);
+
+  auto* tabs = AddChildView(std::make_unique<views::View>());
+  // The tabs spread across the grid's width.
+  constexpr int kTabGap =
+      (kColumns * kCellSize - kTabSize * static_cast<int>(kGroupCount)) /
+      (static_cast<int>(kGroupCount) - 1);
+  auto* tabs_layout = tabs->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), kTabGap));
+  tabs_layout->set_main_axis_alignment(
+      views::BoxLayout::MainAxisAlignment::kCenter);
+  tabs->GetViewAccessibility().SetRole(ax::mojom::Role::kTabList);
+  for (size_t i = 0; i < kGroupCount; ++i) {
+    const auto group = static_cast<EmojiGroup>(i);
+    tabs_[i] = tabs->AddChildView(std::make_unique<CategoryTab>(
+        base::BindRepeating(&EmojiPickerView::ShowGroup, base::Unretained(this),
+                            group),
+        group));
+  }
+
+  std::vector<const EmojiInfo*> all;
+  for (const EmojiInfo& info : GetEmoji()) {
+    all.push_back(&info);
+  }
+  grid_->SetItems(all, /*grouped=*/true);
+  UpdateTabs();
+}
+
+EmojiPickerView::~EmojiPickerView() = default;
+
+void EmojiPickerView::SetCurrentEmoji(const std::string& emoji) {
+  grid_->SetCurrent(emoji);
+}
+
+void EmojiPickerView::ContentsChanged(views::Textfield* sender,
+                                      const std::u16string& new_contents) {
+  const std::u16string_view query =
+      base::TrimWhitespace(new_contents, base::TRIM_ALL);
+  if (query.empty()) {
+    std::vector<const EmojiInfo*> all;
+    for (const EmojiInfo& info : GetEmoji()) {
+      all.push_back(&info);
+    }
+    grid_->SetItems(all, /*grouped=*/true);
+  } else {
+    grid_->SetItems(SearchEmoji(query), /*grouped=*/false);
+  }
+  scroll_->ScrollToOffset(gfx::PointF());
+  scroll_->SetVisible(!grid_->empty());
+  no_matches_->SetVisible(grid_->empty());
+  UpdateTabs();
+}
+
+bool EmojiPickerView::HandleKeyEvent(views::Textfield* sender,
+                                     const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  switch (key_event.key_code()) {
+    case ui::VKEY_DOWN:
+      grid_->MoveSelection(0, 1);
+      return true;
+    case ui::VKEY_UP:
+      // From the top row, the arrow goes back to the search text.
+      if (!grid_->MoveSelection(0, -1)) {
+        grid_->ClearSelection();
+      }
+      return true;
+    case ui::VKEY_LEFT:
+    case ui::VKEY_RIGHT:
+      // Until an emoji is selected, the arrows move the caret.
+      if (!grid_->has_selection()) {
+        return false;
+      }
+      grid_->MoveSelection(key_event.key_code() == ui::VKEY_LEFT ? -1 : 1, 0);
+      return true;
+    case ui::VKEY_RETURN:
+      return grid_->PickSelected();
+    default:
+      return false;
+  }
+}
+
+void EmojiPickerView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  search_box_->SetBackground(views::CreateRoundedRectBackground(
+      FaintFill(GetColorProvider(), 0x0F), kSearchRadius));
+}
+
+void EmojiPickerView::ShowGroup(EmojiGroup group) {
+  if (!search_->GetText().empty()) {
+    // Clearing the search lays the whole grid out again.
+    search_->SetText(std::u16string());
+    ContentsChanged(search_, std::u16string());
+  }
+  if (std::optional<int> top = grid_->GetGroupTop(group)) {
+    scroll_->ScrollToOffset(gfx::PointF(0, *top));
+  }
+  UpdateTabs();
+}
+
+void EmojiPickerView::UpdateTabs() {
+  current_group_ = std::nullopt;
+  if (search_->GetText().empty()) {
+    // A category counts as in view once its heading reaches the top.
+    current_group_ =
+        grid_->GetGroupAt(static_cast<int>(scroll_->CurrentOffset().y()) + 1);
+  }
+  for (size_t i = 0; i < kGroupCount; ++i) {
+    static_cast<CategoryTab*>(tabs_[i].get())
+        ->SetActive(current_group_ &&
+                    GroupIndex(*current_group_) == static_cast<int>(i));
+  }
+}

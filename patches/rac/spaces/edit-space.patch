+// Owns the popup and deletes itself once it closes. Only one is open at a
+// time.
+class EditSpaceBubble {
+ public:
+  EditSpaceBubble(views::View* anchor,
+                  const gfx::Rect& anchor_rect,
+                  views::BubbleBorder::Arrow arrow,
+                  views::Widget* parent,
+                  SpacesService* spaces,
+                  const base::Uuid& space) {
+    if (Current()) {
+      Current()->Close();
+    }
+    Current() = this;
+    auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+        anchor, arrow, views::BubbleBorder::STANDARD_SHADOW,
+        /*autosize=*/true);
+    if (!anchor) {
+      delegate->SetAnchorRect(anchor_rect);
+      delegate->set_parent_window(parent->GetNativeView());
+    }
+    delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate->SetShowCloseButton(false);
+    delegate->set_margins(gfx::Insets());
+    delegate->set_corner_radius(kBubbleRadius);
+    delegate->SetBackgroundColor(kColorProfileMenuBackground);
+    delegate->set_fixed_width(kWidth);
+    delegate->SetAccessibleTitle(
+        l10n_util::GetStringUTF16(IDS_RAC_SPACES_EDIT_TITLE));
+    auto* contents = delegate->SetContentsView(
+        std::make_unique<EditSpaceView>(spaces, space));
+    delegate->SetInitiallyFocusedView(contents->name_field());
+    delegate_ = std::move(delegate);
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(), base::BindOnce(&EditSpaceBubble::OnWidgetClosed,
+                                        weak_factory_.GetWeakPtr()));
+    widget_->Show();
+    contents->name_field()->SelectAll(/*reversed=*/false);
+  }
+  EditSpaceBubble(const EditSpaceBubble&) = delete;
+  EditSpaceBubble& operator=(const EditSpaceBubble&) = delete;
+  ~EditSpaceBubble() = default;
+
+  static EditSpaceBubble*& Current() {
+    static EditSpaceBubble* current = nullptr;
+    return current;
+  }
+
+  void Close() {
+    if (Current() == this) {
+      Current() = nullptr;
+    }
+    if (widget_ && !widget_->IsClosed()) {
+      widget_->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+    }
+  }
+
+ private:
+  void OnWidgetClosed(views::Widget::ClosedReason reason) {
+    if (Current() == this) {
+      Current() = nullptr;
+    }
+    // The widget is still on the stack that reported its closing.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                  this);
+  }
+
+  // Outlives `widget_`, which is declared after it.
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  base::WeakPtrFactory<EditSpaceBubble> weak_factory_{this};
+};

+std::u16string FallbackName(SpacesService* spaces, const base::Uuid& space) {
+  return l10n_util::GetStringFUTF16(
+      IDS_RAC_SPACE_FALLBACK_NAME,
+      base::NumberToString16(spaces->GetIndex(space).value_or(0) + 1));
+}

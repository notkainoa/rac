+// One category tab under the grid: an outline icon, filled softly while its
+// category is the one in view.
+class CategoryTab : public views::Button {
+  METADATA_HEADER(CategoryTab, views::Button)
+
+ public:
+  CategoryTab(PressedCallback callback, EmojiGroup group)
+      : views::Button(std::move(callback)), group_(group) {
+    SetPreferredSize(gfx::Size(kTabSize, kTabSize));
+    const std::u16string name = GroupName(group);
+    SetTooltipText(name);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+    GetViewAccessibility().SetName(name);
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kTabRadius);
+    views::FocusRing::Install(this);
+  }
+
+  void SetActive(bool active) {
+    if (active_ == active) {
+      return;
+    }
+    active_ = active;
+    GetViewAccessibility().SetIsSelected(active);
+    SchedulePaint();
+  }
+
+  // views::Button:
+  void StateChanged(ButtonState old_state) override { SchedulePaint(); }
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    const bool hovered =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    if (active_ || hovered) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(FaintFill(colors, active_ ? 0x18 : 0x0F));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), kTabRadius, flags);
+    }
+    const gfx::ImageSkia icon = gfx::CreateVectorIcon(
+        GroupIcon(group_), kTabIconSize,
+        colors->GetColor(active_ ? ui::kColorSysOnSurface
+                                 : ui::kColorSysOnSurfaceSubtle));
+    canvas->DrawImageInt(icon, (width() - icon.width()) / 2,
+                         (height() - icon.height()) / 2);
+  }
+
+ private:
+  const EmojiGroup group_;
+  bool active_ = false;
+};

+
+SkColor HexColor(std::string_view hex) {
+  uint32_t rgb = 0;
+  if (hex.size() != 7 || !base::HexStringToUInt(hex.substr(1), &rgb)) {
+    return SK_ColorTRANSPARENT;
+  }
+  return SkColorSetA(rgb, SK_AlphaOPAQUE);
+}
+
+// A faint fill of the text color reads as a field or a hover on any
+// background.
+SkColor FaintFill(const ui::ColorProvider* colors, SkAlpha alpha) {
+  return SkColorSetA(colors->GetColor(ui::kColorSysOnSurface), alpha);
+}

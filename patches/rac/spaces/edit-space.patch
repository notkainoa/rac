+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/spaces/emoji_data.h"
+
+#include <string>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace rac {
+
+namespace {
+
+constexpr EmojiInfo kEmoji[] = {
+#include "chrome/browser/ui/views/rac/spaces/emoji_data.inc"
+};
+
+bool IsWordBoundary(char c) {
+  return c == '|' || c == ' ' || c == ':' || c == ',' || c == '-' || c == '(' ||
+         c == ')';
+}
+
+// Whether a word in `terms` starts with `word`.
+bool HasWordStartingWith(std::string_view terms, std::string_view word) {
+  for (size_t pos = terms.find(word); pos != std::string_view::npos;
+       pos = terms.find(word, pos + 1)) {
+    if (pos == 0 || IsWordBoundary(terms[pos - 1])) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+base::span<const EmojiInfo> GetEmoji() {
+  return kEmoji;
+}
+
+std::vector<const EmojiInfo*> SearchEmoji(std::u16string_view query) {
+  const std::string lowered = base::UTF16ToUTF8(base::ToLowerASCII(query));
+  const std::vector<std::string_view> words = base::SplitStringPiece(
+      lowered, " ", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::vector<const EmojiInfo*> matches;
+  if (words.empty()) {
+    return matches;
+  }
+  for (const EmojiInfo& info : kEmoji) {
+    bool all = true;
+    for (std::string_view word : words) {
+      if (!HasWordStartingWith(info.search_terms, word)) {
+        all = false;
+        break;
+      }
+    }
+    if (all) {
+      matches.push_back(&info);
+    }
+  }
+  return matches;
+}
+
+}  // namespace rac

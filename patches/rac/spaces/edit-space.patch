+// The popup's contents. Every choice applies as soon as it's made, so the
+// sidebar and window change while the popup stays open.
+class EditSpaceView : public views::View,
+                      public views::TextfieldController,
+                      public SpacesService::Observer {
+  METADATA_HEADER(EditSpaceView, views::View)
+
+ public:
+  EditSpaceView(SpacesService* spaces, const base::Uuid& space)
+      : spaces_(spaces), space_(space) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(kPadding),
+        kPadding));
+    const Space* found = spaces_->FindSpace(space_);
+    CHECK(found);
+
+    name_ = AddChildView(std::make_unique<views::Textfield>());
+    name_->set_controller(this);
+    name_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 10)));
+    name_->SetBackgroundEnabled(false);
+    name_->RemoveHoverEffect();
+    name_->SetFontList(views::TypographyProvider::Get().GetFont(
+        views::style::CONTEXT_LABEL, views::style::STYLE_BODY_3_MEDIUM));
+    name_->SetTextColorId(ui::kColorSysOnSurface);
+    name_->SetPlaceholderTextColorId(ui::kColorSysOnSurfaceSubtle);
+    name_->GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_RAC_SPACES_NAME_FIELD));
+    name_->SetText(base::UTF8ToUTF16(found->name));
+    name_->SetPreferredSize(gfx::Size(0, kNameHeight));
+
+    // The space's color, and whether its windows are light or dark.
+    auto* row = AddChildView(std::make_unique<views::View>());
+    auto* row_layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal));
+    row_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* swatches = row->AddChildView(std::make_unique<views::View>());
+    swatches->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), kSwatchGap));
+    swatches->GetViewAccessibility().SetRole(ax::mojom::Role::kRadioGroup);
+    swatches->GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_RAC_SPACES_COLOR));
+    for (size_t i = 0; i < SpaceTheme::kPresetCount; ++i) {
+      swatches_.push_back(swatches->AddChildView(std::make_unique<Swatch>(
+          base::BindRepeating(&EditSpaceView::OnColorSelected,
+                              base::Unretained(this), i),
+          i)));
+    }
+    row_layout->SetFlexForView(swatches, 1);
+    mode_ = row->AddChildView(std::make_unique<ModeSwitch>(base::BindRepeating(
+        &EditSpaceView::OnModeSelected, base::Unretained(this))));
+
+    // The divider runs edge to edge, like a menu's.
+    auto* separator = AddChildView(std::make_unique<views::Separator>());
+    separator->SetColorId(ui::kColorMenuSeparator);
+    separator->SetProperty(views::kMarginsKey, gfx::Insets::VH(0, -kPadding));
+
+    picker_ =
+        AddChildView(std::make_unique<EmojiPickerView>(base::BindRepeating(
+            &EditSpaceView::OnEmojiPicked, base::Unretained(this))));
+    picker_->GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+    picker_->GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_RAC_SPACES_ICON));
+    dot_ = picker_->SetSearchAccessory(std::make_unique<DotButton>(
+        base::BindRepeating(&EditSpaceView::OnEmojiPicked,
+                            base::Unretained(this), std::string())));
+
+    Update();
+    observation_.Observe(spaces_);
+  }
+  EditSpaceView(const EditSpaceView&) = delete;
+  EditSpaceView& operator=(const EditSpaceView&) = delete;
+  ~EditSpaceView() override = default;
+
+  views::Textfield* name_field() { return name_; }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    // An empty name gives the space its fallback name back.
+    spaces_->RenameSpace(space_,
+                         base::UTF16ToUTF8(base::CollapseWhitespace(
+                             new_contents,
+                             /*trim_sequences_with_line_breaks=*/true)));
+  }
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() == ui::EventType::kKeyPressed &&
+        key_event.key_code() == ui::VKEY_RETURN) {
+      GetWidget()->CloseWithReason(
+          views::Widget::ClosedReason::kAcceptButtonClicked);
+      return true;
+    }
+    return false;
+  }
+
+  // views::View:
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    name_->SetBackground(views::CreateRoundedRectBackground(
+        FaintFill(GetColorProvider(), 0x0F), kControlRadius));
+  }
+
+  // SpacesService::Observer:
+  void OnSpaceRenamed(const base::Uuid& id) override {
+    if (id == space_) {
+      Update();
+    }
+  }
+  void OnSpaceAppearanceChanged(const SpaceId& id) override {
+    if (id == space_) {
+      Update();
+    }
+  }
+  void OnSpaceRemoved(const base::Uuid& id) override {
+    if (id == space_) {
+      observation_.Reset();
+      GetWidget()->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+    }
+  }
+  void OnSpacesReordered() override { Update(); }
+
+ private:
+  // Shows the space as it is now. The name field is left alone: it's the
+  // source of the name while the popup is open.
+  void Update() {
+    const Space* space = spaces_->FindSpace(space_);
+    if (!space) {
+      return;
+    }
+    name_->SetPlaceholderText(FallbackName(spaces_, space_));
+    switch (space->theme.mode) {
+      case SpaceTheme::Mode::kAuto:
+        mode_->SetSelected(0);
+        break;
+      case SpaceTheme::Mode::kLight:
+        mode_->SetSelected(1);
+        break;
+      case SpaceTheme::Mode::kDark:
+        mode_->SetSelected(2);
+        break;
+    }
+    for (size_t i = 0; i < swatches_.size(); ++i) {
+      const SpaceTheme preset = SpaceTheme::Preset(i);
+      static_cast<Swatch*>(swatches_[i].get())
+          ->SetSelected(space->theme.color1 == preset.color1 &&
+                        space->theme.color2 == preset.color2);
+    }
+    dot_->SetSelected(space->icon.empty());
+    picker_->SetCurrentEmoji(space->icon);
+  }
+
+  void OnModeSelected(size_t index) {
+    constexpr SpaceTheme::Mode kModes[] = {SpaceTheme::Mode::kAuto,
+                                           SpaceTheme::Mode::kLight,
+                                           SpaceTheme::Mode::kDark};
+    spaces_->SetSpaceThemeMode(space_, kModes[index]);
+  }
+
+  void OnColorSelected(size_t preset) {
+    spaces_->SetSpaceThemePreset(space_, preset);
+  }
+
+  // An empty emoji puts the dot back.
+  void OnEmojiPicked(const std::string& emoji) {
+    spaces_->SetSpaceIcon(space_, emoji);
+  }
+
+  const raw_ptr<SpacesService> spaces_;
+  const base::Uuid space_;
+  raw_ptr<views::Textfield> name_ = nullptr;
+  raw_ptr<ModeSwitch> mode_ = nullptr;
+  std::vector<raw_ptr<views::Button>> swatches_;
+  raw_ptr<EmojiPickerView> picker_ = nullptr;
+  raw_ptr<DotButton> dot_ = nullptr;
+  base::ScopedObservation<SpacesService, SpacesService::Observer> observation_{
+      this};
+};

+// Auto, light, and dark as three icons in one track, the chosen one lifted
+// out of it.
+class ModeSwitch : public views::View {
+  METADATA_HEADER(ModeSwitch, views::View)
+
+ public:
+  explicit ModeSwitch(base::RepeatingCallback<void(size_t)> on_select)
+      : on_select_(std::move(on_select)) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(kModeInset)));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kRadioGroup);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_RAC_SPACES_APPEARANCE));
+    constexpr std::pair<int, const gfx::VectorIcon*> kModes[] = {
+        {IDS_RAC_SPACES_THEME_AUTO, &kSpaceThemeAutoIcon},
+        {IDS_RAC_SPACES_THEME_LIGHT, &kSpaceThemeLightIcon},
+        {IDS_RAC_SPACES_THEME_DARK, &kSpaceThemeDarkIcon}};
+    for (size_t i = 0; i < std::size(kModes); ++i) {
+      modes_.push_back(AddChildView(std::make_unique<Mode>(
+          base::BindRepeating(&ModeSwitch::OnPressed, base::Unretained(this),
+                              i),
+          l10n_util::GetStringUTF16(kModes[i].first), *kModes[i].second)));
+    }
+  }
+
+  void SetSelected(size_t index) {
+    for (size_t i = 0; i < modes_.size(); ++i) {
+      modes_[i]->SetSelected(i == index);
+    }
+  }
+
+  // views::View:
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    SetBackground(views::CreateRoundedRectBackground(
+        FaintFill(GetColorProvider(), 0x0F), kControlRadius));
+  }
+
+ private:
+  class Mode : public views::Button {
+    METADATA_HEADER(Mode, views::Button)
+
+   public:
+    Mode(PressedCallback callback,
+         std::u16string name,
+         const gfx::VectorIcon& icon)
+        : views::Button(std::move(callback)), icon_(icon) {
+      SetPreferredSize(gfx::Size(kModeWidth, kRowHeight - 2 * kModeInset));
+      SetTooltipText(name);
+      GetViewAccessibility().SetRole(ax::mojom::Role::kRadioButton);
+      GetViewAccessibility().SetName(name);
+      GetViewAccessibility().SetCheckedState(ax::mojom::CheckedState::kFalse);
+      views::InstallRoundRectHighlightPathGenerator(
+          this, gfx::Insets(), kControlRadius - kModeInset);
+      views::FocusRing::Install(this);
+    }
+
+    void SetSelected(bool selected) {
+      if (selected_ == selected) {
+        return;
+      }
+      selected_ = selected;
+      GetViewAccessibility().SetCheckedState(
+          selected ? ax::mojom::CheckedState::kTrue
+                   : ax::mojom::CheckedState::kFalse);
+      SchedulePaint();
+    }
+
+    // views::Button:
+    void StateChanged(ButtonState old_state) override { SchedulePaint(); }
+    void PaintButtonContents(gfx::Canvas* canvas) override {
+      const ui::ColorProvider* colors = GetColorProvider();
+      if (selected_) {
+        cc::PaintFlags flags;
+        flags.setAntiAlias(true);
+        flags.setColor(FaintFill(colors, 0x24));
+        canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()),
+                              kControlRadius - kModeInset, flags);
+      }
+      const SkColor color = colors->GetColor(
+          selected_ || IsHovered(this) ? ui::kColorSysOnSurface
+                                       : ui::kColorSysOnSurfaceSubtle);
+      canvas->DrawImageInt(gfx::CreateVectorIcon(*icon_, kModeIconSize, color),
+                           (width() - kModeIconSize) / 2,
+                           (height() - kModeIconSize) / 2);
+    }
+
+   private:
+    const raw_ref<const gfx::VectorIcon> icon_;
+    bool selected_ = false;
+  };
+
+  void OnPressed(size_t index) {
+    SetSelected(index);
+    on_select_.Run(index);
+  }
+
+  base::RepeatingCallback<void(size_t)> on_select_;
+  std::vector<raw_ptr<Mode>> modes_;
+};

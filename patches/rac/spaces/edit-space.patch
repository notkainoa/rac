+  outputs = [ "$target_gen_dir/spaces/emoji_data.inc" ]
+  args = [ "--annotations" ] + rebase_path(annotations, root_build_dir) +
+         [ "--sequences" ] + rebase_path(sequences, root_build_dir) +
+         [
+           "--output",
+           rebase_path(outputs[0], root_build_dir),
+         ]

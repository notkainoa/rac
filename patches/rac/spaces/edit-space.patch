+#!/usr/bin/env python3
+# Copyright 2026 The rac Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+"""Writes the space emoji picker's table from Unicode data in the tree.
+
+CLDR's English annotations give each emoji's name and search keywords, in
+Unicode's emoji order. ICU's copy of the emoji sequence files says which
+sequences are recommended for general interchange (RGI) and how each is
+fully qualified. Skin tone variants are left out; the picker shows the
+default of each emoji.
+"""
+
+import argparse
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+ZWJ = 0x200D
+VS16 = 0xFE0F
+SKIN_TONES = range(0x1F3FB, 0x1F400)
+HAIR_COMPONENTS = range(0x1F9B0, 0x1F9B4)
+
+# The first emoji of each picker category, in CLDR's order. People share a
+# category with smileys, as in most pickers.
+GROUP_STARTS = [
+    ('\U0001F600', 'kSmileysAndPeople'),
+    ('\U0001F435', 'kAnimalsAndNature'),
+    ('\U0001F347', 'kFoodAndDrink'),
+    ('\U0001F30D', 'kTravelAndPlaces'),
+    ('\U0001F383', 'kActivities'),
+    ('\U0001F453', 'kObjects'),
+    ('\U0001F3E7', 'kSymbols'),
+    ('\U0001F3C1', 'kFlags'),
+]
+
+
+def strip_vs16(sequence):
+    return ''.join(ch for ch in sequence if ord(ch) != VS16)
+
+
+def parse_code_points(field):
+    field = field.strip()
+    if '..' in field:
+        first, last = field.split('..')
+        return [chr(cp) for cp in range(int(first, 16), int(last, 16) + 1)]
+    return [''.join(chr(int(cp, 16)) for cp in field.split())]
+
+
+def read_rgi(paths):
+    """Maps each RGI sequence, without VS16, to its fully qualified form."""
+    rgi = {}
+    for path in paths:
+        with open(path, encoding='utf-8') as f:
+            for line in f:
+                line = line.split('#', 1)[0].strip()
+                if not line:
+                    continue
+                fields = [field.strip() for field in line.split(';')]
+                if len(fields) < 2:
+                    continue
+                for sequence in parse_code_points(fields[0]):
+                    code_points = [ord(ch) for ch in sequence]
+                    # Skin tone variants, and the bare hair and skin tone
+                    # components that only build other emoji.
+                    if any(cp in SKIN_TONES for cp in code_points) or (
+                            len(code_points) == 1
+                            and code_points[0] in HAIR_COMPONENTS):
+                        continue
+                    rgi[strip_vs16(sequence)] = sequence
+    return rgi
+
+
+def read_annotations(paths):
+    """Yields (sequence, name, keywords, file index) in file order."""
+    seen = {}
+    order = []
+    for index, path in enumerate(paths):
+        for element in ET.parse(path).getroot().iter('annotation'):
+            cp = element.get('cp')
+            text = (element.text or '').strip()
+            if not cp or not text:
+                continue
+            entry = seen.setdefault(cp, {
+                'name': '',
+                'keywords': [],
+                'file': index
+            })
+            if cp not in order:
+                order.append(cp)
+            if element.get('type') == 'tts':
+                entry['name'] = text
+            else:
+                entry['keywords'] = [
+                    word.strip() for word in text.split('|') if word.strip()
+                ]
+    for cp in order:
+        entry = seen[cp]
+        yield cp, entry['name'], entry['keywords'], entry['file']
+
+
+def is_flag(sequence):
+    first = ord(sequence[0])
+    return 0x1F1E6 <= first <= 0x1F1FF or (first == 0x1F3F4
+                                           and len(sequence) > 1)
+
+
+def c_string(text):
+    out = []
+    for byte in text.encode('utf-8'):
+        if 0x20 <= byte < 0x7F and chr(byte) not in '"\\?':
+            out.append(chr(byte))
+        else:
+            out.append('\\x%02X' % byte)
+    # A hex escape swallows any hex digits after it, so split the literal.
+    return '"' + re.sub(r'(\\x[0-9A-F]{2})(?=[0-9A-Fa-f])', r'\1""',
+                        ''.join(out)) + '"'
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--annotations', nargs='+', required=True)
+    parser.add_argument('--sequences', nargs='+', required=True)
+    parser.add_argument('--output', required=True)
+    args = parser.parse_args()
+
+    rgi = read_rgi(args.sequences)
+    group_of_start = {strip_vs16(emoji): group for emoji, group in GROUP_STARTS}
+    groups = {group: [] for _, group in GROUP_STARTS}
+    group = None
+    used = set()
+    for cp, name, keywords, file in read_annotations(args.annotations):
+        key = strip_vs16(cp)
+        if file == 0:
+            group = group_of_start.get(key, group)
+        if key not in rgi or key in used or not name or group is None:
+            continue
+        used.add(key)
+        target = group
+        # The derived annotations follow the main file, so they're sorted by
+        # what they are: flags, keycaps, and people.
+        if file > 0:
+            if is_flag(key):
+                target = 'kFlags'
+            elif name.startswith('keycap'):
+                target = 'kSymbols'
+            else:
+                target = 'kSmileysAndPeople'
+        words = [name.lower()] + [k.lower() for k in keywords]
+        search = '|'.join(dict.fromkeys(words))
+        groups[target].append((rgi[key], name, search))
+
+    count = sum(len(entries) for entries in groups.values())
+    if count < 1000:
+        sys.exit('only %d emoji found; is the data missing?' % count)
+
+    with open(args.output, 'w', encoding='utf-8') as out:
+        out.write('// Generated by generate_emoji_data.py. Do not edit.\n')
+        for _, group in GROUP_STARTS:
+            for emoji, name, search in groups[group]:
+                out.write('{%s, %s, %s, EmojiGroup::%s},\n' %
+                          (c_string(emoji), c_string(name), c_string(search),
+                           group))
+
+
+if __name__ == '__main__':
+    main()

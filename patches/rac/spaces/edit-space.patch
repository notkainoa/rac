+// A search box over a scrolling grid of every emoji, with a row of category
+// tabs under it, as in Arc's and macOS's pickers.
+class EmojiPickerView : public views::View, public views::TextfieldController {
+  METADATA_HEADER(EmojiPickerView, views::View)
+
+ public:
+  using PickCallback = base::RepeatingCallback<void(const std::string& emoji)>;
+
+  static constexpr int kSearchHeight = 30;
+
+  explicit EmojiPickerView(PickCallback on_pick);
+  EmojiPickerView(const EmojiPickerView&) = delete;
+  EmojiPickerView& operator=(const EmojiPickerView&) = delete;
+  ~EmojiPickerView() override;
+
+  // Marks `emoji` in the grid as the one in use. Empty for none.
+  void SetCurrentEmoji(const std::string& emoji);
+
+  views::Textfield* search_field() { return search_; }
+
+  // Puts `view` at the end of the search row.
+  template <typename T>
+  T* SetSearchAccessory(std::unique_ptr<T> view) {
+    return search_row_->AddChildView(std::move(view));
+  }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  class Grid;
+
+  static constexpr size_t kGroupCount =
+      static_cast<size_t>(EmojiGroup::kMaxValue) + 1;
+
+  void ShowGroup(EmojiGroup group);
+  void UpdateTabs();
+
+  raw_ptr<views::View> search_row_ = nullptr;
+  raw_ptr<views::View> search_box_ = nullptr;
+  raw_ptr<views::Textfield> search_ = nullptr;
+  raw_ptr<views::ScrollView> scroll_ = nullptr;
+  raw_ptr<Grid> grid_ = nullptr;
+  raw_ptr<views::Label> no_matches_ = nullptr;
+  std::array<raw_ptr<views::Button>, kGroupCount> tabs_ = {};
+  // The category at the top of the grid; none while searching.
+  std::optional<EmojiGroup> current_group_;
+  base::CallbackListSubscription scroll_subscription_;
+};
+

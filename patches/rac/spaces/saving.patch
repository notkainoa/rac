+StoredTab SnapshotTab(tabs::TabInterface* tab) {
+  StoredTab stored;
+  content::WebContents* contents = tab->GetContents();
+  sessions::LiveTab* live_tab =
+      sessions::ContentLiveTab::GetOrCreateForWebContents(contents);
+  const int count = live_tab->GetEntryCount();
+  const int current = live_tab->GetCurrentEntryIndex();
+  for (int i = 0; i < count; ++i) {
+    sessions::SerializedNavigationEntry navigation =
+        live_tab->GetEntryAtIndex(i);
+    if (navigation.virtual_url().is_valid()) {
+      if (i == current) {
+        stored.selected_navigation =
+            static_cast<int>(stored.navigations.size());
+      }
+      stored.navigations.push_back(std::move(navigation));
+    }
+  }
+  stored.last_active = contents->GetLastActiveTime();
+  return stored;
+}
+
+}  // namespace
+
+StoredSpace SnapshotHiddenSpace(const base::Uuid& space,
+                                const HiddenSpace& hidden) {
+  StoredSpace stored;
+  stored.space = space;
+  for (const HiddenSpace::Item& item : hidden.items()) {
+    if (const auto* tab = std::get_if<std::unique_ptr<tabs::TabModel>>(&item)) {
+      StoredTab stored_tab = SnapshotTab(tab->get());
+      if (!stored_tab.navigations.empty()) {
+        if (tab->get() == hidden.active_tab()) {
+          stored.active_tab = static_cast<int>(stored.tabs.size());
+        }
+        stored.tabs.push_back(std::move(stored_tab));
+      }
+      continue;
+    }
+    const auto& collection =
+        std::get<std::unique_ptr<DetachedTabCollection>>(item);
+    if (!std::holds_alternative<std::unique_ptr<tabs::TabGroupTabCollection>>(
+            collection->collection_)) {
+      // A split view: its tabs become plain tabs.
+      for (tabs::TabInterface* split_tab :
+           std::get<std::unique_ptr<tabs::SplitTabCollection>>(
+               collection->collection_)
+               ->GetTabsRecursive()) {
+        StoredTab stored_tab = SnapshotTab(split_tab);
+        if (!stored_tab.navigations.empty()) {
+          if (split_tab == hidden.active_tab()) {
+            stored.active_tab = static_cast<int>(stored.tabs.size());
+          }
+          stored.tabs.push_back(std::move(stored_tab));
+        }
+      }
+      continue;
+    }
+    const auto& group_collection =
+        std::get<std::unique_ptr<tabs::TabGroupTabCollection>>(
+            collection->collection_);
+    const TabGroup* group = group_collection->GetTabGroup();
+    StoredGroup stored_group;
+    stored_group.id = group_collection->GetTabGroupId();
+    if (const tab_groups::TabGroupVisualData* visuals = group->visual_data()) {
+      stored_group.title = visuals->title();
+      stored_group.color = static_cast<int>(visuals->color());
+      stored_group.collapsed = visuals->is_collapsed();
+    }
+    stored.groups.push_back(stored_group);
+    for (tabs::TabInterface* group_tab : group_collection->GetTabsRecursive()) {
+      StoredTab stored_tab = SnapshotTab(group_tab);
+      if (stored_tab.navigations.empty()) {
+        continue;
+      }
+      stored_tab.group = stored_group.id;
+      if (group_tab == hidden.active_tab()) {
+        stored.active_tab = static_cast<int>(stored.tabs.size());
+      }
+      stored.tabs.push_back(std::move(stored_tab));
+    }
+  }
+  return stored;
+}
+
+tabs::TabInterface* RestoreStoredSpace(BrowserWindowInterface* browser,
+                                       const StoredSpace& stored) {
+  TabStripModel* model = browser->GetTabStripModel();
+  std::map<int, tabs::TabInterface*> added;
+  for (size_t i = 0; i < stored.tabs.size(); ++i) {
+    const StoredTab& tab = stored.tabs[i];
+    // A reasonable stand-in for the original tick count: recent tabs look
+    // recently used.
+    const base::TimeTicks last_active_ticks =
+        tab.last_active.is_null()
+            ? base::TimeTicks()
+            : base::TimeTicks::Now() - (base::Time::Now() - tab.last_active);
+    content::WebContents* contents = chrome::AddRestoredTab(
+        browser, tab.navigations, model->count(), tab.selected_navigation,
+        std::string(), tab.group, /*select=*/false, /*pin=*/false,
+        last_active_ticks, tab.last_active, /*session_storage_namespace=*/
+        nullptr, sessions::SerializedUserAgentOverride(),
+        /*extra_data=*/{},
+        /*from_session_restore=*/true,
+        /*is_active_browser=*/std::nullopt,
+        chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+    if (contents) {
+      added[static_cast<int>(i)] =
+          model->GetTabAtIndex(model->GetIndexOfWebContents(contents));
+    }
+  }
+  for (const StoredGroup& group : stored.groups) {
+    if (model->group_model() &&
+        model->group_model()->ContainsTabGroup(group.id)) {
+      model->ChangeTabGroupVisuals(
+          group.id,
+          tab_groups::TabGroupVisualData(
+              group.title,
+              static_cast<tab_groups::TabGroupColorId>(group.color),
+              group.collapsed),
+          /*is_customized=*/true);
+    }
+  }
+  auto it = added.find(stored.active_tab);
+  if (it != added.end()) {
+    return it->second;
+  }
+  return added.empty() ? nullptr : added.begin()->second;
+}
+
+}  // namespace rac

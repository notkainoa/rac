--- /dev/null
+++ src/chrome/browser/rac/spaces/spaces_store.cc
@@ -0,0 +1,287 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/rac/spaces/spaces_store.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/json/values_util.h"
+#include "base/logging.h"
+#include "base/pickle.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/token.h"
+
+namespace rac {
+
+namespace {
+
+// Same order of magnitude as the session service's per-navigation cap.
+constexpr size_t kMaxNavigationPickleSize = 1 << 20;
+
+constexpr char kVersionKey[] = "version";
+constexpr char kSpacesKey[] = "spaces";
+
+constexpr char kTabsKey[] = "tabs";
+constexpr char kGroupsKey[] = "groups";
+constexpr char kActiveTabKey[] = "active_tab";
+
+constexpr char kNavigationsKey[] = "navigations";
+constexpr char kSelectedNavigationKey[] = "selected_navigation";
+constexpr char kGroupKey[] = "group";
+constexpr char kLastActiveKey[] = "last_active";
+
+constexpr char kIdKey[] = "id";
+constexpr char kTitleKey[] = "title";
+constexpr char kColorKey[] = "color";
+constexpr char kCollapsedKey[] = "collapsed";
+
+std::string SerializeNavigation(
+    const sessions::SerializedNavigationEntry& navigation) {
+  base::Pickle pickle;
+  navigation.WriteToPickle(kMaxNavigationPickleSize, &pickle);
+  return base::Base64Encode(pickle.AsStringView());
+}
+
+std::optional<sessions::SerializedNavigationEntry> DeserializeNavigation(
+    const std::string& encoded) {
+  std::string bytes;
+  if (!base::Base64Decode(encoded, &bytes)) {
+    return std::nullopt;
+  }
+  base::Pickle pickle =
+      base::Pickle::WithUnownedBuffer(base::as_byte_span(bytes));
+  base::PickleIterator it(pickle);
+  sessions::SerializedNavigationEntry navigation;
+  if (!navigation.ReadFromPickle(&it)) {
+    return std::nullopt;
+  }
+  return navigation;
+}
+
+}  // namespace
+
+base::DictValue StoredTab::ToDict() const {
+  base::DictValue dict;
+  base::ListValue navigations_list;
+  for (const sessions::SerializedNavigationEntry& navigation : navigations) {
+    navigations_list.Append(SerializeNavigation(navigation));
+  }
+  dict.Set(kNavigationsKey, std::move(navigations_list));
+  dict.Set(kSelectedNavigationKey, selected_navigation);
+  if (group) {
+    dict.Set(kGroupKey, group->ToString());
+  }
+  if (!last_active.is_null()) {
+    dict.Set(kLastActiveKey, base::TimeToValue(last_active));
+  }
+  return dict;
+}
+
+// static
+std::optional<StoredTab> StoredTab::FromDict(const base::DictValue& dict) {
+  const base::ListValue* navigations_list = dict.FindList(kNavigationsKey);
+  if (!navigations_list) {
+    return std::nullopt;
+  }
+  StoredTab tab;
+  for (const base::Value& value : *navigations_list) {
+    if (!value.is_string()) {
+      continue;
+    }
+    std::optional<sessions::SerializedNavigationEntry> navigation =
+        DeserializeNavigation(value.GetString());
+    if (navigation) {
+      tab.navigations.push_back(std::move(*navigation));
+    }
+  }
+  if (tab.navigations.empty()) {
+    return std::nullopt;
+  }
+  tab.selected_navigation =
+      std::clamp(dict.FindInt(kSelectedNavigationKey).value_or(0), 0,
+                 static_cast<int>(tab.navigations.size()) - 1);
+  if (const std::string* group = dict.FindString(kGroupKey)) {
+    if (std::optional<base::Token> token = base::Token::FromString(*group)) {
+      tab.group = tab_groups::TabGroupId::FromRawToken(*token);
+    }
+  }
+  if (std::optional<base::Time> last_active =
+          base::ValueToTime(dict.Find(kLastActiveKey))) {
+    tab.last_active = *last_active;
+  }
+  return tab;
+}
+
+base::DictValue StoredSpace::ToDict() const {
+  base::DictValue dict = unknown_fields.Clone();
+  base::ListValue tab_list;
+  for (const StoredTab& tab : tabs) {
+    tab_list.Append(tab.ToDict());
+  }
+  dict.Set(kTabsKey, std::move(tab_list));
+  base::ListValue group_list;
+  for (const StoredGroup& group : groups) {
+    group_list.Append(base::DictValue()
+                          .Set(kIdKey, group.id.ToString())
+                          .Set(kTitleKey, group.title)
+                          .Set(kColorKey, group.color)
+                          .Set(kCollapsedKey, group.collapsed));
+  }
+  dict.Set(kGroupsKey, std::move(group_list));
+  dict.Set(kActiveTabKey, active_tab);
+  return dict;
+}
+
+// static
+std::optional<StoredSpace> StoredSpace::FromDict(const base::DictValue& dict) {
+  StoredSpace space;
+  if (const base::ListValue* group_list = dict.FindList(kGroupsKey)) {
+    for (const base::Value& value : *group_list) {
+      const base::DictValue* group_dict = value.GetIfDict();
+      if (!group_dict) {
+        continue;
+      }
+      const std::string* id = group_dict->FindString(kIdKey);
+      std::optional<base::Token> token =
+          id ? base::Token::FromString(*id) : std::nullopt;
+      if (!token) {
+        continue;
+      }
+      StoredGroup group;
+      group.id = tab_groups::TabGroupId::FromRawToken(*token);
+      if (const std::string* title = group_dict->FindString(kTitleKey)) {
+        group.title = base::UTF8ToUTF16(*title);
+      }
+      group.color = group_dict->FindInt(kColorKey).value_or(0);
+      group.collapsed = group_dict->FindBool(kCollapsedKey).value_or(false);
+      space.groups.push_back(std::move(group));
+    }
+  }
+  if (const base::ListValue* tab_list = dict.FindList(kTabsKey)) {
+    for (const base::Value& value : *tab_list) {
+      const base::DictValue* tab_dict = value.GetIfDict();
+      if (!tab_dict) {
+        continue;
+      }
+      if (std::optional<StoredTab> tab = StoredTab::FromDict(*tab_dict)) {
+        space.tabs.push_back(std::move(*tab));
+      }
+    }
+  }
+  space.active_tab = std::clamp(dict.FindInt(kActiveTabKey).value_or(-1), -1,
+                                static_cast<int>(space.tabs.size()) - 1);
+
+  space.unknown_fields = dict.Clone();
+  space.unknown_fields.Remove(kTabsKey);
+  space.unknown_fields.Remove(kGroupsKey);
+  space.unknown_fields.Remove(kActiveTabKey);
+  return space;
+}
+
+SpacesStore::SpacesStore(base::FilePath profile_dir)
+    : dir_(std::move(profile_dir)) {}
+
+SpacesStore::~SpacesStore() {
+  if (write_pending_) {
+    SaveNow();
+  }
+}
+
+void SpacesStore::Load() {
+  for (const char* suffix : {"", ".bak"}) {
+    const base::FilePath path =
+        dir_.AppendASCII("rac spaces" + std::string(suffix));
+    std::string content;
+    if (!base::ReadFileToString(path, &content) || content.empty()) {
+      continue;
+    }
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(content, base::JSON_PARSE_RFC);
+    if (!parsed || !parsed->is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = parsed->GetDict();
+    version_ = std::max(dict.FindInt(kVersionKey).value_or(kVersion), kVersion);
+    unknown_fields_ = dict.Clone();
+    unknown_fields_.Remove(kVersionKey);
+    unknown_fields_.Remove(kSpacesKey);
+    if (const base::DictValue* spaces = dict.FindDict(kSpacesKey)) {
+      for (const auto [key, value] : *spaces) {
+        base::Uuid id = base::Uuid::ParseCaseInsensitive(key);
+        const base::DictValue* space_dict = value.GetIfDict();
+        if (!id.is_valid() || !space_dict) {
+          continue;
+        }
+        std::optional<StoredSpace> space = StoredSpace::FromDict(*space_dict);
+        if (space) {
+          space->space = id;
+          spaces_[id] = std::move(*space);
+        }
+      }
+    }
+    return;
+  }
+}
+
+const StoredSpace* SpacesStore::Find(const base::Uuid& space) const {
+  auto it = spaces_.find(space);
+  return it == spaces_.end() ? nullptr : &it->second;
+}
+
+void SpacesStore::Put(StoredSpace space) {
+  const base::Uuid id = space.space;
+  spaces_[id] = std::move(space);
+  write_pending_ = true;
+  save_timer_.Start(
+      FROM_HERE, base::Seconds(1),
+      base::BindOnce(&SpacesStore::SaveNow, base::Unretained(this)));
+}
+
+void SpacesStore::Remove(const base::Uuid& space) {
+  if (spaces_.erase(space) > 0) {
+    write_pending_ = true;
+    save_timer_.Start(
+        FROM_HERE, base::Seconds(1),
+        base::BindOnce(&SpacesStore::SaveNow, base::Unretained(this)));
+  }
+}
+
+bool SpacesStore::HasPendingWrite() const {
+  return write_pending_;
+}
+
+void SpacesStore::SaveNow() {
+  save_timer_.Stop();
+  write_pending_ = false;
+  std::string json;
+  if (!base::JSONWriter::Write(ToDict(), &json)) {
+    LOG(ERROR) << "rac: couldn't serialize spaces";
+    return;
+  }
+  const base::FilePath path = dir_.AppendASCII("rac spaces");
+  // Keep the last good file, in case this write is cut short.
+  base::CopyFile(path, dir_.AppendASCII("rac spaces.bak"));
+  base::ImportantFileWriter::WriteFileAtomically(path, json, "RacSpacesStore");
+}
+
+base::DictValue SpacesStore::ToDict() const {
+  base::DictValue dict = unknown_fields_.Clone();
+  dict.Set(kVersionKey, version_);
+  base::DictValue spaces;
+  for (const auto& [id, space] : spaces_) {
+    spaces.Set(id.AsLowercaseString(), space.ToDict());
+  }
+  dict.Set(kSpacesKey, std::move(spaces));
+  return dict;
+}
+
+}  // namespace rac

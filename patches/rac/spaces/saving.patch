+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RAC_SPACES_SPACES_STORE_H_
+#define CHROME_BROWSER_RAC_SPACES_SPACES_STORE_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/tab_groups/tab_group_id.h"
+
+namespace rac {
+
+// A tab of a hidden space, saved so it survives a crash or a quit.
+struct StoredTab {
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  int selected_navigation = 0;
+  // The group the tab belongs to, referring to StoredSpace::groups.
+  std::optional<tab_groups::TabGroupId> group;
+  base::Time last_active;
+
+  base::DictValue ToDict() const;
+  static std::optional<StoredTab> FromDict(const base::DictValue& dict);
+};
+
+// A saved tab group. The ID is kept, so tabs restore into it.
+struct StoredGroup {
+  tab_groups::TabGroupId id = tab_groups::TabGroupId::CreateEmpty();
+  std::u16string title;
+  int color = 0;
+  bool collapsed = false;
+};
+
+// The saved tabs of one hidden space.
+struct StoredSpace {
+  base::Uuid space;
+  std::vector<StoredTab> tabs;
+  std::vector<StoredGroup> groups;
+  // Index into `tabs` of the tab that was active.
+  int active_tab = -1;
+
+  // Fields written by a newer rac that this build doesn't read.
+  base::DictValue unknown_fields;
+
+  base::DictValue ToDict() const;
+  static std::optional<StoredSpace> FromDict(const base::DictValue& dict);
+};
+
+// The profile's file of hidden spaces' tabs, `<profile>/rac spaces`. The
+// SpacesWindowManager writes it when tabs leave a window and reads it when a
+// window shows a space that has no live tabs. It exists so a crash or a quit
+// never loses a hidden space's tabs.
+//
+// Writes are coalesced and atomic, and the previous file is kept as
+// `rac spaces.bak`. All methods must be called on the UI thread.
+class SpacesStore {
+ public:
+  static constexpr int kVersion = 1;
+
+  explicit SpacesStore(base::FilePath profile_dir);
+  SpacesStore(const SpacesStore&) = delete;
+  SpacesStore& operator=(const SpacesStore&) = delete;
+  ~SpacesStore();
+
+  // Reads the file. Call once, early.
+  void Load();
+
+  // The stored space, or null. Doesn't remove it; call Remove once the tabs
+  // are live again.
+  const StoredSpace* Find(const base::Uuid& space) const;
+
+  // Adds or replaces the stored tabs of a space, and schedules a write.
+  void Put(StoredSpace space);
+  void Remove(const base::Uuid& space);
+
+  bool HasPendingWrite() const;
+  void SaveNow();
+
+ private:
+  base::DictValue ToDict() const;
+
+  const base::FilePath dir_;
+  std::map<base::Uuid, StoredSpace> spaces_;
+
+  // Top-level keys this build doesn't read, written back unchanged.
+  base::DictValue unknown_fields_;
+  int version_ = kVersion;
+
+  base::OneShotTimer save_timer_;
+  bool write_pending_ = false;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_SPACES_SPACES_STORE_H_

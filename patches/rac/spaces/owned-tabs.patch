+void SpacesWindowManager::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                  int index) {
+  auto* state = FindState(tab->GetBrowserWindowInterface());
+  if (!state || !state->space) {
+    return;
+  }
+  // Unpinning a shared favorite places it in the space being shown.
+  if (!tab->IsPinned()) {
+    TagTab(tab, *state->space);
+  }
+  state->membership_dirty = true;
+  ScheduleReconcile(*state);
+}
+
+void SpacesWindowManager::TabGroupedStateChanged(
+    TabStripModel* model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  auto* state = FindState(model);
+  if (!state || state->changing_space) {
+    return;
+  }
+  // Groups belong to one space. Adding a tab to an existing group (including
+  // via an extension) gives it the group's space, not a mixed hidden group.
+  if (new_group) {
+    for (auto* member : *model) {
+      if (member != tab && member->GetGroup() == new_group) {
+        if (auto space = SpaceTabTag::Get(member->GetContents())) {
+          TagTab(tab, *space);
+          break;
+        }
+      }
+    }
+  }
+  state->membership_dirty = true;
+  ScheduleReconcile(*state);
+}

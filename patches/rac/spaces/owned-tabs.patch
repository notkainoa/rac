+TEST_F(SpacesStoreTest, AsyncLoadDoesNotBlockUIThread) {
+  const auto id = base::Uuid::GenerateRandomV4();
+  {
+    SpacesStore initial(dir_.GetPath());
+    initial.Put(MakeSpace(id, "retained"));
+  }
+  task_environment_.RunUntilIdle();
+
+  SpacesStore store(dir_.GetPath());
+  base::test::TestFuture<void> ready;
+  {
+    base::ScopedDisallowBlocking disallow_blocking;
+    store.LoadAsync(ready.GetCallback());
+    EXPECT_FALSE(ready.IsReady());
+    task_environment_.RunUntilIdle();
+  }
+  ASSERT_TRUE(ready.IsReady());
+  ASSERT_TRUE(store.Find(id));
+  EXPECT_EQ(*store.Find(id)->unknown_fields.FindString("marker"), "retained");
+  EXPECT_FALSE(store.HasPendingWrite());
+}
+
+TEST_F(SpacesStoreTest, AsyncLoadCanOutliveStoreWithoutCallingClient) {
+  base::test::TestFuture<void> ready;
+  {
+    auto store = std::make_unique<SpacesStore>(dir_.GetPath());
+    base::ScopedDisallowBlocking disallow_blocking;
+    store->LoadAsync(ready.GetCallback());
+    store.reset();
+  }
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(ready.IsReady());
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("rac spaces")));
+}
+
+TEST_F(SpacesStoreTest, AsyncLoadThenSaveRetainsOtherSpaces) {
+  const auto first = base::Uuid::GenerateRandomV4();
+  const auto second = base::Uuid::GenerateRandomV4();
+  {
+    SpacesStore initial(dir_.GetPath());
+    initial.Put(MakeSpace(first, "original"));
+  }
+  task_environment_.RunUntilIdle();
+  {
+    SpacesStore store(dir_.GetPath());
+    base::test::TestFuture<void> ready;
+    store.LoadAsync(ready.GetCallback());
+    task_environment_.RunUntilIdle();
+    ASSERT_TRUE(ready.IsReady());
+    store.Put(MakeSpace(second, "new"));
+  }
+  task_environment_.RunUntilIdle();
+  SpacesStore reloaded(dir_.GetPath());
+  reloaded.Load();
+  ASSERT_TRUE(reloaded.Find(first));
+  ASSERT_TRUE(reloaded.Find(second));
+}

+// A window that was open when a link arrived with rac's launch: a link
+// clicked in another app while rac wasn't running.
+struct StartupWindowFacts {
+  // Brought back by session restore: the user's own windows.
+  bool restored_from_session = false;
+  int tab_count = 0;
+  // Its tab is the New Tab page and has never been anywhere else.
+  bool only_new_tab_page = false;
+};

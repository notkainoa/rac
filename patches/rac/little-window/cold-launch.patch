+// After a launch whose only work was a link that became `little`: closes the
+// empty window Chromium opened at launch, so the little window is the only
+// one. Restored session windows and anything with content stay.
+void CloseEmptyStartupWindows(Profile* profile,
+                              BrowserWindowInterface* little) {
+  std::vector<BrowserWindowInterface*> to_close;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* window) {
+        if (window == little || window->GetProfile() != profile ||
+            window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+            window->IsDeleteScheduled()) {
+          return true;
+        }
+        TabStripModel* tabs = window->GetTabStripModel();
+        StartupWindowFacts facts{
+            .restored_from_session =
+                BrowserInitState::From(window)->is_session_restore(),
+            .tab_count = tabs->count()};
+        if (tabs->count() == 1) {
+          content::WebContents* contents = tabs->GetWebContentsAt(0);
+          const GURL& url = contents->GetVisibleURL();
+          facts.only_new_tab_page =
+              contents->GetController().GetEntryCount() <= 1 &&
+              (url == GURL(chrome::kChromeUINewTabURL) ||
+               url == GURL(chrome::kChromeUINewTabPageURL));
+        }
+        if (ShouldCloseStartupWindow(/*link_came_with_launch=*/true,
+                                     LinkRoute::kLittleWindow, facts)) {
+          to_close.push_back(window);
+        }
+        return true;
+      });
+  for (BrowserWindowInterface* window : to_close) {
+    if (BrowserWindow* native = BrowserWindow::FromBrowser(window)) {
+      native->Close();
+    }
+  }
+}
+
+std::vector<GURL> UrlsOf(const StartupTabs& tabs) {
+  std::vector<GURL> urls;
+  urls.reserve(tabs.size());
+  for (const StartupTab& tab : tabs) {
+    urls.push_back(tab.url);
+  }
+  return urls;
+}
+
+}  // namespace
+
+void NoteLinksCameWithLaunch(const StartupTabs& tabs) {
+  g_links_came_with_launch = !tabs.empty();
+}
+
+namespace {
+
+// Once the launch's restore has shown its windows (and activated one), the
+// little window takes the front and focus back. It runs in the same task as
+// the restore, so the windows never visibly jump.
+void WatchLaunchRestore(Profile* profile, BrowserWindowInterface* little) {
+  RestoreWatch() =
+      SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+          [](Profile* profile, base::WeakPtr<BrowserWindowInterface> little,
+             Profile* restored, int /*tab_count*/) {
+            if (restored != profile) {
+              return;
+            }
+            if (little) {
+              CloseEmptyStartupWindows(profile, little.get());
+              if (BrowserWindow* native =
+                      BrowserWindow::FromBrowser(little.get())) {
+                native->Activate();
+              }
+            }
+            // Destroys this callback; nothing after this line.
+            RestoreWatch() = {};
+          },
+          profile, little->GetWeakPtr()));
+}
+

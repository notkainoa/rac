--- a/chrome/browser/ui/views/rac/little_window/little_window.cc
+++ b/chrome/browser/ui/views/rac/little_window/little_window.cc
@@ -17,6 +17,8 @@
 #include "chrome/app/vector_icons/vector_icons.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
 #include "chrome/browser/ui/browser_commands.h"
 #include "chrome/browser/ui/browser_init_state.h"
 #include "chrome/browser/ui/browser_tabstrip.h"
@@ -379,8 +381,16 @@ bool OpenAsTab(BrowserWindowInterface* b
   // Emptying the popup closes it.
   std::unique_ptr<content::WebContents> contents =
       tabs->DetachWebContentsAtForInsertion(tabs->active_index());
+  content::WebContents* moved = contents.get();
   into->GetTabStripModel()->AppendWebContents(std::move(contents),
                                               /*foreground=*/true);
+  // The little window is left out of session restore, so nothing recorded
+  // the page's history while it was there. Write it now, as Chromium does
+  // for a duplicated tab, or the tab would be lost at the next restart.
+  if (SessionService* session =
+          SessionServiceFactory::GetForProfileIfExisting(profile)) {
+    session->TabRestored(moved, /*pinned=*/false);
+  }
   if (BrowserWindow* native = BrowserWindow::FromBrowser(into)) {
     native->Show();
   }

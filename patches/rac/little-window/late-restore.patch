+// Whether a little window opened by a link that started rac watches its
+// profile's session restore: while the restore runs, or before it has started
+// (the profile has no tabbed window yet, as when several profiles restore one
+// after another). Once the profile has windows and no restore runs, startup is
+// over for it and there is nothing to watch.
+bool ShouldWatchLaunchRestore(bool link_came_with_launch,
+                              bool restore_running,
+                              bool profile_has_tabbed_window);
+
+// What the watch does when a session restore finishes.
+enum class LaunchRestoreStep {
+  // Another profile's restore: keep waiting for the link's profile.
+  kKeepWatching,
+  // The link's profile restored (its windows, or one empty window): close the
+  // empty one and bring the little window back to the front, then stop.
+  kRaiseLittleWindow,
+  // The little window closed first: nothing left to do.
+  kStopWatching,
+};
+LaunchRestoreStep StepForFinishedRestore(bool restored_link_profile,
+                                         bool little_window_open);
+
 // A new little window's bounds on a display with `work_area`: a fixed size,
 // shrunk to fit inside the work area's margin, centered. A closed little
 // window keeps nothing, so there is no remembered placement.
--- a/chrome/browser/ui/rac/little_window/little_window_routing_unittest.cc
+++ b/chrome/browser/ui/rac/little_window/little_window_routing_unittest.cc
@@ -139,6 +139,50 @@ TEST(LittleWindowRoutingTest, AWindowWit
   }
 }
 
+TEST(LittleWindowRoutingTest, WatchesARestoreThatIsRunning) {
+  EXPECT_TRUE(ShouldWatchLaunchRestore(/*link_came_with_launch=*/true,
+                                       /*restore_running=*/true,
+                                       /*profile_has_tabbed_window=*/false));
+  EXPECT_TRUE(ShouldWatchLaunchRestore(true, true, true));
+}
+
+TEST(LittleWindowRoutingTest, WatchesARestoreThatHasNotStarted) {
+  // Several profiles restore one after another; the link's profile is later
+  // in line, so it has no window and no restore yet.
+  EXPECT_TRUE(ShouldWatchLaunchRestore(/*link_came_with_launch=*/true,
+                                       /*restore_running=*/false,
+                                       /*profile_has_tabbed_window=*/false));
+}
+
+TEST(LittleWindowRoutingTest, NoWatchOnceTheProfileHasStartedUp) {
+  // Its windows are open and no restore runs: nothing more will come.
+  EXPECT_FALSE(ShouldWatchLaunchRestore(true, false, true));
+  // A link while rac runs never watches.
+  EXPECT_FALSE(ShouldWatchLaunchRestore(false, true, false));
+  EXPECT_FALSE(ShouldWatchLaunchRestore(false, false, false));
+}
+
+TEST(LittleWindowRoutingTest, RaisesTheLittleWindowWhenItsProfileRestores) {
+  // Restored windows, or nothing to restore (one empty window): either way
+  // the little window comes back to the front.
+  EXPECT_EQ(StepForFinishedRestore(/*restored_link_profile=*/true,
+                                   /*little_window_open=*/true),
+            LaunchRestoreStep::kRaiseLittleWindow);
+}
+
+TEST(LittleWindowRoutingTest, KeepsWatchingThroughOtherProfilesRestores) {
+  EXPECT_EQ(StepForFinishedRestore(/*restored_link_profile=*/false,
+                                   /*little_window_open=*/true),
+            LaunchRestoreStep::kKeepWatching);
+}
+
+TEST(LittleWindowRoutingTest, StopsWhenTheLittleWindowClosedFirst) {
+  EXPECT_EQ(StepForFinishedRestore(true, /*little_window_open=*/false),
+            LaunchRestoreStep::kStopWatching);
+  EXPECT_EQ(StepForFinishedRestore(false, /*little_window_open=*/false),
+            LaunchRestoreStep::kStopWatching);
+}

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/ui/rac/little_window/little_window_routing.h"
+
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace rac::little_window {
+namespace {
+
+// Stand-ins for profiles: only their addresses matter.
+const int kRegular = 1;
+const int kIncognito = 2;
+const int kOtherProfile = 3;
+
+WindowFacts Normal(const void* profile, std::string space = "work") {
+  return {.profile = profile, .normal = true, .active_space = space};
+}
+
+LinkRoute Route(std::vector<GURL> urls) {
+  return RouteLinksFromOtherApp(urls);
+}
+
+TEST(LittleWindowRoutingTest, OneWebLinkOpensALittleWindow) {
+  EXPECT_EQ(Route({GURL("https://example.com/a?b#c")}),
+            LinkRoute::kLittleWindow);
+  EXPECT_EQ(Route({GURL("http://example.com")}), LinkRoute::kLittleWindow);
+}
+
+TEST(LittleWindowRoutingTest, EverythingElseOpensTabs) {
+  EXPECT_EQ(Route({}), LinkRoute::kTabs);
+  // Several links at once (a multi-select in Finder) stay tabs, not a
+  // stack of windows.
+  EXPECT_EQ(Route({GURL("https://example.com"), GURL("https://example.org")}),
+            LinkRoute::kTabs);
+  EXPECT_EQ(Route({GURL("file:///Users/me/page.html")}), LinkRoute::kTabs);
+  EXPECT_EQ(Route({GURL("chrome://settings")}), LinkRoute::kTabs);
+  EXPECT_EQ(Route({GURL("mailto:me@example.com")}), LinkRoute::kTabs);
+  EXPECT_EQ(Route({GURL("javascript:alert(1)")}), LinkRoute::kTabs);
+  EXPECT_EQ(Route({GURL("not a url")}), LinkRoute::kTabs);
+}
+
+TEST(LittleWindowRoutingTest, ExpandsIntoTheMostRecentNormalWindow) {
+  const WindowFacts windows[] = {Normal(&kRegular, "work"),
+                                 Normal(&kRegular, "home")};
+  ExpandTarget target = PickExpandTarget(&kRegular, windows);
+  EXPECT_EQ(target.window, 0u);
+  EXPECT_EQ(target.space, "work");
+}
+
+TEST(LittleWindowRoutingTest, JoinsTheSpaceItsWindowShows) {
+  const WindowFacts windows[] = {Normal(&kRegular, "home")};
+  EXPECT_EQ(PickExpandTarget(&kRegular, windows).space, "home");
+}
+
+TEST(LittleWindowRoutingTest, SkipsWindowsThatCantTakeTheTab) {
+  WindowFacts popup = Normal(&kRegular, "");
+  popup.normal = false;  // Another little window, a popup, an app, PiP.
+  WindowFacts closing = Normal(&kRegular, "a");
+  closing.closing = true;
+  WindowFacts elsewhere = Normal(&kRegular, "b");
+  elsewhere.on_current_desktop = false;
+  const WindowFacts windows[] = {popup, closing, elsewhere,
+                                 Normal(&kRegular, "c")};
+  ExpandTarget target = PickExpandTarget(&kRegular, windows);
+  EXPECT_EQ(target.window, 3u);
+  EXPECT_EQ(target.space, "c");
+}
+
+TEST(LittleWindowRoutingTest, StaysInItsOwnProfile) {
+  // The most recent window belongs to another profile; the tab goes to its
+  // own profile's window even though that one is older.
+  const WindowFacts windows[] = {Normal(&kOtherProfile, "x"),
+                                 Normal(&kRegular, "mine")};
+  ExpandTarget target = PickExpandTarget(&kRegular, windows);
+  EXPECT_EQ(target.window, 1u);
+  EXPECT_EQ(target.space, "mine");
+}
+
+TEST(LittleWindowRoutingTest, IncognitoStaysIncognito) {
+  WindowFacts incognito = Normal(&kIncognito, "");
+  const WindowFacts windows[] = {Normal(&kRegular, "work"), incognito};
+  EXPECT_EQ(PickExpandTarget(&kIncognito, windows).window, 1u);
+  // A regular little window never lands in the incognito window.
+  const WindowFacts only_incognito[] = {incognito};
+  EXPECT_FALSE(PickExpandTarget(&kRegular, only_incognito).window);
+}
+
+TEST(LittleWindowRoutingTest, NoWindowMeansANewOne) {
+  ExpandTarget target = PickExpandTarget(&kRegular, {});
+  EXPECT_FALSE(target.window);
+  EXPECT_TRUE(target.space.empty());
+}
+
+TEST(LittleWindowRoutingTest, BoundsAreCenteredAtTheirSize) {
+  const gfx::Rect work_area(0, 25, 1440, 875);
+  const gfx::Rect bounds = LittleWindowBounds(work_area);
+  EXPECT_EQ(bounds.size().ToString(), "960x720");
+  EXPECT_EQ(bounds.CenterPoint().ToString(),
+            work_area.CenterPoint().ToString());
+  EXPECT_TRUE(work_area.Contains(bounds));
+}
+
+TEST(LittleWindowRoutingTest, BoundsFollowTheDisplay) {
+  // A second display to the left of the main one.
+  const gfx::Rect work_area(-1920, 0, 1920, 1080);
+  const gfx::Rect bounds = LittleWindowBounds(work_area);
+  EXPECT_TRUE(work_area.Contains(bounds));
+  EXPECT_EQ(bounds.CenterPoint().ToString(),
+            work_area.CenterPoint().ToString());
+}
+
+TEST(LittleWindowRoutingTest, BoundsShrinkOnASmallDisplay) {
+  const gfx::Rect work_area(0, 0, 800, 600);
+  const gfx::Rect bounds = LittleWindowBounds(work_area);
+  EXPECT_TRUE(work_area.Contains(bounds));
+  EXPECT_LT(bounds.width(), 800);
+  EXPECT_LT(bounds.height(), 600);
+  // A tiny work area still gets a window inside it.
+  const gfx::Rect tiny(0, 0, 40, 30);
+  EXPECT_TRUE(tiny.Contains(LittleWindowBounds(tiny)));
+  EXPECT_FALSE(LittleWindowBounds(tiny).IsEmpty());
+}
+
+}  // namespace
+}  // namespace rac::little_window

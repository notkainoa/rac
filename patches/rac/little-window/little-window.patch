+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/ui/rac/little_window/little_window_routing.h"
+
+#include <algorithm>
+
+#include "chrome/browser/ui/views/rac/rac_tokens.h"
+#include "ui/gfx/geometry/size.h"
+#include "url/gurl.h"
+
+namespace rac::little_window {
+namespace {
+
+// Big enough for a page's desktop layout, small enough to read as a preview
+// floating over the main window.
+constexpr gfx::Size kLittleWindowSize(960, 720);
+
+}  // namespace
+
+LinkRoute RouteLinksFromOtherApp(base::span<const GURL> urls) {
+  if (urls.size() != 1) {
+    return LinkRoute::kTabs;
+  }
+  const GURL& url = urls.front();
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() ? LinkRoute::kLittleWindow
+                                                     : LinkRoute::kTabs;
+}
+
+ExpandTarget PickExpandTarget(
+    const void* profile,
+    base::span<const WindowFacts> windows_by_activation) {
+  for (size_t i = 0; i < windows_by_activation.size(); ++i) {
+    const WindowFacts& window = windows_by_activation[i];
+    if (window.profile == profile && window.normal && !window.closing &&
+        window.on_current_desktop) {
+      return {.window = i, .space = window.active_space};
+    }
+  }
+  return {};
+}
+
+gfx::Rect LittleWindowBounds(const gfx::Rect& work_area) {
+  gfx::Rect room = work_area;
+  room.Inset(rac::tokens::kSpacing24);
+  if (room.IsEmpty()) {
+    room = work_area;
+  }
+  gfx::Rect bounds(std::min(kLittleWindowSize.width(), room.width()),
+                   std::min(kLittleWindowSize.height(), room.height()));
+  bounds.set_origin(room.CenterPoint() -
+                    gfx::Vector2d(bounds.width() / 2, bounds.height() / 2));
+  return bounds;
+}
+
+}  // namespace rac::little_window

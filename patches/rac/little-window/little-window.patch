+
+// The little window: a link from another app opens in a small window of its
+// own instead of a tab in the main window. It is a real tab in a Chromium
+// popup window, so permission prompts, downloads, find, and dialogs work and
+// name the page's own origin. Open as Tab (⌘O, or the toolbar button) moves
+// the page into the main window without reloading it. ⌥⌘N opens an empty
+// one.
+//
+// Nothing here runs or exists until a little window opens: the hooks below
+// are plain function calls that return at once, and the list of little
+// windows is made with the first one.
+//
+// Hooks into Chromium (rac/little-window/little-window.patch):
+//  - app_controller_mac.mm: OpenStartupTabsInBrowserWithProfile asks
+//    OpenLinksFromOtherApp first; ⌥⌘N with no window open.
+//  - browser_command_controller.cc: IDC_OPEN_FILE runs OpenAsTab in a little
+//    window.
+//  - toolbar_view.cc: a little window's address field can be edited.
+namespace rac::little_window {
+
+// Whether `browser` is a little window, or the popup CreateLittleWindow is
+// making right now (its toolbar asks while it is being built).
+bool IsLittleWindow(const BrowserWindowInterface* browser);
+
+// For the URLs macOS hands rac from another app, once Chromium has picked
+// `profile` (the last used one, never incognito unless policy forces it).
+// Opens them in a little window and returns true when they route to one;
+// returns false to leave them to Chromium.
+bool OpenLinksFromOtherApp(const StartupTabs& tabs, Profile* profile);
+
+// Opens an empty little window for `profile`, with its address field focused.
+// An incognito profile's little window is incognito.
+BrowserWindowInterface* OpenEmpty(Profile* profile);
+
+// Moves the little window's page into a normal window of its profile as the
+// active tab, without reloading it, and closes the little window. Returns
+// false when `browser` isn't a little window.
+bool OpenAsTab(BrowserWindowInterface* browser);
+
+// The action table's handler for the open_little_window row (⌥⌘N, File >
+// New Little Window, the command bar).
+void OpenLittleWindowAction(const action_table::ActionContext& context,
+                            const base::DictValue& args);
+
+#if BUILDFLAG(IS_MAC)
+// Retitles File > Open File… (⌘O) to Open as Tab while a little window is
+// the active window, and back. In little_window_mac.mm.
+void SetOpenFileItemOpensAsTab(bool as_tab);
+#endif
+
+}  // namespace rac::little_window

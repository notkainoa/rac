+// True only while CreateLittleWindow builds its popup, so the popup's toolbar
+// can tell it apart from other popups before the window is listed.
+bool g_creating_little_window = false;
+
+// The open little windows. Made with the first one; a window leaves the list
+// when it closes.
+class LittleWindows {
+ public:
+  LittleWindows() = default;
+  LittleWindows(const LittleWindows&) = delete;
+  LittleWindows& operator=(const LittleWindows&) = delete;
+  ~LittleWindows() = default;
+
+  static LittleWindows* Get() { return Instance().get(); }
+
+  static LittleWindows& GetOrCreate() {
+    if (!Instance()) {
+      Instance() = std::make_unique<LittleWindows>();
+    }
+    return *Instance();
+  }
+
+  void Add(BrowserWindowInterface* browser) {
+    Subscriptions& subscriptions = windows_[browser];
+    subscriptions.closed = browser->RegisterBrowserDidClose(
+        base::BindRepeating(&LittleWindows::OnClosed, base::Unretained(this)));
+#if BUILDFLAG(IS_MAC)
+    subscriptions.active = browser->RegisterDidBecomeActive(base::BindRepeating(
+        &LittleWindows::UpdateOpenFileItem, base::Unretained(this)));
+    subscriptions.inactive =
+        browser->RegisterDidBecomeInactive(base::BindRepeating(
+            &LittleWindows::UpdateOpenFileItem, base::Unretained(this)));
+    UpdateOpenFileItem(browser);
+#endif
+  }
+
+  bool Contains(const BrowserWindowInterface* browser) const {
+    return windows_.contains(browser);
+  }
+
+ private:
+  struct Subscriptions {
+    base::CallbackListSubscription closed;
+    base::CallbackListSubscription active;
+    base::CallbackListSubscription inactive;
+  };
+
+  static std::unique_ptr<LittleWindows>& Instance() {
+    static base::NoDestructor<std::unique_ptr<LittleWindows>> instance;
+    return *instance;
+  }
+
+  void OnClosed(BrowserWindowInterface* browser) {
+    windows_.erase(browser);
+#if BUILDFLAG(IS_MAC)
+    UpdateOpenFileItem(browser);
+#endif
+  }
+
+#if BUILDFLAG(IS_MAC)
+  // Activation callbacks can arrive in either order when focus moves from
+  // one little window to another, so this looks at every window instead of
+  // trusting the one that changed.
+  void UpdateOpenFileItem(BrowserWindowInterface* /*changed*/) {
+    bool any_active = false;
+    for (const auto& [window, subscriptions] : windows_) {
+      any_active |= window->IsActive();
+    }
+    SetOpenFileItemOpensAsTab(any_active);
+  }
+#endif
+
+  std::map<const BrowserWindowInterface*, Subscriptions> windows_;
+};
+
+// The ⌘O button at the end of the little window's toolbar.
+void AddOpenAsTabButton(BrowserWindowInterface* browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  ToolbarView* toolbar = browser_view ? browser_view->toolbar() : nullptr;
+  if (!toolbar) {
+    return;
+  }
+  auto button = std::make_unique<ToolbarButton>(base::BindRepeating(
+      [](base::WeakPtr<BrowserWindowInterface> window) {
+        if (window) {
+          OpenAsTab(window.get());
+        }
+      },
+      browser->GetWeakPtr()));
+  const std::u16string label =
+      l10n_util::GetStringUTF16(IDS_RAC_LITTLE_WINDOW_OPEN_AS_TAB);
+  button->SetVectorIcon(kOpenInFullIcon);
+  button->SetTooltipText(label);
+  button->GetViewAccessibility().SetName(label);
+  button->SetPreferredSize(
+      browser_view->toolbar_button_provider()->GetToolbarButtonSize());
+  button->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(0, rac::tokens::kSpacing4, 0, rac::tokens::kSpacing4));
+  toolbar->AddChildView(std::move(button));
+}
+
+BrowserWindowInterface* CreateLittleWindow(Profile* profile) {
+  if (!profile || GetBrowserWindowCreationStatusForProfile(*profile) !=
+                      BrowserWindowInterface::CreationStatus::kOk) {
+    return nullptr;
+  }
+  BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_POPUP, *profile,
+                                   /*from_user_gesture=*/true);
+  // A closed little window keeps nothing: no session restore, no remembered
+  // placement. Popups never reach Recently Closed.
+  params.omit_from_session_restore = true;
+  params.should_trigger_session_restore = false;
+  params.initial_bounds = LittleWindowBounds(
+      display::Screen::Get()->GetDisplayForNewWindows().work_area());
+  params.initial_origin_specified =
+      BrowserWindowCreateParams::ValueSpecified::kSpecified;
+
+  BrowserWindowInterface* browser = nullptr;
+  {
+    base::AutoReset<bool> creating(&g_creating_little_window, true);
+    browser = CreateBrowserWindow(std::move(params));
+  }
+  if (!browser) {
+    return nullptr;
+  }
+  LittleWindows::GetOrCreate().Add(browser);
+  AddOpenAsTabButton(browser);
+  return browser;
+}
+
+}  // namespace
+
+bool IsLittleWindow(const BrowserWindowInterface* browser) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_POPUP) {
+    return false;
+  }
+  if (g_creating_little_window) {
+    return true;
+  }
+  const LittleWindows* windows = LittleWindows::Get();
+  return windows && windows->Contains(browser);
+}
+
+bool OpenLinksFromOtherApp(const StartupTabs& tabs, Profile* profile) {
+  std::vector<GURL> urls;
+  urls.reserve(tabs.size());
+  for (const StartupTab& tab : tabs) {
+    urls.push_back(tab.url);
+  }
+  if (RouteLinksFromOtherApp(urls) != LinkRoute::kLittleWindow) {
+    return false;
+  }
+  BrowserWindowInterface* browser = CreateLittleWindow(profile);
+  if (!browser) {
+    return false;
+  }
+  // As Chromium's own startup tabs load (StartupBrowserCreatorImpl::
+  // OpenTabsInBrowser): a top-level load from outside the browser.
+  const StartupTab& tab = tabs.front();
+  NavigateParams navigate(browser, tab.url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  if (tab.is_untrusted_launch) {
+    // A custom scheme launch from another app: an opaque initiator, so the
+    // load is never treated as typed by the user.
+    navigate.initiator_origin = url::Origin();
+  }
+  navigate.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  navigate.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&navigate);
+  return true;
+}
+
+BrowserWindowInterface* OpenEmpty(Profile* profile) {
+  BrowserWindowInterface* browser = CreateLittleWindow(profile);
+  if (!browser) {
+    return nullptr;
+  }
+  chrome::AddTabAt(browser, GURL(), /*index=*/-1, /*foreground=*/true,
+                   /*group=*/std::nullopt, /*pinned=*/false,
+                   NavigateParams::WindowAction::kShowWindow);
+  chrome::FocusLocationBar(browser);
+  return browser;
+}
+
+bool OpenAsTab(BrowserWindowInterface* browser) {
+  if (!IsLittleWindow(browser)) {
+    return false;
+  }
+  TabStripModel* tabs = browser->GetTabStripModel();
+  if (tabs->empty()) {
+    return true;
+  }
+  Profile* profile = browser->GetProfile();
+
+  std::vector<BrowserWindowInterface*> windows;
+  std::vector<WindowFacts> facts;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* window) {
+        WindowFacts fact{
+            .profile = window->GetProfile(),
+            .normal = window->GetType() == BrowserWindowInterface::TYPE_NORMAL,
+            .closing = window->IsDeleteScheduled()};
+        if (BrowserWindow* native = BrowserWindow::FromBrowser(window)) {
+          fact.on_current_desktop = native->IsOnCurrentWorkspace();
+        }
+        if (SpacesWindowManager* spaces = SpacesWindowManager::From(window)) {
+          if (std::optional<SpaceId> space = spaces->GetActiveSpaceId(window)) {
+            fact.active_space = space->AsLowercaseString();
+          }
+        }
+        windows.push_back(window);
+        facts.push_back(std::move(fact));
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  const ExpandTarget target = PickExpandTarget(profile, facts);
+
+  // Make the new window, if one is needed, before the page leaves: closing
+  // the last window first would start shutting the browser down (as in
+  // chrome::ConvertPopupToTabbedBrowser).
+  BrowserWindowInterface* into =
+      target.window ? windows[*target.window]
+                    : CreateBrowserWindow(BrowserWindowCreateParams(
+                          *profile, /*from_user_gesture=*/true));
+  if (!into) {
+    return true;
+  }
+  // The WebContents moves as it is: no reload, the same scroll position and
+  // form text. The tab can't move whole between window types
+  // (crbug.com/334281979), so its per-tab features start fresh, as with
+  // Chromium's Show as Tab. The window inserts it into the space it shows.
+  // Emptying the popup closes it.
+  std::unique_ptr<content::WebContents> contents =
+      tabs->DetachWebContentsAtForInsertion(tabs->active_index());
+  into->GetTabStripModel()->AppendWebContents(std::move(contents),
+                                              /*foreground=*/true);
+  if (BrowserWindow* native = BrowserWindow::FromBrowser(into)) {
+    native->Show();
+  }
+  return true;
+}
+
+void OpenLittleWindowAction(const action_table::ActionContext& context,
+                            const base::DictValue& /*args*/) {
+  if (context.browser) {
+    OpenEmpty(context.browser->GetProfile());
+  }
+}

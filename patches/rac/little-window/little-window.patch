+void SetOpenFileItemOpensAsTab(bool as_tab) {
+  NSMenu* file_menu = [NSApp.mainMenu itemWithTag:IDC_FILE_MENU].submenu;
+  NSMenuItem* item = [file_menu itemWithTag:IDC_OPEN_FILE];
+  if (!item) {
+    return;
+  }
+  // Same key (⌘O); browser_command_controller.cc sends IDC_OPEN_FILE to
+  // OpenAsTab in a little window.
+  item.title = l10n_util::GetNSStringWithFixup(
+      as_tab ? IDS_RAC_LITTLE_WINDOW_OPEN_AS_TAB : IDS_OPEN_FILE_MAC);
+}

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_RAC_LITTLE_WINDOW_LITTLE_WINDOW_ROUTING_H_
+#define CHROME_BROWSER_UI_RAC_LITTLE_WINDOW_LITTLE_WINDOW_ROUTING_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+
+#include "base/containers/span.h"
+#include "ui/gfx/geometry/rect.h"
+
+class GURL;
+
+// Where the little window's links and tabs go. Plain values in, a decision
+// out: no browser, profile, or window objects, so the rules are unit tested
+// without a browser. The browser side
+// (chrome/browser/ui/views/rac/little_window/) gathers the facts and acts.
+namespace rac::little_window {
+
+// What happens to the URLs macOS hands rac from another app: a link clicked
+// in Mail or Slack, a .webloc file, Handoff.
+enum class LinkRoute {
+  // One web link: it opens in a little window.
+  kLittleWindow,
+  // Anything else (several links at once, files, other schemes): Chromium
+  // opens tabs in a normal window, as it always has.
+  kTabs,
+};
+LinkRoute RouteLinksFromOtherApp(base::span<const GURL> urls);
+
+// One open browser window, as the expand decision sees it.
+struct WindowFacts {
+  // Names the window's profile. An incognito profile is not its regular
+  // profile, so an incognito little window never expands into a regular
+  // window, or the reverse.
+  const void* profile = nullptr;
+  // A normal tabbed window: not a popup, a little window, an app, or PiP.
+  bool normal = false;
+  bool closing = false;
+  // On the macOS desktop (Space) the user is looking at.
+  bool on_current_desktop = true;
+  // The rac space the window shows; empty when it has none.
+  std::string active_space;
+};
+
+struct ExpandTarget {
+  // Index into the windows passed in, or nullopt for a new normal window.
+  std::optional<size_t> window;
+  // The rac space the tab joins: the one its window shows. Empty for a new
+  // window, which claims a space the way every new window does.
+  std::string space;
+};
+
+// Where a little window's tab goes when it becomes a tab: the most recently
+// active normal window of the same profile on the current desktop, into the
+// space it shows. `windows_by_activation` is most recently active first.
+ExpandTarget PickExpandTarget(
+    const void* profile,
+    base::span<const WindowFacts> windows_by_activation);
+
+// A new little window's bounds on a display with `work_area`: a fixed size,
+// shrunk to fit inside the work area's margin, centered. A closed little
+// window keeps nothing, so there is no remembered placement.
+gfx::Rect LittleWindowBounds(const gfx::Rect& work_area);
+
+}  // namespace rac::little_window
+
+#endif  // CHROME_BROWSER_UI_RAC_LITTLE_WINDOW_LITTLE_WINDOW_ROUTING_H_

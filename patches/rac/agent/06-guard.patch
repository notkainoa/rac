+TEST(SnapshotSerializerTest, FormsShareOneSnapshotBudget) {
+  auto page = MakePage();
+  for (int id = 1; id <= 2; ++id) {
+    auto* form = Node(page.mutable_root_node(), proto::CONTENT_ATTRIBUTE_FORM);
+    form->mutable_content_attributes()->mutable_form_data()->set_action_url(
+        "https://example.com/submit");
+    auto* button = Node(form, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+    DomId(button, id);
+    Visible(button);
+    button->mutable_content_attributes()->set_label(std::string(32, 'a'));
+    button->mutable_content_attributes()
+        ->mutable_form_control_data()
+        ->set_form_control_type(proto::FORM_CONTROL_TYPE_BUTTON_BUTTON);
+  }
+  RefTable refs;
+  SnapshotOptions options;
+  options.max_chars = 90;
+  auto snapshot = SerializeAgentSnapshot(page, refs, options, 1);
+  EXPECT_EQ(snapshot.lines.size(), 1u);
+  EXPECT_LE(snapshot.text.size(), options.max_chars);
+}

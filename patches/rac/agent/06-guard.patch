--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/agent/action_guard.h	2026-10-23 19:05:20.291129106 -0700
@@ -0,0 +1,44 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+#ifndef CHROME_BROWSER_RAC_AGENT_ACTION_GUARD_H_
+#define CHROME_BROWSER_RAC_AGENT_ACTION_GUARD_H_
+#include <set>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/rac/agent/tool_registry.h"
+namespace rac::agent {
+struct ActionMetadata {
+  ActionRiskInput risk;
+  std::string url;
+  bool requires_url_provenance = true;
+  std::string frame_origin;
+  bool submit = false;
+  bool press_enter = false;
+  bool unknown_target = false;
+  bool download = false;
+  bool closing_user_tab = false;
+};
+enum class GuardDecision { kAllow, kPlan, kConfirm, kBlock };
+struct GuardResult {
+  GuardDecision decision = GuardDecision::kBlock;
+  RiskClass risk = RiskClass::kConsequential;
+  std::string reason;
+};
+class ActionGuard {
+ public:
+  void BeginTurn(const std::vector<std::string>& user_messages,
+                 const std::set<std::string>& origins);
+  void RememberPageLink(const std::string& url);
+  void AllowPlan(const std::set<std::string>& additional_origins = {});
+  GuardResult Evaluate(const ActionMetadata& action) const;
+  const std::set<std::string>& origins() const { return origins_; }
+
+ private:
+  std::set<std::string> urls_;
+  std::set<std::string> origins_;
+  bool plan_allowed_ = false;
+};
+std::string RiskClassName(RiskClass risk);
+}  // namespace rac::agent
+#endif
Index: src/chrome/browser/rac/agent/action_guard_unittest.cc
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/agent/action_guard_unittest.cc	2026-10-23 19:05:20.291402311 -0700
@@ -0,0 +1,124 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+#include "chrome/browser/rac/agent/action_guard.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+namespace rac::agent {
+namespace {
+ActionMetadata Low() {
+  ActionMetadata a;
+  a.risk.tool_name = "type";
+  a.risk.current_origin = "https://example.com";
+  a.risk.element_role = "textbox";
+  a.risk.element_name = "Email";
+  return a;
+}
+}  // namespace
+TEST(ActionGuardTest, ReadsAreFreeAndFirstActionNeedsPlan) {
+  ActionGuard guard;
+  guard.BeginTurn({}, {"https://example.com"});
+  auto a = Low();
+  a.risk.tool_name = "snapshot";
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kAllow);
+  a = Low();
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kPlan);
+  guard.AllowPlan();
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kAllow);
+  guard.BeginTurn({}, {"https://example.com"});
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kPlan);
+}
+TEST(ActionGuardTest, EveryConsequentialStepNeedsConfirmation) {
+  ActionGuard guard;
+  guard.BeginTurn({}, {"https://example.com"});
+  guard.AllowPlan();
+  for (const char* label : {"Submit", "Send", "Buy", "Checkout", "Pay",
+                            "Delete", "Upload", "Sign in"}) {
+    auto a = Low();
+    a.risk.tool_name = "click";
+    a.risk.element_name = label;
+    EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kConfirm) << label;
+  }
+  for (int i = 0; i < 7; ++i) {
+    auto a = Low();
+    if (i == 0) {
+      a.risk.is_password_field = true;
+    }
+    if (i == 1) {
+      a.risk.is_payment_field = true;
+    }
+    if (i == 2) {
+      a.submit = true;
+    }
+    if (i == 3) {
+      a.press_enter = true;
+    }
+    if (i == 4) {
+      a.unknown_target = true;
+    }
+    if (i == 5) {
+      a.frame_origin = "https://other.com";
+    }
+    if (i == 6) {
+      a.closing_user_tab = true;
+    }
+    EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kConfirm) << i;
+  }
+}
+TEST(ActionGuardTest, ProvenanceIsExactAndNeverComesFromPageText) {
+  ActionGuard guard;
+  guard.BeginTurn({"Open https://example.com/start."}, {"https://example.com"});
+  guard.AllowPlan();
+  auto a = Low();
+  a.risk.tool_name = "navigate";
+  a.url = "https://example.com/start";
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kConfirm);
+  a.url = "https://example.com/injection";
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kBlock);
+  guard.RememberPageLink(a.url);
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kConfirm);
+  a.url = "https://forms.example.com/submit";
+  a.submit = true;
+  a.requires_url_provenance = false;
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kConfirm);
+  a.requires_url_provenance = true;
+  a.submit = false;
+  a.url = "https://example.com/injection";
+  a.url += "?different";
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kBlock);
+}
+TEST(ActionGuardTest, SchemesDownloadsAndUnknownToolsStayBlocked) {
+  ActionGuard guard;
+  guard.BeginTurn({}, {"https://example.com"});
+  guard.AllowPlan();
+  auto a = Low();
+  a.risk.tool_name = "navigate";
+  for (const char* url :
+       {"chrome://settings", "chrome-extension://x/a", "file:///tmp/a",
+        "data:text/html,x", "javascript:alert(1)",
+        "blob:https://example.com/a"}) {
+    a.url = url;
+    guard.RememberPageLink(url);
+    EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kBlock) << url;
+  }
+  a = Low();
+  a.download = true;
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kBlock);
+  a = Low();
+  a.risk.tool_name = "shell";
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kBlock);
+}
+TEST(ActionGuardTest, NoGrantForOtherOriginsOrFrames) {
+  ActionGuard guard;
+  guard.BeginTurn({}, {"https://example.com"});
+  guard.AllowPlan({"https://planned.com"});
+  auto planned = Low();
+  planned.risk.current_origin = "https://planned.com";
+  EXPECT_EQ(guard.Evaluate(planned).decision, GuardDecision::kAllow);
+  auto a = Low();
+  a.risk.current_origin = "https://other.com";
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kConfirm);
+  a = Low();
+  a.frame_origin = "https://other.com";
+  EXPECT_EQ(guard.Evaluate(a).decision, GuardDecision::kConfirm);
+}
+}  // namespace rac::agent

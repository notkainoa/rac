+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+#include "chrome/browser/rac/agent/commit_guard.h"
+
+#include "chrome/browser/rac/agent/action_context.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+namespace rac::agent {
+namespace {
+class CommitGuard : public content::CommitDeferringCondition {
+ public:
+  explicit CommitGuard(content::NavigationHandle& handle)
+      : content::CommitDeferringCondition(handle) {}
+  Result WillCommitNavigation(base::OnceClosure resume) override {
+    auto& handle = GetNavigationHandle();
+    auto* context = ActionContext::From(handle.GetWebContents());
+    if (!context || context->AllowsNavigation(handle.GetURL())) {
+      return Result::kProceed;
+    }
+    context->ReportBlocked(
+        "Navigation outside the approved origins was blocked.");
+    handle.GetWebContents()->Stop();
+    return Result::kCancelled;
+  }
+  const char* TraceEventName() const override { return "RacAgentCommitGuard"; }
+};
+}  // namespace
+std::unique_ptr<content::CommitDeferringCondition> CreateCommitGuard(
+    content::NavigationHandle& handle) {
+  if (!ActionContext::From(handle.GetWebContents())) {
+    return nullptr;
+  }
+  return std::make_unique<CommitGuard>(handle);
+}
+}  // namespace rac::agent

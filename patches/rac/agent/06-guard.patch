+#include "third_party/blink/public/web/web_form_element.h"
+namespace rac::agent {
+namespace {
+std::string Clean(const blink::WebString& text) {
+  return base::CollapseWhitespaceASCII(text.Utf8(), false);
+}
+std::string ControlType(blink::mojom::FormControlType type) {
+  switch (type) {
+    case blink::mojom::FormControlType::kButtonButton:
+      return "16";
+    case blink::mojom::FormControlType::kButtonSubmit:
+      return "17";
+    case blink::mojom::FormControlType::kButtonReset:
+      return "18";
+    case blink::mojom::FormControlType::kButtonPopover:
+      return "19";
+    case blink::mojom::FormControlType::kFieldset:
+      return "20";
+    case blink::mojom::FormControlType::kInputButton:
+      return "21";
+    case blink::mojom::FormControlType::kInputCheckbox:
+      return "2";
+    case blink::mojom::FormControlType::kInputColor:
+      return "22";
+    case blink::mojom::FormControlType::kInputDate:
+      return "23";
+    case blink::mojom::FormControlType::kInputDatetimeLocal:
+      return "24";
+    case blink::mojom::FormControlType::kInputEmail:
+      return "3";
+    case blink::mojom::FormControlType::kInputFile:
+      return "25";
+    case blink::mojom::FormControlType::kInputHidden:
+      return "26";
+    case blink::mojom::FormControlType::kInputImage:
+      return "27";
+    case blink::mojom::FormControlType::kInputMonth:
+      return "4";
+    case blink::mojom::FormControlType::kInputNumber:
+      return "5";
+    case blink::mojom::FormControlType::kInputPassword:
+      return "6";
+    case blink::mojom::FormControlType::kInputRadio:
+      return "7";
+    case blink::mojom::FormControlType::kInputRange:
+      return "28";
+    case blink::mojom::FormControlType::kInputReset:
+      return "29";
+    case blink::mojom::FormControlType::kInputSearch:
+      return "8";
+    case blink::mojom::FormControlType::kInputSubmit:
+      return "30";
+    case blink::mojom::FormControlType::kInputTelephone:
+      return "9";
+    case blink::mojom::FormControlType::kInputText:
+      return "10";
+    case blink::mojom::FormControlType::kInputTime:
+      return "31";
+    case blink::mojom::FormControlType::kInputUrl:
+      return "11";
+    case blink::mojom::FormControlType::kInputWeek:
+      return "32";
+    case blink::mojom::FormControlType::kOutput:
+      return "33";
+    case blink::mojom::FormControlType::kSelectOne:
+      return "12";
+    case blink::mojom::FormControlType::kSelectMultiple:
+      return "13";
+    case blink::mojom::FormControlType::kTextArea:
+      return "15";
+  }
+}
+}  // namespace
+bool ValidateActionSemantics(
+    const content::RenderFrame& frame,
+    int node_id,
+    const actor::mojom::RacActionExpectation& expected) {
+  auto element =
+      actor::GetNodeFromId(frame, node_id).DynamicTo<blink::WebElement>();
+  if (!element) {
+    return false;
+  }
+  auto control = element.DynamicTo<blink::WebFormControlElement>();
+  if (!expected.control_type.empty()) {
+    if (!control ||
+        ControlType(control.FormControlType()) != expected.control_type) {
+      return false;
+    }
+  } else if (control) {
+    return false;
+  }
+  if (!expected.sensitive) {
+    if (control && control.FormControlTypeForAutofill() ==
+                       blink::mojom::FormControlType::kInputPassword) {
+      return false;
+    }
+    const auto autocomplete = base::ToLowerASCII(
+        element.GetAttribute(blink::WebString::FromUtf8("autocomplete"))
+            .Utf8());
+    if (autocomplete.find("cc-") != std::string::npos ||
+        autocomplete.find("one-time-code") != std::string::npos) {
+      return false;
+    }
+    const auto security = element
+                              .GetComputedValue(blink::WebString::FromUtf8(
+                                  "-webkit-text-security"))
+                              .Utf8();
+    if (!security.empty() && security != "none") {
+      return false;
+    }
+  }
+  if (element.HasAttribute(blink::WebString::FromUtf8("download"))) {
+    return false;
+  }
+  std::string link;
+  if (element.HasAttribute(blink::WebString::FromUtf8("href"))) {
+    link = element.GetDocument()
+               .CompleteURL(
+                   element.GetAttribute(blink::WebString::FromUtf8("href")))
+               .GetString()
+               .Utf8();
+  }
+  if (link != expected.link_url) {
+    return false;
+  }
+  const std::string form_action =
+      control && !control.Form().IsNull() ? control.Form().Action().Utf8() : "";
+  if (form_action != expected.form_action) {
+    return false;
+  }
+  std::string name =
+      Clean(element.GetAttribute(blink::WebString::FromUtf8("aria-label")));
+  if (name.empty() &&
+      (element.HasHTMLTagName(blink::WebString::FromUtf8("button")) ||
+       (control && (control.FormControlType() ==
+                        blink::mojom::FormControlType::kInputButton ||
+                    control.FormControlType() ==
+                        blink::mojom::FormControlType::kInputSubmit)))) {
+    name = Clean(element.TextContent());
+    if (name.empty() && control) {
+      name = Clean(control.Value());
+    }
+  }
+  if (name.empty() && control) {
+    name = Clean(control.NameForAutofill());
+  }
+  if (name.empty() && control) {
+    name =
+        Clean(element.GetAttribute(blink::WebString::FromUtf8("placeholder")));
+  }
+  if (name.empty()) {
+    name = Clean(element.TextContent());
+  }
+  std::string expected_name = expected.name;
+  base::RemoveChars(name, base::kWhitespaceASCII, &name);
+  base::RemoveChars(expected_name, base::kWhitespaceASCII, &expected_name);
+  if (!name.empty() && name != expected_name) {
+    return false;
+  }
+  return true;
+}
+}  // namespace rac::agent

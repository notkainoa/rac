--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/agent/action_guard.cc	2026-10-23 19:05:20.290912566 -0700
@@ -0,0 +1,99 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+#include "chrome/browser/rac/agent/action_guard.h"
+
+#include "base/strings/string_util.h"
+#include "url/gurl.h"
+namespace rac::agent {
+void ActionGuard::BeginTurn(const std::vector<std::string>& user_messages,
+                            const std::set<std::string>& origins) {
+  urls_.clear();
+  origins_ = origins;
+  plan_allowed_ = false;
+  for (const auto& message : user_messages) {
+    size_t position = 0;
+    while ((position = message.find("http", position)) != std::string::npos) {
+      size_t end = message.find_first_of(" \t\n\r<>\"'`", position);
+      std::string candidate = message.substr(
+          position, end == std::string::npos ? end : end - position);
+      if (IsAllowedAgentUrl(candidate)) {
+        urls_.insert(GURL(candidate).spec());
+      }
+      while (!candidate.empty() &&
+             (candidate.back() == '.' || candidate.back() == ')' ||
+              candidate.back() == ']')) {
+        candidate.pop_back();
+      }
+      if (IsAllowedAgentUrl(candidate)) {
+        urls_.insert(GURL(candidate).spec());
+      }
+      position = end == std::string::npos ? message.size() : end + 1;
+    }
+  }
+}
+void ActionGuard::RememberPageLink(const std::string& url) {
+  if (IsAllowedAgentUrl(url) && urls_.size() < 4096) {
+    urls_.insert(GURL(url).spec());
+  }
+}
+void ActionGuard::AllowPlan(const std::set<std::string>& additional_origins) {
+  origins_.insert(additional_origins.begin(), additional_origins.end());
+  plan_allowed_ = true;
+}
+
+GuardResult ActionGuard::Evaluate(const ActionMetadata& action) const {
+  const auto* tool = FindToolDefinition(action.risk.tool_name);
+  if (!tool) {
+    return {GuardDecision::kBlock, RiskClass::kConsequential,
+            "Unknown browser tool."};
+  }
+  if (tool->kind == ToolKind::kRead) {
+    return {GuardDecision::kAllow, RiskClass::kNone, ""};
+  }
+  if (action.download ||
+      base::ToLowerASCII(action.risk.element_name).find("download") !=
+          std::string::npos) {
+    return {GuardDecision::kBlock, RiskClass::kConsequential,
+            "Downloads are not allowed."};
+  }
+  if (!action.url.empty()) {
+    if (!IsAllowedAgentUrl(action.url)) {
+      return {GuardDecision::kBlock, RiskClass::kConsequential,
+              "Only http(s) web pages are allowed."};
+    }
+    if (action.requires_url_provenance &&
+        !urls_.contains(GURL(action.url).spec())) {
+      return {GuardDecision::kBlock, RiskClass::kConsequential,
+              "This URL was not supplied by the user or a visible page link."};
+    }
+  }
+  RiskClass risk = ClassifyActionRisk(action.risk);
+  if (action.submit || action.press_enter || action.unknown_target ||
+      action.closing_user_tab ||
+      !origins_.contains(action.risk.current_origin) ||
+      (!action.frame_origin.empty() &&
+       !origins_.contains(action.frame_origin))) {
+    risk = RiskClass::kConsequential;
+  }
+  if (!plan_allowed_) {
+    return {GuardDecision::kPlan, risk,
+            "Review the browser plan before starting."};
+  }
+  if (risk != RiskClass::kLow) {
+    return {GuardDecision::kConfirm, risk,
+            "This step may send information, change an account, or leave the "
+            "allowed sites."};
+  }
+  return {GuardDecision::kAllow, risk, ""};
+}
+std::string RiskClassName(RiskClass risk) {
+  switch (risk) {
+    case RiskClass::kNone:
+      return "read";
+    case RiskClass::kLow:
+      return "low";
+    case RiskClass::kConsequential:
+      return "consequential";
+  }
+}
+}  // namespace rac::agent

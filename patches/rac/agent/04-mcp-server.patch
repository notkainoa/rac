+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/mcp_echo_provider.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+
+namespace rac::agent {
+namespace {
+
+constexpr char kEchoSwitch[] = "rac-agent-mcp-echo";
+
+}  // namespace
+
+bool IsMcpEchoProviderEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kEchoSwitch);
+}
+
+std::vector<McpToolSpec> EchoMcpToolProvider::ListTools() {
+  McpToolSpec echo;
+  echo.name = "rac_echo";
+  echo.description =
+      "Echo the supplied text. Use this tool when asked to call rac_echo.";
+  echo.input_schema =
+      base::DictValue()
+          .Set("type", "object")
+          .Set("properties",
+               base::DictValue().Set("text",
+                                     base::DictValue().Set("type", "string")))
+          .Set("required", base::ListValue().Append("text"))
+          .Set("additionalProperties", false);
+  echo.read_only = true;
+  std::vector<McpToolSpec> tools;
+  tools.push_back(std::move(echo));
+  return tools;
+}
+
+void EchoMcpToolProvider::CallTool(
+    const std::string& name,
+    base::DictValue args,
+    base::OnceCallback<void(McpToolResult)> done) {
+  McpToolResult result;
+  if (name != "rac_echo") {
+    result.is_error = true;
+    result.content.Append(
+        base::DictValue().Set("type", "text").Set("text", "Unknown tool"));
+    std::move(done).Run(std::move(result));
+    return;
+  }
+  const std::string* text = args.FindString("text");
+  result.content.Append(
+      base::DictValue().Set("type", "text").Set("text", text ? *text : ""));
+  result.is_error = false;
+  std::move(done).Run(std::move(result));
+}
+
+}  // namespace rac::agent

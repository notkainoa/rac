+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_AGENT_MCP_PROTOCOL_H_
+#define CHROME_BROWSER_RAC_AGENT_MCP_PROTOCOL_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/rac/agent/mcp_tool_provider.h"
+
+namespace rac::agent {
+
+// Same local ceiling as ACP framing; not an MCP specification limit.
+inline constexpr size_t kMcpMaxFrameBytes = 8 * 1024 * 1024;
+
+// Negotiated subset used by Codex/Claude/Cursor via /usr/bin/nc -U.
+inline constexpr char kMcpDefaultProtocolVersion[] = "2024-11-05";
+
+// Fatal on any malformed frame, including an incomplete final line.
+class McpFramer {
+ public:
+  bool Feed(std::string_view bytes, std::vector<base::DictValue>& frames);
+  bool Finish();
+  bool failed() const { return failed_; }
+
+ private:
+  std::string buffer_;
+  bool failed_ = false;
+};
+
+base::DictValue MakeMcpResult(base::Value id, base::DictValue result);
+base::DictValue MakeMcpError(base::Value id, int code, std::string message);
+base::DictValue McpToolSpecToDict(const McpToolSpec& spec);
+base::DictValue McpToolResultToDict(const McpToolResult& result);
+
+// JSON-RPC dispatcher for one MCP connection. Tool calls run through the
+// provider asynchronously; write replies via `Write`.
+class McpConnectionHandler {
+ public:
+  using Write = base::RepeatingCallback<void(base::DictValue)>;
+
+  McpConnectionHandler(McpToolProvider* provider,
+                       ToolApprovalCallback approval,
+                       Write write);
+  ~McpConnectionHandler();
+
+  // Cuts the handler off from the provider: later calls get an error, and
+  // replies to calls in flight are dropped. Safe while a call is on the
+  // stack, unlike deleting the handler.
+  void Detach();
+
+  // Returns false when the connection must die (framing already failed
+  // upstream, or a protocol-fatal condition). Notifications return true with
+  // no write.
+  bool Handle(base::DictValue message);
+
+ private:
+  void OnToolDone(base::Value id, McpToolResult result);
+  void RunTool(base::Value id, std::string name, base::DictValue args);
+  void AfterApproval(base::Value id,
+                     std::string name,
+                     base::DictValue args,
+                     bool allow);
+
+  raw_ptr<McpToolProvider> provider_;
+  ToolApprovalCallback approval_;
+  Write write_;
+  std::string protocol_version_ = kMcpDefaultProtocolVersion;
+  base::WeakPtrFactory<McpConnectionHandler> weak_factory_{this};
+};
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_MCP_PROTOCOL_H_
Index: src/chrome/browser/rac/agent/mcp_protocol_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/rac/agent/mcp_protocol_unittest.cc
@@ -0,0 +1,149 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/mcp_protocol.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/test/bind.h"
+#include "base/test/task_environment.h"
+#include "chrome/browser/rac/agent/mcp_echo_provider.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::agent {
+namespace {
+
+base::DictValue Line(std::string_view json) {
+  auto value = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  CHECK(value);
+  CHECK(value->is_dict());
+  return std::move(*value).TakeDict();
+}
+
+TEST(McpFramerTest, SplitsAcrossChunksAndStripsCr) {
+  McpFramer framer;
+  std::vector<base::DictValue> frames;
+  EXPECT_TRUE(
+      framer.Feed(R"({"jsonrpc":"2.0","id":1,"method":"ping")", frames));
+  EXPECT_TRUE(frames.empty());
+  EXPECT_TRUE(framer.Feed("}\r\n", frames));
+  ASSERT_EQ(frames.size(), 1u);
+  EXPECT_EQ(frames[0].FindInt("id"), 1);
+  EXPECT_TRUE(framer.Finish());
+}
+
+TEST(McpFramerTest, MalformedLineIsFatal) {
+  McpFramer framer;
+  std::vector<base::DictValue> frames;
+  EXPECT_FALSE(framer.Feed("not-json\n", frames));
+  EXPECT_TRUE(framer.failed());
+}
+
+TEST(McpFramerTest, OversizedFrameIsFatal) {
+  McpFramer framer;
+  std::vector<base::DictValue> frames;
+  std::string big(kMcpMaxFrameBytes + 1, 'x');
+  EXPECT_FALSE(framer.Feed(big, frames));
+  EXPECT_TRUE(framer.failed());
+}
+
+TEST(McpFramerTest, IncompleteEofIsFatal) {
+  McpFramer framer;
+  std::vector<base::DictValue> frames;
+  EXPECT_TRUE(framer.Feed("{\"jsonrpc\":\"2.0\"", frames));
+  EXPECT_FALSE(framer.Finish());
+}
+
+class McpConnectionHandlerTest : public testing::Test {
+ public:
+  McpConnectionHandlerTest() {
+    handler_ = std::make_unique<McpConnectionHandler>(
+        &provider_, ToolApprovalCallback(),
+        base::BindLambdaForTesting([&](base::DictValue message) {
+          written_.push_back(std::move(message));
+        }));
+  }
+
+  void Handle(std::string_view json) {
+    EXPECT_TRUE(handler_->Handle(Line(json)));
+  }
+
+  base::test::TaskEnvironment env_;
+  EchoMcpToolProvider provider_;
+  std::unique_ptr<McpConnectionHandler> handler_;
+  std::vector<base::DictValue> written_;
+};
+
+TEST_F(McpConnectionHandlerTest, InitializeNegotiatesVersion) {
+  Handle(
+      R"({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","clientInfo":{"name":"t","version":"1"}}})");
+  ASSERT_EQ(written_.size(), 1u);
+  const base::DictValue* result = written_[0].FindDict("result");
+  ASSERT_TRUE(result);
+  EXPECT_EQ(*result->FindString("protocolVersion"), "2025-06-18");
+  EXPECT_EQ(*result->FindDict("serverInfo")->FindString("name"), "rac");
+}
+
+TEST_F(McpConnectionHandlerTest, ToolsListAndCallHappyPath) {
+  Handle(R"({"jsonrpc":"2.0","id":1,"method":"initialize","params":{}})");
+  Handle(R"({"jsonrpc":"2.0","method":"notifications/initialized"})");
+  Handle(R"({"jsonrpc":"2.0","id":2,"method":"tools/list"})");
+  ASSERT_GE(written_.size(), 2u);
+  const base::DictValue* list = written_.back().FindDict("result");
+  ASSERT_TRUE(list);
+  const base::ListValue* tools = list->FindList("tools");
+  ASSERT_TRUE(tools);
+  ASSERT_EQ(tools->size(), 1u);
+  EXPECT_EQ(*(*tools)[0].GetDict().FindString("name"), "rac_echo");
+
+  Handle(
+      R"({"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"rac_echo","arguments":{"text":"wp6m"}}})");
+  const base::DictValue* call = written_.back().FindDict("result");
+  ASSERT_TRUE(call);
+  EXPECT_EQ(call->FindBool("isError"), false);
+  const base::ListValue* content = call->FindList("content");
+  ASSERT_TRUE(content);
+  ASSERT_EQ(content->size(), 1u);
+  EXPECT_EQ(*(*content)[0].GetDict().FindString("text"), "wp6m");
+}
+
+TEST_F(McpConnectionHandlerTest, UnknownToolIsError) {
+  Handle(
+      R"({"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"nope","arguments":{}}})");
+  ASSERT_EQ(written_.size(), 1u);
+  EXPECT_TRUE(written_[0].FindDict("error"));
+  EXPECT_EQ(written_[0].FindDict("error")->FindInt("code"), -32602);
+}
+
+TEST_F(McpConnectionHandlerTest, ProviderGone) {
+  handler_ = std::make_unique<McpConnectionHandler>(
+      nullptr, ToolApprovalCallback(),
+      base::BindLambdaForTesting([&](base::DictValue message) {
+        written_.push_back(std::move(message));
+      }));
+  Handle(
+      R"({"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"rac_echo","arguments":{"text":"x"}}})");
+  ASSERT_EQ(written_.size(), 1u);
+  EXPECT_TRUE(written_[0].FindDict("error"));
+}
+
+// After a run ends the server detaches its handlers. A detached handler must
+// never reach the provider again, which may already be gone.
+TEST_F(McpConnectionHandlerTest, DetachedHandlerNeverReachesProvider) {
+  handler_->Detach();
+  Handle(R"({"jsonrpc":"2.0","id":1,"method":"tools/list"})");
+  ASSERT_EQ(written_.size(), 1u);
+  const base::ListValue* tools =
+      written_[0].FindDict("result")->FindList("tools");
+  ASSERT_TRUE(tools);
+  EXPECT_TRUE(tools->empty());
+  Handle(
+      R"({"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"rac_echo","arguments":{"text":"x"}}})");
+  ASSERT_EQ(written_.size(), 2u);
+  EXPECT_TRUE(written_[1].FindDict("error"));
+}

+#ifndef CHROME_BROWSER_RAC_AGENT_MCP_SERVER_H_
+#define CHROME_BROWSER_RAC_AGENT_MCP_SERVER_H_
+
+#include <map>
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "chrome/browser/rac/agent/mcp_protocol.h"
+#include "chrome/browser/rac/agent/mcp_tool_provider.h"
+
+namespace rac::agent {
+
+// In-browser MCP server. Listens on a Unix domain socket under a fresh 0700
+// directory in the profile. Security for the nc bridge:
+//   1. Unpredictable directory name (session capability / token).
+//   2. Directory mode 0700, socket mode 0600.
+//   3. Accept only same-UID peers (getpeereid).
+// nc cannot attach headers or initialize secrets, so no clientInfo token is
+// required (see acp-design.md "MCP nc bridge and session identity").
+class McpServer {
+ public:
+  using StartCallback = base::OnceCallback<void(bool ok)>;
+
+  // `provider` is non-owning. It must outlive the server, or be cleared with
+  // ClearProvider (or Stop) first; after either, nothing reaches it again.
+  McpServer(base::FilePath profile_path,
+            scoped_refptr<base::SequencedTaskRunner> io_runner,
+            scoped_refptr<base::SequencedTaskRunner> ui_runner,
+            McpToolProvider* provider);
+  McpServer(const McpServer&) = delete;
+  McpServer& operator=(const McpServer&) = delete;
+  ~McpServer();
+
+  void SetApprovalCallback(ToolApprovalCallback approval);
+  // Tool calls get an error from now on. Safe to call from inside a call.
+  void ClearProvider();
+
+  // Creates the socket directory on the IO sequence and begins listening.
+  // Invokes `done` on the UI sequence with the result. Never blocks the UI
+  // thread.
+  void Start(StartCallback done);
+  // Closes the listen socket and drops connections on the IO sequence, then
+  // deletes the socket directory on a MayBlock task. Never waits on the UI
+  // thread.
+  void Stop();
+
+  bool running() const { return running_; }
+  const base::FilePath& socket_path() const { return socket_path_; }
+  const base::FilePath& socket_dir() const { return socket_dir_; }
+
+  // ACP session/new mcpServers entry:
+  // {"name":"rac","command":"/usr/bin/nc","args":["-U",socket],"env":[]}
+  base::DictValue MakeAcpMcpServerEntry() const;
+  static base::DictValue MakeAcpMcpServerEntry(const base::FilePath& socket);
+
+  base::WeakPtr<McpServer> GetWeakPtr();
+
+ private:
+  class IoState;
+
+  void OnIoStartComplete(StartCallback done,
+                         base::FilePath dir,
+                         base::FilePath socket,
+                         bool ok);
+  void OnConnectionOpened(int connection_id);
+  void OnConnectionClosed(int connection_id);
+  void DispatchOnUi(int connection_id, base::DictValue message);
+  void WriteToConnection(int connection_id, base::DictValue message);
+  void CloseConnection(int connection_id);
+  // Detaches every handler and deletes them later, since one may be on the
+  // stack.
+  void DropHandlers();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  base::FilePath profile_path_;
+  scoped_refptr<base::SequencedTaskRunner> io_runner_;
+  scoped_refptr<base::SequencedTaskRunner> ui_runner_;
+  raw_ptr<McpToolProvider> provider_;
+  ToolApprovalCallback approval_;
+
+  base::FilePath socket_dir_;
+  base::FilePath socket_path_;
+  // Deleted on `io_runner_`.
+  std::unique_ptr<IoState> io_state_;
+  std::map<int, std::unique_ptr<McpConnectionHandler>> ui_handlers_;
+  bool running_ = false;
+  bool starting_ = false;
+
+  base::WeakPtrFactory<McpServer> weak_factory_{this};
+};
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_MCP_SERVER_H_

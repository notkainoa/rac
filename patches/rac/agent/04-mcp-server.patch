+base::DictValue ReadJsonLine(int fd) {
+  std::string line;
+  char ch = 0;
+  while (HANDLE_EINTR(read(fd, &ch, 1)) == 1) {
+    if (ch == '\n') {
+      break;
+    }
+    line.push_back(ch);
+    if (line.size() > 1024 * 1024) {
+      break;
+    }
+  }
+  auto parsed = base::JSONReader::Read(line, base::JSON_PARSE_RFC);
+  CHECK(parsed) << line;
+  CHECK(parsed->is_dict());
+  return std::move(*parsed).TakeDict();
+}
+
+void WriteJsonLine(int fd, const base::DictValue& message) {
+  std::string line;
+  CHECK(base::JSONWriter::Write(message, &line));
+  line.push_back('\n');
+  ASSERT_EQ(HANDLE_EINTR(write(fd, line.data(), line.size())),
+            static_cast<ssize_t>(line.size()));
+}
+
+// Whether anything still listens at `path`.
+bool CanConnect(const base::FilePath& path) {
+  base::ScopedFD fd(HANDLE_EINTR(socket(AF_UNIX, SOCK_STREAM, 0)));
+  sockaddr_un addr = {};
+  addr.sun_family = AF_UNIX;
+  if (!fd.is_valid() || path.value().size() >= sizeof(addr.sun_path)) {
+    return false;
+  }
+  std::memcpy(addr.sun_path, path.value().data(), path.value().size());
+  return HANDLE_EINTR(connect(fd.get(), reinterpret_cast<sockaddr*>(&addr),
+                              sizeof(addr))) == 0;
+}
+
+base::ScopedFD ConnectUnix(const base::FilePath& path) {
+  base::ScopedFD fd(HANDLE_EINTR(socket(AF_UNIX, SOCK_STREAM, 0)));
+  EXPECT_TRUE(fd.is_valid());
+  if (!fd.is_valid()) {
+    return fd;
+  }
+  sockaddr_un addr = {};
+  addr.sun_family = AF_UNIX;
+  EXPECT_LT(path.value().size(), sizeof(addr.sun_path));
+  if (path.value().size() >= sizeof(addr.sun_path)) {
+    return base::ScopedFD();
+  }
+  std::memcpy(addr.sun_path, path.value().data(), path.value().size());
+  EXPECT_EQ(HANDLE_EINTR(connect(fd.get(), reinterpret_cast<sockaddr*>(&addr),
+                                 sizeof(addr))),
+            0);
+  return fd;
+}
+
+class McpServerTest : public testing::Test {
+ public:
+  McpServerTest() {
+    CHECK(temp_.CreateUniqueTempDir());
+    io_thread_ = std::make_unique<base::Thread>("RacMcpTestIo");
+    base::Thread::Options options;
+    options.message_pump_type = base::MessagePumpType::IO;
+    CHECK(io_thread_->StartWithOptions(std::move(options)));
+  }
+
+  ~McpServerTest() override {
+    server_.reset();
+    if (io_thread_) {
+      io_thread_->Stop();
+    }
+  }
+
+  void StartServer() {
+    server_ = std::make_unique<McpServer>(
+        temp_.GetPath(), io_thread_->task_runner(),
+        base::SequencedTaskRunner::GetCurrentDefault(), &provider_);
+    base::RunLoop loop;
+    bool ok = false;
+    server_->Start(base::BindLambdaForTesting([&](bool success) {
+      ok = success;
+      loop.Quit();
+    }));
+    loop.Run();
+    ASSERT_TRUE(ok);
+    ASSERT_TRUE(server_->running());
+  }
+
+  void StopServerAndFlush() {
+    if (!server_) {
+      return;
+    }
+    server_->Stop();
+    env_.RunUntilIdle();
+    // Directory deletion is posted to the thread pool.
+    base::RunLoop flush;
+    base::ThreadPool::PostTaskAndReply(FROM_HERE, {base::MayBlock()},
+                                       base::DoNothing(), flush.QuitClosure());
+    flush.Run();
+    env_.RunUntilIdle();
+  }
+
+  // Sends `message` and pumps both threads until the reply line arrives.
+  base::DictValue Call(int fd, const base::DictValue& message) {
+    WriteJsonLine(fd, message);
+    for (int i = 0; i < 300; ++i) {
+      env_.RunUntilIdle();
+      fd_set fds;
+      FD_ZERO(&fds);
+      FD_SET(fd, &fds);
+      timeval wait{.tv_sec = 0, .tv_usec = 10000};
+      if (select(fd + 1, &fds, nullptr, nullptr, &wait) > 0) {
+        return ReadJsonLine(fd);
+      }
+    }
+    ADD_FAILURE() << "no reply";
+    return base::DictValue();
+  }
+
+  base::test::TaskEnvironment env_{
+      base::test::TaskEnvironment::MainThreadType::IO};
+  base::ScopedTempDir temp_;
+  std::unique_ptr<base::Thread> io_thread_;
+  EchoMcpToolProvider provider_;
+  std::unique_ptr<McpServer> server_;
+};
+
+TEST_F(McpServerTest, SocketDirIs0700AndRemovedOnStop) {
+  StartServer();
+  const base::FilePath dir = server_->socket_dir();
+  const base::FilePath sock = server_->socket_path();
+  ASSERT_TRUE(base::DirectoryExists(dir));
+  ASSERT_TRUE(base::PathExists(sock));
+
+  struct stat st = {};
+  ASSERT_EQ(stat(dir.value().c_str(), &st), 0);
+  EXPECT_EQ(st.st_mode & 0777, static_cast<mode_t>(0700));
+
+  StopServerAndFlush();
+  EXPECT_FALSE(server_->running());
+  EXPECT_FALSE(base::PathExists(dir));
+  EXPECT_FALSE(base::PathExists(sock));
+}
+
+TEST_F(McpServerTest, NcClientInitializeAndToolsList) {
+  StartServer();
+  base::ScopedFD client = ConnectUnix(server_->socket_path());
+
+  WriteJsonLine(
+      client.get(),
+      base::DictValue()
+          .Set("jsonrpc", "2.0")
+          .Set("id", 1)
+          .Set("method", "initialize")
+          .Set("params", base::DictValue()
+                             .Set("protocolVersion", "2025-06-18")
+                             .Set("capabilities", base::DictValue())
+                             .Set("clientInfo", base::DictValue()
+                                                    .Set("name", "test")
+                                                    .Set("version", "1"))));
+  // Allow IO ↔ UI hops.
+  base::RunLoop().RunUntilIdle();
+  for (int i = 0; i < 50 && !base::PathExists(server_->socket_path()); ++i) {
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // Pump until a response arrives (read is blocking; run loop on side).
+  // Use a short non-blocking poll via RunUntilIdle between attempts.
+  base::DictValue init_reply;
+  {
+    // Make the read non-blocking wait with task environment.
+    fd_set fds;
+    FD_ZERO(&fds);
+    FD_SET(client.get(), &fds);
+    // Process posted UI tasks while waiting.
+    for (int i = 0; i < 200; ++i) {
+      env_.RunUntilIdle();
+      fd_set trial = fds;
+      timeval zero{.tv_sec = 0, .tv_usec = 10000};
+      if (select(client.get() + 1, &trial, nullptr, nullptr, &zero) > 0) {
+        init_reply = ReadJsonLine(client.get());
+        break;
+      }
+    }
+  }
+  ASSERT_TRUE(init_reply.FindDict("result"));
+  EXPECT_EQ(*init_reply.FindDict("result")->FindString("protocolVersion"),
+            "2025-06-18");
+
+  WriteJsonLine(client.get(), base::DictValue()
+                                  .Set("jsonrpc", "2.0")
+                                  .Set("id", 2)
+                                  .Set("method", "tools/list"));
+  base::DictValue list_reply;
+  for (int i = 0; i < 200; ++i) {
+    env_.RunUntilIdle();
+    fd_set fds;
+    FD_ZERO(&fds);
+    FD_SET(client.get(), &fds);
+    timeval zero{.tv_sec = 0, .tv_usec = 10000};
+    if (select(client.get() + 1, &fds, nullptr, nullptr, &zero) > 0) {
+      list_reply = ReadJsonLine(client.get());
+      break;
+    }
+  }
+  ASSERT_TRUE(list_reply.FindDict("result"));
+  const base::ListValue* tools =
+      list_reply.FindDict("result")->FindList("tools");
+  ASSERT_TRUE(tools);
+  ASSERT_EQ(tools->size(), 1u);
+  EXPECT_EQ(*(*tools)[0].GetDict().FindString("name"), "rac_echo");
+
+  WriteJsonLine(
+      client.get(),
+      base::DictValue()
+          .Set("jsonrpc", "2.0")
+          .Set("id", 3)
+          .Set("method", "tools/call")
+          .Set("params", base::DictValue()
+                             .Set("name", "rac_echo")
+                             .Set("arguments",
+                                  base::DictValue().Set("text", "socket-ok"))));
+  base::DictValue call_reply;
+  for (int i = 0; i < 200; ++i) {
+    env_.RunUntilIdle();
+    fd_set fds;
+    FD_ZERO(&fds);
+    FD_SET(client.get(), &fds);
+    timeval zero{.tv_sec = 0, .tv_usec = 10000};
+    if (select(client.get() + 1, &fds, nullptr, nullptr, &zero) > 0) {
+      call_reply = ReadJsonLine(client.get());
+      break;
+    }
+  }
+  ASSERT_TRUE(call_reply.FindDict("result"));
+  EXPECT_EQ(*(*call_reply.FindDict("result")->FindList("content"))[0]
+                 .GetDict()
+                 .FindString("text"),
+            "socket-ok");
+
+  // Tear down before the client FD closes to avoid a racing EOF during fixture
+  // destruction under the parallel test launcher.
+  StopServerAndFlush();
+}
+
+// The provider belongs to one run. Once the run ends the server must not
+// reach it through a connection that is still open, and once the server
+// stops nothing listens at the socket.
+TEST_F(McpServerTest, ClearedProviderIsNeverReachedAndStopCloses) {
+  StartServer();
+  const base::FilePath sock = server_->socket_path();
+  base::ScopedFD client = ConnectUnix(sock);
+  base::DictValue list = base::DictValue()
+                             .Set("jsonrpc", "2.0")
+                             .Set("id", 1)
+                             .Set("method", "tools/list");
+  base::DictValue reply = Call(client.get(), list);
+  ASSERT_TRUE(reply.FindDict("result"));
+  EXPECT_EQ(reply.FindDict("result")->FindList("tools")->size(), 1u);
+
+  server_->ClearProvider();
+  list.Set("id", 2);
+  reply = Call(client.get(), list);
+  ASSERT_TRUE(reply.FindDict("result"));
+  EXPECT_TRUE(reply.FindDict("result")->FindList("tools")->empty());
+  reply = Call(client.get(),
+               base::DictValue()
+                   .Set("jsonrpc", "2.0")
+                   .Set("id", 3)
+                   .Set("method", "tools/call")
+                   .Set("params", base::DictValue()
+                                      .Set("name", "rac_echo")
+                                      .Set("arguments", base::DictValue())));
+  EXPECT_TRUE(reply.FindDict("error"));
+
+  StopServerAndFlush();
+  EXPECT_FALSE(CanConnect(sock));
+}
+
+TEST(McpServerEntryTest, MatchesAcpShape) {
+  base::DictValue entry =
+      McpServer::MakeAcpMcpServerEntry(base::FilePath("/tmp/rac.sock"));
+  EXPECT_EQ(*entry.FindString("name"), "rac");
+  EXPECT_EQ(*entry.FindString("command"), "/usr/bin/nc");
+  const base::ListValue* args = entry.FindList("args");
+  ASSERT_TRUE(args);
+  ASSERT_EQ(args->size(), 2u);
+  EXPECT_EQ((*args)[0].GetString(), "-U");
+  EXPECT_EQ((*args)[1].GetString(), "/tmp/rac.sock");
+  EXPECT_TRUE(entry.FindList("env"));
+}
+

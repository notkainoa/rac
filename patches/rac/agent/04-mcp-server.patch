+constexpr size_t kReadChunk = 64 * 1024;
+// Darwin AF_UNIX sun_path is 104 bytes including NUL.
+constexpr size_t kMaxUnixPathBytes = 103;
+
+bool PeerUidIsSelf(int fd) {
+  uid_t peer_uid = 0;
+  gid_t peer_gid = 0;
+  if (getpeereid(fd, &peer_uid, &peer_gid) != 0) {
+    return false;
+  }
+  return peer_uid == geteuid();
+}
+
+bool PathFitsUnix(const base::FilePath& path) {
+  return path.value().size() <= kMaxUnixPathBytes;
+}
+
+// POSIX mkdir avoids base::CreateDirectory's blocking annotation so this can
+// run on the dedicated IO sequence without ScopedAllowBlocking friendship.
+bool MkDir0700(const base::FilePath& path) {
+  if (::mkdir(path.value().c_str(), 0700) == 0) {
+    return true;
+  }
+  if (errno != EEXIST) {
+    return false;
+  }
+  return chmod(path.value().c_str(), 0700) == 0 && base::DirectoryExists(path);
+}
+
+std::string RandomTokenHex() {
+  return base::HexEncode(base::as_byte_span(base::RandBytesAsVector(8)));
+}
+
+bool SetNonBlocking(int fd) {
+  const int flags = fcntl(fd, F_GETFL);
+  if (flags == -1) {
+    return false;
+  }
+  return fcntl(fd, F_SETFL, flags | O_NONBLOCK) != -1;
+}
+
+base::ScopedFD OpenListenSocket(const base::FilePath& path) {
+  if (!PathFitsUnix(path)) {
+    LOG(ERROR) << "rac MCP socket path too long for AF_UNIX: " << path;
+    return base::ScopedFD();
+  }
+  base::ScopedFD fd(HANDLE_EINTR(socket(AF_UNIX, SOCK_STREAM, 0)));
+  if (!fd.is_valid()) {
+    PLOG(ERROR) << "rac MCP socket()";
+    return base::ScopedFD();
+  }
+#if BUILDFLAG(IS_MAC)
+  int yes = 1;
+  setsockopt(fd.get(), SOL_SOCKET, SO_NOSIGPIPE, &yes, sizeof(yes));
+#endif
+  if (!SetNonBlocking(fd.get())) {
+    PLOG(ERROR) << "rac MCP fcntl(O_NONBLOCK)";
+    return base::ScopedFD();
+  }
+
+  sockaddr_un addr = {};
+  addr.sun_family = AF_UNIX;
+  const std::string& value = path.value();
+  if (value.size() >= sizeof(addr.sun_path)) {
+    return base::ScopedFD();
+  }
+  std::memcpy(addr.sun_path, value.data(), value.size());
+  if (HANDLE_EINTR(bind(fd.get(), reinterpret_cast<sockaddr*>(&addr),
+                        sizeof(addr))) != 0) {
+    PLOG(ERROR) << "rac MCP bind()";
+    return base::ScopedFD();
+  }
+  if (chmod(value.c_str(), 0600) != 0) {
+    PLOG(ERROR) << "rac MCP chmod(socket)";
+    return base::ScopedFD();
+  }
+  if (HANDLE_EINTR(listen(fd.get(), 4)) != 0) {
+    PLOG(ERROR) << "rac MCP listen()";
+    return base::ScopedFD();
+  }
+  return fd;
+}
+
+// A directory another server may still be using: one this user doesn't own,
+// one that changed in the last minute (a server may be about to bind in it),
+// or one whose socket still accepts connections (another rac instance, or
+// another profile in this one).
+bool MayBeLive(const base::FilePath& dir) {
+  struct stat st = {};
+  if (stat(dir.value().c_str(), &st) != 0 || !S_ISDIR(st.st_mode) ||
+      st.st_uid != geteuid()) {
+    return true;
+  }
+  if (time(nullptr) - st.st_mtime < 60) {
+    return true;
+  }
+  const std::string path = dir.AppendASCII("s").value();
+  sockaddr_un addr = {};
+  addr.sun_family = AF_UNIX;
+  if (path.size() >= sizeof(addr.sun_path)) {
+    return false;
+  }
+  std::memcpy(addr.sun_path, path.data(), path.size());
+  base::ScopedFD fd(HANDLE_EINTR(socket(AF_UNIX, SOCK_STREAM, 0)));
+  if (!fd.is_valid() || !SetNonBlocking(fd.get())) {
+    return true;
+  }
+  if (HANDLE_EINTR(connect(fd.get(), reinterpret_cast<sockaddr*>(&addr),
+                           sizeof(addr))) == 0) {
+    return true;
+  }
+  return errno == EINPROGRESS || errno == EAGAIN;
+}
+
+// Runs on the IO sequence before every listen, so it can never race this
+// server's own directory.
+void DeleteStaleMcpDirs(const base::FilePath& profile_path) {
+  const base::FilePath profile_root = profile_path.AppendASCII("rac-agent-mcp");
+  if (base::DirectoryExists(profile_root)) {
+    base::FileEnumerator entries(profile_root, /*recursive=*/false,
+                                 base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath child = entries.Next(); !child.empty();
+         child = entries.Next()) {
+      if (!MayBeLive(child)) {
+        base::DeletePathRecursively(child);
+      }
+    }
+  }
+
+  const std::string tmp_prefix =
+      "rac-mcp-" + base::NumberToString(static_cast<int>(geteuid())) + "-";
+  base::FileEnumerator tmp_entries(base::FilePath("/tmp"), /*recursive=*/false,
+                                   base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath child = tmp_entries.Next(); !child.empty();
+       child = tmp_entries.Next()) {
+    if (base::StartsWith(child.BaseName().value(), tmp_prefix) &&
+        !MayBeLive(child)) {
+      base::DeletePathRecursively(child);
+    }
+  }
+}

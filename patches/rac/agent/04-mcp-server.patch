--- /dev/null
+++ src/chrome/browser/rac/agent/mcp_protocol.cc
@@ -0,0 +1,286 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/mcp_protocol.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+
+namespace rac::agent {
+namespace {
+
+bool ValidId(const base::Value& id) {
+  return id.is_int() || id.is_string() || id.is_none();
+}
+
+bool IsSupportedProtocolVersion(std::string_view version) {
+  return version == "2024-11-05" || version == "2025-03-26" ||
+         version == "2025-06-18" || version == "2025-11-25";
+}
+
+std::optional<McpToolSpec> FindTool(McpToolProvider* provider,
+                                    std::string_view name) {
+  if (!provider) {
+    return std::nullopt;
+  }
+  for (McpToolSpec& tool : provider->ListTools()) {
+    if (tool.name == name) {
+      return std::move(tool);
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+bool McpFramer::Feed(std::string_view bytes,
+                     std::vector<base::DictValue>& frames) {
+  if (failed_) {
+    return false;
+  }
+  while (!bytes.empty()) {
+    const size_t end = bytes.find('\n');
+    const size_t count = end == std::string_view::npos ? bytes.size() : end;
+    if (buffer_.size() + count > kMcpMaxFrameBytes) {
+      failed_ = true;
+      return false;
+    }
+    buffer_.append(bytes.substr(0, count));
+    bytes.remove_prefix(count);
+    if (end == std::string_view::npos) {
+      break;
+    }
+    bytes.remove_prefix(1);
+    if (!buffer_.empty() && buffer_.back() == '\r') {
+      buffer_.pop_back();
+    }
+    if (buffer_.empty()) {
+      continue;
+    }
+    if (!base::IsStringUTF8(buffer_)) {
+      failed_ = true;
+      return false;
+    }
+    auto parsed = base::JSONReader::ReadAndReturnValueWithError(
+        buffer_, base::JSON_PARSE_RFC);
+    if (!parsed.has_value() || !parsed->is_dict()) {
+      failed_ = true;
+      return false;
+    }
+    auto dict = std::move(*parsed).TakeDict();
+    const std::string* version = dict.FindString("jsonrpc");
+    const base::Value* id = dict.Find("id");
+    const base::Value* method = dict.Find("method");
+    const bool response = dict.contains("result") != dict.contains("error");
+    if (!version || *version != "2.0" || (id && !ValidId(*id)) ||
+        (method && (!method->is_string() || method->GetString().empty() ||
+                    dict.contains("result") || dict.contains("error"))) ||
+        (!method && (!id || !response))) {
+      failed_ = true;
+      return false;
+    }
+    frames.push_back(std::move(dict));
+    buffer_.clear();
+  }
+  return true;
+}
+
+bool McpFramer::Finish() {
+  failed_ = failed_ || !buffer_.empty();
+  return !failed_;
+}
+
+base::DictValue MakeMcpResult(base::Value id, base::DictValue result) {
+  return base::DictValue()
+      .Set("jsonrpc", "2.0")
+      .Set("id", std::move(id))
+      .Set("result", std::move(result));
+}
+
+base::DictValue MakeMcpError(base::Value id, int code, std::string message) {
+  return base::DictValue()
+      .Set("jsonrpc", "2.0")
+      .Set("id", std::move(id))
+      .Set("error", base::DictValue()
+                        .Set("code", code)
+                        .Set("message", std::move(message)));
+}
+
+base::DictValue McpToolSpecToDict(const McpToolSpec& spec) {
+  base::DictValue tool;
+  tool.Set("name", spec.name);
+  tool.Set("description", spec.description);
+  tool.Set("inputSchema", spec.input_schema.Clone());
+  if (spec.read_only) {
+    tool.Set("annotations", base::DictValue().Set("readOnlyHint", true));
+  }
+  return tool;
+}
+
+base::DictValue McpToolResultToDict(const McpToolResult& result) {
+  return base::DictValue()
+      .Set("content", result.content.Clone())
+      .Set("isError", result.is_error);
+}
+
+McpConnectionHandler::McpConnectionHandler(McpToolProvider* provider,
+                                           ToolApprovalCallback approval,
+                                           Write write)
+    : provider_(provider),
+      approval_(std::move(approval)),
+      write_(std::move(write)) {}
+
+McpConnectionHandler::~McpConnectionHandler() = default;
+
+void McpConnectionHandler::Detach() {
+  provider_ = nullptr;
+  approval_.Reset();
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+bool McpConnectionHandler::Handle(base::DictValue message) {
+  const base::Value* id = message.Find("id");
+  const std::string* method = message.FindString("method");
+  if (!method) {
+    // Ignore stray responses; clients should not send them.
+    return true;
+  }
+  if (!id) {
+    // notifications/initialized and other notifications: acknowledge silently.
+    return true;
+  }
+
+  const base::DictValue* params = message.FindDict("params");
+  base::Value id_value = id->Clone();
+
+  if (*method == "initialize") {
+    std::string requested = kMcpDefaultProtocolVersion;
+    if (params) {
+      if (const std::string* version = params->FindString("protocolVersion")) {
+        if (IsSupportedProtocolVersion(*version)) {
+          requested = *version;
+        }
+      }
+    }
+    protocol_version_ = requested;
+    write_.Run(MakeMcpResult(
+        std::move(id_value),
+        base::DictValue()
+            .Set("protocolVersion", protocol_version_)
+            .Set("capabilities",
+                 base::DictValue().Set("tools", base::DictValue()))
+            .Set("serverInfo",
+                 base::DictValue().Set("name", "rac").Set("version", "0.1"))));
+    return true;
+  }
+
+  if (*method == "ping") {
+    write_.Run(MakeMcpResult(std::move(id_value), base::DictValue()));
+    return true;
+  }
+
+  if (*method == "resources/list" || *method == "resources/templates/list" ||
+      *method == "prompts/list") {
+    const char* key = *method == "resources/list" ? "resources"
+                      : *method == "resources/templates/list"
+                          ? "resourceTemplates"
+                          : "prompts";
+    write_.Run(MakeMcpResult(std::move(id_value),
+                             base::DictValue().Set(key, base::ListValue())));
+    return true;
+  }
+
+  if (*method == "tools/list") {
+    base::ListValue tools;
+    if (provider_) {
+      for (const McpToolSpec& spec : provider_->ListTools()) {
+        tools.Append(McpToolSpecToDict(spec));
+      }
+    }
+    write_.Run(MakeMcpResult(std::move(id_value),
+                             base::DictValue().Set("tools", std::move(tools))));
+    return true;
+  }
+
+  if (*method == "tools/call") {
+    if (!provider_) {
+      write_.Run(MakeMcpError(std::move(id_value), -32000,
+                              "Tool provider is unavailable."));
+      return true;
+    }
+    if (!params) {
+      write_.Run(MakeMcpError(std::move(id_value), -32602, "Invalid params"));
+      return true;
+    }
+    const std::string* name = params->FindString("name");
+    if (!name || name->empty()) {
+      write_.Run(MakeMcpError(std::move(id_value), -32602, "Invalid params"));
+      return true;
+    }
+    base::DictValue args;
+    if (const base::DictValue* arguments = params->FindDict("arguments")) {
+      args = arguments->Clone();
+    }
+    std::optional<McpToolSpec> spec = FindTool(provider_, *name);
+    if (!spec) {
+      write_.Run(
+          MakeMcpError(std::move(id_value), -32602, "Unknown tool: " + *name));
+      return true;
+    }
+    if (spec->read_only || !approval_) {
+      RunTool(std::move(id_value), *name, std::move(args));
+      return true;
+    }
+    McpToolCallInfo info;
+    info.name = *name;
+    info.arguments = args.Clone();
+    info.read_only = spec->read_only;
+    approval_.Run(
+        info, base::BindOnce(&McpConnectionHandler::AfterApproval,
+                             weak_factory_.GetWeakPtr(), std::move(id_value),
+                             *name, std::move(args)));
+    return true;
+  }
+
+  write_.Run(MakeMcpError(std::move(id_value), -32601, "Method not found"));
+  return true;
+}
+
+void McpConnectionHandler::AfterApproval(base::Value id,
+                                         std::string name,
+                                         base::DictValue args,
+                                         bool allow) {
+  if (!allow) {
+    McpToolResult denied;
+    denied.is_error = true;
+    denied.content.Append(
+        base::DictValue().Set("type", "text").Set("text", "Tool call denied."));
+    OnToolDone(std::move(id), std::move(denied));
+    return;
+  }
+  RunTool(std::move(id), std::move(name), std::move(args));
+}
+
+void McpConnectionHandler::RunTool(base::Value id,
+                                   std::string name,
+                                   base::DictValue args) {
+  if (!provider_) {
+    write_.Run(
+        MakeMcpError(std::move(id), -32000, "Tool provider is unavailable."));
+    return;
+  }
+  provider_->CallTool(
+      name, std::move(args),
+      base::BindOnce(&McpConnectionHandler::OnToolDone,
+                     weak_factory_.GetWeakPtr(), std::move(id)));
+}
+
+void McpConnectionHandler::OnToolDone(base::Value id, McpToolResult result) {
+  write_.Run(MakeMcpResult(std::move(id), McpToolResultToDict(result)));
+}
+
+}  // namespace rac::agent

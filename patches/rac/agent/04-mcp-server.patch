+
+void AcpService::OnMcpServerStarted(DoneCallback ready,
+                                    PreparedLaunch prepared,
+                                    Session* launched,
+                                    std::unique_ptr<rac::agent::McpServer> mcp,
+                                    bool ok) {
+  if (shutting_down_ || !session_ || session_.get() != launched ||
+      !IsAiEnabled(prefs_)) {
+    if (mcp) {

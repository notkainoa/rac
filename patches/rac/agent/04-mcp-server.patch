+class McpServer::IoState {
+ public:
+  using OpenedCb = base::RepeatingCallback<void(int)>;
+  using ClosedCb = base::RepeatingCallback<void(int)>;
+  using MessageCb = base::RepeatingCallback<void(int, base::DictValue)>;
+
+  class Connection {
+   public:
+    Connection(int id, base::ScopedFD fd, IoState* owner, MessageCb on_message)
+        : id_(id),
+          fd_(std::move(fd)),
+          owner_(owner),
+          on_message_(std::move(on_message)) {
+      read_watcher_ = base::FileDescriptorWatcher::WatchReadable(
+          fd_.get(),
+          base::BindRepeating(&Connection::OnReadable, base::Unretained(this)));
+    }
+
+    ~Connection() {
+      read_watcher_.reset();
+      write_watcher_.reset();
+    }
+
+    void EnqueueWrite(base::DictValue message) {
+      std::string line;
+      if (!base::JSONWriter::Write(message, &line)) {
+        RequestClose();
+        return;
+      }
+      line.push_back('\n');
+      if (line.size() > kMcpMaxFrameBytes) {
+        RequestClose();
+        return;
+      }
+      write_queue_.append(std::move(line));
+      PumpWrite();
+    }
+
+   private:
+    void OnReadable() {
+      char buffer[kReadChunk];
+      const ssize_t n = HANDLE_EINTR(read(fd_.get(), buffer, sizeof(buffer)));
+      if (n == 0) {
+        RequestClose();
+        return;
+      }
+      if (n < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+          return;
+        }
+        RequestClose();
+        return;
+      }
+      std::vector<base::DictValue> frames;
+      if (!framer_.Feed(std::string_view(buffer, static_cast<size_t>(n)),
+                        frames)) {
+        RequestClose();
+        return;
+      }
+      for (base::DictValue& frame : frames) {
+        on_message_.Run(id_, std::move(frame));
+      }
+    }
+
+    void PumpWrite() {
+      while (!write_queue_.empty()) {
+        const ssize_t n = HANDLE_EINTR(
+            write(fd_.get(), write_queue_.data(), write_queue_.size()));
+        if (n > 0) {
+          write_queue_.erase(0, static_cast<size_t>(n));
+          continue;
+        }
+        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+          if (!write_watcher_) {
+            write_watcher_ = base::FileDescriptorWatcher::WatchWritable(
+                fd_.get(), base::BindRepeating(&Connection::PumpWrite,
+                                               base::Unretained(this)));
+          }
+          return;
+        }
+        RequestClose();
+        return;
+      }
+      write_watcher_.reset();
+    }
+
+    void RequestClose() {
+      if (closing_) {
+        return;
+      }
+      closing_ = true;
+      // The server may delete the IoState before this task runs.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&IoState::DropConnection, owner_->GetWeakPtr(), id_));
+    }
+
+    const int id_;
+    base::ScopedFD fd_;
+    raw_ptr<IoState> owner_;
+    MessageCb on_message_;
+    McpFramer framer_;
+    std::string write_queue_;
+    std::unique_ptr<base::FileDescriptorWatcher::Controller> read_watcher_;
+    std::unique_ptr<base::FileDescriptorWatcher::Controller> write_watcher_;
+    bool closing_ = false;
+  };
+
+  IoState(OpenedCb on_opened, ClosedCb on_closed, MessageCb on_message)
+      : on_opened_(std::move(on_opened)),
+        on_closed_(std::move(on_closed)),
+        on_message_(std::move(on_message)) {
+    DETACH_FROM_SEQUENCE(sequence_checker_);
+  }
+
+  ~IoState() { DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_); }
+
+  base::WeakPtr<IoState> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+
+  bool StartListen(const base::FilePath& profile_path,
+                   const base::FilePath& dir,
+                   const base::FilePath& socket,
+                   bool use_profile_root) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    DeleteStaleMcpDirs(profile_path);
+    if (use_profile_root) {
+      const base::FilePath root = profile_path.AppendASCII("rac-agent-mcp");
+      if (!MkDir0700(root)) {
+        PLOG(ERROR) << "rac MCP mkdir(root)";
+        return false;
+      }
+    }
+    if (base::DirectoryExists(dir) || !MkDir0700(dir)) {
+      PLOG(ERROR) << "rac MCP mkdir(session)";
+      return false;
+    }
+    listen_fd_ = OpenListenSocket(socket);
+    if (!listen_fd_.is_valid()) {
+      unlink(socket.value().c_str());
+      rmdir(dir.value().c_str());
+      return false;
+    }
+    accept_watcher_ = base::FileDescriptorWatcher::WatchReadable(
+        listen_fd_.get(),
+        base::BindRepeating(&IoState::OnAcceptable, base::Unretained(this)));
+    return true;
+  }
+
+  void Stop() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    accept_watcher_.reset();
+    connections_.clear();
+    listen_fd_.reset();
+  }
+
+  void AcceptOne() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (!listen_fd_.is_valid()) {
+      return;
+    }
+    base::ScopedFD client(
+        HANDLE_EINTR(accept(listen_fd_.get(), nullptr, nullptr)));
+    if (!client.is_valid()) {
+      return;
+    }
+    if (!SetNonBlocking(client.get())) {
+      return;
+    }
+#if BUILDFLAG(IS_MAC)
+    int yes = 1;
+    setsockopt(client.get(), SOL_SOCKET, SO_NOSIGPIPE, &yes, sizeof(yes));
+#endif
+    if (!PeerUidIsSelf(client.get())) {
+      VLOG(1) << "rac MCP rejected peer with mismatched uid";
+      return;
+    }
+    const int id = next_id_++;
+    connections_.emplace(id, std::make_unique<Connection>(id, std::move(client),
+                                                          this, on_message_));
+    on_opened_.Run(id);
+  }
+
+  void DropConnection(int id) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (connections_.erase(id)) {
+      on_closed_.Run(id);
+    }
+  }
+
+  void WriteMessage(int id, base::DictValue message) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    auto it = connections_.find(id);
+    if (it != connections_.end()) {
+      it->second->EnqueueWrite(std::move(message));
+    }
+  }
+
+ private:
+  void OnAcceptable() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    AcceptOne();
+  }
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  OpenedCb on_opened_;
+  ClosedCb on_closed_;
+  MessageCb on_message_;
+  base::ScopedFD listen_fd_;
+  std::unique_ptr<base::FileDescriptorWatcher::Controller> accept_watcher_;
+  std::map<int, std::unique_ptr<Connection>> connections_;
+  int next_id_ = 1;
+  base::WeakPtrFactory<IoState> weak_factory_{this};
+};
+
+McpServer::McpServer(base::FilePath profile_path,
+                     scoped_refptr<base::SequencedTaskRunner> io_runner,
+                     scoped_refptr<base::SequencedTaskRunner> ui_runner,
+                     McpToolProvider* provider)
+    : profile_path_(std::move(profile_path)),
+      io_runner_(std::move(io_runner)),
+      ui_runner_(std::move(ui_runner)),
+      provider_(provider) {
+  DCHECK(io_runner_);
+  DCHECK(ui_runner_);
+}
+
+McpServer::~McpServer() {
+  Stop();
+}
+
+void McpServer::SetApprovalCallback(ToolApprovalCallback approval) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  approval_ = std::move(approval);
+}
+
+void McpServer::ClearProvider() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  provider_ = nullptr;
+  DropHandlers();
+}
+
+void McpServer::DropHandlers() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (ui_handlers_.empty()) {
+    return;
+  }
+  for (auto& [id, handler] : ui_handlers_) {
+    handler->Detach();
+  }
+  ui_runner_->PostTask(
+      FROM_HERE,
+      base::DoNothingWithBoundArgs(std::exchange(ui_handlers_, {})));
+}
+
+void McpServer::Start(StartCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (running_ || starting_) {
+    std::move(done).Run(running_);
+    return;
+  }
+  if (profile_path_.empty() || !provider_) {
+    std::move(done).Run(false);
+    return;
+  }
+
+  // Prefer <profile>/rac-agent-mcp/<token>/s. Darwin AF_UNIX paths are capped
+  // at 103 bytes; deep profile paths fall back to /tmp/rac-mcp-<uid>-<token>/s.
+  const std::string token = RandomTokenHex();
+  const base::FilePath preferred_socket =
+      profile_path_.AppendASCII("rac-agent-mcp")
+          .AppendASCII(token)
+          .AppendASCII("s");
+  base::FilePath dir;
+  const bool use_profile_root = PathFitsUnix(preferred_socket);
+  if (use_profile_root) {
+    dir = profile_path_.AppendASCII("rac-agent-mcp").AppendASCII(token);
+  } else {
+    dir = base::FilePath("/tmp").AppendASCII(
+        "rac-mcp-" + base::NumberToString(static_cast<int>(geteuid())) + "-" +
+        token);
+    LOG(WARNING) << "rac MCP using short socket root (profile path too long "
+                    "for AF_UNIX): "
+                 << dir;
+  }
+  base::FilePath socket = dir.AppendASCII("s");
+  if (!PathFitsUnix(socket)) {
+    LOG(ERROR) << "rac MCP socket path exceeds AF_UNIX limit: " << socket;
+    std::move(done).Run(false);
+    return;
+  }
+
+  // BindPostTask so IO never touches WeakPtr sequence affinity.
+  auto on_opened = base::BindPostTask(
+      ui_runner_, base::BindRepeating(&McpServer::OnConnectionOpened,
+                                      weak_factory_.GetWeakPtr()));
+  auto on_closed = base::BindPostTask(
+      ui_runner_, base::BindRepeating(&McpServer::OnConnectionClosed,
+                                      weak_factory_.GetWeakPtr()));
+  auto on_message = base::BindPostTask(
+      ui_runner_, base::BindRepeating(&McpServer::DispatchOnUi,
+                                      weak_factory_.GetWeakPtr()));
+
+  io_state_ = std::make_unique<IoState>(
+      std::move(on_opened), std::move(on_closed), std::move(on_message));
+  starting_ = true;
+
+  io_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](IoState* state, base::FilePath profile_path, base::FilePath dir,
+             base::FilePath socket, bool use_profile_root,
+             scoped_refptr<base::SequencedTaskRunner> ui_runner,
+             base::WeakPtr<McpServer> self, StartCallback done) {
+            const bool ok =
+                state->StartListen(profile_path, dir, socket, use_profile_root);
+            ui_runner->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](base::WeakPtr<McpServer> self, StartCallback done,
+                       base::FilePath dir, base::FilePath socket, bool ok) {
+                      if (!self) {
+                        if (ok) {
+                          // Server was destroyed mid-start; drop the listen
+                          // socket and directory on a worker.
+                          base::ThreadPool::PostTask(
+                              FROM_HERE,
+                              {base::MayBlock(),
+                               base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+                              base::BindOnce(
+                                  [](base::FilePath dir,
+                                     base::FilePath socket) {
+                                    unlink(socket.value().c_str());
+                                    base::DeletePathRecursively(dir);
+                                  },
+                                  std::move(dir), std::move(socket)));
+                        }
+                        std::move(done).Run(false);
+                        return;
+                      }
+                      self->OnIoStartComplete(std::move(done), std::move(dir),
+                                              std::move(socket), ok);
+                    },
+                    std::move(self), std::move(done), std::move(dir),
+                    std::move(socket), ok));
+          },
+          base::Unretained(io_state_.get()), profile_path_, dir, socket,
+          use_profile_root, ui_runner_, weak_factory_.GetWeakPtr(),
+          std::move(done)));
+}
+
+void McpServer::OnIoStartComplete(StartCallback done,
+                                  base::FilePath dir,
+                                  base::FilePath socket,
+                                  bool ok) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  starting_ = false;
+  if (!ok) {
+    IoState* state = io_state_.release();
+    if (state) {
+      io_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce([](IoState* state) { delete state; }, state));
+    }
+    std::move(done).Run(false);
+    return;
+  }
+  socket_dir_ = std::move(dir);
+  socket_path_ = std::move(socket);
+  running_ = true;
+  VLOG(1) << "rac MCP listening on " << socket_path_.value();
+  std::move(done).Run(true);
+}
+
+void McpServer::Stop() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  weak_factory_.InvalidateWeakPtrs();
+  provider_ = nullptr;
+  DropHandlers();
+  starting_ = false;
+  running_ = false;
+
+  const base::FilePath dir = std::move(socket_dir_);
+  const base::FilePath socket = std::move(socket_path_);
+  socket_dir_.clear();
+  socket_path_.clear();
+
+  if (io_state_) {
+    IoState* state = io_state_.release();
+    io_runner_->PostTask(FROM_HERE,
+                         base::BindOnce(
+                             [](IoState* state, base::FilePath socket) {
+                               state->Stop();
+                               if (!socket.empty()) {
+                                 unlink(socket.value().c_str());
+                               }
+                               delete state;
+                             },
+                             state, socket));
+  } else if (!socket.empty()) {
+    io_runner_->PostTask(FROM_HERE, base::BindOnce(
+                                        [](base::FilePath socket) {
+                                          unlink(socket.value().c_str());
+                                        },
+                                        socket));
+  }
+
+  if (!dir.empty()) {
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+         base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+        base::BindOnce(
+            [](base::FilePath dir) { base::DeletePathRecursively(dir); }, dir));
+  }
+}
+
+void McpServer::OnConnectionOpened(int connection_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!running_ || ui_handlers_.contains(connection_id)) {
+    return;
+  }
+  ui_handlers_.emplace(
+      connection_id,
+      std::make_unique<McpConnectionHandler>(
+          provider_, approval_,
+          base::BindRepeating(&McpServer::WriteToConnection,
+                              weak_factory_.GetWeakPtr(), connection_id)));
+}
+
+void McpServer::OnConnectionClosed(int connection_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (auto it = ui_handlers_.find(connection_id); it != ui_handlers_.end()) {
+    it->second->Detach();
+    ui_runner_->DeleteSoon(FROM_HERE, std::move(it->second));
+    ui_handlers_.erase(it);
+  }
+}
+
+void McpServer::DispatchOnUi(int connection_id, base::DictValue message) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!running_) {
+    return;
+  }
+  if (!ui_handlers_.contains(connection_id)) {
+    OnConnectionOpened(connection_id);
+  }
+  auto it = ui_handlers_.find(connection_id);
+  if (it == ui_handlers_.end()) {
+    return;
+  }
+  if (!it->second->Handle(std::move(message))) {
+    CloseConnection(connection_id);
+  }
+}
+
+void McpServer::WriteToConnection(int connection_id, base::DictValue message) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!io_state_) {
+    return;
+  }
+  io_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&IoState::WriteMessage, base::Unretained(io_state_.get()),
+                     connection_id, std::move(message)));
+}
+
+void McpServer::CloseConnection(int connection_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  OnConnectionClosed(connection_id);
+  if (!io_state_) {
+    return;
+  }
+  io_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&IoState::DropConnection,
+                     base::Unretained(io_state_.get()), connection_id));
+}
+
+base::DictValue McpServer::MakeAcpMcpServerEntry() const {
+  return MakeAcpMcpServerEntry(socket_path_);
+}
+
+base::DictValue McpServer::MakeAcpMcpServerEntry(const base::FilePath& socket) {
+  base::ListValue args;
+  args.Append("-U");
+  args.Append(socket.value());
+  return base::DictValue()
+      .Set("name", "rac")
+      .Set("command", "/usr/bin/nc")
+      .Set("args", std::move(args))
+      .Set("env", base::ListValue());
+}
+
+base::WeakPtr<McpServer> McpServer::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+}  // namespace rac::agent

+    const base::DictValue* raw = tool.FindDict("rawInput");
+    const std::string* server = raw ? raw->FindString("server") : nullptr;
+    const std::string* name = raw ? raw->FindString("tool") : nullptr;
+    return server && *server == "rac" && name &&
+           std::ranges::contains(advertised_tools, *name);

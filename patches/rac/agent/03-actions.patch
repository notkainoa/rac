+#ifndef CHROME_BROWSER_RAC_AGENT_RENDERER_TOOLS_H_
+#define CHROME_BROWSER_RAC_AGENT_RENDERER_TOOLS_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/rac/agent/action_types.h"
+#include "chrome/browser/rac/agent/ref_table.h"
+#include "chrome/common/chrome_render_frame.mojom.h"
+#include "components/actor/core/task_id.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+
+namespace content {
+class WebContents;
+class RenderFrameHost;
+}  // namespace content
+
+namespace rac::agent {
+
+// Invokes Chromium renderer actor tools over ChromeRenderFrame. No Glic /
+// ExecutionEngine dependency.
+class RendererTools {
+ public:
+  using DoneCallback = base::OnceCallback<void(ActionResult)>;
+
+  RendererTools();
+  ~RendererTools();
+
+  void Click(content::WebContents* contents,
+             const RefEntry& entry,
+             DoneCallback done);
+  void Type(content::WebContents* contents,
+            const RefEntry& entry,
+            const std::string& text,
+            bool press_enter,
+            DoneCallback done);
+  void Select(content::WebContents* contents,
+              const RefEntry& entry,
+              const std::string& value,
+              DoneCallback done);
+  void Scroll(content::WebContents* contents,
+              const RefEntry* entry,
+              int dx,
+              int dy,
+              DoneCallback done);
+  void Cancel();
+
+ private:
+  using ToolBuilder = base::OnceCallback<actor::mojom::ToolActionPtr(
+      content::RenderFrameHost&)>;
+
+  void Invoke(content::WebContents* contents,
+              const RefEntry& entry,
+              ToolBuilder builder,
+              DoneCallback done);
+  void OnToolResult(DoneCallback done,
+                    int generation,
+                    actor::mojom::ActionResultPtr result);
+
+  int next_task_id_ = 1;
+  int cancel_generation_ = 0;
+  actor::TaskId active_task_id_;
+  mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> frame_remote_;
+  base::WeakPtrFactory<RendererTools> weak_factory_{this};
+};
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_RENDERER_TOOLS_H_

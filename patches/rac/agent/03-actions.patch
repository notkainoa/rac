+namespace rac::agent {
+
+// static
+void AgentNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  content::WebContents* contents = handle.GetWebContents();
+  if (!ActionContext::From(contents)) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<AgentNavigationThrottle>(registry));
+}
+
+AgentNavigationThrottle::AgentNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+AgentNavigationThrottle::~AgentNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+AgentNavigationThrottle::Check() {
+  const GURL& url = navigation_handle()->GetURL();
+  if (url.SchemeIsHTTPOrHTTPS() || url.IsAboutBlank()) {
+    // Download responses blocked in WillProcessResponse.
+    return PROCEED;
+  }
+  if (url.SchemeIs("chrome") || url.SchemeIsFile() ||
+      url.SchemeIs("javascript") || url.SchemeIs("data") ||
+      url.SchemeIs("blob") || url.SchemeIs("chrome-extension")) {
+    return CANCEL;
+  }
+  if (!IsAllowedAgentUrl(url.spec()) && !url.IsAboutBlank()) {
+    return CANCEL;
+  }
+  return PROCEED;
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+AgentNavigationThrottle::WillStartRequest() {
+  return Check();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+AgentNavigationThrottle::WillRedirectRequest() {
+  return Check();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+AgentNavigationThrottle::WillProcessResponse() {
+  if (navigation_handle()->IsDownload()) {
+    return CANCEL;
+  }
+  const net::HttpResponseHeaders* headers =
+      navigation_handle()->GetResponseHeaders();
+  if (headers) {
+    if (std::optional<std::string> disposition =
+            headers->GetNormalizedHeader("Content-Disposition");
+        disposition && disposition->find("attachment") != std::string::npos) {
+      return CANCEL;
+    }
+  }
+  return Check();
+}
+
+const char* AgentNavigationThrottle::GetNameForLogging() {
+  return "RacAgentNavigationThrottle";
+}
+
+}  // namespace rac::agent

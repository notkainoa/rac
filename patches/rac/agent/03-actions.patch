+namespace rac::agent {
+
+struct RefTarget {
+  std::string ref;
+  uint64_t snapshot_id = 0;
+};
+
+struct ClickAction {
+  RefTarget target;
+};
+struct TypeAction {
+  RefTarget target;
+  std::string text;
+  bool press_enter = false;
+};
+struct ScrollAction {
+  std::optional<RefTarget> target;
+  int dx = 0;
+  int dy = 0;
+};
+struct SelectAction {
+  RefTarget target;
+  std::string value;
+};
+struct PressKeyAction {
+  std::string key;
+  std::optional<RefTarget> target;
+};
+struct NavigateAction {
+  GURL url;
+};
+struct BackAction {};
+struct OpenTabAction {
+  GURL url;
+};
+struct SwitchTabAction {
+  std::string tab_id;
+};
+struct CloseTabAction {
+  std::string tab_id;
+};
+struct WaitAction {
+  base::TimeDelta duration;
+};
+
+using Action = std::variant<ClickAction,
+                            TypeAction,
+                            ScrollAction,
+                            SelectAction,
+                            PressKeyAction,
+                            NavigateAction,
+                            BackAction,
+                            OpenTabAction,
+                            SwitchTabAction,
+                            CloseTabAction,
+                            WaitAction>;
+
+struct ActionRequest {
+  uint64_t turn_id = 0;
+  std::string tab_id;
+  Action action;
+};
+
+enum class EventKind {
+  kNavigation,
+  kPopup,
+  kDialog,
+  kDownload,
+  kTabClosed,
+  kFileChooser,
+  kInterrupted,
+};
+
+struct ActionEvent {
+  EventKind kind = EventKind::kInterrupted;
+  std::string tab_id;
+  GURL url;
+  bool blocked = false;
+  std::string detail;
+};
+
+struct ActionResult {
+  bool ok = false;
+  std::string error_code;
+  std::string error;
+  bool may_have_acted = false;
+  bool settled = false;
+  bool timed_out = false;
+  std::optional<uint64_t> next_snapshot_id;
+  std::vector<ActionEvent> events;
+};
+

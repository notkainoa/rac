+
+ActionResult Denied(std::string_view code, std::string_view message) {
+  ActionResult r;
+  r.error_code = std::string(code);
+  r.error = std::string(message);
+  return r;
+}
+
+}  // namespace
+
+class ActionRunner::InputMonitor
+    : public content::WebContentsObserver,
+      public content::RenderWidgetHost::InputEventObserver,
+      public content::RenderWidgetHostObserver {
+ public:
+  InputMonitor(content::WebContents* contents, base::RepeatingClosure pause)
+      : content::WebContentsObserver(contents), pause_(std::move(pause)) {
+    contents->ForEachRenderFrameHost(
+        [this](content::RenderFrameHost* frame) { Watch(frame); });
+  }
+  ~InputMonitor() override {
+    for (auto* host : hosts_) {
+      host->RemoveInputEventObserver(this);
+      host->RemoveObserver(this);
+    }
+  }
+  void RenderFrameCreated(content::RenderFrameHost* frame) override {
+    Watch(frame);
+  }
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost* host) override {
+    host->RemoveInputEventObserver(this);
+    host->RemoveObserver(this);
+    hosts_.erase(host);
+  }
+  void OnInputEvent(const content::RenderWidgetHost&,
+                    const blink::WebInputEvent& event,
+                    InputEventSource) override {
+    using Type = blink::WebInputEvent::Type;
+    if (event.GetType() == Type::kMouseDown ||
+        event.GetType() == Type::kRawKeyDown ||
+        event.GetType() == Type::kTouchStart ||
+        event.GetType() == Type::kGestureScrollBegin) {
+      // Actor input is dispatched within the renderer, outside this path.
+      pause_.Run();
+    }
+  }
+
+ private:
+  void Watch(content::RenderFrameHost* frame) {
+    auto* host = frame->GetRenderWidgetHost();
+    if (host && hosts_.insert(host).second) {
+      host->AddInputEventObserver(this);
+      host->AddObserver(this);
+    }
+  }
+  std::set<content::RenderWidgetHost*> hosts_;
+  base::RepeatingClosure pause_;
+};
+
+bool IsBrowserControlAllowed(const PrefService* prefs, const Profile* profile) {
+  if (!profile || !profile->IsRegularProfile()) {
+    return false;
+  }
+  if (!rac::ai::IsAiEnabled(prefs)) {
+    return false;
+  }
+  return prefs && prefs->GetBoolean(rac::ai::kBrowserControl);
+}
+
+ActionRunner::ActionRunner(Profile* profile,
+                           BrowserWindowInterface* browser,
+                           PrefService* prefs,
+                           RefTable* refs)
+    : profile_(profile),
+      browser_(browser),
+      prefs_(prefs),
+      refs_(refs),
+      tab_tools_(std::make_unique<TabTools>(browser)) {}
+
+ActionRunner::~ActionRunner() {
+  Cancel();
+  for (auto& [alias, monitor] : input_monitors_) {
+    if (monitor->web_contents()) {
+      monitor->web_contents()->RemoveUserData(ActionContext::UserDataKey());
+    }
+  }
+}
+
+bool ActionRunner::IsAllowed() const {
+  return IsBrowserControlAllowed(prefs_, profile_);
+}
+
+void ActionRunner::AttachTab(const std::string& tab_id,
+                             content::WebContents* contents,
+                             bool agent_opened) {
+  ownership_.Attach(tab_id, agent_opened);
+  if (contents) {
+    input_monitors_[tab_id] = std::make_unique<InputMonitor>(
+        contents, base::BindRepeating(&ActionRunner::PauseForUserInteraction,
+                                      weak_factory_.GetWeakPtr()));
+    ActionContext::Ensure(contents, "session", agent_opened);
+  }
+}
+
+void ActionRunner::DetachTab(const std::string& tab_id) {
+  input_monitors_.erase(tab_id);
+  ownership_.Detach(tab_id);
+}
+
+content::WebContents* ActionRunner::ResolveTab(
+    const std::string& tab_id) const {
+  if (!ownership_.Owns(tab_id)) {
+    return nullptr;
+  }
+  return tab_tools_->FindByAlias(tab_id);
+}
+
+bool ActionRunner::GateOrFail(DoneCallback& done) {
+  if (!IsAllowed()) {
+    std::move(done).Run(
+        Denied("denied", "Browser control is off or unavailable."));
+    return false;
+  }
+  if (running_) {
+    std::move(done).Run(Denied("busy", "Another action is in flight."));
+    return false;
+  }
+  if (paused_) {
+    std::move(done).Run(
+        Denied("paused", "Paused because you interacted with the tab."));
+    return false;
+  }
+  return true;
+}
+
+void ActionRunner::Cancel() {
+  renderer_tools_.Cancel();
+  settler_.Cancel();
+  if (running_ && pending_done_) {
+    ActionResult r = Denied("cancelled", "Action cancelled.");
+    r.may_have_acted = true;
+    Finish(std::move(r));
+  }
+}
+
+void ActionRunner::PauseForUserInteraction() {
+  if (paused_) {
+    return;
+  }
+  paused_ = true;
+  if (paused_callback_) {
+    paused_callback_.Run();
+  }
+  Cancel();
+}
+
+void ActionRunner::Resume() {
+  paused_ = false;
+}
+
+void ActionRunner::SetPausedCallback(base::RepeatingClosure callback) {
+  paused_callback_ = std::move(callback);
+}
+
+void ActionRunner::Finish(ActionResult result) {
+  running_ = false;
+  DoneCallback cb = std::move(pending_done_);
+  if (cb) {
+    std::move(cb).Run(std::move(result));
+  }
+}
+
+void ActionRunner::Run(ActionRequest request, DoneCallback done) {
+  if (!GateOrFail(done)) {
+    return;
+  }
+  running_ = true;
+  pending_done_ = std::move(done);
+  pending_request_ = std::move(request);
+
+  auto fail = [this](ActionResult r) { Finish(std::move(r)); };
+
+  if (std::holds_alternative<OpenTabAction>(pending_request_.action)) {
+    const auto& a = std::get<OpenTabAction>(pending_request_.action);
+    std::string tab_id;
+    ActionResult r = tab_tools_->OpenTab(a.url, &tab_id);
+    if (r.ok && !tab_id.empty()) {
+      ownership_.Attach(tab_id, /*agent_opened=*/true);
+      if (content::WebContents* contents = tab_tools_->FindByAlias(tab_id)) {
+        ActionContext::Ensure(contents, "session", true);
+      }
+    }
+    Finish(std::move(r));
+    return;
+  }
+  if (std::holds_alternative<SwitchTabAction>(pending_request_.action)) {
+    const auto& a = std::get<SwitchTabAction>(pending_request_.action);
+    if (!ownership_.Owns(a.tab_id)) {
+      fail(Denied("denied", "Tab is not attached to this agent session."));
+      return;
+    }
+    Finish(tab_tools_->SwitchTab(a.tab_id));
+    return;
+  }
+  if (std::holds_alternative<CloseTabAction>(pending_request_.action)) {
+    const auto& a = std::get<CloseTabAction>(pending_request_.action);
+    Finish(tab_tools_->CloseTab(a.tab_id, ownership_.AgentOpened(a.tab_id)));
+    ownership_.Detach(a.tab_id);
+    return;
+  }
+
+  content::WebContents* contents = ResolveTab(pending_request_.tab_id);
+  if (!contents) {
+    fail(Denied("denied", "Tab is not attached to this agent session."));
+    return;
+  }
+  if (ActionContext* ctx = ActionContext::From(contents);
+      ctx && ctx->paused()) {
+    fail(Denied("paused", "Paused because you interacted with the tab."));
+    return;
+  }
+
+  if (std::holds_alternative<NavigateAction>(pending_request_.action)) {
+    const auto& a = std::get<NavigateAction>(pending_request_.action);
+    content::RenderFrameHost* root = contents->GetPrimaryMainFrame();
+    settler_.Prepare(root, base::Seconds(10));
+    tab_tools_->Navigate(
+        contents, a.url,
+        base::BindOnce(
+            [](base::WeakPtr<ActionRunner> self, ActionResult r) {
+              if (!self) {
+                return;
+              }
+              self->OnToolDone(std::move(r));
+            },
+            weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (std::holds_alternative<BackAction>(pending_request_.action)) {
+    content::RenderFrameHost* root = contents->GetPrimaryMainFrame();
+    settler_.Prepare(root, base::Seconds(10));
+    OnToolDone(tab_tools_->GoBack(contents));
+    return;
+  }
+  if (std::holds_alternative<WaitAction>(pending_request_.action)) {
+    const auto& a = std::get<WaitAction>(pending_request_.action);
+    content::RenderFrameHost* root = contents->GetPrimaryMainFrame();
+    settler_.Prepare(root,
+                     a.duration.is_zero() ? base::Seconds(4) : a.duration);
+    ActionResult ok;
+    ok.ok = true;
+    OnToolDone(std::move(ok));
+    return;
+  }
+
+  auto resolve_ref = [&](const RefTarget& target) -> const RefEntry* {
+    const RefEntry* entry = refs_->Lookup(target.ref);
+    if (!entry || !entry->present_in_latest) {
+      return nullptr;
+    }
+    if (target.snapshot_id &&
+        entry->last_seen_generation < target.snapshot_id) {
+      return nullptr;
+    }
+    if (entry->key.tab_id != pending_request_.tab_id) {
+      return nullptr;
+    }
+    return entry;
+  };
+
+  content::RenderFrameHost* root = contents->GetPrimaryMainFrame();
+  settler_.Prepare(root, base::Seconds(4));
+
+  if (std::holds_alternative<ClickAction>(pending_request_.action)) {
+    const auto& a = std::get<ClickAction>(pending_request_.action);
+    const RefEntry* entry = resolve_ref(a.target);
+    if (!entry) {
+      fail(Denied("stale_ref",
+                  a.target.ref + " is missing or stale. Take a new snapshot."));
+      return;
+    }
+    renderer_tools_.Click(
+        contents, *entry,
+        base::BindOnce(&ActionRunner::OnToolDone, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (std::holds_alternative<TypeAction>(pending_request_.action)) {
+    const auto& a = std::get<TypeAction>(pending_request_.action);
+    const RefEntry* entry = resolve_ref(a.target);
+    if (!entry) {
+      fail(Denied("stale_ref",
+                  a.target.ref + " is missing or stale. Take a new snapshot."));
+      return;
+    }
+    renderer_tools_.Type(
+        contents, *entry, a.text, a.press_enter,
+        base::BindOnce(&ActionRunner::OnToolDone, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (std::holds_alternative<SelectAction>(pending_request_.action)) {
+    const auto& a = std::get<SelectAction>(pending_request_.action);
+    const RefEntry* entry = resolve_ref(a.target);
+    if (!entry) {
+      fail(Denied("stale_ref",
+                  a.target.ref + " is missing or stale. Take a new snapshot."));
+      return;
+    }
+    renderer_tools_.Select(
+        contents, *entry, a.value,
+        base::BindOnce(&ActionRunner::OnToolDone, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (std::holds_alternative<ScrollAction>(pending_request_.action)) {
+    const auto& a = std::get<ScrollAction>(pending_request_.action);
+    const RefEntry* entry = nullptr;
+    if (a.target) {
+      entry = resolve_ref(*a.target);
+      if (!entry) {
+        fail(Denied(
+            "stale_ref",
+            a.target->ref + " is missing or stale. Take a new snapshot."));
+        return;
+      }
+    }
+    renderer_tools_.Scroll(
+        contents, entry, a.dx, a.dy,
+        base::BindOnce(&ActionRunner::OnToolDone, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (std::holds_alternative<PressKeyAction>(pending_request_.action)) {
+    const auto& a = std::get<PressKeyAction>(pending_request_.action);
+    if (a.target && base::EqualsCaseInsensitiveASCII(a.key, "Enter")) {
+      const RefEntry* entry = resolve_ref(*a.target);
+      if (!entry) {
+        fail(Denied("stale_ref", "stale ref for press_key"));
+        return;
+      }
+      renderer_tools_.Type(contents, *entry, "", true,
+                           base::BindOnce(&ActionRunner::OnToolDone,
+                                          weak_factory_.GetWeakPtr()));
+      return;
+    }
+    fail(Denied("unsupported",
+                "press_key currently supports Enter on a ref only."));
+    return;
+  }
+
+  fail(Denied("unsupported", "Unknown action."));
+}
+
+void ActionRunner::OnToolDone(ActionResult result) {
+  if (!running_) {
+    return;
+  }
+  content::WebContents* contents = ResolveTab(pending_request_.tab_id);
+  if (!contents || !result.ok) {
+    Finish(std::move(result));
+    return;
+  }
+  settler_.Wait(contents,
+                base::BindOnce(&ActionRunner::OnSettled,
+                               weak_factory_.GetWeakPtr(), std::move(result)));
+}
+
+void ActionRunner::OnSettled(ActionResult result, SettleResult settle) {
+  result.settled = settle.settled;
+  result.timed_out = settle.timed_out;
+  content::WebContents* contents = ResolveTab(pending_request_.tab_id);
+  if (!contents) {
+    Finish(std::move(result));
+    return;
+  }
+  ExtractAnnotatedPageContent(
+      contents, base::BindOnce(
+                    [](base::WeakPtr<ActionRunner> self, ActionResult action,
+                       optimization_guide::AIPageContentResultOrError page) {
+                      if (!self || !self->running_) {
+                        return;
+                      }
+                      if (page.has_value()) {
+                        SnapshotOptions options;
+                        options.tab_id = self->pending_request_.tab_id;
+                        auto snapshot = SerializeAgentSnapshot(
+                            page->proto, *self->refs_, options,
+                            self->last_snapshot_.snapshot_id + 1,
+                            &self->last_snapshot_);
+                        action.next_snapshot_id = snapshot.snapshot_id;
+                        self->last_snapshot_ = std::move(snapshot);
+                      }
+                      self->Finish(std::move(action));
+                    },
+                    weak_factory_.GetWeakPtr(), std::move(result)));
+}
+
+}  // namespace rac::agent

+namespace rac::agent {
+namespace {
+using Monitor = page_content_annotations::PageSettledMonitor;
+}  // namespace
+
+class PageSettler::Delegate : public Monitor::Delegate {
+ public:
+  Delegate(Monitor::PageStabilityConfig config,
+           base::TimeDelta timeout,
+           base::WeakPtr<PageSettler> owner)
+      : Monitor::Delegate(config),
+        timeout_(timeout),
+        owner_(std::move(owner)) {}
+
+  void WillMoveToState(Monitor::State state) override {
+    if (state == Monitor::State::kDidTimeout && owner_) {
+      owner_->timed_out_ = true;
+    }
+  }
+
+  void OnEvent(Monitor::Event event) override {
+    if (event == Monitor::Event::kMojoDisconnected && owner_) {
+      owner_->timed_out_ = true;
+    }
+  }
+
+  base::TimeDelta GetCompletionTimeout() const override { return timeout_; }
+
+ private:
+  base::TimeDelta timeout_;
+  base::WeakPtr<PageSettler> owner_;
+};
+
+PageSettler::PageSettler() = default;
+PageSettler::~PageSettler() {
+  Cancel();
+}
+
+void PageSettler::Prepare(content::RenderFrameHost* local_root,
+                          base::TimeDelta timeout) {
+  Cancel();
+  if (!local_root) {
+    return;
+  }
+  timed_out_ = false;
+  Monitor::PageStabilityConfig config;
+  config.supports_paint_stability = true;
+  config.start_delay = base::TimeDelta();
+  auto delegate =
+      std::make_unique<Delegate>(config, timeout, weak_factory_.GetWeakPtr());
+  monitor_ = std::make_unique<Monitor>(local_root, std::move(delegate));
+}
+
+void PageSettler::Wait(content::WebContents* contents, DoneCallback done) {
+  if (!monitor_ || !contents) {
+    SettleResult r;
+    r.settled = false;
+    r.timed_out = true;
+    std::move(done).Run(r);
+    return;
+  }
+  const int generation = ++generation_;
+  monitor_->Wait(contents, base::BindOnce(&PageSettler::OnReady,
+                                          weak_factory_.GetWeakPtr(),
+                                          std::move(done), generation));
+}
+
+void PageSettler::OnReady(DoneCallback done, int generation) {
+  if (generation != generation_) {
+    return;
+  }
+  SettleResult r;
+  r.timed_out = timed_out_;
+  r.settled = !timed_out_;
+  monitor_.reset();
+  std::move(done).Run(r);
+}
+
+void PageSettler::Cancel() {
+  ++generation_;
+  monitor_.reset();
+}
+
+}  // namespace rac::agent

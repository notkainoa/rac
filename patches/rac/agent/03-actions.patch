+#include "chrome/browser/rac/agent/tab_tools.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rac/agent/tool_registry.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace rac::agent {
+
+TabTools::TabTools(BrowserWindowInterface* browser) : browser_(browser) {}
+TabTools::~TabTools() = default;
+
+std::string TabTools::AliasFor(content::WebContents* contents) const {
+  if (!contents || !browser_) {
+    return {};
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (!model) {
+    return {};
+  }
+  const int index = model->GetIndexOfWebContents(contents);
+  if (index == TabStripModel::kNoTab) {
+    return {};
+  }
+  // Stable-enough alias for the session: strip handle raw value.
+  tabs::TabInterface* tab = model->GetTabAtIndex(index);
+  if (!tab) {
+    return {};
+  }
+  return "t" + base::NumberToString(tab->GetHandle().raw_value());
+}
+
+content::WebContents* TabTools::FindByAlias(const std::string& tab_id) const {
+  if (!browser_ || tab_id.empty()) {
+    return nullptr;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (!model) {
+    return nullptr;
+  }
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    if (AliasFor(contents) == tab_id) {
+      return contents;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<TabInfo> TabTools::ListTabs() const {
+  std::vector<TabInfo> out;
+  if (!browser_) {
+    return out;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (!model) {
+    return out;
+  }
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    if (!contents) {
+      continue;
+    }
+    const GURL& url = contents->GetLastCommittedURL();
+    if (!url.is_empty() && !url.SchemeIsHTTPOrHTTPS() && !url.IsAboutBlank()) {
+      continue;
+    }
+    TabInfo info;
+    info.tab_id = AliasFor(contents);
+    info.title = base::UTF16ToUTF8(contents->GetTitle());
+    info.url = url;
+    info.active = model->active_index() == i;
+    out.push_back(std::move(info));
+  }
+  return out;
+}
+
+ActionResult TabTools::OpenTab(const GURL& url, std::string* out_tab_id) {
+  ActionResult result;
+  if (!browser_ || !IsAllowedAgentUrl(url.spec())) {
+    result.error_code = "denied";
+    result.error = "URL not allowed.";
+    return result;
+  }
+  NavigateParams params(browser_, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  ::Navigate(&params);
+  content::WebContents* created = params.navigated_or_inserted_contents;
+  if (!created) {
+    result.error_code = "open_failed";
+    result.error = "Could not open tab.";
+    return result;
+  }
+  if (out_tab_id) {
+    *out_tab_id = AliasFor(created);
+  }
+  result.ok = true;
+  return result;
+}
+
+ActionResult TabTools::SwitchTab(const std::string& tab_id) {
+  ActionResult result;
+  content::WebContents* contents = FindByAlias(tab_id);
+  if (!contents || !browser_) {
+    result.error_code = "unknown_tab";
+    result.error = "Unknown tab.";
+    return result;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  const int index = model->GetIndexOfWebContents(contents);
+  if (index == TabStripModel::kNoTab) {
+    result.error_code = "unknown_tab";
+    result.error = "Unknown tab.";
+    return result;
+  }
+  model->ActivateTabAt(index);
+  result.ok = true;
+  return result;
+}
+
+ActionResult TabTools::CloseTab(const std::string& tab_id, bool agent_opened) {
+  ActionResult result;
+  if (!agent_opened) {
+    result.error_code = "denied";
+    result.error = "Closing a user tab requires confirmation.";
+    return result;
+  }
+  content::WebContents* contents = FindByAlias(tab_id);
+  if (!contents || !browser_) {
+    result.error_code = "unknown_tab";
+    result.error = "Unknown tab.";
+    return result;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  const int index = model->GetIndexOfWebContents(contents);
+  if (index == TabStripModel::kNoTab) {
+    result.error_code = "unknown_tab";
+    result.error = "Unknown tab.";
+    return result;
+  }
+  model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+  result.ok = true;
+  return result;
+}
+
+void TabTools::Navigate(content::WebContents* contents,
+                        const GURL& url,
+                        NavigateDone done) {
+  ActionResult result;
+  if (!contents || !IsAllowedAgentUrl(url.spec())) {
+    result.error_code = "denied";
+    result.error = "Navigation URL not allowed.";
+    std::move(done).Run(std::move(result));
+    return;
+  }
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  contents->GetController().LoadURLWithParams(params);
+  result.ok = true;
+  std::move(done).Run(std::move(result));
+}
+
+ActionResult TabTools::GoBack(content::WebContents* contents) {
+  ActionResult result;
+  if (!contents || !contents->GetController().CanGoBack()) {
+    result.error_code = "no_history";
+    result.error = "Nothing to go back to.";
+    return result;
+  }
+  const content::NavigationEntry* entry =
+      contents->GetController().GetEntryAtOffset(-1);
+  if (entry && !IsAllowedAgentUrl(entry->GetURL().spec()) &&
+      !entry->GetURL().IsAboutBlank()) {
+    result.error_code = "denied";
+    result.error = "Back target URL not allowed.";
+    return result;
+  }
+  contents->GetController().GoBack();
+  result.ok = true;
+  return result;
+}
+
+}  // namespace rac::agent

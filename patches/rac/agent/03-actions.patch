+namespace rac::agent {
+namespace {
+
+struct DebugState {
+  RefTable refs;
+  std::unique_ptr<ActionRunner> runner;
+  std::string tab_id;
+  AgentSnapshot last_snapshot;
+};
+
+DebugState& State() {
+  static DebugState state;
+  return state;
+}
+
+base::DictValue SnapshotToDict(const AgentSnapshot& snap) {
+  return base::DictValue()
+      .Set("ok", true)
+      .Set("snapshot_id", static_cast<double>(snap.snapshot_id))
+      .Set("is_delta", snap.is_delta)
+      .Set("title", snap.title)
+      .Set("url", snap.url)
+      .Set("text", snap.text)
+      .Set("line_count", static_cast<int>(snap.line_count));
+}
+
+base::DictValue ResultToDict(const ActionResult& r) {
+  return base::DictValue()
+      .Set("ok", r.ok)
+      .Set("error_code", r.error_code)
+      .Set("error", r.error)
+      .Set("settled", r.settled)
+      .Set("timed_out", r.timed_out)
+      .Set("may_have_acted", r.may_have_acted);
+}
+
+void EnsureRunner(Profile* profile, BrowserWindowInterface* browser) {
+  DebugState& s = State();
+  if (!s.runner) {
+    s.runner = std::make_unique<ActionRunner>(profile, browser,
+                                              profile->GetPrefs(), &s.refs);
+  }
+}
+
+}  // namespace
+
+bool IsAgentDebugEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kAgentDebugSwitch);
+}
+
+void RunAgentDebugCommand(Profile* profile,
+                          BrowserWindowInterface* browser,
+                          content::WebContents* active_tab,
+                          const base::DictValue& command,
+                          AgentDebugDone done) {
+  if (!IsAgentDebugEnabled()) {
+    std::move(done).Run(base::DictValue()
+                            .Set("ok", false)
+                            .Set("error", "Pass --rac-agent-debug to enable."));
+    return;
+  }
+  if (!profile || !browser) {
+    std::move(done).Run(
+        base::DictValue().Set("ok", false).Set("error", "No browser."));
+    return;
+  }
+  EnsureRunner(profile, browser);
+  DebugState& s = State();
+  TabTools tabs(browser);
+  const std::string* op = command.FindString("op");
+  if (!op) {
+    std::move(done).Run(
+        base::DictValue().Set("ok", false).Set("error", "Missing op."));
+    return;
+  }
+
+  if (*op == "attach") {
+    if (!active_tab) {
+      std::move(done).Run(
+          base::DictValue().Set("ok", false).Set("error", "No active tab."));
+      return;
+    }
+    s.tab_id = tabs.AliasFor(active_tab);
+    s.runner->AttachTab(s.tab_id, active_tab, /*agent_opened=*/false);
+    std::move(done).Run(
+        base::DictValue().Set("ok", true).Set("tab_id", s.tab_id));
+    return;
+  }
+
+  if (*op == "snapshot") {
+    if (!active_tab) {
+      std::move(done).Run(
+          base::DictValue().Set("ok", false).Set("error", "No active tab."));
+      return;
+    }
+    if (s.tab_id.empty()) {
+      s.tab_id = tabs.AliasFor(active_tab);
+      s.runner->AttachTab(s.tab_id, active_tab, false);
+    }
+    const bool full = command.FindBool("full").value_or(false);
+    ExtractAnnotatedPageContent(
+        active_tab,
+        base::BindOnce(
+            [](AgentDebugDone done, bool full, std::string tab_id,
+               optimization_guide::AIPageContentResultOrError result) {
+              if (!result.has_value()) {
+                std::move(done).Run(base::DictValue()
+                                        .Set("ok", false)
+                                        .Set("error", result.error()));
+                return;
+              }
+              DebugState& st = State();
+              SnapshotOptions opts;
+              opts.full = full;
+              opts.tab_id = tab_id;
+              const uint64_t id = st.last_snapshot.snapshot_id + 1;
+              AgentSnapshot snap = SerializeAgentSnapshot(
+                  result->proto, st.refs, opts, id,
+                  st.last_snapshot.snapshot_id ? &st.last_snapshot : nullptr);
+              const std::string nonce =
+                  base::UnguessableToken::Create().ToString();
+              rac::ai::PageAttachment page;
+              page.title = snap.title;
+              page.url = snap.url;
+              page.text = snap.text;
+              const std::string wrapped = rac::ai::WrapPageContent(page, nonce);
+              st.last_snapshot = snap;
+              st.runner->SetLastSnapshot(snap);
+              base::DictValue out = SnapshotToDict(snap);
+              out.Set("wrapped", wrapped);
+              out.Set("tab_id", tab_id);
+              std::move(done).Run(std::move(out));
+            },
+            std::move(done), full, s.tab_id));
+    return;
+  }
+
+  if (s.tab_id.empty() && active_tab) {
+    s.tab_id = tabs.AliasFor(active_tab);
+    s.runner->AttachTab(s.tab_id, active_tab, false);
+  }
+
+  ActionRequest req;
+  req.tab_id = s.tab_id;
+  req.turn_id = 1;
+
+  if (*op == "click") {
+    const std::string* ref = command.FindString("ref");
+    if (!ref) {
+      std::move(done).Run(
+          base::DictValue().Set("ok", false).Set("error", "Missing ref."));
+      return;
+    }
+    ClickAction a;
+    a.target.ref = *ref;
+    a.target.snapshot_id = s.last_snapshot.snapshot_id;
+    req.action = std::move(a);
+  } else if (*op == "type") {
+    const std::string* ref = command.FindString("ref");
+    const std::string* text = command.FindString("text");
+    if (!ref || !text) {
+      std::move(done).Run(
+          base::DictValue().Set("ok", false).Set("error", "Missing ref/text."));
+      return;
+    }
+    TypeAction a;
+    a.target.ref = *ref;
+    a.target.snapshot_id = s.last_snapshot.snapshot_id;
+    a.text = *text;
+    a.press_enter = command.FindBool("press_enter").value_or(false);
+    req.action = std::move(a);
+  } else if (*op == "select") {
+    const std::string* ref = command.FindString("ref");
+    const std::string* value = command.FindString("value");
+    if (!ref || !value) {
+      std::move(done).Run(base::DictValue()
+                              .Set("ok", false)
+                              .Set("error", "Missing ref/value."));
+      return;
+    }
+    SelectAction a;
+    a.target.ref = *ref;
+    a.target.snapshot_id = s.last_snapshot.snapshot_id;
+    a.value = *value;
+    req.action = std::move(a);
+  } else if (*op == "navigate") {
+    const std::string* url = command.FindString("url");
+    if (!url) {
+      std::move(done).Run(
+          base::DictValue().Set("ok", false).Set("error", "Missing url."));
+      return;
+    }
+    NavigateAction a;
+    a.url = GURL(*url);
+    req.action = std::move(a);
+  } else if (*op == "cancel") {
+    s.runner->Cancel();
+    std::move(done).Run(base::DictValue().Set("ok", true));
+    return;
+  } else if (*op == "pause") {
+    s.runner->PauseForUserInteraction();
+    std::move(done).Run(base::DictValue().Set("ok", true));
+    return;
+  } else {
+    std::move(done).Run(
+        base::DictValue().Set("ok", false).Set("error", "Unknown op: " + *op));
+    return;
+  }
+
+  s.runner->Run(std::move(req),
+                base::BindOnce(
+                    [](AgentDebugDone done, ActionResult result) {
+                      auto out = ResultToDict(result);
+                      if (result.next_snapshot_id) {
+                        out.Set(
+                            "snapshot",
+                            SnapshotToDict(*State().runner->last_snapshot()));
+                      }
+                      std::move(done).Run(std::move(out));
+                    },
+                    std::move(done)));
+}
+
+}  // namespace rac::agent

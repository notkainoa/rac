+#include "chrome/browser/rac/agent/action_context.h"
+
+namespace rac::agent {
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ActionContext);
+
+ActionContext::ActionContext(content::WebContents* contents,
+                             std::string session_id,
+                             bool agent_opened)
+    : content::WebContentsUserData<ActionContext>(*contents),
+      session_id_(std::move(session_id)),
+      agent_opened_(agent_opened) {}
+
+ActionContext::~ActionContext() = default;
+
+// static
+ActionContext* ActionContext::From(content::WebContents* contents) {
+  return contents
+             ? WebContentsUserData<ActionContext>::FromWebContents(contents)
+             : nullptr;
+}
+
+// static
+ActionContext* ActionContext::Ensure(content::WebContents* contents,
+                                     std::string session_id,
+                                     bool agent_opened) {
+  if (!contents) {
+    return nullptr;
+  }
+  if (ActionContext* existing = From(contents)) {
+    return existing;
+  }
+  CreateForWebContents(contents, std::move(session_id), agent_opened);
+  return From(contents);
+}
+
+void TabOwnership::Attach(const std::string& tab_id, bool agent_opened) {
+  attached_.insert(tab_id);
+  if (agent_opened) {
+    agent_opened_.insert(tab_id);
+  }
+}
+
+void TabOwnership::Detach(const std::string& tab_id) {
+  attached_.erase(tab_id);
+  agent_opened_.erase(tab_id);
+}
+
+bool TabOwnership::Owns(const std::string& tab_id) const {
+  return attached_.contains(tab_id);
+}
+
+bool TabOwnership::AgentOpened(const std::string& tab_id) const {
+  return agent_opened_.contains(tab_id);
+}
+
+void TabOwnership::Clear() {
+  attached_.clear();
+  agent_opened_.clear();
+}
+
+}  // namespace rac::agent

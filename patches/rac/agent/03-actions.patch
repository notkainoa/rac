+#ifndef CHROME_BROWSER_RAC_AGENT_TAB_TOOLS_H_
+#define CHROME_BROWSER_RAC_AGENT_TAB_TOOLS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/rac/agent/action_types.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}
+
+namespace rac::agent {
+
+struct TabInfo {
+  std::string tab_id;
+  std::string title;
+  GURL url;
+  bool active = false;
+  bool agent_owned = false;
+};
+
+class TabTools {
+ public:
+  using NavigateDone = base::OnceCallback<void(ActionResult)>;
+
+  explicit TabTools(BrowserWindowInterface* browser);
+  ~TabTools();
+
+  std::vector<TabInfo> ListTabs() const;
+  content::WebContents* FindByAlias(const std::string& tab_id) const;
+  std::string AliasFor(content::WebContents* contents) const;
+
+  ActionResult OpenTab(const GURL& url, std::string* out_tab_id);
+  ActionResult SwitchTab(const std::string& tab_id);
+  ActionResult CloseTab(const std::string& tab_id, bool agent_opened);
+  void Navigate(content::WebContents* contents,
+                const GURL& url,
+                NavigateDone done);
+  ActionResult GoBack(content::WebContents* contents);
+
+ private:
+  raw_ptr<BrowserWindowInterface> browser_;
+};
+
+}  // namespace rac::agent

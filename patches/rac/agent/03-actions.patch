+void PageHandler::HandleAgentDebug(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  AllowJavascript();
+  if (!rac::agent::IsAgentDebugEnabled() || profile_->IsOffTheRecord()) {
+    ResolveJavascriptCallback(
+        args[0],
+        base::DictValue().Set("ok", false).Set("error", "debug disabled"));
+    return;
+  }
+  if (!args[1].is_dict()) {
+    ResolveJavascriptCallback(
+        args[0],
+        base::DictValue().Set("ok", false).Set("error", "expected dict"));
+    return;
+  }
+  BrowserWindowInterface* browser = GetBrowser();
+  content::WebContents* active = nullptr;
+  if (browser) {
+    if (tabs::TabInterface* tab = browser->GetActiveTabInterface()) {
+      active = tab->GetContents();
+    }
+  }
+  rac::agent::RunAgentDebugCommand(
+      profile_, browser, active, args[1].GetDict(),
+      base::BindOnce(
+          [](base::WeakPtr<PageHandler> self, base::Value callback_id,
+             base::DictValue result) {
+            if (!self || !self->IsJavascriptAllowed()) {
+              return;
+            }
+            self->ResolveJavascriptCallback(callback_id, result);
+          },
+          weak_factory_.GetWeakPtr(), args[0].Clone()));
+}

+
+namespace rac::agent {
+
+// Marks a tab as controlled by an agent session. Looked up without creating
+// from navigation/download hooks.
+class ActionContext : public content::WebContentsUserData<ActionContext> {
+ public:
+  ~ActionContext() override;
+
+  static ActionContext* From(content::WebContents* contents);
+  static ActionContext* Ensure(content::WebContents* contents,
+                               std::string session_id,
+                               bool agent_opened);
+
+  const std::string& session_id() const { return session_id_; }
+  bool agent_opened() const { return agent_opened_; }
+  bool paused() const { return paused_; }
+  void SetPaused(bool paused) { paused_ = paused; }
+
+ private:
+  friend class content::WebContentsUserData<ActionContext>;
+  ActionContext(content::WebContents* contents,
+                std::string session_id,
+                bool agent_opened);
+
+  std::string session_id_;
+  bool agent_opened_ = false;
+  bool paused_ = false;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// Session-scoped ownership of tabs the agent may act in.
+class TabOwnership {
+ public:
+  void Attach(const std::string& tab_id, bool agent_opened);
+  void Detach(const std::string& tab_id);
+  bool Owns(const std::string& tab_id) const;
+  bool AgentOpened(const std::string& tab_id) const;
+  void Clear();
+
+ private:
+  std::unordered_set<std::string> attached_;
+  std::unordered_set<std::string> agent_opened_;
+};
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_ACTION_CONTEXT_H_

+namespace rac::agent {
+namespace {
+
+content::RenderFrameHost* LocalRootFor(content::RenderFrameHost* rfh) {
+  content::RenderFrameHost* local_root = rfh;
+  while (local_root && local_root->GetParent()) {
+    if (local_root->GetRenderWidgetHost() !=
+        local_root->GetParent()->GetRenderWidgetHost()) {
+      break;
+    }
+    local_root = local_root->GetParent();
+  }
+  return local_root;
+}
+
+content::RenderFrameHost* ResolveFrame(content::WebContents* contents,
+                                       const RefEntry& entry) {
+  if (!contents || entry.key.document_token.empty()) {
+    return nullptr;
+  }
+  content::RenderFrameHost* frame =
+      optimization_guide::GetRenderFrameForDocumentIdentifier(
+          *contents, entry.key.document_token);
+  if (!frame || !frame->IsActive()) {
+    return nullptr;
+  }
+  return LocalRootFor(frame);
+}
+
+actor::mojom::ObservedToolTargetPtr MakeObservedTarget(
+    const RefEntry& entry,
+    content::RenderFrameHost& local_root) {
+  auto observed = actor::mojom::ObservedToolTarget::New();
+  observed->node_attribute = blink::mojom::AIPageContentAttributes::New();
+  observed->node_attribute->dom_node_id = entry.key.dom_node_id;
+  if (!entry.outer_box.IsEmpty() || !entry.visible_box.IsEmpty()) {
+    observed->node_attribute->geometry =
+        blink::mojom::AIPageContentGeometry::New();
+    auto* view = local_root.GetView();
+    if (view && !entry.outer_box.IsEmpty()) {
+      const gfx::Point origin =
+          gfx::ToRoundedPoint(view->TransformRootPointToViewCoordSpace(
+              gfx::PointF(entry.outer_box.origin())));
+      observed->node_attribute->geometry->outer_bounding_box =
+          gfx::Rect(origin, entry.outer_box.size());
+    } else {
+      observed->node_attribute->geometry->outer_bounding_box = entry.outer_box;
+    }
+    if (view && !entry.visible_box.IsEmpty()) {
+      const gfx::Point origin =
+          gfx::ToRoundedPoint(view->TransformRootPointToViewCoordSpace(
+              gfx::PointF(entry.visible_box.origin())));
+      observed->node_attribute->geometry->visible_bounding_box =
+          gfx::Rect(origin, entry.visible_box.size());
+    } else {
+      observed->node_attribute->geometry->visible_bounding_box =
+          entry.visible_box;
+    }
+  }
+  return observed;
+}
+
+ActionResult FromMojo(actor::mojom::ActionResultPtr result) {
+  ActionResult out;
+  if (!result) {
+    out.error_code = "tool_failed";
+    out.error = "No result from renderer tool.";
+    out.may_have_acted = true;
+    return out;
+  }
+  if (result->code == actor::mojom::ActionResultCode::kOk) {
+    out.ok = true;
+    return out;
+  }
+  out.error_code = "tool_failed";
+  out.error =
+      result->message.empty() ? "Renderer tool failed." : result->message;
+  out.may_have_acted = true;
+  return out;
+}
+
+}  // namespace
+
+RendererTools::RendererTools() = default;
+RendererTools::~RendererTools() {
+  Cancel();
+}
+
+void RendererTools::Cancel() {
+  ++cancel_generation_;
+  if (frame_remote_.is_bound()) {
+    if (!active_task_id_.is_null()) {
+      frame_remote_->CancelTool(active_task_id_);
+    }
+    frame_remote_.reset();
+  }
+}
+
+void RendererTools::Click(content::WebContents* contents,
+                          const RefEntry& entry,
+                          DoneCallback done) {
+  Invoke(
+      contents, entry, base::BindOnce([](content::RenderFrameHost&) {
+        return actor::mojom::ToolAction::NewClick(
+            actor::mojom::ClickAction::New(actor::mojom::ClickType::kLeft,
+                                           actor::mojom::ClickCount::kSingle));
+      }),
+      std::move(done));
+}
+
+void RendererTools::Type(content::WebContents* contents,
+                         const RefEntry& entry,
+                         const std::string& text,
+                         bool press_enter,
+                         DoneCallback done) {
+  Invoke(contents, entry,
+         base::BindOnce(
+             [](std::string text, bool press_enter, content::RenderFrameHost&) {
+               return actor::mojom::ToolAction::NewType(
+                   actor::mojom::TypeAction::New(
+                       actor::mojom::TypeAction::Mode::kDeleteExisting, text,
+                       press_enter));
+             },
+             text, press_enter),
+         std::move(done));
+}
+
+void RendererTools::Select(content::WebContents* contents,
+                           const RefEntry& entry,
+                           const std::string& value,
+                           DoneCallback done) {
+  std::string resolved;
+  bool matched = false;
+  std::vector<std::string> available;
+  for (const auto& option : entry.select_options) {
+    if (option.disabled) {
+      continue;
+    }
+    available.push_back(option.label + " (" + option.value + ")");
+    if (option.value == value) {
+      resolved = option.value;
+      matched = true;
+      break;
+    }
+  }
+  if (!matched) {
+    for (const auto& option : entry.select_options) {
+      if (!option.disabled && option.label == value) {
+        resolved = option.value;
+        matched = true;
+        break;
+      }
+    }
+  }
+  if (!matched) {
+    ActionResult result;
+    result.error_code = "invalid_option";
+    result.error = "No matching option. Available options: " +
+                   base::JoinString(available, ", ");
+    std::move(done).Run(std::move(result));
+    return;
+  }
+  Invoke(contents, entry,
+         base::BindOnce(
+             [](std::string value, content::RenderFrameHost&) {
+               return actor::mojom::ToolAction::NewSelect(
+                   actor::mojom::SelectAction::New(value));
+             },
+             resolved),
+         std::move(done));
+}
+
+void RendererTools::Scroll(content::WebContents* contents,
+                           const RefEntry* entry,
+                           int dx,
+                           int dy,
+                           DoneCallback done) {
+  // Decompose into a single-axis scroll; prefer the larger axis.
+  actor::mojom::ScrollAction::ScrollDirection dir;
+  float distance;
+  if (std::abs(dy) >= std::abs(dx)) {
+    dir = dy >= 0 ? actor::mojom::ScrollAction::ScrollDirection::kDown
+                  : actor::mojom::ScrollAction::ScrollDirection::kUp;
+    distance = static_cast<float>(std::abs(dy));
+  } else {
+    dir = dx >= 0 ? actor::mojom::ScrollAction::ScrollDirection::kRight
+                  : actor::mojom::ScrollAction::ScrollDirection::kLeft;
+    distance = static_cast<float>(std::abs(dx));
+  }
+  if (distance <= 0) {
+    ActionResult ok;
+    ok.ok = true;
+    std::move(done).Run(std::move(ok));
+    return;
+  }
+
+  RefEntry viewport;
+  viewport.key.dom_node_id = actor::kRootElementDomNodeId;
+  if (entry) {
+    Invoke(contents, *entry,
+           base::BindOnce(
+               [](actor::mojom::ScrollAction::ScrollDirection dir,
+                  float distance, content::RenderFrameHost&) {
+                 return actor::mojom::ToolAction::NewScroll(
+                     actor::mojom::ScrollAction::New(dir, distance));
+               },
+               dir, distance),
+           std::move(done));
+    return;
+  }
+  // Viewport scroll: use primary main frame local root + root DOM id.
+  if (!contents || !contents->GetPrimaryMainFrame()) {
+    ActionResult fail;
+    fail.error_code = "no_frame";
+    fail.error = "No frame available to scroll.";
+    std::move(done).Run(std::move(fail));
+    return;
+  }
+  viewport.key.document_token =
+      "";  // Resolve via primary frame below in Invoke path.
+  content::RenderFrameHost* local_root =
+      LocalRootFor(contents->GetPrimaryMainFrame());
+  if (!local_root) {
+    ActionResult fail;
+    fail.error_code = "no_frame";
+    fail.error = "No local root for scroll.";
+    std::move(done).Run(std::move(fail));
+    return;
+  }
+  frame_remote_.reset();
+  local_root->GetRemoteAssociatedInterfaces()->GetInterface(&frame_remote_);
+  active_task_id_ = actor::TaskId::FromUnsafeValue(++next_task_id_);
+  auto invocation = actor::mojom::ToolInvocation::New();
+  invocation->task_id = active_task_id_;
+  invocation->action = actor::mojom::ToolAction::NewScroll(
+      actor::mojom::ScrollAction::New(dir, distance));
+  invocation->target =
+      actor::mojom::ToolTarget::NewDomNodeId(actor::kRootElementDomNodeId);
+  const int generation = cancel_generation_;
+  frame_remote_->InvokeTool(std::move(invocation),
+                            mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                                base::BindOnce(&RendererTools::OnToolResult,
+                                               weak_factory_.GetWeakPtr(),
+                                               std::move(done), generation),
+                                nullptr));
+}
+
+void RendererTools::Invoke(content::WebContents* contents,
+                           const RefEntry& entry,
+                           ToolBuilder builder,
+                           DoneCallback done) {
+  content::RenderFrameHost* local_root = ResolveFrame(contents, entry);
+  if (!local_root) {
+    ActionResult fail;
+    fail.error_code = "stale_ref";
+    fail.error =
+        entry.ref + " belongs to a document that is gone. Take a new snapshot.";
+    std::move(done).Run(std::move(fail));
+    return;
+  }
+  if (entry.outer_box.IsEmpty() && entry.visible_box.IsEmpty()) {
+    ActionResult fail;
+    fail.error_code = "stale_ref";
+    fail.error = "Missing geometry for " + entry.ref +
+                 "; take a fresh snapshot before acting.";
+    std::move(done).Run(std::move(fail));
+    return;
+  }
+
+  frame_remote_.reset();
+  local_root->GetRemoteAssociatedInterfaces()->GetInterface(&frame_remote_);
+
+  active_task_id_ = actor::TaskId::FromUnsafeValue(++next_task_id_);
+  auto invocation = actor::mojom::ToolInvocation::New();
+  invocation->task_id = active_task_id_;
+  invocation->action = std::move(builder).Run(*local_root);
+  invocation->target =
+      actor::mojom::ToolTarget::NewDomNodeId(entry.key.dom_node_id);
+  invocation->observed_target = MakeObservedTarget(entry, *local_root);
+
+  const int generation = cancel_generation_;
+  frame_remote_->InvokeTool(std::move(invocation),
+                            mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                                base::BindOnce(&RendererTools::OnToolResult,
+                                               weak_factory_.GetWeakPtr(),
+                                               std::move(done), generation),
+                                nullptr));
+}
+
+void RendererTools::OnToolResult(DoneCallback done,
+                                 int generation,
+                                 actor::mojom::ActionResultPtr result) {
+  if (generation != cancel_generation_) {
+    ActionResult cancelled;
+    cancelled.error_code = "cancelled";
+    cancelled.error = "Action cancelled.";
+    cancelled.may_have_acted = true;
+    std::move(done).Run(std::move(cancelled));
+    return;
+  }
+  frame_remote_.reset();
+  std::move(done).Run(FromMojo(std::move(result)));
+}
+
+}  // namespace rac::agent

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/tool_registry.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::agent {
+
+TEST(ToolRegistryTest, CatalogContainsReadAndActionTools) {
+  auto tools = GetToolDefinitions();
+  EXPECT_GE(tools.size(), 14u);
+  EXPECT_TRUE(FindToolDefinition("snapshot"));
+  EXPECT_TRUE(FindToolDefinition("click"));
+  EXPECT_TRUE(FindToolDefinition("navigate"));
+  EXPECT_TRUE(FindToolDefinition("wait_for_settle"));
+  EXPECT_EQ(FindToolDefinition("snapshot")->kind, ToolKind::kRead);
+  EXPECT_EQ(FindToolDefinition("click")->kind, ToolKind::kAction);
+}
+
+TEST(ToolRegistryTest, ValidatesUrlSchemes) {
+  EXPECT_TRUE(IsAllowedAgentUrl("https://example.com/a"));
+  EXPECT_TRUE(IsAllowedAgentUrl("http://127.0.0.1:8771/login.html"));
+  EXPECT_FALSE(IsAllowedAgentUrl("chrome://settings"));
+  EXPECT_FALSE(IsAllowedAgentUrl("file:///tmp/x"));
+  EXPECT_FALSE(IsAllowedAgentUrl("javascript:alert(1)"));
+  EXPECT_FALSE(IsAllowedAgentUrl("data:text/html,hi"));
+
+  const ToolDefinition* nav = FindToolDefinition("navigate");
+  ASSERT_TRUE(nav);
+  base::DictValue bad;
+  bad.Set("url", "chrome://version");
+  EXPECT_TRUE(ValidateToolArguments(*nav, bad).has_value());
+  base::DictValue good;
+  good.Set("url", "https://example.com");
+  EXPECT_FALSE(ValidateToolArguments(*nav, good).has_value());
+}
+
+TEST(ToolRegistryTest, RequiresRefForClick) {
+  const ToolDefinition* click = FindToolDefinition("click");
+  ASSERT_TRUE(click);
+  EXPECT_TRUE(ValidateToolArguments(*click, base::DictValue()).has_value());
+  base::DictValue args;
+  args.Set("ref", "e12");
+  EXPECT_FALSE(ValidateToolArguments(*click, args).has_value());
+}
+
+TEST(ToolRegistryTest, RiskClassifier) {
+  ActionRiskInput low;
+  low.tool_name = "click";
+  low.element_role = "button";
+  low.element_name = "Cancel";
+  EXPECT_EQ(ClassifyActionRisk(low), RiskClass::kLow);
+
+  ActionRiskInput buy;
+  buy.tool_name = "click";
+  buy.element_role = "button";
+  buy.button_text = "Buy now";
+  EXPECT_EQ(ClassifyActionRisk(buy), RiskClass::kConsequential);
+
+  ActionRiskInput password;
+  password.tool_name = "type";
+  password.is_password_field = true;
+  EXPECT_EQ(ClassifyActionRisk(password), RiskClass::kConsequential);
+
+  ActionRiskInput cross;
+  cross.tool_name = "click";
+  cross.cross_origin = true;
+  EXPECT_EQ(ClassifyActionRisk(cross), RiskClass::kConsequential);
+
+  ActionRiskInput nav;
+  nav.tool_name = "navigate";
+  EXPECT_EQ(ClassifyActionRisk(nav), RiskClass::kConsequential);
+}
+
+}  // namespace rac::agent

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+// Draft for patch 02 — will be quilt-added after 01 commits.
+
+#ifndef CHROME_BROWSER_RAC_AGENT_TOOL_REGISTRY_H_
+#define CHROME_BROWSER_RAC_AGENT_TOOL_REGISTRY_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+namespace rac::agent {
+
+enum class ToolKind { kRead, kAction };
+
+enum class RiskClass {
+  kNone,           // Read tools.
+  kLow,            // Click/type/scroll inside allowed origins.
+  kConsequential,  // Submit/buy/delete/password/cross-origin/etc.
+};
+
+struct ToolDefinition {
+  std::string name;
+  std::string description;
+  ToolKind kind = ToolKind::kRead;
+  RiskClass default_risk = RiskClass::kNone;
+  // JSON Schema object as a base::DictValue (type/properties/required).
+  base::DictValue parameters;
+};
+
+struct ToolCall {
+  std::string id;
+  std::string name;
+  base::DictValue arguments;
+};
+
+struct ToolResult {
+  bool ok = false;
+  std::string error_code;
+  std::string error;
+  base::DictValue data;
+  bool may_have_acted = false;
+};
+
+struct ActionRiskInput {
+  std::string tool_name;
+  std::string element_role;
+  std::string element_name;
+  std::string control_type;
+  std::string input_type;  // password, text, email, …
+  std::string button_text;
+  std::string current_origin;
+  std::string target_origin;  // Navigate / link destination origin.
+  bool is_password_field = false;
+  bool is_payment_field = false;
+  bool is_file_input = false;
+  bool cross_origin = false;
+};
+
+// Catalog shared by the MCP server and the direct tool loop.
+std::vector<ToolDefinition> GetToolDefinitions();
+const ToolDefinition* FindToolDefinition(std::string_view name);
+
+// Validates arguments against the tool's JSON schema (required keys, types,
+// URL scheme allowlist). Returns nullopt on success.
+std::optional<std::string> ValidateToolArguments(const ToolDefinition& def,
+                                                 const base::DictValue& args);
+
+RiskClass ClassifyActionRisk(const ActionRiskInput& input);
+
+// True for http/https only. Rejects chrome://, file, javascript, data, etc.
+bool IsAllowedAgentUrl(std::string_view url);
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_TOOL_REGISTRY_H_

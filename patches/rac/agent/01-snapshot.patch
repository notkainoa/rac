+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/ref_table.h"
+
+#include <algorithm>
+#include <limits>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace rac::agent {
+
+RefTable::RefTable() : RefTable(kDefaultMaxEntries) {}
+
+RefTable::RefTable(size_t max_entries) : max_entries_(max_entries) {}
+
+RefTable::~RefTable() = default;
+
+std::string RefTable::AllocateRef() {
+  CHECK_LT(next_number_, std::numeric_limits<uint64_t>::max());
+  return "e" + base::NumberToString(next_number_++);
+}
+
+std::string RefTable::GetOrCreate(const RefKey& key, RefEntry meta) {
+  if (auto it = by_key_.find(key); it != by_key_.end()) {
+    RefEntry* existing = LookupMutable(it->second);
+    CHECK(existing);
+    const std::string ref = existing->ref;
+    meta.ref = ref;
+    meta.key = key;
+    meta.snapshot_generation = existing->snapshot_generation;
+    *existing = std::move(meta);
+    existing->present_in_latest = true;
+    return ref;
+  }
+  EvictIfNeeded();
+  std::string ref = AllocateRef();
+  meta.ref = ref;
+  meta.key = key;
+  meta.present_in_latest = true;
+  by_key_[key] = ref;
+  by_ref_[ref] = std::move(meta);
+  return ref;
+}
+
+const RefEntry* RefTable::Lookup(std::string_view ref) const {
+  auto it = by_ref_.find(std::string(ref));
+  return it == by_ref_.end() ? nullptr : &it->second;
+}
+
+RefEntry* RefTable::LookupMutable(std::string_view ref) {
+  auto it = by_ref_.find(std::string(ref));
+  return it == by_ref_.end() ? nullptr : &it->second;
+}
+
+void RefTable::BeginSnapshot(std::string_view tab_id, uint64_t generation) {
+  for (auto& [ref, entry] : by_ref_) {
+    if (entry.key.tab_id == tab_id) {
+      entry.present_in_latest = false;
+      entry.in_viewport = false;
+      entry.snapshot_generation = generation;
+    }
+  }
+}
+
+void RefTable::MarkSeen(std::string_view ref, bool in_viewport) {
+  if (RefEntry* entry = LookupMutable(ref)) {
+    entry->present_in_latest = true;
+    entry->last_seen_generation = entry->snapshot_generation;
+    entry->in_viewport = in_viewport;
+  }
+}
+
+void RefTable::EndSnapshot(std::string_view tab_id) {
+  // Absent entries keep their refs but are not actionable until re-seen.
+}
+
+void RefTable::InvalidateDocument(std::string_view tab_id,
+                                  std::string_view document_token) {
+  std::vector<std::string> dead;
+  for (const auto& [ref, entry] : by_ref_) {
+    if (entry.key.tab_id == tab_id &&
+        entry.key.document_token == document_token) {
+      dead.push_back(ref);
+    }
+  }
+  for (const std::string& ref : dead) {
+    auto it = by_ref_.find(ref);
+    if (it == by_ref_.end()) {
+      continue;
+    }
+    by_key_.erase(it->second.key);
+    by_ref_.erase(it);
+  }
+}
+
+void RefTable::InvalidateTab(std::string_view tab_id) {
+  std::vector<std::string> dead;
+  for (const auto& [ref, entry] : by_ref_) {
+    if (entry.key.tab_id == tab_id) {
+      dead.push_back(ref);
+    }
+  }
+  for (const std::string& ref : dead) {
+    auto it = by_ref_.find(ref);
+    if (it == by_ref_.end()) {
+      continue;
+    }
+    by_key_.erase(it->second.key);
+    by_ref_.erase(it);
+  }
+}
+
+void RefTable::Clear() {
+  by_ref_.clear();
+  by_key_.clear();
+  next_number_ = 1;
+}
+
+void RefTable::EvictIfNeeded() {
+  while (by_ref_.size() >= max_entries_) {
+    auto oldest = by_ref_.end();
+    for (auto it = by_ref_.begin(); it != by_ref_.end(); ++it) {
+      if (!it->second.present_in_latest &&
+          (oldest == by_ref_.end() ||
+           it->second.last_seen_generation <
+               oldest->second.last_seen_generation)) {
+        oldest = it;
+      }
+    }
+    if (oldest == by_ref_.end()) {
+      oldest = by_ref_.begin();
+    }
+    by_key_.erase(oldest->second.key);
+    by_ref_.erase(oldest);
+  }
+}
+
+}  // namespace rac::agent

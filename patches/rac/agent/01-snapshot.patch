+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_AGENT_REF_TABLE_H_
+#define CHROME_BROWSER_RAC_AGENT_REF_TABLE_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/flat_map.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace rac::agent {
+
+// Stable agent-visible element id ("e12") for one session. Keyed on
+// (tab_id, document_token, dom_node_id). Numbers never recycle.
+struct RefKey {
+  std::string tab_id;
+  std::string document_token;
+  int32_t dom_node_id = 0;
+
+  bool operator<(const RefKey& o) const {
+    if (tab_id != o.tab_id) {
+      return tab_id < o.tab_id;
+    }
+    if (document_token != o.document_token) {
+      return document_token < o.document_token;
+    }
+    return dom_node_id < o.dom_node_id;
+  }
+  bool operator==(const RefKey& o) const {
+    return tab_id == o.tab_id && document_token == o.document_token &&
+           dom_node_id == o.dom_node_id;
+  }
+};
+
+struct SelectOption {
+  std::string value;
+  std::string label;
+  bool disabled = false;
+};
+
+struct RefEntry {
+  std::string ref;  // e1, e2, …
+  RefKey key;
+  uint64_t snapshot_generation = 0;
+  uint64_t last_seen_generation = 0;
+  std::string role;
+  std::string name;
+  std::string control_type;
+  std::vector<SelectOption> select_options;
+  std::string frame_origin;
+  std::string main_origin;
+  std::string link_url;
+  std::string policy_fingerprint;
+  gfx::Rect outer_box;
+  gfx::Rect visible_box;
+  bool disabled = false;
+  bool readonly = false;
+  bool sensitive = false;
+  bool password = false;
+  bool present_in_latest = false;
+  bool in_viewport = false;
+};
+
+class RefTable {
+ public:
+  static constexpr size_t kDefaultMaxEntries = 4096;
+
+  RefTable();
+  explicit RefTable(size_t max_entries);
+  RefTable(const RefTable&) = delete;
+  RefTable& operator=(const RefTable&) = delete;
+  ~RefTable();
+
+  // Returns an existing ref or allocates e{N+1}. Eviction marks the oldest
+  // unused entry invalid; numbers are never reused.
+  std::string GetOrCreate(const RefKey& key, RefEntry meta);
+
+  const RefEntry* Lookup(std::string_view ref) const;
+  RefEntry* LookupMutable(std::string_view ref);
+
+  // Call at the start of a snapshot pass for `tab_id`.
+  void BeginSnapshot(std::string_view tab_id, uint64_t generation);
+  void MarkSeen(std::string_view ref, bool in_viewport);
+  void EndSnapshot(std::string_view tab_id);
+
+  void InvalidateDocument(std::string_view tab_id,
+                          std::string_view document_token);
+  void InvalidateTab(std::string_view tab_id);
+  void Clear();
+
+  size_t size() const { return by_ref_.size(); }
+  uint64_t next_ref_number() const { return next_number_; }
+
+ private:
+  std::string AllocateRef();
+  void EvictIfNeeded();
+
+  size_t max_entries_;
+  uint64_t next_number_ = 1;
+  base::flat_map<std::string, RefEntry> by_ref_;
+  base::flat_map<RefKey, std::string> by_key_;
+};
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_REF_TABLE_H_

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/snapshot_serializer.h"
+
+#include <algorithm>
+#include <cmath>
+#include <ranges>
+#include <utility>
+
+#include "base/hash/sha1.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/optimization_guide/proto/features/common_quality_data.pb.h"
+#include "url/gurl.h"
+
+namespace rac::agent {
+namespace {
+namespace proto = optimization_guide::proto;
+constexpr int kMaxDepth = 128;
+
+std::string Clean(std::string_view text) {
+  std::string repaired = base::IsStringUTF8(text)
+                             ? std::string(text)
+                             : base::UTF16ToUTF8(base::UTF8ToUTF16(text));
+  return base::CollapseWhitespaceASCII(repaired, false);
+}
+
+bool HasVisibleBox(const proto::ContentNode& node) {
+  const auto& a = node.content_attributes();
+  if (!a.has_geometry() || !a.geometry().has_visible_bounding_box()) {
+    return false;
+  }
+  const auto& box = a.geometry().visible_bounding_box();
+  return box.width() > 0 && box.height() > 0;
+}
+
+bool HasHitBox(const proto::ContentNode& node) {
+  const auto& a = node.content_attributes();
+  if (!a.has_geometry() || !a.geometry().has_outer_bounding_box()) {
+    return false;
+  }
+  const auto& box = a.geometry().outer_bounding_box();
+  return box.width() > 0 && box.height() > 0;
+}
+
+// Agent walks must keep offscreen (empty visible box) nodes so full:true and
+// stable refs work. Chat's IsPageNodeHidden treats empty visible as hidden.
+bool IsAgentNodeExcluded(const proto::ContentNode& node) {
+  const auto& a = node.content_attributes();
+  if (std::ranges::find(a.annotated_roles(),
+                        proto::ANNOTATED_ROLE_CONTENT_HIDDEN) !=
+      a.annotated_roles().end()) {
+    return true;
+  }
+  if (a.has_interaction_info()) {
+    const auto& reasons = a.interaction_info().interaction_disabled_reasons();
+    if (std::ranges::find(reasons,
+                          proto::INTERACTION_DISABLED_REASON_ARIA_HIDDEN) !=
+        reasons.end()) {
+      return true;
+    }
+  }
+  if (a.has_geometry() && a.geometry().has_outer_bounding_box()) {
+    const auto& box = a.geometry().outer_bounding_box();
+    if (box.width() <= 0 || box.height() <= 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+gfx::Rect ToRect(const proto::BoundingRect& box) {
+  return gfx::Rect(box.x(), box.y(), box.width(), box.height());
+}
+
+std::string CollectText(const proto::ContentNode& node, int depth = 0) {
+  if (depth > kMaxDepth || IsAgentNodeExcluded(node)) {
+    return {};
+  }
+  const auto& a = node.content_attributes();
+  if (a.has_text_data()) {
+    return Clean(a.text_data().text_content());
+  }
+  if (a.has_image_data()) {
+    return Clean(a.image_data().image_caption());
+  }
+  std::string out;
+  for (const auto& child : node.children_nodes()) {
+    std::string part = CollectText(child, depth + 1);
+    if (part.empty()) {
+      continue;
+    }
+    if (!out.empty()) {
+      out += ' ';
+    }
+    out += part;
+  }
+  return out;
+}
+
+bool IsPasswordControl(const proto::FormControlData& control) {
+  return control.form_control_type() == proto::FORM_CONTROL_TYPE_INPUT_PASSWORD;
+}
+
+bool IsRedactedDecision(proto::RedactionDecision d) {
+  switch (d) {
+    case proto::REDACTION_DECISION_REDACTED_HAS_BEEN_PASSWORD:
+    case proto::REDACTION_DECISION_REDACTED_IS_SENSITIVE_PAYMENT_FIELD:
+    case proto::REDACTION_DECISION_REDACTED_CUSTOM_PASSWORD_CSS:
+    case proto::REDACTION_DECISION_REDACTED_CUSTOM_PASSWORD_JS:
+    case proto::REDACTION_DECISION_REDACTED_IS_OTP:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool IsSensitiveControl(const proto::ContentAttributes& a) {
+  if (a.has_redaction_decision() &&
+      IsRedactedDecision(a.redaction_decision())) {
+    return true;
+  }
+  if (!a.has_form_control_data()) {
+    return false;
+  }
+  const auto& c = a.form_control_data();
+  if (IsPasswordControl(c)) {
+    return true;
+  }
+  for (int t : c.coarse_autofill_field_type()) {
+    if (t == proto::COARSE_AUTOFILL_FIELD_TYPE_CREDIT_CARD ||
+        t == proto::COARSE_AUTOFILL_FIELD_TYPE_OTP) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string FormControlRole(const proto::FormControlData& control) {
+  switch (control.form_control_type()) {
+    case proto::FORM_CONTROL_TYPE_INPUT_CHECKBOX:
+      return "checkbox";
+    case proto::FORM_CONTROL_TYPE_INPUT_RADIO:
+      return "radio";
+    case proto::FORM_CONTROL_TYPE_SELECT_ONE:
+    case proto::FORM_CONTROL_TYPE_SELECT_MULTIPLE:
+      return "combobox";
+    case proto::FORM_CONTROL_TYPE_TEXT_AREA:
+      return "textbox";
+    case proto::FORM_CONTROL_TYPE_BUTTON_BUTTON:
+    case proto::FORM_CONTROL_TYPE_BUTTON_RESET:
+    case proto::FORM_CONTROL_TYPE_BUTTON_POPOVER:
+    case proto::FORM_CONTROL_TYPE_INPUT_BUTTON:
+    case proto::FORM_CONTROL_TYPE_INPUT_IMAGE:
+      return "button";
+    case proto::FORM_CONTROL_TYPE_BUTTON_SUBMIT:
+    case proto::FORM_CONTROL_TYPE_INPUT_SUBMIT:
+      return "button";
+    case proto::FORM_CONTROL_TYPE_INPUT_FILE:
+      return "button";
+    case proto::FORM_CONTROL_TYPE_INPUT_PASSWORD:
+      return "textbox";
+    case proto::FORM_CONTROL_TYPE_FIELDSET:
+      return {};
+    case proto::FORM_CONTROL_TYPE_INPUT_HIDDEN:
+      return {};
+    default:
+      return "textbox";
+  }
+}
+
+std::string ControlTypeName(const proto::FormControlData& control) {
+  return base::NumberToString(static_cast<int>(control.form_control_type()));
+}
+
+std::string ControlName(const proto::ContentAttributes& a,
+                        const proto::ContentNode& node) {
+  std::string name = Clean(a.label());
+  if (!name.empty()) {
+    return name;
+  }
+  if (a.has_form_control_data()) {
+    const auto& c = a.form_control_data();
+    name = Clean(c.field_name());
+    if (name.empty()) {
+      name = Clean(c.placeholder());
+    }
+  }
+  if (name.empty()) {
+    name = CollectText(node);
+  }
+  return name;
+}
+
+std::string SafeFieldValue(const proto::ContentAttributes& a) {
+  if (!a.has_form_control_data() || IsSensitiveControl(a) ||
+      (a.has_form_control_data() && IsPasswordControl(a.form_control_data()))) {
+    return {};
+  }
+  return Clean(a.form_control_data().field_value());
+}
+
+bool IsActionable(const proto::ContentNode& node) {
+  if (IsAgentNodeExcluded(node) || !HasHitBox(node)) {
+    return false;
+  }
+  const auto& a = node.content_attributes();
+  if (!a.has_common_ancestor_dom_node_id()) {
+    return false;
+  }
+  switch (a.attribute_type()) {
+    case proto::CONTENT_ATTRIBUTE_ANCHOR:
+    case proto::CONTENT_ATTRIBUTE_FORM_CONTROL:
+      return true;
+    case proto::CONTENT_ATTRIBUTE_HEADING:
+    case proto::CONTENT_ATTRIBUTE_LIST_ITEM:
+      return true;
+    default:
+      break;
+  }
+  if (a.has_interaction_info()) {
+    const auto& info = a.interaction_info();
+    if (info.is_focusable() || info.is_clickable() ||
+        !info.clickability_reasons().empty()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+struct WalkContext {
+  RefTable* refs = nullptr;
+  SnapshotOptions options;
+  uint64_t generation = 0;
+  std::string document_token;
+  std::string frame_origin;
+  std::string main_origin;
+  std::vector<SnapshotLine>* lines = nullptr;
+  size_t used_chars = 0;
+};
+
+bool AppendLine(WalkContext& ctx, SnapshotLine line) {
+  const size_t need = line.text.size() + (ctx.lines->empty() ? 0 : 1);
+  if (ctx.used_chars + need > ctx.options.max_chars) {
+    return false;
+  }
+  ctx.used_chars += need;
+  ctx.lines->push_back(std::move(line));
+  return true;
+}
+
+std::string SemanticHash(std::string_view line_text) {
+  return base::SHA1HashString(std::string(line_text));
+}
+
+void EmitInteractive(WalkContext& ctx,
+                     const proto::ContentNode& node,
+                     std::string_view role,
+                     std::string_view name,
+                     std::string_view extra) {
+  const auto& a = node.content_attributes();
+  if (!a.has_common_ancestor_dom_node_id()) {
+    return;
+  }
+  const bool in_viewport = HasVisibleBox(node);
+
+  RefKey key;
+  key.tab_id = ctx.options.tab_id;
+  key.document_token = ctx.document_token;
+  key.dom_node_id = a.common_ancestor_dom_node_id();
+
+  RefEntry meta;
+  meta.role = std::string(role);
+  meta.name = std::string(name);
+  meta.frame_origin = ctx.frame_origin;
+  meta.main_origin = ctx.main_origin;
+  meta.disabled =
+      a.has_interaction_info() && a.interaction_info().is_disabled();
+  if (a.has_form_control_data()) {
+    meta.control_type = ControlTypeName(a.form_control_data());
+    meta.password = IsPasswordControl(a.form_control_data());
+    meta.readonly = a.form_control_data().is_readonly();
+    for (const auto& option : a.form_control_data().select_options()) {
+      meta.select_options.push_back(
+          {option.value(), option.text(), option.is_disabled()});
+    }
+  }
+  meta.sensitive = IsSensitiveControl(a);
+  if (a.has_anchor_data()) {
+    meta.link_url = a.anchor_data().url();
+  }
+  if (a.has_geometry()) {
+    if (a.geometry().has_outer_bounding_box()) {
+      meta.outer_box = ToRect(a.geometry().outer_bounding_box());
+    }
+    if (a.geometry().has_visible_bounding_box()) {
+      meta.visible_box = ToRect(a.geometry().visible_bounding_box());
+    }
+  }
+  meta.policy_fingerprint =
+      MakePolicyFingerprint(meta.role, meta.name, meta.control_type,
+                            meta.password, meta.sensitive, meta.link_url);
+  meta.snapshot_generation = ctx.generation;
+  meta.last_seen_generation = ctx.generation;
+  meta.in_viewport = in_viewport;
+
+  const std::string ref = ctx.refs->GetOrCreate(key, std::move(meta));
+  ctx.refs->MarkSeen(ref, in_viewport);
+
+  if (!ctx.options.full && !in_viewport) {
+    return;
+  }
+
+  std::string line = base::StrCat(
+      {"- ", role, " \"", EscapeSnapshotText(name), "\" [ref=", ref, "]"});
+  if (!extra.empty()) {
+    line = base::StrCat({line, extra});
+  }
+  if (a.has_interaction_info() && a.interaction_info().is_disabled()) {
+    line += " [disabled]";
+  }
+
+  SnapshotLine snap;
+  snap.ref = ref;
+  snap.text = std::move(line);
+  snap.semantic_hash = SemanticHash(snap.text);
+  AppendLine(ctx, std::move(snap));
+}
+
+void Walk(WalkContext& ctx, const proto::ContentNode& node, int depth);
+
+void WalkChildren(WalkContext& ctx, const proto::ContentNode& node, int depth) {
+  for (const auto& child : node.children_nodes()) {
+    Walk(ctx, child, depth + 1);
+  }
+}
+
+void Walk(WalkContext& ctx, const proto::ContentNode& node, int depth) {
+  if (depth > kMaxDepth || IsAgentNodeExcluded(node)) {
+    return;
+  }
+  const auto& a = node.content_attributes();
+
+  if (a.attribute_type() == proto::CONTENT_ATTRIBUTE_IFRAME) {
+    if (a.has_iframe_data() && a.iframe_data().has_frame_data() &&
+        a.iframe_data().frame_data().has_document_identifier()) {
+      WalkContext child = ctx;
+      child.document_token =
+          a.iframe_data().frame_data().document_identifier().serialized_token();
+      if (a.iframe_data().frame_data().has_url()) {
+        const GURL frame_url(a.iframe_data().frame_data().url());
+        if (frame_url.is_valid()) {
+          child.frame_origin = frame_url.GetWithEmptyPath().spec();
+          while (!child.frame_origin.empty() &&
+                 child.frame_origin.back() == '/') {
+            child.frame_origin.pop_back();
+          }
+        }
+      }
+      WalkChildren(child, node, depth);
+      return;
+    }
+    // Redacted / unavailable iframe: no refs inside.
+    SnapshotLine line;
+    line.text = "- iframe [redacted]";
+    line.semantic_hash = SemanticHash(line.text);
+    AppendLine(ctx, std::move(line));
+    return;
+  }
+
+  if (a.attribute_type() == proto::CONTENT_ATTRIBUTE_HEADING) {
+    const std::string name = CollectText(node);
+    if (!name.empty() && a.has_common_ancestor_dom_node_id() &&
+        (ctx.options.full || HasVisibleBox(node))) {
+      EmitInteractive(ctx, node, "heading", name, {});
+    }
+    WalkChildren(ctx, node, depth);
+    return;
+  }
+
+  if (a.attribute_type() == proto::CONTENT_ATTRIBUTE_ORDERED_LIST ||
+      a.attribute_type() == proto::CONTENT_ATTRIBUTE_UNORDERED_LIST) {
+    WalkChildren(ctx, node, depth);
+    return;
+  }
+
+  if (a.attribute_type() == proto::CONTENT_ATTRIBUTE_LIST_ITEM) {
+    const std::string name = CollectText(node);
+    if (!name.empty() && a.has_common_ancestor_dom_node_id() &&
+        (ctx.options.full || HasVisibleBox(node)) && IsActionable(node)) {
+      EmitInteractive(ctx, node, "listitem", name, {});
+    } else {
+      WalkChildren(ctx, node, depth);
+    }
+    return;
+  }
+
+  if (a.attribute_type() == proto::CONTENT_ATTRIBUTE_ANCHOR) {
+    const std::string name = ControlName(a, node);
+    std::string extra;
+    if (a.has_anchor_data()) {
+      const GURL url(a.anchor_data().url());
+      if (url.SchemeIsHTTPOrHTTPS()) {
+        std::string target = base::StrCat({url.host(), url.path()});
+        base::TruncateUTF8ToByteSize(target, 100, &target);
+        extra = base::StrCat({" -> ", EscapeSnapshotText(target, 100)});
+      }
+    }
+    if (IsActionable(node)) {
+      EmitInteractive(ctx, node, "link", name.empty() ? "link" : name, extra);
+    }
+    return;
+  }
+
+  if (a.attribute_type() == proto::CONTENT_ATTRIBUTE_FORM_CONTROL &&
+      a.has_form_control_data()) {
+    const auto& control = a.form_control_data();
+    const std::string role = FormControlRole(control);
+    if (role.empty() || !IsActionable(node)) {
+      WalkChildren(ctx, node, depth);
+      return;
+    }
+    const std::string name = ControlName(a, node);
+    std::string extra;
+    if (role == "textbox") {
+      if (IsPasswordControl(control) || IsSensitiveControl(a)) {
+        extra = ": [redacted]";
+      } else {
+        const std::string value = SafeFieldValue(a);
+        if (!value.empty()) {
+          extra = base::StrCat({": ", EscapeSnapshotText(value)});
+        }
+      }
+    } else if (role == "checkbox" || role == "radio") {
+      extra = control.is_checked() ? " [checked]" : " [unchecked]";
+    } else if (role == "combobox") {
+      std::vector<std::string> opts;
+      for (const auto& opt : control.select_options()) {
+        if (opt.is_disabled()) {
+          continue;
+        }
+        std::string label = Clean(opt.text());
+        if (label.empty()) {
+          label = Clean(opt.value());
+        }
+        if (opt.is_selected()) {
+          opts.push_back("*" + EscapeSnapshotText(label, 40));
+        } else {
+          opts.push_back(EscapeSnapshotText(label, 40));
+        }
+        if (opts.size() >= 8) {
+          opts.push_back("…");
+          break;
+        }
+      }
+      if (!opts.empty()) {
+        extra = base::StrCat({": [", base::JoinString(opts, "|"), "]"});
+      }
+    } else if (control.form_control_type() ==
+                   proto::FORM_CONTROL_TYPE_BUTTON_SUBMIT ||
+               control.form_control_type() ==
+                   proto::FORM_CONTROL_TYPE_INPUT_SUBMIT) {
+      extra = " [submit]";
+    }
+    EmitInteractive(ctx, node, role, name.empty() ? role : name, extra);
+    return;
+  }
+
+  // Generic clickable containers with a DOM id.
+  if (IsActionable(node) && a.has_interaction_info() &&
+      (a.interaction_info().is_clickable() ||
+       !a.interaction_info().clickability_reasons().empty()) &&
+      a.attribute_type() != proto::CONTENT_ATTRIBUTE_ROOT &&
+      a.attribute_type() != proto::CONTENT_ATTRIBUTE_CONTAINER &&
+      a.attribute_type() != proto::CONTENT_ATTRIBUTE_FORM &&
+      a.attribute_type() != proto::CONTENT_ATTRIBUTE_PARAGRAPH) {
+    const std::string name = CollectText(node);
+    EmitInteractive(ctx, node, "button", name.empty() ? "clickable" : name, {});
+    return;
+  }
+
+  WalkChildren(ctx, node, depth);
+}
+
+std::string JoinLines(const std::vector<SnapshotLine>& lines) {
+  std::vector<std::string> texts;
+  texts.reserve(lines.size());
+  for (const auto& line : lines) {
+    texts.push_back(line.text);
+  }
+  return base::JoinString(texts, "\n");
+}
+
+std::string BuildDelta(const AgentSnapshot& previous,
+                       const std::vector<SnapshotLine>& current) {
+  base::flat_map<std::string, std::string> prev_by_ref;
+  for (const auto& line : previous.lines) {
+    if (!line.ref.empty()) {
+      prev_by_ref[line.ref] = line.semantic_hash;
+    }
+  }
+  std::vector<std::string> out;
+  bool any_change = false;
+  std::vector<std::string> current_order;
+  std::vector<std::string> previous_order;
+  for (const auto& line : previous.lines) {
+    previous_order.push_back(line.ref);
+  }
+  for (const auto& line : current) {
+    current_order.push_back(line.ref);
+    if (!line.ref.empty()) {
+      auto it = prev_by_ref.find(line.ref);
+      if (it != prev_by_ref.end() && it->second == line.semantic_hash) {
+        prev_by_ref.erase(it);
+        out.push_back(base::StrCat({"- unchanged [ref=", line.ref, "]"}));
+        continue;
+      }
+    }
+    any_change = true;
+    prev_by_ref.erase(line.ref);
+    out.push_back(line.text);
+  }
+  for (const auto& [ref, hash] : prev_by_ref) {
+    out.push_back("- removed [ref=" + ref + "]");
+  }
+  if (!any_change && prev_by_ref.empty() && current_order == previous_order) {
+    return "unchanged";
+  }
+  return base::JoinString(out, "\n");
+}
+
+}  // namespace
+
+std::string EscapeSnapshotText(std::string_view text, size_t max_len) {
+  std::string cleaned = Clean(text);
+  std::string out;
+  out.reserve(cleaned.size());
+  for (char c : cleaned) {
+    if (c == '"' || c == '\\') {
+      out.push_back('\\');
+      out.push_back(c);
+    } else if (c == '\n' || c == '\r' || c == '\t') {
+      out.push_back(' ');
+    } else if (static_cast<unsigned char>(c) < 0x20) {
+      continue;
+    } else {
+      out.push_back(c);
+    }
+  }
+  base::TruncateUTF8ToByteSize(out, max_len, &out);
+  return out;
+}
+
+std::string MakePolicyFingerprint(std::string_view role,
+                                  std::string_view name,
+                                  std::string_view control_type,
+                                  bool password,
+                                  bool sensitive,
+                                  std::string_view link_url) {
+  return base::SHA1HashString(base::StrCat(
+      {role, "\n", name, "\n", control_type, "\n", password ? "1" : "0",
+       sensitive ? "1" : "0", "\n", link_url}));
+}
+
+AgentSnapshot SerializeAgentSnapshot(const proto::AnnotatedPageContent& page,
+                                     RefTable& refs,
+                                     const SnapshotOptions& options,
+                                     uint64_t snapshot_id,
+                                     const AgentSnapshot* previous) {
+  AgentSnapshot result;
+  result.snapshot_id = snapshot_id;
+  if (page.has_main_frame_data()) {
+    if (page.main_frame_data().has_title()) {
+      result.title = Clean(page.main_frame_data().title());
+    }
+    if (page.main_frame_data().has_url()) {
+      result.url = page.main_frame_data().url();
+    }
+  }
+
+  refs.BeginSnapshot(options.tab_id, snapshot_id);
+
+  WalkContext ctx;
+  ctx.refs = &refs;
+  ctx.options = options;
+  ctx.generation = snapshot_id;
+  ctx.lines = &result.lines;
+  if (page.has_main_frame_data() &&
+      page.main_frame_data().has_document_identifier()) {
+    ctx.document_token =
+        page.main_frame_data().document_identifier().serialized_token();
+  }
+  ctx.main_origin = options.main_origin;
+  if (ctx.main_origin.empty() && !result.url.empty()) {
+    const GURL url(result.url);
+    if (url.is_valid()) {
+      ctx.main_origin = url.GetWithEmptyPath().spec();
+      while (!ctx.main_origin.empty() && ctx.main_origin.back() == '/') {
+        ctx.main_origin.pop_back();
+      }
+    }
+  }
+  ctx.frame_origin = ctx.main_origin;
+
+  if (page.has_root_node()) {
+    Walk(ctx, page.root_node(), 0);
+  }
+  refs.EndSnapshot(options.tab_id);
+
+  result.line_count = result.lines.size();
+  if (!options.full && previous && previous->snapshot_id != 0 &&
+      previous->url == result.url && previous->title == result.title) {
+    result.text = BuildDelta(*previous, result.lines);
+    result.is_delta = true;
+  } else {
+    result.text = JoinLines(result.lines);
+  }
+  result.approximate_tokens = (result.text.size() + 3) / 4;
+  return result;
+}

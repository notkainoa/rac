+
+proto::ContentNode* Node(proto::ContentNode* parent,
+                         proto::ContentAttributeType type) {
+  auto* node = parent->add_children_nodes();
+  node->mutable_content_attributes()->set_attribute_type(type);
+  return node;
+}
+
+void DomId(proto::ContentNode* node, int32_t id) {
+  node->mutable_content_attributes()->set_common_ancestor_dom_node_id(id);
+}
+
+void Visible(proto::ContentNode* node) {
+  auto* box = node->mutable_content_attributes()
+                  ->mutable_geometry()
+                  ->mutable_visible_bounding_box();
+  box->set_x(0);
+  box->set_y(0);
+  box->set_width(120);
+  box->set_height(24);
+  auto* outer = node->mutable_content_attributes()
+                    ->mutable_geometry()
+                    ->mutable_outer_bounding_box();
+  *outer = *box;
+}
+
+void Offscreen(proto::ContentNode* node) {
+  auto* outer = node->mutable_content_attributes()
+                    ->mutable_geometry()
+                    ->mutable_outer_bounding_box();
+  outer->set_x(0);
+  outer->set_y(2000);
+  outer->set_width(120);
+  outer->set_height(24);
+  auto* box = node->mutable_content_attributes()
+                  ->mutable_geometry()
+                  ->mutable_visible_bounding_box();
+  box->set_width(0);
+  box->set_height(0);
+}
+
+proto::AnnotatedPageContent MakePage() {
+  proto::AnnotatedPageContent page;
+  page.mutable_main_frame_data()->set_title("Login");
+  page.mutable_main_frame_data()->set_url("https://example.com/login");
+  page.mutable_main_frame_data()
+      ->mutable_document_identifier()
+      ->set_serialized_token("doc-login");
+  page.mutable_root_node()->mutable_content_attributes()->set_attribute_type(
+      proto::CONTENT_ATTRIBUTE_ROOT);
+  return page;
+}
+}  // namespace
+
+TEST(SnapshotSerializerTest, ButtonsTextboxesLinksAndPasswordRedaction) {
+  auto page = MakePage();
+  auto* root = page.mutable_root_node();
+
+  auto* email = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  DomId(email, 3);
+  Visible(email);
+  email->mutable_content_attributes()->set_label("Email");
+  auto* email_ctl =
+      email->mutable_content_attributes()->mutable_form_control_data();
+  email_ctl->set_form_control_type(proto::FORM_CONTROL_TYPE_INPUT_EMAIL);
+  email_ctl->set_field_value("a@b.com");
+
+  auto* password = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  DomId(password, 4);
+  Visible(password);
+  password->mutable_content_attributes()->set_label("Password");
+  auto* pw_ctl =
+      password->mutable_content_attributes()->mutable_form_control_data();
+  pw_ctl->set_form_control_type(proto::FORM_CONTROL_TYPE_INPUT_PASSWORD);
+  pw_ctl->set_field_value("s3cret-value");
+  password->mutable_content_attributes()->set_redaction_decision(
+      proto::REDACTION_DECISION_REDACTED_HAS_BEEN_PASSWORD);
+
+  auto* button = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  DomId(button, 12);
+  Visible(button);
+  button->mutable_content_attributes()->set_label("Sign in");
+  auto* btn_ctl =
+      button->mutable_content_attributes()->mutable_form_control_data();
+  btn_ctl->set_form_control_type(proto::FORM_CONTROL_TYPE_BUTTON_SUBMIT);
+
+  auto* link = Node(root, proto::CONTENT_ATTRIBUTE_ANCHOR);
+  DomId(link, 7);
+  Visible(link);
+  link->mutable_content_attributes()->mutable_anchor_data()->set_url(
+      "https://example.com/docs");
+  auto* link_text = Node(link, proto::CONTENT_ATTRIBUTE_TEXT);
+  link_text->mutable_content_attributes()
+      ->mutable_text_data()
+      ->set_text_content("Docs");
+
+  RefTable refs;
+  SnapshotOptions opts;
+  opts.tab_id = "t1";
+  const AgentSnapshot snap =
+      SerializeAgentSnapshot(page, refs, opts, /*snapshot_id=*/1);
+  EXPECT_NE(snap.text.find("- textbox \"Email\" [ref=e1]: a@b.com"),
+            std::string::npos);
+  EXPECT_NE(snap.text.find("- textbox \"Password\" [ref=e2]: [redacted]"),
+            std::string::npos);
+  EXPECT_EQ(snap.text.find("s3cret"), std::string::npos);
+  EXPECT_NE(snap.text.find("- button \"Sign in\" [ref=e3] [submit]"),
+            std::string::npos);
+  EXPECT_NE(snap.text.find("- link \"Docs\" [ref=e4] -> example.com/docs"),
+            std::string::npos);
+
+  email_ctl->set_field_value("new@example.com");
+  const AgentSnapshot changed =
+      SerializeAgentSnapshot(page, refs, opts, 2, &snap);
+  EXPECT_NE(changed.text.find("new@example.com"), std::string::npos);
+  email_ctl->set_field_value("a@b.com");
+
+  // Same document + nodes keep refs across snapshots.
+  const AgentSnapshot again =
+      SerializeAgentSnapshot(page, refs, opts, /*snapshot_id=*/2, &snap);
+  EXPECT_TRUE(again.is_delta);
+  EXPECT_EQ(again.text, "unchanged");
+  EXPECT_EQ(refs.Lookup("e1")->key.dom_node_id, 3);
+  EXPECT_EQ(refs.Lookup("e3")->key.dom_node_id, 12);
+}
+
+TEST(SnapshotSerializerTest, ViewportFiltersOffscreenUnlessFull) {
+  auto page = MakePage();
+  auto* root = page.mutable_root_node();
+  auto* visible = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  DomId(visible, 1);
+  Visible(visible);
+  visible->mutable_content_attributes()->set_label("Visible");
+  visible->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_form_control_type(proto::FORM_CONTROL_TYPE_BUTTON_BUTTON);
+
+  auto* hidden = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  DomId(hidden, 2);
+  Offscreen(hidden);
+  hidden->mutable_content_attributes()->set_label("Hidden");
+  hidden->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_form_control_type(proto::FORM_CONTROL_TYPE_BUTTON_BUTTON);
+
+  RefTable refs;
+  SnapshotOptions opts;
+  AgentSnapshot viewport =
+      SerializeAgentSnapshot(page, refs, opts, /*snapshot_id=*/1);
+  EXPECT_NE(viewport.text.find("Visible"), std::string::npos);
+  EXPECT_EQ(viewport.text.find("Hidden"), std::string::npos);
+  EXPECT_NE(refs.Lookup("e2"), nullptr);  // Registered, just not emitted.
+
+  opts.full = true;
+  AgentSnapshot full =
+      SerializeAgentSnapshot(page, refs, opts, /*snapshot_id=*/2, &viewport);
+  EXPECT_FALSE(full.is_delta);
+  EXPECT_NE(full.text.find("Hidden"), std::string::npos);
+  EXPECT_EQ(refs.Lookup("e2")->ref, "e2");
+}
+
+TEST(SnapshotSerializerTest, EscapeAndFingerprint) {
+  EXPECT_EQ(EscapeSnapshotText("say \"hi\"\nthere"), "say \\\"hi\\\" there");
+  const std::string fp = MakePolicyFingerprint("button", "Buy", "SUBMIT", false,
+                                               false, "https://x/y");
+  EXPECT_FALSE(fp.empty());
+  EXPECT_EQ(fp, MakePolicyFingerprint("button", "Buy", "SUBMIT", false, false,
+                                      "https://x/y"));
+}
+
+TEST(SnapshotSerializerTest, HiddenAnnotatedRoleExcluded) {
+  auto page = MakePage();
+  auto* root = page.mutable_root_node();
+  auto* decoy = Node(root, proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  DomId(decoy, 9);
+  Visible(decoy);
+  decoy->mutable_content_attributes()->set_label("Ignore me");
+  decoy->mutable_content_attributes()->add_annotated_roles(
+      proto::ANNOTATED_ROLE_CONTENT_HIDDEN);
+  decoy->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->set_form_control_type(proto::FORM_CONTROL_TYPE_BUTTON_BUTTON);
+
+  RefTable refs;
+  AgentSnapshot snap =
+      SerializeAgentSnapshot(page, refs, {}, /*snapshot_id=*/1);
+  EXPECT_EQ(snap.text.find("Ignore me"), std::string::npos);
+  EXPECT_EQ(refs.Lookup("e1"), nullptr);
+}

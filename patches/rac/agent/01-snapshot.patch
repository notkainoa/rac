+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/ref_table.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::agent {
+
+TEST(RefTableTest, StableAcrossSnapshots) {
+  RefTable refs;
+  RefKey key{.tab_id = "t1", .document_token = "docA", .dom_node_id = 12};
+  RefEntry meta;
+  meta.role = "button";
+  meta.name = "Sign in";
+  refs.BeginSnapshot("t1", 1);
+  const std::string r1 = refs.GetOrCreate(key, meta);
+  EXPECT_EQ(r1, "e1");
+  refs.MarkSeen(r1, true);
+  refs.EndSnapshot("t1");
+
+  meta.name = "Sign in (moved)";
+  refs.BeginSnapshot("t1", 2);
+  const std::string r2 = refs.GetOrCreate(key, meta);
+  EXPECT_EQ(r2, "e1");
+  EXPECT_EQ(refs.Lookup(r2)->name, "Sign in (moved)");
+}
+
+TEST(RefTableTest, NewDocumentGetsNewRefs) {
+  RefTable refs;
+  RefEntry meta;
+  meta.role = "button";
+  const std::string a = refs.GetOrCreate(
+      {.tab_id = "t1", .document_token = "doc1", .dom_node_id = 1}, meta);
+  const std::string b = refs.GetOrCreate(
+      {.tab_id = "t1", .document_token = "doc2", .dom_node_id = 1}, meta);
+  EXPECT_EQ(a, "e1");
+  EXPECT_EQ(b, "e2");
+  refs.InvalidateDocument("t1", "doc1");
+  EXPECT_EQ(refs.Lookup(a), nullptr);
+  EXPECT_NE(refs.Lookup(b), nullptr);
+}
+
+TEST(RefTableTest, NeverRecyclesNumbers) {
+  RefTable refs(2);
+  RefEntry meta;
+  const std::string a = refs.GetOrCreate(
+      {.tab_id = "t1", .document_token = "d", .dom_node_id = 1}, meta);
+  const std::string b = refs.GetOrCreate(
+      {.tab_id = "t1", .document_token = "d", .dom_node_id = 2}, meta);
+  EXPECT_EQ(a, "e1");
+  EXPECT_EQ(b, "e2");
+  refs.BeginSnapshot("t1", 1);
+  // Neither marked seen → both eligible for eviction once a third arrives.
+  const std::string c = refs.GetOrCreate(
+      {.tab_id = "t1", .document_token = "d", .dom_node_id = 3}, meta);
+  EXPECT_EQ(c, "e3");
+  EXPECT_EQ(refs.next_ref_number(), 4u);
+}
+
+}  // namespace rac::agent

+struct SnapshotOptions {
+  bool full = false;  // Include offscreen actionable nodes.
+  size_t max_chars = kDefaultSnapshotChars;
+  std::string tab_id = "t1";
+  std::string main_origin;
+};
+
+struct SnapshotLine {
+  std::string ref;
+  std::string text;  // Full line including "- role … [ref=eN]"
+  std::string semantic_hash;
+};
+
+struct AgentSnapshot {
+  uint64_t snapshot_id = 0;
+  std::string title;
+  std::string url;
+  std::string text;  // Joined lines (or delta form).
+  bool is_delta = false;
+  size_t line_count = 0;
+  size_t approximate_tokens = 0;
+  std::vector<SnapshotLine> lines;
+};

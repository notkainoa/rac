+void NormalizeAgentPrefs(PrefService* prefs) {
+  const std::string& level = prefs->GetString(kAgentPermissionLevel);
+  if (level != kAgentPermissionAsk && level != kAgentPermissionCareful &&
+      level != kAgentPermissionAuto) {
+    prefs->SetString(kAgentPermissionLevel, kAgentPermissionAsk);
+  }
+  std::vector<std::string> unreadable;
+  for (const auto [origin, rule] : prefs->GetDict(kAgentSiteRules)) {
+    const std::string* name = rule.GetIfString();
+    // "always" counts only under an exact origin (see ParseSiteRules).
+    const GURL url(origin);
+    const bool exact = url.SchemeIsHTTPOrHTTPS() &&
+                       url::Origin::Create(url).Serialize() == origin;
+    if (!name || (*name != kAgentSiteAlways && *name != kAgentSiteNever) ||
+        (*name == kAgentSiteAlways && !exact)) {
+      unreadable.push_back(origin);
+    }
+  }
+  if (!unreadable.empty()) {
+    ScopedDictPrefUpdate update(prefs, kAgentSiteRules);
+    for (const std::string& origin : unreadable) {
+      update->Set(origin, kAgentSiteNever);
+    }
+  }
+}

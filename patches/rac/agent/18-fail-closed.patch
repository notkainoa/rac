+std::string SiteRuleHost(std::string_view key) {
+  const std::string trimmed(base::TrimWhitespaceASCII(key, base::TRIM_ALL));
+  // A bare host is that host on https.
+  const GURL url(trimmed.find("://") == std::string::npos ? "https://" + trimmed
+                                                          : trimmed);
+  std::string host;
+  if (url.is_valid() && !url.host().empty()) {
+    host = url.host();
+  } else {
+    // Not a URL ("*.bank.example/x y", "bank example:443"): the part a
+    // person would read as the host.
+    host = base::ToLowerASCII(trimmed);
+    if (const size_t scheme = host.find("://"); scheme != std::string::npos) {
+      host.erase(0, scheme + 3);
+    }
+    host = host.substr(0, host.find_first_of("/?#"));
+    if (const size_t at = host.rfind('@'); at != std::string::npos) {
+      host.erase(0, at + 1);
+    }
+    if (!host.starts_with("[")) {
+      host = host.substr(0, host.find(':'));
+    }
+  }
+  // GURL takes "*" in a host and escapes it.
+  host = base::ToLowerASCII(host);
+  base::ReplaceSubstringsAfterOffset(&host, 0, "%2a", "*");
+  // "*.bank.example" and ".bank.example" mean bank.example and below.
+  for (bool trimmed_prefix = true; trimmed_prefix;) {
+    trimmed_prefix = false;
+    for (std::string_view prefix : {"*.", ".", "*"}) {
+      if (host.starts_with(prefix)) {
+        host.erase(0, prefix.size());
+        trimmed_prefix = true;
+      }
+    }
+  }
+  while (host.ends_with(".")) {
+    host.pop_back();
+  }
+  return host;
+}
+std::map<std::string, SiteRule> ParseSiteRules(const base::DictValue& rules) {
+  std::map<std::string, SiteRule> parsed;
+  for (const auto [key, value] : rules) {
+    const GURL url(key.find("://") == std::string::npos ? "https://" + key
+                                                        : key);
+    const bool web =
+        url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !url.host().empty();
+    const std::string origin =
+        web ? url::Origin::Create(url).Serialize() : std::string();
+    // A wildcard is never an exact origin, even where GURL takes the "*"
+    // (as "%2A").
+    const bool exact = web && key == origin &&
+                       url.host().find_first_of("*%") == std::string::npos;
+    // The names in ai_prefs.h (kAgentSiteAlways, kAgentSiteNever). Settings
+    // and the card write exact origins, so "always" counts only under one.
+    const std::string* name = value.GetIfString();
+    if (exact && name && *name == "always") {
+      // Two spellings of one origin: never wins.
+      parsed.emplace(key, SiteRule::kAlways);
+      continue;
+    }
+    // Any other rule can only take away: never, for the host it names as
+    // best it can be read. NeverOn reads the host back from the key.
+    const std::string host = SiteRuleHost(key);
+    if (host.empty()) {
+      // It names no site at all.
+      continue;
+    }
+    parsed[web ? origin : "https://" + host] = SiteRule::kNever;
+  }

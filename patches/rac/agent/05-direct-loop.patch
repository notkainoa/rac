+namespace rac::agent {
+namespace {
+const char kControllerKey[] = "rac.agent.controller";
+ToolResult Error(std::string code, std::string text) {
+  ToolResult result;
+  result.error_code = std::move(code);
+  result.error = std::move(text);
+  return result;
+}
+std::string String(const base::DictValue& dict, std::string_view key) {
+  const auto* value = dict.FindString(key);
+  return value ? *value : "";
+}
+std::string Origin(content::WebContents* tab) {
+  return tab ? url::Origin::Create(tab->GetLastCommittedURL()).Serialize() : "";
+}
+}  // namespace
+
+struct AgentController::Conversation {
+  base::WeakPtr<BrowserWindowInterface> browser;
+  RefTable refs;
+  std::unique_ptr<ActionRunner> runner;
+  std::map<std::string, base::WeakPtr<content::WebContents>> tabs;
+  std::map<std::string, AgentSnapshot> snapshots;
+  std::string default_tab;
+  uint64_t snapshot_id = 0;
+  base::ListValue log;
+};
+
+AgentController* AgentController::GetIfCreated(Profile* profile) {
+  return profile ? static_cast<AgentController*>(
+                       profile->GetUserData(&kControllerKey))
+                 : nullptr;
+}
+AgentController* AgentController::GetOrCreate(Profile* profile) {
+  if (!profile || !IsBrowserControlAllowed(profile->GetPrefs(), profile)) {
+    return nullptr;
+  }
+  if (!GetIfCreated(profile)) {
+    profile->SetUserData(&kControllerKey,
+                         std::make_unique<AgentController>(profile));
+  }
+  return GetIfCreated(profile);
+}
+AgentController::AgentController(Profile* profile) : profile_(profile) {
+  VLOG(1) << "rac AgentController created";
+  prefs_.Init(profile->GetPrefs());
+  for (const char* pref : {rac::ai::kEnabled, rac::ai::kBrowserControl}) {
+    prefs_.Add(pref, base::BindRepeating(&AgentController::OnPrefsChanged,
+                                         base::Unretained(this)));
+  }
+}
+AgentController::~AgentController() {
+  Cancel();
+}
+base::WeakPtr<AgentController> AgentController::GetWeakPtr() {
+  return operation_factory_.GetWeakPtr();
+}
+void AgentController::OnPrefsChanged() {
+  if (!IsBrowserControlAllowed(profile_->GetPrefs(), profile_)) {
+    Cancel();
+    current_ = nullptr;
+    conversations_.clear();
+  }
+}
+std::vector<ToolDefinition> AgentController::AvailableTools() {
+  const bool actions_allowed =
+      active_ && current_ && current_->browser &&
+      current_->browser->GetProfile() == profile_ &&
+      IsBrowserControlAllowed(profile_->GetPrefs(), profile_);
+  std::vector<ToolDefinition> tools;
+  for (auto& tool : GetToolDefinitions()) {
+    if (tool.kind == ToolKind::kRead || actions_allowed) {
+      tools.push_back(std::move(tool));
+    }
+  }
+  return tools;
+}
+
+void AgentController::BeginTurn(
+    BrowserWindowInterface* browser,
+    std::string conversation_id,
+    std::string goal,
+    const std::vector<std::string>& user_messages,
+    const std::vector<content::WebContents*>& attached_tabs,
+    EventCallback events) {
+  Cancel();
+  if (!IsBrowserControlAllowed(profile_->GetPrefs(), profile_) || !browser ||
+      browser->GetProfile() != profile_) {
+    return;
+  }
+  if (conversations_.size() >= 8 && !conversations_.contains(conversation_id)) {
+    current_ = nullptr;
+    conversations_.clear();
+  }
+  auto& conversation = conversations_[conversation_id];
+  if (!conversation || conversation->browser.get() != browser) {
+    conversation = std::make_unique<Conversation>();
+    conversation->browser = browser->GetWeakPtr();
+  }
+  current_ = conversation.get();
+  current_->snapshots.clear();
+  goal_ = std::move(goal);
+  events_ = std::move(events);
+  steps_ = confirmed_ = 0;
+  paused_ = false;
+  active_ = true;
+  current_->log.clear();
+  current_->runner = std::make_unique<ActionRunner>(
+      profile_, browser, profile_->GetPrefs(), &current_->refs);
+  current_->runner->SetPausedCallback(
+      base::BindRepeating(&AgentController::Pause, weak_factory_.GetWeakPtr()));
+  TabTools tabs(browser);
+  for (auto* tab : attached_tabs) {
+    if (!tab || tab->GetBrowserContext() != profile_ ||
+        !IsAllowedAgentUrl(tab->GetLastCommittedURL().spec())) {
+      continue;
+    }
+    const std::string alias = tabs.AliasFor(tab);
+    if (alias.empty()) {
+      continue;
+    }
+    current_->tabs[alias] = tab->GetWeakPtr();
+    current_->default_tab = alias;
+  }
+  for (const auto& [alias, tab] : current_->tabs) {
+    if (tab) {
+      current_->runner->AttachTab(alias, tab.get(), false);
+    }
+  }
+  State("working");
+}
+void AgentController::Emit(base::DictValue event) {
+  if (events_) {
+    events_.Run(std::move(event));
+  }
+}
+void AgentController::State(const std::string& state) {
+  state_ = state;
+  Emit(base::DictValue()
+           .Set("type", "run_state")
+           .Set("state", state)
+           .Set("tabId", TargetAlias())
+           .Set("goal", goal_));
+}
+std::string AgentController::TargetAlias() const {
+  if (!current_) {
+    return "";
+  }
+  if (const auto* alias = pending_.arguments.FindString("tab_id")) {
+    return *alias;
+  }
+  if (const auto* entry =
+          current_->refs.Lookup(String(pending_.arguments, "ref"))) {
+    return entry->key.tab_id;
+  }
+  return current_->default_tab;
+}
+content::WebContents* AgentController::TargetTab() const {
+  if (!current_ || !current_->browser) {
+    return nullptr;
+  }
+  auto found = current_->tabs.find(TargetAlias());
+  if (found == current_->tabs.end() || !found->second) {
+    return nullptr;
+  }
+  TabTools tabs(current_->browser.get());
+  return tabs.FindByAlias(found->first) == found->second.get()
+             ? found->second.get()
+             : nullptr;
+}
+std::string AgentController::Label() const {
+  const RefEntry* entry =
+      current_ ? current_->refs.Lookup(String(pending_.arguments, "ref"))
+               : nullptr;
+  const std::string name = entry ? EscapeSnapshotText(entry->name, 100) : "";
+  if (pending_.name == "click") {
+    return "Click “" + name + "”";
+  }
+  if (pending_.name == "type") {
+    return "Type into “" + name + "”";
+  }
+  if (pending_.name == "select_option") {
+    return "Choose an option in “" + name + "”";
+  }
+  if (pending_.name == "snapshot" || pending_.name == "get_page_text") {
+    return "Read the page";
+  }
+  if (pending_.name == "navigate" || pending_.name == "open_tab") {
+    return "Open " +
+           url::Origin::Create(GURL(String(pending_.arguments, "url")))
+               .Serialize();
+  }
+  if (pending_.name == "scroll") {
+    return "Scroll the page";
+  }
+  if (pending_.name == "list_tabs") {
+    return "Read open tabs";
+  }
+  if (pending_.name == "find_in_page") {
+    return "Find text in the page";
+  }
+  if (pending_.name == "go_back") {
+    return "Go back";
+  }
+  if (pending_.name == "close_tab") {
+    return "Close the tab";
+  }
+  if (pending_.name == "switch_tab") {
+    return "Switch tabs";
+  }
+  return "Wait for the page";
+}
+void AgentController::HandleToolCall(const ToolCall& call,
+                                     ToolCallSource source,
+                                     DoneCallback done) {
+  if (!active_ || !current_ || !current_->browser ||
+      current_->browser->GetProfile() != profile_ ||
+      !IsBrowserControlAllowed(profile_->GetPrefs(), profile_)) {
+    std::move(done).Run(
+        Error("denied", "Browser control is off or this turn has ended."));
+    return;
+  }
+  if (done_) {
+    std::move(done).Run(Error("busy", "Another browser tool is pending."));
+    return;
+  }
+  if (steps_ >= static_cast<int>(rac::ai::kMaxToolCallsPerTurn)) {
+    const std::string message =
+        "This turn reached its limit of 25 browser tools.";
+    std::move(done).Run(Error("step_limit", message));
+    EndTurn(message);
+    return;
+  }
+  const auto* definition = FindToolDefinition(call.name);
+  if (!definition) {
+    std::move(done).Run(Error("unknown_tool", "Unknown browser tool."));
+    return;
+  }
+  if (auto error = ValidateToolArguments(*definition, call.arguments)) {
+    std::move(done).Run(Error("invalid_arguments", *error));
+    return;
+  }
+  pending_ = {call.id, call.name, call.arguments.Clone()};
+  action_dispatched_ = false;
+  done_ = std::move(done);
+  step_id_ = "step-" + base::NumberToString(++next_id_);
+  ++steps_;
+  Emit(base::DictValue()
+           .Set("type", "step_started")
+           .Set("id", step_id_)
+           .Set("tool", pending_.name)
+           .Set("label", Label())
+           .Set("tabId", TargetAlias())
+           .Set("tabTitle",
+                TargetTab() ? base::UTF16ToUTF8(TargetTab()->GetTitle()) : "")
+           .Set("origin", Origin(TargetTab())));
+  if (paused_) {
+    deferred_ = base::BindOnce(&AgentController::ProcessTool,
+                               operation_factory_.GetWeakPtr());
+    return;
+  }
+  ProcessTool();
+}
+void AgentController::ProcessTool() {
+  if (pending_.name == "list_tabs") {
+    ToolResult result;
+    result.ok = true;
+    base::ListValue list;
+    if (current_->browser) {
+      for (const auto& tab : TabTools(current_->browser.get()).ListTabs()) {
+        list.Append(base::DictValue()
+                        .Set("tab_id", tab.tab_id)
+                        .Set("title", tab.title)
+                        .Set("url", tab.url.spec())
+                        .Set("attached", current_->tabs.contains(tab.tab_id)));
+      }
+    }
+    result.data.Set("tabs", std::move(list));
+    Finish(std::move(result));
+    return;
+  }
+  if (!TargetTab() && pending_.name != "open_tab") {
+    Finish(Error("unattached_tab", "Attach this tab before using it."));
+    return;
+  }
+  if (FindToolDefinition(pending_.name)->kind == ToolKind::kRead) {
+    ReadPage(false);
+    return;
+  }
+  if (!String(pending_.arguments, "ref").empty()) {
+    ReadPage(true);
+    return;
+  }
+  Authorize();
+}
+void AgentController::ReadPage(bool for_action) {
+  auto* tab = TargetTab();
+  if (!tab || !IsAllowedAgentUrl(tab->GetLastCommittedURL().spec())) {
+    Finish(Error("denied", "Only attached web pages can be read."));
+    return;
+  }
+  ExtractAnnotatedPageContent(
+      tab, base::BindOnce(&AgentController::OnPageRead,
+                          operation_factory_.GetWeakPtr(), for_action));
+}
+void AgentController::OnPageRead(
+    bool for_action,
+    optimization_guide::AIPageContentResultOrError result) {
+  if (!done_) {
+    return;
+  }
+  if (!result.has_value()) {
+    Finish(Error("snapshot_failed", result.error()));
+    return;
+  }
+  SnapshotOptions options;
+  options.tab_id = TargetAlias();
+  options.full =
+      for_action || pending_.arguments.FindBool("full").value_or(false);
+  auto& previous = current_->snapshots[options.tab_id];
+  auto snapshot = SerializeAgentSnapshot(
+      result->proto, current_->refs, options, ++current_->snapshot_id,
+      previous.snapshot_id ? &previous : nullptr);
+  if (!for_action) {
+    previous = snapshot;
+  }
+  if (for_action) {
+    const auto* entry =
+        current_->refs.Lookup(String(pending_.arguments, "ref"));
+    if (!entry || !entry->present_in_latest ||
+        entry->key.tab_id != options.tab_id) {
+      Finish(Error("stale_ref", "The element changed. Take a new snapshot."));
+      return;
+    }
+    if (revalidating_) {
+      revalidating_ = false;
+      if (entry->policy_fingerprint != approved_fingerprint_) {
+        Finish(Error("stale_ref",
+                     "The element changed while awaiting approval. Take a new "
+                     "snapshot."));
+        return;
+      }
+      Dispatch();
+      return;
+    }
+    Authorize();
+    return;
+  }
+  rac::ai::PageAttachment page;
+  page.title = snapshot.title;
+  page.url = snapshot.url;
+  page.text = pending_.name == "snapshot"
+                  ? snapshot.text
+                  : rac::ai::SerializePageContent(result->proto).text;
+  if (pending_.name == "find_in_page") {
+    const std::string query = String(pending_.arguments, "query");
+    size_t offset = 0;
+    int count = 0;
+    std::string snippets;
+    while (!query.empty() &&
+           (offset = page.text.find(query, offset)) != std::string::npos) {
+      ++count;
+      if (snippets.size() < 4000) {
+        snippets += page.text.substr(offset, 160) + "\n";
+      }
+      offset += query.size();
+    }
+    page.text = base::NumberToString(count) + " matches\n" + snippets;
+  }
+  ToolResult out;
+  out.ok = true;
+  out.data.Set("tab_id", options.tab_id)
+      .Set("snapshot_id", static_cast<double>(snapshot.snapshot_id))
+      .Set("is_delta", snapshot.is_delta)
+      .Set("title", page.title)
+      .Set("url", page.url)
+      .Set("text", rac::ai::WrapPageContent(
+                       page, base::UnguessableToken::Create().ToString()));
+  Finish(std::move(out));
+}
+void AgentController::Authorize() {
+  RequestConfirmation("Allow this browser action?");
+}
+void AgentController::RequestConfirmation(std::string reason) {
+  approval_id_ = "approval-" + base::NumberToString(++next_id_);
+  if (const auto* entry =
+          current_->refs.Lookup(String(pending_.arguments, "ref"))) {
+    approved_fingerprint_ = entry->policy_fingerprint;
+  }
+  State("waiting");
+  Emit(base::DictValue()
+           .Set("type", "confirm_request")
+           .Set("id", approval_id_)
+           .Set("action", Label())
+           .Set("risk", "consequential")
+           .Set("reason", reason)
+           .Set("origin", Origin(TargetTab()))
+           .Set("tabId", TargetAlias()));
+}
+void AgentController::Respond(const std::string& id,
+                              const std::string& decision) {
+  if (id != approval_id_ || !done_ || approval_id_.empty()) {
+    return;
+  }
+  approval_id_.clear();
+  if (decision == "stop") {
+    Cancel();
+    return;
+  }
+  if (decision != "allow" && decision != "allow_once") {
+    Finish(
+        Error("declined", "The user declined this action. Do not retry it."));
+    return;
+  }
+  ++confirmed_;
+  State(paused_ ? "paused" : "working");
+  auto continuation = base::BindOnce(
+      [](base::WeakPtr<AgentController> self) {
+        if (!self) {
+          return;
+        }
+        if (!String(self->pending_.arguments, "ref").empty()) {
+          self->revalidating_ = true;
+          self->ReadPage(true);
+        } else {
+          self->Dispatch();
+        }
+      },
+      operation_factory_.GetWeakPtr());
+  if (paused_) {
+    deferred_ = std::move(continuation);
+  } else {
+    std::move(continuation).Run();
+  }
+}
+void AgentController::Dispatch() {
+  if (!done_ || !active_ || !current_ || !current_->browser ||
+      !IsBrowserControlAllowed(profile_->GetPrefs(), profile_)) {
+    Finish(Error("cancelled", "Browser control ended."));
+    return;
+  }
+  const auto& args = pending_.arguments;
+  ActionRequest request;
+  request.tab_id = TargetAlias();
+  RefTarget ref{String(args, "ref"), current_->snapshot_id};
+  if (pending_.name == "click") {
+    request.action = ClickAction{ref};
+  } else if (pending_.name == "type") {
+    request.action = TypeAction{ref, String(args, "text"),
+                                args.FindBool("press_enter").value_or(false)};
+  } else if (pending_.name == "select_option") {
+    request.action = SelectAction{ref, String(args, "value")};
+  } else if (pending_.name == "navigate") {
+    request.action = NavigateAction{GURL(String(args, "url"))};
+  } else if (pending_.name == "open_tab") {
+    request.action = OpenTabAction{GURL(String(args, "url"))};
+  } else if (pending_.name == "go_back") {
+    request.action = BackAction{};
+  } else if (pending_.name == "switch_tab") {
+    request.action = SwitchTabAction{request.tab_id};
+  } else if (pending_.name == "close_tab") {
+    request.action = CloseTabAction{request.tab_id};
+  } else if (pending_.name == "press_key") {
+    request.action = PressKeyAction{
+        String(args, "key"),
+        ref.ref.empty() ? std::nullopt : std::make_optional(ref)};
+  } else if (pending_.name == "scroll") {
+    request.action =
+        ScrollAction{ref.ref.empty() ? std::nullopt : std::make_optional(ref),
+                     static_cast<int>(args.FindDouble("dx").value_or(0)),
+                     static_cast<int>(args.FindDouble("dy").value_or(0))};
+  } else {
+    request.action = WaitAction{base::Milliseconds(4000)};
+  }
+  AgentSnapshot published;
+  if (auto found = current_->snapshots.find(request.tab_id);
+      found != current_->snapshots.end()) {
+    published = found->second;
+  }
+  published.snapshot_id = current_->snapshot_id;
+  current_->runner->SetLastSnapshot(std::move(published));
+  action_dispatched_ = true;
+  current_->runner->Run(std::move(request),
+                        base::BindOnce(&AgentController::OnActionDone,
+                                       operation_factory_.GetWeakPtr()));
+}
+void AgentController::OnActionDone(ActionResult result) {
+  ToolResult out;
+  out.ok = result.ok;
+  out.error = std::move(result.error);
+  out.error_code = std::move(result.error_code);
+  out.may_have_acted = result.may_have_acted;
+  out.data.Set("settled", result.settled).Set("timed_out", result.timed_out);
+  if (result.next_snapshot_id && current_->runner) {
+    const auto& snapshot = *current_->runner->last_snapshot();
+    current_->snapshot_id =
+        std::max(current_->snapshot_id, snapshot.snapshot_id);
+    current_->snapshots[TargetAlias()] = snapshot;
+    rac::ai::PageAttachment page;
+    page.title = snapshot.title;
+    page.url = snapshot.url;
+    page.text = snapshot.text;
+    out.data.Set("snapshot_id", static_cast<double>(snapshot.snapshot_id))
+        .Set("text", rac::ai::WrapPageContent(
+                         page, base::UnguessableToken::Create().ToString()));
+  }
+  if (paused_) {
+    deferred_ = base::BindOnce(&AgentController::Finish,
+                               operation_factory_.GetWeakPtr(), std::move(out));
+    return;
+  }
+  Finish(std::move(out));
+}
+void AgentController::Finish(ToolResult result) {
+  if (!done_) {
+    return;
+  }
+  auto event =
+      base::DictValue()
+          .Set("type", "step_finished")
+          .Set("id", step_id_)
+          .Set("tool", pending_.name)
+          .Set("label", Label())
+          .Set("ok", result.ok)
+          .Set("origin", Origin(TargetTab()))
+          .Set("tabId", TargetAlias())
+          .Set("tabTitle",
+               TargetTab() ? base::UTF16ToUTF8(TargetTab()->GetTitle()) : "");
+  if (!result.error.empty()) {
+    event.Set("error", result.error);
+  }
+  current_->log.Append(event.Clone());
+  Emit(std::move(event));
+  approval_id_.clear();
+  revalidating_ = false;
+  State(paused_ ? "paused" : "working");
+  action_dispatched_ = false;
+  std::move(done_).Run(std::move(result));
+}
+void AgentController::Pause() {
+  if (!active_ || paused_) {
+    return;
+  }
+  paused_ = true;
+  Emit(base::DictValue()
+           .Set("type", "paused")
+           .Set("reason", "you're using this tab")
+           .Set("tabId", TargetAlias()));
+  State("paused");
+}
+void AgentController::Resume() {
+  if (!active_ || !paused_) {
+    return;
+  }
+  paused_ = false;
+  if (current_ && current_->runner) {
+    current_->runner->Resume();
+  }
+  Emit(base::DictValue().Set("type", "resumed"));
+  State(approval_id_.empty() ? "working" : "waiting");
+  if (deferred_) {
+    std::move(deferred_).Run();
+  }
+}
+void AgentController::Cancel() {
+  const bool may_have_acted = action_dispatched_ && !!done_;
+  operation_factory_.InvalidateWeakPtrs();
+  deferred_.Reset();
+  approval_id_.clear();
+  active_ = false;
+  if (current_ && current_->runner) {
+    current_->runner->Cancel();
+    current_->runner.reset();
+  }
+  if (events_ && done_) {
+    Emit(base::DictValue()
+             .Set("type", "step_finished")
+             .Set("id", step_id_)
+             .Set("tool", pending_.name)
+             .Set("label", Label())
+             .Set("tabId", TargetAlias())
+             .Set("tabTitle",
+                  TargetTab() ? base::UTF16ToUTF8(TargetTab()->GetTitle()) : "")
+             .Set("origin", Origin(TargetTab()))
+             .Set("ok", false)
+             .Set("error",
+                  may_have_acted
+                      ? "Stopped. This step may already have taken effect."
+                      : "Stopped."));
+  }
+  if (events_) {
+    State("stopped");
+    Emit(base::DictValue()
+             .Set("type", "summary")
+             .Set("text",
+                  "Stopped after " + base::NumberToString(steps_) + " steps")
+             .Set("steps", steps_)
+             .Set("confirmed", confirmed_));
+  }
+  auto done = std::move(done_);
+  action_dispatched_ = false;
+  events_.Reset();
+  if (done) {
+    auto result =
+        Error("cancelled", "The user stopped the task. Do not continue.");
+    result.may_have_acted = may_have_acted;
+    std::move(done).Run(std::move(result));
+  }
+}
+
+void AgentController::EndTurn(std::string error) {
+  if (done_) {
+    Cancel();
+    return;
+  }
+  if (!active_) {
+    return;
+  }
+  active_ = false;
+  if (current_) {
+    current_->runner.reset();
+  }
+  State(error.empty() ? "done" : "error");
+  Emit(base::DictValue()
+           .Set("type", "summary")
+           .Set("text", error.empty() ? "Done" : error)
+           .Set("steps", steps_)
+           .Set("confirmed", confirmed_));
+  events_.Reset();
+}

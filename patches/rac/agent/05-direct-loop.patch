+std::optional<std::string> MergeToolCallDeltas(
+    std::map<int, ChatToolCall>& calls,
+    const std::vector<ToolCallDelta>& deltas) {
+  for (const auto& delta : deltas) {
+    if (delta.index < 0 || delta.index >= 32) {
+      return "Invalid tool call index.";
+    }
+    auto& call = calls[delta.index];
+    call.id += delta.id;
+    call.name += delta.name;
+    call.arguments += delta.arguments;
+    if (call.id.size() > 200 || call.name.size() > 100 ||
+        call.arguments.size() > 64 * 1024) {
+      return "The provider's tool call was too large.";
+    }
+  }
+  return std::nullopt;
+}
+base::expected<std::vector<ChatToolCall>, std::string> CompleteToolCalls(
+    std::map<int, ChatToolCall> calls,
+    const std::vector<ChatToolDefinition>& offered) {
+  std::set<std::string> ids;
+  std::vector<ChatToolCall> complete;
+  for (auto& [index, call] : calls) {
+    if (call.arguments.empty()) {
+      call.arguments = "{}";
+    }
+    if (call.id.empty() || call.name.empty() || !ids.insert(call.id).second ||
+        !base::JSONReader::ReadDict(call.arguments, base::JSON_PARSE_RFC)) {
+      return base::unexpected("The provider returned a malformed tool call.");
+    }
+    if (std::ranges::none_of(offered, [&call](const auto& tool) {
+          return tool.name == call.name;
+        })) {
+      return base::unexpected("The provider requested an unavailable tool.");
+    }
+    complete.push_back(std::move(call));
+  }
+  return complete;
+}

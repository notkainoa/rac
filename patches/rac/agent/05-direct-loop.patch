+void ChatSession::OnStreamUpdate(StreamUpdate update) {
+  if (failed_ || round_finished_) {
+    return;
+  }
+  if (update.error) {
+    Fail(*update.error);
+    return;
+  }
+  if (!update.tool_deltas.empty()) {
+    if (!tool_handler_ || request_.tools.empty()) {
+      Fail("The provider returned an unexpected tool call.");
+      return;
+    }
+    if (auto error = MergeToolCallDeltas(partial_calls_, update.tool_deltas)) {
+      Fail(*error);
+      return;
+    }
+  }
+  round_text_ += update.text_delta;
+  if (!update.text_delta.empty()) {
+    on_update_.Run({.text_delta = std::move(update.text_delta)});
+  }
+  if (update.done) {
+    round_finished_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ChatSession::FinishRound, weak_factory_.GetWeakPtr()));
+  }
+}
+
+void ChatSession::FinishRound() {
+  stream_.reset();
+  if (partial_calls_.empty()) {
+    on_update_.Run({.done = true});
+    return;
+  }
+  auto calls = CompleteToolCalls(std::move(partial_calls_), request_.tools);
+  if (!calls.has_value()) {
+    Fail(calls.error());
+    return;
+  }
+  round_calls_ = std::move(*calls);
+  partial_calls_.clear();
+  if (tool_count_ + round_calls_.size() > kMaxToolCallsPerTurn) {
+    Fail("Stopped after 25 browser tools. Send another message to continue.");
+    return;
+  }
+  tool_count_ += round_calls_.size();
+  ChatMessage assistant{ChatMessage::Role::kAssistant, std::move(round_text_)};
+  assistant.tool_calls = round_calls_;
+  request_.messages.push_back(std::move(assistant));
+  next_tool_ = 0;
+  RunNextTool();
+}
+
+void ChatSession::RunNextTool() {
+  if (next_tool_ >= round_calls_.size()) {
+    StartRequest();
+    return;
+  }
+  ChatToolCall call = round_calls_[next_tool_++];
+  std::string id = call.id;
+  tool_handler_.Run(std::move(call),
+                    base::BindOnce(&ChatSession::OnToolResult,
+                                   weak_factory_.GetWeakPtr(), std::move(id)));
+}
+
+void ChatSession::OnToolResult(std::string id, std::string result) {
+  ChatMessage message{ChatMessage::Role::kTool, std::move(result)};
+  message.tool_call_id = std::move(id);
+  request_.messages.push_back(std::move(message));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ChatSession::RunNextTool, weak_factory_.GetWeakPtr()));
+}
+
 void ChatSession::Fail(const std::string& message) {
+  if (failed_) {
+    return;
+  }
+  failed_ = true;
   on_update_.Run({.error = message});
 }
 

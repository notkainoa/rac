Index: src/chrome/browser/resources/rac_ai/app.css
===================================================================
--- src.orig/chrome/browser/resources/rac_ai/app.css
+++ src/chrome/browser/resources/rac_ai/app.css
@@ -2376,3 +2376,109 @@ body[data-mode='panel'] .composer-wrap {
     width: 6px;
   }
 }
+
+/* A provider or agent failure: the same row shape, a soft mark, the fix a
+ * link away. The raw message waits behind the row. */
+.error-row .error-line {
+  flex-wrap: wrap;
+  gap: 2px 8px;
+  height: auto;
+  min-height: 28px;
+  padding-inline-end: 4px;
+}
+
+.error-toggle .row-label {
+  white-space: normal;
+}
+
+.error-row .error-line:hover {
+  background: none;
+}
+
+/* A long label wraps; the marks stay with its first line. */
+.error-toggle {
+  align-items: flex-start;
+  background: none;
+  border: 0;
+  border-radius: 6px;
+  color: var(--text);
+  display: flex;
+  flex: 1 1 auto;
+  font: inherit;
+  gap: 8px;
+  line-height: 20px;
+  min-height: 28px;
+  min-width: 0;
+  padding: 4px;
+  text-align: start;
+}
+
+.error-toggle > svg {
+  margin-top: 3px;
+}
+
+.error-toggle:hover:not(:disabled) {
+  background: var(--token-hover);
+}
+
+.error-toggle:disabled {
+  cursor: default;
+}
+
+.error-toggle svg:not(.chevron) {
+  color: color-mix(in srgb, var(--error) 70%, var(--text-faint));
+  flex: none;
+  height: 15px;
+  stroke-width: 1.7;
+  width: 15px;
+}
+
+.error-row[data-status='stopped'] .error-toggle svg:not(.chevron) {
+  color: var(--text-faint);
+}
+
+.error-toggle .chevron {
+  color: var(--text-faint);
+  flex: none;
+  height: 14px;
+  margin-inline-end: -4px;
+  opacity: 0;
+  rotate: -90deg;
+  stroke-width: 2;
+  transition: rotate 150ms var(--ease-out), opacity 120ms ease;
+  width: 14px;
+}
+
+.error-toggle:is(:hover, :focus-visible, [aria-expanded='true']):not(:disabled)
+    .chevron {
+  opacity: 1;
+}
+
+.error-row[data-open='true'] .error-toggle .chevron {
+  rotate: 0deg;
+}
+
+/* The fixes sit on their own line, under the label. */
+.error-links {
+  display: flex;
+  flex: 1 0 100%;
+  gap: 12px;
+  padding-inline-start: 45px;
+}
+
+.error-links .row-link {
+  color: var(--text);
+  font-size: 12px;
+  margin: 0;
+  white-space: nowrap;
+}
+
+.error-row .row-detail {
+  padding-inline-start: 45px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .error-toggle .chevron {
+    transition: none;
+  }
+}

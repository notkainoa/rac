+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// The agent's tabs are in reach only when IsTabInAgentReach() is true, which
+// is !rac::ai::IsInternalTab(): IsInternalEntry() of the tab's last committed
+// entry. These tests build real navigation entries the way a tab holds them.
+
+#include <memory>
+
+#include "chrome/browser/rac/ai/internal_tab.h"
+#include "content/public/browser/content_browser_client.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/common/content_client.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace rac::agent {
+namespace {
+
+using rac::ai::IsInternalEntry;
+
+// A committed entry for `url`, shown in the address bar as `shown` (the same
+// address when `shown` is empty).
+std::unique_ptr<content::NavigationEntry> Entry(const char* url,
+                                                const char* shown = "") {
+  std::unique_ptr<content::NavigationEntry> entry =
+      content::NavigationEntry::Create();
+  entry->SetURL(GURL(url));
+  if (*shown) {
+    entry->SetVirtualURL(GURL(shown));
+  }
+  return entry;
+}
+
+bool InReach(const char* url, const char* shown = "") {
+  return !IsInternalEntry(Entry(url, shown).get());
+}
+
+// A navigation entry asks the content client for its default favicon.
+class RacAgentTabReachTest : public testing::Test {
+ protected:
+  RacAgentTabReachTest() {
+    content::SetContentClient(&client_);
+    content::SetBrowserClientForTesting(&browser_client_);
+  }
+  ~RacAgentTabReachTest() override {
+    content::SetBrowserClientForTesting(nullptr);
+    content::SetContentClient(nullptr);
+  }
+
+ private:
+  content::ContentClient client_;
+  content::ContentBrowserClient browser_client_;
+};
+
+TEST_F(RacAgentTabReachTest, WebPagesAreInReach) {
+  EXPECT_TRUE(InReach("https://example.com/"));
+  EXPECT_TRUE(InReach("http://example.com/a?b#c"));
+  EXPECT_TRUE(InReach("http://127.0.0.1:8080/plans"));
+  EXPECT_TRUE(InReach("https://example.com/", "https://example.com/"));
+}
+
+TEST_F(RacAgentTabReachTest, ViewSourceIsOutOfReach) {
+  // How the browser commits view-source:https://example.com/: the entry
+  // loads the page's own address and the address bar shows view-source:.
+  // WebContents::GetLastCommittedURL() is the shown one.
+  auto entry =
+      Entry("https://example.com/", "view-source:https://example.com/");
+  EXPECT_EQ(entry->GetURL(), GURL("https://example.com/"));
+  EXPECT_EQ(entry->GetVirtualURL(), GURL("view-source:https://example.com/"));
+  EXPECT_TRUE(IsInternalEntry(entry.get()));
+  // Either half alone is enough.
+  EXPECT_FALSE(
+      InReach("view-source:https://example.com/", "https://example.com/"));
+  EXPECT_FALSE(InReach("view-source:https://example.com/"));
+}
+
+TEST_F(RacAgentTabReachTest, BrowserPagesAreOutOfReach) {
+  EXPECT_FALSE(InReach("chrome://settings/"));
+  EXPECT_FALSE(InReach("chrome://newtab/"));
+  EXPECT_FALSE(InReach("chrome://rac-ai/"));
+  EXPECT_FALSE(InReach("rac://settings/"));
+  EXPECT_FALSE(InReach("rac://newtab/"));
+  EXPECT_FALSE(InReach("chrome-extension://abcdefghijklmnop/options.html"));
+  // An internal page can't pass by showing a web address, nor a web page by
+  // showing an internal one.
+  EXPECT_FALSE(InReach("chrome://settings/", "https://example.com/"));
+  EXPECT_FALSE(InReach("https://example.com/", "rac://settings/"));
+}
+
+TEST_F(RacAgentTabReachTest, OtherNonWebPagesAreOutOfReach) {
+  EXPECT_FALSE(InReach("file:///Users/me/notes.html"));
+  EXPECT_FALSE(InReach("data:text/html,hello"));
+  EXPECT_FALSE(InReach("about:blank"));
+  EXPECT_FALSE(InReach("javascript:alert(1)"));
+  EXPECT_FALSE(InReach("blob:https://example.com/0f0f0f0f"));
+}
+
+TEST_F(RacAgentTabReachTest, LoadingTabsAreOutOfReach) {
+  // A tab still loading its first page has committed nothing: no entry, or
+  // the initial entry, whose address is empty.
+  EXPECT_TRUE(IsInternalEntry(nullptr));
+  EXPECT_FALSE(InReach(""));
+  EXPECT_TRUE(rac::ai::IsInternalTab(nullptr));
+}
+

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/agent_mcp_convert.h"
+#include "chrome/browser/rac/agent/tool_registry.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::agent {
+namespace {
+
+TEST(AgentMcpToolsTest, SpecConversionMarksReadOnly) {
+  ToolDefinition read;
+  read.name = "snapshot";
+  read.description = "Read the page";
+  read.kind = ToolKind::kRead;
+  read.parameters = base::DictValue()
+                        .Set("type", "object")
+                        .Set("properties", base::DictValue());
+
+  ToolDefinition action;
+  action.name = "click";
+  action.description = "Click an element";
+  action.kind = ToolKind::kAction;
+  action.parameters = base::DictValue().Set("type", "object");
+
+  McpToolSpec read_spec = ToolDefinitionToMcpSpec(read);
+  EXPECT_EQ(read_spec.name, "snapshot");
+  EXPECT_EQ(read_spec.description, "Read the page");
+  EXPECT_TRUE(read_spec.read_only);
+  EXPECT_EQ(*read_spec.input_schema.FindString("type"), "object");
+
+  McpToolSpec action_spec = ToolDefinitionToMcpSpec(action);
+  EXPECT_EQ(action_spec.name, "click");
+  EXPECT_FALSE(action_spec.read_only);
+}
+
+TEST(AgentMcpToolsTest, DeclinedResultIsErrorWithPlainText) {
+  ToolResult declined;
+  declined.ok = false;
+  declined.error_code = "declined";
+  declined.error = "The user declined this action. Do not retry it.";
+
+  McpToolResult mcp = ToolResultToMcpResult(declined);
+  EXPECT_TRUE(mcp.is_error);
+  ASSERT_EQ(mcp.content.size(), 1u);
+  const std::string* text = mcp.content[0].GetDict().FindString("text");
+  ASSERT_TRUE(text);
+  EXPECT_NE(text->find("declined"), std::string::npos);
+  EXPECT_NE(text->find("Do not retry"), std::string::npos);
+}
+
+TEST(AgentMcpToolsTest, OkResultIsNotError) {
+  ToolResult ok;
+  ok.ok = true;
+  ok.data.Set("ref", "e1");
+
+  McpToolResult mcp = ToolResultToMcpResult(ok);
+  EXPECT_FALSE(mcp.is_error);
+  ASSERT_EQ(mcp.content.size(), 1u);
+  const std::string* text = mcp.content[0].GetDict().FindString("text");
+  ASSERT_TRUE(text);
+  EXPECT_NE(text->find("\"ok\":true"), std::string::npos);
+}
+
+TEST(AgentMcpToolsTest, TurnGoneReturnsError) {
+  McpToolResult got = MissingControllerMcpResult();
+  EXPECT_TRUE(got.is_error);
+  ASSERT_EQ(got.content.size(), 1u);
+  EXPECT_EQ(*got.content[0].GetDict().FindString("text"),
+            "Browser control ended.");
+}
+
+}  // namespace
+}  // namespace rac::agent

+void PageHandler::BeginAgentToolTurn(const PendingSend& send, int send_id) {
+  auto* controller = rac::agent::AgentController::GetOrCreate(profile_);
+  if (!controller) {
+    return;
+  }
+  std::vector<content::WebContents*> attached;
+  BrowserWindowInterface* browser = GetBrowser();
+  for (int id : send.control_tab_ids) {
+    auto* tab = tabs::TabHandle(id).Get();
+    if (tab && tab->GetBrowserWindowInterface() == browser &&
+        IsAttachable(tab)) {
+      attached.push_back(tab->GetContents());
+    }
+  }
+  std::vector<std::string> user_messages;
+  for (const auto& message : send.request.messages) {
+    if (message.role == ChatMessage::Role::kUser) {
+      user_messages.push_back(message.text);
+    }
+  }
+  const std::string goal = send.request.messages.empty()
+                               ? std::string()
+                               : send.request.messages.back().text;
+  controller->BeginTurn(
+      browser, conversation_id_, goal, user_messages, attached,
+      base::BindRepeating(
+          [](base::WeakPtr<PageHandler> handler, int send_id,
+             base::DictValue event) {
+            if (!handler || !handler->IsJavascriptAllowed() ||
+                handler->active_send_id_ != send_id) {
+              return;
+            }
+            if (event.FindString("type") &&
+                *event.FindString("type") == "run_state" &&
+                event.FindString("state") &&
+                *event.FindString("state") == "stopped") {
+              base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                  FROM_HERE,
+                  base::BindOnce(
+                      [](base::WeakPtr<PageHandler> handler, int id) {
+                        if (handler && handler->active_send_id_ == id) {
+                          handler->StopSession();
+                        }
+                      },
+                      handler, send_id));
+            }
+            event.Set("sendId", send_id);
+            handler->FireWebUIListener("racAiAgentEvent", event);
+          },
+          weak_factory_.GetWeakPtr(), send_id));
+  agent_controller_ = controller->GetWeakPtr();
+  agent_mcp_tools_ =
+      std::make_unique<rac::agent::AgentMcpTools>(agent_controller_);
+  if (AiService* service = AiServiceFactory::GetForProfile(profile_)) {
+    // Create the service here: the session starts right after, and without a
+    // provider on the first turn it launches with no browser tools.
+    if (AcpService* acp = service->acp_service()) {
+      // Auto-allow at the MCP approval layer; plan/confirm/critic live in
+      // AgentController::HandleToolCall and must not be bypassed here.
+      acp->SetToolApprovalCallback(
+          base::BindRepeating([](const rac::agent::McpToolCallInfo&,
+                                 base::OnceCallback<void(bool allow)> decide) {
+            std::move(decide).Run(true);
+          }));
+      acp->SetToolProvider(agent_mcp_tools_.get());
+    }
+  }
+}

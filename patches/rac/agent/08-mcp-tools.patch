@@ -0,0 +1,48 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/agent_mcp_tools.h"
+
+#include <utility>
+
+#include "base/uuid.h"
+
+namespace rac::agent {
+
+AgentMcpTools::AgentMcpTools(base::WeakPtr<AgentController> controller)
+    : controller_(std::move(controller)) {}
+
+AgentMcpTools::~AgentMcpTools() = default;
+
+std::vector<McpToolSpec> AgentMcpTools::ListTools() {
+  std::vector<McpToolSpec> specs;
+  if (!controller_) {
+    return specs;
+  }
+  for (const ToolDefinition& tool : controller_->AvailableTools()) {
+    specs.push_back(ToolDefinitionToMcpSpec(tool));
+  }
+  return specs;
+}
+
+void AgentMcpTools::CallTool(const std::string& name,
+                             base::DictValue args,
+                             base::OnceCallback<void(McpToolResult)> done) {
+  if (!controller_) {
+    std::move(done).Run(MissingControllerMcpResult());
+    return;
+  }
+  ToolCall call;
+  call.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  call.name = name;
+  call.arguments = std::move(args);
+  controller_->HandleToolCall(
+      call, ToolCallSource::kMcp,
+      base::BindOnce(
+          [](base::OnceCallback<void(McpToolResult)> done, ToolResult result) {
+            std::move(done).Run(ToolResultToMcpResult(result));
+          },
+          std::move(done)));
+}
+
+}  // namespace rac::agent

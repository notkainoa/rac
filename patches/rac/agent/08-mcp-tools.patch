+++ src/chrome/browser/rac/agent/agent_mcp_convert.cc
@@ -0,0 +1,50 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/agent_mcp_convert.h"
+
+#include <utility>
+
+#include "base/json/json_writer.h"
+
+namespace rac::agent {
+namespace {
+
+McpToolResult TextResult(std::string text, bool is_error) {
+  McpToolResult result;
+  result.is_error = is_error;
+  result.content.Append(
+      base::DictValue().Set("type", "text").Set("text", std::move(text)));
+  return result;
+}
+
+}  // namespace
+
+McpToolSpec ToolDefinitionToMcpSpec(const ToolDefinition& tool) {
+  McpToolSpec spec;
+  spec.name = tool.name;
+  spec.description = tool.description;
+  spec.input_schema = tool.parameters.Clone();
+  spec.read_only = tool.kind == ToolKind::kRead;
+  return spec;
+}
+
+McpToolResult ToolResultToMcpResult(const ToolResult& result) {
+  base::DictValue value;
+  value.Set("ok", result.ok);
+  value.Set("error_code", result.error_code);
+  value.Set("error", result.error);
+  value.Set("may_have_acted", result.may_have_acted);
+  value.Set("data", result.data.Clone());
+  std::string json;
+  base::JSONWriter::Write(value, &json);
+  // Declined / blocked / failed actions are errors so the agent can react,
+  // but the JSON body still carries the full ToolResult shape.
+  return TextResult(std::move(json), !result.ok);
+}
+
+McpToolResult MissingControllerMcpResult() {
+  return TextResult("Browser control ended.", /*is_error=*/true);
+}
+
+}  // namespace rac::agent

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_AGENT_AGENT_MCP_TOOLS_H_
+#define CHROME_BROWSER_RAC_AGENT_AGENT_MCP_TOOLS_H_
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/rac/agent/agent_controller.h"
+#include "chrome/browser/rac/agent/agent_mcp_convert.h"
+#include "chrome/browser/rac/agent/mcp_tool_provider.h"
+
+namespace rac::agent {
+
+// McpToolProvider backed by a live AgentController turn. Holds only a
+// WeakPtr; if the turn ends, CallTool returns an error and never crashes.
+class AgentMcpTools : public McpToolProvider {
+ public:
+  explicit AgentMcpTools(base::WeakPtr<AgentController> controller);
+  ~AgentMcpTools() override;
+
+  std::vector<McpToolSpec> ListTools() override;
+  void CallTool(const std::string& name,
+                base::DictValue args,
+                base::OnceCallback<void(McpToolResult)> done) override;
+
+ private:
+  base::WeakPtr<AgentController> controller_;
+};
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_AGENT_MCP_TOOLS_H_

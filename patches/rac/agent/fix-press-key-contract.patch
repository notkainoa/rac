+TEST(ToolRegistryTest, EnumArgumentsAreValidated) {
+  const ToolDefinition* press = FindToolDefinition("press_key");
+  ASSERT_TRUE(press);
+  base::DictValue enter;
+  enter.Set("ref", "e1");
+  enter.Set("key", "Enter");
+  EXPECT_FALSE(ValidateToolArguments(*press, enter).has_value());
+  base::DictValue tab = enter.Clone();
+  tab.Set("key", "Tab");
+  EXPECT_TRUE(ValidateToolArguments(*press, tab).has_value());
+  // Extra arguments are ignored, not rejected.
+  enter.Set("confirmed", true);
+  EXPECT_FALSE(ValidateToolArguments(*press, enter).has_value());
+}

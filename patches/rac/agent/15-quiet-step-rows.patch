+TEST(AgentEventsTest, StepDetailTravelsOnlyWhenSet) {
+  const base::DictValue bare =
+      StepEvent(false, "step-1", "click", "Click", "t1", "Shop", "", true, "");
+  EXPECT_EQ(bare.Find("args"), nullptr);
+  EXPECT_EQ(bare.Find("target"), nullptr);
+  EXPECT_EQ(bare.Find("durationMs"), nullptr);
+  StepDetail detail;
+  detail.args.Set("ref", "e7");
+  detail.target_role = "button";
+  detail.target_name = "Sign in";
+  detail.target_ref = "e7";
+  detail.result = "ok";
+  detail.duration_ms = 420;
+  detail.guard = "Asked: a form submit";
+  detail.critic_verdict = "allow";
+  const base::DictValue full = StepEvent(true, "step-1", "click", "Click",
+                                         "t1", "Shop", "", true, "", detail);
+  EXPECT_EQ(*full.FindDict("args")->FindString("ref"), "e7");
+  EXPECT_EQ(*full.FindDict("target")->FindString("name"), "Sign in");
+  EXPECT_EQ(full.FindInt("durationMs"), 420);
+  EXPECT_EQ(*full.FindString("guard"), "Asked: a form submit");
+  EXPECT_EQ(*full.FindDict("critic")->FindString("verdict"), "allow");
+  // A started step never carries a result or timing.
+  const base::DictValue started = StepEvent(
+      false, "step-1", "click", "Click", "t1", "Shop", "", true, "", detail);
+  EXPECT_EQ(started.Find("result"), nullptr);
+  EXPECT_EQ(started.Find("durationMs"), nullptr);
+}
 }  // namespace rac::agent

+namespace {
+// What made the action risky, in a few words, or empty.
+std::string RiskyBecause(const ActionMetadata& action) {
+  const ActionRiskInput& risk = action.risk;
+  if (risk.is_password_field) {
+    return "a password field";
+  }
+  if (risk.is_payment_field) {
+    return "a payment field";
+  }
+  if (risk.is_file_input) {
+    return "a file field";
+  }
+  if (action.submit) {
+    return "a form submit";
+  }
+  if (action.press_enter) {
+    return "Enter in a form";
+  }
+  if (action.closing_user_tab) {
+    return "closing your tab";
+  }
+  if (action.unknown_target) {
+    return "a target it can't classify";
+  }
+  if (HasRiskyTarget(risk)) {
+    return "what the control says it does";
+  }
+  return "";
+}

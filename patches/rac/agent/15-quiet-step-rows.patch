+StepDetail AgentController::Detail(const ToolResult* result) const {
+  StepDetail detail;
+  const RefEntry* entry =
+      current_ ? current_->refs.Lookup(String(pending_.arguments, "ref"))
+               : nullptr;
+  for (const auto [key, value] : pending_.arguments) {
+    if (key == "text" && entry && (entry->password || entry->sensitive)) {
+      detail.args.Set(key, "[redacted]");
+    } else if (const std::string* text = value.GetIfString()) {
+      detail.args.Set(key, EscapeSnapshotText(*text, 200));
+    } else {
+      detail.args.Set(key, value.Clone());
+    }
+  }
+  if (entry) {
+    detail.target_role = entry->role;
+    detail.target_name = EscapeSnapshotText(entry->name, 100);
+    detail.target_ref = entry->ref;
+  }
+  if (result) {
+    detail.duration_ms = static_cast<int>(
+        (base::TimeTicks::Now() - step_started_).InMilliseconds());
+    detail.guard = step_guard_;
+    detail.critic_verdict = step_critic_verdict_;
+    detail.critic_note = step_critic_note_;
+    if (!result->ok) {
+      detail.result = result->error;
+    } else if (const std::string* text = result->data.FindString("text")) {
+      base::TruncateUTF8ToByteSize(*text, 2000, &detail.result);
+    }
+  }
+  return detail;
+}

+
+/* The run: every step of a reply behind one quiet line. While it works the
+ * line is the step in progress, with the earlier steps above it; once it
+ * ends the line is the step count, with the steps below. Rows are 13px
+ * lines on an 8px grid, no borders. Chevrons show on hover, and stay while
+ * open. */
+.run {
+  margin: 4px 0 8px;
+}
+
+.run-header,
+.row-line {
+  align-items: center;
+  background: none;
+  border: 0;
+  border-radius: 6px;
+  color: var(--text-muted);
+  display: flex;
+  font: inherit;
+  font-size: 13px;
+  gap: 8px;
+  height: 28px;
+  line-height: 20px;
+  padding: 0 6px 0 4px;
+  text-align: start;
+  width: 100%;
+}
+
+.run-header:hover:not(:disabled),
+.row-line:hover:not(:disabled) {
+  background: var(--token-hover);
+  color: var(--text);
+}
+
+.run-header:focus-visible,
+.row-line:focus-visible {
+  outline: 2px solid color-mix(in srgb, currentcolor 35%, transparent);
+  outline-offset: -2px;
+}
+
+.run-header:disabled,
+.row-line:disabled {
+  cursor: default;
+}
+
+.run-title,
+.row-label {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.run-header .chevron,
+.row-line .chevron {
+  color: var(--text-faint);
+  flex: none;
+  height: 14px;
+  margin-inline-end: -4px;
+  opacity: 0;
+  rotate: -90deg;
+  stroke-width: 2;
+  transition: rotate 150ms var(--ease-out), opacity 120ms ease;
+  width: 14px;
+}
+
+.run[data-open='true'] > .run-header .chevron,
+.row[data-open='true'] > .row-line .chevron {
+  rotate: 0deg;
+}
+
+/* While the run works, its steps open above the line. */
+.run[data-active='true'][data-open='true'] > .run-header .chevron {
+  rotate: 180deg;
+}
+
+/* An open row keeps its chevron, so it shows how to close. */
+:is(.run-header, button.row-line):is(:hover, :focus-visible,
+    [aria-expanded='true']):not(:disabled) .chevron {
+  opacity: 1;
+}
+
+.run-header[data-status] .row-icon {
+  color: var(--text-muted);
+}
+
+.run-title.arriving {
+  animation: run-title-in 150ms ease-out both;
+}
+
+@keyframes run-title-in {
+  from {
+    opacity: 0;
+  }
+}
+
+.row-icon {
+  color: var(--text-faint);
+  flex: none;
+  height: 15px;
+  stroke-width: 1.7;
+  width: 15px;
+}
+
+.row[data-status='running'] .row-icon,
+.row[data-status='needs'] .row-icon {
+  color: var(--text-muted);
+}
+
+.row[data-status='failed'] .row-icon {
+  color: color-mix(in srgb, var(--error) 70%, var(--text-faint));
+}
+
+.row[data-status='blocked'] .row-icon {
+  color: light-dark(#9a5300, #f2b54d);
+}
+
+/* The tiny status at the row's end: a check, a turning arc, or a word. */
+.row-status {
+  align-items: center;
+  color: var(--text-faint);
+  display: inline-flex;
+  flex: none;
+  font-size: 11px;
+  gap: 4px;
+  height: 20px;
+  line-height: 20px;
+  margin-inline-start: auto;
+}
+
+.row-status svg {
+  height: 14px;
+  stroke-width: 2.2;
+  width: 14px;
+}
+
+.row-spinner {
+  animation: step-spin 0.8s linear infinite;
+  border: 1.5px solid var(--spin-track);
+  border-radius: 50%;
+  border-top-color: var(--text);
+  box-sizing: border-box;
+  height: 12px;
+  width: 12px;
+}
+
+.item-assistant[data-asking] .row-spinner {
+  animation: none;
+  background: #fcbf49;
+  border: 0;
+  height: 7px;
+  width: 7px;
+}
+
+.row[data-status='failed'] .row-status {
+  color: color-mix(in srgb, var(--error) 80%, var(--text-muted));
+}
+
+/* Detail opens by height only, so no row beside it shifts. */
+.run-body,
+.row-body {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows 150ms ease-out;
+}
+
+.run[data-open='true'] > .run-body,
+.row[data-open='true'] > .row-body {
+  grid-template-rows: 1fr;
+}
+
+.run-body-inner,
+.row-body-inner {
+  min-height: 0;
+  overflow: hidden;
+}
+
+/* A closed row's body stays out of the tab order. */
+.run[data-open='false'] > .run-body,
+.row[data-open='false'] > .row-body {
+  visibility: hidden;
+}
+
+/* Steps sit a little in from the line they open from: under "7 steps",
+ * and under a folded row such as "Read the page twice". While the run
+ * works, the earlier steps open above the step in progress, level with it. */
+.run[data-active='false'] > .run-body > .run-body-inner,
+.row-body-inner > .row {
+  padding-inline-start: 12px;
+}
+
+/* Lines up with the row's label, past the chevron and the icon. */
+.row-detail {
+  color: var(--text-muted);
+  font-size: 12px;
+  line-height: 18px;
+  padding: 2px 6px 8px 45px;
+}
+
+.row-kv {
+  display: grid;
+  gap: 0 10px;
+  grid-template-columns: max-content minmax(0, 1fr);
+  margin: 0;
+}
+
+.row-kv dt {
+  color: var(--text-faint);
+}
+
+.row-kv dd {
+  margin: 0;
+  overflow-wrap: anywhere;
+}
+
+.row-line-text {
+  overflow-wrap: anywhere;
+}
+
+.row-mono {
+  background: var(--token);
+  border-radius: 6px;
+  color: var(--text-muted);
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 11.5px;
+  line-height: 18px;
+  margin: 6px 0 0;
+  max-height: 148px;
+  overflow: auto;
+  overflow-wrap: anywhere;
+  padding: 6px 8px;
+  white-space: pre-wrap;
+}
+
+.row-link {
+  background: none;
+  border: 0;
+  color: var(--text-muted);
+  font: inherit;
+  font-size: 12px;
+  margin-top: 6px;
+  padding: 0;
+  text-decoration: underline;
+  text-decoration-color: color-mix(in srgb, currentcolor 40%, transparent);
+  text-underline-offset: 2px;
+}
+
+.row-link:hover {
+  color: var(--text);
+}
+
+/* The confirm card: a tinted surface, no edge, no shadow. The title asks,
+ * one dim line says what could happen and where, then the buttons. */
+.confirm-card {
+  background: light-dark(rgb(0 0 0 / 4%), rgb(255 255 255 / 6%));
+  border-color: transparent;
+  border-radius: 12px;
+  box-shadow: none;
+  margin: 4px 0 8px;
+  padding: 12px;
+}
+
+/* It takes focus when it arrives; a ring there would read as a border, so
+ * focus deepens the tint instead. */
+.confirm-card:focus-visible {
+  background: light-dark(rgb(0 0 0 / 6%), rgb(255 255 255 / 8%));
+  border-color: transparent;
+  box-shadow: none;
+}
+
+.confirm-card .agent-title {
+  font-size: 13px;
+  line-height: 20px;
+}
+
+.confirm-reason {
+  color: var(--text-muted);
+  font-size: 12px;
+  line-height: 16px;
+  margin-top: 2px;
+  overflow-wrap: anywhere;
+}
+
+.confirm-card .agent-actions {
+  gap: 4px;
+  margin-top: 12px;
+}
+
+.confirm-card .pill-action {
+  font-size: 12px;
+  height: 24px;
+  padding: 0 10px;
+}
+
+/* "Always allow on <host>" follows the buttons, or wraps under them. */
+.confirm-card .pill-action.quiet {
+  display: block;
+  line-height: 24px;
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .run-body,
+  .row-body,
+  .run-header .chevron,
+  .row-line .chevron {
+    transition: none;
+  }
+
+  .run-title.arriving {
+    animation: none;
+  }
+
+  .row-spinner {
+    animation: none;
+    background: var(--text);
+    border: 0;
+    height: 6px;
+    width: 6px;
+  }
+}

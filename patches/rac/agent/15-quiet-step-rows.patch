+  error: 'M10 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12zM10 7v3.5M10 13v.01',
+  stop: 'M6.5 6.5h7v7h-7z',
+  plan: 'M5 6h10M5 10h10M5 14h6',
+};
+
+export type RowStatus = 'running'|'done'|'failed'|'stopped'|'skipped'|
+    'needs'|'confirmed'|'blocked';
+
+// One section of a row's detail: key: value pairs, a line of text, or a
+// monospace block that scrolls past a few lines.
+export type DetailPart = {
+  kind: 'kv',
+  pairs: Array<[string, string]>,
+}|{kind: 'line', text: string}|{kind: 'mono', text: string};
+
+export interface RunRow {
+  key: string;
+  icon: RowIcon;
+  // The plain verb phrase on the collapsed line.
+  label: string;
+  status: RowStatus;
+  detail: DetailPart[];
+  // The raw payload behind "Copy JSON", when there is one.
+  json?: string;
+  // Adjacent rows that fold into this one, as "Scrolled 3 times".
+  members?: RunRow[];
+  // Rows that say the same thing fold together when both have this and it
+  // matches; empty for rows that always stand alone.
+  foldKey?: string;
+  // When the row's step began, to order the browser's rows with an agent's
+  // own.
+  at: number;
+}
+
+function str(key: string, ...args: string[]): string {
+  return args.length > 0 ? loadTimeData.getStringF(key, ...args) :
+                           loadTimeData.getString(key);
+}
+
+function make<K extends keyof HTMLElementTagNameMap>(
+    tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
+  const element = document.createElement(tag);
+  if (className) {
+    element.className = className;
+  }
+  if (text) {
+    element.textContent = text;
+  }
+  return element;
+}
+
+export function rowIcon(icon: RowIcon): SVGSVGElement {
+  const svg = makeIcon(ICONS[icon]);
+  svg.classList.add('row-icon');
+  return svg;
+}
+
+// Folds runs of rows that say the same thing into one row with a count.
+export function foldSimilar(rows: RunRow[]): RunRow[] {
+  const out: RunRow[] = [];
+  for (const row of rows) {
+    const last = out[out.length - 1];
+    if (last && row.foldKey && last.foldKey === row.foldKey) {
+      const members = last.members ?? [{...last, members: undefined}];
+      members.push(row);
+      const count = members.length;
+      out[out.length - 1] = {
+        ...last,
+        key: `${last.key}+${count}`,
+        label: count === 2 ? str('twice', row.label) :
+                             str('nTimes', row.label, String(count)),
+        detail: [],
+        json: undefined,
+        members,
+      };
+      continue;
+    }
+    out.push(row);
+  }
+  return out;
+}
+
+// What the tiny text at the row's end says. Done rows show the check only.
+function statusWord(status: RowStatus): string {
+  switch (status) {
+    case 'needs':
+      return str('needsYou');
+    case 'stopped':
+      return str('rowStopped');
+    case 'failed':
+      return str('rowFailed');
+    case 'skipped':
+      return str('rowSkipped');
+    case 'confirmed':
+      return str('rowConfirmed');
+    case 'blocked':
+      return str('rowBlocked');
+    default:
+      return '';
+  }
+}
+
+function makeDetail(row: RunRow): HTMLElement {
+  const body = make('div', 'row-detail');
+  for (const part of row.detail) {
+    if (part.kind === 'kv') {
+      const list = make('dl', 'row-kv');
+      for (const [key, value] of part.pairs) {
+        list.append(make('dt', '', key), make('dd', '', value));
+      }
+      body.appendChild(list);
+    } else if (part.kind === 'line') {
+      body.appendChild(make('div', 'row-line-text', part.text));
+    } else {
+      body.appendChild(make('pre', 'row-mono', part.text));
+    }
+  }
+  if (row.json) {
+    const json = row.json;
+    const copy = make('button', 'row-link', str('copyJson'));
+    copy.type = 'button';
+    copy.addEventListener('click', () => {
+      navigator.clipboard.writeText(json).then(() => {
+        copy.textContent = str('copied');
+        setTimeout(() => copy.textContent = str('copyJson'), 1200);
+      });
+    });
+    body.appendChild(copy);
+  }
+  return body;
+}
+
+// A row that opens its detail in place. The body animates height only, so
+// nothing beside it moves.
+export function makeRow(owner: Expander, row: RunRow): HTMLElement {
+  const wrap = make('div', 'row');
+  wrap.dataset['status'] = row.status;
+  const hasBody = row.detail.length > 0 || !!row.json || !!row.members;
+  const open = hasBody && owner.expanded.has(row.key);
+  const line = make('button', 'row-line');
+  line.type = 'button';
+  line.disabled = !hasBody;
+  line.dataset['stepKey'] = row.key;
+  line.id = `row-${row.key}`;
+  line.setAttribute('aria-expanded', String(open));
+  // The chevron keeps its place on every row, shown or not, so the rows
+  // line up and nothing moves when it appears.
+  line.append(
+      makeChevron(), rowIcon(row.icon), make('span', 'row-label', row.label),
+      makeStatus(row.status));
+  const body = make('div', 'row-body');
+  body.id = `body-${row.key}`;
+  body.setAttribute('role', 'group');
+  body.setAttribute('aria-labelledby', line.id);
+  line.setAttribute('aria-controls', body.id);
+  const inner = make('div', 'row-body-inner');
+  if (row.members) {
+    for (const member of row.members) {
+      inner.appendChild(makeRow(owner, member));
+    }
+  } else {
+    inner.appendChild(makeDetail(row));
+  }
+  body.appendChild(inner);
+  wrap.dataset['open'] = String(open);
+  line.addEventListener('click', () => {
+    const now = wrap.dataset['open'] !== 'true';
+    wrap.dataset['open'] = String(now);
+    line.setAttribute('aria-expanded', String(now));
+    if (now) {
+      owner.expanded.add(row.key);
+    } else {
+      owner.expanded.delete(row.key);
+    }
+  });
+  wrap.append(line, body);
+  return wrap;
+}
+
+// How many steps a list of rows stands for, and how many of them failed.
+function tally(rows: RunRow[]): {steps: number, failed: number} {
+  let steps = 0;
+  let failed = 0;
+  for (const row of rows) {
+    for (const step of row.members ?? [row]) {
+      steps++;
+      if (step.status === 'failed') {
+        failed++;
+      }
+    }
+  }
+  return {steps, failed};
+}
+
+// The status at the end of a row or the run's line.
+function makeStatus(status: RowStatus): HTMLElement {
+  const element = make('span', 'row-status');
+  const word = statusWord(status);
+  if (word) {
+    element.textContent = word;
+  } else if (status === 'done') {
+    element.appendChild(makeIcon('M5.5 10.25l3 3 6-6.5'));
+  } else if (status === 'running') {
+    const spinner = make('span', 'row-spinner');
+    spinner.setAttribute('aria-hidden', 'true');
+    element.appendChild(spinner);
+  }
+  return element;
+}
+
+// The run is one line. While it works, the line is the step in progress and
+// the steps before it unfold above it, first at the top. Once it ends, the
+// line says "7 steps" and the steps unfold below it; opened, it also says
+// how many failed.
+export function makeRun(
+    owner: Expander, key: string, rows: RunRow[], active: boolean,
+    justEnded = false): HTMLElement|null {
+  // A step waiting on the user shows as its confirm card, so while the run
+  // works the line keeps the step before it rather than repeat the card.
+  const shown = active ? rows.filter(row => row.status !== 'needs') : rows;
+  if (shown.length === 0) {
+    return null;
+  }
+  const live = active ?
+      ([...shown].reverse().find(row => row.status === 'running') ??
+       shown[shown.length - 1]) :
+      undefined;
+  const history = live ? shown.filter(row => row !== live) : shown;
+  const open = history.length > 0 && owner.expanded.has(key);
+  const run = make('div', 'run');
+  run.dataset['open'] = String(open);
+  run.dataset['active'] = String(active);
+  const header = make('button', 'run-header');
+  header.type = 'button';
+  header.disabled = history.length === 0;
+  header.dataset['stepKey'] = key;
+  header.setAttribute('aria-expanded', String(open));
+  header.setAttribute('aria-controls', `run-${key}`);
+  let showCount = (_now: boolean) => {};
+  if (live) {
+    header.dataset['status'] = live.status;
+    header.append(
+        makeChevron(), rowIcon(live.icon),
+        make('span', 'run-title', live.label), makeStatus(live.status));
+  } else {
+    const {steps, failed} = tally(rows);
+    const total = steps === 1 ? str('oneStep') : str('nSteps', String(steps));
+    const title = make('span', 'run-title', total);
+    if (justEnded) {
+      title.classList.add('arriving');
+    }
+    // Opened, the line also says how many of the steps failed.
+    showCount = (now: boolean) => {
+      title.textContent =
+          now && failed > 0 ? str('stepsFailed', total, String(failed)) : total;
+    };
+    showCount(open);
+    header.append(makeChevron(), title);
+  }
+  header.addEventListener('click', () => {
+    const now = run.dataset['open'] !== 'true';
+    run.dataset['open'] = String(now);
+    header.setAttribute('aria-expanded', String(now));
+    showCount(now);
+    if (now) {
+      owner.expanded.add(key);
+    } else {
+      owner.expanded.delete(key);
+    }
+  });
+  const body = make('div', 'run-body');
+  body.id = `run-${key}`;
+  const inner = make('div', 'run-body-inner');
+  for (const row of foldSimilar(history)) {
+    inner.appendChild(makeRow(owner, row));
+  }
+  body.appendChild(inner);
+  if (live) {
+    run.append(body, header);
+  } else {
+    run.append(header, body);
+  }
+  return run;
+}

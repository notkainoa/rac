+#include "chrome/renderer/rac/agent/snapshot_agent.h"
+
+#include "base/functional/bind.h"
+#include "chrome/common/rac/agent/snapshot.mojom.h"
+#include "chrome/renderer/rac/agent/semantic_validator.h"
+#include "content/public/renderer/render_frame.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "mojo/public/cpp/bindings/associated_receiver.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_registry.h"
+namespace rac::agent {
+namespace {
+class SnapshotAgent final : public content::RenderFrameObserver,
+                            public mojom::Snapshot {
+ public:
+  SnapshotAgent(content::RenderFrame* frame,
+                mojo::PendingAssociatedReceiver<mojom::Snapshot> receiver)
+      : content::RenderFrameObserver(frame),
+        receiver_(this, std::move(receiver)) {
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&SnapshotAgent::OnDestruct, base::Unretained(this)));
+  }
+  void GetSubmissions(const std::vector<int32_t>& nodes,
+                      GetSubmissionsCallback callback) override {
+    std::move(callback).Run(rac::agent::GetSubmissions(*render_frame(), nodes));
+  }
+  void OnDestruct() override { delete this; }
+
+ private:
+  mojo::AssociatedReceiver<mojom::Snapshot> receiver_;
+};
+}  // namespace
+void RegisterSnapshotInterface(content::RenderFrame& frame) {
+  frame.GetAssociatedInterfaceRegistry()->AddInterface<mojom::Snapshot>(
+      base::BindRepeating(
+          [](content::RenderFrame* frame,
+             mojo::PendingAssociatedReceiver<mojom::Snapshot> receiver) {
+            // Allocation and extraction happen only on an explicit agent query.
+            new SnapshotAgent(frame, std::move(receiver));
+          },
+          &frame));
+}
+}  // namespace rac::agent

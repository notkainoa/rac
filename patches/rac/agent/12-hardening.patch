+            if (!page.has_value()) {
+              std::move(done).Run(std::move(page), {});
+              return;
+            }
+            Nodes nodes;
+            CollectFormNodes(page->proto.root_node(),
+                             page->proto.main_frame_data()
+                                 .document_identifier()
+                                 .serialized_token(),
+                             nodes);
+            if (nodes.empty()) {
+              std::move(done).Run(std::move(page), {});
+              return;
+            }
+            auto state = std::make_shared<EnrichedPage>(
+                EnrichedPage{std::move(page), {}, false});
+            auto barrier = base::BarrierClosure(
+                nodes.size(),
+                base::BindOnce(
+                    [](std::shared_ptr<EnrichedPage> state,
+                       OnAgentPageContentDone done) {
+                      if (state->failed) {
+                        std::move(done).Run(
+                            base::unexpected(
+                                "Form document changed while reading."),
+                            {});
+                      } else {

+
+#include "url/gurl.h"
+namespace rac::agent {
+class ContainmentPolicy {
+ public:
+  void Arm(std::set<std::string> origins);
+  void BindNavigation(GURL url,
+                      std::string method,
+                      bool form,
+                      std::optional<int> frame = std::nullopt);
+  void Revoke();
+  bool enforcing() const { return armed_; }
+  bool revoked() const { return revoked_; }
+  bool Allows(const GURL& url,
+              std::string_view method,
+              std::optional<int> frame = std::nullopt) const;
+  // A server redirect of a navigation whose first request matched Allows().
+  // The request already reached the approved server, so only the destination
+  // site matters: an approved origin, or the same site as one (http to https,
+  // www, a trailing slash, a POST answered with 303).
+  bool AllowsRedirect(const GURL& url,
+                      std::optional<int> frame = std::nullopt) const;
+
+ private:
+  std::set<std::string> origins_;
+  GURL expected_url_;
+  std::string expected_method_;
+  std::optional<int> expected_frame_;
+  bool form_ = false;
+  bool armed_ = false;
+  bool revoked_ = false;
+};
+}  // namespace rac::agent

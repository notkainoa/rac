+#include "chrome/browser/rac/agent/containment_policy.h"
+
+#include "base/strings/string_util.h"
+#include "url/origin.h"
+namespace rac::agent {
+void ContainmentPolicy::Arm(std::set<std::string> origins) {
+  origins_ = std::move(origins);
+  expected_url_ = GURL();
+  expected_method_.clear();
+  expected_frame_.reset();
+  armed_ = true;
+  revoked_ = false;
+}
+void ContainmentPolicy::BindNavigation(GURL url,
+                                       std::string method,
+                                       bool form,
+                                       std::optional<int> frame) {
+  expected_url_ = std::move(url);
+  expected_method_ = base::ToUpperASCII(method);
+  form_ = form;
+  expected_frame_ = frame;
+}
+void ContainmentPolicy::Revoke() {
+  if (armed_) {
+    revoked_ = true;
+  }
+}
+bool ContainmentPolicy::Allows(const GURL& url,
+                               std::string_view method,
+                               std::optional<int> frame) const {
+  if (!armed_) {
+    return true;
+  }
+  if (revoked_ || (expected_frame_ && expected_frame_ != frame) ||
+      !url.SchemeIsHTTPOrHTTPS() ||
+      !origins_.contains(url::Origin::Create(url).Serialize())) {
+    return false;
+  }
+  if (expected_url_.is_empty()) {
+    return true;
+  }
+  if (base::ToUpperASCII(method) != expected_method_) {
+    return false;
+  }
+  auto comparable = [this](const GURL& candidate) {
+    GURL::Replacements replacements;
+    replacements.ClearRef();
+    // GET submissions replace the action query with the serialized form data.
+    if (form_ && expected_method_ == "GET") {
+      replacements.ClearQuery();
+    }
+    return candidate.ReplaceComponents(replacements);
+  };
+  return comparable(url) == comparable(expected_url_);
+}
+}  // namespace rac::agent

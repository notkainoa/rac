+bool ValidateDispatch(const actor::ToolBase& tool,
+                      const actor::ResolvedTarget* click,
+                      bool require_focus) {
+  if (!tool.rac_expectation()) {
+    return true;
+  }
+  if (!ValidateActionSemantics(*tool.frame(), tool.rac_node_id(),
+                               *tool.rac_expectation())) {
+    return false;
+  }
+  auto approved = actor::GetNodeFromId(*tool.frame(), tool.rac_node_id());
+  if (require_focus && actor::FindFocusedElement(*tool.frame()) != approved) {
+    return false;
+  }
+  if (click) {
+    auto* widget = click->GetWidget(tool);
+    if (!widget || approved.IsNull()) {
+      return false;
+    }
+    auto hit =
+        widget->HitTestResultAt(click->widget_point).GetNodeOrPseudoNode();
+    if (hit.IsNull() || !approved.ContainsViaFlatTree(&hit)) {
+      return false;
+    }
+    // Decorative descendants are normal hit targets. A nested control/link is
+    // a different activation target even when it lies inside the approved node.
+    for (auto node = hit; node != approved; node = node.ParentInFlatTree()) {
+      auto element = node.DynamicTo<blink::WebElement>();
+      if (!element) {
+        continue;
+      }
+      const auto role =
+          element.GetAttribute(blink::WebString::FromUtf8("role")).Utf8();
+      if (element.DynamicTo<blink::WebFormControlElement>() ||
+          element.HasHTMLTagName(blink::WebString::FromUtf8("a")) ||
+          role == "button" || role == "link") {
+        return false;
+      }
+    }
+  }
+  return true;
+}

+void ActionContext::OnInputEvent(const content::RenderWidgetHost&,
+                                 const blink::WebInputEvent& event,
+                                 InputEventSource) {
+  using Type = blink::WebInputEvent::Type;
+  if (event.GetType() == Type::kMouseDown ||
+      event.GetType() == Type::kMouseUp ||
+      event.GetType() == Type::kRawKeyDown ||
+      event.GetType() == Type::kTouchStart ||
+      event.GetType() == Type::kTouchEnd) {
+    // Actor input runs inside the renderer and never reaches this observer.
+    user_inputs_.push_back(event.TimeStamp());
+    if (user_inputs_.size() > 8) {
+      user_inputs_.pop_front();
+    }
+    // Once the agent's authority has ended (Stop, turn end, browser control
+    // off), the user's own input hands the page back, so their downloads,
+    // popups, and file pickers work again. A paused turn keeps it, because
+    // the user's input is what paused it.
+    if (policy_.enforcing() && policy_.revoked() && !paused_ &&
+        (event.GetType() == Type::kMouseDown ||
+         event.GetType() == Type::kRawKeyDown ||
+         event.GetType() == Type::kTouchStart)) {
+      // Observers must not be removed from inside the host's notification.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&ActionContext::HandBack, weak_factory_.GetWeakPtr()));
+    }
+  }
+}
+void ActionContext::HandBack() {
+  if (!policy_.enforcing() || !policy_.revoked() || paused_) {
+    return;

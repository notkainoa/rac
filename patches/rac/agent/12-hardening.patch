+ActionContext* ActionContext::ForNavigation(content::NavigationHandle& handle) {
+  auto* stored =
+      static_cast<InitiatorContext*>(handle.GetUserData(&kInitiatorContextKey));
+  if (!stored && handle.GetInitiatorFrameToken()) {
+    auto* frame = content::RenderFrameHost::FromFrameToken(
+        {handle.GetInitiatorProcessId(), *handle.GetInitiatorFrameToken()});
+    auto* contents =
+        frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+    if (From(contents)) {
+      auto source = std::make_unique<InitiatorContext>();
+      source->contents = contents->GetWeakPtr();
+      stored = source.get();
+      handle.SetUserData(&kInitiatorContextKey, std::move(source));

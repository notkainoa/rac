+using Nodes = std::map<std::string, std::vector<int32_t>>;
+void CollectFormNodes(const optimization_guide::proto::ContentNode& node,
+                      std::string document,
+                      Nodes& nodes) {
+  const auto& attr = node.content_attributes();
+  if (attr.has_iframe_data() && attr.iframe_data().has_frame_data()) {
+    document = attr.iframe_data()
+                   .frame_data()
+                   .document_identifier()
+                   .serialized_token();
+  }
+  const bool interactive =
+      attr.has_form_control_data() ||
+      (attr.has_interaction_info() &&
+       (attr.interaction_info().is_focusable() ||
+        attr.interaction_info().is_clickable() ||
+        !attr.interaction_info().clickability_reasons().empty()));
+  // APC can expose native image submits as generic clickable images, without
+  // form_control_data. Ask native semantics for every interactive node.
+  if (interactive && attr.has_common_ancestor_dom_node_id()) {
+    nodes[document].push_back(attr.common_ancestor_dom_node_id());
+  }
+  for (const auto& child : node.children_nodes()) {
+    CollectFormNodes(child, document, nodes);
+  }
+}

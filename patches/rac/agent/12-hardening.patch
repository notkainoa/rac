+std::vector<mojom::SubmissionPtr> GetSubmissions(
+    const content::RenderFrame& frame,
+    const std::vector<int32_t>& nodes) {
+  std::vector<mojom::SubmissionPtr> result;
+  for (int node : nodes) {
+    // This interface is document-scoped, unlike actor tools, which are sent to
+    // the local root. Do not use the actor helper's local-root-only lookup.
+    auto element =
+        blink::WebNode::FromDomNodeId(node).DynamicTo<blink::WebElement>();
+    result.push_back(element && element.GetDocument().GetFrame() ==
+                                    frame.GetWebFrame()
+                         ? ResolveSubmission(element)
+                         : nullptr);
+  }
+  return result;
+}

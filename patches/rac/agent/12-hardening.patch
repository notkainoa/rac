+mojom::SubmissionPtr ResolveSubmission(blink::WebElement element) {
+  auto control = element.DynamicTo<blink::WebFormControlElement>();
+  if (!control || !control.Form()) {
+    return nullptr;
+  }
+  auto form = control.Form();
+  blink::WebFormControlElement submitter;
+  if (IsSubmit(control)) {
+    submitter = control;
+  } else {
+    // Enter activates the first native submitter, including form= controls.
+    // A disabled default submitter prevents submission, rather than skipping
+    // it.
+    for (auto candidate : form.GetFormControlElements()) {
+      if (candidate.Form() == form && IsSubmit(candidate)) {
+        submitter = candidate;
+        break;
+      }
+    }
+  }
+  auto attr = [](blink::WebElement e, const char* name) {
+    return e.GetAttribute(blink::WebString::FromUtf8(name)).Utf8();
+  };
+  auto overridden = [&](const char* override_name, const char* form_name) {
+    return submitter && submitter.HasAttribute(
+                            blink::WebString::FromUtf8(override_name))
+               ? attr(submitter, override_name)
+               : attr(form, form_name);
+  };
+  std::string action = overridden("formaction", "action");
+  auto document = element.GetDocument();
+  action = action.empty()
+               ? document.Url().GetString().Utf8()
+               : document.CompleteURL(blink::WebString::FromUtf8(action))
+                     .GetString()
+                     .Utf8();
+  std::string method = base::ToLowerASCII(overridden("formmethod", "method"));
+  if (method != "post" && method != "dialog") {
+    method = "get";
+  }
+  std::string target = overridden("formtarget", "target");
+  if (target.empty()) {
+    auto base =
+        document.QuerySelector(blink::WebString::FromUtf8("base[target]"));
+    if (base) {
+      target = attr(base, "target");
+    }
+  }
+  if (target.empty() || base::EqualsCaseInsensitiveASCII(target, "_self")) {
+    target = "_self";
+  }
+  std::string name = attr(element, "aria-label");
+  if (name.empty()) {
+    name = control.NameForAutofill().Utf8();
+  }
+  if (name.empty()) {
+    name = attr(element, "alt");
+  }
+  return mojom::Submission::New(
+      action, method, target, submitter ? submitter.GetDomNodeId() : 0,
+      ControlType(control.FormControlType()), Clean(name));
+}

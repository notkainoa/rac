+namespace rac::agent {
+TEST(ContainmentPolicyTest, RevocationKeepsDelayedEffectsRestricted) {
+  ContainmentPolicy policy;
+  const GURL local("https://example.com/start");
+  const GURL other("https://other.example/steal");
+  EXPECT_TRUE(policy.Allows(other, "GET"));
+  policy.Arm({"https://example.com"});
+  EXPECT_TRUE(policy.Allows(local, "GET"));
+  EXPECT_FALSE(policy.Allows(other, "GET"));
+  // The same revocation runs for Pause, Stop, pref disable, and turn end.
+  policy.Revoke();
+  EXPECT_TRUE(policy.enforcing());
+  EXPECT_FALSE(policy.Allows(local, "GET"));
+  EXPECT_FALSE(policy.Allows(other, "GET"));
+  policy.Revoke();
+  EXPECT_FALSE(policy.Allows(other, "GET"));
+  policy.Arm({"https://example.com"});

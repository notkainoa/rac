+mojom::SubmissionPtr ResolveSubmission(blink::WebElement element) {
+  auto control = element.DynamicTo<blink::WebFormControlElement>();
+  if (!control || !control.Form()) {
+    return nullptr;
+  }
+  auto form = control.Form();
+  blink::WebFormControlElement submitter;
+  if (IsSubmit(control)) {
+    submitter = control;
+  } else {
+    // Enter activates the first native submitter, including form= controls.
+    // A disabled default submitter prevents submission, rather than skipping
+    // it.
+    for (auto candidate : form.GetFormControlElements()) {
+      if (candidate.Form() == form && IsSubmit(candidate)) {
+        submitter = candidate;
+        break;
+      }
+    }
+  }
+  auto attr = [](blink::WebElement e, const char* name) {
+    return e.GetAttribute(blink::WebString::FromUtf8(name)).Utf8();
+  };
+  auto overridden = [&](const char* override_name, const char* form_name) {
+    return submitter && submitter.HasAttribute(
+                            blink::WebString::FromUtf8(override_name))
+               ? attr(submitter, override_name)
+               : attr(form, form_name);
+  };

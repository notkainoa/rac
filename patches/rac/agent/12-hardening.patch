+// The text a snapshot name is built from: text nodes and image alt text,
+// skipping aria-hidden and undisplayed subtrees (icon ligatures, for example).
+void AppendVisibleText(const blink::WebNode& node,
+                       int depth,
+                       std::string& out) {
+  if (depth > 32 || out.size() > 4096) {
+    return;
+  }
+  for (auto child = node.FirstChild(); !child.IsNull();
+       child = child.NextSibling()) {
+    if (child.IsTextNode()) {
+      out += child.NodeValue().Utf8();
+      out += ' ';
+      continue;
+    }
+    auto element = child.DynamicTo<blink::WebElement>();
+    if (!element) {
+      continue;
+    }
+    if (base::EqualsCaseInsensitiveASCII(
+            element.GetAttribute(blink::WebString::FromUtf8("aria-hidden"))
+                .Utf8(),
+            "true") ||
+        element.GetComputedValue(blink::WebString::FromUtf8("display"))
+                .Utf8() == "none" ||
+        element.GetComputedValue(blink::WebString::FromUtf8("visibility"))
+                .Utf8() == "hidden") {
+      continue;
+    }
+    if (element.HasHTMLTagName(blink::WebString::FromUtf8("img"))) {
+      out += element.GetAttribute(blink::WebString::FromUtf8("alt")).Utf8();
+      out += ' ';
+      continue;
+    }
+    AppendVisibleText(element, depth + 1, out);
+  }

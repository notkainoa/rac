+#ifndef CHROME_COMMON_RAC_AGENT_SUBMISSION_H_
+#define CHROME_COMMON_RAC_AGENT_SUBMISSION_H_
+#include <cstdint>
+#include <map>
+#include <string>
+#include <utility>
+namespace rac::agent {
+struct Submission {
+  std::string action;
+  std::string method;
+  std::string target;
+  int32_t submitter = 0;
+  std::string control_type = {};
+  std::string name = {};
+  bool operator==(const Submission&) const = default;
+  // Length prefixes keep arbitrary attribute contents unambiguous. This travels
+  // in rac's existing opaque renderer expectation, not in model/page text.
+  std::string Fingerprint() const {
+    auto field = [](const std::string& value) {
+      return std::to_string(value.size()) + ":" + value;
+    };
+    return field(action) + field(method) + field(target) +
+           std::to_string(submitter) + ":" + field(control_type) + field(name);
+  }
+};
+using Submissions = std::map<std::pair<std::string, int32_t>, Submission>;
+// Lifetime validity does not imply action validity (Pause/Resume reuse
+// runners).
+class ActionGeneration {
+ public:
+  uint64_t Advance() { return ++value_; }
+  uint64_t current() const { return value_; }
+  bool Matches(uint64_t captured) const { return captured == value_; }
+
+ private:
+  uint64_t value_ = 0;
+};
+}  // namespace rac::agent

+bool IsSubmit(const blink::WebFormControlElement& control) {
+  using Type = blink::mojom::FormControlType;
+  return control && (control.FormControlType() == Type::kButtonSubmit ||
+                     control.FormControlType() == Type::kInputSubmit ||

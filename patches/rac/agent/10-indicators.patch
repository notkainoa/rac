+// The status pill: what the agent is doing, and Stop.
+class StatusPill : public views::View {
+  METADATA_HEADER(StatusPill, views::View)
+
+ public:
+  StatusPill(BrowserWindowInterface* browser,
+             base::RepeatingClosure stop,
+             base::RepeatingClosure resume,
+             base::RepeatingClosure open_sidebar)
+      : browser_(browser),
+        stop_(std::move(stop)),
+        open_sidebar_(std::move(open_sidebar)) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetOpacity(0);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(
+        kShadowMargin, kShadowMargin + 12, kShadowMargin, kShadowMargin + 4)));
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    layout->set_minimum_cross_axis_size(kPillHeight);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+    GetViewAccessibility().SetName(u"rac agent");
+
+    orb_ = AddChildView(std::make_unique<Orb>());
+    text_ = AddChildView(std::make_unique<StatusText>(base::BindRepeating(
+        &StatusPill::OnTextPressed, base::Unretained(this))));
+    resume_ = AddChildView(std::make_unique<PillButton>(
+        base::BindRepeating([](base::RepeatingClosure resume) { resume.Run(); },
+                            std::move(resume)),
+        kResumeText, kResumeName));
+    stop_button_ = AddChildView(std::make_unique<PillButton>(
+        base::BindRepeating(&StatusPill::OnStopPressed, base::Unretained(this)),
+        kStopText, kStopName));
+    // Stop belongs to the tab while it has focus.
+    AddAccelerator(ui::Accelerator(ui::VKEY_OEM_PERIOD, ui::EF_COMMAND_DOWN));
+    Update(AgentTabState::kWorking, std::u16string());
+  }
+
+  void Update(AgentTabState state, const std::u16string& title) {
+    state_ = state;
+    std::u16string text;
+    switch (state) {
+      case AgentTabState::kWorking:
+        text = title.empty() ? kWorkingText : title;
+        break;
+      case AgentTabState::kWaiting:
+        text = kWaitingText;
+        break;
+      case AgentTabState::kPaused:
+        text = kPausedText;
+        break;
+    }
+    text_->SetText(text);
+    text_->SetEnabled(state == AgentTabState::kWaiting);
+    text_->SetFocusBehavior(state == AgentTabState::kWaiting
+                                ? FocusBehavior::ALWAYS
+                                : FocusBehavior::NEVER);
+    text_->SetTooltipText(state == AgentTabState::kWaiting
+                              ? std::u16string(kOpenSidebarTip)
+                              : std::u16string());
+    resume_->SetVisible(state == AgentTabState::kPaused);
+    UpdateOrb();
+    InvalidateLayout();
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    gfx::RectF body(GetLocalBounds());
+    body.Inset(kShadowMargin);
+    cc::PaintFlags shadow;
+    shadow.setAntiAlias(true);
+    shadow.setColor(colors->GetColor(ui::kColorBubbleBackground));
+    shadow.setLooper(gfx::CreateShadowDrawLooper({gfx::ShadowValue(
+        gfx::Vector2d(0, 1), 6,
+        SkColorSetA(SK_ColorBLACK, IsDark(GetWidget()) ? 0x66 : 0x33))}));
+    canvas->DrawRoundRect(body, kPillRadius, shadow);
+    cc::PaintFlags border;
+    border.setAntiAlias(true);
+    border.setStyle(cc::PaintFlags::kStroke_Style);
+    border.setStrokeWidth(1);
+    border.setColor(colors->GetColor(ui::kColorMenuBorder));
+    body.Inset(0.5f);
+    canvas->DrawRoundRect(body, kPillRadius - 0.5f, border);
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    UpdateOrb();
+  }
+
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override {
+    OnStopPressed();
+    return true;
+  }
+
+ private:
+  void UpdateOrb() {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    SkColor color;
+    if (state_ == AgentTabState::kWaiting) {
+      color = kAccent;
+    } else {
+      color =
+          SpaceColor(browser_, GetWidget())
+              .value_or(colors->GetColor(ui::kColorLabelForegroundSecondary));
+    }
+    orb_->SetColor(color);
+  }
+
+  void OnTextPressed() {
+    if (state_ == AgentTabState::kWaiting) {
+      open_sidebar_.Run();
+    }
+  }
+
+  void OnStopPressed() { stop_.Run(); }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  base::RepeatingClosure stop_;
+  base::RepeatingClosure open_sidebar_;
+  AgentTabState state_ = AgentTabState::kWorking;
+  raw_ptr<Orb> orb_ = nullptr;
+  raw_ptr<StatusText> text_ = nullptr;
+  raw_ptr<PillButton> resume_ = nullptr;
+  raw_ptr<PillButton> stop_button_ = nullptr;
+};

+class Orb : public views::View {
+  METADATA_HEADER(Orb, views::View)
+
+ public:
+  Orb() { GetViewAccessibility().SetIsIgnored(true); }
+
+  void SetColor(SkColor color) {
+    if (color != color_) {
+      color_ = color;
+      SchedulePaint();
+    }
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kOrbSize, kOrbSize);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color_);
+    canvas->DrawCircle(gfx::PointF(width() / 2.0f, height() / 2.0f),
+                       kOrbSize / 2.0f, flags);
+  }
+
+ private:
+  SkColor color_ = SK_ColorGRAY;
+};

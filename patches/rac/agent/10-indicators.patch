+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_AGENT_AGENT_TAB_INDICATOR_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_AGENT_AGENT_TAB_INDICATOR_H_
+
+#include <string>
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace rac::agent {
+
+enum class AgentTabState {
+  kWorking,
+  // A confirm card or the plan card waits in the sidebar.
+  kWaiting,
+  // The user took over the tab.
+  kPaused,
+};
+
+// Marks the tab the agent works in: a still ring along the page card's edge
+// and a pill with Stop. Nothing exists, and nothing observes the tab, until
+// Show(). All calls belong on the UI thread, and do nothing for a tab that
+// isn't in a tabbed window.
+class AgentTabIndicator {
+ public:
+  AgentTabIndicator() = delete;
+
+  // Starts marking `contents`, working, with `title` (a few words about the
+  // task) in the pill. Showing a tab that is already marked updates its title.
+  static void Show(content::WebContents* contents, std::u16string title);
+
+  static void SetState(content::WebContents* contents, AgentTabState state);
+
+  // Takes the marks down. The tab can be shown or in the background.
+  static void Hide(content::WebContents* contents);
+
+  static bool IsShowing(content::WebContents* contents);
+};
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_AGENT_AGENT_TAB_INDICATOR_H_

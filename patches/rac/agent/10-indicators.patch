+// A small flat button: a quiet fill of the text color, as in the find bar's
+// Ask button.
+class PillButton : public views::LabelButton {
+  METADATA_HEADER(PillButton, views::LabelButton)
+
+ public:
+  PillButton(PressedCallback callback,
+             std::u16string_view text,
+             std::u16string_view name)
+      : views::LabelButton(std::move(callback), std::u16string(text)) {
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(0, 10, 0, 10)));
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+    SetEnabledTextColors(ui::kColorLabelForeground);
+    SetFocusBehavior(FocusBehavior::ALWAYS);
+    SetTooltipText(std::u16string(name));
+    GetViewAccessibility().SetName(std::u16string(name));
+    views::InstallPillHighlightPathGenerator(this);
+    label()->SetSubpixelRenderingEnabled(false);
+    label()->SetFontList(label()->font_list().DeriveWithSizeDelta(
+        12 - label()->font_list().GetFontSize()));
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(
+        views::LabelButton::CalculatePreferredSize(available_size).width(),
+        kButtonHeight);
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const SkColor text = colors->GetColor(ui::kColorLabelForeground);
+    const bool dark = !color_utils::IsDark(text);
+    const int percent = dark ? (GetState() == STATE_PRESSED   ? 22
+                                : GetState() == STATE_HOVERED ? 18
+                                                              : 12)
+                             : (GetState() == STATE_PRESSED   ? 16
+                                : GetState() == STATE_HOVERED ? 12
+                                                              : 8);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(text, percent * 255 / 100));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), kButtonHeight / 2.0f,
+                          flags);
+  }
+};
+
+BEGIN_METADATA(PillButton)
+END_METADATA

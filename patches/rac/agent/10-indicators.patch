+// The marks for one tab. Created by Show(), it owns its views and observes
+// the tab and the page card the tab sits in, until Hide() or the tab goes.
+class AgentTabController
+    : public content::WebContentsUserData<AgentTabController>,
+      public content::WebContentsObserver,
+      public views::ViewObserver,
+      public ui::ImplicitAnimationObserver {
+ public:
+  ~AgentTabController() override {
+    StopObservingContainer();
+    Detach();
+  }
+
+  void SetTitle(std::u16string title) {
+    title_ = Shorten(std::move(title));
+    ApplyState();
+  }
+
+  void SetState(AgentTabState state) {
+    if (state == state_) {
+      return;
+    }
+    state_ = state;
+    ApplyState();
+    if (pill_ && pill_->GetWidget()) {
+      pill_->GetViewAccessibility().AnnounceText(
+          state == AgentTabState::kWaiting  ? kWaitingText
+          : state == AgentTabState::kPaused ? kPausedText
+                                            : kWorkingText);
+    }
+  }
+
+  // Brings the marks back after a Hide() that hasn't finished fading.
+  void Reveal() {
+    if (!hiding_) {
+      return;
+    }
+    hiding_ = false;
+    if (ring_ && pill_) {
+      Fade(ring_, 1, kFadeIn);
+      Fade(pill_, 1, kFadeIn);
+    }
+  }
+
+  void BeginHide() {
+    if (hiding_) {
+      return;
+    }
+    hiding_ = true;
+    if (!ring_ || !pill_) {
+      Finish();
+      return;
+    }
+    Fade(pill_, 0, kFadeOut);
+    Fade(ring_, 0, kFadeOut, this);
+  }
+
+  // content::WebContentsObserver:
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility == content::Visibility::VISIBLE) {
+      Reattach(/*fade=*/false);
+    } else if (visibility == content::Visibility::HIDDEN) {
+      Detach();
+    }
+  }
+  void WebContentsDestroyed() override {
+    // Takes this controller with it.
+  }
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override {
+    UpdateBounds();
+  }
+  void OnViewIsDeleting(views::View* observed_view) override {
+    // The window is closing. The views go with their parent.
+    observed_view->RemoveObserver(this);
+    container_ = nullptr;
+    contents_view_ = nullptr;
+    ring_ = nullptr;
+    pill_ = nullptr;
+    owned_ring_.reset();
+    owned_pill_.reset();
+  }
+
+  // ui::ImplicitAnimationObserver:
+  void OnImplicitAnimationsCompleted() override {
+    if (hiding_) {
+      // Leave this call before deleting what called it.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&AgentTabController::Finish,
+                                    weak_factory_.GetWeakPtr()));
+    }
+  }
+
+  void Attach() { Reattach(/*fade=*/true); }
+
+ private:
+  friend class content::WebContentsUserData<AgentTabController>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  AgentTabController(content::WebContents* contents, std::u16string title)
+      : content::WebContentsUserData<AgentTabController>(*contents),
+        content::WebContentsObserver(contents),
+        title_(Shorten(std::move(title))) {}
+
+  static void Remove(content::WebContents* contents);
+
+  tabs::TabInterface* GetTab() {
+    return web_contents()
+               ? tabs::TabInterface::MaybeGetFromContents(web_contents())
+               : nullptr;
+  }
+
+  BrowserWindowInterface* GetBrowser() {
+    tabs::TabInterface* tab = GetTab();
+    return tab ? tab->GetBrowserWindowInterface() : nullptr;
+  }
+
+  ContentsContainerView* FindContainer() {
+    BrowserWindowInterface* browser = GetBrowser();
+    BrowserView* browser_view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    MultiContentsView* multi =
+        browser_view ? browser_view->multi_contents_view() : nullptr;
+    return multi ? multi->GetContentsContainerViewFor(web_contents()) : nullptr;
+  }
+
+  void StopObservingContainer() {
+    if (container_) {
+      container_->RemoveObserver(this);
+    }
+    if (contents_view_) {
+      contents_view_->RemoveObserver(this);
+    }
+    container_ = nullptr;
+    contents_view_ = nullptr;
+  }
+
+  // Takes the views out of the page card, and keeps them for the next time
+  // the tab shows.
+  void Detach() {
+    StopObservingContainer();
+    if (ring_ && ring_->parent()) {
+      owned_ring_ = ring_->parent()->RemoveChildViewT(ring_.get());
+    }
+    if (pill_ && pill_->parent()) {
+      owned_pill_ = pill_->parent()->RemoveChildViewT(pill_.get());
+    }
+  }
+
+  void CreateViews() {
+    BrowserWindowInterface* browser = GetBrowser();
+    if (!browser) {
+      return;
+    }
+    content::WebContents* contents = web_contents();
+    Profile* profile =
+        Profile::FromBrowserContext(contents->GetBrowserContext());
+    base::WeakPtr<AgentTabController> weak = weak_factory_.GetWeakPtr();
+    auto ring = std::make_unique<RingView>(browser);
+    auto pill = std::make_unique<StatusPill>(
+        browser,
+        base::BindRepeating(
+            [](Profile* profile) {
+              VLOG(1) << "rac agent: indicator stop";
+              if (AgentUiDelegate* delegate = GetAgentUiDelegate(profile)) {
+                delegate->Stop();
+              }
+            },
+            profile),
+        base::BindRepeating(
+            [](Profile* profile) {
+              VLOG(1) << "rac agent: indicator resume";
+              if (AgentUiDelegate* delegate = GetAgentUiDelegate(profile)) {
+                delegate->Resume();
+              }
+            },
+            profile),
+        base::BindRepeating(
+            [](base::WeakPtr<AgentTabController> controller) {
+              if (controller) {
+                controller->OpenSidebar();
+              }
+            },
+            weak));
+    ring_ = ring.get();
+    pill_ = pill.get();
+    owned_ring_ = std::move(ring);
+    owned_pill_ = std::move(pill);
+  }
+
+  void OpenSidebar() {
+    BrowserWindowInterface* browser = GetBrowser();
+    SidePanelUI* ui = browser ? SidePanelUI::From(browser) : nullptr;
+    if (ui) {
+      ui->Show(SidePanelEntryKey(SidePanelEntryId::kRacAi),
+               SidePanelOpenTrigger::kToolbarButton);
+    }
+  }
+
+  void Reattach(bool fade) {
+    if (hiding_) {
+      return;
+    }
+    // The tab may not be in its page card yet when it is shown.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AgentTabController::DoAttach,
+                                  weak_factory_.GetWeakPtr(), fade));
+  }
+
+  void DoAttach(bool fade) {
+    if (hiding_ || !web_contents() ||
+        web_contents()->GetVisibility() != content::Visibility::VISIBLE) {
+      return;
+    }
+    ContentsContainerView* container = FindContainer();
+    if (!container || container == container_) {
+      return;
+    }
+    Detach();
+    if (!ring_ || !pill_) {
+      CreateViews();
+    }
+    if (!owned_ring_ || !owned_pill_) {
+      return;
+    }
+    container_ = container;
+    contents_view_ = container->contents_view();
+    container_->AddObserver(this);
+    contents_view_->AddObserver(this);
+    // The page card keeps its capture border last in z-order.
+    size_t index = container->children().size();
+    if (views::View* border = static_cast<views::View*>(
+            container->capture_contents_border_view())) {
+      index = container->GetIndexOf(border).value_or(index);
+    }
+    ring_->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    pill_->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    container->AddChildViewAt(std::move(owned_ring_), index);
+    container->AddChildViewAt(std::move(owned_pill_), index + 1);
+    ApplyState();
+    UpdateBounds();
+    if (fade && !shown_once_) {
+      Fade(ring_, 1, kFadeIn);
+      Fade(pill_, 1, kFadeIn);
+    } else {
+      ring_->layer()->SetOpacity(1);
+      pill_->layer()->SetOpacity(1);
+    }
+    shown_once_ = true;
+  }
+
+  void ApplyState() {
+    if (pill_) {
+      static_cast<StatusPill*>(pill_.get())->Update(state_, title_);
+    }
+    UpdateBounds();
+  }
+
+  void UpdateBounds() {
+    if (!container_ || !ring_ || !pill_) {
+      return;
+    }
+    const gfx::Rect page = container_->GetContentsViewBounds();
+    ring_->SetBoundsRect(page);
+    if (contents_view_) {
+      static_cast<RingView*>(ring_.get())
+          ->SetCorners(contents_view_->GetBackgroundRadii());
+    }
+    gfx::Size size = pill_->GetPreferredSize();
+    size.set_width(std::min(size.width(), std::max(0, page.width() - 24)));
+    const int x = page.x() + (page.width() - size.width()) / 2;
+    const int y = page.bottom() - kPillBottomGap - kPillHeight - kShadowMargin;
+    pill_->SetBoundsRect(gfx::Rect(gfx::Point(x, y), size));
+  }
+
+  void Finish();
+
+  std::u16string title_;
+  AgentTabState state_ = AgentTabState::kWorking;
+  bool hiding_ = false;
+  bool shown_once_ = false;
+  raw_ptr<ContentsContainerView> container_ = nullptr;
+  raw_ptr<ContentsWebView> contents_view_ = nullptr;
+  raw_ptr<views::View> ring_ = nullptr;
+  raw_ptr<views::View> pill_ = nullptr;
+  std::unique_ptr<views::View> owned_ring_;
+  std::unique_ptr<views::View> owned_pill_;
+  base::WeakPtrFactory<AgentTabController> weak_factory_{this};
+
+ public:
+  static AgentTabController* Get(content::WebContents* contents) {
+    return contents ? FromWebContents(contents) : nullptr;
+  }
+  static AgentTabController* Create(content::WebContents* contents,
+                                    std::u16string title) {
+    CreateForWebContents(contents, std::move(title));
+    return FromWebContents(contents);
+  }
+  static void Destroy(content::WebContents* contents) {
+    contents->RemoveUserData(UserDataKey());
+  }
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AgentTabController);
+
+void AgentTabController::Finish() {
+  if (web_contents()) {
+    Destroy(web_contents());
+  }
+}
+
+// static
+void AgentTabIndicator::Show(content::WebContents* contents,
+                             std::u16string title) {
+  if (!contents) {
+    return;
+  }
+  if (AgentTabController* existing = AgentTabController::Get(contents)) {
+    existing->Reveal();
+    existing->SetTitle(std::move(title));
+    return;
+  }
+  if (!tabs::TabInterface::MaybeGetFromContents(contents)) {
+    return;
+  }
+  AgentTabController::Create(contents, std::move(title))->Attach();
+}
+
+// static
+void AgentTabIndicator::SetState(content::WebContents* contents,
+                                 AgentTabState state) {
+  if (AgentTabController* controller = AgentTabController::Get(contents)) {
+    controller->SetState(state);
+  }
+}
+
+// static
+void AgentTabIndicator::Hide(content::WebContents* contents) {
+  if (AgentTabController* controller = AgentTabController::Get(contents)) {
+    controller->BeginHide();
+  }
+}
+
+// static
+bool AgentTabIndicator::IsShowing(content::WebContents* contents) {
+  return AgentTabController::Get(contents) != nullptr;
+}
+
+}  // namespace rac::agent

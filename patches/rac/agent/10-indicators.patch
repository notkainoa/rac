+std::u16string Shorten(std::u16string title) {
+  if (title.size() > static_cast<size_t>(kMaxTitleChars)) {
+    title.resize(kMaxTitleChars - 1);
+    title.push_back(u'\u2026');
+  }
+  return title;
+}

   std::optional<base::DictValue> event =
       base::JSONReader::ReadDict(args[0].GetString(), base::JSON_PARSE_RFC);
-  if (event) {
-    FireWebUIListener("racAiAgentEvent", *event);
+  if (!event) {
+    return;
+  }
+  if (const std::string* type = event->FindString("type");
+      type && *type == "debug_indicator") {
+    ApplyDebugIndicator(*event);
+    return;
+  }
+  FireWebUIListener("racAiAgentEvent", *event);
+}
+
+void PageHandler::ApplyDebugIndicator(const base::DictValue& event) {
+  BrowserWindowInterface* browser = GetBrowser();
+  tabs::TabInterface* tab =
+      browser ? browser->GetActiveTabInterface() : nullptr;
+  const std::string* state = event.FindString("state");
+  if (!tab || !state) {
+    return;
   }
+  content::WebContents* contents = tab->GetContents();
+  if (*state == "hidden") {
+    agent::AgentTabIndicator::Hide(contents);
+    return;
+  }
+  const std::string* title = event.FindString("title");
+  agent::AgentTabIndicator::Show(
+      contents, title ? base::UTF8ToUTF16(*title) : std::u16string());
+  agent::AgentTabIndicator::SetState(
+      contents, *state == "waiting"  ? agent::AgentTabState::kWaiting
+                : *state == "paused" ? agent::AgentTabState::kPaused
+                                     : agent::AgentTabState::kWorking);
 }
 

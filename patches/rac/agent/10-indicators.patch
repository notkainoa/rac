+SkColor ParseHex(std::string_view hex) {
+  uint32_t rgb = 0;
+  if (hex.size() != 7 || !base::HexStringToUInt(hex.substr(1), &rgb)) {
+    return SK_ColorTRANSPARENT;
+  }
+  return SkColorSetA(rgb, SK_AlphaOPAQUE);
+}
+
+bool IsDark(const views::Widget* widget) {
+  return widget &&
+         widget->GetColorMode() == ui::ColorProviderKey::ColorMode::kDark;
+}
+
+// The color of the window's space. None in the neutral space and in windows
+// without spaces.
+std::optional<SkColor> SpaceColor(BrowserWindowInterface* browser,
+                                  const views::Widget* widget) {
+  SpacesWindowManager* manager =
+      browser ? SpacesWindowManager::From(browser) : nullptr;
+  const auto active =
+      manager ? manager->GetActiveSpaceId(browser) : std::nullopt;
+  const Space* space = active ? manager->spaces()->FindSpace(*active) : nullptr;
+  if (!space || !widget) {
+    return std::nullopt;
+  }
+  const SpaceTheme neutral = SpaceTheme::Preset(0);
+  if (space->theme.color1 == neutral.color1 &&
+      space->theme.color2 == neutral.color2) {
+    return std::nullopt;
+  }
+  const SkColor themed = ParseHex(space->theme.GetStops(IsDark(widget)).first);
+  if (themed == SK_ColorTRANSPARENT) {
+    return std::nullopt;
+  }
+  return themed;
+}
+
+void Fade(views::View* view,
+          float opacity,
+          base::TimeDelta duration,
+          ui::ImplicitAnimationObserver* observer = nullptr) {
+  ui::Layer* layer = view->layer();
+  if (gfx::Animation::PrefersReducedMotion()) {
+    layer->SetOpacity(opacity);
+    if (observer) {
+      observer->OnImplicitAnimationsCompleted();
+    }
+    return;
+  }
+  ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+  settings.SetTransitionDuration(duration);
+  settings.SetTweenType(gfx::Tween::EASE_OUT);
+  if (observer) {
+    settings.AddObserver(observer);
+  }
+  layer->SetOpacity(opacity);
+}

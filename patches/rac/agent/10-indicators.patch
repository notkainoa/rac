+// A still ring just inside the page card's edge, and a soft glow inside it.
+// It paints once into its layer; fading it only changes the layer's opacity.
+class RingView : public views::View {
+  METADATA_HEADER(RingView, views::View)
+
+ public:
+  explicit RingView(BrowserWindowInterface* browser) : browser_(browser) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetOpacity(0);
+    SetCanProcessEventsWithinSubtree(false);
+    GetViewAccessibility().SetIsIgnored(true);
+  }
+
+  void SetCorners(const gfx::RoundedCornersF& corners) {
+    if (corners == corners_) {
+      return;
+    }
+    corners_ = corners;
+    SchedulePaint();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors || width() <= 2 * kRingWidth || height() <= 2 * kRingWidth) {
+      return;
+    }
+    const bool dark = IsDark(GetWidget());
+    const std::optional<SkColor> themed = SpaceColor(browser_, GetWidget());
+    SkColor ring;
+    SkColor glow;
+    if (themed) {
+      ring = SkColorSetA(*themed, dark ? 0xA6 : 0x8C);
+      glow = SkColorSetA(*themed, 0x40);
+    } else {
+      ring = dark ? SkColorSetARGB(0x66, 0xFF, 0xFF, 0xFF)
+                  : SkColorSetARGB(0x59, 0x00, 0x00, 0x00);
+      glow = SkColorSetA(colors->GetColor(ui::kColorLabelForeground), 0x30);
+    }
+
+    const SkVector radii[4] = {
+        {corners_.upper_left(), corners_.upper_left()},
+        {corners_.upper_right(), corners_.upper_right()},
+        {corners_.lower_right(), corners_.lower_right()},
+        {corners_.lower_left(), corners_.lower_left()},
+    };
+    SkRRect outer;
+    outer.setRectRadii(SkRect::MakeWH(width(), height()), radii);
+
+    canvas->Save();
+    canvas->sk_canvas()->clipRRect(outer, true);
+    // A soft glow: strokes that fade toward the middle of the page.
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    constexpr int kGlowStep = 1;
+    for (int offset = 0; offset < kGlowWidth; offset += kGlowStep) {
+      const float fade = 1.0f - static_cast<float>(offset) / kGlowWidth;
+      SkRRect band;
+      outer.inset(kRingWidth + offset + kGlowStep / 2.0f,
+                  kRingWidth + offset + kGlowStep / 2.0f, &band);
+      flags.setStrokeWidth(kGlowStep);
+      flags.setColor(SkColorSetA(
+          glow, static_cast<U8CPU>(SkColorGetA(glow) * fade * fade)));
+      canvas->sk_canvas()->drawRRect(band, flags);
+    }
+
+    SkRRect inner;
+    outer.inset(kRingWidth / 2.0f, kRingWidth / 2.0f, &inner);
+    flags.setStrokeWidth(kRingWidth);
+    flags.setColor(ring);
+    canvas->sk_canvas()->drawRRect(inner, flags);
+    canvas->Restore();
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    SchedulePaint();
+  }
+
+ private:
+  raw_ptr<BrowserWindowInterface> browser_;
+  gfx::RoundedCornersF corners_;
+};

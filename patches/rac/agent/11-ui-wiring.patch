+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_AGENT_AGENT_EVENTS_H_
+#define CHROME_BROWSER_RAC_AGENT_AGENT_EVENTS_H_
+
+#include <optional>
+#include <string>
+
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/rac/agent/action_guard.h"
+
+namespace rac::agent {
+
+// The events the assistant sidebar shows, as dictionaries. The sidebar reads
+// them in one place, chrome/browser/resources/rac_ai/agent_events.ts
+// (parseAgentEvent). A field changes there and here together, or not at all.
+// None of them carries a value the agent typed.
+
+// "example.com" or "127.0.0.1:8772" for a URL or origin, or "" if it has no
+// host.
+std::string DisplayHost(const std::string& url_or_origin);
+
+base::DictValue StepEvent(bool finished,
+                          const std::string& id,
+                          const std::string& tool,
+                          const std::string& label,
+                          const std::string& tab_id,
+                          const std::string& tab_title,
+                          const std::string& origin,
+                          bool ok,
+                          const std::string& error);
+
+base::DictValue PlanRequestEvent(const std::string& id,
+                                 const std::string& goal,
+                                 const std::string& step,
+                                 const base::ListValue& origins,
+                                 const std::string& tab_id);
+
+struct ConfirmEventInput {
+  std::string id;
+  std::string label;
+  std::string risk;
+  std::string reason;
+  std::string origin;
+  std::string detail;
+  std::string tab_id;
+  // Set when the critic held the step back. May be empty.
+  std::optional<std::string> critic_note;
+  // No fast model is set up, so every step is confirmed.
+  bool no_fast_model = false;
+};
+base::DictValue ConfirmRequestEvent(const ConfirmEventInput& input);
+
+base::DictValue PausedEvent(const std::string& reason,
+                            const std::string& tab_id);
+base::DictValue ResumedEvent();
+base::DictValue RunStateEvent(const std::string& state,
+                              const std::string& tab_id);
+base::DictValue SummaryEvent(const std::string& text,
+                             int steps,
+                             int confirmed,
+                             base::TimeDelta duration);
+
+// Why a step needs the user's OK, as the sidebar's confirm card understands
+// it: sensitive_field, purchase, delete, send, upload, download, cross_origin,
+// submit, critic or other. `held_by_critic` marks a step the guard would have
+// let through.
+std::string ConfirmationRisk(const ActionMetadata& action, bool held_by_critic);
+
+// What will happen if the user confirms, in one or two sentences. Never
+// includes the text to type.
+std::string ConfirmationDetail(const ActionMetadata& action);
+
+// What a card's button sends back.
+enum class Decision { kAllow, kDeny, kStop, kUnknown };
+Decision ParseDecision(const std::string& decision);
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_AGENT_EVENTS_H_

@@ -0,0 +1,231 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/agent_events.h"
+
+#include <set>
+#include <utility>
+
+#include "base/strings/string_util.h"
+#include "chrome/browser/rac/agent/snapshot_serializer.h"
+#include "url/gurl.h"
+
+namespace rac::agent {
+namespace {
+
+bool HasWord(const std::string& text, const std::set<std::string>& words) {
+  const std::string lower = base::ToLowerASCII(text);
+  size_t start = 0;
+  while (start < lower.size()) {
+    while (start < lower.size() && !base::IsAsciiAlpha(lower[start])) {
+      ++start;
+    }
+    size_t end = start;
+    while (end < lower.size() && base::IsAsciiAlpha(lower[end])) {
+      ++end;
+    }
+    if (end > start && words.contains(lower.substr(start, end - start))) {
+      return true;
+    }
+    start = end;
+  }
+  return false;
+}
+
+std::string Quoted(const std::string& name) {
+  const std::string escaped = EscapeSnapshotText(name, 100);
+  return escaped.empty() ? "" : "“" + escaped + "”";
+}
+
+}  // namespace
+
+std::string DisplayHost(const std::string& url_or_origin) {
+  const GURL url(url_or_origin);
+  if (!url.is_valid() || url.host().empty()) {
+    return "";
+  }
+  std::string host(url.host());
+  if (!url.port().empty()) {
+    host += ":";
+    host += url.port();
+  }
+  return host;
+}
+
+base::DictValue StepEvent(bool finished,
+                          const std::string& id,
+                          const std::string& tool,
+                          const std::string& label,
+                          const std::string& tab_id,
+                          const std::string& tab_title,
+                          const std::string& origin,
+                          bool ok,
+                          const std::string& error) {
+  base::DictValue event;
+  event.Set("type", finished ? "step_finished" : "step_started");
+  event.Set("id", id);
+  event.Set("tool", tool);
+  event.Set("label", label);
+  event.Set("tabId", tab_id);
+  event.Set("tabTitle", tab_title);
+  event.Set("origin", origin);
+  if (finished) {
+    event.Set("ok", ok);
+    if (!error.empty()) {
+      event.Set("error", error);
+    }
+  }
+  return event;
+}
+
+base::DictValue PlanRequestEvent(const std::string& id,
+                                 const std::string& goal,
+                                 const std::string& step,
+                                 const base::ListValue& origins,
+                                 const std::string& tab_id) {
+  return base::DictValue()
+      .Set("type", "plan_request")
+      .Set("id", id)
+      .Set("goal", goal)
+      .Set("steps", base::ListValue().Append(step))
+      .Set("origins", origins.Clone())
+      .Set("tabId", tab_id);
+}
+
+base::DictValue ConfirmRequestEvent(const ConfirmEventInput& input) {
+  base::DictValue event;
+  event.Set("type", "confirm_request");
+  event.Set("id", input.id);
+  event.Set("label", input.label);
+  event.Set("risk", input.risk);
+  event.Set("reason", input.reason);
+  event.Set("origin", input.origin);
+  event.Set("detail", input.detail);
+  event.Set("tabId", input.tab_id);
+  if (input.critic_note) {
+    event.Set("critic", base::DictValue().Set("note", *input.critic_note));
+  }
+  event.Set("noFastModel", input.no_fast_model);
+  return event;
+}
+
+base::DictValue PausedEvent(const std::string& reason,
+                            const std::string& tab_id) {
+  return base::DictValue()
+      .Set("type", "paused")
+      .Set("reason", reason)
+      .Set("tabId", tab_id);
+}
+
+base::DictValue ResumedEvent() {
+  return base::DictValue().Set("type", "resumed");
+}
+
+base::DictValue RunStateEvent(const std::string& state,
+                              const std::string& tab_id) {
+  return base::DictValue()
+      .Set("type", "run_state")
+      .Set("state", state)
+      .Set("tabId", tab_id);
+}
+
+base::DictValue SummaryEvent(const std::string& text,
+                             int steps,
+                             int confirmed,
+                             base::TimeDelta duration) {
+  return base::DictValue()
+      .Set("type", "summary")
+      .Set("text", text)
+      .Set("steps", steps)
+      .Set("confirmed", confirmed)
+      .Set("durationMs", static_cast<double>(duration.InMilliseconds()));
+}
+
+std::string ConfirmationRisk(const ActionMetadata& action,
+                             bool held_by_critic) {
+  const ActionRiskInput& risk = action.risk;
+  if (risk.is_password_field || risk.is_payment_field) {
+    return "sensitive_field";
+  }
+  const std::string words = risk.element_name + " " + risk.button_text;
+  if (HasWord(words, {"buy", "purchase", "order", "pay", "checkout",
+                      "subscribe", "donate"})) {
+    return "purchase";
+  }
+  if (HasWord(words, {"delete", "remove", "erase", "unsubscribe"})) {
+    return "delete";
+  }
+  if (HasWord(words, {"send", "post", "publish", "reply", "share"})) {
+    return "send";
+  }
+  if (risk.is_file_input || HasWord(words, {"upload", "attach"})) {
+    return "upload";
+  }
+  if (action.download || HasWord(words, {"download"})) {
+    return "download";
+  }
+  if (risk.cross_origin || (!action.frame_origin.empty() &&
+                            action.frame_origin != risk.current_origin)) {
+    return "cross_origin";
+  }
+  if (action.submit || action.press_enter) {
+    return "submit";
+  }
+  return held_by_critic ? "critic" : "other";
+}
+
+std::string ConfirmationDetail(const ActionMetadata& action) {
+  const ActionRiskInput& risk = action.risk;
+  const std::string& tool = risk.tool_name;
+  const std::string name = Quoted(risk.element_name);
+  const bool sensitive = risk.is_password_field || risk.is_payment_field;
+  std::string detail;
+  if (tool == "click") {
+    detail = name.empty() ? "Clicks an element on the page."
+                          : "Clicks " + name + ".";
+  } else if (tool == "type") {
+    detail = sensitive ? "Enters text in a password or payment field."
+                       : (name.empty() ? "Enters text in a field."
+                                       : "Enters text in " + name + ".");
+    detail += " The text isn't shown here.";
+  } else if (tool == "select_option") {
+    detail = name.empty() ? "Chooses an option."
+                          : "Chooses an option in " + name + ".";
+  } else if (tool == "navigate" || tool == "open_tab") {
+    const std::string host = DisplayHost(risk.target_origin);
+    detail = "Opens " + (host.empty() ? "a page" : host) +
+             (tool == "open_tab" ? " in a new tab." : ".");
+  } else if (tool == "press_key") {
+    detail = name.empty() ? "Presses Enter." : "Presses Enter in " + name + ".";
+  } else if (tool == "go_back") {
+    detail = "Goes back to the previous page.";
+  } else if (tool == "close_tab") {
+    detail = "Closes a tab.";
+  } else if (tool == "switch_tab") {
+    detail = "Switches to another tab.";
+  }
+  const bool navigates = tool == "navigate" || tool == "open_tab";
+  const std::string target = DisplayHost(risk.target_origin);
+  if (!navigates && (action.submit || action.press_enter) && !target.empty()) {
+    detail += " It sends the form to " + target + ".";
+  } else if (!navigates && risk.cross_origin && !target.empty()) {
+    detail += " It goes to " + target + ".";
+  }
+  return detail;
+}
+
+Decision ParseDecision(const std::string& decision) {
+  if (decision == "allow" || decision == "allow_once" ||
+      decision == "confirm") {
+    return Decision::kAllow;
+  }
+  if (decision == "deny" || decision == "skip") {
+    return Decision::kDeny;
+  }
+  if (decision == "stop") {
+    return Decision::kStop;
+  }
+  return Decision::kUnknown;
+}
+
+}  // namespace rac::agent

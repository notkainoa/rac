+void AgentController::UpdateIndicator(AgentTabStatus status) {
+  content::WebContents* tab = TargetTab();
+  if (!tab) {
+    tab = indicator_tab_.get();
+  }
+  if (!tab) {
+    return;
+  }
+  if (indicator_tab_ && indicator_tab_.get() != tab) {
+    NotifyAgentTab(profile_, indicator_tab_.get(), AgentTabStatus::kHidden,
+                   std::u16string());
+  }
+  indicator_tab_ = tab->GetWeakPtr();
+  NotifyAgentTab(profile_, tab, status,
+                 done_ ? base::UTF8ToUTF16(Label()) : std::u16string());

--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/rac/agent/agent_events_unittest.cc	2026-10-23 19:05:21.175079494 -0700
@@ -0,0 +1,181 @@
+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/agent/agent_events.h"
+
+#include <set>
+#include <string>
+
+#include "base/json/json_writer.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::agent {
+namespace {
+
+// The fields agent_events.ts reads, per event type.
+std::set<std::string> ReadByUi(const std::string& type) {
+  if (type == "step_started") {
+    return {"id", "tool", "label", "tabTitle", "origin"};
+  }
+  if (type == "step_finished") {
+    return {"id", "tool", "label", "tabTitle", "origin", "ok"};
+  }
+  if (type == "plan_request") {
+    return {"id", "goal", "steps", "origins"};
+  }
+  if (type == "confirm_request") {
+    return {"id", "label", "risk", "reason", "origin", "detail", "noFastModel"};
+  }
+  if (type == "paused") {
+    return {"reason"};
+  }
+  if (type == "run_state") {
+    return {"state"};
+  }
+  if (type == "summary") {
+    return {"text", "steps", "confirmed", "durationMs"};
+  }
+  return {};
+}
+
+void ExpectReadable(const base::DictValue& event) {
+  const std::string* type = event.FindString("type");
+  ASSERT_TRUE(type);
+  for (const std::string& field : ReadByUi(*type)) {
+    EXPECT_TRUE(event.contains(field)) << *type << " lacks " << field;
+  }
+}
+
+ActionMetadata Click(const std::string& name) {
+  ActionMetadata action;
+  action.risk.tool_name = "click";
+  action.risk.element_name = name;
+  action.risk.current_origin = "http://127.0.0.1:8771";
+  return action;
+}
+
+TEST(AgentEventsTest, ConfirmRequestHasWhatTheCardReads) {
+  ConfirmEventInput input;
+  input.id = "approval-3";
+  input.label = "Open paypal.com";
+  input.risk = "cross_origin";
+  input.reason = "This step may leave the allowed sites.";
+  input.origin = "https://paypal.com";
+  input.detail = "Opens paypal.com.";
+  input.no_fast_model = true;
+  const base::DictValue event = ConfirmRequestEvent(input);
+  ExpectReadable(event);
+  EXPECT_EQ(*event.FindString("label"), "Open paypal.com");
+  EXPECT_EQ(*event.FindString("risk"), "cross_origin");
+  EXPECT_EQ(event.FindBool("noFastModel"), true);
+  EXPECT_EQ(event.FindDict("critic"), nullptr);
+  EXPECT_EQ(event.Find("action"), nullptr);
+}
+
+TEST(AgentEventsTest, CriticNoteIsNestedAndMayBeEmpty) {
+  ConfirmEventInput input;
+  input.id = "approval-4";
+  input.critic_note = "";
+  const base::DictValue event = ConfirmRequestEvent(input);
+  const base::DictValue* critic = event.FindDict("critic");
+  ASSERT_TRUE(critic);
+  EXPECT_EQ(*critic->FindString("note"), "");
+  EXPECT_EQ(critic->Find("noDirectProvider"), nullptr);
+  EXPECT_EQ(event.FindBool("noFastModel"), false);
+}
+
+TEST(AgentEventsTest, SummaryReportsDurationInMilliseconds) {
+  const base::DictValue event =
+      SummaryEvent("Done", 5, 1, base::Milliseconds(61500));
+  ExpectReadable(event);
+  EXPECT_EQ(event.FindDouble("durationMs"), 61500.0);
+  EXPECT_EQ(event.FindInt("steps"), 5);
+  EXPECT_EQ(event.FindInt("confirmed"), 1);
+  EXPECT_EQ(event.Find("elapsedMs"), nullptr);
+}
+
+TEST(AgentEventsTest, OtherEventsHaveWhatThePageReads) {
+  ExpectReadable(StepEvent(false, "step-1", "click", "Click “Go”", "t1", "Shop",
+                           "http://127.0.0.1:8771", true, ""));
+  const base::DictValue finished =
+      StepEvent(true, "step-1", "click", "Click “Go”", "t1", "Shop",
+                "http://127.0.0.1:8771", false, "Stopped.");
+  ExpectReadable(finished);
+  EXPECT_EQ(finished.FindBool("ok"), false);
+  EXPECT_EQ(*finished.FindString("error"), "Stopped.");
+  base::ListValue origins;
+  origins.Append("http://127.0.0.1:8771");
+  const base::DictValue plan = PlanRequestEvent(
+      "approval-1", "Fill in the form", "Click “Go”", origins, "t1");
+  ExpectReadable(plan);
+  EXPECT_EQ(plan.FindList("steps")->size(), 1u);
+  ExpectReadable(PausedEvent("you're using this tab", "t1"));
+  ExpectReadable(RunStateEvent("waiting", "t1"));
+  EXPECT_EQ(*ResumedEvent().FindString("type"), "resumed");
+}
+
+TEST(AgentEventsTest, NoEventCarriesTypedText) {
+  ActionMetadata action = Click("Password");
+  action.risk.tool_name = "type";
+  action.risk.is_password_field = true;
+  const std::string detail = ConfirmationDetail(action);
+  EXPECT_NE(detail.find("password or payment field"), std::string::npos);
+  EXPECT_NE(detail.find("isn't shown"), std::string::npos);
+  EXPECT_EQ(ConfirmationRisk(action, false), "sensitive_field");
+}
+
+TEST(AgentEventsTest, RiskKindFollowsTheStep) {
+  ActionMetadata purchase = Click("Place order");
+  purchase.submit = true;
+  EXPECT_EQ(ConfirmationRisk(purchase, false), "purchase");
+
+  ActionMetadata card = Click("Card number");
+  card.risk.tool_name = "type";
+  card.risk.is_payment_field = true;
+  EXPECT_EQ(ConfirmationRisk(card, false), "sensitive_field");
+
+  ActionMetadata open;
+  open.risk.tool_name = "navigate";
+  open.risk.current_origin = "http://127.0.0.1:8771";
+  open.risk.target_origin = "http://127.0.0.1:8772";
+  open.risk.cross_origin = true;
+  EXPECT_EQ(ConfirmationRisk(open, false), "cross_origin");
+  EXPECT_EQ(ConfirmationDetail(open), "Opens 127.0.0.1:8772.");
+
+  ActionMetadata sign_in = Click("Sign in");
+  sign_in.submit = true;
+  EXPECT_EQ(ConfirmationRisk(sign_in, false), "submit");
+
+  ActionMetadata upload = Click("Resume");
+  upload.risk.is_file_input = true;
+  EXPECT_EQ(ConfirmationRisk(upload, false), "upload");
+
+  EXPECT_EQ(ConfirmationRisk(Click("Remove item"), false), "delete");
+  EXPECT_EQ(ConfirmationRisk(Click("Send message"), false), "send");
+  EXPECT_EQ(ConfirmationRisk(Click("Next"), true), "critic");
+  EXPECT_EQ(ConfirmationRisk(Click("Next"), false), "other");
+}
+
+TEST(AgentEventsTest, SubmitDetailNamesWhereTheFormGoes) {
+  ActionMetadata action = Click("Sign in");
+  action.submit = true;
+  action.risk.target_origin = "http://127.0.0.1:8772";
+  action.risk.cross_origin = true;
+  EXPECT_EQ(ConfirmationDetail(action),
+            "Clicks “Sign in”. It sends the form to 127.0.0.1:8772.");
+}
+
+TEST(AgentEventsTest, DecisionsFromTheCardsAndTheModelPath) {
+  EXPECT_EQ(ParseDecision("allow"), Decision::kAllow);
+  EXPECT_EQ(ParseDecision("confirm"), Decision::kAllow);
+  EXPECT_EQ(ParseDecision("allow_once"), Decision::kAllow);
+  EXPECT_EQ(ParseDecision("skip"), Decision::kDeny);
+  EXPECT_EQ(ParseDecision("deny"), Decision::kDeny);
+  EXPECT_EQ(ParseDecision("stop"), Decision::kStop);
+  EXPECT_EQ(ParseDecision("ALLOW"), Decision::kUnknown);
+  EXPECT_EQ(ParseDecision(""), Decision::kUnknown);
+}
+
+}  // namespace
+}  // namespace rac::agent

+#ifndef CHROME_BROWSER_RAC_AGENT_AGENT_UI_DELEGATE_H_
+#define CHROME_BROWSER_RAC_AGENT_AGENT_UI_DELEGATE_H_
+
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "base/values.h"
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+namespace rac::agent {
+
+// What the sidebar's plan card, confirm cards and Stop and Resume buttons do.
+// The agent controller implements it. The sidebar never acts on its own.
+class AgentUiDelegate {
+ public:
+  virtual ~AgentUiDelegate() = default;
+
+  // The user answered the card `id`. `decision` is "allow" (the plan card),
+  // "confirm" or "skip" (a confirm card), or "stop" (either card).
+  virtual void Respond(const std::string& id, const std::string& decision) = 0;
+
+  // Ends the task. Safe to call when none is running.
+  virtual void Stop() = 0;
+
+  // Lets a paused task go on.
+  virtual void Resume() = 0;
+};
+
+// The delegate for `context`, or null. The caller keeps ownership and clears
+// it (passing null) before it goes away.
+void SetAgentUiDelegate(content::BrowserContext* context,
+                        AgentUiDelegate* delegate);
+AgentUiDelegate* GetAgentUiDelegate(content::BrowserContext* context);
+
+// Shows `event` in every assistant page of `context` that has a reply
+// running. The dictionary is what the page's single parser reads: a `type`
+// of step_started, step_finished, plan_request, confirm_request, paused,
+// resumed, run_state or summary, and that type's fields. Does nothing when
+// no page is listening.
+void DispatchAgentEvent(content::BrowserContext* context,
+                        base::DictValue event);
+
+using AgentEventCallback =
+    base::RepeatingCallback<void(const base::DictValue&)>;
+
+// For the assistant page: runs `callback` for each DispatchAgentEvent().
+base::CallbackListSubscription AddAgentEventCallback(
+    content::BrowserContext* context,
+    AgentEventCallback callback);
+
+}  // namespace rac::agent
+
+#endif  // CHROME_BROWSER_RAC_AGENT_AGENT_UI_DELEGATE_H_

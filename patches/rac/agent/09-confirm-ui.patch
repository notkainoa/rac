+
+import {makeIcon} from './markdown.js';
+
+// Anything that remembers which rows the user opened. Rows draw again as
+// events arrive, so the page keeps their state here.
+export interface Expander {
+  expanded: Set<string>;
+}
+
+export function makeChevron(): SVGSVGElement {
+  const chevron = makeIcon('M6.5 8.25L10 11.75l3.5-3.5');
+  chevron.classList.add('chevron');
+  return chevron;
+}
+
+// A row that opens and closes its body in place, so the chevron can turn
+// without the thread redrawing.
+export function makeFold(
+    owner: Expander, key: string, label: Node[],
+    fill: (body: HTMLElement) => void, hasBody = true): HTMLElement {
+  const wrap = document.createElement('div');
+  wrap.className = 'step';
+  const open = hasBody && owner.expanded.has(key);
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.className = 'step-row';
+  // A step with nothing to show stays a plain line.
+  button.disabled = !hasBody;
+  button.dataset['stepKey'] = key;
+  button.id = `row-${key}`;
+  button.setAttribute('aria-expanded', String(open));
+  button.setAttribute('aria-controls', `body-${key}`);
+  const text = document.createElement('span');
+  text.className = 'step-label';
+  text.append(...label);
+  button.append(makeChevron(), text);
+  const body = document.createElement('div');
+  body.className = 'step-body';
+  body.id = `body-${key}`;
+  body.setAttribute('role', 'group');
+  body.setAttribute('aria-labelledby', button.id);
+  body.hidden = !open;
+  fill(body);
+  button.addEventListener('click', () => {
+    const now = button.getAttribute('aria-expanded') !== 'true';
+    button.setAttribute('aria-expanded', String(now));
+    body.hidden = !now;
+    if (now) {
+      owner.expanded.add(key);
+    } else {
+      owner.expanded.delete(key);
+    }
+  });
+  wrap.append(button, body);
+  return wrap;
+}

+void PageHandler::OnAgentTaskEvent(const base::DictValue& event) {
+  // Only the reply that owns the turn shows the agent's work.
+  if (!IsJavascriptAllowed() || agent_turn_send_id_ == 0 ||
+      agent_turn_send_id_ != active_send_id_) {
+    return;
+  }
+  const std::string* type = event.FindString("type");
+  const std::string* state = event.FindString("state");
+  if (type && *type == "run_state" && state && *state == "stopped") {
+    // The task was stopped from the card, the pill or the keyboard. End the
+    // model's side of it as well.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<PageHandler> handler, int send_id) {
+                         if (handler && handler->active_send_id_ == send_id) {
+                           handler->StopSession();
+                         }
+                       },
+                       weak_factory_.GetWeakPtr(), agent_turn_send_id_));
+  }
+  FireWebUIListener("racAiAgentEvent", event);

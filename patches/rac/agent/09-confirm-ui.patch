+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// The plan card, the confirm cards, the step log and the end-of-task line
+// for an agent that works in the user's tabs.
+
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+
+import {isActive, pastLabel, presentLabel, stepCount} from './agent_events.js';
+import type {AgentTask, ConfirmCard, Decision, LogRow, PlanCard, TaskStep} from './agent_events.js';
+import {makeChevron, makeFold} from './fold.js';
+import {makeIcon} from './markdown.js';
+
+export interface CardContext {
+  respond: (id: string, decision: Decision) => void;
+  resume: () => void;
+  stop: () => void;
+  openSettings: () => void;
+  // Draws the thread again after the page changed a card.
+  redraw: () => void;
+  // Whether a plan card may take focus when it appears.
+  mayTakeFocus: () => boolean;
+  announce: (text: string, assertive: boolean) => void;
+}
+
+// Steps past this many fold into one row.
+const MAX_OPEN_ROWS = 3;
+const MAX_SITE_CHIPS = 6;
+const MAX_TAB_TITLE = 32;
+const INFO_ICON = 'M10 3.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM10 9v4.5' +
+    'M10 6.5v.01';
+
+function str(key: string, ...args: string[]): string {
+  return args.length > 0 ? loadTimeData.getStringF(key, ...args) :
+                           loadTimeData.getString(key);
+}
+
+function make<K extends keyof HTMLElementTagNameMap>(
+    tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
+  const element = document.createElement(tag);
+  if (className) {
+    element.className = className;
+  }
+  if (text) {
+    element.textContent = text;
+  }
+  return element;
+}
+
+function makeButton(
+    label: string, onClick: () => void, primary = false): HTMLButtonElement {
+  const button =
+      make('button', primary ? 'pill-action primary' : 'pill-action');
+  button.type = 'button';
+  button.textContent = label;
+  button.addEventListener('click', onClick);
+  return button;
+}
+
+// New cards slide in once. They keep their element afterwards, so drawing the
+// thread again doesn't replay it.
+function enter(card: HTMLElement) {
+  card.classList.add('entering');
+  card.addEventListener(
+      'animationend', () => card.classList.remove('entering'), {once: true});
+  setTimeout(() => card.classList.remove('entering'), 400);
+}
+
+function makeFavicon(host: string): HTMLImageElement {
+  const image = make('img');
+  image.alt = '';
+  image.src = `chrome://favicon2/?size=16&pageUrl=${
+      encodeURIComponent(`https://${host}`)}`;
+  image.addEventListener('error', () => image.remove());
+  return image;
+}
+
+function makeSiteChip(host: string): HTMLElement {
+  const chip = make('span', 'site-chip');
+  chip.append(makeFavicon(host), host);
+  return chip;
+}
+
+function allowedText(plan: PlanCard): string {
+  if (plan.status === 'stopped') {
+    return str('stopped');
+  }
+  const [first, ...rest] = plan.hosts;
+  if (!first) {
+    return str('allowedAnywhere');
+  }
+  return rest.length === 0 ? str('allowedOn', first) :
+                             str('allowedOnMore', first, String(rest.length));
+}
+
+function buildPlanCard(
+    task: AgentTask, plan: PlanCard, ctx: CardContext): HTMLElement {
+  const base = `plan-${task.uid}`;
+  const card = make('div', 'agent-card plan-card');
+  card.setAttribute('role', 'group');
+  card.tabIndex = -1;
+  card.dataset['planId'] = plan.id;
+
+  const line = make('button', 'step-row agent-line');
+  line.type = 'button';
+  line.setAttribute('aria-controls', `${base}-body`);
+  const label = make('span', 'step-label');
+  line.append(makeChevron(), label);
+  line.addEventListener('click', () => {
+    plan.open = !plan.open;
+    ctx.redraw();
+  });
+
+  const collapse = make('div', 'agent-collapse');
+  collapse.id = `${base}-body`;
+  const inner = make('div', 'agent-collapse-inner');
+  const title = make('h3', 'agent-title', str('planTitle'));
+  title.id = `${base}-title`;
+  const list = make('ul', 'agent-steps');
+  list.id = `${base}-steps`;
+  for (const step of plan.steps) {
+    list.appendChild(make('li', '', step));
+  }
+  card.setAttribute('aria-labelledby', title.id);
+  card.setAttribute('aria-describedby', list.id);
+  inner.append(title, list);
+  if (plan.hosts.length > 0) {
+    inner.appendChild(make('div', 'agent-label', str('planSites')));
+    const chips = make('div', 'site-chips');
+    for (const host of plan.hosts.slice(0, MAX_SITE_CHIPS)) {
+      chips.appendChild(makeSiteChip(host));
+    }
+    if (plan.hosts.length > MAX_SITE_CHIPS) {
+      chips.appendChild(make(
+          'span', 'site-more',
+          str('moreSites', String(plan.hosts.length - MAX_SITE_CHIPS))));
+    }
+    inner.appendChild(chips);
+  }
+  const actions = make('div', 'error-actions agent-actions');
+  const allow =
+      makeButton(str('planAllow'), () => ctx.respond(plan.id, 'allow'), true);
+  allow.title = str('planAllowTip');
+  allow.setAttribute('aria-keyshortcuts', 'Meta+Enter');
+  actions.append(
+      allow, makeButton(str('stop'), () => ctx.respond(plan.id, 'stop')));
+  inner.append(actions, make('div', 'agent-note', str('planNote')));
+  collapse.appendChild(inner);
+  card.append(line, collapse);
+
+  enter(card);
+  ctx.announce(str('announcePlan'), false);
+  if (ctx.mayTakeFocus()) {
+    requestAnimationFrame(() => card.focus({preventScroll: true}));
+  }
+  return card;
+}
+
+function updatePlanCard(card: HTMLElement, plan: PlanCard) {
+  const pending = plan.status === 'pending';
+  const open = pending || plan.open;
+  card.dataset['state'] = open ? 'open' : 'collapsed';
+  card.dataset['status'] = plan.status;
+  const line = card.querySelector<HTMLButtonElement>('.agent-line')!;
+  line.hidden = pending;
+  line.setAttribute('aria-expanded', String(open));
+  line.querySelector('.step-label')!.textContent = allowedText(plan);
+  card.querySelector<HTMLElement>('.agent-collapse')!.inert = !open;
+  card.querySelector<HTMLElement>('.agent-actions')!.hidden = !pending;
+  card.querySelector<HTMLElement>('.agent-note')!.hidden = !pending;
+}
+
+function whyText(note: string): string {
+  const trimmed = note.trim().replace(/[.\s]+$/, '');
+  return trimmed ? str('pausedBecause', trimmed) : str('pausedFallback');
+}
+
+function buildConfirmCard(
+    task: AgentTask, confirm: ConfirmCard, ctx: CardContext): HTMLElement {
+  const base = `confirm-${task.uid}-${confirm.id}`;
+  const card = make('div', 'agent-card confirm-card attn');
+  card.setAttribute('role', 'group');
+  card.tabIndex = -1;
+  card.dataset['confirmId'] = confirm.id;
+  const title = make('h3', 'agent-title', confirm.title);
+  title.id = `${base}-title`;
+  card.setAttribute('aria-labelledby', title.id);
+  card.appendChild(title);
+  if (confirm.critic !== null) {
+    const why = make('div', 'agent-why');
+    why.append(makeIcon(INFO_ICON), make('span', '', whyText(confirm.critic)));
+    card.appendChild(why);
+  }
+  if (confirm.detail) {
+    const detail = make('div', 'agent-detail', confirm.detail);
+    detail.id = `${base}-detail`;
+    card.setAttribute('aria-describedby', detail.id);
+    card.appendChild(detail);
+  }
+  if (confirm.noFastModel) {
+    const note = make('div', 'agent-detail agent-every', str('everyStepNote'));
+    const link = make('button', 'link-button', str('setOneUp'));
+    link.type = 'button';
+    link.addEventListener('click', ctx.openSettings);
+    note.append(' ', link);
+    card.appendChild(note);
+  }
+  const actions = make('div', 'error-actions agent-actions');
+  actions.append(
+      makeButton(
+          str('confirm'), () => ctx.respond(confirm.id, 'confirm'), true),
+      makeButton(str('skip'), () => ctx.respond(confirm.id, 'skip')),
+      makeButton(str('stop'), () => ctx.respond(confirm.id, 'stop')));
+  card.appendChild(actions);
+
+  enter(card);
+  ctx.announce(str('announceConfirm', confirm.title), true);
+  // The card takes focus, but Confirm never does: nothing here is a default.
+  requestAnimationFrame(() => card.focus({preventScroll: true}));
+  return card;
+}
+
+function tabTitle(step: TaskStep): string {
+  const title = step.tabTitle;
+  return title.length > MAX_TAB_TITLE ?
+      `${title.slice(0, MAX_TAB_TITLE - 1)}\u2026` :
+      title;
+}
+
+// What the status line says while the task runs. Null when there's nothing
+// special to say.
+export function taskActivity(task: AgentTask): string|null {
+  if (task.state === 'waiting' || task.plan?.status === 'pending' ||
+      task.confirm) {
+    return str('waitingForYou');
+  }
+  if (task.state === 'paused') {
+    return str('pausedActivity');
+  }
+  if (task.state !== 'working') {
+    return null;
+  }
+  const running = [...task.log].reverse().find(
+      row => row.kind === 'step' && row.step.status === 'running');
+  if (!running || running.kind !== 'step') {
+    return null;
+  }
+  const step = running.step;
+  if (step.host && /navigate|open|goto|visit/i.test(step.tool)) {
+    return str('opening', step.host);
+  }
+  if (step.tabTitle) {
+    return str('workingIn', tabTitle(step));
+  }
+  return step.label ? `${presentLabel(step.label)}\u2026` : str('workingDots');
+}
+
+function stepLabel(step: TaskStep): Node[] {
+  const nodes: Node[] = [];
+  if (step.status === 'running') {
+    nodes.push(document.createTextNode(`${presentLabel(step.label)}\u2026`));
+    return nodes;
+  }
+  const label = pastLabel(step.label) || str('toolFallback');
+  const parts = [label];
+  if (step.host && !label.includes(step.host)) {
+    parts.push(step.host);
+  }
+  nodes.push(document.createTextNode(parts.join(' \u00b7 ')));
+  if (step.status === 'failed') {
+    nodes.push(make('span', 'step-failed', str('stepFailed')));
+  }
+  if (step.confirmed) {
+    nodes.push(make('span', 'step-faint', str('confirmedSuffix')));
+  }
+  return nodes;
+}
+
+function makeLogRow(task: AgentTask, row: LogRow): HTMLElement {
+  if (row.kind === 'decision') {
+    const key = `d-${task.uid}-${row.decision.id}`;
+    const text = str(
+        row.decision.verdict === 'confirmed' ? 'confirmedLine' : 'skippedLine',
+        row.decision.label);
+    return makeFold(
+        task, key, [document.createTextNode(text)], () => {}, false);
+  }
+  const step = row.step;
+  const details: Array<[string, string]> = [];
+  if (step.tabTitle) {
+    details.push([str('stepTab'), step.tabTitle]);
+  }
+  if (step.host) {
+    details.push([str('stepSite'), step.host]);
+  }
+  if (step.error) {
+    details.push([str('stepError'), step.error]);
+  }
+  return makeFold(task, `s-${task.uid}-${step.id}`, stepLabel(step), body => {
+    for (const [key, value] of details) {
+      const line = make('div', 'step-detail');
+      line.append(
+          make('span', 'step-key', `${key}: `),
+          make('span', 'step-value', value));
+      body.appendChild(line);
+    }
+  }, details.length > 0);
+}
+
+function makeLog(task: AgentTask): HTMLElement|null {
+  // A confirmed step carries its own "confirmed" mark, so its card's line
+  // would only repeat it.
+  const confirmedSteps = new Set(task.log.flatMap(
+      row => row.kind === 'step' && row.step.confirmed ? [row.step.id] : []));
+  const rows = task.log.filter(
+      row =>
+          !(row.kind === 'decision' && row.decision.verdict === 'confirmed' &&
+            confirmedSteps.has(row.decision.id)));
+  if (rows.length === 0) {
+    return null;
+  }
+  const list = make('div', 'steps');
+  if (rows.length <= MAX_OPEN_ROWS) {
+    for (const row of rows) {
+      list.appendChild(makeLogRow(task, row));
+    }
+    return list;
+  }
+  const count = Math.max(stepCount(task), 1);
+  list.appendChild(makeFold(
+      task, `log-${task.uid}`,
+      [document.createTextNode(
+          count === 1 ? str('oneStep') : str('nSteps', String(count)))],
+      body => {
+        for (const row of rows) {
+          body.appendChild(makeLogRow(task, row));
+        }
+      }));
+  return list;
+}
+
+function makePausedActions(ctx: CardContext): HTMLElement {
+  const actions = make('div', 'error-actions agent-paused');
+  actions.append(
+      makeButton(str('resume'), ctx.resume, true),
+      makeButton(str('stop'), ctx.stop));
+  return actions;
+}
+
+// The blocks an agent task adds to its reply, in order: the plan, the log of
+// steps, then whatever is waiting for the user.
+export function renderTaskBlocks(
+    task: AgentTask, ctx: CardContext): HTMLElement[] {
+  const blocks: HTMLElement[] = [];
+  const live = new Set<string>();
+  if (task.plan) {
+    const key = `plan:${task.plan.id}`;
+    live.add(key);
+    let card = task.elements.get(key);
+    if (!card) {
+      card = buildPlanCard(task, task.plan, ctx);
+      task.elements.set(key, card);
+    }
+    updatePlanCard(card, task.plan);
+    blocks.push(card);
+  }
+  const log = makeLog(task);
+  if (log) {
+    blocks.push(log);
+  }
+  if (task.confirm) {
+    const key = `confirm:${task.confirm.id}`;
+    live.add(key);
+    let card = task.elements.get(key);
+    if (!card) {
+      card = buildConfirmCard(task, task.confirm, ctx);
+      task.elements.set(key, card);
+    }
+    blocks.push(card);
+  }
+  if (task.state === 'paused') {
+    blocks.push(makePausedActions(ctx));
+  }
+  for (const key of [...task.elements.keys()]) {
+    if (!live.has(key)) {
+      task.elements.delete(key);
+    }
+  }
+  return blocks;
+}
+
+function formatDuration(ms: number): string {
+  const seconds = Math.max(1, Math.round(ms / 1000));
+  return seconds < 60 ?
+      str('durationSeconds', String(seconds)) :
+      str('durationMinutes', String(Math.round(seconds / 60)));
+}
+
+// "Done in 1 min · 12 steps · 2 confirmed", or "Stopped after 5 steps".
+// Empty while the task runs.
+export function taskFooter(task: AgentTask): string {
+  if (isActive(task)) {
+    return '';
+  }
+  const steps = task.summary?.steps || stepCount(task);
+  const confirmed = task.summary?.confirmed || task.confirmedCount;
+  if (task.state !== 'done') {
+    return steps === 0 ? str('stopped') :
+        steps === 1    ? str('stoppedAfterOne') :
+                         str('stoppedAfter', String(steps));
+  }
+  const parts = [str(
+      'doneIn',
+      formatDuration(task.summary?.durationMs || task.endMs - task.startMs))];
+  if (steps > 0) {
+    parts.push(steps === 1 ? str('oneStep') : str('nSteps', String(steps)));
+  }
+  if (confirmed > 0) {
+    parts.push(str('nConfirmed', String(confirmed)));
+  }
+  return parts.join(' \u00b7 ');
+}

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// What the browser's agent says to the page, and what the page keeps of it.
+// Every field name the browser sends is read in parseAgentEvent() and
+// nowhere else.
+
+export type TaskState = 'working'|'paused'|'waiting'|'done'|'stopped'|'error';
+
+export type Decision = 'allow'|'stop'|'confirm'|'skip';
+
+export type AgentEvent = {
+  type: 'step_started'|'step_finished',
+  id: string,
+  tool: string,
+  label: string,
+  tabTitle: string,
+  origin: string,
+  ok: boolean,
+  error: string,
+}|{
+  type: 'plan_request',
+  id: string,
+  goal: string,
+  steps: string[],
+  origins: string[],
+}|{
+  type: 'confirm_request',
+  id: string,
+  label: string,
+  risk: string,
+  reason: string,
+  origin: string,
+  detail: string,
+  // Set when the critic held the step back. The note may be empty.
+  critic: string | null,
+  noFastModel: boolean,
+}|{
+  type: 'paused',
+  reason: string,
+}|{
+  type: 'resumed',
+}|{
+  type: 'run_state',
+  state: TaskState,
+}|{
+  type: 'summary',
+  text: string,
+  steps: number,
+  confirmed: number,
+  durationMs: number,
+};
+
+const STATES: TaskState[] =
+    ['working', 'paused', 'waiting', 'done', 'stopped', 'error'];
+
+function text(value: unknown, max = 400): string {
+  return typeof value === 'string' ? value.slice(0, max) : '';
+}
+
+function count(value: unknown): number {
+  return typeof value === 'number' && Number.isFinite(value) ?
+      Math.max(0, Math.round(value)) :
+      0;
+}
+
+function strings(value: unknown, limit: number): string[] {
+  return Array.isArray(value) ?
+      value.map(item => text(item)).filter(Boolean).slice(0, limit) :
+      [];
+}
+
+// Returns null for anything that isn't a well-formed event.
+export function parseAgentEvent(raw: unknown): AgentEvent|null {
+  if (!raw || typeof raw !== 'object') {
+    return null;
+  }
+  const event = raw as Record<string, unknown>;
+  const id = text(event['id'], 120);
+  switch (event['type']) {
+    case 'step_started':
+    case 'step_finished':
+      return id ? {
+        type: event['type'],
+        id,
+        tool: text(event['tool'], 80),
+        label: text(event['label']),
+        tabTitle: text(event['tabTitle']),
+        origin: text(event['origin']),
+        ok: event['ok'] !== false,
+        error: text(event['error']),
+      } :
+                  null;

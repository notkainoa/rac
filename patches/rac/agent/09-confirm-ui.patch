+
+#include "chrome/browser/rac/agent/agent_ui_delegate.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/memory/raw_ptr.h"
+#include "base/supports_user_data.h"
+#include "content/public/browser/browser_context.h"
+
+namespace rac::agent {
+namespace {
+
+const char kUserDataKey[] = "rac.agent.ui_delegate";
+
+class Hub : public base::SupportsUserData::Data {
+ public:
+  static Hub* Get(content::BrowserContext* context, bool create) {
+    auto* hub = static_cast<Hub*>(context->GetUserData(kUserDataKey));
+    if (!hub && create) {
+      auto owned = std::make_unique<Hub>();
+      hub = owned.get();
+      context->SetUserData(kUserDataKey, std::move(owned));
+    }
+    return hub;
+  }
+
+  raw_ptr<AgentUiDelegate> delegate;
+  base::RepeatingCallbackList<void(const base::DictValue&)> callbacks;
+};
+
+}  // namespace
+
+void SetAgentUiDelegate(content::BrowserContext* context,
+                        AgentUiDelegate* delegate) {
+  if (Hub* hub = Hub::Get(context, /*create=*/delegate != nullptr)) {
+    hub->delegate = delegate;
+  }
+}
+
+AgentUiDelegate* GetAgentUiDelegate(content::BrowserContext* context) {
+  Hub* hub = Hub::Get(context, /*create=*/false);
+  return hub ? hub->delegate.get() : nullptr;
+}
+
+void DispatchAgentEvent(content::BrowserContext* context,
+                        base::DictValue event) {
+  if (Hub* hub = Hub::Get(context, /*create=*/false)) {
+    hub->callbacks.Notify(event);
+  }
+}
+
+base::CallbackListSubscription AddAgentEventCallback(
+    content::BrowserContext* context,
+    AgentEventCallback callback) {
+  return Hub::Get(context, /*create=*/true)->callbacks.Add(std::move(callback));
+}
+
+}  // namespace rac::agent

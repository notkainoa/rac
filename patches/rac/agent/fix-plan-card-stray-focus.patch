Index: src/chrome/browser/resources/rac_ai/agent_cards.ts
===================================================================
--- src.orig/chrome/browser/resources/rac_ai/agent_cards.ts
+++ src/chrome/browser/resources/rac_ai/agent_cards.ts
@@ -152,7 +152,13 @@ function buildPlanCard(
   enter(card);
   ctx.announce(str('announcePlan'), false);
   if (ctx.mayTakeFocus()) {
-    requestAnimationFrame(() => card.focus({preventScroll: true}));
+    // The frame can come after the user already answered, and a collapsed
+    // card must not take focus then.
+    requestAnimationFrame(() => {
+      if (plan.status === 'pending') {
+        card.focus({preventScroll: true});
+      }
+    });
   }
   return card;
 }
@@ -217,7 +223,11 @@ function buildConfirmCard(
   enter(card);
   ctx.announce(str('announceConfirm', confirm.title), true);
   // The card takes focus, but Confirm never does: nothing here is a default.
-  requestAnimationFrame(() => card.focus({preventScroll: true}));
+  requestAnimationFrame(() => {
+    if (card.isConnected && task.confirm?.id === confirm.id) {
+      card.focus({preventScroll: true});
+    }
+  });
   return card;
 }
 

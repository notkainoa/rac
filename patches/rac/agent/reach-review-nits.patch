+// Like the agent's own tools, the debug commands only read or attach a tab in
+// the agent's reach (IsTabInAgentReach()): a committed web page. Otherwise
+// this answers `done` and returns false.
+bool InReachOrRefuse(content::WebContents* tab, AgentDebugDone& done) {
+  if (!tab) {
+    std::move(done).Run(
+        base::DictValue().Set("ok", false).Set("error", "No active tab."));
+    return false;
+  }
+  if (!IsTabInAgentReach(tab)) {
+    std::move(done).Run(
+        base::DictValue()
+            .Set("ok", false)
+            .Set("error_code", "denied")
+            .Set("error",
+                 "The active tab isn't a web page, so the agent can't use "
+                 "it."));
+    return false;
+  }
+  return true;
+}

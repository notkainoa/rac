+// The values a card shows are kept per document, bounded, and never
+// dropped silently.
+TEST(AgentEventsTest, EnteredValuesNeverDropSilently) {
+  EnteredValues entered;
+  const EnteredValues::Document form{"t1", "doc-1"};
+  entered.Record(form, 1, {"Email", "a@example.com"});
+  entered.Record(form, 1, {"Email", "b@example.com"});
+  // The user's own words in a password field are stored as empty.
+  entered.Record(form, 2, {"Password", "hunter2", true, true});
+  EnteredValues::Shown shown = entered.Lookup(form);
+  ASSERT_EQ(shown.values.size(), 2u);
+  EXPECT_EQ(shown.values[0].value, "b@example.com");
+  EXPECT_EQ(shown.values[1].value, "");
+  EXPECT_TRUE(shown.values[1].hidden);
+  EXPECT_EQ(entered.Lookup(form, 1).values.size(), 1u);
+  // The 65th field is counted, not lost.
+  for (int32_t node = 3; node <= 70; ++node) {
+    entered.Record(form, node, {"F", "v"});
+  }
+  shown = entered.Lookup(form);
+  EXPECT_EQ(shown.values.size(), EnteredValues::kMaxFields);
+  EXPECT_EQ(shown.untracked, 70 - static_cast<int>(EnteredValues::kMaxFields));
+  EXPECT_FALSE(shown.forgotten);
+  // The 33rd document evicts the oldest only, which stays marked.
+  for (int i = 2; i <= 33; ++i) {
+    entered.Record({"t1", "doc-" + base::NumberToString(i)}, 1, {"F", "v"});
+  }
+  shown = entered.Lookup(form);
+  EXPECT_TRUE(shown.values.empty());
+  EXPECT_TRUE(shown.forgotten);
+  EXPECT_EQ(entered.Lookup({"t1", "doc-2"}).values.size(), 1u);
+  EXPECT_FALSE(entered.Lookup({"t1", "doc-2"}).forgotten);
+  EXPECT_FALSE(entered.Lookup({"t1", "never-typed"}).forgotten);
+  // Entering again in it doesn't bring back what was lost.
+  entered.Record(form, 1, {"Email", "c@example.com"});
+  shown = entered.Lookup(form);
+  EXPECT_EQ(shown.values.size(), 1u);
+  EXPECT_TRUE(shown.forgotten);
+  // A step with no known target sees the whole tab.
+  EXPECT_GE(entered.LookupTab("t1").values.size(), 32u);
+  EXPECT_TRUE(entered.LookupTab("t1").forgotten);
+  EXPECT_TRUE(entered.LookupTab("t2").values.empty());
+}

+// Every level crossed with every kind of step, for each shape of read set.
+// The destination is b.example throughout; the user named it, and careful's
+// plan allows it.
+TEST(ActionGuardDataFlowTest, DataFlowTable) {
+  constexpr char kB[] = "https://b.example";
+  constexpr char kUserUrl[] = "https://b.example/start";
+  constexpr char kPageUrl[] = "https://b.example/link";
+  enum Step {
+    kRead,
+    kScroll,
+    kWait,
+    kSwitch,
+    kNavigateTyped,
+    kNavigateLink,
+    kClickLink,
+    kClickCheckbox,
+    kSelect,
+    kTypeOwn,
+    kTypeModel,
+    kSubmit,
+  };
+  auto make = [&](Step step) {
+    ActionMetadata a = LinkClick(kB);
+    switch (step) {
+      case kRead:
+        a.risk.tool_name = "snapshot";
+        break;
+      case kScroll:
+        a.risk.tool_name = "scroll";
+        break;
+      case kWait:
+        a.risk.tool_name = "wait_for_settle";
+        break;
+      case kSwitch:
+        a.risk.tool_name = "switch_tab";
+        break;
+      case kNavigateTyped:
+      case kNavigateLink:
+        a.risk.tool_name = "navigate";
+        a.url = step == kNavigateTyped ? kUserUrl : kPageUrl;
+        a.risk.target_origin = kB;
+        a.frame_origin.clear();
+        break;
+      case kClickLink:
+        break;
+      case kClickCheckbox:
+        a.risk.element_role = "checkbox";
+        a.risk.element_name = "Newsletter";
+        break;
+      case kSelect:
+        a.risk.tool_name = "select_option";
+        a.risk.element_role = "combobox";
+        a.risk.element_name = "Size";
+        a.unknown_field = true;
+        break;
+      case kTypeOwn:
+      case kTypeModel:
+        a.risk.tool_name = "type";
+        a.risk.element_role = "textbox";
+        a.risk.element_name = "Note";
+        a.unknown_field = true;
+        a.unknown_text = step == kTypeModel;
+        break;
+      case kSubmit:
+        a.risk.element_role = "button";
+        a.risk.element_name = "Next";
+        a.submit = true;
+        break;
+    }
+    return a;
+  };
+  // A: allow, C: confirm. Columns: nothing read or only b read; another
+  // site read; another site read and b granted.
+  struct Row {
+    Step step;
+    const char* ask;
+    const char* careful;
+    const char* automatic;
+  } rows[] = {
+      {kRead, "AAA", "AAA", "AAA"},
+      {kScroll, "AAA", "AAA", "AAA"},
+      {kWait, "AAA", "AAA", "AAA"},
+      {kSwitch, "AAA", "AAA", "AAA"},
+      {kNavigateTyped, "CCC", "CCC", "AAA"},
+      {kNavigateLink, "CCC", "CCC", "ACA"},
+      {kClickLink, "CCC", "ACA", "ACA"},
+      {kClickCheckbox, "CCC", "ACA", "ACA"},
+      {kSelect, "CCC", "CCC", "ACA"},
+      {kTypeOwn, "CCC", "CCC", "AAA"},
+      {kTypeModel, "CCC", "CCC", "ACA"},
+      {kSubmit, "CCC", "CCC", "CCC"},
+  };
+  enum ReadSet { kNothing, kOnlyB, kOther, kBoth, kOtherGranted, kBothGranted };
+  for (const Row& row : rows) {
+    for (PermissionLevel level :
+         {PermissionLevel::kAsk, PermissionLevel::kCareful,
+          PermissionLevel::kAuto}) {
+      const char* expected = level == PermissionLevel::kAsk ? row.ask
+                             : level == PermissionLevel::kCareful
+                                 ? row.careful
+                                 : row.automatic;
+      for (ReadSet reads :
+           {kNothing, kOnlyB, kOther, kBoth, kOtherGranted, kBothGranted}) {
+        ActionGuard guard;
+        guard.BeginTurn(level, {std::string("start at ") + kUserUrl}, {},
+                        "table");
+        guard.RememberPageLink(kPageUrl);
+        guard.AllowPlan({kB});
+        if (reads == kOnlyB || reads == kBoth || reads == kBothGranted) {
+          guard.RecordRead({kB});
+        }
+        if (reads >= kOther) {
+          guard.RecordRead({"https://a.example"});
+        }
+        if (reads == kOtherGranted || reads == kBothGranted) {
+          guard.GrantFlow(kB, {"https://a.example"});
+        }
+        const int column = reads <= kOnlyB ? 0 : reads <= kBoth ? 1 : 2;
+        const GuardResult result = guard.Evaluate(make(row.step));
+        const GuardDecision want = expected[column] == 'A'
+                                       ? GuardDecision::kAllow
+                                       : GuardDecision::kConfirm;
+        const std::string where =
+            base::NumberToString(row.step) + " level " +
+            base::NumberToString(static_cast<int>(level)) + " reads " +
+            base::NumberToString(reads);
+        EXPECT_EQ(result.decision, want) << where;
+        const bool carries = row.step == kNavigateLink ||
+                             row.step == kClickLink ||
+                             row.step == kClickCheckbox ||
+                             row.step == kSelect || row.step == kTypeModel;
+        if (column == 1 && carries && level != PermissionLevel::kAsk) {
+          EXPECT_TRUE(result.offer_flow_grant) << where;
+          EXPECT_EQ(result.flow_from,
+                    std::vector<std::string>{"https://a.example"})
+              << where;
+        }
+        if (row.step == kSubmit) {
+          EXPECT_FALSE(result.offer_flow_grant) << "risky: " << where;
+        }
+      }
+    }
+  }
+}

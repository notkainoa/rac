+std::string ContentFrameOrigin(const proto::FrameData& frame,
+                               const std::string& parent) {
+  if (frame.has_security_origin() && !frame.security_origin().opaque()) {
+    const GURL origin(frame.security_origin().value());
+    if (origin.is_valid() && origin.SchemeIsHTTPOrHTTPS()) {
+      return url::Origin::Create(origin).Serialize();
+    }
+  }
+  if (frame.has_url()) {
+    const GURL url(frame.url());
+    if (url.is_valid() && url.SchemeIsHTTPOrHTTPS()) {
+      return url::Origin::Create(url).Serialize();
+    }
+  }
+  return parent;
+}
+
+std::set<std::string> PageContentOrigins(
+    const proto::AnnotatedPageContent& page) {
+  std::set<std::string> origins;
+  const std::string main = page.has_main_frame_data()
+                               ? ContentFrameOrigin(page.main_frame_data(), "")
+                               : std::string();
+  // The title and URL alone are page content.
+  if (!main.empty()) {
+    origins.insert(main);
+  }
+  if (!page.has_root_node()) {
+    return origins;
+  }
+  // No depth limit, unlike the serializers: a reader that walks deeper than
+  // this one would show an origin it missed. A stack can't overflow.
+  std::vector<std::pair<const proto::ContentNode*, std::string>> stack;
+  stack.emplace_back(&page.root_node(), main);
+  while (!stack.empty()) {
+    auto [node, origin] = std::move(stack.back());
+    stack.pop_back();
+    const auto& a = node->content_attributes();
+    if (a.has_iframe_data()) {
+      if (a.iframe_data().has_frame_data()) {
+        const proto::FrameData& frame = a.iframe_data().frame_data();
+        origin = ContentFrameOrigin(frame, origin);
+        // A frame's selection is read even when the frame shows no nodes.
+        if (!origin.empty() && !frame.frame_interaction_info()
+                                    .selection()
+                                    .selected_text()
+                                    .empty()) {
+          origins.insert(origin);
+        }
+      }
+    } else if (!origin.empty() &&
+               (a.has_text_data() || a.has_image_data() ||
+                a.has_anchor_data() || a.has_form_control_data() ||
+                a.has_svg_root_data() || !a.label().empty())) {
+      origins.insert(origin);
+    }
+    for (const auto& child : node->children_nodes()) {
+      stack.emplace_back(&child, origin);
+    }
+  }
+  return origins;
+}

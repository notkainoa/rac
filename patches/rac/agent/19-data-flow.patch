+// Cards show every value in full, however long, with its length. Only the
+// user's own words in a password field are hidden, and they never travel.
+TEST(AgentEventsTest, ValuesAreShownInFullAndOnlyTheUsersOwnSecretIsHidden) {
+  ConfirmEventInput input;
+  input.id = "approval-3";
+  const std::string long_value = std::string(16 * 1024 - 3, 'x') + "end";
+  input.values = {{"Email", "me@example.com", false, false},
+                  {"Password", "", true, true},
+                  {"Card number", "4111 1111 1111 1111", false, true},
+                  {"Note", "line\none \"quoted\"", false, false},
+                  {"Message", long_value, false, false}};
+  input.values_kind = ValuesKind::kSend;
+  const base::DictValue event = ConfirmRequestEvent(input);
+  const base::ListValue* values = event.FindList("values");
+  ASSERT_TRUE(values);
+  ASSERT_EQ(values->size(), 5u);
+  EXPECT_EQ(*event.FindString("valuesKind"), "send");
+  EXPECT_EQ(*(*values)[0].GetDict().FindString("value"), "me@example.com");
+  EXPECT_EQ((*values)[0].GetDict().FindInt("chars"), 14);
+  EXPECT_EQ(*(*values)[1].GetDict().FindString("field"), "Password");
+  EXPECT_EQ(*(*values)[1].GetDict().FindString("value"), "");
+  EXPECT_EQ((*values)[1].GetDict().FindBool("hidden"), true);
+  // Text the model chose shows even in a payment field, which the card
+  // says.
+  EXPECT_EQ(*(*values)[2].GetDict().FindString("value"), "4111 1111 1111 1111");
+  EXPECT_EQ((*values)[2].GetDict().FindBool("sensitive"), true);
+  EXPECT_EQ((*values)[2].GetDict().FindBool("hidden"), false);
+  // Newlines and quotes stay as typed.
+  EXPECT_EQ(*(*values)[3].GetDict().FindString("value"),
+            "line\none \"quoted\"");
+  // 16 KB, not cut.
+  EXPECT_EQ(*(*values)[4].GetDict().FindString("value"), long_value);
+  EXPECT_EQ((*values)[4].GetDict().FindInt("chars"),

+void EnteredValues::Record(const Document& document,
+                           int32_t node,
+                           ShownValue value) {
+  if (value.hidden) {
+    // The user's own words in a password field: the card only names it.
+    value.value.clear();
+  }
+  auto found = documents_.find(document);
+  if (found == documents_.end()) {
+    if (documents_.size() >= kMaxDocuments) {
+      // The document the agent entered something in longest ago.
+      const auto oldest = std::ranges::min_element(
+          documents_, {},
+          [](const auto& entry) { return entry.second.last_used; });
+      if (forgotten_.size() >= kMaxForgotten) {
+        forgotten_.clear();
+        lost_track_ = true;
+      }
+      forgotten_.insert(oldest->first);
+      documents_.erase(oldest);
+    }
+    found = documents_.emplace(document, Values()).first;
+    // Entering more doesn't bring back what was evicted.
+    found->second.forgotten = forgotten_.erase(document) > 0 || lost_track_;
+  }
+  Values& values = found->second;
+  values.last_used = ++clock_;
+  if (values.fields.size() < kMaxFields || values.fields.contains(node)) {
+    values.fields[node] = std::move(value);
+  } else {
+    values.untracked.insert(node);
+  }

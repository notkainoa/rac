+bool ActionGuard::StaysOnNamedSites(const ActionMetadata& action) const {
+  return std::ranges::all_of(
+      Destinations(action), [&](const std::string& destination) {
+        return destination == action.risk.current_origin ||
+               IsNamed(destination);
+      });
+}
+
+bool ActionGuard::Carries(const ActionMetadata& action) const {
+  const std::string& tool = action.risk.tool_name;
+  if (tool == "navigate" || tool == "open_tab") {
+    // A page link (one of many the model could pick, or one with a query
+    // string a page offered) carries a choice. A URL the user typed doesn't.
+    return !user_urls_.contains(GURL(action.url).spec());
+  }
+  if (tool == "type") {
+    // The user's own words are free where the user is: the tab and the
+    // sites the user named. Into a frame from somewhere else (an ad, a
+    // widget, an opaque frame a script built) they carry like anything
+    // else.
+    return action.unknown_text || !StaysOnNamedSites(action);
+  }
+  // Which link, which option, which checkbox, which button: every choice
+  // is a symbol a page can read.
+  return tool == "click" || tool == "select_option" || tool == "press_key" ||
+         tool == "go_back";
+}
+
+std::set<std::string> ActionGuard::Destinations(
+    const ActionMetadata& action) const {
+  std::set<std::string> to;
+  const std::string& tool = action.risk.tool_name;
+  if (tool != "navigate" && tool != "open_tab") {
+    // The page and the frame see the input; script there can send it on.
+    to.insert(action.risk.current_origin);
+    to.insert(action.frame_origin);
+  }
+  // The server gets the request, and the URL in it.
+  to.insert(action.risk.target_origin);
+  to.erase(std::string());
+  return to;
+}
+
+std::set<std::string> ActionGuard::UngrantedSources(
+    const std::string& destination) const {
+  const DataFlow& data = flow();
+  std::set<std::string> sources = data.read;
+  if (data.earlier_unknown) {
+    sources.insert(kEarlierInConversation);
+  }
+  if (data.files_attached) {
+    sources.insert(kAttachedFiles);
+  }
+  // A page can't learn from a step what it showed the model itself.
+  sources.erase(destination);
+  if (const auto granted = data.grants.find(destination);
+      granted != data.grants.end()) {
+    for (const std::string& source : granted->second) {
+      sources.erase(source);
+    }
+  }
+  return sources;
+}

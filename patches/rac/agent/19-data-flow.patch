+void AgentController::CardValues(const ActionMetadata& meta,
+                                 ConfirmEventInput& input) const {
+  const RefEntry* entry =
+      current_->refs.Lookup(String(pending_.arguments, "ref"));
+  const bool enters =
+      pending_.name == "type" || pending_.name == "select_option";
+  if (enters && entry) {
+    input.values.push_back(EnteredValue(*entry));
+  }
+  // A submit, Enter, a key, or a click on anything (a div that says Send,
+  // a control the guard can't classify, a link whose page script runs)
+  // can send what the page holds, so the card shows it all. A form can own
+  // fields outside its element, so it's the whole document.
+  const bool sends = meta.submit || meta.press_enter;
+  if (!sends && pending_.name != "click") {
+    input.values_kind = ValuesKind::kEnter;
+    return;
+  }
+  input.values_kind = sends ? ValuesKind::kSend : ValuesKind::kPage;
+  const EnteredValues::Shown shown =
+      entry ? current_->entered.Lookup(
+                  {entry->key.tab_id, entry->key.document_token},
+                  // This step's own value is already first.
+                  enters ? std::make_optional(entry->key.dom_node_id)
+                         : std::nullopt)
+            : current_->entered.LookupTab(TargetAlias());
+  input.values.insert(input.values.end(), shown.values.begin(),
+                      shown.values.end());
+  input.untracked_values = shown.untracked;
+  input.values_forgotten = shown.forgotten;
+}
+ShownValue AgentController::EnteredValue(const RefEntry& entry) const {
+  const std::string value =
+      String(pending_.arguments, pending_.name == "type" ? "text" : "value");
+  const bool sensitive = entry.password || entry.sensitive;
+  // Hidden only when the user wrote it: the page decides what a password
+  // field is, and model-chosen text in one is exactly what to show.
+  const bool hidden =
+      sensitive && pending_.name == "type" && guard_.IsOwnWords(value);
+  return {entry.name, hidden ? std::string() : value, hidden, sensitive};
+}
+void AgentController::RememberEnteredValue() {
+  if (pending_.name != "type" && pending_.name != "select_option") {
+    return;
+  }
+  const RefEntry* entry =
+      current_->refs.Lookup(String(pending_.arguments, "ref"));
+  if (!entry) {
+    return;
+  }
+  // A hidden value is stored as empty (EnteredValues::Record).
+  current_->entered.Record({entry->key.tab_id, entry->key.document_token},
+                           entry->key.dom_node_id, EnteredValue(*entry));
+}

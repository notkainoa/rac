+// like any flow card, and a scroll allowed once still moves by the fixed
+// step.
+TEST(ActionGuardDataFlowTest, OutOfFreeStepsCardNamesTheFlow) {
+  ActionGuard guard;
+  guard.BeginTurn(PermissionLevel::kAuto, {"go"}, {}, "O");
+  guard.RecordRead({"https://a.example"});
+  auto scroll = LinkClick("https://b.example");
+  scroll.risk.tool_name = "scroll";
+  scroll.risk.element_role.clear();
+  for (int i = 0; i < kFreeStepsPerTurn; ++i) {
+    guard.SpendFreeStep();
+  }
+  GuardResult card = guard.Evaluate(scroll);
+  ASSERT_EQ(card.decision, GuardDecision::kConfirm);
+  EXPECT_EQ(card.flow_from, std::vector<std::string>{"https://a.example"});
+  EXPECT_EQ(card.flow_to, std::vector<std::string>{"https://b.example"});
+  EXPECT_TRUE(card.flow_card);
+  EXPECT_TRUE(card.offer_flow_grant);
+  EXPECT_TRUE(card.coarse_scroll);
+  guard.GrantFlow("https://b.example", card.flow_from);
+  EXPECT_EQ(guard.Evaluate(scroll).decision, GuardDecision::kAllow)
+      << "the grant settles it";
+  auto own_words = Low();
+  own_words.risk.current_origin = own_words.frame_origin = "https://c.example";
+  card = guard.Evaluate(own_words);
+  ASSERT_EQ(card.decision, GuardDecision::kConfirm);
+  EXPECT_EQ(card.flow_to, std::vector<std::string>{"https://c.example"});
+  EXPECT_FALSE(card.coarse_scroll);
+  guard.SetLevel(PermissionLevel::kAsk);
+  card = guard.Evaluate(scroll);
+  EXPECT_TRUE(card.flow_to.empty()) << "granted above";
+  scroll.risk.current_origin = scroll.frame_origin = "https://d.example";
+  card = guard.Evaluate(scroll);
+  ASSERT_EQ(card.decision, GuardDecision::kConfirm);
+  EXPECT_EQ(card.flow_to, std::vector<std::string>{"https://d.example"});
+  EXPECT_FALSE(card.offer_flow_grant) << "ask offers no grant";
+}
+
+// A grant that covered "earlier" was for what its card showed. A site read
+// past the cap is counted as earlier too, so it takes that grant back.
+TEST(ActionGuardDataFlowTest, ReadsPastTheCapTakeBackEarlierGrants) {
+  ActionGuard guard;
+  guard.BeginTurn(PermissionLevel::kAuto, {"one", "two"}, {}, "P");
+  GuardResult card = guard.Evaluate(LinkClick("https://dest.example"));
+  ASSERT_EQ(card.flow_from, std::vector<std::string>{kEarlierInConversation});
+  guard.GrantFlow("https://dest.example", card.flow_from);
+  EXPECT_EQ(guard.Evaluate(LinkClick("https://dest.example")).decision,
+            GuardDecision::kAllow);
+  std::set<std::string> many;
+  for (int i = 0; i < 256; ++i) {
+    many.insert("https://s" + base::NumberToString(i) + ".example");
+  }
+  guard.RecordRead(many);
+  guard.GrantFlow("https://dest.example",
+                  guard.Evaluate(LinkClick("https://dest.example")).flow_from);
+  EXPECT_EQ(guard.Evaluate(LinkClick("https://dest.example")).decision,
+            GuardDecision::kAllow);
+  guard.RecordRead({"https://s0.example"});
+  EXPECT_EQ(guard.Evaluate(LinkClick("https://dest.example")).decision,
+            GuardDecision::kAllow)
+      << "a site already listed changes nothing";
+  guard.RecordRead({"https://secret.example"});
+  card = guard.Evaluate(LinkClick("https://dest.example"));
+  EXPECT_EQ(card.decision, GuardDecision::kConfirm);
+  EXPECT_EQ(card.flow_from, std::vector<std::string>{kEarlierInConversation});
+}
+
+// Past 256 origins the record stops listing them and counts the rest as

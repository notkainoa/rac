+  page.mutable_main_frame_data()->mutable_security_origin()->set_value(
+      "https://a.example");
+  auto* root = page.mutable_root_node();
+  Paragraph(root, "Top text.");
+  // A cross-site frame's paragraph, as a block.
+  Paragraph(FrameNode(root, "https://b.example", "https://b.example/"),
+            "The code is 4417.");
+  // A srcdoc frame inside another frame: its text is that frame's.
+  auto* b_again = FrameNode(root, "https://b2.example", "https://b2.example");
+  Paragraph(FrameNode(b_again, "", "about:srcdoc"), "srcdoc text");
+  // A frame inline in a paragraph goes through Inline, not Collect.
+  auto* paragraph = Node(root, proto::CONTENT_ATTRIBUTE_PARAGRAPH);
+  Text(paragraph, "Before");
+  Text(FrameNode(paragraph, "https://inline.example", "https://inline.example"),
+       "inline frame");
+  // A frame whose only text is the user's selection.
+  FrameNode(root, "https://selected.example", "https://selected.example")
+      ->mutable_content_attributes()

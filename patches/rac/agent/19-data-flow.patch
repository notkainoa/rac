+namespace {
+// An iframe node under `parent` with a frame of its own. Empty `origin` and
+// `url` leave the field unset; `opaque` makes the security origin opaque.
+proto::ContentNode* Frame(proto::ContentNode* parent,
+                          const std::string& origin,
+                          const std::string& url,
+                          bool opaque = false) {
+  auto* node = Node(parent, proto::CONTENT_ATTRIBUTE_IFRAME);
+  auto* frame = node->mutable_content_attributes()
+                    ->mutable_iframe_data()
+                    ->mutable_frame_data();
+  if (opaque) {
+    frame->mutable_security_origin()->set_opaque(true);
+    frame->mutable_security_origin()->set_value("nonce-1234");
+  } else if (!origin.empty()) {
+    frame->mutable_security_origin()->set_value(origin);
+  }
+  if (!url.empty()) {
+    frame->set_url(url);
+  }
+  return node;
+}
+void Words(proto::ContentNode* parent, const std::string& text) {
+  Node(parent, proto::CONTENT_ATTRIBUTE_TEXT)
+      ->mutable_content_attributes()
+      ->mutable_text_data()
+      ->set_text_content(text);
+}

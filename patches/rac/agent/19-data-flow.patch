+bool IsUsersOwnWords(std::string_view typed, std::string_view user_text) {
+  // The text is typed as the model wrote it, so it is matched as written:
+  // case, inner spacing, and spaces at the ends would each spell something
+  // the user never wrote.
+  if (typed.empty()) {
+    return true;
+  }
+  if (base::IsAsciiWhitespace(typed.front()) ||
+      base::IsAsciiWhitespace(typed.back())) {
+    return false;
+  }
+  auto word = [](char c) {
+    return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) ||
+           static_cast<unsigned char>(c) >= 0x80;
+  };
+  // Punctuation alone isn't a word of the user's: ".", "-", and "," are in
+  // nearly every message, and could spell anything one mark at a time.
+  if (std::ranges::none_of(typed, word)) {
+    return false;
+  }
+  for (size_t at = user_text.find(typed); at != std::string::npos;
+       at = user_text.find(typed, at + 1)) {
+    const size_t end = at + typed.size();
+    // A match that starts or ends inside a word picks letters out of the
+    // user's words, which can spell anything.
+    if ((at == 0 || !word(user_text[at - 1]) || !word(typed.front())) &&
+        (end == user_text.size() || !word(user_text[end]) ||
+         !word(typed.back()))) {
+      return true;
+    }
+  }
+  return false;
+}

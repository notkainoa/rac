+
+void EnteredValues::Add(Shown& shown,
+                        const Values& values,
+                        std::optional<int32_t> skip) const {
+  for (const auto& [node, value] : values.fields) {
+    if (node != skip) {
+      shown.values.push_back(value);
+    }
+  }
+  shown.untracked += static_cast<int>(values.untracked.size());
+  shown.forgotten |= values.forgotten;
+}
+
+EnteredValues::Shown EnteredValues::Lookup(const Document& document,
+                                           std::optional<int32_t> skip) const {
+  Shown shown;
+  const auto found = documents_.find(document);
+  if (found == documents_.end()) {
+    shown.forgotten = lost_track_ || forgotten_.contains(document);
+  } else {
+    Add(shown, found->second, skip);
+  }
+  return shown;
+}
+
+EnteredValues::Shown EnteredValues::LookupTab(const std::string& tab) const {
+  Shown shown;
+  shown.forgotten = lost_track_;
+  for (const auto& [document, values] : documents_) {
+    if (document.first == tab) {
+      Add(shown, values, std::nullopt);
+    }
+  }
+  for (const Document& document : forgotten_) {
+    shown.forgotten |= document.first == tab;
+  }
+  return shown;
+}

+  const std::u16string units = base::UTF8ToUTF16(value);
+  std::u16string out;
+  out.reserve(units.size());
+  for (size_t i = 0; i < units.size(); ++i) {
+    char32_t c = units[i];
+    size_t length = 1;
+    if (c >= 0xD800 && c <= 0xDBFF && i + 1 < units.size() &&
+        units[i + 1] >= 0xDC00 && units[i + 1] <= 0xDFFF) {
+      c = 0x10000 + ((c - 0xD800) << 10) + (units[i + 1] - 0xDC00);
+      length = 2;
+    }
+    if (SpelledOut(c)) {
+      std::string hex = base::HexEncode(std::string{static_cast<char>(c >> 16),
+                                                    static_cast<char>(c >> 8),
+                                                    static_cast<char>(c)});
+      while (hex.size() > 4 && hex.starts_with("0")) {
+        hex.erase(0, 1);
+      }
+      // "⟨U+202E⟩"
+      out += u"\u27E8U+" + base::ASCIIToUTF16(hex) + u"\u27E9";

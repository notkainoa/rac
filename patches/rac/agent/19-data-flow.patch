+std::string WithoutPageBlocks(std::string_view message) {
+  constexpr std::string_view kOpen = "<<<page ";
+  constexpr std::string_view kEnd = "<<<end page ";
+  std::string out;
+  size_t at = 0;
+  while (at < message.size()) {
+    const size_t open = message.find(kOpen, at);
+    if (open == std::string_view::npos) {
+      out.append(message.substr(at));
+      break;
+    }
+    out.append(message.substr(at, open - at));
+    // Page data can't hold "<<<" (NeutralizeRoleTags), so the first end
+    // marker after the opening is the block's own.
+    const size_t end = message.find(kEnd, open + kOpen.size());
+    const size_t close =
+        end == std::string_view::npos ? end : message.find(">>>", end);
+    if (close == std::string_view::npos) {
+      break;
+    }
+    out.push_back('\n');
+    at = close + 3;
+  }
+  return out;
+}

+void ActionGuard::RecordRead(const std::set<std::string>& origins) {
+  DataFlow& flow = flows_[conversation_];
+  for (const std::string& origin : origins) {
+    if (origin == kAttachedFiles) {
+      flow.files_attached = true;
+      continue;
+    }
+    const GURL url(origin);
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      // An opaque or local page's content belongs to whoever showed it,
+      // which the caller records instead.
+      continue;
+    }
+    const std::string read = url::Origin::Create(url).Serialize();
+    if (flow.read.contains(read)) {
+      continue;
+    }
+    if (flow.read.size() >= kMaxReadOrigins) {
+      // Past the cap a new site is only "earlier". A grant that covered
+      // "earlier" was for what its card showed, not this, so it asks again.
+      flow.earlier_unknown = true;
+      for (auto& [destination, sources] : flow.grants) {
+        sources.erase(kEarlierInConversation);
+      }
+      continue;
+    }
+    flow.read.insert(read);
+  }

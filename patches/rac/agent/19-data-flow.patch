+  EXPECT_FALSE(event.contains("moreValues"));
+  EXPECT_FALSE(event.contains("untrackedValues"));
+  EXPECT_FALSE(event.contains("valuesForgotten"));
+  // A whole document's worth fits on one card.
+  input.values.assign(EnteredValues::kMaxFields + 1, {"Field", "v"});
+  EXPECT_EQ(ConfirmRequestEvent(input).FindList("values")->size(),
+            EnteredValues::kMaxFields + 1);
+  EXPECT_FALSE(ConfirmRequestEvent(input).contains("moreValues"));
+  input.values.push_back({"Field", "v"});
+  EXPECT_EQ(ConfirmRequestEvent(input).FindInt("moreValues"), 1);
+  // What it couldn't track is said even with no value to list.

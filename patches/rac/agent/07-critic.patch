+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+#include "chrome/browser/rac/agent/critic_protocol.h"
+
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace rac::agent {
+TEST(CriticProtocolTest, OnlyGoalAndActionMetadata) {
+  ActionMetadata action;
+  action.risk.tool_name = "type";
+  action.risk.element_role = "textbox";
+  action.risk.element_name = "Email";
+  action.risk.current_origin = "https://example.com";
+  action.risk.button_text = "PAGE TEXT MUST NOT APPEAR";
+  action.url = "https://example.com/private?secret=1";
+  const auto prompt = BuildCriticPrompt("Fill in my email", action);
+  auto value = base::JSONReader::ReadDict(prompt, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(value);
+  EXPECT_EQ(value->size(), 6u);
+  EXPECT_EQ(*value->FindString("goal"), "Fill in my email");
+  EXPECT_EQ(prompt.find("PAGE TEXT"), std::string::npos);
+  EXPECT_EQ(prompt.find("secret"), std::string::npos);
+}
+TEST(CriticProtocolTest, EscalatesMalformedOrUncertainResponses) {
+  for (const char* input :
+       {"", "allow", "{}", "{\"decision\":true}", "{\"decision\":\"maybe\"}",
+        "{\"decision\":\"allow\"} extra"}) {
+    EXPECT_TRUE(ParseCriticResponse(input).escalate) << input;
+  }
+  auto verdict = ParseCriticResponse(
+      R"({"decision":"escalate","note":"This could send a message."})");
+  EXPECT_TRUE(verdict.escalate);
+  EXPECT_EQ(verdict.note, "This could send a message.");
+  EXPECT_FALSE(
+      ParseCriticResponse(R"({"decision":"allow","note":"Fits the goal"})")
+          .escalate);
+}
+TEST(CriticProtocolTest, FailClosedDefaultsAndTruncatesPageLeak) {
+  CriticVerdict unset;
+  EXPECT_TRUE(unset.escalate);
+  EXPECT_TRUE(ParseCriticResponse("not-json").escalate);
+  EXPECT_TRUE(ParseCriticResponse(std::string(5000, 'a')).escalate);
+  ActionMetadata action;
+  action.risk.tool_name = "click";
+  action.risk.element_name = "Save";
+  action.risk.current_origin = "https://example.com";
+  action.risk.button_text = "inner page copy must stay out";
+  const auto prompt = BuildCriticPrompt(std::string(8000, 'g'), action);
+  EXPECT_LE(prompt.size(), 4500u);
+  EXPECT_EQ(prompt.find("inner page copy"), std::string::npos);
+}

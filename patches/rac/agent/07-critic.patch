+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+#include "chrome/browser/rac/agent/critic_protocol.h"
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+namespace rac::agent {
+std::string BuildCriticPrompt(std::string_view goal,
+                              const ActionMetadata& action) {
+  std::string bounded_goal;
+  base::TruncateUTF8ToByteSize(goal, 4000, &bounded_goal);
+  std::string name;
+  base::TruncateUTF8ToByteSize(action.risk.element_name, 200, &name);
+  auto metadata =
+      base::DictValue()
+          .Set("goal", bounded_goal)
+          .Set("tool", action.risk.tool_name)
+          .Set("role", action.risk.element_role)
+          .Set("name", name)
+          .Set("origin", action.frame_origin.empty()
+                             ? action.risk.current_origin
+                             : action.frame_origin)
+          .Set("risk", RiskClassName(ClassifyActionRisk(action.risk)));
+  std::string json;
+  base::JSONWriter::Write(metadata, &json);
+  return json;
+}
+CriticVerdict ParseCriticResponse(std::string_view response) {
+  CriticVerdict result{true, "This step looks unusual for what you asked."};
+  if (response.size() > 4096) {
+    return result;
+  }
+  auto value = base::JSONReader::ReadDict(response, base::JSON_PARSE_RFC);
+  if (!value) {
+    return result;
+  }
+  const auto* decision = value->FindString("decision");
+  if (!decision || (*decision != "allow" && *decision != "escalate")) {
+    return result;
+  }
+  result.escalate = *decision != "allow";
+  if (const auto* note = value->FindString("note");
+      note && base::IsStringUTF8(*note) && !note->empty()) {
+    base::TruncateUTF8ToByteSize(base::CollapseWhitespaceASCII(*note, false),
+                                 240, &result.note);
+  }
+  return result;
+}

+  EXPECT_EQ(guard.Evaluate(buy).decision, GuardDecision::kConfirm);
+  auto blocked = Low();
+  blocked.risk.tool_name = "navigate";
+  blocked.url = "https://evil.example/steal";
+  EXPECT_EQ(guard.Evaluate(blocked).decision, GuardDecision::kBlock);
+}

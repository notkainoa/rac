+bool ActionGuard::NeverOn(const std::string& origin) const {
+  // A "never" rule covers the site on any scheme or port, so a rule saved
+  // for https://bank.example also stops http://bank.example:8080.
+  const GURL url(origin);
+  if (!url.is_valid() || url.host().empty()) {
+    return false;
+  }
+  for (const auto& [rule_origin, rule] : site_rules_) {
+    if (rule == SiteRule::kNever && GURL(rule_origin).host() == url.host()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ActionGuard::IsNamed(const std::string& origin) const {
+  const auto rule = site_rules_.find(origin);
+  // An opaque frame ("null": about:blank, srcdoc, data:) was built by a
+  // page's script, not named by the user.
+  return origin.empty() || origins_.contains(origin) ||
+         named_origins_.contains(origin) ||
+         (rule != site_rules_.end() && rule->second == SiteRule::kAlways);
+}

+// "always" makes a site count as one the user named; "never" blocks every
+// action there at every level, with a reason that names the setting.
+TEST(ActionGuardSiteRuleTest, AlwaysMakesTheSiteNamedAndNeverBlocks) {
+  ActionGuard guard;
+  guard.BeginTurn(PermissionLevel::kAuto, {}, {"https://example.com"});
+  guard.SetSiteRules({{"https://trusted.com", SiteRule::kAlways},
+                      {"https://banned.com", SiteRule::kNever}});
+  auto typing = Low();
+  typing.unknown_text = true;
+  typing.risk.current_origin = "https://trusted.com";
+  EXPECT_EQ(guard.Evaluate(typing).decision, GuardDecision::kAllow);
+  typing.risk.current_origin = "https://other.com";
+  const GuardResult offered = guard.Evaluate(typing);
+  EXPECT_EQ(offered.decision, GuardDecision::kConfirm);
+  EXPECT_TRUE(offered.offer_site_rule);
+  guard.AddSiteRule("https://other.com", SiteRule::kAlways);
+  EXPECT_EQ(guard.Evaluate(typing).decision, GuardDecision::kAllow);
+  auto submit = Low();
+  submit.submit = true;
+  submit.risk.current_origin = "https://trusted.com";
+  const GuardResult risky = guard.Evaluate(submit);
+  EXPECT_EQ(risky.decision, GuardDecision::kConfirm) << "risky still asks";
+  EXPECT_FALSE(risky.offer_site_rule);
+  auto click = Low();
+  click.risk.tool_name = "click";
+  click.risk.element_role = "link";
+  click.risk.current_origin = "https://banned.com";
+  const GuardResult blocked = guard.Evaluate(click);
+  EXPECT_EQ(blocked.decision, GuardDecision::kBlock);
+  EXPECT_NE(blocked.reason.find("banned.com"), std::string::npos);
+  EXPECT_NE(blocked.reason.find("Settings"), std::string::npos);
+  auto navigate = Low();
+  navigate.risk.tool_name = "navigate";
+  navigate.url = "https://banned.com/";
+  navigate.requires_url_provenance = false;
+  navigate.risk.target_origin = "https://banned.com";
+  EXPECT_EQ(guard.Evaluate(navigate).decision, GuardDecision::kBlock);
+  auto read = Low();
+  read.risk.tool_name = "snapshot";
+  read.risk.current_origin = "https://banned.com";
+  EXPECT_EQ(guard.Evaluate(read).decision, GuardDecision::kAllow)
+      << "reads are not actions";
+}
+
+// A rule for the tab's site wouldn't settle a card about a frame on another
+// site, so that card doesn't offer one.
+// A "never" rule covers its site on any scheme or port.
+TEST(ActionGuardSiteRuleTest, NeverCoversTheSiteOnAnySchemeOrPort) {
+  ActionGuard guard;
+  guard.BeginTurn(PermissionLevel::kAuto, {}, {"https://example.com"});
+  guard.SetSiteRules({{"https://bank.example", SiteRule::kNever}});
+  auto click = Low();
+  click.risk.tool_name = "click";
+  click.risk.element_role = "link";
+  for (const char* origin : {"https://bank.example", "http://bank.example",
+                             "http://bank.example:8080"}) {
+    click.risk.current_origin = origin;
+    EXPECT_EQ(guard.Evaluate(click).decision, GuardDecision::kBlock) << origin;
+  }
+  click.risk.current_origin = "https://www.bank.example";
+  EXPECT_EQ(guard.Evaluate(click).decision, GuardDecision::kAllow)
+      << "another host is another site";
+}

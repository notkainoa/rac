+
+// The origin a typed site stands for: a bare host means https. Null when it
+// isn't an http(s) address.
+function siteOrigin(raw: string): string|null {
+  const text = raw.trim();
+  if (!text || /\s/.test(text)) {
+    return null;
+  }
+  try {
+    const url = new URL(text.includes('://') ? text : `https://${text}`);
+    // The parser escapes what a host can't hold ("a%20b"), so check the
+    // result is a plain host name, which may end in one dot
+    // ("example.com."), or an IP address.
+    return (url.protocol === 'https:' || url.protocol === 'http:') &&
+            /^(\[[0-9a-f:.]+\]|[a-z0-9-]+(\.[a-z0-9-]+)*\.?)$/i.test(
+                url.hostname) ?
+        url.origin :
+        null;
+  } catch {
+    return null;
+  }

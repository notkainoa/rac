--- src.orig/chrome/browser/ui/views/rac/agent/agent_tab_indicator.cc
+++ src/chrome/browser/ui/views/rac/agent/agent_tab_indicator.cc
@@ -75,6 +75,7 @@ namespace rac::agent {

+TEST(ActionGuardSiteRuleTest, OnlyLevelsThatHonorTheRuleOfferIt) {
+  auto type = Low();
+  type.risk.tool_name = "type";
+  type.risk.element_role = "textbox";
+  type.unknown_text = true;
+  type.risk.current_origin = "https://elsewhere.com";
+  for (PermissionLevel level :
+       {PermissionLevel::kAsk, PermissionLevel::kAuto}) {
+    ActionGuard guard;
+    guard.BeginTurn(level, {}, {"https://example.com"});
+    const GuardResult result = guard.Evaluate(type);
+    EXPECT_EQ(result.decision, GuardDecision::kConfirm)
+        << static_cast<int>(level);
+    EXPECT_EQ(result.offer_site_rule, level == PermissionLevel::kAuto)
+        << "ask asks on every site, so a rule for this one would change "
+           "nothing and its card must not offer one";
+  }
+}

+// The ask level confirms every action, risky or not, and never shows a plan.
+TEST(ActionGuardLevelTest, AskConfirmsEveryActionButReads) {
+  ActionGuard guard;
+  guard.BeginTurn(PermissionLevel::kAsk, {}, {"https://example.com"});
+  auto read = Low();
+  read.risk.tool_name = "snapshot";
+  EXPECT_EQ(guard.Evaluate(read).decision, GuardDecision::kAllow);
+  for (const char* still : {"scroll", "wait_for_settle", "switch_tab"}) {
+    auto move = Low();
+    move.risk.tool_name = still;
+    EXPECT_EQ(guard.Evaluate(move).decision, GuardDecision::kAllow) << still;
+  }
+  auto click = Low();
+  click.risk.tool_name = "click";
+  click.risk.element_role = "link";
+  EXPECT_EQ(guard.Evaluate(click).decision, GuardDecision::kConfirm);
+  EXPECT_EQ(guard.Evaluate(click).risk, RiskClass::kLow);
+  auto navigate = Low();
+  navigate.risk.tool_name = "navigate";
+  navigate.url = "https://other.com/";
+  navigate.requires_url_provenance = false;
+  navigate.risk.target_origin = "https://other.com";
+  EXPECT_EQ(guard.Evaluate(navigate).decision, GuardDecision::kConfirm);
+  auto typing = Low();
+  typing.unknown_text = true;
+  EXPECT_EQ(guard.Evaluate(typing).decision, GuardDecision::kConfirm);
+  auto submit = Low();
+  submit.submit = true;
+  EXPECT_EQ(guard.Evaluate(submit).decision, GuardDecision::kConfirm);
+  EXPECT_EQ(guard.Evaluate(submit).risk, RiskClass::kConsequential);
+  auto password = Low();
+  password.risk.is_password_field = true;
+  EXPECT_EQ(guard.Evaluate(password).decision, GuardDecision::kConfirm);
+}
+
+// The auto level runs free on sites the user named and on new sites, asks
+// about typing its own words on a site the user didn't name, and still asks
+// about every risky action. It never shows a plan.
+TEST(ActionGuardLevelTest, AutoAsksOnlyForRiskAndForeignTyping) {
+  ActionGuard guard;
+  guard.BeginTurn(PermissionLevel::kAuto, {"Use https://named.com/ please"},
+                  {"https://example.com"});
+  auto click = Low();
+  click.risk.tool_name = "click";
+  click.risk.element_role = "link";
+  EXPECT_EQ(guard.Evaluate(click).decision, GuardDecision::kAllow);
+  auto navigate = Low();
+  navigate.risk.tool_name = "navigate";
+  navigate.url = "https://other.com/";
+  navigate.requires_url_provenance = false;
+  navigate.risk.target_origin = "https://other.com";
+  navigate.risk.cross_origin = true;
+  EXPECT_EQ(guard.Evaluate(navigate).decision, GuardDecision::kAllow);
+  auto typing = Low();
+  typing.unknown_text = true;
+  typing.unknown_field = true;
+  EXPECT_EQ(guard.Evaluate(typing).decision, GuardDecision::kAllow)
+      << "attached tab";
+  typing.risk.current_origin = "https://named.com";
+  EXPECT_EQ(guard.Evaluate(typing).decision, GuardDecision::kAllow)
+      << "site named in a message";
+  typing.risk.current_origin = "https://other.com";
+  EXPECT_EQ(guard.Evaluate(typing).decision, GuardDecision::kConfirm)
+      << "site the user never named";
+  typing.unknown_text = false;
+  EXPECT_EQ(guard.Evaluate(typing).decision, GuardDecision::kAllow)
+      << "the user's own words";
+  auto submit = Low();
+  submit.submit = true;
+  EXPECT_EQ(guard.Evaluate(submit).decision, GuardDecision::kConfirm);
+  auto enter = Low();
+  enter.press_enter = true;
+  EXPECT_EQ(guard.Evaluate(enter).decision, GuardDecision::kConfirm);
+  auto password = Low();
+  password.risk.is_password_field = true;
+  EXPECT_EQ(guard.Evaluate(password).decision, GuardDecision::kConfirm);
+  auto buy = Low();
+  buy.risk.tool_name = "click";
+  buy.risk.element_name = "Buy now";
+  EXPECT_EQ(guard.Evaluate(buy).decision, GuardDecision::kConfirm);
+  auto plain = Low();
+  plain.risk.tool_name = "click";
+  plain.unknown_target = true;
+  EXPECT_EQ(guard.Evaluate(plain).decision, GuardDecision::kConfirm);
+  auto download = Low();
+  download.download = true;
+  EXPECT_EQ(guard.Evaluate(download).decision, GuardDecision::kBlock);
+}
+
+// The careful level is the old guard: a plan first, then everything the

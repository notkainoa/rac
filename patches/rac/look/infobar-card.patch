+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/infobar_card.h"
+
+#include <algorithm>
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/views/infobars/infobar_view.h"
+#include "chrome/browser/ui/views/rac/rac_look.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/gfx/skia_paint_util.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+
+namespace rac {
+
+namespace {
+
+// Padding inside the card, before the icon and after the close button. The
+// close button's hover circle keeps the gap it has above and below.
+constexpr int kCardLeadingPadding = 12;
+constexpr int kCardTrailingPadding = 8;
+
+// The active tab's shadow: 0 2px 8px.
+constexpr int kCardShadowBlur = 8;
+
+class InfoBarCardsBackground : public views::Background {
+ public:
+  InfoBarCardsBackground() = default;
+  ~InfoBarCardsBackground() override = default;
+
+  // views::Background:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const ui::ColorProvider* colors = view->GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    for (const views::View* child : view->children()) {
+      if (!views::IsViewClass<InfoBarView>(child) || !child->GetVisible() ||
+          child->bounds().IsEmpty()) {
+        continue;
+      }
+      cc::PaintFlags fill;
+      fill.setAntiAlias(true);
+      fill.setColor(GetInfoBarCardColor(colors));
+      fill.setLooper(gfx::CreateShadowDrawLooper(
+          {gfx::ShadowValue(gfx::Vector2d(0, 2), kCardShadowBlur,
+                            colors->GetColor(kColorRacTabSelectedShadow))}));
+      canvas->DrawRoundRect(gfx::RectF(child->bounds()), kInfoBarCardRadius,
+                            fill);
+    }
+  }
+};
+
+}  // namespace
+
+gfx::Insets GetInfoBarCardInteriorMargin() {
+  return gfx::Insets::TLBR(0, kCardLeadingPadding, 0, kCardTrailingPadding);
+}
+
+gfx::Rect GetInfoBarCardBounds(const gfx::Rect& top_bar,
+                               const gfx::Size& preferred) {
+  // The container's margin around the card is the gap below the bar, so it
+  // may reach the bar's edges.
+  const int width = std::min(preferred.width(), top_bar.width());
+  return gfx::Rect(top_bar.x() + (top_bar.width() - width) / 2,
+                   top_bar.bottom(), width, preferred.height());
+}
+
+std::unique_ptr<views::Background> CreateInfoBarCardsBackground() {
+  return std::make_unique<InfoBarCardsBackground>();
+}
+
+std::unique_ptr<views::Border> CreateInfoBarCardBorder() {
+  return views::CreateRoundedRectBorder(1, kInfoBarCardRadius,
+                                        kColorRacContentCardBorder);
+}
+
+SkColor GetInfoBarCardColor(const ui::ColorProvider* color_provider) {
+  return color_provider->GetColor(kColorRacTabBackgroundSelected);
+}
+
+}  // namespace rac

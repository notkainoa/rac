+void InfoBarContainerView::SetRacCardStyle(bool card) {
+  if (rac_card_ == card) {
+    return;
+  }
+  rac_card_ = card;
+  // The cards draw over the page, which has layers of its own.
+  if (card) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+  } else {
+    DestroyLayer();
+  }
+  for (View* child : children()) {
+    if (child != chrome_border_) {
+      static_cast<InfoBarView*>(child)->SetRacCardStyle(card);
+    }
+  }
+  UpdateBackground();
+  InvalidateLayout();
+}

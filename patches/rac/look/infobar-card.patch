@@ -0,0 +1,58 @@
+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_INFOBAR_CARD_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_INFOBAR_CARD_H_
+
+#include <memory>
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace ui {
+class ColorProvider;
+}  // namespace ui
+
+namespace views {
+class Background;
+class Border;
+}  // namespace views
+
+// In the Top bar layout, infobars float over the top of the page as cards
+// sized to their content, instead of taking a strip of the window.
+namespace rac {
+
+// Room around each card for its shadow, and between stacked cards. The
+// container's bounds include it.
+inline constexpr int kInfoBarCardMargin = 8;
+
+// Space between the last control and the close button.
+inline constexpr int kInfoBarCardCloseGap = 4;
+
+// Corner radius of a card, matching the address bar's pill.
+inline constexpr int kInfoBarCardRadius = 10;
+
+// The infobar's padding inside its card.
+gfx::Insets GetInfoBarCardInteriorMargin();
+
+// Where the infobar container goes: centered just below `top_bar`, as wide
+// as its cards but no wider than the bar.
+gfx::Rect GetInfoBarCardBounds(const gfx::Rect& top_bar,
+                               const gfx::Size& preferred);
+
+// Paints the shadow of each infobar's card in the container. The infobar
+// fills its card itself, so its labels draw on an opaque color.
+std::unique_ptr<views::Background> CreateInfoBarCardsBackground();
+
+// The card's hairline edge, as on the active tab.
+std::unique_ptr<views::Border> CreateInfoBarCardBorder();
+
+// The card's fill, for the labels drawn on it.
+SkColor GetInfoBarCardColor(const ui::ColorProvider* color_provider);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_INFOBAR_CARD_H_

+bool InfoBarContainerView::DoesIntersectRect(const views::View* target,
+                                             const gfx::Rect& rect) const {
+  if (!rac_card_) {
+    return views::ViewTargeterDelegate::DoesIntersectRect(target, rect);
+  }
+  // Clicks around the cards reach the page.
+  return std::ranges::any_of(children(), [&](const View* child) {
+    return child != chrome_border_ && child->bounds().Intersects(rect);
+  });

+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_RAC_TOKENS_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_RAC_TOKENS_H_
+
+#include "base/time/time.h"
+#include "chrome/browser/ui/views/rac/motion/rac_spring.h"
+#include "ui/gfx/animation/tween.h"
+
+// rac's design values: motion, corners, spacing, and type. Colors stay in
+// the color mixer (rac_color_id.h).
+//
+// This file is the source of truth for WebUI too. devutils/rac/tokens.py
+// reads the tokens below and writes ui/webui/resources/css/rac_tokens.css,
+// which pages load as chrome://resources/css/rac_tokens.css. Write each
+// token as one `inline constexpr` statement whose value is a number, a
+// base::Milliseconds() or base::Hertz() duration, a braced list of those, or
+// another token. A `// rac-css:` comment adds a CSS-only property. Run
+// `tokens.py` after a change; `tokens.py --check` fails on drift.
+//
+// Frequency sets the budget: hundreds of times a day, 0 to 100 ms of color
+// or opacity; tens a day, 120 to 250 ms with springs for movement; rare
+// surfaces up to 400 ms. Springs move things, fixed curves fade and recolor.
+// Read rac::motion::ReducedMotion() each time an animation starts.
+
+namespace rac {
+
+// A fixed curve. CSS and rac's curve elements use the bezier as recorded.
+// Code that takes only a gfx::Tween::Type uses `tween`, the nearest one.
+struct Curve {
+  double x1, y1, x2, y2;
+  gfx::Tween::Type tween;
+};
+
+// A duration and its curve.
+struct Timing {
+  base::TimeDelta duration;
+  Curve curve;
+};
+
+namespace tokens {
+
+// Curves.
+
+// Material 3 standard, as Helium's reveal uses.
+inline constexpr Curve kEaseStandard{0.2, 0, 0, 1,
+                                     gfx::Tween::FAST_OUT_SLOW_IN_3};
+// Within 4% of Dia's row slide.
+inline constexpr Curve kEaseList{0.2, 0, 0.2, 1,
+                                 gfx::Tween::FAST_OUT_SLOW_IN_2};
+// CSS's ease-out; Dia's close fade. EASE_OUT is 6.9% off.
+inline constexpr Curve kEaseFadeOut{0, 0, 0.58, 1, gfx::Tween::EASE_OUT};
+// Dia's command bar. No tween is close (16.7%), so native code runs it in a
+// rac::CurveElement.
+inline constexpr Curve kEaseExpo{0.16, 1, 0.3, 1,
+                                 gfx::Tween::ACCEL_5_70_DECEL_90};
+// Cubic ease-in-out; Arc's edge peek out. For opacity only. EASE_IN_OUT is
+// the nearest tween (7.4% off).
+inline constexpr Curve kEaseInOut{0.65, 0, 0.35, 1, gfx::Tween::EASE_IN_OUT};
+
+// Durations and timings.
+
+// Keyboard tab switches, selection, the command bar as the new tab page.
+inline constexpr base::TimeDelta kInstant = base::Milliseconds(0);
+// Tab and list rows, in and out, as Chromium's glow hover.
+inline constexpr Timing kHoverRow{base::Milliseconds(50), kEaseFadeOut};
+// Icon buttons, tiles, chips.
+inline constexpr Timing kHoverControl{base::Milliseconds(120), kEaseStandard};
+// The pressed fill shows at once (kInstant); letting go fades it back.
+inline constexpr Timing kPressRelease = kHoverControl;
+// Fades: a closing row, a row's close button, popover close.
+inline constexpr Timing kFade{base::Milliseconds(100), kEaseFadeOut};
+// Rows sliding to open or close a gap.
+inline constexpr Timing kList{base::Milliseconds(140), kEaseList};
+// Opacity exits.
+inline constexpr Timing kExit{base::Milliseconds(150), kEaseInOut};
+// Confirm and plan cards: opacity plus a kSpacing4 rise, no scale.
+inline constexpr Timing kCard{base::Milliseconds(200), kEaseStandard};
+// Rare popovers (edit space, site controls): scale 0.96 to 1 from the
+// trigger's side, with a kFade fade.
+inline constexpr Timing kPopover{base::Milliseconds(120), kEaseStandard};
+inline constexpr Timing kPanelOpen{base::Milliseconds(250), kEaseStandard};
+inline constexpr Timing kPanelClose{base::Milliseconds(200), kEaseStandard};
+// The command bar growing out of the address field. Closing is kFade.
+inline constexpr Timing kCommandBarGrow{base::Milliseconds(130), kEaseExpo};
+// What a slide becomes under Reduce Motion.
+inline constexpr Timing kReducedFade{base::Milliseconds(150), kEaseFadeOut};
+// Waiting loops step at most this often, and only while work shows.
+inline constexpr base::TimeDelta kLoopStep = base::Hertz(15);
+// A spinner turns no faster than this.
+inline constexpr base::TimeDelta kSpinnerTurn = base::Milliseconds(1880);
+// The first tooltip waits; any shown within the warm window after one
+// closes appears at once, without animation.
+inline constexpr base::TimeDelta kTooltipDelay = base::Milliseconds(500);
+inline constexpr base::TimeDelta kTooltipWarmWindow = base::Milliseconds(1500);
+
+// Springs, as (response in seconds, damping ratio).
+
+// The space pager, the space wash, and the space dots.
+inline constexpr Spring kSpringPage{0.25, 1.0};
+// Cmd+S both ways; later the AI panel. 02-D1 picks the bounce.
+inline constexpr Spring kSpringDock{0.2, 0.85};
+// Rows moving between sections: pin, unpin, favorite, folder moves.
+inline constexpr Spring kSpringMove{0.22, 1.0};
+// The hidden sidebar sliding in at the window edge.
+inline constexpr Spring kSpringReveal{0.185, 0.77};
+// Movement exits, including edge reveal out. Fast and without bounce, so a
+// reversal keeps its speed.
+inline constexpr Spring kSpringExit{0.16, 1.0};
+// Peek growing out of a link.
+inline constexpr Spring kSpringGrow{0.22, 0.9};
+// When a spring is at rest: under 0.25 DIP and 15 DIP/s, checked at 240 Hz
+// as Arc samples its springs.
+inline constexpr RestRule kSpringRest{0.25f, 15.0f, base::Hertz(240),

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_MOTION_RAC_SPRING_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_MOTION_RAC_SPRING_H_
+
+#include "base/check_op.h"
+#include "base/time/time.h"
+
+namespace rac {
+
+// When a spring counts as at rest: closer than `max_offset` and slower than
+// `max_speed`, checked every `step` and given up on at `longest`. Offsets are
+// in the caller's units (DIPs for layers) and speeds in units per second.
+struct RestRule {
+  float max_offset;
+  float max_speed;
+  base::TimeDelta step;
+  base::TimeDelta longest;
+};
+
+// A damped spring, written as Apple writes them: `response` is the period in
+// seconds the spring would swing at with no damping, and `damping_ratio` is 1
+// for no bounce, under 1 for some, and over 1 for a slower, heavier settle.
+// The motion is x'' + 2 * ratio * w * x' + w * w * x = 0, with
+// w = 2 * pi / response, where x is the distance from rest.
+//
+// The values live in rac_tokens.h (kSpringPage, kSpringDock, ...). The unit
+// functions below describe a move from 0 to 1, which is what tests, CSS
+// curves, and tables use. SpringMotion is the same spring started from an
+// actual place and speed.
+class Spring {
+ public:
+  // The shortest response a spring keeps, in seconds.
+  static constexpr double kMinResponse = 0.001;
+  // The longest SettleTime() and SettleTime(distance) will report. A spring
+  // that has not settled by then, such as an undamped one, reports this.
+  static constexpr base::TimeDelta kLongestSettle = base::Seconds(60);
+
+  // `response` must be above 0 and `damping_ratio` must be 0 or more. A ratio
+  // of 0 is allowed and means an undamped spring, which swings forever and so
+  // never settles: SettleTime() reports kLongestSettle for it. That keeps
+  // the spring maths well defined at the edge of its range, and tests use it.
+  // Anything else (a response of 0 or less, a negative ratio, NaN) is a
+  // mistake in the caller. It DCHECKs, and in release builds is clamped to
+  // kMinResponse or to an undamped spring, so the maths below never divides
+  // by zero or returns NaN, and no search can hang.
+  constexpr Spring(double response, double damping_ratio)
+      : response_(ClampedResponse(response)),
+        damping_ratio_(ClampedRatio(damping_ratio)) {
+    DCHECK_GT(response, 0);
+    DCHECK_GE(damping_ratio, 0);
+  }
+
+  constexpr double response() const { return response_; }
+  constexpr double damping_ratio() const { return damping_ratio_; }
+  // w, in radians per second.
+  double AngularFrequency() const;
+
+  // A move from 0 to 1 that starts at `initial_velocity`, in moves per
+  // second toward 1. Under a ratio of 1 the value passes 1 before settling.
+  double ValueAt(base::TimeDelta time, double initial_velocity = 0) const;
+  double VelocityAt(base::TimeDelta time, double initial_velocity = 0) const;
+  // From then on the value stays within `epsilon` of 1. SettleTime(0.01) is
+  // the table's "within 1% at". At most kLongestSettle.
+  base::TimeDelta SettleTime(double epsilon, double initial_velocity = 0) const;
+  // When a move from rest first reaches `fraction`, such as 0.9, or
+  // kLongestSettle if it takes longer.
+  base::TimeDelta TimeToReach(double fraction) const;
+  // How far past 1 a move from rest goes, as a fraction of the move. 0 for a
+  // ratio of 1 or more.
+  double Overshoot() const;
+
+  constexpr bool operator==(const Spring&) const = default;
+
+ private:
+  // Written so NaN fails the comparison and is clamped too. Huge values are
+  // capped: the over- and underdamped forms lose all precision long before.
+  static constexpr double ClampedResponse(double response) {
+    if (!(response >= kMinResponse)) {
+      return kMinResponse;
+    }
+    return response <= kLargest ? response : kLargest;
+  }
+  static constexpr double ClampedRatio(double damping_ratio) {
+    if (!(damping_ratio >= 0)) {
+      return 0;
+    }
+    return damping_ratio <= kLargest ? damping_ratio : kLargest;
+  }
+  static constexpr double kLargest = 1e9;
+
+  double response_;
+  double damping_ratio_;
+};
+
+// One run of a spring: it starts `offset` from rest moving at `velocity`,
+// both in the caller's units, and heads for rest at 0.
+//
+// To retarget without losing speed, take the place and speed now and start a
+// new motion from them (Retarget). A swipe hands its release speed over the
+// same way.
+struct SpringMotion {
+  Spring spring;
+  double offset = 0;
+  double velocity = 0;
+
+  double OffsetAt(base::TimeDelta time) const;
+  double VelocityAt(base::TimeDelta time) const;
+  // From then on the offset stays within `distance` of rest. Never more than
+  // Spring::kLongestSettle: an undamped motion never settles and reports that.
+  base::TimeDelta SettleTime(double distance) const;
+  // The first `rule.step` at which the motion is at rest under `rule`, or
+  // `rule.longest`. With tokens::kSpringRest this is exactly what the space
+  // pager's spring has always used.
+  base::TimeDelta RestTime(const RestRule& rule) const;
+
+  // The motion that continues from this one at `elapsed` toward a resting
+  // place `rest_shift` further along, with the same place and speed. Pass
+  // `next` to change springs, such as kSpringReveal to kSpringExit when the
+  // pointer turns back.
+  SpringMotion Retarget(base::TimeDelta elapsed, double rest_shift) const;
+  SpringMotion Retarget(base::TimeDelta elapsed,
+                        double rest_shift,
+                        const Spring& next) const;
+};
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_MOTION_RAC_SPRING_H_

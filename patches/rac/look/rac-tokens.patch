+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/motion/rac_spring.h"
+
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+#include <optional>
+
+#include "base/check_op.h"
+
+namespace rac {
+
+namespace {
+
+// Ratios this close to 1 use the critically damped form. The other forms
+// divide by sqrt(|1 - ratio^2|), which loses precision near 1.
+constexpr double kCriticalTolerance = 1e-9;
+// Searches stop once the window is this small, in seconds.
+constexpr double kSearchPrecision = 1e-10;
+// The most turns SettleTime walks through. A spring with a response of 1 ms
+// turns 120000 times in 60 s, so this is a backstop for NaN and other
+// numbers gone wrong; the time limit is what ends an undamped spring.
+constexpr int kMaxSettleTurns = 20000;
+
+double ToSeconds(base::TimeDelta time) {
+  return std::max(0.0, time.InSecondsF());
+}
+
+// The first whole microsecond at or after `seconds`.
+base::TimeDelta CeilToMicroseconds(double seconds) {
+  return base::Microseconds(
+      std::ceil(seconds * base::Time::kMicrosecondsPerSecond));
+}
+
+enum class Damping { kUnder, kCritical, kOver };
+
+Damping DampingOf(const Spring& spring) {
+  const double ratio = spring.damping_ratio();
+  if (std::abs(ratio - 1) < kCriticalTolerance) {
+    return Damping::kCritical;
+  }
+  return ratio < 1 ? Damping::kUnder : Damping::kOver;
+}
+
+// The two decay rates of an overdamped spring, and how much of each the
+// motion holds.
+struct OverdampedTerms {
+  double rate1, rate2;
+  double amount1, amount2;
+};
+
+OverdampedTerms Overdamped(const SpringMotion& m) {
+  const double w = m.spring.AngularFrequency();
+  const double ratio = m.spring.damping_ratio();
+  const double root = std::sqrt(ratio * ratio - 1);
+  OverdampedTerms terms;
+  terms.rate1 = -w * (ratio - root);
+  terms.rate2 = -w * (ratio + root);
+  terms.amount1 =
+      (m.velocity - terms.rate2 * m.offset) / (terms.rate1 - terms.rate2);
+  terms.amount2 = m.offset - terms.amount1;
+  return terms;
+}
+
+double OffsetAtSeconds(const SpringMotion& m, double t) {
+  const double w = m.spring.AngularFrequency();
+  const double ratio = m.spring.damping_ratio();
+  switch (DampingOf(m.spring)) {
+    case Damping::kCritical: {
+      // Written exactly as the space pager always has, so the pager moves
+      // onto this spring without a bit of change.
+      const double rate = m.velocity + w * m.offset;
+      return (m.offset + rate * t) * std::exp(-w * t);
+    }
+    case Damping::kUnder: {
+      const double wd = w * std::sqrt(1 - ratio * ratio);
+      const double b = (m.velocity + ratio * w * m.offset) / wd;
+      return std::exp(-ratio * w * t) *
+             (m.offset * std::cos(wd * t) + b * std::sin(wd * t));
+    }
+    case Damping::kOver: {
+      const OverdampedTerms o = Overdamped(m);
+      return o.amount1 * std::exp(o.rate1 * t) +
+             o.amount2 * std::exp(o.rate2 * t);
+    }
+  }
+}
+
+double VelocityAtSeconds(const SpringMotion& m, double t) {
+  const double w = m.spring.AngularFrequency();
+  const double ratio = m.spring.damping_ratio();
+  switch (DampingOf(m.spring)) {
+    case Damping::kCritical: {
+      const double rate = m.velocity + w * m.offset;
+      return (rate - w * (m.offset + rate * t)) * std::exp(-w * t);
+    }
+    case Damping::kUnder: {
+      const double wd = w * std::sqrt(1 - ratio * ratio);
+      const double b = (m.velocity + ratio * w * m.offset) / wd;
+      const double sine_part = ratio * w * b + m.offset * wd;
+      return std::exp(-ratio * w * t) *
+             (m.velocity * std::cos(wd * t) - sine_part * std::sin(wd * t));
+    }
+    case Damping::kOver: {
+      const OverdampedTerms o = Overdamped(m);
+      return o.amount1 * o.rate1 * std::exp(o.rate1 * t) +
+             o.amount2 * o.rate2 * std::exp(o.rate2 * t);
+    }
+  }
+}
+
+// The first time after `t` at which the velocity is zero, if any.
+std::optional<double> NextTurn(const SpringMotion& m, double t) {
+  const double w = m.spring.AngularFrequency();
+  const double ratio = m.spring.damping_ratio();
+  switch (DampingOf(m.spring)) {
+    case Damping::kCritical: {
+      // v(t) = (v0 - w * rate * t) * exp(-w t) turns at most once.
+      const double rate = m.velocity + w * m.offset;
+      if (rate == 0) {
+        return std::nullopt;
+      }
+      const double turn = m.velocity / (w * rate);
+      return turn > t ? std::optional(turn) : std::nullopt;
+    }
+    case Damping::kOver: {
+      const OverdampedTerms o = Overdamped(m);
+      const double ratio_of_terms =
+          -(o.amount2 * o.rate2) / (o.amount1 * o.rate1);
+      if (!std::isfinite(ratio_of_terms) || ratio_of_terms <= 0) {
+        return std::nullopt;
+      }
+      const double turn = std::log(ratio_of_terms) / (o.rate1 - o.rate2);
+      return turn > t ? std::optional(turn) : std::nullopt;
+    }
+    case Damping::kUnder: {
+      // v(t) is zero where v0 cos(wd t) = s sin(wd t), every pi / wd.
+      const double wd = w * std::sqrt(1 - ratio * ratio);
+      const double b = (m.velocity + ratio * w * m.offset) / wd;
+      const double sine_part = ratio * w * b + m.offset * wd;
+      double phase = std::atan2(m.velocity, sine_part);
+      if (phase <= 0) {
+        phase += std::numbers::pi;
+      }
+      const double half_period = std::numbers::pi / wd;
+      double turn = phase / wd;
+      if (turn <= t) {
+        turn += std::ceil((t - turn) / half_period + kSearchPrecision) *
+                half_period;
+      }
+      return turn;
+    }
+  }
+}
+
+// The smallest time in (lo, hi] for which `done` holds, given it holds at
+// `hi` and, once it holds, keeps holding up to `hi`.
+template <typename Done>
+double Search(double lo, double hi, Done done) {
+  DCHECK(done(hi));
+  while (hi - lo > kSearchPrecision) {
+    const double mid = (lo + hi) / 2;
+    if (done(mid)) {
+      hi = mid;
+    } else {
+      lo = mid;
+    }
+  }
+  return hi;
+}
+
+}  // namespace
+
+double Spring::AngularFrequency() const {
+  return 2 * std::numbers::pi / response_;
+}
+
+double Spring::ValueAt(base::TimeDelta time, double initial_velocity) const {
+  return 1 + SpringMotion{*this, -1, initial_velocity}.OffsetAt(time);
+}
+
+double Spring::VelocityAt(base::TimeDelta time, double initial_velocity) const {
+  return SpringMotion{*this, -1, initial_velocity}.VelocityAt(time);
+}
+
+base::TimeDelta Spring::SettleTime(double epsilon,
+                                   double initial_velocity) const {
+  return SpringMotion{*this, -1, initial_velocity}.SettleTime(epsilon);
+}
+
+base::TimeDelta Spring::TimeToReach(double fraction) const {
+  DCHECK_GT(fraction, 0);
+  DCHECK_LT(fraction, 1);
+  const SpringMotion motion{*this, -1, 0};
+  auto reached = [&](double t) {
+    return 1 + OffsetAtSeconds(motion, t) >= fraction;
+  };
+  // From rest the value only climbs until its first turn.
+  double hi = NextTurn(motion, 0).value_or(response_);
+  const double longest = kLongestSettle.InSecondsF();
+  while (!reached(hi)) {
+    hi *= 2;
+    if (!(hi < longest)) {
+      return kLongestSettle;
+    }
+  }
+  return CeilToMicroseconds(Search(0, hi, reached));
+}
+
+double Spring::Overshoot() const {
+  if (damping_ratio_ >= 1) {
+    return 0;
+  }
+  return std::exp(-damping_ratio_ * std::numbers::pi /
+                  std::sqrt(1 - damping_ratio_ * damping_ratio_));
+}
+
+double SpringMotion::OffsetAt(base::TimeDelta time) const {
+  return OffsetAtSeconds(*this, ToSeconds(time));
+}
+
+double SpringMotion::VelocityAt(base::TimeDelta time) const {
+  return VelocityAtSeconds(*this, ToSeconds(time));
+}
+
+base::TimeDelta SpringMotion::SettleTime(double distance) const {
+  DCHECK_GT(distance, 0);
+  auto settled = [&](double t) {
+    return std::abs(OffsetAtSeconds(*this, t)) <= distance;
+  };
+  // Between two turns the distance from rest falls to zero and climbs to the
+  // next turn, which is nearer rest than the one before. So the motion
+  // settles after the last turn that is still too far out.
+  std::optional<double> last_far;
+  if (!settled(0)) {
+    last_far = 0;
+  }
+  std::optional<double> next = NextTurn(*this, 0);
+  // An undamped spring never settles, so the walk ends at the time limit or
+  // the turn limit, whichever comes first, and reports the limit.
+  const double longest = Spring::kLongestSettle.InSecondsF();
+  int turns = 0;
+  while (next && !settled(*next)) {
+    if (!(*next < longest) || ++turns > kMaxSettleTurns) {
+      return Spring::kLongestSettle;
+    }
+    last_far = *next;
+    next = NextTurn(*this, *next);
+  }
+  if (!last_far) {
+    return base::TimeDelta();
+  }
+  double hi;
+  if (next) {
+    hi = *next;
+  } else {
+    // No more turns: the distance only shrinks from here.
+    hi = *last_far + spring.response();
+    while (!settled(hi)) {
+      hi += spring.response();
+      if (!(hi < longest)) {
+        return Spring::kLongestSettle;
+      }
+    }
+  }
+  return std::min(CeilToMicroseconds(Search(*last_far, hi, settled)),
+                  Spring::kLongestSettle);
+}
+
+base::TimeDelta SpringMotion::RestTime(const RestRule& rule) const {
+  // Layers take float transforms, so rest is judged in float, as the space
+  // pager always has.
+  base::TimeDelta time = rule.step;
+  while (time < rule.longest &&
+         (std::abs(static_cast<float>(OffsetAt(time))) > rule.max_offset ||
+          std::abs(static_cast<float>(VelocityAt(time))) > rule.max_speed)) {
+    time += rule.step;
+  }
+  return time;
+}
+
+SpringMotion SpringMotion::Retarget(base::TimeDelta elapsed,
+                                    double rest_shift) const {
+  return Retarget(elapsed, rest_shift, spring);
+}
+
+SpringMotion SpringMotion::Retarget(base::TimeDelta elapsed,
+                                    double rest_shift,
+                                    const Spring& next) const {
+  return {next, OffsetAt(elapsed) - rest_shift, VelocityAt(elapsed)};
+}
+
+}  // namespace rac

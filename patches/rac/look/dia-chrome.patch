+// Fills the top bar with the page's color, as Dia does, and falls back to
+// the toolbar's normal background in other layouts.
+class TopBarBackground : public views::Background,
+                         public content::WebContentsObserver {
+ public:
+  TopBarBackground(views::View* toolbar, BrowserWindowInterface* browser)
+      : toolbar_(toolbar),
+        browser_(browser),
+        fallback_(std::make_unique<CustomCornersBackground>(
+            *toolbar,
+            *BrowserView::GetBrowserViewForBrowser(browser),
+            CustomCornersBackground::ToolbarTheme(),
+            CustomCornersBackground::FrameTheme())) {}
+  ~TopBarBackground() override = default;
+
+  void SetTab(content::WebContents* tab) {
+    // The toolbar is also updated with no tab, e.g. while tabs move.
+    if (!tab) {
+      if (tabs::TabInterface* active = browser_->GetActiveTabInterface()) {
+        tab = active->GetContents();
+      }
+    }
+    if (tab != web_contents()) {
+      Observe(tab);
+    }
+    Refresh();
+  }
+
+  // The page color while the Top bar layout is on, else nullopt.
+  std::optional<SkColor> GetPageColor() const {
+    return IsTopBar(browser_) ? page_color_ : std::nullopt;
+  }
+
+  // views::Background:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const std::optional<SkColor> color = GetPageColor();
+    if (!color) {
+      fallback_->Paint(canvas, view);
+      return;
+    }
+    const BrowserView* browser_view =
+        BrowserView::GetBrowserViewForBrowser(browser_);
+    if (!browser_view || !IsTopBarOnPageCard(browser_view)) {
+      canvas->DrawColor(*color);
+    } else {
+      const SkScalar r = GetGenericFrameRadius();
+      const SkVector radii[4] = {{r, r}, {r, r}, {0, 0}, {0, 0}};
+      SkRRect rrect;
+      rrect.setRectRadii(gfx::RectToSkRect(view->GetLocalBounds()), radii);
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(*color);
+      canvas->sk_canvas()->drawRRect(rrect, flags);
+    }
+    // Dia's hairline between the bar and the page.
+    const SkColor line = color_utils::IsDark(*color)
+                             ? SkColorSetA(SK_ColorWHITE, 0x1F)
+                             : SkColorSetA(SK_ColorBLACK, 0x14);
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    const float scale = canvas->UndoDeviceScaleFactor();
+    const gfx::RectF bounds =
+        gfx::ScaleRect(gfx::RectF(view->GetLocalBounds()), scale);
+    canvas->FillRect(gfx::ToEnclosingRect(gfx::RectF(
+                         bounds.x(), bounds.bottom() - 1, bounds.width(), 1)),
+                     line);
+  }
+
+  void OnViewThemeChanged(views::View* view) override {
+    fallback_->OnViewThemeChanged(view);
+    Refresh(/*retheme=*/false);
+  }
+
+  // content::WebContentsObserver:
+  void OnBackgroundColorChanged() override { Refresh(); }
+  void DidChangeThemeColor() override { Refresh(); }
+
+ private:
+  void Refresh(bool retheme = true) {
+    std::optional<SkColor> color;
+    if (content::WebContents* tab = web_contents()) {
+      color = tab->GetBackgroundColor();
+      if (!color || SkColorGetA(*color) != SK_AlphaOPAQUE) {
+        color = tab->GetThemeColor();
+      }
+    }
+    if (!color) {
+      if (const ui::ColorProvider* colors = toolbar_->GetColorProvider()) {
+        color = colors->GetColor(kColorToolbar);
+      }
+    }
+    if (color == page_color_) {
+      return;
+    }
+    const bool was_dark = page_color_ && color_utils::IsDark(*page_color_);
+    page_color_ = color;
+    toolbar_->SchedulePaint();
+    // Icons pick their color from GetTopBarForegroundColor() when they
+    // theme, so rerun theming only when the contrast side flips.
+    if (retheme &&
+        was_dark != (page_color_ && color_utils::IsDark(*page_color_)) &&
+        IsTopBar(browser_) && toolbar_->GetWidget()) {
+      toolbar_->GetWidget()->ThemeChanged();
+    }
+  }
+
+  const raw_ptr<views::View> toolbar_;
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<CustomCornersBackground> fallback_;
+  std::optional<SkColor> page_color_;
+};

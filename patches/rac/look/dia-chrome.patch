       features::IsWebUIToolbarEnabled()) {
     return nullptr;
   }
-  return std::make_unique<AssistantButtonHost>(browser);
+  return std::make_unique<ChatButtonHost>(browser);
+}
+
+void UpdateTopBarForContents(views::View* toolbar,
+                             BrowserWindowInterface* browser,
+                             content::WebContents* tab) {
+  if (!toolbar) {
+    return;
+  }
+  TopBarBackground* background = toolbar->GetProperty(kTopBarBackgroundKey);
+  if (!background) {
+    if (!IsTopBar(browser)) {
+      return;
+    }
+    auto owned = std::make_unique<TopBarBackground>(toolbar, browser);
+    background = owned.get();
+    toolbar->SetProperty(kTopBarBackgroundKey, background);
+    toolbar->SetBackground(std::move(owned));
+  }
+  background->SetTab(tab);
+}
+
+std::optional<SkColor> GetTopBarForegroundColor(const views::View* view,
+                                                views::Button::ButtonState state) {
+  for (const views::View* v = view; v; v = v->parent()) {
+    if (const TopBarBackground* background =
+            v->GetProperty(kTopBarBackgroundKey)) {
+      const std::optional<SkColor> page = background->GetPageColor();
+      if (!page) {
+        return std::nullopt;
+      }
+      const SkColor fg = color_utils::IsDark(*page)
+                             ? SkColorSetRGB(0xF5, 0xF5, 0xF5)
+                             : SkColorSetRGB(0x1F, 0x1F, 0x1F);
+      return state == views::Button::STATE_DISABLED
+                 ? SkColorSetA(fg, 0x66)
+                 : fg;
+    }
+  }
+  return std::nullopt;
 }
 

+}
+
+bool IsTopBarSpanningWindow(const BrowserWindowInterface* browser) {
+  if (!IsTopBar(browser)) {
+    return false;
+  }
+  // The sidebar is hidden as in rac::IsSidebarHidden().
+  const PrefService* prefs = browser->GetProfile()->GetPrefs();
+  return prefs->GetBoolean(prefs::kHeliumZenMode) &&
+         !prefs->GetBoolean(prefs::kHeliumZenModeSidebarPinned) &&
+         prefs->GetBoolean(prefs::kHeliumZenModeTopChromePinned);

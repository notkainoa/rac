+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RAC_MOTION_TAB_LIST_MOTION_H_
+#define CHROME_BROWSER_UI_VIEWS_RAC_MOTION_TAB_LIST_MOTION_H_
+
+#include "chrome/browser/ui/views/rac/rac_tokens.h"
+
+namespace gfx {
+class SlideAnimation;
+}
+
+namespace views {
+class View;
+}
+
+// How rows enter and leave the sidebar's tab lists (plan 02, S4 and S5).
+// Chromium's TabCollectionAnimatingLayoutManager does the work; these are
+// its hooks for lists that animate along the vertical axis.
+//
+//  - Rows slide to open or close a gap over tokens::kList.
+//  - A new tab row is in place, fully opaque, at once. Its layer draws it
+//    above the rows sliding down from under it.
+//  - A closing tab row fades over tokens::kFade where it was while the rows
+//    below slide up into its place.
+//  - Under Reduce Motion all of it is instant.
+//
+// Nothing here runs between animations: the layout manager calls these only
+// while a row is entering or leaving, and drops each row's layer once the
+// list is at rest.
+
+namespace rac {
+
+// The slide that opens or closes a gap in the list.
+Timing TabListSlide(bool reduced_motion);
+
+// The fade of a closing row.
+Timing ClosingTabRowFade(bool reduced_motion);
+
+// Sets the list's layout animation to TabListSlide(). Called as each
+// animation starts, so a change to Reduce Motion applies to the next one.
+void UseTabListSlide(gfx::SlideAnimation& animation);
+
+// For a row the list is adding, on each frame of the animation. A row with a
+// layer (a tab row) shows in place at once: returns true, and the caller
+// keeps the row at its final bounds. Returns false for other rows, which
+// keep Chromium's motion.
+bool ShowAddedTabRowInPlace(views::View& row);
+
+// For a row the list is closing, on each frame of the animation. A row with
+// a layer (a tab row) fades out where it is: the first call starts the fade
+// on the compositor, and later calls leave it running, so closing another
+// tab mid-fade never brings the row back. Returns true, and the caller keeps
+// the row at its last bounds. Returns false for other rows, which keep
+// Chromium's motion.
+bool FadeClosingTabRowInPlace(views::View& row);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RAC_MOTION_TAB_LIST_MOTION_H_

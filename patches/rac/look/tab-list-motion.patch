+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/motion/tab_list_motion.h"
+
+#include "base/command_line.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/views/rac/rac_tokens.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/animation/animation.h"
+#include "ui/gfx/animation/slide_animation.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/switches.h"
+#include "ui/views/view.h"
+
+namespace rac {
+namespace {
+
+// Sets Reduce Motion the way --force-prefers-reduced-motion does. The test
+// runs on gtest's own main, without base's test launcher, so it sets up the
+// process's command line itself.
+void SetReduceMotion(bool reduced) {
+  if (!base::CommandLine::InitializedForCurrentProcess()) {
+    base::CommandLine::Init(0, nullptr);
+  }
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  command_line->RemoveSwitch(switches::kForcePrefersReducedMotion);
+  command_line->RemoveSwitch(switches::kForcePrefersNoReducedMotion);
+  command_line->AppendSwitch(reduced ? switches::kForcePrefersReducedMotion
+                                     : switches::kForcePrefersNoReducedMotion);
+}
+
+TEST(TabListMotionTest, SlideIsTheListToken) {
+  const Timing slide = TabListSlide(/*reduced_motion=*/false);
+  EXPECT_EQ(slide.duration, tokens::kList.duration);
+  EXPECT_EQ(slide.curve.tween, tokens::kList.curve.tween);
+  EXPECT_EQ(slide.curve.tween, gfx::Tween::FAST_OUT_SLOW_IN_2);
+}
+
+TEST(TabListMotionTest, CloseFadeIsTheFadeToken) {
+  const Timing fade = ClosingTabRowFade(/*reduced_motion=*/false);
+  EXPECT_EQ(fade.duration, tokens::kFade.duration);
+  EXPECT_EQ(fade.curve.tween, tokens::kFade.curve.tween);
+  EXPECT_EQ(fade.curve.tween, gfx::Tween::EASE_OUT);
+}
+
+TEST(TabListMotionTest, FadeEndsBeforeTheSlide) {
+  // The closing row is gone before the rows below finish sliding over it.
+  EXPECT_LT(ClosingTabRowFade(false).duration, TabListSlide(false).duration);
+}
+
+TEST(TabListMotionTest, ReduceMotionIsInstant) {
+  EXPECT_EQ(TabListSlide(/*reduced_motion=*/true).duration, tokens::kInstant);
+  EXPECT_EQ(ClosingTabRowFade(/*reduced_motion=*/true).duration,
+            tokens::kInstant);
+}
+
+TEST(TabListMotionTest, UseTabListSlideFollowsReduceMotion) {
+  gfx::SlideAnimation animation(nullptr);
+  SetReduceMotion(false);
+  UseTabListSlide(animation);
+  EXPECT_EQ(animation.GetSlideDuration(), tokens::kList.duration);
+  SetReduceMotion(true);
+  UseTabListSlide(animation);
+  EXPECT_EQ(animation.GetSlideDuration(), tokens::kInstant);
+}
+
+TEST(TabListMotionTest, RowsWithoutALayerKeepChromiumsMotion) {
+  views::View row;
+  EXPECT_FALSE(ShowAddedTabRowInPlace(row));
+  EXPECT_FALSE(FadeClosingTabRowInPlace(row));
+  EXPECT_FALSE(row.layer());
+}
+
+TEST(TabListMotionTest, AddedRowIsOpaqueAtOnce) {
+  views::View row;
+  row.SetPaintToLayer();
+  row.layer()->SetOpacity(0.0f);
+  EXPECT_TRUE(ShowAddedTabRowInPlace(row));
+  EXPECT_EQ(row.layer()->opacity(), 1.0f);
+}
+
+TEST(TabListMotionTest, ClosingRowFadesOutUnderReduceMotionAtOnce) {
+  SetReduceMotion(true);
+  views::View row;
+  row.SetPaintToLayer();
+  EXPECT_TRUE(FadeClosingTabRowInPlace(row));
+  EXPECT_EQ(row.layer()->opacity(), 0.0f);
+  // Later frames leave it alone.
+  EXPECT_TRUE(FadeClosingTabRowInPlace(row));
+  EXPECT_EQ(row.layer()->opacity(), 0.0f);
+}
+
+TEST(TabListMotionTest, ClosingRowFadeTargetsZeroAndIsNotRestarted) {
+  SetReduceMotion(false);
+  views::View row;
+  row.SetPaintToLayer();
+  EXPECT_TRUE(FadeClosingTabRowInPlace(row));
+  EXPECT_EQ(row.layer()->GetTargetOpacity(), 0.0f);
+  // A second close mid-fade calls again; the fade keeps its target.
+  EXPECT_TRUE(FadeClosingTabRowInPlace(row));
+  EXPECT_EQ(row.layer()->GetTargetOpacity(), 0.0f);
+}
+
+}  // namespace
+}  // namespace rac

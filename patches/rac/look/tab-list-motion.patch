+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/motion/tab_list_motion.h"
+
+#include "chrome/browser/ui/views/rac/motion/rac_motion.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_animator.h"
+#include "ui/compositor/scoped_layer_animation_settings.h"
+#include "ui/gfx/animation/slide_animation.h"
+#include "ui/views/view.h"
+
+namespace rac {
+
+namespace {
+
+Timing OrInstant(const Timing& timing, bool reduced_motion) {
+  return reduced_motion ? Timing{tokens::kInstant, timing.curve} : timing;
+}
+
+}  // namespace
+
+Timing TabListSlide(bool reduced_motion) {
+  return OrInstant(tokens::kList, reduced_motion);
+}
+
+Timing ClosingTabRowFade(bool reduced_motion) {
+  return OrInstant(tokens::kFade, reduced_motion);
+}
+
+void UseTabListSlide(gfx::SlideAnimation& animation) {
+  const Timing slide = TabListSlide(motion::ReducedMotion());
+  animation.SetSlideDuration(slide.duration);
+  animation.SetTweenType(slide.curve.tween);
+}
+
+bool ShowAddedTabRowInPlace(views::View& row) {
+  ui::Layer* layer = row.layer();
+  if (!layer) {
+    return false;
+  }
+  if (layer->GetTargetOpacity() != 1.0f) {
+    layer->SetOpacity(1.0f);
+  }
+  return true;
+}
+
+bool FadeClosingTabRowInPlace(views::View& row) {
+  ui::Layer* layer = row.layer();
+  if (!layer) {
+    return false;
+  }
+  // Already fading, or faded.
+  if (layer->GetTargetOpacity() == 0.0f) {
+    return true;
+  }
+  const Timing fade = ClosingTabRowFade(motion::ReducedMotion());
+  ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+  settings.SetPreemptionStrategy(
+      ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+  settings.SetTransitionDuration(fade.duration);
+  settings.SetTweenType(fade.curve.tween);
+  layer->SetOpacity(0.0f);
+  return true;
+}
+
+}  // namespace rac

+
+// rac's three ways to run motion tokens natively:
+// - compositor layers: SpringTransformElement, SpringOpacityElement, and
+//   CurveElement, started on a layer's ui::LayerAnimator. Use these for
+//   anything that moves, so it stays smooth while the UI thread is busy.
+// - the UI thread: SpringAnimation, for what has to lay out each frame.
+// - WebUI: the CSS tokens in rac_tokens.css.
+//
+// Nothing here runs or allocates until an animation starts, and nothing
+// keeps the compositor ticking once an animation rests.
+
+namespace rac {
+
+namespace motion {
+
+// Whether the system asks for reduced motion. Read it each time an
+// animation starts, never once in a constructor: the user can change it
+// while rac runs. Under it, slides become tokens::kReducedFade fades and
+// springs jump; gesture tracking may still follow the fingers.
+bool ReducedMotion();
+
+}  // namespace motion
+
+// A UI-thread animation on a spring, shaped like gfx::SlideAnimation: Show()
+// heads for 1 and Hide() for 0. A new target while moving keeps the current
+// place and speed, so reversing Cmd+S mid-slide doesn't jolt. Under a ratio
+// below 1 the value passes its target briefly.
+//
+// Prefer a compositor element; use this only for what must lay out every
+// frame.
+class SpringAnimation : public gfx::Animation {
+ public:
+  // `distance` is how many DIPs a change of 1 in the value moves something.
+  // Rest is judged in those DIPs, by tokens::kSpringRest.
+  SpringAnimation(gfx::AnimationDelegate* delegate,
+                  const Spring& spring,
+                  float distance);
+  SpringAnimation(const SpringAnimation&) = delete;
+  SpringAnimation& operator=(const SpringAnimation&) = delete;
+  ~SpringAnimation() override;
+
+  void Show();
+  void Hide();
+  // Heads for `target` from the value and speed it has now. Under reduced
+  // motion it jumps there instead.
+  void SetTarget(double target);
+  // The same on another spring, such as tokens::kSpringExit for an exit.
+  void SetTarget(double target, const Spring& spring);
+  // Heads for `target` starting at `velocity`, in values per second, as a
+  // swipe hands over its speed.
+  void SetTargetWithVelocity(double target, double velocity);
+  // Jumps to `value` and stops.
+  void Reset(double value);
+
+  bool IsShowing() const { return target_ == 1; }
+  double target() const { return target_; }
+  // In values per second.
+  double GetCurrentVelocity() const;
+
+  // gfx::Animation:
+  double GetCurrentValue() const override;
+
+ protected:
+  // gfx::Animation:
+  void Step(base::TimeTicks now) override;
+
+ private:
+  void Begin(double target,
+             const Spring& spring,
+             std::optional<double> velocity);
+  // The motion's offset and speed at `now`, in DIPs from `target_`.
+  SpringMotion MotionAt(base::TimeTicks now) const;
+
+  Spring spring_;
+  const float distance_;
+  double target_ = 0;
+  double value_ = 0;
+  // In DIPs from `target_`, started at `motion_start_`.
+  SpringMotion motion_{spring_};
+  base::TimeTicks motion_start_;
+  base::TimeDelta rest_time_;
+};
+
+// What rac's compositor elements share: the curve runs on the compositor
+// thread, which picks the start time on its first frame, and the UI thread
+// only hears about the end. Chromium's own threaded elements aren't public.
+class CompositorElement : public ui::LayerAnimationElement {
+ public:
+  CompositorElement(const CompositorElement&) = delete;
+  CompositorElement& operator=(const CompositorElement&) = delete;
+  ~CompositorElement() override;
+
+  // ui::LayerAnimationElement:
+  bool IsThreaded(ui::LayerAnimationDelegate* delegate) const override;
+
+ protected:
+  // Only a TRANSFORM or OPACITY element runs on the compositor.
+  CompositorElement(AnimatableProperty property, base::TimeDelta duration);
+
+  AnimatableProperty property() const { return property_; }
+
+  // How long the compositor has been running the curve; zero until its first
+  // frame.
+  base::TimeDelta Elapsed() const;
+
+  // The curve for the compositor, from what OnStart() read off the layer.
+  virtual std::unique_ptr<gfx::AnimationCurve> CreateCurve() const = 0;
+  // Sets the layer where the curve has it after `elapsed`, when an abort
+  // leaves it there.
+  virtual void SetAt(base::TimeDelta elapsed,
+                     ui::LayerAnimationDelegate* delegate) = 0;
+  // Sets the layer to where the curve ends.
+  virtual void SetEnd(ui::LayerAnimationDelegate* delegate) = 0;
+
+  // ui::LayerAnimationElement:
+  bool OnProgress(double t, ui::LayerAnimationDelegate* delegate) override;
+  void OnAbort(ui::LayerAnimationDelegate* delegate) override;
+  void RequestEffectiveStart(ui::LayerAnimationDelegate* delegate) override;
+
+ private:
+  void RemoveFromCompositor(ui::LayerAnimationDelegate* delegate);
+
+  const AnimatableProperty property_;
+};
+
+// Slides a layer on the compositor thread until it rests at `rest`: the
+// space pager's element, made general. It starts `motion.offset` DIPs from
+// rest along `axis`, moving at `motion.velocity`, and ends once
+// tokens::kSpringRest holds. Every frame changes only the layer's transform.
+//
+// To retarget, read GetOffset() and GetVelocity(), then start a new element
+// from them; the layer's animator replaces the old one.
+class SpringTransformElement : public CompositorElement {
+ public:
+  enum class Axis { kX, kY };
+
+  SpringTransformElement(const SpringMotion& motion,
+                         const gfx::Vector2dF& rest,
+                         Axis axis);
+  SpringTransformElement(const SpringTransformElement&) = delete;
+  SpringTransformElement& operator=(const SpringTransformElement&) = delete;
+  ~SpringTransformElement() override;
+
+  // Moves and scales a layer from `from` to `to` on the spring's progress,
+  // for Peek growing out of a link. Both are 2D translate-and-scale
+  // transforms; the layer's contents keep their final size.
+  // `initial_velocity` is in moves per second toward `to`.
+  static std::unique_ptr<SpringTransformElement> CreateBlend(
+      const Spring& spring,
+      const gfx::Transform& from,
+      const gfx::Transform& to,
+      double initial_velocity = 0);
+
+  // Where the compositor has the layer now, as DIPs from rest along the
+  // axis, and how fast it's moving. For a blend they're in moves: the offset
+  // runs from -1 to 0.
+  float GetOffset() const;
+  float GetVelocity() const;
+
+  // The layer's transform `elapsed` into the run.
+  gfx::Transform TransformAt(base::TimeDelta elapsed) const;
+
+ protected:
+  // CompositorElement:
+  std::unique_ptr<gfx::AnimationCurve> CreateCurve() const override;
+  void SetAt(base::TimeDelta elapsed,
+             ui::LayerAnimationDelegate* delegate) override;
+  void SetEnd(ui::LayerAnimationDelegate* delegate) override;
+
+  // ui::LayerAnimationElement:
+  std::string DebugName() const override;
+  void OnStart(ui::LayerAnimationDelegate* delegate) override;
+  void OnGetTarget(TargetValue* target) const override;
+
+ private:
+  SpringTransformElement(const SpringMotion& motion,
+                         const gfx::Transform& from,
+                         const gfx::Transform& to);
+
+  const SpringMotion motion_;
+  const bool blend_;
+  const gfx::Vector2dF rest_;
+  const Axis axis_;
+  const gfx::Transform from_;
+  const gfx::Transform to_;
+};
+
+// Fades a layer from `from` to `to` on a spring's progress, on the
+// compositor thread. The opacity stays within 0 and 1 even if the spring
+// passes its target.
+class SpringOpacityElement : public CompositorElement {
+ public:
+  SpringOpacityElement(const Spring& spring,
+                       float from,
+                       float to,
+                       double initial_velocity = 0);
+  SpringOpacityElement(const SpringOpacityElement&) = delete;
+  SpringOpacityElement& operator=(const SpringOpacityElement&) = delete;
+  ~SpringOpacityElement() override;
+
+  float OpacityAt(base::TimeDelta elapsed) const;
+
+ protected:
+  // CompositorElement:
+  std::unique_ptr<gfx::AnimationCurve> CreateCurve() const override;
+  void SetAt(base::TimeDelta elapsed,
+             ui::LayerAnimationDelegate* delegate) override;
+  void SetEnd(ui::LayerAnimationDelegate* delegate) override;
+
+  // ui::LayerAnimationElement:
+  std::string DebugName() const override;
+  void OnStart(ui::LayerAnimationDelegate* delegate) override;
+  void OnGetTarget(TargetValue* target) const override;
+
+ private:
+  // A unit move from 0 to 1.
+  const SpringMotion motion_;
+  const float from_;
+  const float to_;
+};
+
+// Runs a property over a rac::Timing with its bezier as recorded, which
+// gfx::Tween can't always hold (kEaseExpo). It starts from the layer's
+// value when it starts. Opacity and transforms run on the compositor thread;
+// a clip rect and rounded corners run on the UI thread, as Chromium's own
+// elements for them do.
+class CurveElement : public CompositorElement {
+ public:
+  static std::unique_ptr<CurveElement> CreateOpacity(float to,
+                                                     const Timing& timing);
+  static std::unique_ptr<CurveElement> CreateTransform(
+      const gfx::Transform& to,
+      const Timing& timing);
+  // The command bar growing out of the address field.
+  static std::unique_ptr<CurveElement> CreateClipRect(const gfx::Rect& to,
+                                                      const Timing& timing);
+  static std::unique_ptr<CurveElement> CreateRoundedCorners(
+      const gfx::RoundedCornersF& to,
+      const Timing& timing);
+
+  CurveElement(const CurveElement&) = delete;
+  CurveElement& operator=(const CurveElement&) = delete;
+  ~CurveElement() override;
+
+  // ui::LayerAnimationElement:
+  bool IsThreaded(ui::LayerAnimationDelegate* delegate) const override;
+
+ protected:
+  // CompositorElement:
+  std::unique_ptr<gfx::AnimationCurve> CreateCurve() const override;
+  void SetAt(base::TimeDelta elapsed,
+             ui::LayerAnimationDelegate* delegate) override;
+  void SetEnd(ui::LayerAnimationDelegate* delegate) override;
+
+  // ui::LayerAnimationElement:
+  std::string DebugName() const override;
+  void OnStart(ui::LayerAnimationDelegate* delegate) override;
+  bool OnProgress(double t, ui::LayerAnimationDelegate* delegate) override;
+  void OnGetTarget(TargetValue* target) const override;
+
+ private:
+  CurveElement(AnimatableProperty property,
+               const TargetValue& to,
+               const Timing& timing);
+
+  // Sets the property at `fraction` of the way from the start to the end.
+  void SetFraction(double fraction, ui::LayerAnimationDelegate* delegate);
+
+  const TargetValue to_;
+  TargetValue from_;
+  const Curve curve_;
+};
+
+}  // namespace rac

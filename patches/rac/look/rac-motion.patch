+namespace rac {
+
+namespace {
+
+// A move from 0 to 1 rests as a slide this many DIPs long would under
+// tokens::kSpringRest: within 0.25 DIP of 300 and slower than 15 DIP/s.
+constexpr double kUnitMoveDips = 300;
+
+RestRule UnitRest() {
+  RestRule rule = tokens::kSpringRest;
+  rule.max_offset /= kUnitMoveDips;
+  rule.max_speed /= kUnitMoveDips;
+  return rule;
+}
+
+// A curve the compositor runs by asking `value` for each frame. The callback
+// holds only copies of plain values, so the compositor thread can run it.
+template <typename Base, typename T>
+class FunctionCurve : public Base {
+ public:
+  using Function = base::RepeatingCallback<T(base::TimeDelta)>;
+
+  FunctionCurve(base::TimeDelta duration,
+                Function value,
+                std::optional<float> maximum_scale = std::nullopt)
+      : duration_(duration),
+        value_(std::move(value)),
+        maximum_scale_(maximum_scale) {}
+  FunctionCurve(const FunctionCurve&) = default;
+  FunctionCurve& operator=(const FunctionCurve&) = delete;
+  ~FunctionCurve() override = default;
+
+  // gfx::AnimationCurve:
+  base::TimeDelta Duration() const override { return duration_; }
+  std::unique_ptr<gfx::AnimationCurve> Clone() const override {
+    return std::make_unique<FunctionCurve>(*this);
+  }
+  bool MaximumScale(float* max_scale) const override {
+    if (!maximum_scale_) {
+      return false;
+    }
+    *max_scale = *maximum_scale_;
+    return true;
+  }
+  T GetValue(base::TimeDelta t) const override { return value_.Run(t); }
+  T GetTransformedValue(
+      base::TimeDelta t,
+      gfx::TimingFunction::LimitDirection limit_direction) const override {
+    return GetValue(t);
+  }
+
+ private:
+  const base::TimeDelta duration_;
+  const Function value_;
+  const std::optional<float> maximum_scale_;
+};
+
+using TransformCurve =
+    FunctionCurve<gfx::TransformAnimationCurve, gfx::TransformOperations>;
+using OpacityCurve = FunctionCurve<gfx::FloatAnimationCurve, float>;
+
+gfx::TransformOperations ToOperations(const gfx::Transform& transform) {
+  gfx::TransformOperations operations;
+  operations.AppendMatrix(transform);
+  return operations;
+}
+
+// Translates by `rest` plus `offset` along `axis`. Additions stay in float,
+// as the space pager's always were.
+gfx::Transform Along(SpringTransformElement::Axis axis,
+                     const gfx::Vector2dF& rest,
+                     float offset) {
+  return axis == SpringTransformElement::Axis::kX
+             ? gfx::Transform::MakeTranslation(rest.x() + offset, rest.y())
+             : gfx::Transform::MakeTranslation(rest.x(), rest.y() + offset);
+}
+
+// Translate and scale `progress` of the way from `from` to `to`. Unlike
+// gfx::Tween, it follows a spring past 1.
+gfx::Transform Blend(const gfx::Transform& from,
+                     const gfx::Transform& to,
+                     double progress) {
+  const gfx::Vector2dF translate =
+      from.To2dTranslation() +
+      gfx::ScaleVector2d(to.To2dTranslation() - from.To2dTranslation(),
+                         progress);
+  const gfx::Vector2dF scale =
+      from.To2dScale() +
+      gfx::ScaleVector2d(to.To2dScale() - from.To2dScale(), progress);
+  gfx::Transform transform =
+      gfx::Transform::MakeTranslation(translate.x(), translate.y());
+  transform.Scale(scale.x(), scale.y());
+  return transform;
+}
+
+gfx::TransformOperations SpringTranslationAt(
+    const SpringMotion& motion,
+    base::TimeDelta duration,
+    const gfx::Vector2dF& rest,
+    SpringTransformElement::Axis axis,
+    base::TimeDelta t) {
+  const float offset =
+      t >= duration ? 0 : static_cast<float>(motion.OffsetAt(t));
+  gfx::TransformOperations operations;
+  if (axis == SpringTransformElement::Axis::kX) {
+    operations.AppendTranslate(rest.x() + offset, rest.y(), 0);
+  } else {
+    operations.AppendTranslate(rest.x(), rest.y() + offset, 0);
+  }
+  return operations;
+}
+
+// How far past rest `motion` goes. A fast start carries even a critically
+// damped spring past rest, so it's sampled rather than read off the spring.
+double PeakOvershoot(const SpringMotion& motion, base::TimeDelta duration) {
+  double peak = 0;
+  for (base::TimeDelta t; t < duration; t += base::Hertz(240)) {
+    peak = std::max(peak, motion.OffsetAt(t));
+  }
+  return peak;
+}
+
+gfx::TransformOperations SpringBlendAt(const SpringMotion& motion,
+                                       base::TimeDelta duration,
+                                       const gfx::Transform& from,
+                                       const gfx::Transform& to,
+                                       base::TimeDelta t) {
+  const double progress = t >= duration ? 1 : 1 + motion.OffsetAt(t);
+  return ToOperations(Blend(from, to, progress));
+}
+
+float SpringOpacityAt(const SpringMotion& motion,
+                      base::TimeDelta duration,
+                      float from,
+                      float to,
+                      base::TimeDelta t) {
+  const double progress = t >= duration ? 1 : 1 + motion.OffsetAt(t);
+  return std::clamp(
+      static_cast<float>(from + (to - from) * progress), 0.0f, 1.0f);
+}
+
+// How far along `curve` is at `linear`, a fraction of its time.
+double CurveAt(const Curve& curve, double linear) {
+  if (linear >= 1) {
+    return 1;
+  }
+  return gfx::CubicBezier(curve.x1, curve.y1, curve.x2, curve.y2)
+      .Solve(std::max(0.0, linear));
+}
+
+double CurveFraction(const Curve& curve,
+                     base::TimeDelta duration,
+                     base::TimeDelta t) {
+  return duration.is_positive() ? CurveAt(curve, t / duration) : 1;
+}
+
+float CurveOpacityAt(const Curve& curve,
+                     base::TimeDelta duration,
+                     float from,
+                     float to,
+                     base::TimeDelta t) {
+  return gfx::Tween::FloatValueBetween(CurveFraction(curve, duration, t), from,
+                                       to);
+}
+
+gfx::TransformOperations CurveTransformAt(const Curve& curve,
+                                          base::TimeDelta duration,
+                                          const gfx::Transform& from,
+                                          const gfx::Transform& to,
+                                          base::TimeDelta t) {
+  return ToOperations(gfx::Tween::TransformValueBetween(
+      CurveFraction(curve, duration, t), from, to));
+}
+
+}  // namespace
+
+namespace motion {
+
+bool ReducedMotion() {
+  // gfx::Animation refreshes this when the system setting changes, and
+  // --force-prefers-reduced-motion overrides it.
+  return gfx::Animation::PrefersReducedMotion();
+}
+
+}  // namespace motion
+
+// SpringAnimation.
+
+SpringAnimation::SpringAnimation(gfx::AnimationDelegate* delegate,
+                                 const Spring& spring,
+                                 float distance)
+    // Views' CompositorAnimationRunner steps it at the display's rate; this
+    // interval is only the fallback timer's.
+    : gfx::Animation(base::Hertz(gfx::LinearAnimation::kDefaultFrameRate)),
+      spring_(spring),
+      distance_(distance) {
+  set_delegate(delegate);
+}
+
+SpringAnimation::~SpringAnimation() = default;
+
+void SpringAnimation::Show() {
+  SetTarget(1);
+}
+
+void SpringAnimation::Hide() {
+  SetTarget(0);
+}
+
+void SpringAnimation::SetTarget(double target) {
+  Begin(target, spring_, std::nullopt);
+}
+
+void SpringAnimation::SetTarget(double target, const Spring& spring) {
+  Begin(target, spring, std::nullopt);
+}
+
+void SpringAnimation::SetTargetWithVelocity(double target, double velocity) {
+  Begin(target, spring_, velocity);
+}
+
+void SpringAnimation::Reset(double value) {
+  target_ = value;
+  value_ = value;
+  motion_ = {spring_};
+  Stop();
+}
+
+double SpringAnimation::GetCurrentVelocity() const {
+  if (!is_animating()) {
+    return 0;
+  }
+  return MotionAt(base::TimeTicks::Now()).velocity / distance_;
+}
+
+double SpringAnimation::GetCurrentValue() const {
+  return value_;
+}
+
+void SpringAnimation::Step(base::TimeTicks now) {
+  const base::TimeDelta elapsed = now - motion_start_;
+  const bool done = elapsed >= rest_time_;
+  value_ = done ? target_ : target_ + motion_.OffsetAt(elapsed) / distance_;
+  if (delegate()) {
+    delegate()->AnimationProgressed(this);
+  }
+  // The delegate may have set a new target, which starts a new motion.
+  if (done && now - motion_start_ >= rest_time_) {
+    Stop();
+  }
+}
+
+void SpringAnimation::Begin(double target,
+                            const Spring& spring,
+                            std::optional<double> velocity) {
+  if (motion::ReducedMotion() || distance_ <= 0) {
+    // A jump, which ends at once, as gfx::SlideAnimation's does.
+    const bool was_animating = is_animating();
+    spring_ = spring;
+    target_ = target;
+    value_ = target;
+    if (delegate()) {
+      delegate()->AnimationProgressed(this);
+    }
+    if (was_animating) {
+      Stop();
+    } else if (delegate()) {
+      delegate()->AnimationEnded(this);
+    }
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const SpringMotion current = MotionAt(now);
+  // Where the value is now, in DIPs from the new target, at its speed now.
+  motion_ = current.Retarget(base::TimeDelta(), (target - target_) * distance_,
+                             spring);
+  if (velocity) {
+    motion_.velocity = *velocity * distance_;
+  }
+  spring_ = spring;
+  target_ = target;
+  motion_start_ = now;
+  rest_time_ = motion_.RestTime(tokens::kSpringRest);
+  if (!is_animating()) {
+    Start();
+  }
+}
+
+SpringMotion SpringAnimation::MotionAt(base::TimeTicks now) const {
+  if (!is_animating()) {
+    return {spring_, (value_ - target_) * distance_, 0};
+  }
+  const base::TimeDelta elapsed = now - motion_start_;
+  return {spring_, motion_.OffsetAt(elapsed), motion_.VelocityAt(elapsed)};
+}
+
+// CompositorElement.
+
+CompositorElement::CompositorElement(AnimatableProperty property,
+                                     base::TimeDelta duration)
+    : ui::LayerAnimationElement(property, duration), property_(property) {}
+
+CompositorElement::~CompositorElement() = default;
+
+bool CompositorElement::IsThreaded(ui::LayerAnimationDelegate* delegate) const {
+  return duration().is_positive();
+}
+
+base::TimeDelta CompositorElement::Elapsed() const {
+  const base::TimeTicks start = effective_start_time();
+  return start.is_null() ? base::TimeDelta() : base::TimeTicks::Now() - start;
+}
+
+bool CompositorElement::OnProgress(double t,
+                                   ui::LayerAnimationDelegate* delegate) {
+  if (t < 1.0) {
+    return false;
+  }
+  RemoveFromCompositor(delegate);
+  SetEnd(delegate);
+  return true;
+}
+
+void CompositorElement::OnAbort(ui::LayerAnimationDelegate* delegate) {
+  if (!delegate || !Started() || !IsThreaded(delegate)) {
+    return;
+  }
+  RemoveFromCompositor(delegate);
+  SetAt(Elapsed(), delegate);
+}
+
+void CompositorElement::RequestEffectiveStart(
+    ui::LayerAnimationDelegate* delegate) {
+  if (!IsThreaded(delegate)) {
+    set_effective_start_time(requested_start_time());
+    return;
+  }
+  // The compositor sets the real start time when it first ticks the curve.
+  set_effective_start_time(base::TimeTicks());
+  // A new id, so a model isn't removed and added under one id in a frame.
+  UpdateKeyframeModelId();
+  const cc::TargetProperty::Type property =
+      property_ == TRANSFORM ? cc::TargetProperty::TRANSFORM
+                             : cc::TargetProperty::OPACITY;
+  std::unique_ptr<cc::KeyframeModel> keyframe_model = cc::KeyframeModel::Create(
+      CreateCurve(), keyframe_model_id(), animation_group_id(),
+      cc::KeyframeModel::TargetPropertyId(property));
+  keyframe_model->set_needs_synchronized_start_time(true);
+  delegate->GetThreadedAnimationDelegate()->AddThreadedAnimation(
+      std::move(keyframe_model));
+}
+
+void CompositorElement::RemoveFromCompositor(
+    ui::LayerAnimationDelegate* delegate) {
+  if (Started() && IsThreaded(delegate)) {
+    delegate->GetThreadedAnimationDelegate()->RemoveThreadedAnimation(
+        keyframe_model_id());
+  }
+}
+
+// SpringTransformElement.
+
+SpringTransformElement::SpringTransformElement(const SpringMotion& motion,
+                                               const gfx::Vector2dF& rest,
+                                               Axis axis)
+    : CompositorElement(TRANSFORM, motion.RestTime(tokens::kSpringRest)),
+      motion_(motion),
+      blend_(false),
+      rest_(rest),
+      axis_(axis) {}
+
+SpringTransformElement::SpringTransformElement(const SpringMotion& motion,
+                                               const gfx::Transform& from,
+                                               const gfx::Transform& to)
+    : CompositorElement(TRANSFORM, motion.RestTime(UnitRest())),
+      motion_(motion),
+      blend_(true),
+      axis_(Axis::kX),
+      from_(from),
+      to_(to) {
+  DCHECK(from.IsScaleOrTranslation());
+  DCHECK(to.IsScaleOrTranslation());
+}
+
+SpringTransformElement::~SpringTransformElement() = default;
+
+// static
+std::unique_ptr<SpringTransformElement> SpringTransformElement::CreateBlend(
+    const Spring& spring,
+    const gfx::Transform& from,
+    const gfx::Transform& to,
+    double initial_velocity) {
+  return base::WrapUnique(new SpringTransformElement(
+      SpringMotion{spring, -1, initial_velocity}, from, to));
+}
+
+float SpringTransformElement::GetOffset() const {
+  const base::TimeTicks start = effective_start_time();
+  return start.is_null() ? static_cast<float>(motion_.offset)
+                         : static_cast<float>(motion_.OffsetAt(
+                               base::TimeTicks::Now() - start));
+}
+
+float SpringTransformElement::GetVelocity() const {
+  return static_cast<float>(motion_.VelocityAt(Elapsed()));
+}
+
+gfx::Transform SpringTransformElement::TransformAt(
+    base::TimeDelta elapsed) const {
+  if (blend_) {
+    return Blend(from_, to_,
+                 elapsed >= duration() ? 1 : 1 + motion_.OffsetAt(elapsed));
+  }
+  return Along(axis_, rest_,
+               elapsed >= duration()
+                   ? 0
+                   : static_cast<float>(motion_.OffsetAt(elapsed)));
+}
+
+std::unique_ptr<gfx::AnimationCurve> SpringTransformElement::CreateCurve()
+    const {
+  if (blend_) {
+    const float maximum_scale = std::max(
+        {from_.To2dScale().x(), from_.To2dScale().y(), to_.To2dScale().x(),
+         to_.To2dScale().y()});
+    return std::make_unique<TransformCurve>(
+        duration(),
+        base::BindRepeating(&SpringBlendAt, motion_, duration(), from_, to_),
+        maximum_scale * (1 + PeakOvershoot(motion_, duration())));
+  }
+  return std::make_unique<TransformCurve>(
+      duration(),
+      base::BindRepeating(&SpringTranslationAt, motion_, duration(), rest_,
+                          axis_),
+      1.0f);
+}
+
+void SpringTransformElement::SetAt(base::TimeDelta elapsed,
+                                   ui::LayerAnimationDelegate* delegate) {
+  // Where an abort leaves the layer, past the end included, as the space
+  // pager always has.
+  const gfx::Transform transform =
+      blend_ ? Blend(from_, to_, 1 + motion_.OffsetAt(elapsed))
+             : Along(axis_, rest_,
+                     static_cast<float>(motion_.OffsetAt(elapsed)));
+  delegate->SetTransformFromAnimation(transform,
+                                      ui::PropertyChangeReason::FROM_ANIMATION);
+}
+
+void SpringTransformElement::SetEnd(ui::LayerAnimationDelegate* delegate) {
+  delegate->SetTransformFromAnimation(blend_ ? to_ : Along(axis_, rest_, 0),
+                                      ui::PropertyChangeReason::FROM_ANIMATION);
+}
+
+std::string SpringTransformElement::DebugName() const {
+  return "RacSpringTransform";
+}
+
+void SpringTransformElement::OnStart(ui::LayerAnimationDelegate* delegate) {
+  delegate->SetTransformFromAnimation(
+      blend_ ? from_ : Along(axis_, rest_, static_cast<float>(motion_.offset)),
+      ui::PropertyChangeReason::FROM_ANIMATION);
+}
+
+void SpringTransformElement::OnGetTarget(TargetValue* target) const {
+  target->transform = blend_ ? to_ : Along(axis_, rest_, 0);
+}
+
+// SpringOpacityElement.
+
+SpringOpacityElement::SpringOpacityElement(const Spring& spring,
+                                           float from,
+                                           float to,
+                                           double initial_velocity)
+    : CompositorElement(OPACITY,
+                        from == to ? base::TimeDelta()
+                                   : SpringMotion{spring, -1, initial_velocity}
+                                         .RestTime(UnitRest())),
+      motion_{spring, -1, initial_velocity},
+      from_(from),
+      to_(to) {}
+
+SpringOpacityElement::~SpringOpacityElement() = default;
+
+float SpringOpacityElement::OpacityAt(base::TimeDelta elapsed) const {
+  return SpringOpacityAt(motion_, duration(), from_, to_, elapsed);
+}
+
+std::unique_ptr<gfx::AnimationCurve> SpringOpacityElement::CreateCurve()
+    const {
+  return std::make_unique<OpacityCurve>(
+      duration(),
+      base::BindRepeating(&SpringOpacityAt, motion_, duration(), from_, to_));
+}
+
+void SpringOpacityElement::SetAt(base::TimeDelta elapsed,
+                                 ui::LayerAnimationDelegate* delegate) {
+  delegate->SetOpacityFromAnimation(OpacityAt(elapsed),
+                                    ui::PropertyChangeReason::FROM_ANIMATION);
+}
+
+void SpringOpacityElement::SetEnd(ui::LayerAnimationDelegate* delegate) {
+  delegate->SetOpacityFromAnimation(to_,
+                                    ui::PropertyChangeReason::FROM_ANIMATION);
+}
+
+std::string SpringOpacityElement::DebugName() const {
+  return "RacSpringOpacity";
+}
+
+void SpringOpacityElement::OnStart(ui::LayerAnimationDelegate* delegate) {
+  delegate->SetOpacityFromAnimation(from_,
+                                    ui::PropertyChangeReason::FROM_ANIMATION);
+}
+
+void SpringOpacityElement::OnGetTarget(TargetValue* target) const {
+  target->opacity = to_;
+}
+
+// CurveElement.
+
+// static
+std::unique_ptr<CurveElement> CurveElement::CreateOpacity(
+    float to,
+    const Timing& timing) {
+  TargetValue target;
+  target.opacity = to;
+  return base::WrapUnique(new CurveElement(OPACITY, target, timing));
+}
+
+// static
+std::unique_ptr<CurveElement> CurveElement::CreateTransform(
+    const gfx::Transform& to,
+    const Timing& timing) {
+  TargetValue target;
+  target.transform = to;
+  return base::WrapUnique(new CurveElement(TRANSFORM, target, timing));
+}
+
+// static
+std::unique_ptr<CurveElement> CurveElement::CreateClipRect(
+    const gfx::Rect& to,
+    const Timing& timing) {
+  TargetValue target;
+  target.clip_rect = to;
+  return base::WrapUnique(new CurveElement(CLIP, target, timing));
+}
+
+// static
+std::unique_ptr<CurveElement> CurveElement::CreateRoundedCorners(
+    const gfx::RoundedCornersF& to,
+    const Timing& timing) {
+  TargetValue target;
+  target.rounded_corners = to;
+  return base::WrapUnique(new CurveElement(ROUNDED_CORNERS, target, timing));
+}
+
+CurveElement::CurveElement(AnimatableProperty property,
+                           const TargetValue& to,
+                           const Timing& timing)
+    : CompositorElement(property, timing.duration),
+      to_(to),
+      curve_(timing.curve) {}
+
+CurveElement::~CurveElement() = default;
+
+bool CurveElement::IsThreaded(ui::LayerAnimationDelegate* delegate) const {
+  return (property() == OPACITY || property() == TRANSFORM) &&
+         CompositorElement::IsThreaded(delegate);
+}
+
+std::unique_ptr<gfx::AnimationCurve> CurveElement::CreateCurve() const {
+  if (property() == OPACITY) {
+    return std::make_unique<OpacityCurve>(
+        duration(), base::BindRepeating(&CurveOpacityAt, curve_, duration(),
+                                        from_.opacity, to_.opacity));
+  }
+  DCHECK_EQ(property(), TRANSFORM);
+  return std::make_unique<TransformCurve>(
+      duration(), base::BindRepeating(&CurveTransformAt, curve_, duration(),
+                                      from_.transform, to_.transform));
+}
+
+void CurveElement::SetAt(base::TimeDelta elapsed,
+                         ui::LayerAnimationDelegate* delegate) {
+  SetFraction(CurveFraction(curve_, duration(), elapsed), delegate);
+}
+
+void CurveElement::SetEnd(ui::LayerAnimationDelegate* delegate) {
+  SetFraction(1, delegate);
+}
+
+std::string CurveElement::DebugName() const {
+  return "RacCurve";
+}
+
+void CurveElement::OnStart(ui::LayerAnimationDelegate* delegate) {
+  from_ = TargetValue(delegate);
+}
+
+bool CurveElement::OnProgress(double t, ui::LayerAnimationDelegate* delegate) {
+  if (IsThreaded(delegate)) {
+    return CompositorElement::OnProgress(t, delegate);
+  }
+  // `t` is linear: the element's own tween is never set.
+  SetFraction(CurveAt(curve_, t), delegate);
+  return true;
+}
+
+void CurveElement::OnGetTarget(TargetValue* target) const {
+  switch (property()) {
+    case OPACITY:
+      target->opacity = to_.opacity;
+      return;
+    case TRANSFORM:
+      target->transform = to_.transform;
+      return;
+    case CLIP:
+      target->clip_rect = to_.clip_rect;
+      return;
+    case ROUNDED_CORNERS:
+      target->rounded_corners = to_.rounded_corners;
+      return;
+    default:
+      NOTREACHED();
+  }
+}
+
+void CurveElement::SetFraction(double fraction,
+                               ui::LayerAnimationDelegate* delegate) {
+  constexpr auto kReason = ui::PropertyChangeReason::FROM_ANIMATION;
+  switch (property()) {
+    case OPACITY:
+      delegate->SetOpacityFromAnimation(
+          gfx::Tween::FloatValueBetween(fraction, from_.opacity, to_.opacity),
+          kReason);
+      return;
+    case TRANSFORM:
+      delegate->SetTransformFromAnimation(
+          gfx::Tween::TransformValueBetween(fraction, from_.transform,
+                                            to_.transform),
+          kReason);
+      return;
+    case CLIP:
+      delegate->SetClipRectFromAnimation(
+          gfx::Tween::RectValueBetween(fraction, from_.clip_rect,
+                                       to_.clip_rect),
+          kReason);
+      return;
+    case ROUNDED_CORNERS:
+      delegate->SetRoundedCornersFromAnimation(
+          gfx::RoundedCornersF(
+              gfx::Tween::FloatValueBetween(fraction,
+                                            from_.rounded_corners.upper_left(),
+                                            to_.rounded_corners.upper_left()),
+              gfx::Tween::FloatValueBetween(fraction,
+                                            from_.rounded_corners.upper_right(),
+                                            to_.rounded_corners.upper_right()),
+              gfx::Tween::FloatValueBetween(fraction,
+                                            from_.rounded_corners.lower_right(),
+                                            to_.rounded_corners.lower_right()),
+              gfx::Tween::FloatValueBetween(fraction,
+                                            from_.rounded_corners.lower_left(),
+                                            to_.rounded_corners.lower_left())),
+          kReason);
+      return;
+    default:
+      NOTREACHED();
+  }
+}
+
+}  // namespace rac

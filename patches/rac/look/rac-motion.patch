+// Expected values come from spring_ref.py, a standard-library reference that
+// checks its closed forms against a numerical solution. Times are in
+// microseconds and are the first whole microsecond at or after the exact
+// time.
+struct TableRow {
+  const char* name;
+  Spring spring;
+  int64_t ninety_percent_us;
+  int64_t within_one_percent_us;
+  double overshoot;
+  // The design table, in milliseconds. Timings must stay within 1 ms of it.
+  int table_ninety_percent_ms;
+  int table_within_one_percent_ms;
+};
+
+constexpr TableRow kTable[] = {
+    {"kSpringPage", tokens::kSpringPage, 154768, 264132, 0, 155, 264},
+    {"kSpringDock", tokens::kSpringDock, 101361, 142045, 0.006288, 101, 142},
+    {"kSpringMove", tokens::kSpringMove, 136196, 232436, 0, 136, 233},
+    {"kSpringReveal", tokens::kSpringReveal, 84449, 192801, 0.022566, 84, 192},
+    {"kSpringExit", tokens::kSpringExit, 99051, 169045, 0, 99, 169},
+    {"kSpringGrow", tokens::kSpringGrow, 119241, 179529, 0.001524, 0, 0},
+};
+
+int64_t Us(base::TimeDelta time) {
+  return time.InMicroseconds();
+}
+
+TEST(RacSpringTest, MatchesTheReferenceTable) {
+  for (const TableRow& row : kTable) {
+    SCOPED_TRACE(row.name);
+    EXPECT_NEAR(Us(row.spring.TimeToReach(0.9)), row.ninety_percent_us, 1);
+    EXPECT_NEAR(Us(row.spring.SettleTime(0.01)), row.within_one_percent_us, 1);
+    EXPECT_NEAR(row.spring.Overshoot(), row.overshoot, 1e-6);
+  }
+}
+
+TEST(RacSpringTest, MatchesTheDesignTableWithinOneMillisecond) {
+  for (const TableRow& row : kTable) {
+    if (!row.table_ninety_percent_ms) {
+      continue;
+    }
+    SCOPED_TRACE(row.name);
+    EXPECT_NEAR(row.spring.TimeToReach(0.9).InMillisecondsF(),
+                row.table_ninety_percent_ms, 1.0);
+    EXPECT_NEAR(row.spring.SettleTime(0.01).InMillisecondsF(),
+                row.table_within_one_percent_ms, 1.0);

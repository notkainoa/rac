+class RacMotionTest : public testing::Test {
+ protected:
+  // Starts `element` on `layer` as a ui::LayerAnimator would, with the
+  // compositor's first frame at `start_`.
+  void Start(ui::LayerAnimationElement& element, FakeLayer& layer) {
+    element.set_requested_start_time(start_);
+    element.Start(&layer, 1);
+    if (element.IsThreaded(&layer)) {
+      element.set_effective_start_time(start_);
+    }
+  }
+
+  base::test::SingleThreadTaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  const base::TimeTicks start_ = base::TimeTicks::Now();
+};
+
+TEST_F(RacMotionTest, SpringSlideRunsOnTheCompositorAndRests) {
+  FakeLayer layer;
+  const SpringMotion motion{tokens::kSpringPage, 200, -900};
+  SpringTransformElement element(motion, gfx::Vector2dF(40, 0),
+                                 SpringTransformElement::Axis::kX);
+  EXPECT_EQ(element.duration(), motion.RestTime(tokens::kSpringRest));
+
+  Start(element, layer);
+  EXPECT_EQ(layer.transform_, gfx::Transform::MakeTranslation(240, 0));
+  ASSERT_EQ(layer.models_.size(), 1u);
+  EXPECT_TRUE(layer.models_[0]->needs_synchronized_start_time());
+
+  // The compositor's curve is the spring, then rest.
+  const gfx::TransformAnimationCurve* curve = TransformCurveOf(layer);
+  EXPECT_EQ(curve->Duration(), element.duration());
+  for (base::TimeDelta t; t < element.duration(); t += base::Hertz(240)) {
+    const gfx::Transform expected = gfx::Transform::MakeTranslation(
+        40 + static_cast<float>(motion.OffsetAt(t)), 0);
+    EXPECT_EQ(curve->GetValue(t).Apply(), expected);
+    EXPECT_EQ(element.TransformAt(t), expected);
+  }
+  EXPECT_EQ(curve->GetValue(element.duration()).Apply(),
+            gfx::Transform::MakeTranslation(40, 0));
+  float scale = 0;
+  EXPECT_TRUE(curve->MaximumScale(&scale));
+  EXPECT_EQ(scale, 1);
+
+  // The UI thread hears only about the end.
+  EXPECT_FALSE(element.Progress(start_ + base::Milliseconds(50), &layer));
+  EXPECT_EQ(layer.transform_, gfx::Transform::MakeTranslation(240, 0));
+  EXPECT_TRUE(element.Progress(start_ + element.duration(), &layer));
+  EXPECT_EQ(layer.transform_, gfx::Transform::MakeTranslation(40, 0));
+  EXPECT_EQ(layer.removed_, 1);
+}
+
+TEST_F(RacMotionTest, SpringSlideAbortsWhereItIs) {
+  FakeLayer layer;
+  const SpringMotion motion{tokens::kSpringPage, -300, 0};
+  SpringTransformElement element(motion, gfx::Vector2dF(0, 12),
+                                 SpringTransformElement::Axis::kY);
+  Start(element, layer);
+  EXPECT_EQ(layer.transform_, gfx::Transform::MakeTranslation(0, -288));
+
+  task_environment_.FastForwardBy(base::Milliseconds(60));
+  const float offset = static_cast<float>(
+      motion.OffsetAt(base::Milliseconds(60)));
+  EXPECT_EQ(element.GetOffset(), offset);
+  EXPECT_FLOAT_EQ(element.GetVelocity(),
+                  motion.VelocityAt(base::Milliseconds(60)));
+  element.Abort(&layer);
+  EXPECT_EQ(layer.transform_, gfx::Transform::MakeTranslation(0, 12 + offset));
+  EXPECT_EQ(layer.removed_, 1);
+}
+
+TEST_F(RacMotionTest, SpringBlendFollowsTheBounce) {
+  FakeLayer layer;
+  gfx::Transform from = gfx::Transform::MakeTranslation(100, 50);
+  from.Scale(0.5, 0.5);
+  const gfx::Transform to;
+  std::unique_ptr<SpringTransformElement> element =
+      SpringTransformElement::CreateBlend(tokens::kSpringGrow, from, to);
+  Start(*element, layer);
+  EXPECT_EQ(layer.transform_, from);
+
+  // kSpringGrow bounces, so the layer passes `to` before resting there.
+  const base::TimeDelta peak = base::Milliseconds(245);
+  const gfx::Transform at_peak = element->TransformAt(peak);
+  EXPECT_GT(at_peak.To2dScale().x(), 1);
+  EXPECT_LT(at_peak.To2dTranslation().x(), 0);
+  EXPECT_EQ(TransformCurveOf(layer)->GetValue(peak).Apply(), at_peak);
+
+  float scale = 0;
+  EXPECT_TRUE(TransformCurveOf(layer)->MaximumScale(&scale));
+  EXPECT_GE(scale, at_peak.To2dScale().x());
+
+  EXPECT_TRUE(element->Progress(start_ + element->duration(), &layer));
+  EXPECT_EQ(layer.transform_, to);
+}
+
+TEST_F(RacMotionTest, SpringOpacityStaysInRange) {
+  FakeLayer layer;
+  SpringOpacityElement element(tokens::kSpringReveal, 0.2f, 1);
+  Start(element, layer);
+  EXPECT_EQ(layer.opacity_, 0.2f);
+  const gfx::FloatAnimationCurve* curve = FloatCurveOf(layer);
+  for (base::TimeDelta t; t <= element.duration(); t += base::Hertz(240)) {
+    const float opacity = curve->GetValue(t);
+    EXPECT_GE(opacity, 0);
+    EXPECT_LE(opacity, 1);
+    EXPECT_EQ(opacity, element.OpacityAt(t));
+  }
+  EXPECT_EQ(curve->GetValue(element.duration()), 1);
+  EXPECT_TRUE(element.Progress(start_ + element.duration(), &layer));
+  EXPECT_EQ(layer.opacity_, 1);
+}

+// Counts what a SpringAnimation tells its owner.
+class Recorder : public gfx::AnimationDelegate {
+ public:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    values_.push_back(animation->GetCurrentValue());
+  }
+  void AnimationEnded(const gfx::Animation* animation) override { ++ended_; }
+
+  std::vector<double> values_;
+  int ended_ = 0;
+};
+
+TEST_F(RacMotionTest, SpringAnimationReachesItsTarget) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  Recorder recorder;
+  SpringAnimation animation(&recorder, tokens::kSpringDock, 280);
+  animation.Show();
+  EXPECT_TRUE(animation.is_animating());
+  EXPECT_TRUE(animation.IsShowing());
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_FALSE(animation.is_animating());
+  EXPECT_EQ(animation.GetCurrentValue(), 1);
+  EXPECT_EQ(recorder.ended_, 1);
+  ASSERT_GT(recorder.values_.size(), 5u);
+  // kSpringDock bounces a little past its target.
+  double highest = 0;
+  for (double value : recorder.values_) {
+    highest = std::max(highest, value);
+  }
+  EXPECT_GT(highest, 1);
+  EXPECT_LT(highest, 1.01);
+}
+
+TEST_F(RacMotionTest, SpringAnimationReversesWithoutAJolt) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  Recorder recorder;
+  SpringAnimation animation(&recorder, tokens::kSpringDock, 280);
+  animation.Show();
+  task_environment_.FastForwardBy(base::Milliseconds(50));
+  const double value = animation.GetCurrentValue();
+  const double velocity = animation.GetCurrentVelocity();
+  EXPECT_GT(velocity, 0);
+  animation.Hide();
+  // Same place and speed right after the turn.
+  EXPECT_DOUBLE_EQ(animation.GetCurrentVelocity(), velocity);
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(animation.GetCurrentValue(), 0);
+  EXPECT_GT(value, 0);
+}
+
+TEST_F(RacMotionTest, SpringAnimationJumpsUnderReducedMotion) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  EXPECT_TRUE(motion::ReducedMotion());
+  Recorder recorder;
+  SpringAnimation animation(&recorder, tokens::kSpringDock, 280);
+  animation.Show();
+  EXPECT_FALSE(animation.is_animating());
+  EXPECT_EQ(animation.GetCurrentValue(), 1);
+  ASSERT_EQ(recorder.values_.size(), 1u);
+  EXPECT_EQ(recorder.ended_, 1);
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+}
+
+// Turns back from inside the last frame, as an owner may.
+class TurnBack : public Recorder {
+ public:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    Recorder::AnimationProgressed(animation);
+    if (!turned_ && animation->GetCurrentValue() == 1) {
+      turned_ = true;
+      animation_->Hide();
+    }
+  }
+
+  raw_ptr<SpringAnimation> animation_ = nullptr;
+  bool turned_ = false;
+};
+
+TEST_F(RacMotionTest, SpringAnimationCanTurnBackOnItsLastFrame) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  TurnBack owner;
+  SpringAnimation animation(&owner, tokens::kSpringDock, 280);
+  owner.animation_ = &animation;
+  animation.Show();
+  task_environment_.FastForwardBy(base::Seconds(2));
+  EXPECT_TRUE(owner.turned_);
+  EXPECT_FALSE(animation.is_animating());
+  EXPECT_EQ(animation.GetCurrentValue(), 0);
+  EXPECT_EQ(owner.ended_, 1);
+}

+TEST_F(RacMotionTest, CurveOpacityRunsTheRecordedBezier) {
+  FakeLayer layer;
+  layer.opacity_ = 0;
+  std::unique_ptr<CurveElement> element =
+      CurveElement::CreateOpacity(1, tokens::kCommandBarGrow);
+  Start(*element, layer);
+  ASSERT_EQ(layer.models_.size(), 1u);
+  const gfx::FloatAnimationCurve* curve = FloatCurveOf(layer);
+  EXPECT_EQ(curve->Duration(), base::Milliseconds(130));
+  // kEaseExpo is most of the way there by a third of the time.
+  EXPECT_GT(curve->GetValue(base::Milliseconds(43)), 0.85f);
+  EXPECT_EQ(curve->GetValue(base::Milliseconds(130)), 1);

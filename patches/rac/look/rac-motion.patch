+// The space pager's spring before it moved onto rac::Spring, verbatim.
+constexpr double kPagerOmega = 2 * std::numbers::pi / 0.25;
+
+struct PagerSpring {
+  float offset = 0;
+  float velocity = 0;
+
+  float OffsetAt(base::TimeDelta time) const {
+    const double t = std::max(0.0, time.InSecondsF());
+    const double rate = velocity + kPagerOmega * offset;
+    return (offset + rate * t) * std::exp(-kPagerOmega * t);
+  }
+  float VelocityAt(base::TimeDelta time) const {
+    const double t = std::max(0.0, time.InSecondsF());
+    const double rate = velocity + kPagerOmega * offset;
+    return (rate - kPagerOmega * (offset + rate * t)) *
+           std::exp(-kPagerOmega * t);
+  }
+  base::TimeDelta Duration() const {
+    constexpr base::TimeDelta kStep = base::Hertz(240);
+    constexpr base::TimeDelta kLongest = base::Milliseconds(1500);
+    base::TimeDelta time = kStep;
+    while (time < kLongest && (std::abs(OffsetAt(time)) > 0.25f ||
+                               std::abs(VelocityAt(time)) > 15.0f)) {
+      time += kStep;
+    }
+    return time;
+  }
+};
+
+TEST(RacSpringTest, PagerMovesWithoutChange) {
+  for (float offset = -600; offset <= 600; offset += 7.25f) {
+    for (float velocity = -6000; velocity <= 6000; velocity += 123.5f) {
+      const PagerSpring old{offset, velocity};
+      const SpringMotion now{tokens::kSpringPage, offset, velocity};
+      ASSERT_EQ(old.Duration(), now.RestTime(tokens::kSpringRest))
+          << offset << ", " << velocity;
+      for (base::TimeDelta t; t < base::Milliseconds(400);
+           t += base::Hertz(240)) {
+        ASSERT_EQ(old.OffsetAt(t), static_cast<float>(now.OffsetAt(t)));
+        ASSERT_EQ(old.VelocityAt(t), static_cast<float>(now.VelocityAt(t)));
+      }
+    }
+  }
+}

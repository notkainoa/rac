+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/rac/rac_look.h"
+
+#include <algorithm>
+
+#include "base/notreached.h"
+#include "base/numerics/safe_conversions.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/gfx/skia_paint_util.h"
+
+namespace rac {
+
+namespace {
+
+// The selected card sits 1 px above its row: 0 1px 2px.
+constexpr int kTabShadowBlur = 2;
+// The page card's soft shadow: 0 1px 6px.
+constexpr int kCardShadowBlur = 6;
+
+void DrawRoundedRect(gfx::Canvas* canvas,
+                     const gfx::RectF& rect,
+                     int radius,
+                     SkColor color,
+                     const gfx::ShadowValues& shadows = {}) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(color);
+  if (!shadows.empty()) {
+    flags.setLooper(gfx::CreateShadowDrawLooper(shadows));
+  }
+  canvas->DrawRoundRect(rect, radius, flags);
+}
+
+SkColor ScaleAlpha(SkColor color, float scale) {
+  return SkColorSetA(color,
+                     base::ClampRound<uint8_t>(SkColorGetA(color) * scale));
+}
+
+}  // namespace
+
+bool PaintVerticalTabRow(gfx::Canvas* canvas,
+                         const gfx::Rect& local_bounds,
+                         int corner_radius,
+                         TabRowState state,
+                         float hover_value,
+                         const ui::ColorProvider* color_provider) {
+  if (!color_provider) {
+    return false;
+  }
+  gfx::Rect row = local_bounds;
+  row.Inset(gfx::Insets::VH(kTabRowVerticalGap, kTabRowHorizontalGap));
+  const gfx::RectF rect(row);
+
+  switch (state) {
+    case TabRowState::kActive:
+      DrawRoundedRect(
+          canvas, rect, corner_radius,
+          color_provider->GetColor(kColorRacTabBackgroundSelected),
+          {gfx::ShadowValue(gfx::Vector2d(0, 1), kTabShadowBlur,
+                            color_provider->GetColor(
+                                kColorRacTabSelectedShadow))});
+      return true;
+    case TabRowState::kSelected:
+      DrawRoundedRect(canvas, rect, corner_radius,
+                      color_provider->GetColor(kColorRacTabBackgroundHovered));
+      return true;
+    case TabRowState::kUnselected:
+      DrawRoundedRect(
+          canvas, rect, corner_radius,
+          color_provider->GetColor(kColorRacTabBackgroundUnselected));
+      if (hover_value > 0.0f) {
+        DrawRoundedRect(
+            canvas, rect, corner_radius,
+            ScaleAlpha(color_provider->GetColor(kColorRacTabBackgroundHovered),
+                       std::min(hover_value, 1.0f)));
+      }
+      return true;
+  }
+  NOTREACHED();
+}
+
+SkColor GetVerticalTabTitleColor(const ui::ColorProvider* color_provider,
+                                 bool active) {
+  return color_provider->GetColor(active ? kColorRacTabTitleSelected
+                                         : kColorRacTabTitleUnselected);
+}
+
+void PaintContentCardBackdrop(gfx::Canvas* canvas,
+                              const gfx::Rect& bounds,
+                              const gfx::Rect& card_bounds,
+                              int corner_radius,
+                              bool frame_active,
+                              const ui::ColorProvider* color_provider) {
+  const SkColor backdrop = color_provider->GetColor(
+      frame_active ? ui::kColorFrameActive : ui::kColorFrameInactive);
+  canvas->FillRect(bounds, backdrop);
+  if (card_bounds.IsEmpty()) {
+    return;
+  }
+
+  // The card is painted in the backdrop color: the page covers it, and only
+  // the shadow and the area behind the page's rounded corners show.
+  DrawRoundedRect(
+      canvas, gfx::RectF(card_bounds), corner_radius, backdrop,
+      {gfx::ShadowValue(
+          gfx::Vector2d(0, 1), kCardShadowBlur,
+          color_provider->GetColor(kColorRacContentCardShadow))});
+}
+
+}  // namespace rac

+// to paint only the backdrop.
+void PaintContentCardBackdrop(gfx::Canvas* canvas,
+                              const gfx::Rect& bounds,
+                              const gfx::Rect& card_bounds,
+                              int corner_radius,
+                              bool frame_active,
+                              const ui::ColorProvider* color_provider);
+
+}  // namespace rac

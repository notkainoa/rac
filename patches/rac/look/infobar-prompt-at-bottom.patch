+bool IsInfoBarCardAtBottom(const InfoBarView& infobar) {
+  const infobars::InfoBarDelegate* delegate = infobar.delegate();
+  return delegate &&
+         delegate->GetIdentifier() ==
+             infobars::InfoBarDelegate::DEFAULT_BROWSER_INFOBAR_DELEGATE;
+}
+
+bool HasInfoBarCardAtBottom(const views::View& container) {
+  return std::ranges::any_of(container.children(), [](const views::View* v) {
+    const auto* infobar = views::AsViewClass<InfoBarView>(v);
+    return infobar && IsInfoBarCardAtBottom(*infobar);
+  });
+}
+
+gfx::Insets GetInfoBarCardInteriorMargin(bool at_bottom) {
+  return at_bottom ? gfx::Insets::TLBR(0, kBottomCardLeadingPadding, 0,
+                                       kBottomCardTrailingPadding)
+                   : gfx::Insets::TLBR(0, kCardLeadingPadding, 0,
+                                       kCardTrailingPadding);
 }
 

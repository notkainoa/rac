+// Only the lightweight layout watcher exists in Sidebar layout. The button
+// (including its icon and accessibility state) is constructed on demand.
+class AssistantButtonHost : public views::View {
+ public:
+  explicit AssistantButtonHost(BrowserWindowInterface* browser)
+      : browser_(browser) {
+    SetLayoutManager(std::make_unique<views::FillLayout>());
+    pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+    pref_change_registrar_.Add(
+        kLayout, base::BindRepeating(&AssistantButtonHost::OnLayoutChanged,
+                                     base::Unretained(this)));
+    OnLayoutChanged();
+  }
 
  private:
   void OnLayoutChanged() {
-    SetVisible(IsTopBar(browser_));
-    // The toolbar's height depends on the layout too. Invalidating reaches the
-    // browser view, which asks for the toolbar's preferred size again.
+    if (IsTopBar(browser_)) {
+      if (children().empty()) {
+        AddChildView(std::make_unique<AssistantButton>(browser_));
+      }
+    } else if (!children().empty()) {
+      RemoveChildViewT(children().front());
+    }
+    PreferredSizeChanged();
     if (parent()) {
       parent()->InvalidateLayout();
     }

+
+namespace rac {
+
+namespace {
+
+using gfx::CANVAS_DIMENSIONS;
+using gfx::CLOSE;
+using gfx::FILL_RULE_NONZERO;
+using gfx::MOVE_TO;
+using gfx::QUADRATIC_TO;
+
+// Two four-pointed stars, a large one and a small one above and to its right.
+constexpr gfx::PathElement kSparklesPath[] = {
+    CANVAS_DIMENSIONS, 24,
+    FILL_RULE_NONZERO,
+    MOVE_TO, 10, 6,
+    QUADRATIC_TO, 11.8f, 12.2f, 18, 14,
+    QUADRATIC_TO, 11.8f, 15.8f, 10, 22,
+    QUADRATIC_TO, 8.2f, 15.8f, 2, 14,
+    QUADRATIC_TO, 8.2f, 12.2f, 10, 6,
+    CLOSE,
+    MOVE_TO, 19, 2,
+    QUADRATIC_TO, 19.9f, 5.1f, 23, 6,
+    QUADRATIC_TO, 19.9f, 6.9f, 19, 10,
+    QUADRATIC_TO, 18.1f, 6.9f, 15, 6,
+    QUADRATIC_TO, 18.1f, 5.1f, 19, 2,
+    CLOSE,
+};
+constexpr gfx::VectorIconRep kSparklesReps[] = {{kSparklesPath}};
+constexpr gfx::VectorIcon kSparklesIcon = {
+    kSparklesReps, std::size(kSparklesReps), "rac_sparkles"};
+
+bool IsTopBar(const BrowserWindowInterface* browser) {
+  return browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+         GetLayout(browser->GetProfile()->GetPrefs()) == Layout::kTopBar;
+}
+
+class AssistantButton : public ToolbarButton {
+  METADATA_HEADER(AssistantButton, ToolbarButton)
+
+ public:
+  explicit AssistantButton(BrowserWindowInterface* browser)
+      : ToolbarButton(base::BindRepeating(
+            [](BrowserWindowInterface* browser) {
+              chrome::ExecuteCommand(browser, IDC_RAC_ASSISTANT_TOGGLE);
+            },
+            base::Unretained(browser))),
+        browser_(browser) {
+    const std::u16string tooltip =
+        l10n_util::GetStringUTF16(IDS_RAC_ASSISTANT_TOOLTIP);
+    SetTooltipText(tooltip);
+    GetViewAccessibility().SetName(tooltip);
+
+    pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+    pref_change_registrar_.Add(
+        kLayout, base::BindRepeating(&AssistantButton::OnLayoutChanged,
+                                     base::Unretained(this)));
+    SetVisible(IsTopBar(browser_));
+  }
+
+  ~AssistantButton() override = default;
+
+  // ToolbarButton:
+  void UpdateIcon() override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    const SkColor accent = color_provider->GetColor(kColorRacAccent);
+    UpdateIconsWithColors(
+        kSparklesIcon, accent, accent, accent,
+        color_provider->GetColor(kColorToolbarButtonIconInactive));
+  }
+
+ private:
+  void OnLayoutChanged() {
+    SetVisible(IsTopBar(browser_));
+    // The toolbar's height depends on the layout too. Invalidating reaches the
+    // browser view, which asks for the toolbar's preferred size again.
+    if (parent()) {
+      parent()->InvalidateLayout();
+    }
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  PrefChangeRegistrar pref_change_registrar_;
+};
+
+BEGIN_METADATA(AssistantButton)
+END_METADATA
+
+}  // namespace
+
+int GetTopBarHeight(const BrowserWindowInterface* browser) {
+  return browser && IsTopBar(browser) ? kTopBarHeight : 0;
+}
+
+std::unique_ptr<views::View> CreateAssistantButton(
+    BrowserWindowInterface* browser) {
+  if (browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+      features::IsWebUIToolbarEnabled()) {
+    return nullptr;
+  }
+  return std::make_unique<AssistantButton>(browser);
+}
+
+}  // namespace rac

     return SK_ColorTRANSPARENT;
   }
-  return SkColorSetA(SK_ColorBLACK | rgb, alpha);
+  const SkColor opaque = SkColorSetA(SK_ColorBLACK | rgb, SK_AlphaOPAQUE);
+  SkScalar hsv[3];
+  SkColorToHSV(opaque, hsv);
+  // Near-white Arc presets need more chroma to read on a frosted frame.
+  hsv[1] = std::min(SkScalar(1), hsv[1] * 1.7f);

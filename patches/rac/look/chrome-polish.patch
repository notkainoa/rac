@@ -14,10 +14,10 @@ namespace rac {
 // Space colors shared by light and dark chrome. The dynamic sRGB stops belong
 // to the space model, not the profile-wide color provider.
 inline void AddSpaceColorMixer(ui::ColorMixer& mixer) {
-  mixer[kColorRacSpaceDotActive] = {kColorToolbarButtonIcon};
-  mixer[kColorRacSpaceDotInactive] = {kColorToolbarButtonIconInactive};
-  mixer[kColorRacSpaceTintLight] = {SkColorSetA(SK_ColorWHITE, 0x4D)};
-  mixer[kColorRacSpaceTintDark] = {SkColorSetA(SK_ColorWHITE, 0x2E)};
+  // Dot colors live in AddRacColorMixer so they can follow light/dark.
+  // Strong enough that Arc-style space washes read on the frosted frame.
+  mixer[kColorRacSpaceTintLight] = {SkColorSetA(SK_ColorWHITE, 0xD9)};
+  mixer[kColorRacSpaceTintDark] = {SkColorSetA(SK_ColorWHITE, 0x99)};
 }
 
 }  // namespace rac

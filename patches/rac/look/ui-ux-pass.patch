+gfx::ImageSkia ThemeFavicon(const gfx::ImageSkia& source,
+                            const ui::ColorProvider& colors) {
+  if (source.isNull()) {
+    return source;
+  }
+  // Inspect only when the icon or theme changes, never while painting. A
+  // narrow luminance range distinguishes silhouettes from grayscale artwork.
+  const SkBitmap& bitmap = *source.bitmap();
+  int darkest = 255;
+  int lightest = 0;
+  bool transparent = false;
+  for (int y = 0; y < bitmap.height(); ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      const SkColor pixel = bitmap.getColor(x, y);
+      if (SkColorGetA(pixel) < 128) {
+        transparent = true;
+        continue;
+      }
+      const int low = std::min(
+          {SkColorGetR(pixel), SkColorGetG(pixel), SkColorGetB(pixel)});
+      const int high = std::max(
+          {SkColorGetR(pixel), SkColorGetG(pixel), SkColorGetB(pixel)});
+      darkest = std::min(darkest, low);
+      lightest = std::max(lightest, high);
+      if (high - low > 8 || lightest - darkest > 16) {
+        return source;
+      }
+    }
+  }
+  if (!transparent || lightest < darkest) {
+    return source;
+  }
+  return favicon::ThemeFavicon(
+      source, colors.GetColor(kColorRacTabTitleSelected),
+      colors.GetColor(kColorRacTabBackgroundSelected),
+      color_utils::GetResultingPaintColor(
+          colors.GetColor(kColorRacTabBackgroundUnselected),
+          colors.GetColor(ui::kColorFrameActive)));
+}

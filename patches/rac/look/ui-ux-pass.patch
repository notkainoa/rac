+// Arrow keys move and select within a single row of appearance choices.
+views::View* AdjacentChoice(views::View* choice, const ui::KeyEvent& event) {
+  if (event.IsShiftDown() || event.IsControlDown() || event.IsAltDown() ||
+      event.IsCommandDown()) {
+    return nullptr;
+  }
+  const auto key = event.key_code();
+  if (key != ui::VKEY_LEFT && key != ui::VKEY_RIGHT && key != ui::VKEY_UP &&
+      key != ui::VKEY_DOWN) {
+    return nullptr;
+  }
+  const auto& choices = choice->parent()->children();
+  const size_t index = choice->parent()->GetIndexOf(choice).value();
+  const bool previous = key == ui::VKEY_LEFT || key == ui::VKEY_UP;
+  views::View* next =
+      choices[(index + (previous ? choices.size() - 1 : 1)) % choices.size()];
+  next->RequestFocus();
+  return next;
+}

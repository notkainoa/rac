+int PageCardRadius() {
+  // Only macOS 26's window corner (17) gives a concentric radius above the
+  // card's old radius. Everywhere else keep Helium's padded radius exactly
+  // (the window corner minus 3).
+  const int concentric = GetSystemWindowRadius() - tokens::kInsetPageCard;
+  return concentric > tokens::kRadiusPageCard ? concentric
+                                              : GetPaddedFrameRadius();
+}

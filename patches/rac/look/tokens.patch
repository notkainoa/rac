+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/color/rac_color_mixer.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+
+void AddRacColorMixer(ui::ColorProvider* provider,
+                      const ui::ColorProviderKey& key) {
+  const bool dark = key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  ui::ColorMixer& mixer = provider->AddMixer();
+
+  // Window and sidebar surfaces.
+  mixer[kColorRacWindowTint] = {dark ? SkColorSetARGB(0x99, 0x12, 0x12, 0x12)
+                                     : SkColorSetARGB(0xCC, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorRacSidebarBackground] = {kColorRacWindowTint};
+  mixer[kColorRacSidebarBorder] = {SkColorSetARGB(0x4D, 0xFF, 0xFF, 0xFF)};
+
+  // Content card.
+  mixer[kColorRacContentCardShadow] = {
+      dark ? SkColorSetARGB(0x66, 0x00, 0x00, 0x00)
+           : SkColorSetARGB(0x1F, 0x00, 0x00, 0x00)};
+  mixer[kColorRacContentCardBorder] = {
+      dark ? SkColorSetARGB(0x14, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0x0F, 0x00, 0x00, 0x00)};
+
+  // Tab rows.
+  mixer[kColorRacTabBackgroundUnselected] = {
+      dark ? SkColorSetARGB(0x0F, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0x0F, 0x00, 0x00, 0x00)};
+  mixer[kColorRacTabBackgroundHovered] = {
+      dark ? SkColorSetARGB(0x29, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0x8C, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorRacTabBackgroundSelected] = {dark ? SK_ColorBLACK
+                                                : SK_ColorWHITE};
+  mixer[kColorRacTabSelectedShadow] = {SkColorSetARGB(0x14, 0x00, 0x00, 0x00)};
+  mixer[kColorRacTabTitleSelected] = {dark ? SK_ColorWHITE : SK_ColorBLACK};
+  mixer[kColorRacTabTitleUnselected] = {
+      dark ? SkColorSetARGB(0xC7, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0xAD, 0x00, 0x00, 0x00)};
+  mixer[kColorRacTabCloseButtonHovered] = {
+      dark ? SkColorSetARGB(0x29, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0x1A, 0x00, 0x00, 0x00)};
+
+  // Text.
+  mixer[kColorRacTextPrimary] = {dark ? SkColorSetARGB(0xD9, 0xFF, 0xFF, 0xFF)
+                                      : SkColorSetARGB(0xD9, 0x00, 0x00, 0x00)};
+  mixer[kColorRacTextSecondary] = {
+      dark ? SkColorSetARGB(0x99, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0x99, 0x00, 0x00, 0x00)};
+  mixer[kColorRacTextTertiary] = {
+      dark ? SkColorSetARGB(0x4D, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0x4D, 0x00, 0x00, 0x00)};
+
+  // Toolbar and address pill.
+  mixer[kColorRacToolbarIcon] = {kColorRacTextSecondary};
+  mixer[kColorRacToolbarIconHovered] = {kColorRacTextPrimary};
+  mixer[kColorRacToolbarIconBackgroundHovered] = {
+      kColorRacTabBackgroundUnselected};
+  mixer[kColorRacUrlPillBackground] = {kColorRacTabBackgroundUnselected};
+  mixer[kColorRacUrlPillBackgroundHovered] = {
+      dark ? SkColorSetARGB(0x1A, 0xFF, 0xFF, 0xFF)
+           : SkColorSetARGB(0x1A, 0x00, 0x00, 0x00)};
+  mixer[kColorRacUrlPillBackgroundFocused] = {kColorRacTabBackgroundSelected};
+  mixer[kColorRacUrlPillBorderFocused] = {SkColorSetRGB(0x63, 0x95, 0xFC)};
+
+  // Assistant accent.
+  mixer[kColorRacAccent] = {SkColorSetRGB(0xFC, 0xBF, 0x49)};
+}

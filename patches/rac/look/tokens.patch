+#ifndef CHROME_BROWSER_UI_COLOR_RAC_COLOR_ID_H_
+#define CHROME_BROWSER_UI_COLOR_RAC_COLOR_ID_H_
+
+// Color IDs for rac's chrome look. Spliced into CHROME_COLOR_IDS (see
+// chrome_color_id.h); values are set in rac_color_mixer.cc.
+//
+// clang-format off
+#define RAC_COLOR_IDS \
+  /* Window and sidebar surfaces. */ \
+  E_CPONLY(kColorRacWindowTint) \
+  E_CPONLY(kColorRacSidebarBackground) \
+  E_CPONLY(kColorRacSidebarBorder) \
+  /* Content "card" shown inset from the sidebar. */ \
+  E_CPONLY(kColorRacContentCardShadow) \
+  E_CPONLY(kColorRacContentCardBorder) \
+  /* Tab rows. */ \
+  E_CPONLY(kColorRacTabBackgroundUnselected) \
+  E_CPONLY(kColorRacTabBackgroundHovered) \
+  E_CPONLY(kColorRacTabBackgroundSelected) \
+  E_CPONLY(kColorRacTabSelectedShadow) \
+  E_CPONLY(kColorRacTabTitleSelected) \
+  E_CPONLY(kColorRacTabTitleUnselected) \
+  E_CPONLY(kColorRacTabCloseButtonHovered) \
+  /* Toolbar and address pill. */ \
+  E_CPONLY(kColorRacToolbarIcon) \
+  E_CPONLY(kColorRacToolbarIconHovered) \
+  E_CPONLY(kColorRacToolbarIconBackgroundHovered) \
+  E_CPONLY(kColorRacUrlPillBackground) \
+  E_CPONLY(kColorRacUrlPillBackgroundHovered) \
+  E_CPONLY(kColorRacUrlPillBackgroundFocused) \
+  E_CPONLY(kColorRacUrlPillBorderFocused) \
+  /* Text. */ \
+  E_CPONLY(kColorRacTextPrimary) \
+  E_CPONLY(kColorRacTextSecondary) \
+  E_CPONLY(kColorRacTextTertiary) \
+  /* Assistant accent. */ \
+  E_CPONLY(kColorRacAccent)
+// clang-format on
+
+#endif  // CHROME_BROWSER_UI_COLOR_RAC_COLOR_ID_H_

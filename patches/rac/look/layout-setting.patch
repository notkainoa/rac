+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/layout_prefs.h"
+
+#include <utility>
+
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace rac {
+
+void RegisterLayoutPrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterIntegerPref(kLayout, std::to_underlying(Layout::kSidebar));
+}
+
+Layout GetLayout(const PrefService* prefs) {
+  return prefs->GetInteger(kLayout) == std::to_underlying(Layout::kTopBar)
+             ? Layout::kTopBar
+             : Layout::kSidebar;
+}
+
+}  // namespace rac

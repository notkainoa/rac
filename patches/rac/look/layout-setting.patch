+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_LAYOUT_PREFS_H_
+#define CHROME_BROWSER_UI_RAC_LAYOUT_PREFS_H_
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace rac {
+
+// Profile pref: how the browser's chrome is arranged.
+inline constexpr char kLayout[] = "rac.browser.layout";
+
+// The values are stored in the pref and must match the options in the
+// Appearance settings page.
+enum class Layout {
+  // Arc: the address bar sits at the top of the sidebar.
+  kSidebar = 0,
+  // Dia: a slim top toolbar with the address bar.
+  kTopBar = 1,
+};
+
+void RegisterLayoutPrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Returns kSidebar for a value this version doesn't know.
+Layout GetLayout(const PrefService* prefs);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_UI_RAC_LAYOUT_PREFS_H_

+// rac has no side panel position setting: the side panel opens on the side
+// away from the tab sidebar.
+void KeepSidePanelOppositeTabs(PrefService* pref_service) {
+  // Unit tests may register only the tab prefs.
+  if (!pref_service->FindPreference(prefs::kSidePanelHorizontalAlignment)) {
+    return;
+  }
+  const bool tabs_on_right =
+      pref_service->GetInteger(prefs::kHeliumLayout) ==
+          std::to_underlying(HeliumLayoutType::kVertical) &&
+      pref_service->GetBoolean(prefs::kHeliumVerticalRightAligned);
+  pref_service->SetBoolean(prefs::kSidePanelHorizontalAlignment,
+                           !tabs_on_right);
+  pref_service->ClearPref(prefs::kSidePanelAlignmentOverrides);
+}
+
+}  // namespace

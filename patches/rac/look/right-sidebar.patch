+void PlaceSidebarAndChatButtons(views::View* toolbar,
+                                views::View* sidebar_button,
+                                bool sidebar_on_right) {
+  views::View* chat = nullptr;
+  // The Chat button's usual place, just before the avatar, or the overflow
+  // button while the sidebar's footer holds the avatar.
+  std::optional<size_t> chat_slot;
+  for (size_t i = 0; i < toolbar->children().size(); ++i) {
+    views::View* child = toolbar->children()[i];
+    if (views::IsViewClass<ChatButtonHost>(child)) {
+      chat = child;
+      continue;
+    }
+    const ui::ElementIdentifier id =
+        child->GetProperty(views::kElementIdentifierKey);
+    if (!chat_slot && (id == kToolbarAvatarButtonElementId ||
+                       id == kToolbarOverflowButtonElementId)) {
+      chat_slot = i;
+    }
+  }
+
+  // The two buttons trade places, so the controls the sidebar borrows keep
+  // the toolbar indices they're restored to.
+  auto move_to_chat_slot = [&](views::View* view) {
+    size_t slot = chat_slot.value_or(toolbar->children().size());
+    if (toolbar->GetIndexOf(view).value() < slot) {
+      --slot;
+    }
+    toolbar->ReorderChildView(view, slot);
+  };
+  if (sidebar_on_right) {
+    if (chat) {
+      toolbar->ReorderChildView(chat, 0);
+    }
+    move_to_chat_slot(sidebar_button);
+    return;
+  }
+  toolbar->ReorderChildView(sidebar_button, 0);
+  if (chat) {
+    move_to_chat_slot(chat);
+  }
+}

@@ -189,3 +189,36 @@ cr-ripple { z-index: 1; }
 
 #content,
 ::slotted(*) { z-index: 2; }
+
+/* rac: filled pill buttons on pages that set html[rac-look]. The --rac-*
+ * colors come from the page. */
+:host-context(html[rac-look]) {
+  --cr-button-background-color: var(--rac-control-fill);
+  --cr-button-border: none;
+  --cr-button-disabled-border: none;
+  --cr-button-disabled-background-color: var(--rac-control-fill);
+  --cr-button-ripple-color: transparent;
+  --cr-button-text-color: var(--rac-text);
+  border-radius: 999px;
+  min-width: 0;
+  padding-inline: 14px;
+}
+
+:host-context(html[rac-look]):host(.action-button) {
+  --cr-button-background-color: var(--rac-primary-fill);
+  --cr-button-text-color: var(--rac-primary-text);
+}
+
+:host-context(html[rac-look]):host(.tonal-button),
+:host-context(html[rac-look]):host(.floating-button) {
+  --cr-button-background-color: var(--rac-control-fill);
+  --cr-button-text-color: var(--rac-text);
+}
+
+:host-context(html[rac-look]):host(:hover) #hoverBackground {
+  background: var(--rac-control-fill);
+}
+
+:host-context(html[rac-look]):host([disabled]) {
+  opacity: 0.5;
+}
--- a/ui/webui/resources/cr_elements/cr_input/cr_input_style_lit.css
+++ b/ui/webui/resources/cr_elements/cr_input/cr_input_style_lit.css
@@ -220,3 +220,22 @@
 :host(.stroked[focused_][invalid]) {
   --cr-input-border: 2px solid var(--cr-input-error-color);
 }
+
+/* rac: a filled, rounded field without an underline on pages that set
+ * html[rac-look]. */
+:host-context(html[rac-look]) {
+  --cr-input-background-color: var(--rac-control-fill);
+  --cr-input-border-bottom: none;
+  --cr-input-border-radius: 8px;
+  --cr-input-focus-color: var(--rac-accent);
+  --cr-input-hover-background-color: var(--rac-control-fill);
+}
+
+:host-context(html[rac-look]) #underline {
+  display: none;
+}
+
+:host-context(html[rac-look]):host([focused_]) #input-container {
+  outline: 2px solid var(--rac-accent);
+  outline-offset: -2px;
+}
--- a/ui/webui/resources/cr_elements/cr_radio_button/cr_radio_button_style_lit.css
+++ b/ui/webui/resources/cr_elements/cr_radio_button/cr_radio_button_style_lit.css
@@ -188,3 +188,19 @@ paper-ripple {
 :host([checked]) paper-ripple {
   color: var(--cr-radio-button-checked-ripple-color);
 }
+
+/* rac: radios in the page's accent on pages that set html[rac-look]. */
+:host-context(html[rac-look]) {
+  --cr-radio-button-checked-color: var(--rac-accent);
+  --cr-radio-button-checked-ripple-color: transparent;
+  --cr-radio-button-unchecked-color: var(--rac-text-faint);
+  --cr-radio-button-unchecked-ripple-color: transparent;
+}
+
+:host-context(html[rac-look]):host([checked]) .disc {
+  transform: scale(0.45);
+}
+
+:host-context(html[rac-look]):host([disabled]) {
+  opacity: 0.4;
+}
--- a/ui/webui/resources/cr_elements/cr_search_field/cr_search_field.css
+++ b/ui/webui/resources/cr_elements/cr_search_field/cr_search_field.css
@@ -130,3 +130,17 @@
     transform: translateY(-50%);
   }
 }
+
+/* rac: a filled field without an underline on pages that set
+ * html[rac-look]. */
+:host-context(html[rac-look]) #searchInput {
+  --cr-input-background-color: var(--rac-control-fill);
+  --cr-input-border-bottom: none;
+  --cr-input-border-radius: 8px;
+  --cr-input-padding-bottom: 5px;
+  --cr-input-padding-end: 8px;
+  --cr-input-padding-start: 10px;
+  --cr-input-padding-top: 5px;
+  --cr-input-underline-display: none;
+  font-size: 13px;
+}
--- a/ui/webui/resources/cr_elements/cr_toggle/cr_toggle.css
+++ b/ui/webui/resources/cr_elements/cr_toggle/cr_toggle.css
@@ -208,3 +208,44 @@
   right: 50%;
   transform: translate(50%, -50%);
 }
+
+/* rac: a macOS-style switch on pages that set html[rac-look]. The
+ * --rac-* colors come from the page. */
+:host-context(html[rac-look]),
+:host-context(html[rac-look]):host(:active),
+:host-context(html[rac-look]):host([checked]),
+:host-context(html[rac-look]):host([checked]:active),
+:host-context(html[rac-look]):host([disabled]) {
+  --cr-toggle-bar-border: none;
+  --cr-toggle-bar-width: 34px;
+  --cr-toggle-checked-bar-color: var(--rac-accent, #4459f2);
+  --cr-toggle-checked-button-color: #fff;
+  --cr-toggle-knob-diameter: 16px;
+  --cr-toggle-unchecked-bar-color:
+      var(--rac-switch-off, rgb(128 128 128 / 30%));
+  --cr-toggle-unchecked-button-color: #fff;
+}
+
+:host-context(html[rac-look]):host([disabled]) {
+  opacity: 0.4;
+}
+
+:host-context(html[rac-look]) #bar {
+  height: 20px;
+  transition: background-color 150ms ease-out;
+}
+
+:host-context(html[rac-look]) #knob {
+  --cr-toggle-knob-center-edge-distance_: 10px;
+  box-shadow: 0 1px 2px rgb(0 0 0 / 25%), 0 0 0 0.5px rgb(0 0 0 / 6%);
+  transition: transform 150ms ease-out;
+}
+
+:host-context(html[rac-look]):host([checked]:hover) #knob {
+  --cr-toggle-checked-button-color: #fff;
+}
+
+:host-context(html[rac-look]):host(:hover) #knob::before,
+:host-context(html[rac-look]) #ink {
+  display: none;
+}
--- a/ui/webui/resources/cr_elements/md_select_lit.css
+++ b/ui/webui/resources/cr_elements/md_select_lit.css
@@ -76,3 +76,25 @@
 :host-context([dir=rtl]) .md-select {
   background-position-x: var(--md-select-side-padding);
 }
+
+/* rac: a filled, borderless select on pages that set html[rac-look]. */
+:host-context(html[rac-look]) .md-select {
+  --md-select-bg-color: var(--rac-control-fill);
+  border-color: transparent;
+  border-radius: 8px;
+  font-size: 13px;
+  height: 30px;
+}
+
+:host-context(html[rac-look]) .md-select:hover {
+  background-color: var(--rac-control-fill-hover);
+}
+
+:host-context(html[rac-look]) .md-select:focus-visible {
+  outline: 2px solid var(--rac-accent);
+  outline-offset: 1px;
+}
+
+:host-context(html[rac-look]) .md-select:focus:not(:focus-visible) {
+  outline: none;
+}

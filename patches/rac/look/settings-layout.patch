+
+/* #css_wrapper_metadata_start
+ * #type=vars
+ * #import=./settings_vars.css.js
+ * #css_wrapper_metadata_end */
+
+/* rac's settings: the surfaces, text, and controls of rac's chat page.
+ * The --rac-* names are also read by the shared controls' html[rac-look]
+ * styles. The color pipeline's colors.css sets its --color-* names on
+ * html:not(#z) and loads after this file, so this selector adds :root to
+ * outrank it. */
+html:not(#z):root {
+  --rac-page: light-dark(#f3f3f3, #202020);
+  --rac-raised: light-dark(#fff, #2a2a2a);
+  --rac-hairline: light-dark(rgb(0 0 0 / 7%), rgb(255 255 255 / 7%));
+  --rac-text: light-dark(rgb(0 0 0 / 85%), rgb(255 255 255 / 88%));
+  --rac-text-muted: light-dark(rgb(0 0 0 / 50%), rgb(255 255 255 / 50%));
+  --rac-text-faint: light-dark(rgb(0 0 0 / 28%), rgb(255 255 255 / 28%));
+  --rac-token: light-dark(rgb(0 0 0 / 4%), rgb(255 255 255 / 5%));
+  --rac-token-hover: light-dark(rgb(0 0 0 / 7%), rgb(255 255 255 / 8%));
+  --rac-control-fill: light-dark(rgb(0 0 0 / 5%), rgb(255 255 255 / 8%));
+  --rac-control-fill-hover:
+      light-dark(rgb(0 0 0 / 9%), rgb(255 255 255 / 12%));
+  --rac-switch-off: light-dark(rgb(0 0 0 / 12%), rgb(255 255 255 / 16%));
+  /* rac's color for windows without a theme, lifted a little in dark. */
+  --rac-accent: light-dark(#4459f2, #5b6ef5);
+  --rac-primary-fill: light-dark(rgb(0 0 0 / 85%), rgb(255 255 255 / 90%));
+  --rac-primary-text: light-dark(#fff, #161616);
+  /* The selected tab's raised card, as in the browser sidebar. */
+  --rac-selected-shadow:
+      0 0 0 0.5px light-dark(rgb(0 0 0 / 8%), rgb(255 255 255 / 6%)),
+      0 1px 3px light-dark(rgb(0 0 0 / 8%), rgb(0 0 0 / 30%));
+
+  --cr-card-background-color: var(--rac-raised);
+  --cr-card-border-radius: 14px;
+  --cr-card-shadow: 0 0 0 0.5px var(--rac-hairline),
+      0 1px 2px light-dark(rgb(0 0 0 / 4%), rgb(0 0 0 / 20%));
+  --cr-separator-color: var(--rac-hairline);
+  --cr-separator-line: 1px solid var(--rac-hairline);
+  --cr-primary-text-color: var(--rac-text);
+  --cr-secondary-text-color: var(--rac-text-muted);
+  --cr-title-text-color: var(--rac-text);
+  --cr-menu-background-color: var(--rac-raised);
+  --cr-hover-background-color: var(--rac-token);
+  --cr-active-background-color: var(--rac-token-hover);
+  --cr-focus-outline-color: var(--rac-accent);
+  --cr-link-color: var(--rac-accent);
+  --cr-checked-color: var(--rac-accent);
+  --cr-section-padding: 18px;
+  --cr-section-min-height: 52px;
+  --cr-section-two-line-min-height: 64px;
+  --cr-section-vertical-margin: 28px;
+  --cr-button-height: 30px;
+  --cr-icon-button-fill-color: var(--rac-text-muted);
+
+  /* Shared controls read these color-pipeline names first. */
+  --color-button-foreground: var(--rac-text);
+  --color-checkbox-foreground-checked: var(--rac-accent);
+  --color-combobox-container-outline: transparent;
+  --color-comboxbox-ink-drop-hovered: var(--rac-control-fill-hover);
+  --color-link-foreground-default: var(--rac-accent);
+  --color-radio-button-foreground-checked: var(--rac-accent);
+  --color-sys-state-focus-ring: var(--rac-accent);
+  --color-sys-state-hover: var(--rac-token);
+  --color-textfield-filled-background: var(--rac-control-fill);
+
+  background: var(--rac-page);
+}
+
+html[rac-look] body {
+  -webkit-font-smoothing: antialiased;
+  font-size: 14px;
+}

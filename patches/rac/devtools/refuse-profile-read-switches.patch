+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/devtools/release_switches.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/logging.h"
+#include "chrome/browser/rac/dev/buildflags.h"
+#include "extensions/common/switches.h"
+#include "services/network/public/cpp/network_switches.h"
+
+namespace rac {
+
+namespace {
+
+// Read by GetNetworkService() when --ssl-key-log-file is absent.
+constexpr char kSslKeyLogFileVar[] = "SSLKEYLOGFILE";
+
+void Refuse(base::CommandLine* command_line, std::string_view name) {
+  LOG(WARNING) << "--" << name
+               << " isn't allowed in rac's release builds; ignoring it.";
+  command_line->RemoveSwitch(name);
+}
+
+// The capture modes that leave cookies and credentials out of the log.
+bool IsRedactedCaptureMode(std::string_view mode) {
+  return mode == "Default" || mode == "HeavilyRedacted";
+}
+
+}  // namespace
+
+void RefuseProfileReadSwitches(base::CommandLine* command_line,
+                               bool dev_switches) {
+  if (dev_switches) {
+    return;
+  }
+
+  // Two are spelled out because their constants live in targets the
+  // browser's startup code shouldn't pull in: switches::
+  // kIgnoreCertificateErrors (network_session_configurator's
+  // network_switch_list.h) and apps::kLoadAndLaunchApp (//apps).
+  for (std::string_view name : {
+           extensions::switches::kLoadExtension,
+           extensions::switches::kDisableExtensionsExcept,
+           extensions::switches::kLoadApps,
+           "load-and-launch-app",
+           "ignore-certificate-errors",
+           network::switches::kIgnoreCertificateErrorsSPKIList,
+           network::switches::kSSLKeyLogFile,
+       }) {
+    if (command_line->HasSwitch(name)) {
+      Refuse(command_line, name);
+    }
+  }
+
+  // Content's parser treats a missing switch, and any value it doesn't know,
+  // as Default.
+  const std::string_view capture_mode = network::switches::kNetLogCaptureMode;
+  if (command_line->HasSwitch(capture_mode) &&
+      !IsRedactedCaptureMode(command_line->GetSwitchValueASCII(capture_mode))) {
+    Refuse(command_line, capture_mode);
+  }
+}
+
+void RefuseProfileReadEnvironment(base::Environment* env, bool dev_switches) {
+  if (dev_switches || !env->HasVar(kSslKeyLogFileVar)) {
+    return;
+  }
+  LOG(WARNING) << kSslKeyLogFileVar
+               << " isn't allowed in rac's release builds; ignoring it.";
+  env->UnSetVar(kSslKeyLogFileVar);
+}
+
+void RefuseProfileReadSwitchesInBrowserProcess() {
+  RefuseProfileReadSwitches(base::CommandLine::ForCurrentProcess(),
+                            BUILDFLAG(RAC_DEV_SWITCHES));
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  RefuseProfileReadEnvironment(env.get(), BUILDFLAG(RAC_DEV_SWITCHES));
+}
+
+}  // namespace rac

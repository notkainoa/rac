+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/devtools/release_switches.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/test/scoped_command_line.h"
+#include "chrome/browser/rac/dev/buildflags.h"
+#include "extensions/common/switches.h"
+#include "services/network/public/cpp/network_switches.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+using Argv = std::vector<std::string>;
+
+base::CommandLine Launch(const Argv& switches) {
+  Argv argv = {"/Applications/rac.app/Contents/MacOS/rac"};
+  argv.insert(argv.end(), switches.begin(), switches.end());
+  return base::CommandLine(argv);
+}
+
+// Refuses in a release build and returns what's left after the program name.
+Argv RefusedInRelease(const Argv& switches) {
+  base::CommandLine command_line = Launch(switches);
+  RefuseProfileReadSwitches(&command_line, /*dev_switches=*/false);
+  const Argv& argv = command_line.argv();
+  return Argv(argv.begin() + 1, argv.end());
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseRemovesLoadExtension) {
+  base::CommandLine command_line =
+      Launch({"--user-data-dir=/tmp/x", "--load-extension=/x"});
+  RefuseProfileReadSwitches(&command_line, /*dev_switches=*/false);
+  EXPECT_FALSE(command_line.HasSwitch(extensions::switches::kLoadExtension));
+  EXPECT_EQ(Argv({"--user-data-dir=/tmp/x"}),
+            Argv(command_line.argv().begin() + 1, command_line.argv().end()));
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseRemovesEveryCopyOfLoadExtension) {
+  EXPECT_EQ(Argv(),
+            RefusedInRelease({"--load-extension=/a", "-load-extension=/b",
+                              "--load-extension=/c,/d"}));
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseRemovesDisableExtensionsExcept) {
+  base::CommandLine command_line = Launch({"--disable-extensions-except=/x"});
+  RefuseProfileReadSwitches(&command_line, /*dev_switches=*/false);
+  EXPECT_FALSE(
+      command_line.HasSwitch(extensions::switches::kDisableExtensionsExcept));
+  EXPECT_EQ(1u, command_line.argv().size());
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseRemovesCertificateKeyLogAndAppSwitches) {
+  for (const char* refused :
+       {"--ignore-certificate-errors",
+        "--ignore-certificate-errors-spki-list=AAAA",
+        "--ssl-key-log-file=/tmp/keys.log", "--load-apps=/x",
+        "--load-and-launch-app=/x"}) {
+    SCOPED_TRACE(refused);
+    EXPECT_EQ(Argv({"--user-data-dir=/tmp/x"}),
+              RefusedInRelease({"--user-data-dir=/tmp/x", refused}));
+  }
+  // The constants the code names match what Chromium's readers look up.
+  base::CommandLine command_line =
+      Launch({"--load-apps=/x", "--ssl-key-log-file=/k",
+              "--ignore-certificate-errors-spki-list=AAAA"});
+  RefuseProfileReadSwitches(&command_line, /*dev_switches=*/false);
+  EXPECT_FALSE(command_line.HasSwitch(extensions::switches::kLoadApps));
+  EXPECT_FALSE(command_line.HasSwitch(network::switches::kSSLKeyLogFile));
+  EXPECT_FALSE(command_line.HasSwitch(
+      network::switches::kIgnoreCertificateErrorsSPKIList));
+}
+
+// Sets SSLKEYLOGFILE for one test and restores what was there.
+class ScopedSslKeyLogFile {
+ public:
+  explicit ScopedSslKeyLogFile(const std::string& value)
+      : env_(base::Environment::Create()),
+        old_(env_->GetVar("SSLKEYLOGFILE")) {
+    env_->SetVar("SSLKEYLOGFILE", value);
+  }
+  ~ScopedSslKeyLogFile() {
+    if (old_) {
+      env_->SetVar("SSLKEYLOGFILE", *old_);
+    } else {
+      env_->UnSetVar("SSLKEYLOGFILE");
+    }
+  }
+  base::Environment* env() { return env_.get(); }
+
+ private:
+  std::unique_ptr<base::Environment> env_;
+  std::optional<std::string> old_;
+};
+
+TEST(RacReleaseSwitchesTest, ReleaseUnsetsSslKeyLogFile) {
+  ScopedSslKeyLogFile scoped("/tmp/keys.log");
+  RefuseProfileReadEnvironment(scoped.env(), /*dev_switches=*/false);
+  EXPECT_FALSE(scoped.env()->HasVar("SSLKEYLOGFILE"));
+  // Nothing to do, and nothing breaks, when it isn't set.
+  RefuseProfileReadEnvironment(scoped.env(), /*dev_switches=*/false);
+  EXPECT_FALSE(scoped.env()->HasVar("SSLKEYLOGFILE"));
+}
+
+TEST(RacReleaseSwitchesTest, DevBuildsKeepSslKeyLogFile) {
+  ScopedSslKeyLogFile scoped("/tmp/keys.log");
+  RefuseProfileReadEnvironment(scoped.env(), /*dev_switches=*/true);
+  EXPECT_EQ("/tmp/keys.log", scoped.env()->GetVar("SSLKEYLOGFILE"));
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseRemovesFullCaptureModes) {
+  for (const char* mode :
+       {"Everything", "IncludeSensitive", "IncludeCookiesAndCredentials",
+        "IncludeSocketBytes", "everything", ""}) {
+    SCOPED_TRACE(mode);
+    base::CommandLine command_line =
+        Launch({"--log-net-log=/x.json",
+                std::string("--net-log-capture-mode=") + mode});
+    RefuseProfileReadSwitches(&command_line, /*dev_switches=*/false);
+    EXPECT_FALSE(command_line.HasSwitch(network::switches::kNetLogCaptureMode));
+    EXPECT_EQ(Argv({"--log-net-log=/x.json"}),
+              Argv(command_line.argv().begin() + 1, command_line.argv().end()));
+  }
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseKeepsRedactedCaptureModes) {
+  for (const char* mode : {"Default", "HeavilyRedacted"}) {
+    SCOPED_TRACE(mode);
+    const Argv switches = {"--log-net-log=/x.json",
+                           std::string("--net-log-capture-mode=") + mode};
+    EXPECT_EQ(switches, RefusedInRelease(switches));
+  }
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseKeepsNetLogWithoutCaptureMode) {
+  EXPECT_EQ(Argv({"--log-net-log=/x.json"}),
+            RefusedInRelease({"--log-net-log=/x.json"}));
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseRemovesTheModeWhenTheLastCopyIsFull) {
+  // base::CommandLine keeps the last value, which is the one content reads.
+  EXPECT_EQ(Argv({"--log-net-log=/x.json"}),
+            RefusedInRelease({"--log-net-log=/x.json",
+                              "--net-log-capture-mode=Default",
+                              "--net-log-capture-mode=Everything"}));
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseLeavesOtherSwitchesAndArgs) {
+  const Argv untouched = {"--user-data-dir=/tmp/x",
+                          "--no-first-run",
+                          "--disable-extensions",
+                          "--log-net-log=/x.json",
+                          "--net-log-capture-mode=Default",
+                          "--enable-logging=stderr",
+                          "--proxy-server=http://127.0.0.1:8080",
+                          "https://example.com/"};
+  EXPECT_EQ(untouched, RefusedInRelease(untouched));
+
+  // Only the refused switches go; everything else keeps its order.
+  EXPECT_EQ(untouched,
+            RefusedInRelease(
+                {"--user-data-dir=/tmp/x", "--load-extension=/x",
+                 "--no-first-run", "--disable-extensions",
+                 "--log-net-log=/x.json", "--net-log-capture-mode=Default",
+                 "--enable-logging=stderr",
+                 "--proxy-server=http://127.0.0.1:8080",
+                 "https://example.com/"}));
+}
+
+TEST(RacReleaseSwitchesTest, ReleaseKeepsArgsThatOnlyLookLikeTheSwitches) {
+  // After the "--" terminator, arguments aren't switches.
+  const Argv args = {"--", "--load-extension=/x",
+                     "--net-log-capture-mode=Everything"};
+  EXPECT_EQ(args, RefusedInRelease(args));
+}
+
+TEST(RacReleaseSwitchesTest, DevBuildsKeepEverything) {
+  const Argv switches = {"--user-data-dir=/tmp/x",
+                         "--load-extension=/x",
+                         "--disable-extensions-except=/y",
+                         "--load-apps=/z",
+                         "--load-and-launch-app=/z",
+                         "--ignore-certificate-errors",
+                         "--ignore-certificate-errors-spki-list=AAAA",
+                         "--ssl-key-log-file=/tmp/keys.log",
+                         "--log-net-log=/x.json",
+                         "--net-log-capture-mode=Everything"};
+  base::CommandLine command_line = Launch(switches);
+  const Argv before = command_line.argv();
+  RefuseProfileReadSwitches(&command_line, /*dev_switches=*/true);
+  EXPECT_EQ(before, command_line.argv());
+  EXPECT_EQ("Everything", command_line.GetSwitchValueASCII(
+                              network::switches::kNetLogCaptureMode));
+}
+
+TEST(RacReleaseSwitchesTest, BrowserProcessHookFollowsTheBuildFlag) {
+  constexpr bool kDevSwitches = BUILDFLAG(RAC_DEV_SWITCHES);
+  base::test::ScopedCommandLine scoped_command_line;
+  base::CommandLine* command_line = scoped_command_line.GetProcessCommandLine();
+  command_line->AppendSwitchASCII(extensions::switches::kLoadExtension, "/x");
+  command_line->AppendSwitchASCII(network::switches::kNetLogCaptureMode,
+                                  "Everything");
+  command_line->AppendSwitchASCII(network::switches::kSSLKeyLogFile, "/k");
+  ScopedSslKeyLogFile scoped("/tmp/keys.log");
+  RefuseProfileReadSwitchesInBrowserProcess();
+  EXPECT_EQ(kDevSwitches,
+            command_line->HasSwitch(extensions::switches::kLoadExtension));
+  EXPECT_EQ(kDevSwitches,
+            command_line->HasSwitch(network::switches::kNetLogCaptureMode));
+  EXPECT_EQ(kDevSwitches,
+            command_line->HasSwitch(network::switches::kSSLKeyLogFile));
+  EXPECT_EQ(kDevSwitches, scoped.env()->HasVar("SSLKEYLOGFILE"));
+}
+
+}  // namespace
+}  // namespace rac

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_DEVTOOLS_RELEASE_SWITCHES_H_
+#define CHROME_BROWSER_RAC_DEVTOOLS_RELEASE_SWITCHES_H_
+
+namespace base {
+class CommandLine;
+class Environment;
+}  // namespace base
+
+namespace rac {
+
+// Every rac user data dir shares one Keychain key, so a launch with
+// --user-data-dir=<throwaway> decrypts the real profile's cookies and logins
+// when links to its files, or copies of them, are planted there. Release
+// builds refuse the launch switches that would hand that decrypted data
+// straight to another program (issue #65):
+// - --load-extension, --disable-extensions-except, --load-apps and
+//   --load-and-launch-app. Each loads unpacked code that can read every
+//   cookie. Unpacked extensions still load from chrome://extensions.
+// - --net-log-capture-mode, unless it's Default or HeavilyRedacted.
+//   IncludeSensitive and Everything (and their old names) write cookies and
+//   credentials into the --log-net-log file. Without the switch the log uses
+//   Default, which strips them, so --log-net-log keeps working.
+// - --ssl-key-log-file and the SSLKEYLOGFILE environment variable, which
+//   write the TLS session keys, and --ignore-certificate-errors and
+//   --ignore-certificate-errors-spki-list, which accept a local
+//   man-in-the-middle's certificate. Either lets a capture or a proxy read
+//   the cookies rac sends.
+//
+// This narrows what a planted profile hands over; it doesn't stop one.
+// Someone who can launch rac with their own arguments already runs code as
+// the user, and other ways to read such a profile remain (for one, settings
+// aren't signed with a secret seed outside Google builds, so a planted
+// profile can carry its own extension settings).
+// docs/internals/launch-switches.md lists them as accepted limits.
+//
+// Dev builds, where BUILDFLAG(RAC_DEV_SWITCHES) is on, keep all of them.
+
+// Removes the refused switches from `command_line` unless `dev_switches`,
+// logging a warning for each one.
+void RefuseProfileReadSwitches(base::CommandLine* command_line,
+                               bool dev_switches);
+
+// Unsets the refused environment variables in `env` unless `dev_switches`,
+// logging a warning for each one that was set.
+void RefuseProfileReadEnvironment(base::Environment* env, bool dev_switches);
+
+// Both of the above on the browser process's command line and environment,
+// with BUILDFLAG(RAC_DEV_SWITCHES). ChromeMainDelegate calls it before the
+// process singleton forwards the command line to a running rac, and before
+// extensions, the network service, or any child process reads either.
+void RefuseProfileReadSwitchesInBrowserProcess();
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_DEVTOOLS_RELEASE_SWITCHES_H_

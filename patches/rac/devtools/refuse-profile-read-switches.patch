+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_DEVTOOLS_RELEASE_SWITCHES_H_
+#define CHROME_BROWSER_RAC_DEVTOOLS_RELEASE_SWITCHES_H_
+
+namespace base {
+class CommandLine;
+}  // namespace base
+
+namespace rac {
+
+// Every rac user data dir shares one Keychain key, so a launch with
+// --user-data-dir=<throwaway> decrypts the real profile's cookies and logins
+// when links to its files, or copies of them, are planted there. Release
+// builds refuse the launch switches that hand that decrypted data to another
+// program (issue #65):
+// - --load-extension and --disable-extensions-except. Both load an unpacked
+//   extension, which can read every cookie through chrome.cookies. Google
+//   Chrome refuses both too. Unpacked extensions still load from
+//   chrome://extensions.
+// - --net-log-capture-mode, unless it's Default or HeavilyRedacted.
+//   IncludeSensitive and Everything (and their old names) write cookies and
+//   credentials into the --log-net-log file. Without the switch the log uses
+//   Default, which strips them, so --log-net-log keeps working.
+//
+// Dev builds, where BUILDFLAG(RAC_DEV_SWITCHES) is on, keep all of them.
+
+// Removes the refused switches from `command_line` unless `dev_switches`,
+// logging a warning for each one.
+void RefuseProfileReadSwitches(base::CommandLine* command_line,
+                               bool dev_switches);
+
+// RefuseProfileReadSwitches() on the browser process's command line, with
+// BUILDFLAG(RAC_DEV_SWITCHES). ChromeMainDelegate calls it before the process
+// singleton forwards the command line to a running rac, and before
+// extensions, the network service, or any child process reads it.
+void RefuseProfileReadSwitchesInBrowserProcess();
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_DEVTOOLS_RELEASE_SWITCHES_H_

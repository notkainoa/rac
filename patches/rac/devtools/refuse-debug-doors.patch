+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_DEVTOOLS_DEFAULT_DIR_H_
+#define CHROME_BROWSER_RAC_DEVTOOLS_DEFAULT_DIR_H_
+
+#include <optional>
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace rac {
+
+// Whether the browser runs on the default user data dir, the user's real
+// profile, where rac refuses Chromium's debug doors (--remote-debugging-port
+// and --remote-debugging-pipe, decision D20). `is_default_by_path` is
+// chrome::IsUsingDefaultDataDirectory(), a plain path compare; unknown
+// (nullopt) counts as default. When the paths differ, DIR_USER_DATA still
+// counts as default if it is the same directory on disk, so a symlink, a
+// case variant, a firmlink, or a `..` path to the real profile is refused
+// too. Only called when one of those switches is on the command line, so a
+// normal launch does no file I/O here.
+bool IsDefaultUserDataDir(std::optional<bool> is_default_by_path);
+
+// The identity check behind IsDefaultUserDataDir(): true if both paths are
+// the same directory (same device and inode). False if `default_dir` doesn't
+// exist, since then there's no real profile to protect. True if either path
+// can't be read for any other reason, so an unknown answer is refused.
+bool IsSameDirectoryAsDefault(const base::FilePath& user_data_dir,
+                              const base::FilePath& default_dir);
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_DEVTOOLS_DEFAULT_DIR_H_

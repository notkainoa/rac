+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/devtools/default_dir.h"
+
+#include <optional>
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/feature_list.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_util.h"
+#include "base/test/scoped_command_line.h"
+#include "base/test/scoped_path_override.h"
+#include "chrome/browser/devtools/features.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/chrome_paths_internal.h"
+#include "content/public/common/content_switches.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+// Every path here lives in a temp dir: base::DIR_APP_DATA and the password
+// database's home are overridden, so both "default" user data dirs are temp
+// folders, never the real profile.
+class RacDefaultDirTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    // Resolved, so /var -> /private/var doesn't change any path below.
+    root_ = base::MakeAbsoluteFilePath(temp_dir_.GetPath());
+    ASSERT_FALSE(root_.empty());
+    app_data_.emplace(base::DIR_APP_DATA, root_.AppendASCII("AppData"),
+                      /*is_absolute=*/true, /*create=*/true);
+    ASSERT_TRUE(chrome::GetDefaultUserDataDirectory(&default_dir_));
+    ASSERT_TRUE(root_.IsParent(default_dir_)) << default_dir_;
+    ASSERT_TRUE(base::CreateDirectory(default_dir_));
+
+    // The home in the password database, where $HOME would point if it
+    // weren't changed. Its default dir doesn't exist unless a test makes it.
+    passwd_home_ = root_.AppendASCII("RealHome");
+    ASSERT_TRUE(base::CreateDirectory(passwd_home_));
+    SetPasswordDatabaseHomeForTesting(passwd_home_);
+    const std::vector<base::FilePath> dirs = GetDefaultUserDataDirs();
+    ASSERT_EQ(dirs.size(), 2u);
+    EXPECT_EQ(dirs[0], default_dir_);
+    passwd_default_dir_ = dirs[1];
+    ASSERT_TRUE(passwd_home_.IsParent(passwd_default_dir_));
+    EXPECT_EQ(passwd_default_dir_.BaseName(), default_dir_.BaseName());
+
+    other_ = root_.AppendASCII("profile");
+    ASSERT_TRUE(base::CreateDirectory(other_));
+  }
+
+  void TearDown() override {
+    chrome::SetUsingDefaultUserDataDirectoryForTesting(std::nullopt);
+    SetPasswordDatabaseHomeForTesting(std::nullopt);
+  }
+
+  // Sets DIR_USER_DATA to `path` exactly as given. PathService would
+  // otherwise resolve it with realpath(), hiding what this test checks.
+  void UseUserDataDir(const base::FilePath& path) {
+    user_data_dir_.reset();
+    user_data_dir_.emplace(chrome::DIR_USER_DATA, path, /*is_absolute=*/true,
+                           /*create=*/false);
+  }
+
+  // What IsRemoteDebuggingAllowed() decides for the port and the pipe alike:
+  // both pass it the same chrome::IsUsingDefaultDataDirectory() value.
+  bool Refused() {
+    return IsDefaultUserDataDir(chrome::IsUsingDefaultDataDirectory());
+  }
+
+  // What ProfileManager::CanCreateProfileAtPath() asks with the port open on
+  // `other_`, the way a test runner launches rac.
+  bool ProfileRefused(const base::FilePath& profile_dir) {
+    UseUserDataDir(other_);
+    command_line_.GetProcessCommandLine()->AppendSwitchASCII(
+        ::switches::kRemoteDebuggingPort, "0");
+    return RefusesProfileForDebugDoors(profile_dir);
+  }
+
+  base::ScopedTempDir temp_dir_;
+  base::FilePath root_;
+  base::FilePath default_dir_;
+  base::FilePath passwd_home_;
+  base::FilePath passwd_default_dir_;
+  base::FilePath other_;
+  base::test::ScopedCommandLine command_line_;
+  std::optional<base::ScopedPathOverride> app_data_;
+  std::optional<base::ScopedPathOverride> user_data_dir_;
+};
+
+// The user data dir.
+
+TEST_F(RacDefaultDirTest, RefusedWhenUsingTheDefaultDir) {
+  chrome::SetUsingDefaultUserDataDirectoryForTesting(true);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedWhenUnknown) {
+  EXPECT_TRUE(IsDefaultUserDataDir(std::nullopt));
+}
+
+TEST_F(RacDefaultDirTest, RefusedOnTheDefaultPath) {
+  UseUserDataDir(default_dir_);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), true);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, AllowedWithAnotherDir) {
+  UseUserDataDir(other_);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_FALSE(Refused());
+}
+
+// A sibling whose name starts with the default's, like rac's dev profile
+// `me.kainoa.rac.dev` next to `me.kainoa.rac`.
+TEST_F(RacDefaultDirTest, AllowedNextToTheDefaultDir) {
+  const base::FilePath dev = default_dir_.AddExtensionASCII("dev");
+  ASSERT_TRUE(base::CreateDirectory(dev));
+  UseUserDataDir(dev);
+  EXPECT_FALSE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, AllowedWhenNoDefaultDirExists) {
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  UseUserDataDir(other_);
+  EXPECT_FALSE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedInsideTheDefaultDir) {
+  const base::FilePath inside = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(inside.AppendASCII("deeper")));
+  UseUserDataDir(inside);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+  UseUserDataDir(inside.AppendASCII("deeper"));
+  EXPECT_TRUE(Refused());
+}
+
+// $HOME points elsewhere, so GetDefaultUserDataDirectory() names a folder
+// that isn't the real profile; the password database still names it.
+TEST_F(RacDefaultDirTest, RefusedOnTheRealHomesDefaultWhenHomeMoved) {
+  ASSERT_TRUE(base::CreateDirectory(passwd_default_dir_));
+  UseUserDataDir(passwd_default_dir_);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+
+  // Also when $HOME's default doesn't exist at all.
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  EXPECT_TRUE(Refused());
+  UseUserDataDir(passwd_default_dir_.AppendASCII("Default"));
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughASymlink) {
+  const base::FilePath link = root_.AppendASCII("link");
+  ASSERT_TRUE(base::CreateSymbolicLink(default_dir_, link));
+  UseUserDataDir(link);
+  // The path compare alone misses it.
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughASymlinkedParent) {
+  const base::FilePath link = root_.AppendASCII("link");
+  ASSERT_TRUE(base::CreateSymbolicLink(default_dir_.DirName(), link));
+  UseUserDataDir(link.Append(default_dir_.BaseName()));
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+// The real profile moved to another disk and linked back: the path compare
+// sees the link, the switch names where it points.
+TEST_F(RacDefaultDirTest, RefusedWhenTheDefaultIsASymlink) {
+  const base::FilePath moved = root_.AppendASCII("moved");
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  ASSERT_TRUE(base::CreateDirectory(moved));
+  ASSERT_TRUE(base::CreateSymbolicLink(moved, default_dir_));
+  UseUserDataDir(moved);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughACaseVariant) {
+  const base::FilePath variant = default_dir_.DirName().AppendASCII(
+      base::ToUpperASCII(default_dir_.BaseName().value()));
+  ASSERT_NE(variant, default_dir_);
+  if (!base::DirectoryExists(variant)) {
+    GTEST_SKIP() << "The temp volume is case-sensitive.";
+  }
+  UseUserDataDir(variant);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughDotDot) {
+  const base::FilePath sibling = default_dir_.DirName().AppendASCII("other");
+  ASSERT_TRUE(base::CreateDirectory(sibling));
+  UseUserDataDir(sibling.AppendASCII("..").Append(default_dir_.BaseName()));
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedWhenTheUserDataDirCannotBeRead) {
+  // Missing with a `..` after it: once created, it could climb anywhere.
+  UseUserDataDir(root_.AppendASCII("missing").AppendASCII(".."));
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedWhenTheRealHomeIsUnknown) {
+  UseUserDataDir(other_);
+  SetPasswordDatabaseHomeForTesting(base::FilePath());
+  EXPECT_TRUE(GetDefaultUserDataDirs().empty());
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, IsInsideDefaultDir) {
+  const base::FilePath missing_default = root_.AppendASCII("no-default");
+  EXPECT_TRUE(IsInsideDefaultDir(default_dir_, {default_dir_}));
+  EXPECT_FALSE(IsInsideDefaultDir(other_, {default_dir_}));
+  EXPECT_FALSE(IsInsideDefaultDir(default_dir_, {missing_default}));
+  EXPECT_TRUE(
+      IsInsideDefaultDir(default_dir_, {missing_default, default_dir_}));
+  // A path that doesn't exist yet is judged by its nearest existing folder.
+  EXPECT_TRUE(IsInsideDefaultDir(
+      default_dir_.AppendASCII("new").AppendASCII("Default"), {default_dir_}));
+  EXPECT_FALSE(
+      IsInsideDefaultDir(other_.AppendASCII("Profile 1"), {default_dir_}));
+}
+
+// Profiles, which ProfileManager loads from DIR_USER_DATA.Append(name).
+
+TEST_F(RacDefaultDirTest, ProfileAllowedInsideAnotherDir) {
+  ASSERT_TRUE(base::CreateDirectory(other_.AppendASCII("Default")));
+  EXPECT_FALSE(ProfileRefused(other_.AppendASCII("Default")));
+  // A profile folder about to be created.
+  EXPECT_FALSE(ProfileRefused(other_.AppendASCII("Profile 1")));
+}
+
+// --user-data-dir=/tmp/x "--profile-directory=../../<real>/Default".
+TEST_F(RacDefaultDirTest, ProfileRefusedThroughDotDot) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  base::FilePath escape = other_;
+  for (size_t i = 0; i < other_.GetComponents().size() - 1; ++i) {
+    escape = escape.AppendASCII("..");
+  }
+  for (size_t i = 1; i < real_profile.GetComponents().size(); ++i) {
+    escape = escape.Append(real_profile.GetComponents()[i]);
+  }
+  ASSERT_TRUE(base::DirectoryExists(escape)) << escape;
+  EXPECT_TRUE(ProfileRefused(escape));
+}
+
+// --user-data-dir=<real>/Default/x --profile-directory=.., which also passes
+// ProfileManager::IsAllowedProfilePath() since DirName() strips the `..`.
+TEST_F(RacDefaultDirTest, ProfileRefusedThroughDotDotFromInside) {
+  const base::FilePath inside =
+      default_dir_.AppendASCII("Default").AppendASCII("x");
+  ASSERT_TRUE(base::CreateDirectory(inside));
+  UseUserDataDir(inside);
+  command_line_.GetProcessCommandLine()->AppendSwitchASCII(
+      ::switches::kRemoteDebuggingPort, "0");
+  EXPECT_TRUE(RefusesProfileForDebugDoors(inside.AppendASCII("..")));
+}
+
+TEST_F(RacDefaultDirTest, ProfileRefusedAtAnAbsolutePath) {
+  EXPECT_TRUE(ProfileRefused(default_dir_.AppendASCII("Default")));
+  EXPECT_TRUE(ProfileRefused(default_dir_));
+}
+
+// /tmp/x/Default is a symlink to the real profile: no switch names it.
+TEST_F(RacDefaultDirTest, ProfileRefusedThroughASymlink) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  const base::FilePath link = other_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateSymbolicLink(real_profile, link));
+  EXPECT_TRUE(ProfileRefused(link));
+}
+
+TEST_F(RacDefaultDirTest, ProfileRefusedInTheRealHomeWhenHomeMoved) {
+  const base::FilePath real_profile =
+      passwd_default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  const base::FilePath link = other_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateSymbolicLink(real_profile, link));
+  EXPECT_TRUE(ProfileRefused(link));
+}
+
+TEST_F(RacDefaultDirTest, ProfileRefusedWithThePipe) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  UseUserDataDir(other_);
+  command_line_.GetProcessCommandLine()->AppendSwitch(
+      ::switches::kRemoteDebuggingPipe);
+  EXPECT_TRUE(RefusesProfileForDebugDoors(real_profile));
+}
+
+// Without a door, or with the doors shut because DIR_USER_DATA is the
+// default, every profile loads as usual and nothing touches the disk.
+TEST_F(RacDefaultDirTest, ProfileAllowedWithoutAnOpenDoor) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  UseUserDataDir(other_);
+  EXPECT_FALSE(RefusesProfileForDebugDoors(real_profile));
+
+  UseUserDataDir(default_dir_);
+  command_line_.GetProcessCommandLine()->AppendSwitchASCII(
+      ::switches::kRemoteDebuggingPort, "9222");
+  EXPECT_TRUE(Refused());
+  EXPECT_FALSE(RefusesProfileForDebugDoors(real_profile));
+}
+
+// With the feature off, chrome://inspect hides its approval-mode toggle.
+// RemoteDebuggingServer::GetInstance() never starts approval mode at all,
+// even with the feature forced on.
+TEST(RacDebugDoorsTest, ApprovalModeIsOffByDefault) {
+  EXPECT_FALSE(base::FeatureList::IsEnabled(
+      features::kDevToolsAcceptDebuggingConnections));
+}

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/devtools/default_dir.h"
+
+#include <errno.h>
+#include <sys/stat.h>
+
+#include "base/files/file_path.h"
+#include "base/path_service.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/chrome_paths_internal.h"
+
+namespace rac {
+
+namespace {
+
+enum class Lookup { kFound, kMissing, kUnreadable };
+
+// stat() follows symlinks, and on a case-insensitive volume a case variant
+// names the same inode, so both land on the directory they point to.
+Lookup StatPath(const base::FilePath& path, struct stat* info) {
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  if (stat(path.value().c_str(), info) == 0) {
+    return Lookup::kFound;
+  }
+  const int error = errno;
+  return error == ENOENT || error == ENOTDIR ? Lookup::kMissing
+                                             : Lookup::kUnreadable;
+}
+
+}  // namespace
+
+bool IsSameDirectoryAsDefault(const base::FilePath& user_data_dir,
+                              const base::FilePath& default_dir) {
+  struct stat default_info = {};
+  switch (StatPath(default_dir, &default_info)) {
+    case Lookup::kFound:
+      break;
+    case Lookup::kMissing:
+      return false;
+    case Lookup::kUnreadable:
+      return true;
+  }
+
+  struct stat user_info = {};
+  if (StatPath(user_data_dir, &user_info) != Lookup::kFound) {
+    return true;
+  }
+  return user_info.st_dev == default_info.st_dev &&
+         user_info.st_ino == default_info.st_ino;
+}
+
+bool IsDefaultUserDataDir(std::optional<bool> is_default_by_path) {
+  if (is_default_by_path.value_or(true)) {
+    return true;
+  }
+  base::FilePath user_data_dir;
+  base::FilePath default_dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir) ||
+      !chrome::GetDefaultUserDataDirectory(&default_dir)) {
+    return true;
+  }
+  return IsSameDirectoryAsDefault(user_data_dir, default_dir);
+}
+
+}  // namespace rac

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/devtools/default_dir.h"
+
+#include <optional>
+
+#include "base/base_paths.h"
+#include "base/feature_list.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_util.h"
+#include "base/test/scoped_path_override.h"
+#include "chrome/browser/devtools/features.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/chrome_paths_internal.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac {
+namespace {
+
+// Every path here lives in a temp dir: base::DIR_APP_DATA is overridden, so
+// the "default" user data dir is a temp folder, never the real profile.
+class RacDefaultDirTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    // Resolved, so /var -> /private/var doesn't change any path below.
+    root_ = base::MakeAbsoluteFilePath(temp_dir_.GetPath());
+    ASSERT_FALSE(root_.empty());
+    app_data_.emplace(base::DIR_APP_DATA, root_.AppendASCII("AppData"),
+                      /*is_absolute=*/true, /*create=*/true);
+    ASSERT_TRUE(chrome::GetDefaultUserDataDirectory(&default_dir_));
+    ASSERT_TRUE(root_.IsParent(default_dir_)) << default_dir_;
+    ASSERT_TRUE(base::CreateDirectory(default_dir_));
+  }
+
+  void TearDown() override {
+    chrome::SetUsingDefaultUserDataDirectoryForTesting(std::nullopt);
+  }
+
+  // Sets DIR_USER_DATA to `path` exactly as given. PathService would
+  // otherwise resolve it with realpath(), hiding what this test checks.
+  void UseUserDataDir(const base::FilePath& path) {
+    user_data_dir_.reset();
+    user_data_dir_.emplace(chrome::DIR_USER_DATA, path, /*is_absolute=*/true,
+                           /*create=*/false);
+  }
+
+  // What IsRemoteDebuggingAllowed() decides for the port and the pipe alike:
+  // both pass it the same chrome::IsUsingDefaultDataDirectory() value.
+  bool Refused() {
+    return IsDefaultUserDataDir(chrome::IsUsingDefaultDataDirectory());
+  }
+
+  base::ScopedTempDir temp_dir_;
+  base::FilePath root_;
+  base::FilePath default_dir_;
+  std::optional<base::ScopedPathOverride> app_data_;
+  std::optional<base::ScopedPathOverride> user_data_dir_;
+};
+
+TEST_F(RacDefaultDirTest, RefusedWhenUsingTheDefaultDir) {
+  chrome::SetUsingDefaultUserDataDirectoryForTesting(true);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedWhenUnknown) {
+  EXPECT_TRUE(IsDefaultUserDataDir(std::nullopt));
+}
+
+TEST_F(RacDefaultDirTest, RefusedOnTheDefaultPath) {
+  UseUserDataDir(default_dir_);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), true);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, AllowedWithAnotherDir) {
+  const base::FilePath other = root_.AppendASCII("profile");
+  ASSERT_TRUE(base::CreateDirectory(other));
+  UseUserDataDir(other);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_FALSE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, AllowedWhenTheDefaultDirDoesNotExist) {
+  const base::FilePath other = root_.AppendASCII("profile");
+  ASSERT_TRUE(base::CreateDirectory(other));
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  UseUserDataDir(other);
+  EXPECT_FALSE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughASymlink) {
+  const base::FilePath link = root_.AppendASCII("link");
+  ASSERT_TRUE(base::CreateSymbolicLink(default_dir_, link));
+  UseUserDataDir(link);
+  // The path compare alone misses it.
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughASymlinkedParent) {
+  const base::FilePath link = root_.AppendASCII("link");
+  ASSERT_TRUE(base::CreateSymbolicLink(default_dir_.DirName(), link));
+  UseUserDataDir(link.Append(default_dir_.BaseName()));
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+// The real profile moved to another disk and linked back: the path compare
+// sees the link, the switch names where it points.
+TEST_F(RacDefaultDirTest, RefusedWhenTheDefaultIsASymlink) {
+  const base::FilePath moved = root_.AppendASCII("moved");
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  ASSERT_TRUE(base::CreateDirectory(moved));
+  ASSERT_TRUE(base::CreateSymbolicLink(moved, default_dir_));
+  UseUserDataDir(moved);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughACaseVariant) {
+  const base::FilePath variant = default_dir_.DirName().AppendASCII(
+      base::ToUpperASCII(default_dir_.BaseName().value()));
+  ASSERT_NE(variant, default_dir_);
+  if (!base::DirectoryExists(variant)) {
+    GTEST_SKIP() << "The temp volume is case-sensitive.";
+  }
+  UseUserDataDir(variant);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughDotDot) {
+  const base::FilePath sibling = default_dir_.DirName().AppendASCII("other");
+  ASSERT_TRUE(base::CreateDirectory(sibling));
+  UseUserDataDir(sibling.AppendASCII("..").Append(default_dir_.BaseName()));
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedWhenTheUserDataDirCannotBeRead) {
+  UseUserDataDir(root_.AppendASCII("missing"));
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, SameDirectoryAsDefault) {
+  const base::FilePath other = root_.AppendASCII("profile");
+  ASSERT_TRUE(base::CreateDirectory(other));
+  EXPECT_TRUE(IsSameDirectoryAsDefault(default_dir_, default_dir_));
+  EXPECT_FALSE(IsSameDirectoryAsDefault(other, default_dir_));
+  EXPECT_FALSE(
+      IsSameDirectoryAsDefault(other, root_.AppendASCII("no-default")));
+}
+
+// With the feature off, RemoteDebuggingServer::GetInstance() never starts
+// chrome://inspect's approval mode, and chrome://inspect hides its toggle.
+TEST(RacDebugDoorsTest, ApprovalModeIsOffByDefault) {
+  EXPECT_FALSE(base::FeatureList::IsEnabled(
+      features::kDevToolsAcceptDebuggingConnections));
+}
+
+}  // namespace
+}  // namespace rac

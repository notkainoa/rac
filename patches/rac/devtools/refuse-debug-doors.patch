+  UseUserDataDir(other_);
+  EXPECT_FALSE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedInsideTheDefaultDir) {
+  const base::FilePath inside = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(inside.AppendASCII("deeper")));
+  UseUserDataDir(inside);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());

+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_RAC_DEVTOOLS_DEFAULT_DIR_H_
+#define CHROME_BROWSER_RAC_DEVTOOLS_DEFAULT_DIR_H_
+
+#include <stddef.h>
+
+#include <optional>
+#include <vector>
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace rac {
+
+// rac refuses Chromium's debug doors (--remote-debugging-port and
+// --remote-debugging-pipe, decision D20) on the user's real profile: the
+// default user data dir, or anything inside it. "The default" is
+// chrome::GetDefaultUserDataDirectory(), which follows $HOME and the
+// CrProductDirName key in Info.plist. The same folder under the home
+// directory in the password database counts too, so pointing $HOME elsewhere
+// doesn't hide the real one. So does rac's own `me.kainoa.rac` under both
+// homes, so a copy of the app with an edited Info.plist can't redefine it.
+// Paths are compared by file identity, so a symlink, a case variant, a
+// firmlink, or a `..` path to it counts too. When the answer is unknown, the
+// doors are refused.
+//
+// Two checks keep a door and the real profile from being open together,
+// whichever comes first. The door check refuses a door when DIR_USER_DATA is
+// the real profile, or when a profile inside it already loaded. Once a door
+// is open, the profile check refuses any profile inside the real one. Chrome
+// loads the first profile before RemoteDebuggingServer starts, so at startup
+// the door is the one refused and the profile still opens.
+//
+// Not covered, because file identity can't see them:
+// - Links planted inside an allowed profile that point at the real profile's
+//   files: symlinks to its files, or hard links, which share their inodes.
+// - Swapping folders after the check, such as renaming the real profile into
+//   place once its path has passed.
+// - Copies of the real profile's files.
+// - Cross-device mounts of the real profile (an NFS, bindfs, or other
+//   re-export), whose files have different identities.
+// Reading cookies or passwords through any of these needs the Keychain key
+// that decrypts them, and every user data dir shares that key. Forcing the
+// mock keychain while a door is open would close them; whether to is an open
+// decision for the maintainer, not implemented here.
+//
+// The file checks run only when a door was asked for, so a normal launch
+// does no file I/O here. They use plain syscalls, not base's file helpers,
+// because profiles can load on the UI thread after blocking is disallowed
+// there; they stat a few local folders.
+
+// Whether RemoteDebuggingServer must refuse a debug door: DIR_USER_DATA is
+// the real profile (IsDefaultUserDataDir()), or RefusesProfileForDebugDoors()
+// already let a profile inside the real one load.
+bool RefusesDebugDoors(std::optional<bool> is_default_by_path);
+
+// Records that RemoteDebuggingServer opened a debug door. From then on,
+// RefusesProfileForDebugDoors() refuses profiles inside the real one.
+void SetDebugDoorOpen();
+
+// Whether DIR_USER_DATA is the real profile's user data dir, or inside it.
+// `is_default_by_path` is chrome::IsUsingDefaultDataDirectory(), a plain path
+// compare; true or unknown (nullopt) counts as default.
+bool IsDefaultUserDataDir(std::optional<bool> is_default_by_path);
+
+// Whether ProfileManager must refuse to load the profile at `profile_dir`:
+// a debug door is open (SetDebugDoorOpen()) and `profile_dir` is the real
+// profile's user data dir or inside it. This closes a profile that escapes
+// DIR_USER_DATA, such as a `Default` symlink into the real profile or
+// `--profile-directory=..` from a user data dir inside it. Before a door
+// opens, such a profile loads, and RefusesDebugDoors() then keeps the doors
+// shut. Without a door switch on the command line, it touches no files.
+bool RefusesProfileForDebugDoors(const base::FilePath& profile_dir);
+
+// The identity check behind all of these: true if `path`, resolved, is one of
+// `default_dirs` or inside one. A default dir that doesn't exist has no
+// profile to protect and is skipped. True if any path can't be read for
+// another reason, or if `path` doesn't exist and has a `..` component.
+bool IsInsideDefaultDir(const base::FilePath& path,
+                        const std::vector<base::FilePath>& default_dirs);
+
+// The default user data dirs to protect, or none if they can't be computed
+// (then every check refuses).
+std::vector<base::FilePath> GetDefaultUserDataDirs();
+
+// The home directory in the password database, starting getpwuid_r() with a
+// `buffer_size` buffer and growing it while the entry doesn't fit.
+std::optional<base::FilePath> LookUpPasswordDatabaseHomeForTesting(
+    size_t buffer_size);
+
+// Replaces the home directory from the password database in tests, so they
+// never look at the real profile. An empty path acts as a failed lookup.
+// Pass nullopt to restore it.
+void SetPasswordDatabaseHomeForTesting(std::optional<base::FilePath> home);
+
+// Replaces the product dir that CrProductDirName names, the way an edited
+// Info.plist would. Pass nullopt to restore it.
+void SetProductDirForTesting(std::optional<base::FilePath> product_dir);
+
+// Forgets SetDebugDoorOpen() and any real profile that loaded.
+void ResetDebugDoorsForTesting();
+
+}  // namespace rac
+
+#endif  // CHROME_BROWSER_RAC_DEVTOOLS_DEFAULT_DIR_H_

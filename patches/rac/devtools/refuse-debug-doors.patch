+}
+
+// $HOME points elsewhere, so GetDefaultUserDataDirectory() names a folder
+// that isn't the real profile; the password database still names it.
+TEST_F(RacDefaultDirTest, RefusedOnTheRealHomesDefaultWhenHomeMoved) {
+  ASSERT_TRUE(base::CreateDirectory(passwd_default_dir_));
+  UseUserDataDir(passwd_default_dir_);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);

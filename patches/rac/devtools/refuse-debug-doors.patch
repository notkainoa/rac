+// A one-byte buffer can't hold any password database entry, so getpwuid_r()
+// reports ERANGE and the lookup retries with bigger buffers. Only the home's
+// path is read, never anything inside it.
+TEST(RacPasswordDatabaseTest, LookupRetriesWithABiggerBuffer) {
+  struct passwd entry = {};
+  struct passwd* found = nullptr;
+  std::string tiny(1, '\0');
+  ASSERT_EQ(getpwuid_r(getuid(), &entry, tiny.data(), tiny.size(), &found),
+            ERANGE);
+
+  const std::optional<base::FilePath> home =
+      LookUpPasswordDatabaseHomeForTesting(16 * 1024);
+  ASSERT_TRUE(home.has_value());
+  EXPECT_TRUE(home->IsAbsolute());
+  EXPECT_EQ(LookUpPasswordDatabaseHomeForTesting(1), home);
+  EXPECT_EQ(LookUpPasswordDatabaseHomeForTesting(0), home);
+}

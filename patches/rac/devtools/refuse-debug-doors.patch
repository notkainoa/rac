+class RacDefaultDirTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    // Resolved, so /var -> /private/var doesn't change any path below.
+    root_ = base::MakeAbsoluteFilePath(temp_dir_.GetPath());
+    ASSERT_FALSE(root_.empty());
+    app_data_.emplace(base::DIR_APP_DATA, root_.AppendASCII("AppData"),
+                      /*is_absolute=*/true, /*create=*/true);
+    ASSERT_TRUE(chrome::GetDefaultUserDataDirectory(&default_dir_));
+    ASSERT_TRUE(root_.IsParent(default_dir_)) << default_dir_;
+    ASSERT_TRUE(base::CreateDirectory(default_dir_));
+
+    // The home in the password database, where $HOME would point if it
+    // weren't changed. Its default dir doesn't exist unless a test makes it.
+    passwd_home_ = root_.AppendASCII("RealHome");
+    ASSERT_TRUE(base::CreateDirectory(passwd_home_));
+    SetPasswordDatabaseHomeForTesting(passwd_home_);
+    // The test binary has no CrProductDirName, so the product dir is rac's
+    // literal one and each home has a single default.
+    ASSERT_EQ(default_dir_.BaseName().value(), "me.kainoa.rac");
+    const std::vector<base::FilePath> dirs = GetDefaultUserDataDirs();
+    ASSERT_EQ(dirs.size(), 2u);
+    EXPECT_EQ(dirs[0], default_dir_);
+    passwd_default_dir_ = dirs[1];
+    ASSERT_TRUE(passwd_home_.IsParent(passwd_default_dir_));
+    EXPECT_EQ(passwd_default_dir_.BaseName(), default_dir_.BaseName());
+
+    other_ = root_.AppendASCII("profile");
+    ASSERT_TRUE(base::CreateDirectory(other_));
+  }
+
+  void TearDown() override {
+    chrome::SetUsingDefaultUserDataDirectoryForTesting(std::nullopt);
+    SetPasswordDatabaseHomeForTesting(std::nullopt);
+    SetProductDirForTesting(std::nullopt);
+    ResetDebugDoorsForTesting();
+  }
+
+  // Sets DIR_USER_DATA to `path` exactly as given. PathService would
+  // otherwise resolve it with realpath(), hiding what this test checks.
+  void UseUserDataDir(const base::FilePath& path) {
+    user_data_dir_.reset();
+    user_data_dir_.emplace(chrome::DIR_USER_DATA, path, /*is_absolute=*/true,
+                           /*create=*/false);
+  }
+
+  // What IsRemoteDebuggingAllowed() decides for the port and the pipe alike:
+  // both pass it the same chrome::IsUsingDefaultDataDirectory() value.
+  bool Refused() {
+    return IsDefaultUserDataDir(chrome::IsUsingDefaultDataDirectory());
+  }
+
+  void AskForThePort() {
+    command_line_.GetProcessCommandLine()->AppendSwitchASCII(
+        ::switches::kRemoteDebuggingPort, "0");
+  }
+
+  // What ProfileManager::CanCreateProfileAtPath() asks with the port open on
+  // `other_`, the way a test runner launches rac.
+  bool ProfileRefused(const base::FilePath& profile_dir) {
+    UseUserDataDir(other_);
+    AskForThePort();
+    SetDebugDoorOpen();
+    return RefusesProfileForDebugDoors(profile_dir);
+  }
+
+  base::ScopedTempDir temp_dir_;
+  base::FilePath root_;
+  base::FilePath default_dir_;
+  base::FilePath passwd_home_;
+  base::FilePath passwd_default_dir_;
+  base::FilePath other_;
+  base::test::ScopedCommandLine command_line_;
+  std::optional<base::ScopedPathOverride> app_data_;
+  std::optional<base::ScopedPathOverride> user_data_dir_;
+};

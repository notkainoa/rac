+// Copyright 2026 The rac Authors
+// Use of this source code is governed by a GPL-3.0 license.
+
+#include "chrome/browser/rac/devtools/default_dir.h"
+
+#include <errno.h>
+#include <pwd.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/memory/free_deleter.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/chrome_paths_internal.h"
+#include "content/public/common/content_switches.h"
+
+namespace rac {
+
+namespace {
+
+enum class Lookup { kFound, kMissing, kUnreadable };
+
+Lookup FromErrno() {
+  const int error = errno;
+  return error == ENOENT || error == ENOTDIR ? Lookup::kMissing
+                                             : Lookup::kUnreadable;
+}
+
+// stat() follows symlinks, and on a case-insensitive volume a case variant
+// names the same inode, so both land on the directory they point to.
+Lookup StatPath(const base::FilePath& path, struct stat* info) {
+  return stat(path.value().c_str(), info) == 0 ? Lookup::kFound : FromErrno();
+}
+
+// realpath() resolves every symlink and `..`, so walking up the result visits
+// the directories that really contain `path`.
+Lookup RealPath(const base::FilePath& path, base::FilePath* resolved) {
+  std::unique_ptr<char, base::FreeDeleter> result(
+      realpath(path.value().c_str(), nullptr));
+  if (!result) {
+    return FromErrno();
+  }
+  *resolved = base::FilePath(result.get());
+  return Lookup::kFound;
+}
+
+// `path` resolved, or its nearest existing ancestor resolved when `path`
+// doesn't exist yet (a profile folder about to be created). Dropping missing
+// names is only safe without `..`, which could climb out of them once they
+// exist, so such a path is unknown.
+std::optional<base::FilePath> ResolveNearestExisting(base::FilePath path) {
+  while (true) {
+    base::FilePath resolved;
+    switch (RealPath(path, &resolved)) {
+      case Lookup::kFound:
+        return resolved;
+      case Lookup::kUnreadable:
+        return std::nullopt;
+      case Lookup::kMissing:
+        break;
+    }
+    const base::FilePath parent = path.DirName();
+    if (path.ReferencesParent() || parent == path) {
+      return std::nullopt;
+    }
+    path = parent;
+  }
+}
+
+std::optional<base::FilePath>& PasswordDatabaseHomeOverride() {
+  static base::NoDestructor<std::optional<base::FilePath>> home;
+  return *home;
+}
+
+std::optional<base::FilePath> PasswordDatabaseHome() {
+  if (const std::optional<base::FilePath>& home =
+          PasswordDatabaseHomeOverride()) {
+    return home->empty() ? std::nullopt : home;
+  }
+  struct passwd entry = {};
+  struct passwd* found = nullptr;
+  std::string buffer(16 * 1024, '\0');
+  if (getpwuid_r(getuid(), &entry, buffer.data(), buffer.size(), &found) != 0 ||
+      !found || !found->pw_dir || found->pw_dir[0] != '/') {
+    return std::nullopt;
+  }
+  return base::FilePath(found->pw_dir);
+}
+
+bool IsInsideDefaultDirs(const base::FilePath& path) {
+  const std::vector<base::FilePath> default_dirs = GetDefaultUserDataDirs();
+  return default_dirs.empty() || IsInsideDefaultDir(path, default_dirs);
+}
+
+}  // namespace
+
+bool IsInsideDefaultDir(const base::FilePath& path,
+                        const std::vector<base::FilePath>& default_dirs) {
+  std::vector<struct stat> defaults;
+  for (const base::FilePath& default_dir : default_dirs) {
+    struct stat info = {};
+    switch (StatPath(default_dir, &info)) {
+      case Lookup::kFound:
+        defaults.push_back(info);
+        break;
+      case Lookup::kMissing:
+        break;
+      case Lookup::kUnreadable:
+        return true;
+    }
+  }
+  if (defaults.empty()) {
+    return false;
+  }
+
+  const std::optional<base::FilePath> resolved = ResolveNearestExisting(path);
+  if (!resolved) {
+    return true;
+  }
+  for (base::FilePath dir = *resolved;; dir = dir.DirName()) {
+    struct stat info = {};
+    if (StatPath(dir, &info) != Lookup::kFound) {
+      return true;
+    }
+    for (const struct stat& default_info : defaults) {
+      if (info.st_dev == default_info.st_dev &&
+          info.st_ino == default_info.st_ino) {
+        return true;
+      }
+    }
+    if (dir.DirName() == dir) {
+      return false;
+    }
+  }
+}
+
+std::vector<base::FilePath> GetDefaultUserDataDirs() {
+  base::FilePath default_dir;
+  base::FilePath app_data;
+  base::FilePath product_dir;
+  if (!chrome::GetDefaultUserDataDirectory(&default_dir) ||
+      !base::PathService::Get(base::DIR_APP_DATA, &app_data) ||
+      !app_data.AppendRelativePath(default_dir, &product_dir)) {
+    return {};
+  }
+  const std::optional<base::FilePath> home = PasswordDatabaseHome();
+  if (!home) {
+    return {};
+  }
+  return {default_dir, home->Append("Library")
+                           .Append("Application Support")
+                           .Append(product_dir)};
+}
+
+bool IsDefaultUserDataDir(std::optional<bool> is_default_by_path) {
+  if (is_default_by_path.value_or(true)) {
+    return true;
+  }
+  base::FilePath user_data_dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir)) {
+    return true;
+  }
+  return IsInsideDefaultDirs(user_data_dir);
+}
+
+bool RefusesProfileForDebugDoors(const base::FilePath& profile_dir) {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(::switches::kRemoteDebuggingPort) &&
+      !command_line.HasSwitch(::switches::kRemoteDebuggingPipe)) {
+    return false;
+  }
+  // On the default dir by path, IsDefaultUserDataDir() keeps both doors
+  // shut, so its profiles open as usual.
+  if (chrome::IsUsingDefaultDataDirectory().value_or(false)) {
+    return false;
+  }
+  return IsInsideDefaultDirs(profile_dir);
+}
+
+void SetPasswordDatabaseHomeForTesting(std::optional<base::FilePath> home) {
+  PasswordDatabaseHomeOverride() = std::move(home);
+}
+
+}  // namespace rac

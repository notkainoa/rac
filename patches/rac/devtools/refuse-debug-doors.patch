+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughASymlinkedParent) {
+  const base::FilePath link = root_.AppendASCII("link");
+  ASSERT_TRUE(base::CreateSymbolicLink(default_dir_.DirName(), link));
+  UseUserDataDir(link.Append(default_dir_.BaseName()));
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+// The real profile moved to another disk and linked back: the path compare
+// sees the link, the switch names where it points.
+TEST_F(RacDefaultDirTest, RefusedWhenTheDefaultIsASymlink) {
+  const base::FilePath moved = root_.AppendASCII("moved");
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  ASSERT_TRUE(base::CreateDirectory(moved));
+  ASSERT_TRUE(base::CreateSymbolicLink(moved, default_dir_));
+  UseUserDataDir(moved);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughACaseVariant) {
+  const base::FilePath variant = default_dir_.DirName().AppendASCII(
+      base::ToUpperASCII(default_dir_.BaseName().value()));
+  ASSERT_NE(variant, default_dir_);
+  if (!base::DirectoryExists(variant)) {
+    GTEST_SKIP() << "The temp volume is case-sensitive.";
+  }
+  UseUserDataDir(variant);
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedThroughDotDot) {
+  const base::FilePath sibling = default_dir_.DirName().AppendASCII("other");
+  ASSERT_TRUE(base::CreateDirectory(sibling));
+  UseUserDataDir(sibling.AppendASCII("..").Append(default_dir_.BaseName()));
+  EXPECT_EQ(chrome::IsUsingDefaultDataDirectory(), false);
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedWhenTheUserDataDirCannotBeRead) {
+  // Missing with a `..` after it: once created, it could climb anywhere.
+  UseUserDataDir(root_.AppendASCII("missing").AppendASCII(".."));
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, RefusedWhenTheRealHomeIsUnknown) {
+  UseUserDataDir(other_);
+  SetPasswordDatabaseHomeForTesting(base::FilePath());
+  EXPECT_TRUE(GetDefaultUserDataDirs().empty());
+  EXPECT_TRUE(Refused());
+}
+
+TEST_F(RacDefaultDirTest, IsInsideDefaultDir) {
+  const base::FilePath missing_default = root_.AppendASCII("no-default");
+  EXPECT_TRUE(IsInsideDefaultDir(default_dir_, {default_dir_}));
+  EXPECT_FALSE(IsInsideDefaultDir(other_, {default_dir_}));
+  EXPECT_FALSE(IsInsideDefaultDir(default_dir_, {missing_default}));
+  EXPECT_TRUE(
+      IsInsideDefaultDir(default_dir_, {missing_default, default_dir_}));
+  // A path that doesn't exist yet is judged by its nearest existing folder.
+  EXPECT_TRUE(IsInsideDefaultDir(
+      default_dir_.AppendASCII("new").AppendASCII("Default"), {default_dir_}));
+  EXPECT_FALSE(
+      IsInsideDefaultDir(other_.AppendASCII("Profile 1"), {default_dir_}));
+}
+
+// Profiles, which ProfileManager loads from DIR_USER_DATA.Append(name).
+
+TEST_F(RacDefaultDirTest, ProfileAllowedInsideAnotherDir) {
+  ASSERT_TRUE(base::CreateDirectory(other_.AppendASCII("Default")));
+  EXPECT_FALSE(ProfileRefused(other_.AppendASCII("Default")));
+  // A profile folder about to be created.
+  EXPECT_FALSE(ProfileRefused(other_.AppendASCII("Profile 1")));
+}
+
+// --user-data-dir=/tmp/x "--profile-directory=../../<real>/Default".
+TEST_F(RacDefaultDirTest, ProfileRefusedThroughDotDot) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  base::FilePath escape = other_;
+  for (size_t i = 0; i < other_.GetComponents().size() - 1; ++i) {
+    escape = escape.AppendASCII("..");
+  }
+  for (size_t i = 1; i < real_profile.GetComponents().size(); ++i) {
+    escape = escape.Append(real_profile.GetComponents()[i]);
+  }
+  ASSERT_TRUE(base::DirectoryExists(escape)) << escape;
+  EXPECT_TRUE(ProfileRefused(escape));
+}
+
+// --user-data-dir=<real>/Default/x --profile-directory=.., which also passes
+// ProfileManager::IsAllowedProfilePath() since DirName() strips the `..`.
+TEST_F(RacDefaultDirTest, ProfileRefusedThroughDotDotFromInside) {
+  const base::FilePath inside =
+      default_dir_.AppendASCII("Default").AppendASCII("x");
+  ASSERT_TRUE(base::CreateDirectory(inside));
+  UseUserDataDir(inside);
+  AskForThePort();
+  SetDebugDoorOpen();
+  EXPECT_TRUE(RefusesProfileForDebugDoors(inside.AppendASCII("..")));
+}
+
+TEST_F(RacDefaultDirTest, ProfileRefusedAtAnAbsolutePath) {
+  EXPECT_TRUE(ProfileRefused(default_dir_.AppendASCII("Default")));
+  EXPECT_TRUE(ProfileRefused(default_dir_));
+}
+
+// /tmp/x/Default is a symlink to the real profile: no switch names it.
+TEST_F(RacDefaultDirTest, ProfileRefusedThroughASymlink) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  const base::FilePath link = other_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateSymbolicLink(real_profile, link));
+  EXPECT_TRUE(ProfileRefused(link));
+}
+
+TEST_F(RacDefaultDirTest, ProfileRefusedInTheRealHomeWhenHomeMoved) {
+  const base::FilePath real_profile =
+      passwd_default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  const base::FilePath link = other_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateSymbolicLink(real_profile, link));
+  EXPECT_TRUE(ProfileRefused(link));
+}
+
+TEST_F(RacDefaultDirTest, ProfileRefusedWithThePipe) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  UseUserDataDir(other_);
+  command_line_.GetProcessCommandLine()->AppendSwitch(
+      ::switches::kRemoteDebuggingPipe);
+  SetDebugDoorOpen();
+  EXPECT_TRUE(RefusesProfileForDebugDoors(real_profile));
+}
+
+// Without a door switch, every profile loads as usual, nothing touches the
+// disk, and nothing is noted for the doors.
+TEST_F(RacDefaultDirTest, ProfileAllowedWithoutADoorSwitch) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  UseUserDataDir(other_);
+  EXPECT_FALSE(RefusesProfileForDebugDoors(real_profile));
+  EXPECT_FALSE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+}
+
+// A door switch alone refuses no profile: only an open door does. Here the
+// real profile is reached through a symlinked user data dir, so the door is
+// refused and the profile still opens instead of showing a profile error.
+TEST_F(RacDefaultDirTest, ProfileAllowedWhenTheDoorWasRefused) {
+  const base::FilePath link = root_.AppendASCII("link");
+  ASSERT_TRUE(base::CreateSymbolicLink(default_dir_, link));
+  UseUserDataDir(link);
+  AskForThePort();
+  EXPECT_TRUE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+  EXPECT_FALSE(RefusesProfileForDebugDoors(link.AppendASCII("Default")));
+
+  // The same through a symlinked home that holds the default dir.
+  const base::FilePath home_link = root_.AppendASCII("home-link");
+  ASSERT_TRUE(base::CreateSymbolicLink(root_, home_link));
+  const base::FilePath via_home =
+      home_link.Append(default_dir_.DirName().BaseName())
+          .Append(default_dir_.BaseName());
+  UseUserDataDir(via_home);
+  EXPECT_TRUE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+  EXPECT_FALSE(RefusesProfileForDebugDoors(via_home.AppendASCII("Default")));
+}
+
+// On the default dir by path, the doors stay shut and its profiles open.
+TEST_F(RacDefaultDirTest, ProfileAllowedOnTheDefaultDirWithADoorSwitch) {
+  UseUserDataDir(default_dir_);
+  command_line_.GetProcessCommandLine()->AppendSwitchASCII(
+      ::switches::kRemoteDebuggingPort, "9222");
+  EXPECT_TRUE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+  EXPECT_FALSE(
+      RefusesProfileForDebugDoors(default_dir_.AppendASCII("Default")));
+}
+
+// Chrome loads the first profile before it opens a door. A `Default` symlink
+// into the real profile loads, and then the door is refused.
+TEST_F(RacDefaultDirTest, DoorRefusedOnceTheRealProfileLoaded) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  const base::FilePath link = other_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateSymbolicLink(real_profile, link));
+  UseUserDataDir(other_);
+  AskForThePort();
+  EXPECT_FALSE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+  EXPECT_FALSE(RefusesProfileForDebugDoors(other_.AppendASCII("Profile 1")));
+  EXPECT_FALSE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+  EXPECT_FALSE(RefusesProfileForDebugDoors(link));
+  EXPECT_TRUE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+}
+
+// Once a door is open, only profiles inside the real one are refused.
+TEST_F(RacDefaultDirTest, ProfileRefusedOnlyOnceADoorIsOpen) {
+  const base::FilePath real_profile = default_dir_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(real_profile));
+  const base::FilePath link = other_.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateSymbolicLink(real_profile, link));
+  UseUserDataDir(other_);
+  AskForThePort();
+  EXPECT_FALSE(RefusesProfileForDebugDoors(other_.AppendASCII("Profile 1")));
+  SetDebugDoorOpen();
+  EXPECT_TRUE(RefusesProfileForDebugDoors(link));
+  EXPECT_FALSE(RefusesProfileForDebugDoors(other_.AppendASCII("Profile 1")));
+  // Refusing it didn't note it as loaded.
+  EXPECT_FALSE(RefusesDebugDoors(chrome::IsUsingDefaultDataDirectory()));
+}
+
+// A copy of rac whose Info.plist sets CrProductDirName to another folder still
+// can't open a door on `me.kainoa.rac`, under either home.
+TEST_F(RacDefaultDirTest, RefusedOnRacsProductDirWhenThePlistRenamesIt) {
+  SetProductDirForTesting(base::FilePath("net.example.edited"));
+  const base::FilePath edited =
+      default_dir_.DirName().Append("net.example.edited");
+  const base::FilePath passwd_rac = passwd_home_.Append("Library")
+                                        .Append("Application Support")
+                                        .Append("me.kainoa.rac");
+  const std::vector<base::FilePath> dirs = GetDefaultUserDataDirs();
+  ASSERT_EQ(dirs.size(), 4u);
+  EXPECT_EQ(dirs[0], edited);
+  EXPECT_TRUE(std::ranges::contains(dirs, default_dir_));
+  EXPECT_TRUE(std::ranges::contains(dirs, passwd_rac));
+  EXPECT_TRUE(std::ranges::contains(dirs, passwd_home_.Append("Library")
+                                              .Append("Application Support")
+                                              .Append("net.example.edited")));
+
+  // The path compare follows the edited name, so it says "not default".
+  UseUserDataDir(default_dir_);
+  EXPECT_TRUE(IsDefaultUserDataDir(/*is_default_by_path=*/false));
+  UseUserDataDir(default_dir_.AppendASCII("Default"));
+  EXPECT_TRUE(IsDefaultUserDataDir(/*is_default_by_path=*/false));
+
+  ASSERT_TRUE(base::DeletePathRecursively(default_dir_));
+  ASSERT_TRUE(base::CreateDirectory(passwd_rac));
+  UseUserDataDir(passwd_rac);
+  EXPECT_TRUE(IsDefaultUserDataDir(/*is_default_by_path=*/false));
+
+  // The edited folder is protected as well, and an unrelated one isn't.
+  ASSERT_TRUE(base::CreateDirectory(edited));
+  UseUserDataDir(edited);
+  EXPECT_TRUE(IsDefaultUserDataDir(/*is_default_by_path=*/false));
+  UseUserDataDir(other_);
+  EXPECT_FALSE(IsDefaultUserDataDir(/*is_default_by_path=*/false));
+}

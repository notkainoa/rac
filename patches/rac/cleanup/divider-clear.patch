+// Whether `view` is `tab`'s view or holds it, as a group or split does.
+bool ShowsTab(const views::View* view, const tabs::TabInterface* tab) {
+  if (const auto* tab_view = views::AsViewClass<TabView>(view)) {
+    return tab_view->GetTabInterface() == tab;
+  }
+  return std::ranges::any_of(view->children(), [tab](const views::View* child) {
+    return ShowsTab(child, tab);
+  });
+}

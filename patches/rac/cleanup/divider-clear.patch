+void PinnedSection::ShowKeptRows() {
+  if (!browser_ || !container_) {
+    return;
+  }
+  // Both are lookups that make nothing until the window's first Clear.
+  const bool undo = cleanup::HasPendingUndo(browser_);
+  std::vector<std::pair<tabs::TabHandle, int>> kept =
+      cleanup::TakeKeptTabs(browser_);
+  if (!undo && kept.empty()) {
+    // Undone, or never cleared: the notes have nothing left to explain.
+    if (kept_timer_ && kept_timer_->IsRunning()) {
+      kept_timer_->Stop();
+      HideKeptRows();
+    }
+    return;
+  }
+  if (kept.empty()) {
+    // An Undo is now offered, or still is; keep the notes already showing.
+    if (!kept_timer_ || !kept_timer_->IsRunning()) {
+      StartKeptTimer();
+    }
+    return;
+  }
+  HideKeptRows();
+  for (const auto& [handle, message_id] : kept) {
+    kept_rows_.emplace_back(
+        handle,
+        container_->AddChildView(std::make_unique<KeptReasonRow>(message_id)));
+  }
+  StartKeptTimer();
+  container_->InvalidateLayout();
+}
+
+void PinnedSection::StartKeptTimer() {
+  if (!kept_timer_) {
+    kept_timer_ = std::make_unique<base::OneShotTimer>();
+  }
+  kept_timer_->Start(FROM_HERE, cleanup::KeptNotesDuration(),
+                     base::BindOnce(&PinnedSection::EndClear,
+                                    base::Unretained(this)));
+}
+
+void PinnedSection::EndClear() {
+  HideKeptRows();
+}
+
+void PinnedSection::HideKeptRows() {
+  if (!container_ || kept_rows_.empty()) {
+    return;
+  }
+  // Out of the list first: each removal lays the container out again.
+  std::vector<std::pair<tabs::TabHandle, raw_ptr<views::View>>> rows;
+  std::swap(rows, kept_rows_);
+  // Closed by the animating layout manager before it deletes them, as
+  // folder headers are.
+  auto* layout_manager = static_cast<TabCollectionAnimatingLayoutManager*>(
+      container_->GetLayoutManager());
+  for (auto& [handle, row] : rows) {
+    views::View* view = row;
+    row = nullptr;
+    layout_manager->AnimateAndDestroyChildView(view);
+  }
+  container_->InvalidateLayout();
 }
 

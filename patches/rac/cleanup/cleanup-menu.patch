+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace rac::cleanup {
+
+// When `contents` last stopped being its window's selected tab, or null if
+// it hasn't since this run of the browser started. Kept on the tab in
+// memory only: after a restart, IsInactiveFor() falls back to the last time
+// the tab was shown, which session restore keeps.
+base::Time GetLastDeselected(content::WebContents* contents);
+
+// Stamps each tab of a window's tab strip with the time it stops being the
+// selected tab, for GetLastDeselected(). The window's clean-up button owns
+// one, so only windows that can Clear keep the stamps.
+class DeselectionStamps : public TabStripModelObserver {
+ public:
+  explicit DeselectionStamps(TabStripModel* model);
+  DeselectionStamps(const DeselectionStamps&) = delete;
+  DeselectionStamps& operator=(const DeselectionStamps&) = delete;
+  ~DeselectionStamps() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+};
+
+}  // namespace rac::cleanup

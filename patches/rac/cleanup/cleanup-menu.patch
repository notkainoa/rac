+
+#include "chrome/browser/ui/rac/cleanup/inactive_tabs.h"
+
+#include <algorithm>
+
+namespace rac::cleanup {
+
+bool IsInactiveFor(base::Time last_shown,
+                   base::Time last_left,
+                   bool selected,
+                   base::Time now,
+                   base::TimeDelta period) {
+  const base::Time last_used = std::max(last_shown, last_left);
+  if (selected || last_used.is_null() || last_used > now) {
+    return false;
+  }
+  return now - last_used >= period;
+}
+
+}  // namespace rac::cleanup

+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace rac {
+
+namespace {
+
+using gfx::CANVAS_DIMENSIONS;
+using gfx::CLOSE;
+using gfx::LINE_TO;
+using gfx::MOVE_TO;
+using gfx::NEW_PATH;
+using gfx::QUADRATIC_TO;
+using gfx::STROKE;
+
+// A broom leaning right: the handle up to the top right, a band, and the
+// bristles flaring down to the left with two strands. Drawn in strokes as
+// heavy as the outlined icons beside it (the profile button, the app menu).
+// clang-format off
+constexpr gfx::PathElement kBroomPath[] = {
+    CANVAS_DIMENSIONS, 20,
+    // The handle.
+    STROKE, 1.5f,
+    MOVE_TO, 17.48f, 2.52f,
+    LINE_TO, 12.29f, 7.71f,
+    // The band, a pill across the top of the bristles.
+    NEW_PATH,
+    STROKE, 2,
+    MOVE_TO, 10.08f, 6.72f,
+    LINE_TO, 13.28f, 9.92f,
+    // The bristles.
+    NEW_PATH,
+    STROKE, 1.5f,
+    MOVE_TO, 8.4f, 7.63f,
+    LINE_TO, 2.52f, 10.77f,
+    QUADRATIC_TO, 5.19f, 14.81f, 9.23f, 17.48f,
+    LINE_TO, 12.37f, 11.6f,
+    CLOSE,
+    // Two strands.
+    NEW_PATH,
+    STROKE, 1.5f,
+    MOVE_TO, 7.79f, 10.84f,
+    LINE_TO, 5.19f, 12.83f,
+    NEW_PATH,
+    STROKE, 1.5f,
+    MOVE_TO, 9.16f, 12.21f,
+    LINE_TO, 7.17f, 14.81f,
+};
+// clang-format on
+constexpr gfx::VectorIconRep kBroomReps[] = {{kBroomPath}};
+constexpr gfx::VectorIcon kBroomIcon = {kBroomReps, std::size(kBroomReps),
+                                        "rac_broom"};
+
+// The menu, top to bottom: a title, one item per kInactivePeriods entry,
+// then Clear All.
+constexpr int kFirstPeriodCommand = 1;
+constexpr int kClearAllCommand = 100;
+constexpr int kPeriodLabels[] = {
+    IDS_RAC_CLEANUP_5_HOURS,
+    IDS_RAC_CLEANUP_1_DAY,
+    IDS_RAC_CLEANUP_2_DAYS,
+    IDS_RAC_CLEANUP_5_DAYS,
+};
+static_assert(std::size(kPeriodLabels) == std::size(cleanup::kInactivePeriods));
+
+}  // namespace
+
+// static
+std::unique_ptr<CleanupButton> CleanupButton::CreateFor(
+    BrowserWindowInterface* browser) {
+  if (!browser || browser->GetProfile()->IsOffTheRecord() ||
+      !SpacesWindowManager::From(browser)) {
+    return nullptr;
+  }
+  return std::make_unique<CleanupButton>(browser);
+}
+
+CleanupButton::CleanupButton(BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(&CleanupButton::ShowMenu,
+                                        base::Unretained(this))),
+      browser_(browser),
+      stamps_(std::make_unique<cleanup::DeselectionStamps>(
+          browser->GetTabStripModel())) {
+  SetVectorIcon(kBroomIcon);
+  const std::u16string name = l10n_util::GetStringUTF16(IDS_RAC_CLEANUP_BUTTON);
+  SetTooltipText(name);
+  GetViewAccessibility().SetName(name);
+  GetViewAccessibility().SetHasPopup(ax::mojom::HasPopup::kMenu);
+}
+
+CleanupButton::~CleanupButton() = default;
+
+bool CleanupButton::IsMenuShowing() const {
+  return menu_runner_ && menu_runner_->IsRunning();
+}
+
+bool CleanupButton::IsCommandIdEnabled(int command_id) const {
+  // Greyed out when it would close nothing. Neither runs MayClear(), so an
+  // item can still find every tab it looks at busy.
+  if (command_id == kClearAllCommand) {
+    return action_table::IsBrowserCommandEnabled(browser_,
+                                                 IDC_RAC_CLEAR_TABS) &&
+           cleanup::HasOpenTabs(browser_);
+  }
+  const std::optional<base::TimeDelta> period = PeriodFor(command_id);
+  return period && cleanup::HasOpenTabs(browser_, period);
+}
+
+void CleanupButton::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id == kClearAllCommand) {
+    action_table::ExecuteBrowserCommand(browser_, IDC_RAC_CLEAR_TABS);
+  } else if (const std::optional<base::TimeDelta> period =
+                 PeriodFor(command_id)) {
+    cleanup::ClearTabs(browser_, period);
+  } else {
+    return;
+  }
+  ShowKeptNotes();
+}
+
+void CleanupButton::ShowMenu(const ui::Event& event) {
+  if (menu_runner_ && menu_runner_->IsRunning()) {
+    return;
+  }
+  // The press that closed the menu mustn't reopen it. An event without a
+  // time (a synthetic one) is never that press.
+  const base::TimeTicks closed =
+      menu_runner_ ? menu_runner_->closing_event_time() : base::TimeTicks();
+  if (!event.time_stamp().is_null() && !closed.is_null() &&
+      event.time_stamp() <= closed) {
+    return;
+  }
+  if (!GetWidget()) {
+    return;
+  }
+  // The last menu's runner points at its model; let go of both, runner first.
+  menu_runner_.reset();
+  model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  model_->AddTitle(l10n_util::GetStringUTF16(IDS_RAC_CLEANUP_INACTIVE_TITLE));
+  for (size_t i = 0; i < std::size(kPeriodLabels); ++i) {
+    model_->AddItemWithStringId(kFirstPeriodCommand + static_cast<int>(i),
+                                kPeriodLabels[i]);
+  }
+  model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  model_->AddItemWithStringId(kClearAllCommand, IDS_RAC_CLEANUP_CLEAR_ALL);
+
+  SetHighlighted(true);
+  // Made for each menu: the model it shows is.
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      model_.get(), views::MenuRunner::NO_FLAGS,
+      base::BindRepeating(&CleanupButton::OnMenuClosed,
+                          base::Unretained(this)));
+  // Up from the bottom of the sidebar, and in from the window's edge the
+  // button sits at.
+  const bool at_left_edge =
+      GetBoundsInScreen().CenterPoint().x() <
+      GetWidget()->GetWindowBoundsInScreen().CenterPoint().x();
+  menu_runner_->RunMenuAt(
+      GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+      at_left_edge ? views::MenuAnchorPosition::kBubbleTopRight
+                   : views::MenuAnchorPosition::kBubbleTopLeft,
+      ui::GetMenuSourceTypeForEvent(event));
+}
+
+void CleanupButton::OnMenuClosed() {
+  SetHighlighted(false);
+}
+
+// static
+std::optional<base::TimeDelta> CleanupButton::PeriodFor(int command_id) {
+  const int index = command_id - kFirstPeriodCommand;
+  if (index < 0 ||
+      static_cast<size_t>(index) >= std::size(cleanup::kInactivePeriods)) {
+    return std::nullopt;
+  }
+  return cleanup::kInactivePeriods[index];
+}
+
+void CleanupButton::ShowKeptNotes() {
+  for (views::View* view = parent(); view; view = view->parent()) {
+    if (auto* region = views::AsViewClass<BaseTabStripRegionView>(view)) {
+      if (PinnedSection* section =
+              PinnedSection::Get(region->GetUnpinnedTabsContainer())) {
+        section->ShowKeptRows();
+      }
+      return;
+    }
+  }
+}

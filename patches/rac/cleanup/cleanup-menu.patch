+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_CLEANUP_INACTIVE_TABS_H_
+#define CHROME_BROWSER_UI_RAC_CLEANUP_INACTIVE_TABS_H_
+
+#include "base/time/time.h"
+
+// Which tabs the sidebar's clean-up menu counts as unused, as plain data so
+// it can be tested without a browser. clear_tabs.cc reads the times from
+// real tabs.
+namespace rac::cleanup {
+
+// The clean-up menu's choices, shortest first: Clear the open tabs nobody
+// has looked at for this long.
+inline constexpr base::TimeDelta kInactivePeriods[] = {
+    base::Hours(5),
+    base::Days(1),
+    base::Days(2),
+    base::Days(5),
+};
+
+// Whether a tab has gone unused for at least `period` by `now`. A tab was
+// last used when it was last left, if that's known, and otherwise when it
+// was last shown:
+// - `last_shown` is TabInterface::GetLastActiveTime(), which Chromium sets
+//   when the tab becomes visible, not when it's left, and which session
+//   restore keeps.
+// - `last_left` is when the tab stopped being its window's selected tab
+//   (GetLastDeselected()). It isn't saved, so after a restart it's null
+//   until the tab is selected and left again, and `last_shown` decides.
+// The later of the two counts. The selected tab is in use, however long ago
+// it was selected; that includes the selected tab of a window in the
+// background. So is a tab without either time, or whose time is after
+// `now` (the clock moved back): Clear closes only tabs it knows are old.
+bool IsInactiveFor(base::Time last_shown,
+                   base::Time last_left,
+                   bool selected,
+                   base::Time now,
+                   base::TimeDelta period);
+
+}  // namespace rac::cleanup
+
+#endif  // CHROME_BROWSER_UI_RAC_CLEANUP_INACTIVE_TABS_H_

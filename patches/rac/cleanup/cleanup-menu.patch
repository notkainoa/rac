+// The broom at the bottom of the sidebar, at the window's edge across the
+// footer from the app menu. Its menu clears the space's open tabs nobody has
+// looked at for 5 hours, a day, 2 days or 5 days, or all of them. Each is
+// one Clear: MayClear() keeps busy tabs, with notes under them, and one
+// toast offers Undo. Clear All is the clear_tabs row (IDC_RAC_CLEAR_TABS),
+// as in the command bar and on Shift+Cmd+K.
+class CleanupButton : public ToolbarButton,
+                      public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(CleanupButton, ToolbarButton)
+
+ public:
+  // Null for a window Clear doesn't work in: one without spaces, such as
+  // incognito, guest, apps, and popups.
+  static std::unique_ptr<CleanupButton> CreateFor(
+      BrowserWindowInterface* browser);
+
+  explicit CleanupButton(BrowserWindowInterface* browser);
+  CleanupButton(const CleanupButton&) = delete;
+  CleanupButton& operator=(const CleanupButton&) = delete;
+  ~CleanupButton() override;
+
+  bool IsMenuShowing() const;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  void ShowMenu(const ui::Event& event);
+  void OnMenuClosed();
+  // The period a menu command clears tabs inactive for, or nullopt for Clear
+  // All.
+  static std::optional<base::TimeDelta> PeriodFor(int command_id);
+  // Shows, under the tabs the Clear just kept, why it kept them. Clear
+  // hands them over only within its own task, and only the sidebar's tab
+  // list can show them.
+  void ShowKeptNotes();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  // When each tab was last left, for the inactive choices.
+  std::unique_ptr<cleanup::DeselectionStamps> stamps_;
+  std::unique_ptr<ui::SimpleMenuModel> model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+}  // namespace rac

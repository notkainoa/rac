+#include "chrome/browser/ui/rac/cleanup/last_deselected.h"
+
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace rac::cleanup {
+
+namespace {
+
+class LastDeselected : public content::WebContentsUserData<LastDeselected> {
+ public:
+  LastDeselected(const LastDeselected&) = delete;
+  LastDeselected& operator=(const LastDeselected&) = delete;
+  ~LastDeselected() override = default;
+
+  base::Time time() const { return time_; }
+  void set_time(base::Time time) { time_ = time; }
+
+ private:
+  friend class content::WebContentsUserData<LastDeselected>;
+  explicit LastDeselected(content::WebContents* contents)
+      : content::WebContentsUserData<LastDeselected>(*contents) {}
+
+  base::Time time_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LastDeselected);
+
+}  // namespace
+
+base::Time GetLastDeselected(content::WebContents* contents) {
+  const LastDeselected* stamp =
+      contents ? LastDeselected::FromWebContents(contents) : nullptr;
+  return stamp ? stamp->time() : base::Time();
+}
+
+DeselectionStamps::DeselectionStamps(TabStripModel* model) {
+  model->AddObserver(this);
+}
+
+DeselectionStamps::~DeselectionStamps() = default;
+
+void DeselectionStamps::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // Only a tab still in the strip: not one closing, which may be on its way
+  // to being deleted.
+  if (!selection.active_tab_changed() || !selection.old_contents ||
+      tab_strip_model->GetIndexOfWebContents(selection.old_contents) ==
+          TabStripModel::kNoTab) {
+    return;
+  }
+  LastDeselected::GetOrCreateForWebContents(selection.old_contents)
+      ->set_time(base::Time::Now());
+}
+
+}  // namespace rac::cleanup

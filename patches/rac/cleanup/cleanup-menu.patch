+
+void RacSidebarFooterView::PlaceCleanupButton() {
+  if (!cleanup_button_) {
+    return;
+  }
+  // The app menu sits toward the page, so clean-up takes the window's edge:
+  // bottom left beside a left sidebar, bottom right beside a right one.
+  const size_t center = GetIndexOf(spacer_).value();
+  const views::View* menu =
+      FindToolbarChild(this, kToolbarAppMenuButtonElementId);
+  const bool menu_first = menu && GetIndexOf(menu).value() < center;
+  ReorderChildView(cleanup_button_, menu_first ? children().size() : 0);
+  // The center gives up as much room on its other side, so the space
+  // switcher stays where it was.
+  const int width =
+      collapsed_ ? 0 : cleanup_button_->GetPreferredSize().width();
+  spacer_->SetProperty(views::kMarginsKey,
+                       menu_first ? gfx::Insets::TLBR(0, width, 0, 0)
+                                  : gfx::Insets::TLBR(0, 0, 0, width));
+}
+
+bool RacSidebarFooterView::IsCleanupMenuShowing() const {
+  const auto* button = views::AsViewClass<rac::CleanupButton>(cleanup_button_);
+  return button && button->IsMenuShowing();
+}

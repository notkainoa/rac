+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/cleanup/inactive_tabs.h"
+
+#include <algorithm>
+#include <iterator>
+
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::cleanup {
+namespace {
+
+// A fixed "now", far from the epoch, so subtracting days stays valid.
+base::Time Now() {
+  return base::Time::UnixEpoch() + base::Days(20000);
+}
+
+// Unknown: the tab hasn't been left since the browser started.
+constexpr base::Time kNeverLeft;
+
+TEST(InactiveTabsTest, PeriodsAreTheMenusChoicesShortestFirst) {
+  ASSERT_EQ(std::size(kInactivePeriods), 4u);
+  EXPECT_EQ(kInactivePeriods[0], base::Hours(5));
+  EXPECT_EQ(kInactivePeriods[1], base::Days(1));
+  EXPECT_EQ(kInactivePeriods[2], base::Days(2));
+  EXPECT_EQ(kInactivePeriods[3], base::Days(5));
+  EXPECT_TRUE(std::ranges::is_sorted(kInactivePeriods));
+}
+
+TEST(InactiveTabsTest, ATabUnusedForThePeriodIsInactive) {
+  EXPECT_TRUE(IsInactiveFor(Now() - base::Hours(6), kNeverLeft,
+                            /*selected=*/false, Now(), base::Hours(5)));
+}
+
+TEST(InactiveTabsTest, ATabUsedWithinThePeriodIsNot) {
+  EXPECT_FALSE(IsInactiveFor(Now() - base::Hours(4), kNeverLeft,
+                             /*selected=*/false, Now(), base::Hours(5)));
+  EXPECT_FALSE(IsInactiveFor(Now(), kNeverLeft, /*selected=*/false, Now(),
+                             base::Hours(5)));
+}
+
+TEST(InactiveTabsTest, ThePeriodItselfCounts) {
+  EXPECT_TRUE(IsInactiveFor(Now() - base::Days(1), kNeverLeft,
+                            /*selected=*/false, Now(), base::Days(1)));
+  EXPECT_FALSE(IsInactiveFor(Now() - base::Days(1) + base::Seconds(1),
+                             kNeverLeft, /*selected=*/false, Now(),
+                             base::Days(1)));
+}
+
+TEST(InactiveTabsTest, EachChoiceTakesTheTabsAtLeastThatOld) {
+  // A tab last used two days ago goes with 5 hours, 1 day and 2 days, but
+  // not with 5 days.
+  const base::Time two_days_ago = Now() - base::Days(2);
+  for (size_t i = 0; i < 3; ++i) {
+    EXPECT_TRUE(IsInactiveFor(two_days_ago, kNeverLeft, false, Now(),
+                              kInactivePeriods[i]))
+        << i;
+  }
+  EXPECT_FALSE(IsInactiveFor(two_days_ago, kNeverLeft, false, Now(),
+                             kInactivePeriods[3]));
+}
+
+TEST(InactiveTabsTest, ATabReadForHoursAndJustLeftIsNotInactive) {
+  // Selected at 9:00, read until 14:59, cleared at 15:00: it was in use a
+  // minute ago, though it was shown six hours ago.
+  EXPECT_FALSE(IsInactiveFor(Now() - base::Hours(6), Now() - base::Minutes(1),
+                             /*selected=*/false, Now(), base::Hours(5)));
+}
+
+TEST(InactiveTabsTest, ATabLeftLongAgoIsInactive) {
+  EXPECT_TRUE(IsInactiveFor(Now() - base::Hours(9), Now() - base::Hours(8),
+                            /*selected=*/false, Now(), base::Hours(5)));
+}
+
+TEST(InactiveTabsTest, ALaterShowingCountsOverAnEarlierLeaving) {
+  // Left long ago, shown again a minute ago (and left before this run kept
+  // track): the showing is the later use.
+  EXPECT_FALSE(IsInactiveFor(Now() - base::Minutes(1), Now() - base::Days(3),
+                             /*selected=*/false, Now(), base::Hours(5)));
+}
+
+TEST(InactiveTabsTest, TheSelectedTabIsAlwaysInUse) {
+  // Selected long ago and still showing, in this window or a window in the
+  // background: in use, not old.
+  EXPECT_FALSE(IsInactiveFor(Now() - base::Days(30), kNeverLeft,
+                             /*selected=*/true, Now(), base::Hours(5)));
+  EXPECT_FALSE(IsInactiveFor(Now() - base::Days(30), Now() - base::Days(29),
+                             /*selected=*/true, Now(), base::Hours(5)));
+}
+
+TEST(InactiveTabsTest, ATabWithoutATimeIsNotInactive) {
+  EXPECT_FALSE(IsInactiveFor(base::Time(), kNeverLeft, /*selected=*/false,
+                             Now(), base::Hours(5)));
+}
+
+TEST(InactiveTabsTest, ATimeAfterNowIsNotInactive) {
+  // The clock moved back since the tab was last used.
+  EXPECT_FALSE(IsInactiveFor(Now() + base::Days(3), kNeverLeft,
+                             /*selected=*/false, Now(), base::Hours(5)));
+  EXPECT_FALSE(IsInactiveFor(Now() - base::Days(3), Now() + base::Days(1),
+                             /*selected=*/false, Now(), base::Hours(5)));
+}
+
+}  // namespace
+}  // namespace rac::cleanup

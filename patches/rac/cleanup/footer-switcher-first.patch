+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/cleanup/footer_fit.h"
+
+#include <cstddef>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::cleanup {
+
+namespace {
+
+// The space switcher's place size (kSwitcherSlotSize in
+// chrome/browser/rac/spaces/switcher_fit.h) and the broom's width.
+constexpr int kSlot = 24;
+constexpr int kBroom = 28;
+
+// The switcher's width with every dot and New Space showing.
+constexpr int Need(size_t spaces) {
+  return static_cast<int>(spaces + 1) * kSlot;
+}
+
+}  // namespace
+
+TEST(FooterFitTest, AWideRowShowsTheBroomAndCentersTheSwitcher) {
+  constexpr int room = 200;
+  EXPECT_EQ(
+      FitFooter(room, Need(2), kBroom),
+      (FooterFit{
+          .broom = true, .balance = kBroom, .switcher = room - 2 * kBroom}));
+}
+
+TEST(FooterFitTest, TheBalanceGetsOnlyWhatTheSwitcherLeaves) {
+  // Room for every dot and the broom, and 10 px to spare.
+  constexpr int room = Need(2) + kBroom + 10;
+  EXPECT_EQ(FitFooter(room, Need(2), kBroom),
+            (FooterFit{.broom = true, .balance = 10, .switcher = Need(2)}));
+}
+
+TEST(FooterFitTest, TheBroomShowsWithExactlyEnoughRoom) {
+  constexpr int room = Need(3) + kBroom;
+  EXPECT_EQ(FitFooter(room, Need(3), kBroom),
+            (FooterFit{.broom = true, .balance = 0, .switcher = Need(3)}));
+}
+
+TEST(FooterFitTest, TheBroomYieldsBeforeTheSwitcherLosesADot) {
+  // One px short of every dot beside the broom: the broom goes and the
+  // switcher gets the whole row.
+  constexpr int room = Need(2) + kBroom - 1;
+  EXPECT_EQ(FitFooter(room, Need(2), kBroom),
+            (FooterFit{.broom = false, .balance = 0, .switcher = room}));
+  EXPECT_GE(FitFooter(room, Need(2), kBroom).switcher, Need(2));
+}
+
+TEST(FooterFitTest, FewerSpacesBringTheBroomBack) {
+  constexpr int room = Need(2) + kBroom - 1;
+  EXPECT_FALSE(FitFooter(room, Need(2), kBroom).broom);
+  EXPECT_TRUE(FitFooter(room, Need(1), kBroom).broom);
+}
+
+TEST(FooterFitTest, AWiderRowBringsTheBroomBack) {
+  EXPECT_FALSE(FitFooter(Need(3) + kBroom - 1, Need(3), kBroom).broom);
+  EXPECT_TRUE(FitFooter(Need(3) + kBroom, Need(3), kBroom).broom);
+}
+
+TEST(FooterFitTest, TheDefaultSidebarFitsThreeSpacesAndTheBroom) {
+  // A 200 DIP sidebar has a 184 DIP footer row. The profile button and the
+  // app menu take 28 DIP each with a 1 DIP margin on each side.
+  constexpr int room = 184 - 2 * (28 + 2 * 1);
+  EXPECT_EQ(FitFooter(room, Need(3), kBroom),
+            (FooterFit{.broom = true, .balance = 0, .switcher = Need(3)}));
+  EXPECT_EQ(FitFooter(room, Need(4), kBroom),
+            (FooterFit{.broom = false, .balance = 0, .switcher = room}));
+}
+
+TEST(FooterFitTest, ManySpacesInANarrowRowGetTheWholeRowWithoutTheBroom) {
+  // More spaces than fit even alone: the switcher falls back to its list
+  // button in the whole row, as it did before the broom.
+  constexpr int room = 90;
+  EXPECT_EQ(FitFooter(room, Need(6), kBroom),
+            (FooterFit{.broom = false, .balance = 0, .switcher = room}));
+}
+
+TEST(FooterFitTest, NoRoomGivesNothing) {
+  EXPECT_EQ(FitFooter(-12, Need(1), kBroom), (FooterFit{}));
+  EXPECT_EQ(FitFooter(0, Need(1), kBroom), (FooterFit{}));
+}
+
+}  // namespace rac::cleanup

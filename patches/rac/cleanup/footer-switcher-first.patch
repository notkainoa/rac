+// The margin on each side of the profile button and the app menu in a
+// footer row with the clean-up button: half the toolbar's, so the default
+// sidebar fits three spaces' dots and the button.
+constexpr int kFooterControlMargin = 1;
+
+void SetMargins(views::View* view, const std::optional<gfx::Insets>& margins) {
+  const gfx::Insets* current = view->GetProperty(views::kMarginsKey);
+  if (!margins) {
+    if (current) {
+      view->ClearProperty(views::kMarginsKey);
+    }
+    return;
+  }
+  if (!current || *current != *margins) {
+    view->SetProperty(views::kMarginsKey, *margins);
+  }
+}

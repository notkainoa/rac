+#ifndef CHROME_BROWSER_UI_RAC_CLEANUP_FOOTER_FIT_H_
+#define CHROME_BROWSER_UI_RAC_CLEANUP_FOOTER_FIT_H_
+
+#include <algorithm>
+
+namespace rac::cleanup {
+
+// How the sidebar's footer row shares the room beside its fixed controls
+// (the profile button and the app menu) between the space switcher and the
+// clean-up broom.
+struct FooterFit {
+  // Whether the broom shows.
+  bool broom = false;
+  // Empty room on the switcher's far side, up to the broom's width, so the
+  // switcher stays centered where it was without the broom.
+  int balance = 0;
+  // The switcher's width.
+  int switcher = 0;
+
+  friend bool operator==(const FooterFit&, const FooterFit&) = default;
+};
+
+// `room` is the row's width minus its fixed controls. `switcher_need` is
+// the switcher's width with every space's dot and New Space showing, and
+// `broom` is the broom's width. The switcher comes first: the broom shows
+// only when the switcher still gets everything it needs beside it, and the
+// balance gets only what's left after both. Without the broom the switcher
+// gets the whole room, and only then falls back to its list button.
+constexpr FooterFit FitFooter(int room, int switcher_need, int broom) {
+  room = std::max(room, 0);
+  if (switcher_need + broom > room) {
+    return {.broom = false, .balance = 0, .switcher = room};
+  }
+  const int balance = std::min(broom, room - switcher_need - broom);
+  return {
+      .broom = true, .balance = balance, .switcher = room - broom - balance};
+}
+
+}  // namespace rac::cleanup
+
+#endif  // CHROME_BROWSER_UI_RAC_CLEANUP_FOOTER_FIT_H_

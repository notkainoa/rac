+
+void RacSidebarFooterView::FitCleanupButton() {
+  if (!cleanup_button_) {
+    return;
+  }
+  const auto width_of = [](const views::View* view) {
+    const gfx::Insets* margins = view->GetProperty(views::kMarginsKey);
+    return view->GetPreferredSize().width() + (margins ? margins->width() : 0);
+  };
+  // A collapsed sidebar stacks the controls, so the button keeps its place.
+  rac::cleanup::FooterFit fit = {.broom = true};
+  if (!collapsed_) {
+    int room = width() - GetInsets().width();
+    for (const views::View* child : children()) {
+      if (child != spacer_ && child != cleanup_button_ && child->GetVisible()) {
+        room -= width_of(child);
+      }
+    }
+    fit = rac::cleanup::FitFooter(room, spacer_->GetPreferredSize().width(),
+                                  width_of(cleanup_button_));
+  }
+  // Only what changed, so a settled footer lays out once.
+  cleanup_button_->SetVisible(fit.broom);
+  const bool button_last =
+      GetIndexOf(cleanup_button_).value() > GetIndexOf(spacer_).value();
+  const gfx::Insets margins = button_last
+                                  ? gfx::Insets::TLBR(0, fit.balance, 0, 0)
+                                  : gfx::Insets::TLBR(0, 0, 0, fit.balance);
+  const gfx::Insets* old_margins = spacer_->GetProperty(views::kMarginsKey);
+  if (!old_margins || *old_margins != margins) {
+    spacer_->SetProperty(views::kMarginsKey, margins);
+  }
+}
+
+void RacSidebarFooterView::Layout(PassKey) {
+  // The toolbar may have reset them while it lent them out.
+  UpdateControlMargins();
+  FitCleanupButton();
+  LayoutSuperclass<views::View>(this);
 }
 

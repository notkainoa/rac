+void RacSidebarFooterView::AdoptControl(views::View* view) {
+  const gfx::Insets* margins = view->GetProperty(views::kMarginsKey);
+  controls_.push_back(
+      {.view = view,
+       .toolbar_margins = margins ? std::optional(*margins) : std::nullopt});
+  UpdateControlMargins();
+}
+
+void RacSidebarFooterView::UpdateControlMargins() {
+  const bool narrow = cleanup_button_ && !collapsed_;
+  for (const Control& control : controls_) {
+    SetMargins(control.view,
+               narrow ? std::optional(gfx::Insets::VH(0, kFooterControlMargin))
+                      : control.toolbar_margins);
+  }
+}
+
+void RacSidebarFooterView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  views::View::ViewHierarchyChanged(details);
+  if (details.is_add || details.parent != this) {
+    return;
+  }
+  // Back to the toolbar with the margins it had there.
+  auto it = std::ranges::find(controls_, details.child, &Control::view);
+  if (it != controls_.end()) {
+    SetMargins(details.child, it->toolbar_margins);
+    controls_.erase(it);
+  }
+}

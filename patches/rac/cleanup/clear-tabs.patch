+// These tests answer plan 01's M0 question with TabRestoreService's real
+// bookkeeping: closing N tabs records N recently-closed entries, while a
+// Clear through ClearedTabsContext records one entry that restores the same
+// tabs in order. The browser side (BrowserLiveTabContext) is replaced by a
+// fake window, so this runs without a browser.
+namespace rac::cleanup {
+namespace {
+
+using sessions::tab_restore::Entry;
+using sessions::tab_restore::Group;
+using sessions::tab_restore::Tab;
+using sessions::tab_restore::Type;
+
+constexpr char kSpaceKey[] = "rac.space";
+constexpr char kSpace[] = "8d3f2e5c-0b1a-4c8e-9d7f-1a2b3c4d5e6f";
+
+GURL UrlFor(int n) {
+  return GURL("https://example.com/" + base::NumberToString(n));
+}
+
+class FakeLiveTab : public sessions::LiveTab {
+ public:
+  // An empty `url` is a tab whose first page hasn't committed yet.
+  explicit FakeLiveTab(GURL url) : url_(std::move(url)) {}
+  ~FakeLiveTab() override = default;
+
+  const GURL& url() const { return url_; }
+
+  // sessions::LiveTab:
+  SessionID GetSessionID() const override { return id_; }
+  bool IsInitialBlankNavigation() override { return url_.is_empty(); }
+  int GetCurrentEntryIndex() override { return url_.is_empty() ? -1 : 0; }
+  int GetPendingEntryIndex() override { return -1; }
+  sessions::SerializedNavigationEntry GetEntryAtIndex(int index) override {
+    sessions::SerializedNavigationEntry entry = sessions::
+        SerializedNavigationEntryTestHelper::CreateNavigationForTest();
+    sessions::SerializedNavigationEntryTestHelper::SetVirtualURL(url_, &entry);
+    return entry;
+  }
+  sessions::SerializedNavigationEntry GetPendingEntry() override {
+    return sessions::SerializedNavigationEntry();
+  }
+  int GetEntryCount() override { return url_.is_empty() ? 0 : 1; }
+  sessions::SerializedUserAgentOverride GetUserAgentOverride() override {
+    return sessions::SerializedUserAgentOverride();
+  }
+  base::WeakPtr<sessions::LiveTab> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  const SessionID id_ = SessionID::NewUnique();
+  const GURL url_;
+  base::WeakPtrFactory<FakeLiveTab> weak_factory_{this};
+};
+
+// A window's tab strip, as BrowserLiveTabContext shows it to the service:
+// every tab is tagged with its space, and none is grouped or split.
+class FakeWindow : public sessions::LiveTabContext {
+ public:
+  struct Restored {
+    GURL url;
+    bool select = false;
+    bool cleared = false;
+    std::map<std::string, std::string> extra_data;
+  };
+
+  // `pending` tabs have no committed page yet.
+  explicit FakeWindow(int tab_count, std::set<int> pending = {}) {
+    for (int i = 0; i < tab_count; ++i) {
+      tabs_.push_back(std::make_unique<FakeLiveTab>(
+          pending.contains(i) ? GURL() : UrlFor(i)));
+    }
+  }
+  ~FakeWindow() override = default;
+
+  FakeLiveTab* tab(int index) { return tabs_[index].get(); }
+  const std::vector<Restored>& restored() const { return restored_; }
+
+  // sessions::LiveTabContext:
+  void ShowBrowserWindow() override {}
+  SessionID GetSessionID() const override { return id_; }
+  sessions::SessionWindow::WindowType GetWindowType() const override {
+    return sessions::SessionWindow::TYPE_NORMAL;
+  }
+  int GetTabCount() const override { return tabs_.size(); }
+  int GetSelectedIndex() const override { return 0; }
+  std::string GetAppName() const override { return std::string(); }
+  std::string GetUserTitle() const override { return std::string(); }
+  sessions::LiveTab* GetLiveTabAt(int index) const override {
+    return tabs_[index].get();
+  }
+  sessions::LiveTab* GetActiveLiveTab() const override {
+    return tabs_.empty() ? nullptr : tabs_[0].get();
+  }
+  std::map<std::string, std::string> GetExtraDataForTab(
+      int index) const override {
+    return {{kSpaceKey, kSpace}};
+  }
+  std::map<std::string, std::string> GetExtraDataForWindow() const override {
+    return {};
+  }
+  std::optional<tab_groups::TabGroupId> GetTabGroupForTab(
+      int index) const override {
+    return std::nullopt;
+  }
+  std::optional<split_tabs::SplitTabId> GetSplitForTab(
+      int index) const override {
+    return std::nullopt;
+  }
+  const tab_groups::TabGroupVisualData* GetVisualDataForGroup(
+      const tab_groups::TabGroupId& group) const override {
+    return nullptr;
+  }
+  const split_tabs::SplitTabVisualData* GetVisualDataForSplit(
+      const split_tabs::SplitTabId& split_id) const override {
+    return nullptr;
+  }
+  const std::optional<base::Uuid> GetSavedTabGroupIdForGroup(
+      const tab_groups::TabGroupId& group) const override {
+    return std::nullopt;
+  }
+  const std::optional<tab_groups::TabGroupId> GetGroupIdForSavedGroup(
+      const base::Uuid& saved) const override {
+    return std::nullopt;
+  }
+  bool IsTabPinned(int index) const override { return false; }
+  void SetVisualDataForGroup(
+      const tab_groups::TabGroupId& group,
+      const tab_groups::TabGroupVisualData& visual_data) override {
+    ADD_FAILURE() << "a Clear must never restore into a tab group";
+  }
+  const std::optional<tab_groups::TabGroupId> GetInitialFocusedTabGroup()
+      const override {
+    return std::nullopt;
+  }
+  void SetFocusedTabGroup(const tab_groups::TabGroupId& group) override {}
+  const gfx::Rect GetRestoredBounds() const override { return gfx::Rect(); }
+  ui::mojom::WindowShowState GetRestoredState() const override {
+    return ui::mojom::WindowShowState::kNormal;
+  }
+  std::string GetWorkspace() const override { return std::string(); }
+  sessions::LiveTab* AddRestoredTab(
+      const Tab& tab,
+      int tab_index,
+      bool select,
+      bool is_restoring_group_or_window,
+      sessions::tab_restore::Type original_session_type) override {
+    const GURL& url =
+        tab.navigations.at(tab.normalized_navigation_index()).virtual_url();
+    restored_.push_back({url, select, IsClearedTab(tab), tab.extra_data});
+    tabs_.push_back(std::make_unique<FakeLiveTab>(url));
+    return tabs_.back().get();
+  }
+  sessions::LiveTab* ReplaceRestoredTab(const Tab& tab) override {
+    return nullptr;
+  }
+  void ReconstructSplit(
+      sessions::LiveTab* leading_tab,
+      sessions::LiveTab* trailing_tab,
+      split_tabs::SplitTabId split_id,
+      const split_tabs::SplitTabVisualData& visual_data) override {}
+  void CloseTab() override {}
+
+ private:
+  const SessionID id_ = SessionID::NewUnique();
+  std::vector<std::unique_ptr<FakeLiveTab>> tabs_;
+  std::vector<Restored> restored_;
+};
+
+class FakeClient : public sessions::TabRestoreServiceClient {
+ public:
+  explicit FakeClient(FakeWindow& window) : window_(window) {}
+  ~FakeClient() override = default;
+
+  // sessions::TabRestoreServiceClient:
+  sessions::LiveTabContext* CreateLiveTabContext(
+      sessions::LiveTabContext* existing_context,
+      sessions::SessionWindow::WindowType type,
+      const std::string& app_name,
+      const gfx::Rect& bounds,
+      ui::mojom::WindowShowState show_state,
+      const std::string& workspace,
+      const std::string& user_title,
+      const std::map<std::string, std::string>& extra_data) override {
+    return &*window_;
+  }
+  sessions::LiveTabContext* FindLiveTabContextForTab(
+      const sessions::LiveTab* tab) override {
+    return &*window_;
+  }
+  sessions::LiveTabContext* FindLiveTabContextWithID(
+      SessionID desired_id) override {
+    return &*window_;
+  }
+  sessions::LiveTabContext* FindLiveTabContextWithGroup(
+      tab_groups::TabGroupId group) override {
+    return nullptr;
+  }
+  bool ShouldTrackURLForRestore(const GURL& url) override { return true; }
+  std::string GetExtensionAppIDForTab(sessions::LiveTab* tab) override {
+    return std::string();
+  }
+  base::FilePath GetPathToSaveTo() override { return base::FilePath(); }
+  GURL GetNewTabURL() override { return GURL("chrome://newtab/"); }
+  bool HasLastSession() override { return false; }
+  void GetLastSession(sessions::GetLastSessionCallback callback) override {}
+
+ private:
+  const raw_ref<FakeWindow> window_;
+};
+
+class ClearedTabsContextTest : public testing::Test {
+ protected:
+  explicit ClearedTabsContextTest(int tab_count = 6, std::set<int> pending = {})
+      : window_(tab_count, std::move(pending)),
+        client_(window_),
+        helper_(&service_, &client_, /*time_factory=*/nullptr) {}
+
+  // What a Clear does: one group entry for the tabs at `indices`.
+  SessionID Clear(std::set<int> indices) {
+    ClearedTabsContext context(window_, std::move(indices), u"Personal");
+    helper_.CreateHistoricalGroup(&context, context.group_id());
+    helper_.GroupClosed(context.group_id());
+    return helper_.entries().front()->id;
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  FakeWindow window_;
+  FakeClient client_;
+  testing::NiceMock<MockTabRestoreService> service_;
+  sessions::TabRestoreServiceHelper helper_;
+};
+
+// The baseline the plan asked about: Chromium's close path records each
+// closed tab as its own entry, which is why Clear doesn't use it.
+TEST_F(ClearedTabsContextTest, ClosingTabsOneByOneRecordsAnEntryEach) {
+  for (int i = 0; i < 4; ++i) {
+    helper_.CreateHistoricalTab(window_.tab(i), i);
+  }
+  EXPECT_EQ(helper_.entries().size(), 4u);
+}
+
+// BrowserLiveTabContext::AddRestoredTab spells the key out to stay a one-line
+// hook.
+TEST(ClearedTabsKeyTest, MatchesTheRestoreHook) {
+  EXPECT_STREQ(kClearedTabExtraDataKey, "rac.cleared");
+}
+
+TEST_F(ClearedTabsContextTest, AClearIsOneEntry) {
+  Clear({1, 2, 4});
+
+  ASSERT_EQ(helper_.entries().size(), 1u);
+  const Entry& entry = *helper_.entries().front();
+  ASSERT_EQ(entry.type, Type::GROUP);
+  const auto& group = static_cast<const Group&>(entry);
+  EXPECT_EQ(group.visual_data.title(), u"Personal");
+  EXPECT_FALSE(group.saved_group_id.has_value());
+  ASSERT_EQ(group.tabs.size(), 3u);
+  const int expected_index[] = {1, 2, 4};
+  for (size_t i = 0; i < group.tabs.size(); ++i) {
+    const Tab& tab = *group.tabs[i];
+    SCOPED_TRACE(i);
+    EXPECT_EQ(tab.navigations.at(0).virtual_url(), UrlFor(expected_index[i]));
+    EXPECT_EQ(tab.tabstrip_index, expected_index[i]);
+    EXPECT_TRUE(IsClearedTab(tab));
+    // The window's own extra data (the space) comes along.
+    EXPECT_EQ(tab.extra_data.at(kSpaceKey), kSpace);
+  }
+}
+
+TEST_F(ClearedTabsContextTest, OnlyTheClearedTabsAreMarked) {
+  ClearedTabsContext context(window_, {1, 3}, u"Personal");
+  EXPECT_FALSE(context.GetTabGroupForTab(0).has_value());
+  EXPECT_EQ(context.GetTabGroupForTab(1), context.group_id());
+  EXPECT_FALSE(context.GetTabGroupForTab(2).has_value());
+  EXPECT_EQ(context.GetTabGroupForTab(3), context.group_id());
+  EXPECT_FALSE(context.GetExtraDataForTab(0).contains(kClearedTabExtraDataKey));
+  EXPECT_TRUE(context.GetExtraDataForTab(3).contains(kClearedTabExtraDataKey));
+  EXPECT_FALSE(context.GetSplitForTab(1).has_value());
+  EXPECT_FALSE(context.GetSavedTabGroupIdForGroup(context.group_id()));
+  EXPECT_EQ(context.GetSessionID(), window_.GetSessionID());
+  EXPECT_EQ(context.GetTabCount(), window_.GetTabCount());
+}
+
+TEST_F(ClearedTabsContextTest, UndoRestoresTheSameTabsInOrder) {
+  const SessionID id = Clear({0, 2, 3, 5});
+
+  std::optional<std::vector<sessions::LiveTab*>> live_tabs =
+      helper_.RestoreEntryById(&window_, id, WindowOpenDisposition::UNKNOWN);
+
+  ASSERT_TRUE(live_tabs.has_value());
+  EXPECT_EQ(live_tabs->size(), 4u);
+  const std::vector<FakeWindow::Restored>& restored = window_.restored();
+  ASSERT_EQ(restored.size(), 4u);
+  const int expected_index[] = {0, 2, 3, 5};
+  for (size_t i = 0; i < restored.size(); ++i) {
+    SCOPED_TRACE(i);
+    EXPECT_EQ(restored[i].url, UrlFor(expected_index[i]));
+    EXPECT_EQ(static_cast<FakeLiveTab*>((*live_tabs)[i])->url(),
+              UrlFor(expected_index[i]));
+    // The hook in BrowserLiveTabContext keys off this.
+    EXPECT_TRUE(restored[i].cleared);
+    EXPECT_EQ(restored[i].extra_data.at(kSpaceKey), kSpace);
+    // Only the first is selected; Undo then selects the tab that was active.
+    EXPECT_EQ(restored[i].select, i == 0);
+  }
+  // Restored in full, so the entry is gone.
+  EXPECT_TRUE(helper_.entries().empty());
+}
+
+TEST_F(ClearedTabsContextTest, OneTabCanComeBackFromTheEntry) {
+  const SessionID id = Clear({1, 2});
+  const auto& group = static_cast<const Group&>(*helper_.entries().front());
+  const SessionID second = group.tabs[1]->id;
+
+  helper_.RestoreEntryById(&window_, second, WindowOpenDisposition::UNKNOWN);
+
+  ASSERT_EQ(window_.restored().size(), 1u);
+  EXPECT_EQ(window_.restored()[0].url, UrlFor(2));
+  EXPECT_TRUE(window_.restored()[0].cleared);
+  // The rest of the Clear is still one entry.
+  ASSERT_EQ(helper_.entries().size(), 1u);
+  EXPECT_EQ(helper_.entries().front()->id, id);
+}
+
+// Cmd+Shift+T and History restore into the window in front. A Clear's tabs
+// go back to the window they were cleared from while it's open.
+TEST_F(ClearedTabsContextTest, RestoringAClearReturnsToItsWindow) {
+  Clear({1, 2});
+  const auto& group = static_cast<const Group&>(*helper_.entries().front());
+  FakeWindow other(1);
+  auto find = [&](SessionID id) -> sessions::LiveTabContext* {
+    return id == window_.GetSessionID() ? &window_ : nullptr;
+  };
+  for (const auto& tab : group.tabs) {
+    EXPECT_EQ(WindowForRestoredTab(*tab, &other, find), &window_);
+    EXPECT_EQ(WindowForRestoredTab(*tab, &window_, find), &window_);
+  }
+}
+
+// Once the window it came from has closed, a Clear's tab goes into the
+// window in front (which then shows the tab's space, if it still exists).
+TEST_F(ClearedTabsContextTest, RestoringAClearWhoseWindowClosed) {
+  Clear({1, 2});
+  const auto& group = static_cast<const Group&>(*helper_.entries().front());
+  FakeWindow other(1);
+  auto find = [](SessionID) -> sessions::LiveTabContext* { return nullptr; };
+  for (const auto& tab : group.tabs) {
+    EXPECT_EQ(WindowForRestoredTab(*tab, &other, find), &other);
+  }
+}
+
+// Every other tab restores where Chromium puts it.
+TEST_F(ClearedTabsContextTest, OtherTabsRestoreIntoTheWindowInFront) {
+  helper_.CreateHistoricalTab(window_.tab(0), 0);
+  const auto& tab = static_cast<const Tab&>(*helper_.entries().front());
+  FakeWindow other(1);
+  auto find = [&](SessionID) -> sessions::LiveTabContext* { return &window_; };
+  EXPECT_EQ(WindowForRestoredTab(tab, &other, find), &other);
+}
+
+class ClearedTabsContextPendingTest : public ClearedTabsContextTest {
+ protected:
+  ClearedTabsContextPendingTest()
+      : ClearedTabsContextTest(/*tab_count=*/6, /*pending=*/{2}) {}
+};
+
+// A tab whose first load hasn't committed has nothing recently closed can
+// bring back, so the entry leaves it out. Clear keeps exactly those tabs
+// open, and pairs saved positions only with the tabs the entry holds.
+TEST_F(ClearedTabsContextPendingTest, ATabStillLoadingIsLeftOut) {
+  Clear({1, 2, 3});
+
+  ASSERT_EQ(helper_.entries().size(), 1u);
+  const auto& group = static_cast<const Group&>(*helper_.entries().front());
+  EXPECT_EQ(RecordedIndices(group), (std::vector<int>{1, 3}));
+  EXPECT_EQ(group.tabs[0]->navigations.at(0).virtual_url(), UrlFor(1));
+  EXPECT_EQ(group.tabs[1]->navigations.at(0).virtual_url(), UrlFor(3));
+}
+
+TEST_F(ClearedTabsContextPendingTest, NothingRecordedWhenEveryTabIsLoading) {
+  ClearedTabsContext context(window_, {2}, u"Personal");
+  helper_.CreateHistoricalGroup(&context, context.group_id());
+  helper_.GroupClosed(context.group_id());
+  EXPECT_TRUE(helper_.entries().empty());
+}
+
+class ClearedTabsContextManyTabsTest : public ClearedTabsContextTest {
+ protected:
+  ClearedTabsContextManyTabsTest() : ClearedTabsContextTest(/*tab_count=*/35) {}
+};
+
+// Recently closed keeps 25 entries. Thirty tabs closed one by one would push
+// out everything older and five of their own; a Clear of thirty costs one.
+TEST_F(ClearedTabsContextManyTabsTest, AClearOfManyTabsKeepsOlderEntries) {
+  for (int i = 30; i < 35; ++i) {
+    helper_.CreateHistoricalTab(window_.tab(i), i);
+  }
+  ASSERT_EQ(helper_.entries().size(), 5u);
+
+  std::set<int> indices;
+  for (int i = 0; i < 30; ++i) {
+    indices.insert(i);
+  }
+  Clear(indices);
+
+  ASSERT_EQ(helper_.entries().size(), 6u);
+  const auto& group = static_cast<const Group&>(*helper_.entries().front());
+  EXPECT_EQ(group.tabs.size(), 30u);
+}

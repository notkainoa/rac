+
+// What Undo needs from a window's last Clear.
+struct PendingUndo {
+  SessionID entry_id = SessionID::InvalidValue();
+  // The cleared tabs' indices in the tab strip, in strip order, so Undo puts
+  // each back where it was among the tabs Clear kept.
+  std::vector<int> indices;
+  // Which cleared tab was selected, as an offset into `indices`, if one was.
+  std::optional<size_t> selected;
+  // Otherwise the tab that was selected, which Clear kept.
+  tabs::TabHandle kept_selected;
+};
+
+// Made by the first Clear. Keyed by window; an entry lives while its toast
+// shows. Leaked on purpose, like every NoDestructor; a plain pointer so the
+// sidebar can ask without making it.
+std::map<SessionID, PendingUndo>* g_pending_undos = nullptr;
+
+std::map<SessionID, PendingUndo>& PendingUndos() {
+  if (!g_pending_undos) {
+    g_pending_undos = new std::map<SessionID, PendingUndo>();
+  }
+  return *g_pending_undos;
+}
+
+// The tabs the running Clear keeps, by window. Made by the first Clear that
+// keeps one, and emptied once that Clear's task ends.
+using KeptTabs =
+    std::map<SessionID, std::vector<std::pair<tabs::TabHandle, int>>>;
+// Leaked on purpose, like every NoDestructor; a plain pointer so the
+// sidebar can ask without making it.
+KeptTabs* g_kept_tabs = nullptr;
+
+void ForgetKeptTabs(SessionID window) {
+  if (g_kept_tabs) {
+    g_kept_tabs->erase(window);
+  }
+}
+
+// Hands the sidebar the tabs this Clear keeps, for the rest of this task.
+void StoreKeptTabs(BrowserWindowInterface* browser,
+                   std::vector<std::pair<tabs::TabHandle, int>> kept) {
+  if (kept.empty()) {
+    return;
+  }
+  // The sidebar takes them while the tabs close (or, when none does, right
+  // after its Clear button ran this); nobody may later.
+  if (!g_kept_tabs) {
+    g_kept_tabs = new KeptTabs();
+  }
+  (*g_kept_tabs)[browser->GetSessionID()] = std::move(kept);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ForgetKeptTabs, browser->GetSessionID()));
+}
+
+int KeptMessageId(ClearReason reason) {
+  switch (reason) {
+    case ClearReason::kAgent:
+      return IDS_RAC_CLEAR_KEPT_AGENT;
+    case ClearReason::kCall:
+      return IDS_RAC_CLEAR_KEPT_CALL;
+    case ClearReason::kDevice:
+      return IDS_RAC_CLEAR_KEPT_DEVICE;
+    case ClearReason::kAudio:
+      return IDS_RAC_CLEAR_KEPT_AUDIO;
+    case ClearReason::kPictureInPicture:
+      return IDS_RAC_CLEAR_KEPT_PIP;
+    case ClearReason::kDownload:
+      return IDS_RAC_CLEAR_KEPT_DOWNLOAD;
+    case ClearReason::kUpload:
+      return IDS_RAC_CLEAR_KEPT_UPLOAD;
+    case ClearReason::kSplit:
+      return IDS_RAC_CLEAR_KEPT_SPLIT;
+    case ClearReason::kGroup:
+      return IDS_RAC_CLEAR_KEPT_GROUP;
+    case ClearReason::kBeforeUnload:
+      return IDS_RAC_CLEAR_KEPT_UNSAVED;
+    case ClearReason::kUnsavedEdits:
+      return IDS_RAC_CLEAR_KEPT_EDITS;
+    case ClearReason::kClear:
+    case ClearReason::kFavorite:
+    case ClearReason::kPinned:
+      return 0;
+  }
+  NOTREACHED();
+}
+
+void ForgetUndo(SessionID window, SessionID entry_id) {
+  auto it = PendingUndos().find(window);
+  if (it != PendingUndos().end() && it->second.entry_id == entry_id) {
+    PendingUndos().erase(it);
+  }
+}
+
+bool IsOpenTab(SidebarWindowSync* sync, tabs::TabInterface* tab) {
+  return SpaceTabTag::IsVisible(tab) && !tab->IsPinned() &&
+         GetSidebarTabKind(sync, tab) == SidebarTabKind::kOpen;
+}
+
+bool IsLoaded(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  return !contents->WasDiscarded() && !contents->GetController().NeedsReload();
+}
+
+// Moves off the selected tab before it closes, as closing a tab from the
+// sidebar does, but to a tab this space keeps: the one used most recently,
+// preferring a loaded one so nothing reloads. Only when the space keeps no
+// tab at all does it open a new tab. A new tab focuses the address field,
+// and Chromium hides toasts while it has focus, so landing on an unloaded
+// favorite beats hiding Undo.
+void LeaveSelectedTab(TabStripModel* model,
+                      const std::vector<tabs::TabInterface*>& closing) {
+  tabs::TabInterface* next = nullptr;
+  for (tabs::TabInterface* tab : *model) {
+    if (std::ranges::find(closing, tab) != closing.end() ||
+        !SpaceTabTag::IsVisible(tab)) {
+      continue;
+    }
+    if (!next || IsLoaded(tab) > IsLoaded(next) ||
+        (IsLoaded(tab) == IsLoaded(next) &&
+         tab->GetContents()->GetLastActiveTimeTicks() >
+             next->GetContents()->GetLastActiveTimeTicks())) {
+      next = tab;
+    }
+  }
+  if (next) {
+    model->ActivateTabAt(model->GetIndexOfTab(next));
+  } else {
+    model->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+  }
+}
+
+// The space's name, as the sidebar shows it, for the History menu's entry.
+std::u16string SpaceTitle(SpacesWindowManager* manager, const SpaceId& id) {
+  SpacesService* spaces = manager->spaces();
+  const Space* space = spaces->FindSpace(id);
+  if (space && !space->name.empty()) {
+    return base::UTF8ToUTF16(space->name);
+  }
+  return l10n_util::GetStringFUTF16(
+      IDS_RAC_SPACE_FALLBACK_NAME,
+      base::NumberToString16(spaces->GetIndex(id).value_or(0) + 1));
+}
+
+}  // namespace
+
+sessions::LiveTabContext* RouteRestoredTab(
+    const sessions::tab_restore::Tab& tab,
+    BrowserLiveTabContext* current,
+    Profile* profile,
+    bool select) {
+  sessions::LiveTabContext* target = WindowForRestoredTab(
+      tab, current, [profile](SessionID id) -> sessions::LiveTabContext* {
+        BrowserWindowInterface* browser =
+            GlobalBrowserCollection::GetInstance()->FindBrowserWithID(id);
+        // Only a window of the same profile that has spaces.
+        if (!browser || browser->GetProfile() != profile ||
+            !SpacesWindowManager::From(browser)) {
+          return nullptr;
+        }
+        return BrowserLiveTabContext::From(browser);
+      });
+  if (target != current && select) {
+    // After Chromium shows the window the restore began in.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](SessionID id) {
+              if (BrowserWindowInterface* browser =
+                      GlobalBrowserCollection::GetInstance()
+                          ->FindBrowserWithID(id)) {
+                BrowserLiveTabContext::From(browser)->ShowBrowserWindow();
+              }
+            },
+            target->GetSessionID()));
+  }
+  return target;
+}
+
+bool HasOpenTabs(BrowserWindowInterface* browser) {
+  SidebarWindowSync* sync =
+      browser ? SidebarWindows::ForBrowser(browser) : nullptr;
+  if (!sync) {
+    return false;
+  }
+  for (tabs::TabInterface* tab : *browser->GetTabStripModel()) {
+    if (IsOpenTab(sync, tab)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ClearTabs(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  SpacesWindowManager* manager = SpacesWindowManager::From(browser);
+  SidebarWindowSync* sync = SidebarWindows::ForBrowser(browser);
+  const std::optional<SpaceId> space =
+      manager ? manager->GetActiveSpaceId(browser) : std::nullopt;
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(browser->GetProfile());
+  BrowserLiveTabContext* window = BrowserLiveTabContext::From(browser);
+  if (!sync || !space || !service || !window) {
+    return;
+  }
+
+  TabStripModel* model = browser->GetTabStripModel();
+  std::vector<tabs::TabInterface*> clearing;
+  std::set<int> indices;
+  std::vector<std::pair<tabs::TabHandle, int>> kept;
+  // A split or group shows one note, under the whole of it.
+  std::set<split_tabs::SplitTabId> noted_splits;
+  std::set<tab_groups::TabGroupId> noted_groups;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (!IsOpenTab(sync, tab)) {
+      continue;
+    }
+    const ClearReason reason = MayClear(*tab);
+    if (reason == ClearReason::kClear) {
+      clearing.push_back(tab);
+      indices.insert(i);
+    } else if (const int message_id = KeptMessageId(reason)) {
+      const std::optional<split_tabs::SplitTabId> split = tab->GetSplit();
+      const std::optional<tab_groups::TabGroupId> group = tab->GetGroup();
+      if ((split && !noted_splits.insert(*split).second) ||
+          (group && !noted_groups.insert(*group).second)) {
+        continue;
+      }
+      kept.emplace_back(tab->GetHandle(), message_id);
+    }
+  }
+  if (clearing.empty()) {
+    StoreKeptTabs(browser, std::move(kept));
+    return;
+  }
+
+  // Record the Clear as one entry while every tab is still where it was.
+  ClearedTabsContext context(*window, indices, SpaceTitle(manager, *space));
+  service->CreateHistoricalGroup(&context, context.group_id());
+  service->GroupClosed(context.group_id());
+  const sessions::TabRestoreService::Entries& entries = service->entries();
+  const sessions::tab_restore::Group* entry =
+      !entries.empty() &&
+              entries.front()->type == sessions::tab_restore::Type::GROUP &&
+              static_cast<const sessions::tab_restore::Group&>(
+                  *entries.front())
+                      .group_id == context.group_id()
+          ? &static_cast<const sessions::tab_restore::Group&>(*entries.front())
+          : nullptr;
+
+  // Recently closed leaves out a tab it can't bring back, such as one whose
+  // first page is still loading. Closing it would lose it, so it stays, and
+  // Undo counts and places only the tabs the entry holds.
+  const std::vector<int> recorded =
+      entry ? RecordedIndices(*entry) : std::vector<int>();
+  std::vector<tabs::TabInterface*> closing;
+  size_t k = 0;
+  for (int index : indices) {
+    tabs::TabInterface* tab = clearing[k++];
+    if (std::ranges::binary_search(recorded, index)) {
+      closing.push_back(tab);
+    } else {
+      kept.emplace_back(tab->GetHandle(), IDS_RAC_CLEAR_KEPT_LOADING);
+    }
+  }
+  StoreKeptTabs(browser, std::move(kept));
+  if (closing.empty()) {
+    return;
+  }
+
+  PendingUndo pending;
+  pending.entry_id = entry->id;
+  pending.indices = recorded;
+  tabs::TabInterface* selected = model->GetActiveTab();
+  if (auto it = std::ranges::find(closing, selected); it != closing.end()) {
+    pending.selected = it - closing.begin();
+    LeaveSelectedTab(model, closing);
+  } else if (selected) {
+    pending.kept_selected = selected->GetHandle();
+  }
+  // Offered before the tabs close, so the sidebar sees Undo as the rows go.
+  const SessionID window_id = browser->GetSessionID();
+  const SessionID entry_id = pending.entry_id;
+  ToastController* toasts = ToastController::From(browser);
+  SetUndoClearHandler(&UndoClear);
+  if (toasts) {
+    PendingUndos()[window_id] = std::move(pending);
+  }
+
+  // Close from the bottom up. Not CLOSE_CREATE_HISTORICAL_TAB: the entry
+  // above already holds them.
+  const int count = closing.size();
+  for (tabs::TabInterface* tab : base::Reversed(closing)) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+
+  if (!toasts) {
+    return;
+  }
+  // The toast's lifetime is Undo's: closing it, by timeout, its button, or
+  // the window closing, forgets the Undo.
+  ToastParams params(ToastId::kRacTabsCleared);
+  params.body_string_cardinality_param = count;
+  params.toast_close_callback = base::ScopedClosureRunner(
+      base::BindOnce(&ForgetUndo, window_id, entry_id));
+  if (!toasts->MaybeShowToast(std::move(params))) {
+    ForgetUndo(window_id, entry_id);
+  }
+}
+
+std::vector<std::pair<tabs::TabHandle, int>> TakeKeptTabs(
+    BrowserWindowInterface* browser) {
+  std::vector<std::pair<tabs::TabHandle, int>> kept;
+  if (!g_kept_tabs || !browser) {
+    return kept;
+  }
+  auto it = g_kept_tabs->find(browser->GetSessionID());
+  if (it != g_kept_tabs->end()) {
+    kept = std::move(it->second);
+    g_kept_tabs->erase(it);
+  }
+  return kept;
+}
+
+base::TimeDelta KeptNotesDuration() {
+  return ToastController::kToastWithActionTimeout;
+}
+
+bool HasPendingUndo(BrowserWindowInterface* browser) {
+  return browser && g_pending_undos &&
+         g_pending_undos->contains(browser->GetSessionID());
+}
+
+void UndoClear(BrowserWindowInterface* browser) {
+  if (!HasPendingUndo(browser)) {
+    return;
+  }
+  auto it = PendingUndos().find(browser->GetSessionID());
+  if (it == PendingUndos().end()) {
+    return;
+  }
+  const PendingUndo pending = std::move(it->second);
+  PendingUndos().erase(it);
+
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(browser->GetProfile());
+  BrowserLiveTabContext* window = BrowserLiveTabContext::From(browser);
+  if (!service || !window ||
+      std::ranges::none_of(service->entries(), [&](const auto& entry) {
+        return entry->id == pending.entry_id;
+      })) {
+    return;
+  }
+  std::optional<std::vector<sessions::LiveTab*>> restored =
+      service->RestoreEntryById(window, pending.entry_id,
+                                WindowOpenDisposition::UNKNOWN);
+  if (!restored) {
+    return;
+  }
+
+  // The restore appends the tabs at the end of the strip. Put each back at
+  // its index, top down, so the kept tabs sit between them as before.
+  TabStripModel* model = browser->GetTabStripModel();
+  std::vector<content::WebContents*> contents;
+  for (sessions::LiveTab* live_tab : *restored) {
+    contents.push_back(
+        &static_cast<sessions::ContentLiveTab*>(live_tab)->GetWebContents());
+  }
+  for (size_t i = 0; i < contents.size() && i < pending.indices.size(); ++i) {
+    const int from = model->GetIndexOfWebContents(contents[i]);
+    if (from != TabStripModel::kNoTab) {
+      model->MoveWebContentsAt(from,
+                               std::min(pending.indices[i], model->count() - 1),
+                               /*select_after_move=*/false);
+    }
+  }
+
+  content::WebContents* select = nullptr;
+  if (pending.selected && *pending.selected < contents.size()) {
+    select = contents[*pending.selected];
+  } else if (tabs::TabInterface* kept = pending.kept_selected.Get()) {
+    select = kept->GetContents();
+  }
+  const int index =
+      select ? model->GetIndexOfWebContents(select) : TabStripModel::kNoTab;
+  if (index != TabStripModel::kNoTab) {
+    model->ActivateTabAt(index);
+  }
+}
+

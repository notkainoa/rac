+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/cleanup/clear_reason.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace rac::cleanup {
+namespace {
+
+TEST(ClearReasonTest, AnOrdinaryTabIsCleared) {
+  EXPECT_EQ(Decide(TabFacts()), ClearReason::kClear);
+}
+
+// One test per rule: each fact alone keeps the tab, with its own reason.
+TEST(ClearReasonTest, KeepsFavorites) {
+  EXPECT_EQ(Decide({.favorite = true}), ClearReason::kFavorite);
+}
+
+TEST(ClearReasonTest, KeepsPinnedTabs) {
+  EXPECT_EQ(Decide({.pinned = true}), ClearReason::kPinned);
+}
+
+TEST(ClearReasonTest, KeepsTabsAnAgentIsUsing) {
+  EXPECT_EQ(Decide({.agent = true}), ClearReason::kAgent);
+}
+
+TEST(ClearReasonTest, KeepsCallsAndScreenSharing) {
+  EXPECT_EQ(Decide({.call = true}), ClearReason::kCall);
+}
+
+TEST(ClearReasonTest, KeepsTabsConnectedToADevice) {
+  EXPECT_EQ(Decide({.device = true}), ClearReason::kDevice);
+}
+
+TEST(ClearReasonTest, KeepsTabsPlayingSound) {
+  EXPECT_EQ(Decide({.audio = true}), ClearReason::kAudio);
+}
+
+TEST(ClearReasonTest, KeepsPictureInPicture) {
+  EXPECT_EQ(Decide({.picture_in_picture = true}),
+            ClearReason::kPictureInPicture);
+}
+
+TEST(ClearReasonTest, KeepsTabsWithARunningDownload) {
+  EXPECT_EQ(Decide({.download = true}), ClearReason::kDownload);
+}
+
+TEST(ClearReasonTest, KeepsTabsStillUploading) {
+  EXPECT_EQ(Decide({.upload = true}), ClearReason::kUpload);
+}
+
+TEST(ClearReasonTest, KeepsSplitView) {
+  EXPECT_EQ(Decide({.split = true}), ClearReason::kSplit);
+}
+
+TEST(ClearReasonTest, KeepsTabGroups) {
+  EXPECT_EQ(Decide({.group = true}), ClearReason::kGroup);
+}
+
+TEST(ClearReasonTest, KeepsPagesThatAskBeforeClosing) {
+  EXPECT_EQ(Decide({.before_unload = true}), ClearReason::kBeforeUnload);
+}
+
+TEST(ClearReasonTest, KeepsPagesWithUnsavedEdits) {
+  EXPECT_EQ(Decide({.unsaved_edits = true}), ClearReason::kUnsavedEdits);
+}
+
+// With several facts, the reason is the first in ClearReason's order, so a
+// tab shows the reason that matters most.
+TEST(ClearReasonTest, TheFirstReasonWins) {
+  const TabFacts everything = {.favorite = true,
+                               .pinned = true,
+                               .agent = true,
+                               .call = true,
+                               .device = true,
+                               .audio = true,
+                               .picture_in_picture = true,
+                               .download = true,
+                               .upload = true,
+                               .split = true,
+                               .group = true,
+                               .before_unload = true,
+                               .unsaved_edits = true};
+  EXPECT_EQ(Decide(everything), ClearReason::kFavorite);
+
+  TabFacts facts = everything;
+  facts.favorite = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kPinned);
+  facts.pinned = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kAgent);
+  facts.agent = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kCall);
+  facts.call = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kDevice);
+  facts.device = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kAudio);
+  facts.audio = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kPictureInPicture);
+  facts.picture_in_picture = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kDownload);
+  facts.download = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kUpload);
+  facts.upload = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kSplit);
+  facts.split = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kGroup);
+  facts.group = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kBeforeUnload);
+  facts.before_unload = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kUnsavedEdits);
+  facts.unsaved_edits = false;
+  EXPECT_EQ(Decide(facts), ClearReason::kClear);
+}

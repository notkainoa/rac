+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_RAC_CLEANUP_CLEAR_REASON_H_
+#define CHROME_BROWSER_UI_RAC_CLEANUP_CLEAR_REASON_H_
+
+// The rule behind Clear, as plain data so it can be tested without a
+// browser. may_clear.h reads the facts from a real tab.
+namespace rac::cleanup {
+
+// Why Clear keeps a tab, or kClear when it may close it. When several apply,
+// the first one listed is the reason.
+enum class ClearReason {
+  kClear,
+  // Favorites and pinned tabs live above the divider; Clear never touches
+  // them.
+  kFavorite,
+  kPinned,
+  kAgent,             // An agent is acting in it.
+  kCall,              // Using the camera or microphone, or being shared.
+  kDevice,            // Connected to a USB, HID, serial or Bluetooth device.
+  kAudio,             // Playing sound, or did a moment ago.
+  kPictureInPicture,  // Showing a picture-in-picture window.
+  kDownload,          // A download it started is still running.
+  kUpload,            // Still sending a form or file.
+  kSplit,             // Half of a split view.
+  kGroup,             // In a tab group.
+  kBeforeUnload,      // The page asks before it closes: it may lose work.
+  kUnsavedEdits,      // The user typed into the page, which may be unsaved.
+};
+
+// What MayClear() learns about a tab. Every field defaults to "nothing to
+// keep it for".
+struct TabFacts {
+  bool favorite = false;
+  bool pinned = false;
+  bool agent = false;
+  bool call = false;
+  bool device = false;
+  bool audio = false;
+  bool picture_in_picture = false;
+  bool download = false;
+  bool upload = false;
+  bool split = false;
+  bool group = false;
+  bool before_unload = false;
+  bool unsaved_edits = false;
+};
+
+ClearReason Decide(const TabFacts& facts);
+
+}  // namespace rac::cleanup
+
+#endif  // CHROME_BROWSER_UI_RAC_CLEANUP_CLEAR_REASON_H_

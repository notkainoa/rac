+#include "chrome/grit/rac_strings.h"
+
+namespace rac::cleanup {
+
+namespace {
+
+UndoClearHandler g_undo_clear = nullptr;
+
+void RunUndoClear(BrowserWindowInterface* browser) {
+  if (g_undo_clear) {
+    g_undo_clear(browser);
+  }
+}
+
+}  // namespace
+
+void SetUndoClearHandler(UndoClearHandler handler) {
+  g_undo_clear = handler;
+}
+
+void RegisterClearToast(ToastRegistry& registry,
+                        BrowserWindowInterface* browser) {
+  registry.RegisterToast(
+      ToastId::kRacTabsCleared,
+      ToastSpecification::Builder(kTabIcon, IDS_RAC_CLEAR_TOAST_BODY)
+          .AddCloseButton()
+          // About the space, not a tab: Clear itself selects another tab,
+          // and Undo stays offered if the user switches tabs.
+          .AddGlobalScoped()
+          .AddActionButton(IDS_RAC_CLEAR_TOAST_UNDO,
+                           base::BindRepeating(&RunUndoClear, browser))
+          .Build());
+}

+
+#include "base/time/time.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserLiveTabContext;
+class BrowserWindowInterface;
+class Profile;
+
+namespace sessions {
+class LiveTabContext;
+namespace tab_restore {
+struct Tab;
+}  // namespace tab_restore
+}  // namespace sessions
+
+// Clear: closes the open tabs of the space a window shows, keeping the ones
+// MayClear() spares, and offers Undo. Plan 01, "Clear and archive".
+//
+// Nothing here runs or exists until the first Clear: no observer, no timer.
+// The only state is the Undo of each window's last Clear, made by that Clear
+// and dropped when its toast closes.
+namespace rac::cleanup {
+
+// Whether the space `browser` shows has an open tab (one that isn't a
+// favorite or a pinned tab), so Clear has something to look at. Cheap
+// enough for layout; it doesn't run MayClear().
+bool HasOpenTabs(BrowserWindowInterface* browser);
+
+// Closes the space's open tabs except those MayClear() keeps, recorded as one
+// recently-closed entry, and shows a toast with Undo. Does nothing in a
+// window without spaces (incognito, guest, apps, popups).
+void ClearTabs(BrowserWindowInterface* browser);
+
+// The open tabs the Clear running now in `browser` keeps, each with the
+// IDS_ string that says why ("Kept: playing sound"), for the sidebar to show
+// under them. Handed out once, and only within the task that ran Clear;
+// empty otherwise.
+std::vector<std::pair<tabs::TabHandle, int>> TakeKeptTabs(
+    BrowserWindowInterface* browser);
+
+// How long the sidebar shows those notes: as long as Clear's toast shows.
+base::TimeDelta KeptNotesDuration();
+
+// Whether `browser`'s last Clear can still be undone from its toast (and
+// the sidebar's Undo, which shows for as long).
+bool HasPendingUndo(BrowserWindowInterface* browser);
+
+// For BrowserLiveTabContext::AddRestoredTab: the window a restored tab goes
+// into, `current` unless it's a Clear's tab whose own window is still open
+// (WindowForRestoredTab). When it goes to that other window and is the tab
+// to select, that window comes to the front.
+sessions::LiveTabContext* RouteRestoredTab(
+    const sessions::tab_restore::Tab& tab,
+    BrowserLiveTabContext* current,
+    Profile* profile,
+    bool select);
+
+// The toast's Undo: brings the window's last Clear back, the same tabs in
+// the same order and space, and selects the tab that was selected. Does
+// nothing once the entry is gone (say, restored with Cmd+Shift+T).
+void UndoClear(BrowserWindowInterface* browser);
+
+}  // namespace rac::cleanup
+
+#endif  // CHROME_BROWSER_UI_RAC_CLEANUP_CLEAR_TABS_H_

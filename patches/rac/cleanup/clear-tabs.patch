+#ifndef CHROME_BROWSER_UI_RAC_CLEANUP_CLEARED_TABS_CONTEXT_H_
+#define CHROME_BROWSER_UI_RAC_CLEANUP_CLEARED_TABS_CONTEXT_H_
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/functional/function_ref.h"
+#include "base/memory/raw_ref.h"
+#include "components/sessions/core/live_tab_context.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+
+namespace rac::cleanup {
+
+// Marks a tab that a Clear closed, in its recently-closed entry. Restoring it
+// brings it back as an open tab rather than into the stand-in group below
+// (the one hook in BrowserLiveTabContext::AddRestoredTab).
+inline constexpr char kClearedTabExtraDataKey[] = "rac.cleared";
+
+bool IsClearedTab(const sessions::tab_restore::Tab& tab);
+
+// The tab strip indices of the tabs a Clear's entry holds, in order.
+// Recently closed drops a tab that has no page to bring back (a first load
+// still pending, say), so this can be fewer than the tabs given to
+// ClearedTabsContext; Clear keeps those open rather than lose them.
+std::vector<int> RecordedIndices(const sessions::tab_restore::Group& entry);
+
+// The window a restored tab goes into. Cmd+Shift+T and History restore into
+// the window in front, `current`. A Clear's tab goes back to the window it
+// was cleared from instead, while that window is open (`find_window` looks
+// it up by its session id), so it lands in its own space. Once that window
+// has closed, it goes into `current`, whose window then shows the tab's
+// space when it still exists (selecting a tab shows its space) or takes the
+// tab into the space it shows.
+sessions::LiveTabContext* WindowForRestoredTab(
+    const sessions::tab_restore::Tab& tab,
+    sessions::LiveTabContext* current,
+    base::FunctionRef<sessions::LiveTabContext*(SessionID)> find_window);
+
+// Closing N tabs records N recently-closed entries, one per tab, and the list
+// keeps only 25. So a Clear shows TabRestoreService its tabs as one stand-in
+// tab group: CreateHistoricalGroup() then records the whole Clear as a single
+// Group entry, which Undo, Cmd+Shift+T, and History > Recently Closed restore
+// in one step, in order.
+//
+// The window's real context answers everything else, so each tab keeps its
+// own index and extra data (its space, its sidebar item). Nothing here is
+// visible: no tab joins a real group. Used for the one CreateHistoricalGroup()
+// call and dropped; it never restores anything itself.
+class ClearedTabsContext : public sessions::LiveTabContext {
+ public:
+  // `indices` are the cleared tabs' indices in `window`'s tab strip. `title`
+  // names the entry in the History menu (the space's name).
+  ClearedTabsContext(sessions::LiveTabContext& window,
+                     std::set<int> indices,
+                     std::u16string title);
+  ClearedTabsContext(const ClearedTabsContext&) = delete;
+  ClearedTabsContext& operator=(const ClearedTabsContext&) = delete;
+  ~ClearedTabsContext() override;
+
+  const tab_groups::TabGroupId& group_id() const { return group_id_; }
+
+  // sessions::LiveTabContext:
+  void ShowBrowserWindow() override;
+  SessionID GetSessionID() const override;
+  sessions::SessionWindow::WindowType GetWindowType() const override;
+  int GetTabCount() const override;
+  int GetSelectedIndex() const override;
+  std::string GetAppName() const override;
+  std::string GetUserTitle() const override;
+  sessions::LiveTab* GetLiveTabAt(int index) const override;
+  sessions::LiveTab* GetActiveLiveTab() const override;
+  std::map<std::string, std::string> GetExtraDataForTab(
+      int index) const override;
+  std::map<std::string, std::string> GetExtraDataForWindow() const override;
+  std::optional<tab_groups::TabGroupId> GetTabGroupForTab(
+      int index) const override;
+  std::optional<split_tabs::SplitTabId> GetSplitForTab(
+      int index) const override;
+  const tab_groups::TabGroupVisualData* GetVisualDataForGroup(
+      const tab_groups::TabGroupId& group) const override;
+  const split_tabs::SplitTabVisualData* GetVisualDataForSplit(
+      const split_tabs::SplitTabId& split_id) const override;
+  const std::optional<base::Uuid> GetSavedTabGroupIdForGroup(
+      const tab_groups::TabGroupId& group) const override;
+  const std::optional<tab_groups::TabGroupId> GetGroupIdForSavedGroup(
+      const base::Uuid& saved) const override;
+  bool IsTabPinned(int index) const override;
+  void SetVisualDataForGroup(
+      const tab_groups::TabGroupId& group,
+      const tab_groups::TabGroupVisualData& visual_data) override;
+  const std::optional<tab_groups::TabGroupId> GetInitialFocusedTabGroup()
+      const override;
+  void SetFocusedTabGroup(const tab_groups::TabGroupId& group) override;
+  const gfx::Rect GetRestoredBounds() const override;
+  ui::mojom::WindowShowState GetRestoredState() const override;
+  std::string GetWorkspace() const override;
+  sessions::LiveTab* AddRestoredTab(
+      const sessions::tab_restore::Tab& tab,
+      int tab_index,
+      bool select,
+      bool is_restoring_group_or_window,
+      sessions::tab_restore::Type original_session_type) override;
+  sessions::LiveTab* ReplaceRestoredTab(
+      const sessions::tab_restore::Tab& tab) override;
+  void ReconstructSplit(
+      sessions::LiveTab* leading_tab,
+      sessions::LiveTab* trailing_tab,
+      split_tabs::SplitTabId split_id,
+      const split_tabs::SplitTabVisualData& visual_data) override;
+  void CloseTab() override;
+
+ private:
+  const raw_ref<sessions::LiveTabContext> window_;
+  const std::set<int> indices_;
+  const tab_groups::TabGroupId group_id_;
+  const tab_groups::TabGroupVisualData visual_data_;
+};
+
+}  // namespace rac::cleanup
+
+#endif  // CHROME_BROWSER_UI_RAC_CLEANUP_CLEARED_TABS_CONTEXT_H_

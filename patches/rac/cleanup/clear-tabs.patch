+#include "content/public/browser/web_contents_capability_type.h"
+#include "third_party/blink/public/mojom/frame/sudden_termination_disabler_type.mojom-shared.h"
+
+namespace rac::cleanup {
+
+namespace {
+
+bool IsInCall(content::WebContents* contents) {
+  scoped_refptr<MediaStreamCaptureIndicator> indicator =
+      MediaCaptureDevicesDispatcher::GetInstance()
+          ->GetMediaStreamCaptureIndicator();
+  if (!indicator) {
+    return false;
+  }
+  // Camera or microphone; or the tab is shared, or is sharing a tab, a
+  // window, or the screen.
+  return indicator->IsCapturingUserMedia(contents) ||
+         indicator->IsBeingMirrored(contents) ||
+         indicator->IsCapturingTab(contents) ||
+         indicator->IsCapturingWindow(contents) ||
+         indicator->IsCapturingDisplay(contents);
+}
+
+// WebUSB, WebHID, Web Serial or Web Bluetooth: closing drops the
+// connection.
+bool IsConnectedToDevice(content::WebContents* contents) {
+  using content::WebContentsCapabilityType;
+  return contents->IsCapabilityActive(WebContentsCapabilityType::kUSB) ||
+         contents->IsCapabilityActive(WebContentsCapabilityType::kHID) ||
+         contents->IsCapabilityActive(WebContentsCapabilityType::kSerial) ||
+         contents->IsCapabilityActive(
+             WebContentsCapabilityType::kBluetoothConnected);
+}
+
+// A form or file the page is still sending.
+bool IsUploading(content::WebContents* contents) {
+  const uint64_t size = contents->GetUploadSize();
+  return size > 0 && contents->GetUploadPosition() < size;
+}
+
+// The signal Chromium checks before it discards a tab: the user typed into
+// the page. It may be saved already, but Clear can't tell.
+bool HasUnsavedEdits(content::WebContents* contents) {
+  base::WeakPtr<performance_manager::PageNode> page =
+      performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+          contents);
+  return page && page->HadUserEdits();
+}
+
+bool IsAudible(content::WebContents* contents) {
+  // The same signal as the tab's speaker icon, which stays a moment after
+  // the sound stops, so a pause between tracks doesn't count as silence.
+  if (RecentlyAudibleHelper* helper =
+          RecentlyAudibleHelper::FromWebContents(contents)) {
+    return helper->WasRecentlyAudible();
+  }
+  return contents->IsCurrentlyAudible();
+}
+
+bool HasDownloadInProgress(content::WebContents* contents) {
+  content::DownloadManager* manager =
+      contents->GetBrowserContext()->GetDownloadManager();
+  if (!manager) {
+    return false;
+  }
+  content::DownloadManager::DownloadVector downloads;
+  manager->GetAllDownloads(&downloads);
+  for (download::DownloadItem* item : downloads) {
+    if (item->GetState() == download::DownloadItem::IN_PROGRESS &&
+        content::DownloadItemUtils::GetWebContents(item) == contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Only `beforeunload` means "this page may lose work": unload, pagehide, and
+// visibilitychange handlers, which most analytics scripts add, don't count.
+bool HasBeforeUnloadHandler(content::WebContents* contents) {
+  bool found = false;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [&found](content::RenderFrameHost* frame) {
+        if (frame->GetSuddenTerminationDisablerState(
+                blink::mojom::SuddenTerminationDisablerType::
+                    kBeforeUnloadHandler)) {
+          found = true;
+        }
+      });
+  return found;
+}
+
+}  // namespace
+
+TabFacts ReadTabFacts(tabs::TabInterface& tab) {
+  TabFacts facts;
+  content::WebContents* contents = tab.GetContents();
+  BrowserWindowInterface* browser = tab.GetBrowserWindowInterface();
+  if (SidebarWindowSync* sync =
+          browser ? SidebarWindows::ForBrowser(browser) : nullptr) {
+    switch (GetSidebarTabKind(sync, &tab)) {
+      case SidebarTabKind::kFavorite:
+        facts.favorite = true;
+        break;
+      case SidebarTabKind::kPinned:
+        facts.pinned = true;
+        break;
+      case SidebarTabKind::kOpen:
+        break;
+    }
+  }
+  // Chromium's own pinned tabs are rac's favorites.
+  facts.favorite = facts.favorite || tab.IsPinned();
+  // A lookup only: an agent's context exists while it acts in the tab, and
+  // never with AI off.
+  facts.agent = agent::ActionContext::From(contents) != nullptr;
+  facts.call = IsInCall(contents);
+  facts.device = IsConnectedToDevice(contents);
+  facts.audio = IsAudible(contents);
+  facts.picture_in_picture = contents->HasPictureInPictureVideo() ||
+                             contents->HasPictureInPictureDocument();
+  facts.download = HasDownloadInProgress(contents);
+  facts.upload = IsUploading(contents);
+  facts.split = tab.IsSplit();
+  facts.group = tab.GetGroup().has_value();
+  facts.before_unload = HasBeforeUnloadHandler(contents);
+  facts.unsaved_edits = HasUnsavedEdits(contents);
+  return facts;
+}
+
+ClearReason MayClear(tabs::TabInterface& tab) {
+  return Decide(ReadTabFacts(tab));
+}
+

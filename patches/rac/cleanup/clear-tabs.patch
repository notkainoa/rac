+namespace rac::cleanup {
+
+bool IsClearedTab(const sessions::tab_restore::Tab& tab) {
+  return tab.extra_data.contains(kClearedTabExtraDataKey);
+}
+
+std::vector<int> RecordedIndices(const sessions::tab_restore::Group& entry) {
+  std::vector<int> indices;
+  indices.reserve(entry.tabs.size());
+  for (const auto& tab : entry.tabs) {
+    indices.push_back(tab->tabstrip_index);
+  }
+  return indices;
+}
+
+sessions::LiveTabContext* WindowForRestoredTab(
+    const sessions::tab_restore::Tab& tab,
+    sessions::LiveTabContext* current,
+    base::FunctionRef<sessions::LiveTabContext*(SessionID)> find_window) {
+  if (!IsClearedTab(tab)) {
+    return current;
+  }
+  const SessionID origin = SessionID::FromSerializedValue(tab.browser_id);
+  if (!origin.is_valid() ||
+      (current && current->GetSessionID() == origin)) {
+    return current;
+  }
+  sessions::LiveTabContext* window = find_window(origin);
+  return window ? window : current;
+}
+
+ClearedTabsContext::ClearedTabsContext(sessions::LiveTabContext& window,
+                                       std::set<int> indices,
+                                       std::u16string title)
+    : window_(window),
+      indices_(std::move(indices)),
+      group_id_(tab_groups::TabGroupId::GenerateNew()),
+      visual_data_(std::move(title), tab_groups::TabGroupColorId::kGrey) {}
+
+ClearedTabsContext::~ClearedTabsContext() = default;
+
+void ClearedTabsContext::ShowBrowserWindow() {
+  NOTREACHED();
+}
+
+SessionID ClearedTabsContext::GetSessionID() const {
+  return window_->GetSessionID();
+}
+
+sessions::SessionWindow::WindowType ClearedTabsContext::GetWindowType() const {
+  return window_->GetWindowType();
+}
+
+int ClearedTabsContext::GetTabCount() const {
+  return window_->GetTabCount();
+}
+
+int ClearedTabsContext::GetSelectedIndex() const {
+  return window_->GetSelectedIndex();
+}
+
+std::string ClearedTabsContext::GetAppName() const {
+  return window_->GetAppName();
+}
+
+std::string ClearedTabsContext::GetUserTitle() const {
+  return window_->GetUserTitle();
+}
+
+sessions::LiveTab* ClearedTabsContext::GetLiveTabAt(int index) const {
+  return window_->GetLiveTabAt(index);
+}
+
+sessions::LiveTab* ClearedTabsContext::GetActiveLiveTab() const {
+  return window_->GetActiveLiveTab();
+}
+
+std::map<std::string, std::string> ClearedTabsContext::GetExtraDataForTab(
+    int index) const {
+  std::map<std::string, std::string> extra_data =
+      window_->GetExtraDataForTab(index);
+  if (indices_.contains(index)) {
+    extra_data[kClearedTabExtraDataKey] = "1";
+  }
+  return extra_data;
+}
+
+std::map<std::string, std::string> ClearedTabsContext::GetExtraDataForWindow()
+    const {
+  return window_->GetExtraDataForWindow();
+}
+
+std::optional<tab_groups::TabGroupId> ClearedTabsContext::GetTabGroupForTab(
+    int index) const {
+  if (indices_.contains(index)) {
+    return group_id_;
+  }
+  return std::nullopt;
+}
+
+std::optional<split_tabs::SplitTabId> ClearedTabsContext::GetSplitForTab(
+    int index) const {
+  // Clear keeps split tabs, so none of the cleared tabs is in a split.
+  return std::nullopt;
+}
+
+const tab_groups::TabGroupVisualData* ClearedTabsContext::GetVisualDataForGroup(
+    const tab_groups::TabGroupId& group) const {
+  return group == group_id_ ? &visual_data_ : nullptr;
+}
+
+const split_tabs::SplitTabVisualData* ClearedTabsContext::GetVisualDataForSplit(
+    const split_tabs::SplitTabId& split_id) const {
+  return nullptr;
+}
+
+const std::optional<base::Uuid> ClearedTabsContext::GetSavedTabGroupIdForGroup(
+    const tab_groups::TabGroupId& group) const {
+  // Never saved: a saved group would sync, and restore as a real group.
+  return std::nullopt;
+}
+
+const std::optional<tab_groups::TabGroupId>
+ClearedTabsContext::GetGroupIdForSavedGroup(const base::Uuid& saved) const {
+  return std::nullopt;
+}
+
+bool ClearedTabsContext::IsTabPinned(int index) const {
+  return window_->IsTabPinned(index);
+}
+
+void ClearedTabsContext::SetVisualDataForGroup(
+    const tab_groups::TabGroupId& group,

+// Copyright 2026 The rac Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/rac/cleanup/clear_reason.h"
+
+namespace rac::cleanup {
+
+ClearReason Decide(const TabFacts& facts) {
+  if (facts.favorite) {
+    return ClearReason::kFavorite;
+  }
+  if (facts.pinned) {
+    return ClearReason::kPinned;
+  }
+  if (facts.agent) {
+    return ClearReason::kAgent;
+  }
+  if (facts.call) {
+    return ClearReason::kCall;
+  }
+  if (facts.device) {
+    return ClearReason::kDevice;
+  }
+  if (facts.audio) {
+    return ClearReason::kAudio;
+  }
+  if (facts.picture_in_picture) {
+    return ClearReason::kPictureInPicture;
+  }
+  if (facts.download) {
+    return ClearReason::kDownload;
+  }
+  if (facts.upload) {
+    return ClearReason::kUpload;
+  }
+  if (facts.split) {
+    return ClearReason::kSplit;
+  }
+  if (facts.group) {
+    return ClearReason::kGroup;
+  }
+  if (facts.before_unload) {
+    return ClearReason::kBeforeUnload;
+  }
+  if (facts.unsaved_edits) {
+    return ClearReason::kUnsavedEdits;
+  }
+  return ClearReason::kClear;
+}
+
+}  // namespace rac::cleanup

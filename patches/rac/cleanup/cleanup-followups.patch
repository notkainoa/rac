+void RefreshSidebarReveal(BrowserView* browser_view) {
+  // BrowserView re-checks its reveal on any mouse event it observes, from
+  // where the pointer is, not where the event says. The event goes to
+  // BrowserView::OnEvent alone; nothing else sees it. It stands in for
+  // calling UpdateZenModeRevealFromCursor(), which is private: making it
+  // public would edit browser_view.h, which nearly everything includes, so
+  // every build would recompile most of the browser.
+  const ui::MouseEvent move(ui::EventType::kMouseMoved, gfx::PointF(),
+                            gfx::PointF(), ui::EventTimeForNow(), ui::EF_NONE,
+                            ui::EF_NONE);
+  static_cast<ui::EventObserver*>(browser_view)->OnEvent(move);
+}

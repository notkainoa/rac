{
  "vars": {"order": {"find": "ORD-[0-9]+"}},
  "steps": [
    {"tool": "navigate", "args": {"url": "{origin:a}/orders"}, "label": "open the shop the user named"},
    {"tool": "snapshot", "args": {}, "label": "read the order number"},
    {"tool": "navigate", "args": {"url": "{origin:b}/support"}, "label": "open the form the user named"},
    {"tool": "snapshot", "args": {}, "label": "read the form"},
    {"tool": "type", "args": {"ref": {"ref_of": "textbox \"Reference number\""}, "text": "{order}"}, "label": "type the order number into the form"},
    {"tool": "click", "args": {"ref": {"ref_of": "button \"Save\""}}, "label": "save the form"}
  ],
  "final": "I copied your order number into the form and saved it."
}
